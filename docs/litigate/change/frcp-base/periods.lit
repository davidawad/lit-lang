module change-deadline-frcp-base.periods

// A base layer declares rules from nothing (docs/litigate/CHANGE.md §2.1).
// Each period runs from entry, never from service, so FRCP 6(e) (now 6(d))
// adds nothing: the holding of every collected ruling that rejects three
// added days (VALIDATION.md §3). The 2007 restyling changed no period, so
// the restyled text stands for each period from its adoption (`historical`).
import core.frcp6.{ frcp6 }

/// After the district court enters a judgment, or an order granting or
/// denying class certification, the losing party may file a post-judgment
/// motion or petition for permission to appeal.
start entered

/// The clerk enters the judgment (FRCP 58, 79(a)).
event JudgmentEntered()
/// The court enters an order granting or denying class certification.
event ClassOrderEntered()
/// A motion for a new trial is filed (FRCP 59(b)).
event NewTrialMoved()
/// A motion to alter or amend the judgment is filed (FRCP 59(e)).
event AlterAmendMoved()
/// A renewed motion for judgment as a matter of law is filed (FRCP 50(b)).
event RenewedJmolMoved()
/// A petition for permission to appeal is filed with the circuit clerk
/// (FRCP 23(f)).
event ClassAppealPetitioned()

/// FRCP 59(b): a motion for a new trial no later than 10 days after entry
/// of judgment.
deadline new-trial-motion: 10.days after JudgmentEntered() counted_by frcp6 effective [1968-07-01, ..) cite "FRCP (2007) 59(b)" historical
{
  extend { never cite "FRCP (2007) 6(b)(2)" historical }
}

/// FRCP 59(e): a motion to alter or amend a judgment no later than 10 days
/// after its entry.
deadline alter-amend-motion: 10.days after JudgmentEntered() counted_by frcp6 effective [1968-07-01, ..) cite "FRCP (2007) 59(e)" historical
{
  extend { never cite "FRCP (2007) 6(b)(2)" historical }
}

/// FRCP 50(b): a renewed motion for judgment as a matter of law no later
/// than 10 days after entry of judgment.
deadline renewed-jmol-motion: 10.days after JudgmentEntered() counted_by frcp6 effective [1968-07-01, ..) cite "FRCP (2007) 50(b)" historical
{
  extend { never cite "FRCP (2007) 6(b)(2)" historical }
}

/// FRCP 23(f), added December 1, 1998: a petition for permission to appeal
/// within 10 days after the class-certification order is entered.
deadline class-appeal-petition: 10.days after ClassOrderEntered() counted_by frcp6 effective [1998-12-01, ..) known_at 1998-04-24 cite "FRCP (2007) 23(f)" historical

decision entered: "Judgment or class-certification order entered: what does the losing party file?" by movant effective [1968-07-01, ..) cite "FRCP (2007) 59(b)" historical
{
  new-trial "Move for a new trial" -> motion-filed {
    event NewTrialMoved()
    within new-trial-motion
  }
  alter-amend "Move to alter or amend the judgment" -> motion-filed {
    event AlterAmendMoved()
    within alter-amend-motion
  }
  renew "Renew the motion for judgment as a matter of law" -> motion-filed {
    event RenewedJmolMoved()
    within renewed-jmol-motion
  }
  petition "Petition for permission to appeal the class-certification order" -> petition-filed {
    event ClassAppealPetitioned()
    within class-appeal-petition
  }
  forgo "File nothing" -> nothing-filed
}

terminal motion-filed: "Post-judgment motion filed" effective [1968-07-01, ..)
terminal petition-filed: "Rule 23(f) petition filed" effective [1968-07-01, ..)
terminal nothing-filed: "Nothing filed" effective [1968-07-01, ..)

test "before 2009 a new-trial motion is due 10 days after entry, weekends skipped" cite "FRCP (2007) 59(b)" historical
{
  given JudgmentEntered() on 2008-03-03
  expect deadline(new-trial-motion) == 2008-03-17
}

test "before 2009 a Rule 59(e) motion is due 10 days after entry" cite "FRCP (2007) 59(e)" historical
{
  given JudgmentEntered() on 2008-03-03
  expect deadline(alter-amend-motion) == 2008-03-17
}

test "before 2009 a renewed Rule 50(b) motion is due 10 days after entry" cite "FRCP (2007) 50(b)" historical
{
  given JudgmentEntered() on 2008-03-03
  expect deadline(renewed-jmol-motion) == 2008-03-17
}

test "before 2009 a Rule 23(f) petition is due 10 days after the order" cite "FRCP (2007) 23(f)" historical
{
  given ClassOrderEntered() on 2008-03-03
  expect deadline(class-appeal-petition) == 2008-03-17
}
