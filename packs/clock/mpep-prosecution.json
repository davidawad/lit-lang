  "countingRules": [
    {
      "id": "uspto-1-7",
      "label": "37 CFR 1.7(a)",
      "sourceUrl": "https://www.ecfr.gov/current/title-37/chapter-I/subchapter-A/part-41",
      "closedWeekdays": [
        "saturday",
        "sunday"
      ],
      "holidays": [
        "dc-federal-holidays"
      ],
      "steps": [
        {
          "op": "anchor",
          "kind": "trigger",
          "text": "37 CFR 1.7(a): exclude the trigger date {trigger}"
        },
        {
          "op": "count",
          "periods": [
            {
              "unit": "calendar",
              "count": "calendar",
              "text": "37 CFR 1.7(a): count {n} calendar day(s) {after} the anchor -> {date}"
            },
            {
              "unit": "court",
              "count": "business",
              "text": "37 CFR 1.7(a): count {n} court day(s) {forward}, skipping weekends and holidays -> {date}"
            }
          ]
        },
        {
          "op": "roll",
          "forward": {
            "toward": "later",
            "text": "37 CFR 1.7(a): the last day is a weekend or legal holiday; roll forward -> {date}"
          },
          "backward": {
            "toward": "earlier",
            "text": "37 CFR 1.7(a): the last day is a weekend or legal holiday; roll backward -> {date}"
          }
        },
        {
          "op": "base"
        }
      ],
      "months": {
        "endOfMonth": "clamp",
        "text": "37 CFR 1.7(a): count {n} {unit} {after} the anchor to the corresponding day, else the last day of that month -> {date}"
      }
    }
  ]
