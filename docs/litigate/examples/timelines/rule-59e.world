# Alternate timelines for the Rule 59(e) matter (rule-59e.case):
# the 2007 base, with the 2009 amendment as a choice point. `litigate worlds`
# runs the matter in each world: without the amendment the motion is late,
# with it timely. A world without the amendment after December 1, 2009 is
# not the law, so the world is counterfactual.
modality = "counterfactual"
layers = ["change-frcp-base"]

[location]
family = "district-civil"
court = "d-sdny"
circuit = "ca2"

[choice.rule-59e-2009]
without = []
with = ["change-frcp-2009-amendment"]
