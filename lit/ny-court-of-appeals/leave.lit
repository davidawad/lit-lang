module ny-court-of-appeals-civil.leave

import ny-state-rules.{ ReviewPetitionFiled }

// Leave to appeal sought in the Court of Appeals from a civil order of the
// Appellate Division, from the movant's side. Every period is stated in a
// note, not counted. The merits of the appeal are not modeled: 22 NYCRR
// Part 500 is not vendored.

start motion

decision motion: "Motion in the Court of Appeals for leave to appeal?" by applicant cite "CPLR 5602(a)"
{
  note "An appeal may be taken to the Court of Appeals by permission of the Appellate Division granted before application to the Court of Appeals, or by permission of the Court of Appeals upon refusal by the Appellate Division or upon direct application (CPLR 5602(a)). In an action originating in the supreme court the appeal lies from an order of the Appellate Division which finally determines the action and is not appealable as of right, or from a final judgment where the Appellate Division has made an order on a prior appeal which necessarily affects it (CPLR 5602(a)(1)). The motion must be made within thirty days, computed from service by a party of a copy of the order and written notice of its entry, or, where the Appellate Division has already denied permission, of a copy of that order and written notice of its entry; when the movant served the copy and notice, the time runs from that service (CPLR 5513(b)). A party served with the adverse party's motion papers may move within ten days after that service or within the thirty days, whichever is longer (CPLR 5513(c)). Service by mail or overnight delivery adds the days CPLR 2103(b)(2) and (6) provide (CPLR 5513(d)); CPLR 2103 is not vendored and the days are not stated. The outline named no leading decision on the grant standard; none is kept."
  edge-motion-none "No motion: the Appellate Division order stands" -> no-motion { authority cite "CPLR 5513(b)" }
  edge-motion-made "Motion for leave made" -> leave-decided { event ReviewPetitionFiled() authority cite "CPLR 5602(a)" }
}

decision leave-decided: "Leave to appeal decided" by court cite "CPLR 5602(a)"
{
  note "Permission by the Court of Appeals is granted pursuant to rules authorized by the court, which provide that leave be granted upon the approval of two judges of the court (CPLR 5602(a)). Those rules (22 NYCRR Part 500) are not vendored: the form of the motion papers, the answering time and the grounds the court considers are not stated."
  edge-leave-decided-denied "Leave denied" -> leave-denied { authority cite "CPLR 5602(a)" }
  edge-leave-decided-granted "Leave granted" -> leave-granted { authority cite "CPLR 5602(a)" }
}

terminal no-motion: "No motion: the Appellate Division order stands" outcome [final] cite "CPLR 5513(b)"
{
  note "Once the thirty days of CPLR 5513(b) have run without a motion, no appeal by permission lies from the order."
}

terminal leave-denied: "Leave to appeal denied" outcome [final, loss] cite "CPLR 5602(a)"
{
  note "The Appellate Division order stands. Federal certiorari (28 U.S.C. § 1257) is not vendored and not modeled."
}

terminal leave-granted: "Leave to appeal granted" outcome [appeal] cite "CPLR 5602(a)"
{
  note "The appeal proceeds in the Court of Appeals under 22 NYCRR Part 500, which is not vendored; the merits are not modeled."
}
