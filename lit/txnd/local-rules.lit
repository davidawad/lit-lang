module txnd-local-rules.local-rules

import core.authority.{ CaseOrder }
import core.frcp6.{ frcp6 }

// The Northern District of Texas's own civil periods and limits, counted
// under FRCP 6. Unless another local rule controls or the presiding judge
// directs otherwise, motion practice follows LR 7.1. A paper filed by
// electronic means before midnight central time is deemed filed that day
// (LR 6.1). No trigger carries a service method: FRCP 6(d)'s three added
// days follow the manner of service, which is not modeled here; the
// motion periods here run from filing, not service.
//
// Rules that state no period or limit this layer can count stay in notes:
// the conference and certificate of conference (LR 7.1(a), (b)); a brief
// over ten pages needs tables of contents and authorities (LR 7.2(d)); no
// oral argument on a motion unless the judge directs (LR 7.1(g)); a party
// may file no more than one summary judgment motion unless the judge
// directs or law permits (LR 56.2(b)); the response brief to objections
// to a magistrate judge's recommendation states no period of its own (LR
// 72.2(b)), since FRCP 72(b)(2) sets it; and the prompt notice of a
// changed address or name (LR 83.13). LR 55.1 lets the presiding judge
// require a plaintiff to move for default and default judgment once a
// defendant has been in default for 90 days, within a time the judge
// prescribes; the 90 days are a condition of the judge's power, not a
// party's deadline, and are stated here only.
//
// The earlier N.D. Tex. outline's FRCP flow belongs to lit/frcp and
// lit/frap; its Supreme Court decisions (Twombly, Iqbal, Frow v. De La
// Vega, Celotex, Anderson v. Liberty Lobby, Matsushita) are FRCP authority,
// and no reporter text is vendored, so they are removed here.
/// A brief, unless another local civil rule provides otherwise: at most 25
/// pages, excluding the table of contents and table of authorities;
/// permission to exceed it is granted only for extraordinary and
/// compelling reasons (N.D. Tex. LR 7.2(c)).
limit brief { pages <= 25 cite "N.D. Tex. LR 7.2(c)" } cite "N.D. Tex. LR 7.2(c)"
/// A reply brief: at most 10 pages (N.D. Tex. LR 7.2(c)).
limit reply-brief { pages <= 10 cite "N.D. Tex. LR 7.2(c)" } cite "N.D. Tex. LR 7.2(c)"
/// A principal brief supporting or opposing a summary judgment motion: at
/// most 50 pages, excluding the tables; the presiding judge may set fewer
/// (N.D. Tex. LR 56.5(b)).
limit summary-judgment-brief { pages <= 50 cite "N.D. Tex. LR 56.5(b)" } cite "N.D. Tex. LR 56.5(b)"

/// A summary judgment reply brief: at most 25 pages (N.D. Tex. LR
/// 56.5(b)).
limit summary-judgment-reply-brief {
  pages <= 25 cite "N.D. Tex. LR 56.5(b)"
} cite "N.D. Tex. LR 56.5(b)"

/// In a post-conviction proceeding to vacate or set aside a death
/// sentence, the application, motion or petition with any supporting brief
/// or memorandum, or the answer with its brief: at most 100 pages in total,
/// excluding the tables (N.D. Tex. LR 7.5(a), (b)).
limit capital-habeas-petition { pages <= 100 cite "N.D. Tex. LR 7.5" } cite "N.D. Tex. LR 7.5"
/// The reply in such a proceeding, with any supporting brief or
/// memorandum: at most 25 pages in total (N.D. Tex. LR 7.5(c)).
limit capital-habeas-reply { pages <= 25 cite "N.D. Tex. LR 7.5" } cite "N.D. Tex. LR 7.5"

/// An attorney, other than a prisoner pro se party, appears in a case (N.D.
/// Tex. LR 5.1(f)).
event AttorneyAppeared()
/// An opposed motion is filed (N.D. Tex. LR 7.1(e)).
event OpposedMotionFiled()
/// The response to an opposed motion is filed (N.D. Tex. LR 7.1(f)).
event ResponseFiled()
/// The scheduled date for trial (N.D. Tex. LR 16.4, 26.2, 52.1, 56.2).
event TrialDate()
/// A class action complaint is filed (N.D. Tex. LR 23.2).
event ClassComplaintFiled()
/// Objections or a motion under FRCP 53(f)(2) concerning a master's order,
/// report or recommendation are filed (N.D. Tex. LR 53.1(b)).
event MasterObjectionsFiled()
/// The response brief to objections or a motion under FRCP 53(f)(2) is
/// filed (N.D. Tex. LR 53.1(c)).
event MasterResponseFiled()
/// The clerk enters on the docket a final judgment, or a judgment the
/// presiding judge directs be entered as final under FRCP 54(b), awarding
/// costs (N.D. Tex. LR 54.1).
event CostsJudgmentDocketed()
/// An order transferring the case to a district court outside the Fifth
/// Circuit is entered on the docket without all affected parties' consent
/// (N.D. Tex. LR 62.2).
event TransferOrderEntered()
/// Objections under FRCP 72(a) to a magistrate judge's order in a
/// nondispositive matter are filed (N.D. Tex. LR 72.1(b)).
event NondispositiveObjectionsFiled()
/// The response brief to objections under FRCP 72(a) or 72(b)(2) is filed
/// (N.D. Tex. LR 72.1(c), 72.2(c)).
event MagistrateResponseFiled()
/// The case is finally disposed of (N.D. Tex. LR 79.2(b), 79.4).
event FinalDisposition()
/// A notice of removal is filed (N.D. Tex. LR 81.2).
event RemovalNoticeFiled()

/// N.D. Tex. LR 5.1(f): unless excused for cause, an attorney other than a
/// prisoner pro se party registers as an ECF user within 14 days of the
/// date the attorney appears in a case.
deadline ecf-registration-period: 14.days after AttorneyAppeared() counted_by frcp6 cite "N.D. Tex. LR 5.1(f)"
{
  forum frcp
}

/// N.D. Tex. LR 7.1(e): a response and brief to an opposed motion are
/// filed within 21 days from the date the motion is filed.
deadline response-period: 21.days after OpposedMotionFiled() counted_by frcp6 delegable {
  to CaseOrder
  op set
} cite "N.D. Tex. LR 7.1(e)"
{
  forum frcp
}

/// N.D. Tex. LR 7.1(f): unless the presiding judge directs otherwise, the
/// movant may file a reply brief within 14 days from the date the response
/// is filed.
deadline reply-period: 14.days after ResponseFiled() counted_by frcp6 delegable {
  to CaseOrder
  op set
} cite "N.D. Tex. LR 7.1(f)"
{
  forum frcp
}

/// N.D. Tex. LR 16.4: unless the presiding judge directs otherwise, the
/// pretrial order, prepared by all attorneys, is submitted at least 14 days
/// before the scheduled date for trial.
deadline pretrial-order-period: 14.days before TrialDate() counted_by frcp6 delegable {
  to CaseOrder
  op set
} cite "N.D. Tex. LR 16.4"
{
  forum frcp
}

/// N.D. Tex. LR 23.2: within 90 days of filing a class action complaint,
/// or at such other time as the presiding judge orders, the plaintiff's
/// attorney moves for certification, with a brief setting out what the
/// rule lists.
deadline class-certification-period: 90.days after ClassComplaintFiled() counted_by frcp6 delegable {
  to CaseOrder
  op set
} cite "N.D. Tex. LR 23.2"
{
  forum frcp
}

/// N.D. Tex. LR 26.2(a): every exhibit a party intends to offer at trial,
/// other than for impeachment, is marked and exchanged with opposing
/// parties at least 14 days before the scheduled date for trial.
deadline exhibit-exchange-period: 14.days before TrialDate() counted_by frcp6 cite "N.D. Tex. LR 26.2(a)"
{
  forum frcp
}

/// N.D. Tex. LR 26.2(b): at least 14 days before the scheduled trial date,
/// the parties file and deliver separate lists of exhibits and witnesses.
deadline exhibit-witness-list-period: 14.days before TrialDate() counted_by frcp6 cite "N.D. Tex. LR 26.2(b)"
{
  forum frcp
}

/// N.D. Tex. LR 26.2(c): the portions of any depositions to be offered at
/// trial are designated in lists delivered and filed at least 14 days
/// before the scheduled trial date.
deadline deposition-designation-period: 14.days before TrialDate() counted_by frcp6 cite "N.D. Tex. LR 26.2(c)"
{
  forum frcp
}

/// N.D. Tex. LR 52.1: unless the presiding judge directs otherwise, at
/// least 14 days before trial in a nonjury case each party files and serves
/// proposed findings of fact and conclusions of law.
deadline proposed-findings-period: 14.days before TrialDate() counted_by frcp6 delegable {
  to CaseOrder
  op set
} cite "N.D. Tex. LR 52.1"
{
  forum frcp
}

/// N.D. Tex. LR 53.1(b): a response brief to objections or a motion under
/// FRCP 53(f)(2) is filed within 21 days from the date the objections or
/// motion is filed.
deadline master-response-period: 21.days after MasterObjectionsFiled() counted_by frcp6 cite "N.D. Tex. LR 53.1(b)"
{
  forum frcp
}

/// N.D. Tex. LR 53.1(c): unless the presiding judge directs otherwise, the
/// objecting party may file a reply brief within 14 days from the date the
/// response brief is filed.
deadline master-reply-period: 14.days after MasterResponseFiled() counted_by frcp6 delegable {
  to CaseOrder
  op set
} cite "N.D. Tex. LR 53.1(c)"
{
  forum frcp
}

/// N.D. Tex. LR 54.1: unless a statute or the presiding judge provides
/// otherwise, the bill of costs, in a form the clerk approves, is filed and
/// served no later than 14 days after the clerk enters the judgment on the
/// docket.
deadline bill-of-costs-period: 14.days after CostsJudgmentDocketed() counted_by frcp6 delegable {
  to CaseOrder
  op set
} cite "N.D. Tex. LR 54.1"
{
  forum frcp
}

/// N.D. Tex. LR 56.2(a): unless the presiding judge directs otherwise, no
/// summary judgment motion may be filed within 90 days of the trial
/// setting.
deadline summary-judgment-cutoff: 90.days before TrialDate() counted_by frcp6 delegable {
  to CaseOrder
  op set
} cite "N.D. Tex. LR 56.2(a)"
{
  forum frcp
}

/// N.D. Tex. LR 62.2: unless all affected parties consent, an order
/// transferring a case to a district court outside the Fifth Circuit is
/// stayed for 21 days from the date it is entered on the docket.
deadline transfer-stay-period: 21.days after TransferOrderEntered() counted_by frcp6 cite "N.D. Tex. LR 62.2"
{
  forum frcp
}

/// N.D. Tex. LR 72.1(b): a response brief to objections under FRCP 72(a)
/// is filed within 21 days from the date the objections are filed.
deadline nondispositive-objection-response-period: 21.days after NondispositiveObjectionsFiled() counted_by frcp6 cite "N.D. Tex. LR 72.1(b)"
{
  forum frcp
}

/// N.D. Tex. LR 72.1(c), 72.2(c): unless the presiding judge directs
/// otherwise, the objecting party may file a reply brief within 14 days
/// from the date the response brief is filed.
deadline magistrate-objection-reply-period: 14.days after MagistrateResponseFiled() counted_by frcp6 delegable {
  to CaseOrder
  op set
} cite "N.D. Tex. LR 72.1(c)"
{
  forum frcp
}

/// N.D. Tex. LR 79.2(b): every exhibit in the court's custody is removed
/// from the clerk's office within 60 days after final disposition of the
/// case, by the attorney who introduced it; one not removed may be
/// destroyed or otherwise disposed of by the clerk.
deadline exhibit-removal: 60.days after FinalDisposition() counted_by frcp6 cite "N.D. Tex. LR 79.2(b)"
{
  forum frcp
}

/// N.D. Tex. LR 79.4: unless the presiding judge directs otherwise, a
/// sealed document kept on paper is deemed unsealed 60 days after final
/// disposition of the case; a party who wants it to stay sealed moves
/// before the period expires.
deadline keep-sealed-motion-period: 60.days after FinalDisposition() counted_by frcp6 cite "N.D. Tex. LR 79.4"
{
  forum frcp
}

/// N.D. Tex. LR 81.2: within 21 days after the notice of removal is filed,
/// the plaintiff files a separately signed certificate of interested
/// persons, or adopts another party's previously filed certificate.
deadline removal-certificate-period: 21.days after RemovalNoticeFiled() counted_by frcp6 cite "N.D. Tex. LR 81.2"
{
  forum frcp
}
