start motion-filed

state motion-filed: "Request for relief filed with notice of opportunity for hearing" by applicant cite "W.D. Okla. LBR 9013-1(G)"
{
  note "The title includes 'And Notice of Opportunity for Hearing'; the response time runs a flat number of days from the docket entry regardless of the manner of service, calculated by the movant from the statute, rule or order (LBR 9013-1(G)); a brief accompanies it (LBR 9013-1(C)). The motion's FRBP periods are lit/frbp's."
  edge-motion-filed-opposed "Response filed within the response period" -> opposed {
    authority cite "W.D. Okla. LBR 9013-1(G)"
  }
  edge-motion-filed-unopposed "No response; relief deemed confessed" -> ruling {
    authority cite "W.D. Okla. LBR 9013-1(G)"
  }
}

state opposed: "Response filed; hearing if the court orders one" by opponent cite "W.D. Okla. LBR 9013-1(G)"
{
  note "Hearings are not conducted routinely unless requested or required; a reply to a new matter may follow within five days (LBR 9013-1(C), (F)). A party presenting evidence files its notice seven days after the initial response deadline (LBR 9014-1)."
  edge-opposed-ruling "Hearing held" -> ruling { authority cite "W.D. Okla. LBR 9013-1(F)" }
}

decision ruling: "Motion decided" by court cite "W.D. Okla. LBR 9013-1(G)"
{
  note "A request not opposed within the response period may be deemed confessed and granted ex parte; the proposed order is uploaded within thirty days after the deadline (LBR 9013-1(E), (L))."
  edge-ruling-granted "Granted" -> decided { authority cite "W.D. Okla. LBR 9013-1(G)" }
  edge-ruling-denied "Denied" -> decided { authority cite "W.D. Okla. LBR 9013-1(G)" }
}

terminal decided: "Matter decided: the case continues under lit/frbp" outcome [procedural] cite "W.D. Okla. LBR 1001-1"
