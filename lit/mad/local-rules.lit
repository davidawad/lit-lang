{
  given DismissalHearingHeld() on 2027-02-02
  expect deadline(dismissal-calendar-certificate-period) == 2027-01-19
}

test "settlement filing period: 28 days after the trigger" cite "D. Mass. L.R. 68.2"
{
  given CaseSettled() on 2026-11-02
  expect deadline(settlement-filing-period) == 2026-11-30
}

