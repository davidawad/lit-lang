// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-outline-nj-state-appellate

start notice-filed

state notice-filed: "Notice of appeal filed" by applicant cite ?("N.J. Ct. R. 2:5-1(a)")
{
  note "OUTLINE. Notice in the trial court; period, service and cross-appeal are holes. Appeal from a final judgment: N.J. Ct. R. 2:2-3(a) (verify). Harmless error: N.J. Ct. R. 2:10-2 (verify)."
  edge-notice-record "Record prepared" -> record {
    authority cite ?("N.J. Ct. R. 2:5-3 (verify)")
  }
}

state record: "Record or transcript prepared" by office cite ?("N.J. Ct. R. 2:5-3 (verify)")
{
  note "OUTLINE. Record contents, transcript and stays are holes. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-record-brief "Briefing" -> briefing {
    authority cite ?("N.J. Ct. R. 2:6-2 (verify)")
  }
}

state briefing: "Briefs filed" by applicant cite ?("N.J. Ct. R. 2:6-2 (verify)")
{
  note "OUTLINE. Brief form, length and reply are holes. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-brief-argument "Argument or submission" -> argument {
    authority cite ?("N.J. Ct. R. 2:11-1 (verify)")
  }
}

decision argument: "Argument or submission" by court cite ?("N.J. Ct. R. 2:11-1 (verify)")
{
  note "OUTLINE. Argument is discretionary in some courts. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-arg-decision "Decision issued" -> decision {
    authority cite ?("N.J. Ct. R. 2:11-3 (verify)")
  }
}

chance decision: "Court decides" by court cite ?("N.J. Ct. R. 2:11-3 (verify)")
{
  note "OUTLINE. Probabilities are holes. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-dec-affirmed "Affirmed" -> post-decision p ? {
  }
  edge-dec-reversed "Reversed or remanded" -> post-decision p ? {
  }
}

decision post-decision: "Rehearing or further review decision" by applicant cite ?("N.J. Ct. R. 2:11-6 (verify)")
{
  note "OUTLINE. Rehearing and further review: N.J. Ct. R. 2:12-3 (notice of petition); N.J. Ct. R. 2:12-7 (petition). Petition for certification: N.J. Ct. R. 2:12-4 (verify) governs grant standards."
  edge-pd-rehearing "Rehearing sought" -> rehearing {
    authority cite ?("N.J. Ct. R. 2:11-6 (verify)")
  }
  edge-pd-further "Further review sought" -> further-review {
    authority cite ?("N.J. Ct. R. 2:12-3 (notice of petition); N.J. Ct. R. 2:12-7 (petition)")
  }
  edge-pd-mandate "No further review" -> mandate-issued {
    authority cite ?("N.J. Ct. R. 2:9-5 (verify)")
  }
}

state rehearing: "Rehearing petition" by applicant cite ?("N.J. Ct. R. 2:11-6 (verify)")
{
  note "OUTLINE. Rehearing period and effect on finality are holes."
  edge-rh-decision "Rehearing decided" -> post-decision {
  }
}

state further-review: "Petition for further review" by applicant cite ?("N.J. Ct. R. 2:12-3 (notice of petition); N.J. Ct. R. 2:12-7 (petition)")
{
  note "OUTLINE. Petition period and grant standard are holes. Petition for certification: N.J. Ct. R. 2:12-4 (verify) governs grant standards."
  edge-fr-mandate "Review denied" -> mandate-issued {
  }
  edge-fr-merits "Review granted" -> supreme-merits {
  }
}

terminal mandate-issued: "Mandate or remittitur issued" outcome [final] cite ?("N.J. Ct. R. 2:9-5 (verify)")
{
  note "OUTLINE. Mandate or remittitur returns the case to the trial court. Costs: holes."
  payoff ?
}

terminal supreme-merits: "Review granted on the merits" outcome [final] cite ?("N.J. Ct. R. 2:12-3 (notice of petition); N.J. Ct. R. 2:12-7 (petition)")
{
  note "OUTLINE. Merits review in the highest state court. Outcome is outside this outline."
  payoff ?
}

