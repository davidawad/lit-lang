state cbi-designated: "Material Designated CBI" by applicant cite cfr210.5.disclosure
{
  group discovery-group
  note "Confidential business information is defined per 19 CFR 201.6(a),(c). Properly designated CBI cannot be disclosed without submitter consent except to persons granted access under a 210.34(a) protective order, Commission staff directly administering the investigation, U.S. officers conducting § 1337(j) review, or CBP officers administering an exclusion."
  _ "Move for a Protective Order (Rule 210.34(a))" -> protective-order-ruling {
    authority cite cfr210.34.a
    effort 10.hours
    cost 4_000.usd
    valence good
    action_id "file.motion.protective-order"
  }
}

