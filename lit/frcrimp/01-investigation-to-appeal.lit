/// imported
state arrest: "Arrest / Warrant or Summons Executed" by office delegable_to [CaseOrder] cite ?("Fed. R. Crim. P. 4, 5(a); 18 U.S.C. § 3501(c)") effective [2024-12-01, ..) {
  group charging-group
  note "Defendant must be brought before a magistrate 'without unnecessary delay' — the McNabb-Mallory rule, now codified at 18 U.S.C. § 3501(c). Violation is not itself unconstitutional but triggers suppression of statements as the remedy; there is no bright-line federal day count."
  _ "Bring defendant before magistrate" -> initial-appearance {
    authority cite Fed. R. Crim. P. 5(a); 18 U.S.C. § 3501(c)
    deadline 3.days {
      extendable true
      extension_authority "Court may extend based on 'all the facts and circumstances' (Rule 5 advisory committee notes) — e.g. weather, distance"
      note "Standard is 'without unnecessary delay' (McNabb-Mallory), not a fixed day count; often ~72 hours in practice but no bright-line federal rule. Violation triggers suppression of statements, not invalidation of the arrest."
    }
    duration { min 0.5.days, mode 1.5.days, max 3.days }
  }
  _ "File information" -> information-filed by applicant {
    authority cite Fed. R. Crim. P. 7(b)
    effort 4.hours
    cost 0.usd
    note "Hours: BigLaw-honest estimate for the effort of this move; basis: estimate. No filing fee: as with a criminal complaint, 28 U.S.C. § 1914(a)'s civil filing fee doesn't apply, and Fed. R. Crim. P. 7 imposes none."
  }
}

/// imported
