// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-wi-state-civil

start complaint-filed

state complaint-filed: "Action commenced" by applicant cite ?("Wis. Stat. § 801.02")
{
  note "OUTLINE. Commencement by filing summons and complaint (verify). Wisconsin uses notice pleading (verify)."
  edge-complaint-filed-response-due "Summons served" -> response-due {
    authority cite ?("Wis. Stat. § 801.11")
  }
}

state response-due: "Response due: answer or motion" cite ?("Wis. Stat. § 802.06(1)")
{
  note "OUTLINE. Response period is a hole. Section 802.06(2) defenses; response period is a hole."
  edge-response-due-default-entered "No timely response" -> default-entered {
    authority cite ?("Wis. Stat. § 806.02")
  }
  edge-response-due-motion-ruling "Motion to dismiss filed" -> motion-ruling {
    authority cite ?("Wis. Stat. § 802.06(2)")
  }
  edge-response-due-sched "Answer filed" -> sched {
    authority cite ?("Wis. Stat. § 802.06(1)")
  }
}

decision motion-ruling: "Motion to dismiss ruling" by court cite ?("Wis. Stat. § 802.06(2)")
{
  note "OUTLINE. Data Key Partners v. Permira Advisers LLC, 2014 WI 86 (notice pleading; verify)."
  edge-motion-ruling-dismissed-with-prejudice "Dismissed with prejudice" -> dismissed-with-prejudice {
    authority cite ?("Wis. Stat. § 805.17(2)")
  }
  edge-motion-ruling-response-due "Dismissed with leave to amend" -> response-due {
    authority cite ?("Wis. Stat. § 802.09")
  }
  edge-motion-ruling-sched "Denied" -> sched {
    authority cite ?("Wis. Stat. § 802.06(2)")
  }
}

state sched: "Scheduling order and initial disclosures" cite ?("Wis. Stat. § 802.10")
{
  note "OUTLINE. Scheduling under 802.10 (verify)."
  edge-sched-discovery "Order entered" -> discovery {
    authority cite ?("Wis. Stat. § 802.10")
  }
}

state discovery: "Discovery" cite ?("Wis. Stat. §§ 804.01, 804.08, 804.09, 804.11")
{
  note "OUTLINE. Discovery scope and methods under chapter 804 (verify); county rules are holes."
  edge-discovery-sj-ruling "Dispositive motion filed" -> sj-ruling {
    authority cite ?("Wis. Stat. § 802.08(2)")
  }
  edge-discovery-dismissed-with-prejudice "Discovery sanction dismisses claims" -> dismissed-with-prejudice {
    authority cite ?("Wis. Stat. § 804.12")
  }
  edge-discovery-settled "Settlement or voluntary dismissal" -> settled {
    authority cite ?("Wis. Stat. § 805.04")
  }
  edge-discovery-pretrial "No dispositive motion" -> pretrial {
    authority cite ?("Wis. Stat. § 802.10")
  }
}

decision sj-ruling: "Summary judgment ruling" by court cite ?("Wis. Stat. § 802.08(2)")
{
  note "OUTLINE. Lambrecht v. Estate of Kaczmarczyk, 2001 WI 25 (summary judgment; verify)."
  edge-sj-ruling-judgment-applicant "Granted for applicant" -> judgment-applicant {
    authority cite ?("Wis. Stat. § 806.01")
  }
  edge-sj-ruling-judgment-opponent "Granted for opponent" -> judgment-opponent {
    authority cite ?("Wis. Stat. § 806.01")
  }
  edge-sj-ruling-pretrial "Denied" -> pretrial {
    authority cite ?("Wis. Stat. § 802.08(2)")
  }
}

state pretrial: "Pretrial order" cite ?("Wis. Stat. § 802.10")
{
  note "OUTLINE. Pretrial conference, order and trial setting."
  edge-pretrial-trial "Trial set" -> trial {
    authority cite ?("Wis. Stat. § 802.10")
  }
}

state trial: "Trial (jury or bench)" cite ?("Wis. Stat. ch. 805")
{
  note "OUTLINE. Trial and findings or verdict."
  edge-trial-judgment-applicant "Verdict or findings for applicant" -> judgment-applicant {
    authority cite ?("Wis. Stat. § 806.01")
  }
  edge-trial-judgment-opponent "Verdict or findings for opponent" -> judgment-opponent {
    authority cite ?("Wis. Stat. § 806.01")
  }
}

state judgment-applicant: "Judgment for applicant entered" cite ?("Wis. Stat. § 806.01")
{
  note "OUTLINE. Entry of judgment. Post-verdict and post-judgment motions under chapter 805 and 806.07 (verify)."
  edge-judgment-applicant-post-judgment-ruling "Post-judgment motion" -> post-judgment-ruling {
    authority cite ?("Wis. Stat. §§ 805.14, 805.15, 806.07")
  }
  edge-judgment-applicant-appellate-review "Notice of appeal filed" -> appellate-review {
    authority cite ?("Wis. Stat. § 809.10(1)")
  }
  edge-judgment-applicant-final-win "No appeal within time" -> final-win {
    authority cite ?("Wis. Stat. §§ 808.04, 809.10(1)")
  }
}

state judgment-opponent: "Judgment for opponent entered" cite ?("Wis. Stat. § 806.01")
{
  note "OUTLINE. Entry of judgment. Post-verdict and post-judgment motions under chapter 805 and 806.07 (verify)."
  edge-judgment-opponent-post-judgment-ruling "Post-judgment motion" -> post-judgment-ruling {
    authority cite ?("Wis. Stat. §§ 805.14, 805.15, 806.07")
  }
  edge-judgment-opponent-appellate-review "Notice of appeal filed" -> appellate-review {
    authority cite ?("Wis. Stat. § 809.10(1)")
  }
  edge-judgment-opponent-final-loss "No appeal within time" -> final-loss {
    authority cite ?("Wis. Stat. §§ 808.04, 809.10(1)")
  }
}

decision post-judgment-ruling: "Post-judgment motion ruling" by court cite ?("Wis. Stat. §§ 805.14, 805.15, 806.07")
{
  note "OUTLINE. Post-judgment motions toll the appeal clock; verify tolling rule."
  edge-post-judgment-ruling-pretrial "Granted: new trial" -> pretrial {
    authority cite ?("Wis. Stat. §§ 805.14, 805.15, 806.07")
  }
  edge-post-judgment-ruling-appellate-review "Denied: appeal clock runs from order" -> appellate-review {
    authority cite ?("Wis. Stat. §§ 808.04, 809.10(1)")
  }
}

terminal default-entered: "Default entered against opponent" outcome [win] cite ?("Wis. Stat. § 806.02")
{
  note "OUTLINE. Default under the rule; judgment by default is a separate entry. Outcome is from the applicant's side."
  payoff ?
}

terminal dismissed-with-prejudice: "Dismissed with prejudice" outcome [loss] cite ?("Wis. Stat. § 805.17(2)")
{
  note "OUTLINE. Outcome from the applicant's side."
  payoff ?
}

terminal settled: "Settled or voluntarily dismissed" outcome [settlement] cite ?("Wis. Stat. § 805.04")
{
  note "OUTLINE. Settlement terms are a hole."
  payoff ?
}

terminal final-win: "Final judgment for applicant, no appeal" outcome [win] cite ?("Wis. Stat. §§ 808.04, 809.10(1)")
{
  note "OUTLINE. Judgment final when the appeal period lapses."
  payoff ?
}

terminal final-loss: "Final judgment for opponent, no appeal" outcome [loss] cite ?("Wis. Stat. §§ 808.04, 809.10(1)")
{
  note "OUTLINE. Judgment final when the appeal period lapses."
  payoff ?
}

terminal appellate-review: "Appeal taken: continue in the appellate package" cite ?("Wis. Stat. § 809.10(1)")
{
  note "OUTLINE. Hand-off to the state-appellate or court-of-appeals package."
  payoff ?
}
