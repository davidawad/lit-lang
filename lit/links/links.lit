// Cross-forum composition (SPEC §8.4): the links that carry a matter from a
// trial forum into the Federal Circuit or a regional circuit and back on
// remand, and the `cafc@<origin>` instances they route through, one section
// per origin in packs/links.json's link order, after the one period the
// instances author themselves.
//
// One module, as `litigate import` writes it (SPEC §8.7): lowering orders
// modules by the file of their first declaration's span, and links and
// instances carry none, so link-only modules would fall back to name order
// and reorder the links.
module links

import cafc.{ Entered, Order }
import core.frap26.{ frap26 }

/// FRAP 40(d)(1) gives 14 days to petition for rehearing, but 45 days in a
/// civil case when the United States, a United States agency, or a federal
/// officer is a party; Fed. Cir. R. 40(f)(1) lengthens the general period
/// to 30 days and keeps 45 for those cases. lit/cafc's `rehearing-period`
/// is the 30-day branch. This is the 45-day branch, which the `cafc@cofc`,
/// `cafc@cofc-gov` and `cafc@itc` instances set on `rehearing-file` and
/// `rehearing-time-expires` by patch: the United States is a party to every
/// Court of Federal Claims appeal, and the Commission, an agency, to every
/// Section 337 appeal. A patch is a JSON merge patch, so it repeats the
/// length (45) instead of naming this declaration; the tests below pin the
/// due dates it produces under FRAP 26(a). FRAP 40(d)(1) lets an order
/// shorten or extend either period; lit/cafc's `rehearing-period` records
/// that as `delegable_to [CaseOrder]`, but a links package has no authority
/// level of its own to delegate from (L3004), so this declaration does not.
rule duty rehearing-united-states-party cite Fed. Cir. R. 40(f)(1)
{
  deadline rehearing-period-united-states-party: 45.days after Entered(PanelJudgment) counted_by frap26 effective [2025-12-01, ..) known_at 2025-12-01 cite Fed. Cir. R. 40(f)(1); FRAP 40(d)(1)(A); FRAP 40(d)(1)(B)
}

test "a rehearing petition is due 45 days after judgment when the United States is a party" cite Fed. Cir. R. 40(f)(1)
{
  given Entered(PanelJudgment) on 2026-03-02
  expect deadline(rehearing-period-united-states-party) == 2026-04-16
}

test "a 45th day on a Saturday rolls the rehearing petition to Monday" cite FRAP 26(a)(1)(C)
{
  given Entered(PanelJudgment) on 2026-01-21
  expect deadline(rehearing-period-united-states-party) == 2026-03-09
}

test "a 45th day on Labor Day rolls the rehearing petition to Tuesday" cite FRAP 26(a)(6)(A)
{
  given Entered(PanelJudgment) on 2026-07-24
  expect deadline(rehearing-period-united-states-party) == 2026-09-08
}

// -------------------------------------------------------------------------
// Court of Federal Claims <-> Federal Circuit. 28 U.S.C. § 1295(a)(3) gives
// the Federal Circuit exclusive jurisdiction of appeals from final CoFC
// decisions; § 2522 sets the notice of appeal at 60 days after judgment
// (lit/cafc's `cofc-noa-period`); § 2106 empowers the remand. The United
// States defends every CoFC case, so each side's appeal enters its own
// instance: `cafc@cofc` (the plaintiff appeals a loss) and `cafc@cofc-gov`
// (the government appeals a plaintiff's win, perspective flipped).
//
// The appeal authorities stay cite holes carrying the legacy text verbatim:
// `28 U.S.C. §§ 1295(a)(3), 2522` has a comma, which ends citation mode, so
// it has no `CiteText` spelling (SPEC §2) and any respelling would change
// the generated `authority` string.
/// The plaintiff's appeal. Only `origin-to-cofc` and `remand-route-cofc`
/// survive. The rehearing patches set the 45-day United States-party
/// period (`rehearing-period-united-states-party`).
///
/// Proposed fix, not applied (it would change the generated note): the
/// `rehearing-time-expires` note pins the 45 days on Fed. Cir. R. 40(a)(1);
/// in the vendored Dec. 1, 2025 rules the time is Fed. Cir. R. 40(f)(1),
/// and 40(a)(1) is the general rehearing provision.
instance cafc@cofc {
  pack cafc
  note "Federal Circuit as entered by the CoFC plaintiff appealing a loss (plaintiff = appellant = self). Remand can only return to the CoFC."
  remove_edges [origin-to-district-court, origin-to-ptab, origin-to-itc, remand-route-district-court, remand-route-ptab, remand-route-itc, origin-to-ttab, remand-route-ttab]
  probabilities { remand-route-cofc: 1 }
  patch rehearing-file {
    deadline: {
      length: 45
      note: "45 days after entry of judgment because the United States is a party to every CoFC appeal (Fed. Cir. R. 40, Federal Circuit Rules of Practice Dec. 1, 2025: 30 days, or 45 if the United States or its officer or agency is a party)."
    }
  }
  patch rehearing-time-expires {
    deadline: {
      length: 45
      note: "The rehearing window this edge waits out is 45 days here, not 30, because the United States is a party (Fed. Cir. R. 40(a)(1)); the mandate then issues 7 days after it expires (FRAP 41(b))."
    }
  }
}

/// The government's appeal. Roles flip so the United States (`examiner`,
/// the appellant) is the opponent, and payoffs become the plaintiff's under
/// `1000000 - payoff`: the $1M stake is the legacy placeholder, which a
/// matter overrides with its own stakes. Same rehearing patches and same
/// proposed note fix as `cafc@cofc`.
instance cafc@cofc-gov {
  pack cafc
  note "Federal Circuit as entered by the United States appealing a CoFC plaintiff win. Perspective flipped: the government (appellant) is the opponent; payoffs are the plaintiff's (stake − appellant payoff, stake = $1M placeholder)."
  remove_edges [origin-to-district-court, origin-to-ptab, origin-to-itc, remand-route-district-court, remand-route-ptab, remand-route-itc, origin-to-ttab, remand-route-ttab]
  probabilities { remand-route-cofc: 1 }
  roles { applicant: opponent, examiner: self }
  payoff_transform "1000000 - payoff"
  patch rehearing-file {
    deadline: {
      length: 45
      note: "45 days after entry of judgment because the United States is a party to every CoFC appeal (Fed. Cir. R. 40, Federal Circuit Rules of Practice Dec. 1, 2025: 30 days, or 45 if the United States or its officer or agency is a party)."
    }
  }
  patch rehearing-time-expires {
    deadline: {
      length: 45
      note: "The rehearing window this edge waits out is 45 days here, not 30, because the United States is a party (Fed. Cir. R. 40(a)(1)); the mandate then issues 7 days after it expires (FRAP 41(b))."
    }
  }
}

/// A judgment for the United States after a bench trial (RCFC 52(a), 58) is
/// appealable by the plaintiff (28 U.S.C. § 1295(a)(3)).
link cofc-appeal-judgment-for-government "Plaintiff appeals the judgment to the Federal Circuit": cofc::judgment-for-government -> cafc@cofc::entry-cofc by applicant {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// Summary judgment for the United States (RCFC 56) is a final decision.
link cofc-appeal-sj-for-government "Plaintiff appeals the summary judgment": cofc::summary-judgment-for-government -> cafc@cofc::entry-cofc by applicant {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// A dismissal for lack of subject-matter jurisdiction (RCFC 12(b)(1)).
link cofc-appeal-dismissal-jurisdiction "Plaintiff appeals the RCFC 12(b)(1) dismissal": cofc::dismissed-lack-of-jurisdiction -> cafc@cofc::entry-cofc by applicant {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// A dismissal for failure to state a claim (RCFC 12(b)(6)).
link cofc-appeal-dismissal-failure-to-state "Plaintiff appeals the RCFC 12(b)(6) dismissal": cofc::dismissed-failure-to-state -> cafc@cofc::entry-cofc by applicant {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// A dismissal under the six-year limitation of 28 U.S.C. § 2501.
link cofc-appeal-time-bar "Plaintiff appeals the § 2501 time-bar dismissal": cofc::dismissed-time-barred -> cafc@cofc::entry-cofc by applicant {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// A dismissal under 28 U.S.C. § 1500 (same claim pending in another
/// court).
link cofc-appeal-1500-bar "Plaintiff appeals the § 1500 dismissal": cofc::dismissed-1500-bar -> cafc@cofc::entry-cofc by applicant {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// A bid-protest judgment under 28 U.S.C. § 1491(b) is appealed the same
/// way.
link cofc-appeal-protest-denied "Protester appeals the bid-protest judgment": cofc::protest-denied -> cafc@cofc::entry-cofc by applicant {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// The government's appeals enter `cafc@cofc-gov`, by `examiner` (the
/// United States, the opponent in the cofc package).
link cofc-gov-appeal-judgment-for-plaintiff "United States appeals the judgment for plaintiff": cofc::judgment-for-plaintiff -> cafc@cofc-gov::entry-cofc by examiner {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  note "The government's appeal decision (Solicitor General authorization, 28 C.F.R. § 0.20(b)) is modeled as the opponent's choice; with no probability authored it is solved adversarially (worst case for the plaintiff). Author a probability here to use an appeal rate instead."
  tags [appeal]
}

/// A judgment entered for the plaintiff on summary judgment.
link cofc-gov-appeal-sj-for-plaintiff "United States appeals the judgment entered for plaintiff": cofc::judgment-entered -> cafc@cofc-gov::entry-cofc by examiner {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// A sustained bid protest; an intervenor awardee may appeal as well.
link cofc-gov-appeal-protest-sustained "United States (or intervenor) appeals the sustained protest": cofc::protest-sustained -> cafc@cofc-gov::entry-cofc by examiner {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// 28 U.S.C. § 2106: a court of appellate jurisdiction may remand and
/// "require such further proceedings to be had as may be just under the
/// circumstances".
link cafc-remand-to-cofc "Remand: further proceedings in the Court of Federal Claims": cafc@cofc::remanded-to-cofc -> cofc::trial-bench by office p 1 {
  authority cite 28 U.S.C. § 2106
  note "Re-entry point modeled as further merits proceedings (bench trial). A remand on a narrower issue re-enters later; override with scenario.mask/start when the mandate is specific."
  tags [remand]
}

/// The same remand from the government's appeal.
link cafc-gov-remand-to-cofc "Remand: further proceedings in the Court of Federal Claims": cafc@cofc-gov::remanded-to-cofc -> cofc::trial-bench by office p 1 {
  authority cite 28 U.S.C. § 2106
  tags [remand]
}

// -------------------------------------------------------------------------
// PTAB <-> Federal Circuit. A party dissatisfied with an inter partes review
// final written decision may appeal (35 U.S.C. §§ 141(c), 319) to the court
// with exclusive jurisdiction of Board appeals (28 U.S.C. § 1295(a)(4)(A));
// the notice is due 63 days after the decision (37 C.F.R. § 90.3(a)(1),
// lit/cafc's `ptab-noa-period`).
//
// The appeal authority stays a cite hole carrying the legacy text: its
// comma (`§§ 141(c), 319`) has no `CiteText` spelling (SPEC §2).
/// The Federal Circuit as entered from a final written decision. Only
/// `origin-to-ptab` and `remand-route-ptab` survive. No rehearing patch:
/// the appellee is the other party to the review, so lit/cafc's 30-day
/// `rehearing-period` applies unless the Director intervenes (35 U.S.C.
/// § 143), which a matter models, not this instance.
instance cafc@ptab {
  pack cafc
  note "Federal Circuit as entered from a PTAB final written decision (35 U.S.C. §§ 141, 319). Remand can only return to the PTAB."
  remove_edges [origin-to-district-court, origin-to-itc, origin-to-cofc, remand-route-district-court, remand-route-itc, remand-route-cofc, origin-to-ttab, remand-route-ttab]
  probabilities { remand-route-ptab: 1 }
}

/// Replaces the PTAB pack's own abstract notice-of-appeal edge, so the
/// composed graph has one route into the Federal Circuit; either party may
/// take it, at the pack's 0.92 appeal rate.
link ptab-appeal-to-cafc "Appeal the final written decision to the Federal Circuit": ptab-patent-trial-appeal-board::federal-circuit-window -> cafc@ptab::entry-ptab p 0.92 {
  authority cite ?("35 U.S.C. §§ 141(c), 319; 37 C.F.R. § 90.3")
  note "Supersedes the PTAB pack's abstract Federal Circuit region when both packs are loaded; keeps its 0.92 appeal rate."
  tags [appeal]
  replaces ["ptab-patent-trial-appeal-board::federal-circuit-window->federal-circuit-notice-of-appeal#0"]
}

/// On remand the Board issues a new final written decision. The legacy
/// authority is 28 U.S.C. § 2106, whose text speaks of the judgment "of a
/// court"; kept as the pack has it.
link cafc-remand-to-ptab "Remand: Board issues a new final written decision": cafc@ptab::remanded-to-ptab -> ptab-patent-trial-appeal-board::fwd-issued by office p 1 {
  authority cite 28 U.S.C. § 2106
  tags [remand]
}

// -------------------------------------------------------------------------
// ITC <-> Federal Circuit. A party adversely affected by a final Section 337
// determination may appeal within 60 days after it becomes final (19 U.S.C.
// § 1337(c), lit/cafc's `itc-noa-period`) to the court with exclusive
// jurisdiction to review it (28 U.S.C. § 1295(a)(6)).
/// The Federal Circuit as entered from a final determination. Only
/// `origin-to-itc` and `remand-route-itc` survive. The Commission defends
/// its determination as a party, so the rehearing patches set the 45-day
/// agency-party period (`rehearing-period-united-states-party`, FRAP
/// 40(d)(1)(B)).
///
/// Proposed fix, not applied (it would change the generated notes): both
/// patch notes pin the 45 days on "Fed. Cir. R. 40(a)(1)(B)", which the
/// vendored Dec. 1, 2025 rules do not have; the time is Fed. Cir. R.
/// 40(f)(1), and the agency-party branch FRAP 40(d)(1)(B).
instance cafc@itc {
  pack cafc
  note "Federal Circuit as entered from an ITC § 337 final determination (19 U.S.C. § 1337(c)). Remand can only return to the Commission."
  remove_edges [origin-to-district-court, origin-to-ptab, origin-to-cofc, remand-route-district-court, remand-route-ptab, remand-route-cofc, origin-to-ttab, remand-route-ttab]
  probabilities { remand-route-itc: 1 }
  patch rehearing-file {
    deadline: {
      length: 45
      note: "45 days after entry of judgment because the Commission, a United States agency, is a party to every Section 337 appeal (Fed. Cir. R. 40(a)(1)(B): 30 days, or 45 if a United States agency is a party)."
    }
  }
  patch rehearing-time-expires {
    deadline: {
      length: 45
      note: "The rehearing window this edge waits out is 45 days here because the Commission, a United States agency, is a party (Fed. Cir. R. 40(a)(1)(B)); the mandate then issues 7 days after it expires (FRAP 41(b))."
    }
  }
}

/// Replaces the ITC pack's abstract appeal edge when both packs are loaded.
link itc-appeal-to-cafc "Appeal the Commission's final determination to the Federal Circuit": itc-337::federal-circuit-appeal-window -> cafc@itc::entry-itc by applicant {
  authority cite 19 U.S.C. § 1337(c); 28 U.S.C. § 1295(a)(6)
  note "Supersedes the ITC pack's abstract appeal edge when both packs are loaded."
  tags [appeal]
  replaces ["itc-337::federal-circuit-appeal-window->appeal-filed#0"]
}

/// On remand the Commission issues a new final determination (legacy
/// authority 28 U.S.C. § 2106, kept; see `cafc-remand-to-ptab`).
link cafc-remand-to-itc "Remand: Commission issues a new final determination": cafc@itc::remanded-to-itc -> itc-337::commission-final-determination by office p 1 {
  authority cite 28 U.S.C. § 2106
  tags [remand]
}

// -------------------------------------------------------------------------
// District court -> court of appeals. A notice of appeal from a final
// district-court judgment goes to the regional circuit (28 U.S.C. § 1291),
// except that the Federal Circuit has exclusive jurisdiction when the action
// arises under the patent laws or carries a compulsory patent counterclaim
// (28 U.S.C. § 1295(a)(1)). Both links replace the FRCP pack's cross-appeal
// edge; which one applies is a fact of the matter, so a case removes the
// other (`scenario.remove_edges`).
//
// The regional-circuit authority stays a cite hole carrying the legacy
// text: `Fed. R. App. P. 3, 4` has a comma, so no `CiteText` spelling.
/// The Federal Circuit as entered from a district-court patent judgment.
/// Only `origin-to-district-court` and `remand-route-district-court`
/// survive. No rehearing patch: the United States is rarely a party to a
/// patent case, so lit/cafc's 30-day `rehearing-period` applies.
instance cafc@district-court {
  pack cafc
  note "Federal Circuit as entered from a district-court patent judgment (28 U.S.C. § 1295(a)(1)): a civil action arising under the patent laws, or one with a compulsory patent counterclaim. Remand can only return to that district court."
  remove_edges [origin-to-cofc, origin-to-ptab, origin-to-itc, remand-route-cofc, remand-route-ptab, remand-route-itc, origin-to-ttab, remand-route-ttab]
  probabilities { remand-route-district-court: 1 }
}

/// The regional circuit under FRAP 3 and 4 (non-patent civil appeals).
link frcp-appeal-to-regional-circuit "Proceed under FRAP in the regional circuit (detailed appellate track)": frcp-civil-procedure::notice-of-appeal-filed -> frap-appellate-procedure::notice-of-appeal-filed by applicant {
  authority cite ?("28 U.S.C. § 1291; Fed. R. App. P. 3, 4")
  note "Non-patent civil appeals; the regional circuit is one of two routes out of `notice-of-appeal-filed` (see `frcp-appeal-to-cafc-district-court`). Which applies is a fact about the case (does it arise under the patent laws, or carry a compulsory patent counterclaim, 28 U.S.C. § 1295(a)(1)?), not a free choice between forums with concurrent jurisdiction — a matter scenario should `remove_edges` whichever of the two does not apply, the same way a `cafc@<origin>` instance keeps only the one true origin edge."
  tags [appeal]
  replaces ["frcp-civil-procedure::notice-of-appeal-filed->cross-appeal-window#0"]
}

/// The Federal Circuit for a district-court patent judgment.
link frcp-appeal-to-cafc-district-court "Proceed to the Federal Circuit (district-court patent judgment)": frcp-civil-procedure::notice-of-appeal-filed -> cafc@district-court::entry-district-court by applicant {
  authority cite 28 U.S.C. § 1295(a)(1)
  note "The Federal Circuit has exclusive jurisdiction over an appeal from a final district-court judgment in a civil action arising under an Act of Congress relating to patents (or plant variety protection), or in which a party asserted a compulsory patent counterclaim -- including a final judgment under 28 U.S.C. § 1292(c)(1)-(2). Coexists with `frcp-appeal-to-regional-circuit` as the other route out of `notice-of-appeal-filed`; a matter scenario selects the applicable one with `scenario.remove_edges` (see that link's note). Routes into the `cafc@district-court` instance, which mirrors `cafc@ptab`/`cafc@itc`/`cafc@cofc`: it keeps only `origin-to-district-court` and remands only back to the district court."
  tags [appeal, patent]
  replaces ["frcp-civil-procedure::notice-of-appeal-filed->cross-appeal-window#0"]
}

// -------------------------------------------------------------------------
// TTAB <-> Federal Circuit. A party dissatisfied with a final Board decision
// may appeal to the Federal Circuit on the Board record (15 U.S.C.
// § 1071(a); 28 U.S.C. § 1295(a)(4)(B)) within 63 days (37 C.F.R.
// § 2.145(d)(1), lit/cafc's `ttab-noa-period`), or instead bring a civil
// action (§ 1071(b)), which stays abstract in the TTAB pack.
/// The Federal Circuit as entered from a final TTAB decision. Only
/// `origin-to-ttab` and `remand-route-ttab` survive. No rehearing patch: in
/// an inter partes appeal the appellee is the other party, so lit/cafc's
/// 30-day `rehearing-period` applies unless the Director intervenes.
instance cafc@ttab {
  pack cafc
  note "Federal Circuit as entered from a final TTAB decision (15 U.S.C. § 1071(a); 28 U.S.C. § 1295(a)(4)(B)). Remand can only return to the TTAB."
  remove_edges [origin-to-district-court, origin-to-ptab, origin-to-itc, origin-to-cofc, remand-route-district-court, remand-route-ptab, remand-route-itc, remand-route-cofc]
  probabilities { remand-route-ttab: 1 }
}

/// Replaces the TTAB pack's abstract Federal Circuit outcome edge when both
/// packs are loaded.
link ttab-appeal-to-cafc "Appeal the TTAB decision to the Federal Circuit on the Board record": ttab-trademark-trial-and-appeal-board::decision-sustained -> cafc@ttab::entry-ttab by applicant {
  authority cite 15 U.S.C. § 1071(a); 28 U.S.C. § 1295(a)(4)(B)
  note "Supersedes the TTAB pack's abstract Federal Circuit outcome node when both packs are loaded. The 15 U.S.C. § 1071(b) civil-action alternative stays abstract (district-court de novo review is not a good fit for the FRCP pack's generic civil case); a matter scenario removes whichever route it does not use."
  tags [appeal]
  replaces ["ttab-trademark-trial-and-appeal-board::decision-sustained->cafc-outcome#0"]
}

/// On remand the Board issues a new final decision (legacy authority 28
/// U.S.C. § 2106, kept; see `cafc-remand-to-ptab`).
link cafc-remand-to-ttab "Remand: Board issues a new final decision": cafc@ttab::remanded-to-ttab -> ttab-trademark-trial-and-appeal-board::final-decision by office p 1 {
  authority cite 28 U.S.C. § 2106
  tags [remand]
}
