// litigate run cases/requests/cofc-appeal-threshold-sweep.case --op '{"op":"sweep","param":"stakes","lo":0.25,"hi":20,"steps":40,"watch":["cafc@cofc::appellant-brief-window"]}'
case cofc-appeal-threshold-sweep
uses cofc ^0.1.0, cafc ^0.1.0
as_of 2026-09-28
summary "§1498(a) patent case in the CoFC with a Federal Circuit appeal: the stake at which appealing becomes worth it."
notes "Ported from examples/cofc-appeal-threshold-sweep.json. A 28 U.S.C. § 1498(a) patent claim in the CoFC with a Federal Circuit appeal (links' cafc@cofc instance), at accrual: the claim is timely under § 2501 and nothing is pending elsewhere (§ 1500), so both are matter facts; being a § 1498(a) claim, it elects the §1498(a) claim, the standard complaint and the Appendix J patent track (cited Elected events, which remove the non-patent branch, the bid-protest track and the general-civil case type). The example's remove_edges listed the two barred fact edges; resolving those nodes through facts instead is what the engine's fact-unset warning asks for. Stakes scale the pack's own payoffs by `stakes`; the rate is illustrative."
perspective owner

parties {
  owner: applicant Corporation
  united-states: examiner Government
}

events {
  elected-1: 2026-09-14 Elected(e-patentfork-patent) by owner cite "28 U.S.C. § 1498(a)"
  elected-2: 2026-09-14 Elected(e-filingfork-standard) by owner cite "28 U.S.C. § 1498(a)"
  elected-3: 2026-09-14 Elected(e-casetype-patent) by owner cite "28 U.S.C. § 1498(a)"
}

// The Federal Circuit remands a CoFC judgment to the CoFC: the remand
// destination is a matter fact (lit/cafc's `remand-destination`).
facts {
  limitations-check: e-limitations-timely
  section-1500-check: e-1500-clear
  cafc::remand-destination: cafc::remand-route-cofc
}

analysis { params: { rate: 850.usd / 1.hours, stakes: 12 } }
