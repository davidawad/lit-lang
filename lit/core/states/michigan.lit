module core.states.michigan

import core.calendar.{ us-federal-holidays }

/// The public holidays of Michigan (MCL 435.101(1)), which the section applies
/// "for the holding of courts", that `us-federal-holidays` does not already
/// close: Lincoln's Birthday, February 12. The section moves no weekend
/// holiday, and its Saturday half-holiday is closed whole by `weekend`. Closed
/// from the date the vendored text is amended to (2023 PA 54, immediately
/// effective July 12, 2023).
calendar michigan-holidays cite "MCL 435.101(1)"
{
  lincolns-birthday: fixed(2, 12) effective [2023-07-12, ..)
}

/// FRCP 6 in the district courts of Michigan: the 2023 text
/// (`frcp6@2023-12-01`) with `michigan-holidays`, which 6(a)(6)(C)
/// ("any day declared a holiday by ... the state where the district court
/// is located") makes legal holidays "for periods that are measured after
/// an event" only. A district package there names it as its `counting`
/// rule and `recounts` lit/frcp. A calendar day is closed only from the
/// date its entry is in force; before it the count is `frcp6`'s.
counting frcp6-michigan effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCP 6(d)"
  holidays us-federal-holidays
  forward_holidays michigan-holidays cite "FRCP 6(a)(6)(C)"
  forums [frcp]
  allow_hours
  end_of_month clamp
}

/// FRBP 9006(a) (`frbp9006`) in the bankruptcy courts of Michigan:
/// `michigan-holidays` are legal holidays for a period counted forward only (FRBP
/// 9006(a)(6)(C), "any day declared a holiday by the state where the
/// district court is located"). A bankruptcy package there names it as its
/// `counting` rule and `recounts` lit/frbp. A calendar day is closed only
/// from the date its entry is in force.
counting frbp9006-michigan effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays michigan-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-mie, bankr-miw]
  allow_hours
  end_of_month clamp
}
