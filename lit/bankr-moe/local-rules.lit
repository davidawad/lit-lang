module bankr-moe-local-rules.local-rules

import core.frcp6.{ frcp6 }
import frbp.events.{ FirstMeetingDate, PetitionFiled }

// The Bankr. E.D. Mo. court's own periods and page limit, counted under
// FRBP 9006(a): the Local Rules of Bankruptcy Procedure as revised
// effective December 1, 2025. The FRBP periods (schedules, claims,
// discharge, dischargeability, exemptions, the adversary answer and
// summons, appeals) are lit/frbp's and are not declared again. Restated
// national and statutory periods are not declared: the initial documents
// and chapter 13 plan due within 14 days of the petition (L.R. 1002,
// 1007-6; FRBP 1007(c), 3015(b)) and the chapter 12 plan within 90 days (11
// U.S.C. § 1221); the 45-day outside date for payment advices (L.R. 1007-2;
// § 521(i)) and the tax return 7 days before the § 341 meeting (L.R.
// 1007-4; § 521(e)(2)(A)); the conversion disclosures, lists and reports
// (L.R. 1019; FRBP 1019, 2016(b), 3015(b)); the supplemental fee disclosure
// within 14 days (L.R. 2016-1; FRBP 2016(b)(2)) and the 21-day objection to
// a fee application outside chapter 11 (FRBP 2002(a)(6)); the mortgage
// claim attachments 70 and 120 days after the order for relief and the
// 21-day final cure motion (L.R. 3002.1; FRBP 3002(c)(7), 3002.1(h)); the
// governmental bar date of 180 days (§ 502(b)(9)); the 30-day negative
// notice on claim objections (L.R. 3007, 9061(B); FRBP 3007(a)); Form 101B
// within 30 days (L.R. 4001-5; § 362(l)(2)); the 14 days to object to an
// abandonment (L.R. 6007; FRBP 6007(a)); the 7-day life of a summons (L.R.
// 7004; FRBP 7004(e)); the 30- and 35-day answer periods (L.R. 7055; FRBP
// 7012(a)); the jury demand and consent statements (L.R. 9015; FRCP 38(b),
// FRBP 9015); and the 14-day consent statement after removal (L.R. 9027;
// FRBP 9027(e)(3)).
//
// Stated in the rules but not declared: the clock-time periods (ballot
// summaries 72 hours before confirmation, L.R. 3018; confirmation orders
// served within 72 hours, L.R. 3020; exhibit binders and authenticity
// objections 72 hours before trial, L.R. 7016; certificates of service
// within 24 hours, L.R. 9004; first-day matters within 48 hours and agendas
// 48 hours ahead, L.R. 9013-3; competing orders within 72 hours and service
// within two business days, L.R. 9050); the minimum notices a hearing must
// give rather than deadlines of their own (14, 21 and 30 days, L.R. 1017-1,
// 2016-1, 2016-2, 4003-2, 9060, 9061(D); stay relief motions heard more
// than 30 or 60 days out waive § 362(e), L.R. 4001-1, 4001-6; expedited
// hearings under 21 days, L.R. 9013-2; exemption hearings at least 21 days
// out, L.R. 4004-2; stay continuation hearings 21 to 30 days after the
// petition, L.R. 4001-2); the interim fee application intervals of 120 and
// 180 days (L.R. 2016-2); the chapter 12 mortgage cure of no more than four
// years (L.R. 3015-1), the twelve-month stipulated cure of missed payments
// (L.R. 1017-1) and the three-month suspension of trustee payments (L.R.
// 3015-6); the rent deposits for the 30 days after the petition (L.R.
// 4001-5); the insurance prepaid three months (L.R. 2015-2); the eight-year
// list of prior cases (L.R. 1017-2); the retention periods (notices six
// months after closing, L.R. 2003; ballots two years after confirmation,
// L.R. 3018; signed originals two years after closing, L.R. 9011); and the
// amounts (the $1,000 trustee deposits, L.R. 2015-1, 2015-3; the $1,000
// short-form fee threshold, L.R. 2016-3).
/// A memorandum in support of a motion, exclusive of the signature page,
/// certificate of service and attachments (L.R. 9013-1).
limit motion-memorandum {
  pages <= 15 cite "E.D. Mo. Bankr. L.R. 9013-1"
} cite "E.D. Mo. Bankr. L.R. 9013-1"

/// An individual chapter 7 debtor's application to waive the filing fee is
/// denied and the debtor is not eligible for installments (L.R. 1006).
event FeeWaiverDenied()
/// The court or another party requests an amended matrix (L.R. 1009).
event MatrixRequested()
/// The trustee's § 341 minute entry or another document requesting
/// dismissal for failure to file or provide documents is entered (L.R.
/// 1017-1).
event TrusteeDismissalRequested()
/// A party other than the debtor serves a motion to dismiss a chapter 13
/// case on Negative Notice (L.R. 1017-1).
event Chapter13DismissalMotionServed()
/// An order dismissing the case for failure to file or provide information
/// is entered (L.R. 1007-2, 1017-2).
event DismissalEntered()
/// An order granting the chapter 13 trustee's motion to dismiss for failure
/// to make plan payments is entered (L.R. 1017-3).
event TrusteeDismissalGranted()
/// A chapter 13 debtor's motion to reinstate after dismissal on the
/// trustee's motion is served (L.R. 1017-3).
event ReinstatementMotionServed()
/// An order converting the case is entered (L.R. 1019).
event ConversionOrdered()
/// A party requests a document from another party in writing (L.R. 1030).
event DocumentRequested()
/// A motion for a Rule 2004 examination is served (L.R. 2004).
event ExamMotionServed()
/// The Notice of Appointment of the chapter 12 or subchapter V trustee is
/// filed (L.R. 2015-1(A), 2015-3(C)).
event TrusteeAppointmentNoticed()
/// The hearing on an application for compensation in a chapter 11 case
/// (L.R. 2016-1).
event Chapter11FeeHearing()
/// A chapter 13 case is dismissed before a plan is confirmed (L.R. 2016-3).
event PreConfirmationDismissal()
/// An attorney enters an appearance as counsel for the debtor (L.R. 2091).
event AppearanceEntered()
/// An order approving the rejection of an executory contract or lease, or a
/// judgment in a chapter 5 action against the creditor, is entered (L.R.
/// 3002).
event RejectionOrderEntered()
/// A creditor added after the claims bar date is given written notice of
/// the bar date (L.R. 3003).
event LateCreditorNoticed()
/// The hearing set on an objection to claim (L.R. 3007).
event ClaimObjectionHearing()
/// The order confirming a chapter 13 plan is entered (L.R. 3015-2).
event Chapter13PlanConfirmed()
/// The § 341 meeting in a chapter 12 or 13 case concludes (L.R. 3015-4).
event MeetingConcluded()
/// A pre-confirmation amended chapter 12 or 13 plan is served (L.R.
/// 3015-4).
event AmendedPlanServed()
/// An order confirming a chapter 12 plan is entered (L.R. 3015-4).
event Chapter12PlanConfirmed()
/// A motion to amend a confirmed chapter 12 or 13 plan, with the amended
/// plan and budget, is served (L.R. 3015-5).
event AmendmentMotionServed()
/// The hearing on a disclosure statement (L.R. 3017).
event DisclosureStatementHearing()
/// A subchapter V plan is filed (L.R. 3017.2).
event SubchapterVPlanFiled()
/// The hearing on confirmation of a chapter 11 plan (L.R. 3020).
event ConfirmationHearing()
/// An order confirming a chapter 11 plan is entered (L.R. 3022).
event Chapter11PlanConfirmed()
/// An application for a final decree in a chapter 11 case is served on
/// Negative Notice (L.R. 3022).
event FinalDecreeApplicationServed()
/// The hearing date set on a motion for relief from the automatic stay
/// (L.R. 4001-1(D)).
event StayReliefHearing()
/// The court's notice to a lessor under § 362(l) is issued (L.R. 4001-5).
event LessorNoticeIssued()
/// The lessor receives the debtor's § 362(l)(2) certification (L.R.
/// 4001-5).
event LessorCertificationReceived()
/// The hearing date set on a motion for relief from the co-debtor stay
/// (L.R. 4001-6(C)).
event CoDebtorStayHearing()
/// The court notifies a chapter 13 debtor, on receipt of a motion for
/// discharge, that the § 1328 certification is due (L.R. 4004-1).
event CertificationNoticeIssued()
/// The court notifies the debtor, on the trustee's motion to stop wage
/// withholding, that the certification is due (L.R. 4004-1).
event WageWithholdingNoticeIssued()
/// A final report and account is served with notice of the objection
/// deadline (L.R. 5009).
event FinalReportServed()
/// A motion to withdraw the reference is served (L.R. 5011(B)).
event WithdrawalMotionServed()
/// The hearing date on an adversary summons (L.R. 7004).
event SummonsHearing()
/// The trial date in an adversary proceeding (L.R. 7016).
event AdversaryTrial()
/// An answer or other response is filed in an adversary proceeding (L.R.
/// 7016).
event AnswerFiled()
/// A discovery request is served in an adversary proceeding in which a
/// trial summons issued (L.R. 7026).
event DiscoveryRequestServed()
/// The bankruptcy case is dismissed while a related adversary proceeding is
/// pending (L.R. 7041).
event BankruptcyCaseDismissed()
/// A motion for summary judgment is served, or a responsive pleading falls
/// due (L.R. 7056(E)).
event SummaryJudgmentMotionServed()
/// The date of the hearing on a motion (L.R. 9013-1).
event MotionHearing()
/// The court orders mediation (L.R. 9019).
event MediationOrdered()
/// A court-ordered mediation concludes (L.R. 9019).
event MediationConcluded()
/// A Motion to File Under Seal is filed (L.R. 9037-2(D)).
event SealMotionFiled()
/// A motion or pleading to be heard on Negative Notice is served (L.R.
/// 9061(B)).
event NegativeNoticeServed()
/// A motion for continuation of utility service or adequate assurance under
/// 11 U.S.C. § 366 is served on Negative Notice (L.R. 9061(B)).
event UtilityMotionServed()
/// A chapter 13 motion to incur debt for an automobile, or to retain
/// automobile insurance proceeds, is served on Negative Notice (L.R.
/// 9061(B)).
event AutomobileMotionServed()
/// The response deadline on a Negative Notice matter passes (L.R. 9061).
event ResponseDeadlinePassed()

/// E.D. Mo. Bankr. L.R. 1002: in a chapter 13 case the Chapter 13 Attorney
/// Fee Election Form is due within fourteen (14) days of the petition.
deadline fee-election-period: 14.days after PetitionFiled() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1002"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1006: fifty percent of the filing fee is paid
/// within seven (7) days of the petition if not paid when it is filed.
deadline initial-installment-period: 7.days after PetitionFiled() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1006"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1006: the second installment is paid on or before
/// sixty (60) days after the petition.
deadline second-installment-period: 60.days after PetitionFiled() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1006"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1006: the third installment is paid on or before
/// ninety (90) days after the petition.
deadline final-installment-period: 90.days after PetitionFiled() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1006"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1006: a debtor not eligible for installments is
/// ordered to pay the full filing fee within seven (7) days of the order
/// denying the fee waiver application.
deadline fee-after-waiver-denial-period: 7.days after FeeWaiverDenied() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1006"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1007-1: the debtor provides the trustee
/// documentation supporting the expenses on the Means Test and Disposable
/// Income Official Forms fourteen (14) days before the § 341 meeting.
deadline means-test-documents-period: 14.days before FirstMeetingDate() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1007-1"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1007-2: § 521(a)(1)(B)(iv) is satisfied by
/// providing the trustee payment advices at least fourteen (14) days before
/// the first setting of the § 341 meeting (the statute's 45 days after the
/// petition remains the outside date).
deadline payment-advices-period: 14.days before FirstMeetingDate() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1007-2"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1007-3: records of any § 521(c) education account
/// interest are filed with the petition or within fourteen (14) days
/// thereafter.
deadline education-account-records-period: 14.days after PetitionFiled() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1007-3"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1009: within seven (7) days of a request from the
/// court or any other party, the debtor files and uploads an amended
/// matrix.
deadline amended-matrix-period: 7.days after MatrixRequested() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1009"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1017-1: upon the trustee's § 341 minute entry or
/// another document requesting dismissal, the debtor has seven (7) days to
/// respond, or the court may dismiss the case.
deadline trustee-dismissal-response-period: 7.days after TrusteeDismissalRequested() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1017-1"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1017-1: a debtor has twenty-one (21) days from
/// service of another party's motion to dismiss a chapter 13 case to
/// respond; if a response is filed the movant gives fourteen days' notice
/// of hearing.
deadline chapter13-dismissal-response-period: 21.days after Chapter13DismissalMotionServed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1017-1"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1017-2: a debtor has fourteen (14) days after entry
/// of an order of dismissal to move to reinstate and set aside the
/// dismissal (likewise L.R. 1007-2 for dismissals under § 521(i)).
deadline reinstatement-motion-period: 14.days after DismissalEntered() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1017-2"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1017-3: a chapter 13 debtor has fourteen (14) days
/// after an order granting the trustee's motion to dismiss for failure to
/// make plan payments to move to reinstate.
deadline trustee-dismissal-reinstatement-period: 14.days after TrusteeDismissalGranted() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1017-3"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1017-3: no later than fourteen (14) days after
/// service of the motion to reinstate, the trustee files a response
/// consenting to or opposing reinstatement.
deadline trustee-reinstatement-response-period: 14.days after ReinstatementMotionServed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1017-3"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1019: no later than fourteen (14) days after the
/// order of conversion, an individual debtor files amended Schedules I and
/// J (and J-2 if applicable).
deadline conversion-schedules-period: 14.days after ConversionOrdered() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1019"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1019: in a case converted to chapter 13, the debtor
/// files the attorney fee election form no later than fourteen (14) days
/// after the order of conversion.
deadline converted-fee-election-period: 14.days after ConversionOrdered() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1019"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 1030: failure to comply with a written request for
/// a document within fourteen (14) days is grounds for a motion to compel
/// or other remedy.
deadline document-request-period: 14.days after DocumentRequested() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 1030"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 2003: the debtor provides the trustee the
/// documentation the Procedures Manual specifies fourteen (14) days before
/// the § 341 meeting.
deadline trustee-documents-period: 14.days before FirstMeetingDate() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 2003"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 2004: an objection to a motion for a Rule 2004
/// examination is filed no later than seven (7) days after its service.
deadline exam-objection-period: 7.days after ExamMotionServed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 2004"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 2015-1: no later than seven (7) days after the
/// Notice of Appointment of Trustee, a chapter 12 debtor (and under L.R.
/// 2015-3(C) a subchapter V debtor) tenders the trustee's deposit.
deadline trustee-deposit-period: 7.days after TrusteeAppointmentNoticed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 2015-1"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 2016-1: in chapter 11 cases an objection to an
/// application for compensation is filed and served no later than fourteen
/// (14) days before the hearing.
deadline chapter11-fee-objection-period: 14.days before Chapter11FeeHearing() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 2016-1"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 2016-3: an attorney seeking fees in a chapter 13
/// case dismissed before confirmation files the application, and obtains an
/// order holding funds, within fourteen (14) days of the dismissal order.
deadline dismissed-case-fee-application-period: 14.days after PreConfirmationDismissal() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 2016-3"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 2091: an attorney entering as debtor's counsel
/// files the compensation disclosure and, in a chapter 13 case, the
/// attorney fee election form within fourteen (14) days after the
/// appearance.
deadline appearance-disclosure-period: 14.days after AppearanceEntered() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 2091"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 2091: new chapter 13 debtor's counsel may, only
/// within seven (7) days after entering, petition not to be bound by the
/// withdrawing attorney's fee election.
deadline prior-fee-election-period: 7.days after AppearanceEntered() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 2091"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3002: a claim arising from rejection or a chapter 5
/// judgment is filed by the later of the claims bar date and thirty (30)
/// days after the order or judgment.
deadline rejection-claim-period: 30.days after RejectionOrderEntered() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3002"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3003: in subchapter V cases, unless otherwise
/// ordered, the non-governmental claims bar date is seventy (70) days after
/// the petition.
deadline subchapter-v-claim-period: 70.days after PetitionFiled() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3003"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3003: a creditor added late is given notice that it
/// must file its claim by the later of the bar date and thirty (30) days
/// after the notice.
deadline late-creditor-claim-period: 30.days after LateCreditorNoticed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3003"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3007: a response to an objection to claim set for
/// hearing is filed no later than seven (7) days before the hearing.
deadline claim-objection-response-period: 7.days before ClaimObjectionHearing() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3007"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3015-1: when a chapter 12 plan surrenders
/// collateral, the debtor releases it to the creditor within forty-five
/// (45) days of the petition.
deadline chapter12-surrender-period: 45.days after PetitionFiled() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3015-1"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3015-2: when a chapter 13 plan surrenders
/// collateral, the debtor releases it to the creditor within twenty-one
/// (21) days of the confirmation order.
deadline chapter13-surrender-period: 21.days after Chapter13PlanConfirmed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3015-2"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3015-4: objections to confirmation of the debtor's
/// original chapter 12 or 13 plan are filed and served no later than
/// twenty-one (21) days after the conclusion of the § 341 meeting.
deadline plan-objection-period: 21.days after MeetingConcluded() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3015-4"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3015-4: objections to a pre-confirmation amended
/// plan are filed and served no later than twenty-one (21) days after its
/// service.
deadline amended-plan-objection-period: 21.days after AmendedPlanServed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3015-4"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3015-4: no later than seven (7) days after an order
/// confirming a chapter 12 plan, the debtor serves it, or notice of it, on
/// all creditors and parties in interest.
deadline chapter12-confirmation-service-period: 7.days after Chapter12PlanConfirmed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3015-4"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3015-5: objections to a motion to amend a confirmed
/// chapter 12 or 13 plan are filed and served no later than twenty-one (21)
/// days after its service.
deadline post-confirmation-amendment-objection-period: 21.days after AmendmentMotionServed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3015-5"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3017: unless otherwise ordered, an objection to a
/// disclosure statement is filed and served no later than seven (7) days
/// before its hearing.
deadline disclosure-statement-objection-period: 7.days before DisclosureStatementHearing() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3017"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3017.2: counsel files and serves a Motion to
/// Establish Confirmation Procedures within seven (7) days after the
/// subchapter V plan is filed.
deadline subchapter-v-procedures-motion-period: 7.days after SubchapterVPlanFiled() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3017.2"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3020: unless otherwise ordered, objections to
/// confirmation of a chapter 11 plan are filed and served at least seven
/// (7) days before the confirmation hearing.
deadline confirmation-objection-period: 7.days before ConfirmationHearing() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3020"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3020: the plan proponent serves the proposed
/// confirmation order on the Master Service List seven (7) days before the
/// confirmation hearing.
deadline proposed-confirmation-order-period: 7.days before ConfirmationHearing() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3020"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3022: the plan proponent applies for a final
/// decree, or shows cause why one should not be entered, no later than
/// three (3) months after the confirmation order.
deadline final-decree-application-period: 3.months after Chapter11PlanConfirmed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3022"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 3022: objections to an application for a final
/// decree are filed no later than thirty (30) days after its service.
deadline final-decree-objection-period: 30.days after FinalDecreeApplicationServed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 3022"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 4001-1: a response to a motion for relief from the
/// automatic stay is filed no later than seven (7) days before the hearing
/// date, admitting or denying each paragraph.
deadline stay-relief-response-period: 7.days before StayReliefHearing() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 4001-1"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 4001-2: where the stay terminates on a date certain
/// under §§ 362(c)(3), (h), 521(a)(2) or 521(a)(6), a debtor's motion to
/// continue it is filed within fourteen (14) days of the petition.
deadline stay-continuation-motion-period: 14.days after PetitionFiled() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 4001-2"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 4001-2: a trustee's motion to continue the stay is
/// filed within twenty-one (21) days of the petition.
deadline trustee-stay-continuation-motion-period: 21.days after PetitionFiled() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 4001-2"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 4001-5: the lessor has fourteen (14) days from the
/// court's notice to return it with the lessor's election.
deadline lessor-election-period: 14.days after LessorNoticeIssued() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 4001-5"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 4001-5: a lessor objecting to the § 362(l)(2)
/// certification files and serves its objection within fourteen (14) days
/// of receiving it.
deadline lessor-certification-objection-period: 14.days after LessorCertificationReceived() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 4001-5"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 4001-6: a response to a motion for relief from the
/// co-debtor stay is filed no later than seven (7) days before the hearing,
/// unless the movant gave less than 21 days' notice under § 1301(c)(2).
deadline co-debtor-stay-response-period: 7.days before CoDebtorStayHearing() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 4001-6"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 4004-1: the debtor files the chapter 13 discharge
/// certification within fourteen (14) days of the court's notice, or the
/// case may be closed without a discharge.
deadline discharge-certification-period: 14.days after CertificationNoticeIssued() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 4004-1"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 4004-1: on the trustee's motion to stop wage
/// withholding, the debtor files the certification within twenty-one (21)
/// days of the court's notice.
deadline wage-withholding-certification-period: 21.days after WageWithholdingNoticeIssued() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 4004-1"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 5009: objections to a final report are filed no
/// later than thirty (30) days after its service.
deadline final-report-objection-period: 30.days after FinalReportServed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 5009"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 5011: no later than seven (7) days after service of
/// a motion to withdraw the reference, any other party may file and serve a
/// response.
deadline withdrawal-reference-response-period: 7.days after WithdrawalMotionServed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 5011"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 7004: the plaintiff files the certificate of
/// service of the summons at least fourteen (14) days before the hearing
/// date on the summons.
deadline summons-service-certificate-period: 14.days before SummonsHearing() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 7004"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 7016: parties exchange witness and exhibit lists
/// and exhibits no later than fourteen (14) days before trial, unless an
/// order provides otherwise.
deadline trial-exchange-period: 14.days before AdversaryTrial() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 7016"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 7016: unless a pre-trial order directs otherwise,
/// the parties discuss settlement no later than fourteen (14) days after an
/// answer or other response is filed.
deadline settlement-discussion-period: 14.days after AnswerFiled() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 7016"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 7026: where a trial summons issued, discovery
/// responses are served no later than twenty-one (21) days after service of
/// the request.
deadline discovery-response-period: 21.days after DiscoveryRequestServed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 7026"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 7041: twenty-one (21) days after the bankruptcy
/// case is dismissed the court closes a related adversary proceeding
/// without final judgment unless a party moves within that period to
/// continue it.
deadline adversary-continuation-motion-period: 21.days after BankruptcyCaseDismissed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 7041"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 7056: the response and memorandum are filed no
/// later than twenty-one (21) days after the motion is served or a
/// responsive pleading is due, whichever is later.
deadline summary-judgment-response-period: 21.days after SummaryJudgmentMotionServed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 7056"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 9013-1: unless otherwise specified, a response to a
/// matter set for hearing is filed no later than seven (7) days before the
/// hearing, and any memorandum no later than seven days before it.
deadline hearing-response-period: 7.days before MotionHearing() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 9013-1"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 9019: if the court ordered the mediation, the
/// parties agree on a mediator within seven (7) days of the order.
deadline mediator-selection-period: 7.days after MediationOrdered() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 9019"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 9019: no later than seven (7) days after a court-
/// ordered mediation concludes, the mediator files and serves the report.
deadline mediator-report-period: 7.days after MediationConcluded() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 9019"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 9019: if agreement is reached, the parties prepare
/// and file the settlement papers no later than fourteen (14) days after
/// the mediation concludes.
deadline mediated-settlement-papers-period: 14.days after MediationConcluded() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 9019"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 9037-2: parties in interest may object to a Motion
/// to File Under Seal within seven (7) days after it is filed.
deadline seal-objection-period: 7.days after SealMotionFiled() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 9037-2"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 9061: a party served with a motion or pleading
/// heard on Negative Notice has twenty-one (21) days after service to
/// respond (lien avoidance motions included, L.R. 4003-2).
deadline negative-notice-response-period: 21.days after NegativeNoticeServed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 9061"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 9061: the Negative Notice response time on a motion
/// for continuation of utility service or adequate assurance under § 366 is
/// thirty (30) days.
deadline utility-motion-response-period: 30.days after UtilityMotionServed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 9061"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 9061: the Negative Notice response time on a
/// chapter 13 motion to incur automobile debt or retain automobile
/// insurance proceeds is fourteen (14) days after service.
deadline automobile-motion-response-period: 14.days after AutomobileMotionServed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 9061"
{
  forum frcp
}

/// E.D. Mo. Bankr. L.R. 9061: the Certification of No Response or
/// Resolution is filed as part of the proposed order no later than 7 days
/// after the response deadline.
deadline no-response-certification-period: 7.days after ResponseDeadlinePassed() counted_by frcp6 cite "E.D. Mo. Bankr. L.R. 9061"
{
  forum frcp
}

start motion-filed

state motion-filed: "Motion filed and served" by applicant cite "E.D. Mo. Bankr. L.R. 9013-1"
{
  note "A matter set for hearing is answered no later than seven days before the hearing; a matter heard on Negative Notice is answered within 21 days after service (30 for chapter 13 claim objections and utility motions, 14 for automobile motions) (L.R. 9013-1, 9061(B)). The motion's FRBP periods are lit/frbp's."
  edge-motion-filed-response "Response filed" -> responded {
    authority cite "E.D. Mo. Bankr. L.R. 9061"
  }
  edge-motion-filed-unopposed "No response: Certification of No Response and proposed order" -> ruling {
    authority cite "E.D. Mo. Bankr. L.R. 9061"
  }
}

state responded: "Response filed; matter set for hearing" by opponent cite "E.D. Mo. Bankr. L.R. 9013-1"
{
  note "If a response is filed on a Negative Notice matter, the movant sets it for hearing on the notice the rules require (L.R. 9061(D)); a memorandum is limited to 15 pages without leave (L.R. 9013-1)."
  edge-responded-hearing "Hearing held" -> ruling { authority cite "E.D. Mo. Bankr. L.R. 9013-1" }
}

decision ruling: "Motion decided" by court cite "E.D. Mo. Bankr. L.R. 9061"
{
  note "The court may grant an unopposed Negative Notice motion without a hearing (L.R. 9061)."
  edge-ruling-granted "Granted" -> decided { authority cite "E.D. Mo. Bankr. L.R. 9061" }
  edge-ruling-denied "Denied" -> decided { authority cite "E.D. Mo. Bankr. L.R. 9013-1" }
}

terminal decided: "Matter decided: the case continues under lit/frbp" outcome [procedural] cite "E.D. Mo. Bankr. L.R. 1001"
{
  note "The Local Rules of Bankruptcy Procedure govern practice in the court (L.R. 1001)."
}
