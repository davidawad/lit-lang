// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-nc-industrial-commission

import outline-nc-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start filed

state filed: "Claim, petition or appeal filed" by applicant cite ?("N.C. Gen. Stat. § 97-24 (verify)")
{
  note "OUTLINE. A deputy commissioner hears the claim; the Full Commission reviews and the Court of Appeals hears appeals. Proceedings before the North Carolina Industrial Commission: filing period, form and fees are holes. Leading decisions: not yet identified in this pass; verify before use."
  edge-filed-hearing "Set for hearing" -> hearing { event ActionCommenced() authority cite ?("N.C. Gen. Stat. § 97-84 (verify)") }
}

state hearing: "Hearing" by court cite ?("N.C. Gen. Stat. § 97-84 (verify)")
{
  note "OUTLINE. Hearing procedure, evidence and the record are holes."
  edge-hearing-decision "Decision issued" -> decision { authority cite ?("N.C. Gen. Stat. § 97-85 (verify)") }
}

chance decision: "Tribunal decides" by court cite ?("N.C. Gen. Stat. § 97-85 (verify)")
{
  note "OUTLINE. Outcome probabilities are holes."
  edge-decision-granted "Relief granted" -> review p ? { event DecisionFiled() }
  edge-decision-denied "Relief denied" -> review p ? { event DecisionFiled() }
}

decision review: "Review or appeal sought?" by applicant cite ?("N.C. Gen. Stat. § 97-86 (verify)")
{
  note "OUTLINE. Review period and the reviewing body are holes."
  edge-review-none "No review" -> final-decision { event JudgmentEntered() authority cite ?("N.C. Gen. Stat. § 97-85 (verify)") }
  edge-review-sought "Review or judicial review sought" -> review-sought { event NoticeOfAppealFiled() authority cite ?("N.C. Gen. Stat. § 97-86 (verify)") }
}

terminal final-decision: "Decision final" outcome [final] cite ?("N.C. Gen. Stat. § 97-85 (verify)")
{
  note "OUTLINE. Enforcement and payment are outside this outline."
  payoff ?
}

terminal review-sought: "Review or judicial review sought" outcome [final] cite ?("N.C. Gen. Stat. § 97-86 (verify)")
{
  note "OUTLINE. The reviewing court is its own package."
  payoff ?
}
