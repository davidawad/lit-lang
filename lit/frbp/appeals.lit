test "the order disposing of the last tolling motion restarts the notice period" cite "FRBP 8002(b)(1)"
{
  given BankruptcyOrderEntered() on 2026-03-03
  given BankruptcyOrderEntered() on 2026-03-24
  expect deadline(notice-period) == 2026-04-07
}

test "a cross-notice runs 14 days after the first notice when that ends later" cite "FRBP 8002(a)(3)"
