// Ported from packs/mpep-prosecution.json (`litigate import`, then made strict).
module mpep.pre-filing

import mpep.deadlines.{ provisional-pendency }
import mpep.filing-to-allowance.{ nonprovisional-filed }
import mpep.{ pre-filing-group }

start pre-filing

state pre-filing: "Pre-Filing" by applicant effective [2024-01-31, 2025-01-19) cite "35 U.S.C. 111(b); 37 CFR 1.53(c)"
{
  group pre-filing-group
  note "Provisional application option: file under 35 U.S.C. 111(b) to secure a priority date for 12 months. No claims required. The 12-month window is unextendable — missing it forfeits domestic priority."
  edge-pre-filing-provisional-filed "File provisional application" -> provisional-filed {
    authority cite "35 U.S.C. 111(b); 37 CFR 1.53(c)"
    effort 8.hours
    cost 300.usd
    within provisional-pendency {
      extendable false
      note "12-month period to file a nonprovisional claiming domestic benefit of the provisional is unextendable under 35 U.S.C. 119(e). Missing it forfeits the provisional's priority benefit."
    }
    duration { min 54.8.days, mode 182.5.days, max 365.days }
    note "Provisional filing fee $300.00, undiscounted/large-entity, in force until 1/19/2025 (USPTO fee schedule; 37 CFR 1.16(d)); halve for small entity, one-fifth for micro entity -- not modeled here since this pack doesn't track entity size."
  }
  edge-pre-filing-nonprovisional-filed "File nonprovisional directly (no provisional)" -> nonprovisional-filed {
    authority cite "35 U.S.C. 111(a); 37 CFR 1.53(b)"
    effort 40.hours
    cost 1_820.usd
    note "Nonprovisional utility filing fee $1,820.00, undiscounted/large-entity, in force until 1/19/2025: $320.00 basic filing fee (37 CFR 1.16(a)) + $700.00 search fee (1.16(k)) + $800.00 examination fee (1.16(o))."
  }
}

state pre-filing: "Pre-Filing" by applicant effective [2025-01-19, ..) cite "35 U.S.C. 111(b); 37 CFR 1.53(c)"
{
  group pre-filing-group
  note "Provisional application option: file under 35 U.S.C. 111(b) to secure a priority date for 12 months. No claims required. The 12-month window is unextendable — missing it forfeits domestic priority."
  edge-pre-filing-provisional-filed "File provisional application" -> provisional-filed {
    authority cite "35 U.S.C. 111(b); 37 CFR 1.53(c)"
    effort 8.hours
    cost 325.usd
    within provisional-pendency {
      extendable false
      note "12-month period to file a nonprovisional claiming domestic benefit of the provisional is unextendable under 35 U.S.C. 119(e). Missing it forfeits the provisional's priority benefit."
    }
    duration { min 54.8.days, mode 182.5.days, max 365.days }
    note "Provisional filing fee $325.00, undiscounted/large-entity, effective 1/19/2025 (USPTO fee schedule; 37 CFR 1.16(d)); halve for small entity, one-fifth for micro entity -- not modeled here since this pack doesn't track entity size."
  }
  edge-pre-filing-nonprovisional-filed "File nonprovisional directly (no provisional)" -> nonprovisional-filed {
    authority cite "35 U.S.C. 111(a); 37 CFR 1.53(b)"
    effort 40.hours
    cost 2_000.usd
    note "Nonprovisional utility filing fee $2,000.00, undiscounted/large-entity, effective 1/19/2025: $350.00 basic filing fee (37 CFR 1.16(a)) + $770.00 search fee (1.16(k)) + $880.00 examination fee (1.16(o))."
  }
}

state provisional-filed: "Provisional Filed" by applicant effective [2024-01-31, 2025-01-19) cite "35 U.S.C. 111(b); 37 CFR 1.53(c)"
{
  group pre-filing-group
  note "Provisional secures a U.S. priority date. Must be converted or claimed as priority within 12 months. Provisional does not start the 20-year patent term clock."
  edge-provisional-filed-nonprovisional-filed "File nonprovisional within 12-month window" -> nonprovisional-filed {
    authority cite "35 U.S.C. 111(a); 35 U.S.C. 119(e); 37 CFR 1.53(b)"
    effort 40.hours
    cost 1_820.usd
    within provisional-pendency {
      extendable false
      note "12-month priority window. No extension available under any authority. After expiration, provisional's priority benefit is lost."
    }
    duration { min 54.8.days, mode 182.5.days, max 365.days }
    note "Nonprovisional utility filing fee $1,820.00, undiscounted/large-entity, in force until 1/19/2025: $320.00 basic filing fee (37 CFR 1.16(a)) + $700.00 search fee (1.16(k)) + $800.00 examination fee (1.16(o))."
  }
}

state provisional-filed: "Provisional Filed" by applicant effective [2025-01-19, ..) cite "35 U.S.C. 111(b); 37 CFR 1.53(c)"
{
  group pre-filing-group
  note "Provisional secures a U.S. priority date. Must be converted or claimed as priority within 12 months. Provisional does not start the 20-year patent term clock."
  edge-provisional-filed-nonprovisional-filed "File nonprovisional within 12-month window" -> nonprovisional-filed {
    authority cite "35 U.S.C. 111(a); 35 U.S.C. 119(e); 37 CFR 1.53(b)"
    effort 40.hours
    cost 2_000.usd
    within provisional-pendency {
      extendable false
      note "12-month priority window. No extension available under any authority. After expiration, provisional's priority benefit is lost."
    }
    duration { min 54.8.days, mode 182.5.days, max 365.days }
    note "Nonprovisional utility filing fee $2,000.00, undiscounted/large-entity, effective 1/19/2025: $350.00 basic filing fee (37 CFR 1.16(a)) + $770.00 search fee (1.16(k)) + $880.00 examination fee (1.16(o))."
  }
}
