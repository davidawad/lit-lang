// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.

module outline-ca-state-civil

start commenced

state commenced: "Complaint Filed" by applicant cite ?("Cal. Code Civ. Proc. § 350")
{
  note "Commencement by filing. Filing fee is a hole."
  edge-commenced-response-due "Summons and complaint served" -> response-due {
    authority cite ?("Cal. Code Civ. Proc. § 415.10")
  }
}

decision response-due: "Answer or Motion Due" by office cite ?("Cal. Code Civ. Proc. § 412.20(a)(3)")
{
  note "Response period is a hole. Verify against the rule and any stipulation practice."
  edge-response-due-default-entered "No response" -> default-entered {
    authority cite ?("Cal. Code Civ. Proc. § 585")
  }
  edge-response-due-motion-ruling "Motion filed" -> motion-ruling {
    authority cite ?("Cal. Code Civ. Proc. § 430.10")
  }
  edge-response-due-discovery "Answer filed" -> discovery {
    authority cite ?("Cal. Code Civ. Proc. § 412.20(a)(3)")
  }
}

terminal default-entered: "Default entered" outcome [loss] cite ?("Cal. Code Civ. Proc. § 585")
{
  note "Default entry and set-aside standard are holes. Verify."
  payoff ?
}

decision motion-ruling: "Motion Ruling" by court cite ?("Cal. Code Civ. Proc. § 430.10")
{
  note "Pleading standard: Blank v. Kirwan, 39 Cal. 3d 311 (1985). Verify."
  edge-motion-ruling-dismissed "Dismissed" -> dismissed {
    authority cite ?("Cal. Code Civ. Proc. § 430.10")
  }
  edge-motion-ruling-discovery "Denied" -> discovery {
    authority cite ?("Cal. Code Civ. Proc. § 430.10")
  }
}

terminal dismissed: "Dismissed on the pleadings" outcome [loss] cite ?("Cal. Code Civ. Proc. § 430.10")
{
  note "Leave to amend and with or without prejudice are holes. Verify."
  payoff ?
}

state discovery: "Discovery" by applicant cite ?("Cal. Code Civ. Proc. § 2016.010")
{
  note "Disclosure, discovery limits and deadlines are holes. Verify."
  edge-discovery-settled "Settlement or dismissal" -> settled {
    authority cite ?("Cal. Code Civ. Proc. § 581")
  }
  edge-discovery-summary-judgment "Discovery closed; dispositive motion" -> summary-judgment {
    authority cite ?("Cal. Code Civ. Proc. § 437c")
  }
}

decision summary-judgment: "Summary Judgment" by court cite ?("Cal. Code Civ. Proc. § 437c")
{
  note "Summary judgment: Aguilar v. Atlantic Richfield Co., 25 Cal. 4th 826 (2001). Verify."
  edge-summary-judgment-judgment-merits "Granted" -> judgment-merits {
    authority cite ?("Cal. Code Civ. Proc. § 437c")
  }
  edge-summary-judgment-trial "Denied" -> trial {
    authority cite ?("Cal. Code Civ. Proc. § 437c")
  }
}

terminal judgment-merits: "Summary judgment entered" outcome [win] cite ?("Cal. Code Civ. Proc. § 437c")
{
  note "OUTLINE. Written from the applicant side; the winner depends on who moved (verify)."
  payoff ?
}

decision trial: "Jury or Bench Trial" by court cite ?("Cal. Code Civ. Proc. § 631")
{
  note "Jury demand timing is a hole. Verify."
  edge-trial-post-trial "Verdict or decision" -> post-trial {
    authority cite ?("Cal. Code Civ. Proc. § 631")
  }
  edge-trial-settled "Settled before verdict" -> settled {
    authority cite ?("Cal. Code Civ. Proc. § 581")
  }
}

decision post-trial: "Post-Trial Motions" by applicant cite ?("Cal. Code Civ. Proc. § 629")
{
  note "Post-trial motion timing and standard are holes. Verify."
  edge-post-trial-judgment-entered "Motions resolved or none filed" -> judgment-entered {
    authority cite ?("Cal. Code Civ. Proc. § 657")
  }
}

decision judgment-entered: "Judgment Entered" by court cite ?("Cal. Code Civ. Proc. § 664")
{
  note "Entry of judgment and finality are holes. Verify."
  edge-judgment-entered-appeal-filed "Notice of appeal" -> appeal-filed {
    authority cite ?("Cal. Rules of Court, rule 8.104")
  }
  edge-judgment-entered-judgment-final "No appeal" -> judgment-final {
    authority cite ?("Cal. Code Civ. Proc. § 664")
  }
}

terminal appeal-filed: "Notice of appeal filed; continue in appellate package" outcome [appeal] cite ?("Cal. Rules of Court, rule 8.104")
{
  note "Notice period is a hole. Verify the appellate notice rule and tolling."
  payoff ?
}

terminal judgment-final: "Final judgment, no appeal" outcome [judgment] cite ?("Cal. Code Civ. Proc. § 664")
{
  note "OUTLINE. Outcome depends on the judgment entered (verify)."
  payoff ?
}

terminal settled: "Settled or dismissed by agreement" outcome [settle] cite ?("Cal. Code Civ. Proc. § 581")
{
  note "OUTLINE. Settlement terms and any dismissal mechanics are holes."
  payoff ?
}

