module itc.commission-review-to-federal-circuit-appeal

import itc.periods.{
  federal-circuit-appeal-period,
  petition-for-review-period,
  petition-response-period,
}

import itc.{
  commission-review-group,
  federal-circuit-appeal-group,
  presidential-review-group,
  remedy-enforcement-group,
}

decision petition-for-review-window: "Petition-for-Review Window" by applicant effective [2025-02-03, ..) cite "cfr210.43.a.1"
{
  group commission-review-group
  note "12 days after service for a violation ID; 10 days for a terminating summary determination (see summary-determination-id above); 5 business days for other 210.42(c) determinations. A pure player node — file, or let the window close."
  _ "File Petition for Commission Review (Rule 210.43(a)(1))" -> petition-filed {
    authority cite "cfr210.43.a.1"
    effort 45.hours
    cost 3_000.usd
    within petition-for-review-period {
      note "19 CFR 210.43(a)(1): 12 days after service for a § 210.42(a)(1) violation ID; 10 days for a terminating summary determination; 5 business days for other 210.42(c) determinations. Missing the applicable window abandons the adversely-decided issues — flag itc337/petition-review-abandoned raised."
    }
    duration { min 1.8.days, mode 6.days, max 12.days }
    valence good
    action_id "file.petition.review"
  }
  _ "No petition filed — issues decided adversely are abandoned (Rule 210.43(a)(4))" -> id-becomes-commission-determination {
    authority cite "cfr210.43.a.4"
    effort 0.hours
    valence bad
  }
}

state petition-filed: "Petition for Commission Review Filed" effective [2025-02-03, ..) cite "cfr210.43.a.1"
{
  group commission-review-group
  note "Must identify the seeking party, specify the issues for review, and cite clearly-erroneous-fact, erroneous-legal-conclusion, or Commission-policy grounds; concise statement of facts and argument capped at 100 pages (summary required past 50, capped at 10). Unraised issues are deemed abandoned."
  _ "Opposing party responds — 8 days for a violation-ID petition, 5 business days otherwise (Rule 210.43(c))" -> petition-response {
    authority cite "cfr210.43.c"
    cost 2_500.usd
    within petition-response-period {
      note "19 CFR 210.43(c): 8 days for a § 210.42(a)(1) violation-ID petition response, 5 business days for other petition types. A party in default may not respond on issues where it defaulted."
    }
    duration { min 1.2.days, mode 4.days, max 8.days }
    action_id "respond.petition.review"
  }
}

state petition-response: "Response to Petition Filed" by office effective [2025-02-03, ..) cite "cfr210.43.c"
{
  group commission-review-group
  note "8 days to respond to a § 210.42(a)(1) violation-ID petition, 5 business days for other petition types. A party in default may not respond on issues where it defaulted."
  _ "Commission decides whether to grant the petition — 45 days for a terminating summary determination, 30 days otherwise (Rule 210.43(d))" -> commission-review-decision {
    authority cite "cfr210.43.d"
    duration { mode 30.days, max 45.days }
    note "Duration: 19 CFR 210.43(d) gives the Commission 30 days to decide whether to review (45 for a terminating summary determination) -- sourced, not an estimate."
  }
}

/// A ruling committed to the tribunal's discretion, not a party's choice:
/// 19 C.F.R. § 210.43(d)(2): review is granted for error or abuse, or for
/// "a policy matter ... which the Commission thinks it necessary or
/// appropriate to address".
chance commission-review-decision: "Commission Decides Whether to Grant Review" by office discretion effective [2025-02-03, ..) cite "cfr210.43.d"
{
  group commission-review-group
  note "Grant rate authored at 0.35 / denial at 0.65 — APPROXIMATE. Granted 'if it appears that an error or abuse... is present or if the petition raises a policy matter... which the Commission thinks it necessary or appropriate to address' — decided 'based upon the petition and response thereto, without oral argument or further written submissions unless the Commission shall order otherwise.'"
  _ "Petition granted — error/abuse present, or a policy matter the Commission wishes to address (Rule 210.43(d))" -> review-granted p 0.35 {
    authority cite "cfr210.43.d"
  }
  _ "Petition denied — the ID becomes the Commission's final determination" -> id-becomes-commission-determination p 0.65 {
    authority cite "cfr210.42.a.1"
  }
}

state review-granted: "Commission Review Granted" by office effective [2025-02-03, ..) cite "cfr210.43.d"
{
  group commission-review-group
  note "The Commission decides within 45 days for a potentially investigation-terminating summary determination, 30 days for other determinations."
  _ "Commission reviews on the merits and issues its opinion" -> commission-opinion {
    authority cite "cfr210.43.d"
  }
}

state id-becomes-commission-determination: "ID Matures into the Commission's Determination" by office effective [2025-02-03, ..) cite "cfr210.42.a.1"
{
  group commission-review-group
  note "Reached either because no petition was timely filed (flag itc337/petition-review-abandoned raised as to the adversely-decided issues, per the abandonment-of-issues-not-of-case principle: 'a party's failure to file a petition for review shall constitute abandonment of all issues decided adversely to that party') or because the Commission declined to order review. By operation of 210.42(a)(1), the ALJ's Initial Determination becomes the Commission's own final determination 60 days after service, with no separate Commission opinion ever written — the ITC's version of a magistrate's R&R adopted by non-objection (cf. Certain Automated Mechanical Transmission Systems, 337-TA-503)."
  _ "Non-reviewed ID matures into the Commission's Final Determination by operation of Rule 210.42(a)(1)" -> commission-final-determination {
    authority cite "cfr210.42.a.1"
  }
}

state commission-opinion: "Commission Reviews on the Merits" by office effective [2025-02-03, ..) cite "cfr210.43.d"
{
  group commission-review-group
  note "The Commission decides the petition 'based upon the petition and response thereto, without oral argument or further written submissions unless the Commission shall order otherwise' — granted where 'an error or abuse... is present' or the petition 'raises a policy matter... which the Commission thinks it necessary or appropriate to address.' Decision due within 45 days for a potentially investigation-terminating summary determination, 30 days otherwise. The Commission may affirm, reverse, or modify the ALJ in whole or in part (cf. the Samsung/Apple pair, 337-TA-794 and 337-TA-796, and Certain Footwear Products, 337-TA-936, where review genuinely changed the outcome)."
  _ "Commission's opinion becomes the Commission's Final Determination" -> commission-final-determination {
    authority cite "cfr210.43.d"
  }
}

/// A ruling the tribunal makes under a legal standard, not a party's
/// choice: 19 U.S.C. § 1337(c): the Commission "shall determine ... whether
/// or not there is a violation".
chance commission-final-determination: "Commission Final Determination" by office discretion effective [1995-01-01, ..) cite "usc1337.b.1"
{
  group commission-review-group
  note "The § 1337(b)(1) 'earliest practicable time' mandate resolves here, whether the determination arrived by non-reviewed ID maturation, Commission opinion, or (see cafc-remanded below) a Federal Circuit remand. No-violation authored at 0.35 / violation-with-remedy at 0.65 — APPROXIMATE."
  _ "Commission's Final Determination: no violation" -> no-violation-outcome p 0.35 {
    authority cite "usc1337.b.1"
  }
  _ "Commission's Final Determination: violation found — Commission determines remedy" -> remedy-determined p 0.65 {
    authority cite "usc1337.d"
  }
}

state no-violation-outcome: "Commission Determination: No Violation" by applicant effective [1995-01-01, ..) cite "usc1337.b.1"
{
  group commission-review-group
  note "Complainant's investigation concludes without relief. Still a 'final determination' any adversely affected person — including the complainant — may appeal under § 1337(c)."
  _ "Complainant (or another adversely affected person) considers appeal of the no-violation determination" -> federal-circuit-appeal-window {
    authority cite "usc1337.c"
    effort 0.hours
  }
}

state remedy-determined: "Commission Determines Remedy" by office effective [1995-01-01, ..) cite "usc1337.d"
{
  group commission-review-group
  note "A limited exclusion order (LEO) runs only against adjudicated respondents' imports. A general exclusion order (GEO) runs against the article itself regardless of source, and is available only on the heightened Certain Airless Paint Spray Pumps (337-TA-90) showing — now codified at § 1337(d)(2) — of a widespread pattern of unauthorized use plus business conditions suggesting other, not-yet-identified foreign manufacturers may enter the market (cf. Certain Height-Adjustable Desk Platforms, 337-TA-1125, a clean textbook GEO grant). In addition to, or instead of, an exclusion order, the Commission may issue a cease-and-desist order (CDO) reaching domestic conduct — sales of existing U.S. inventory — that an exclusion order cannot touch (§ 1337(f))."
  _ "Commission serves the determination — the 60-day Presidential (USTR) disapproval window begins (§ 1337(j))" -> presidential-review-window {
    authority cite "usc1337.j"
    duration { mode 60.days, max 60.days }
    note "Duration: 19 U.S.C. § 1337(j)'s disapproval window is 60 days -- sourced, not an estimate."
  }
}

/// A ruling committed to the tribunal's discretion, not a party's choice:
/// 19 U.S.C. § 1337(j)(2): the President (by delegation, the USTR) may
/// disapprove "for policy reasons".
chance presidential-review-window: "Presidential (USTR) Review Window" by office discretion effective [1995-01-01, ..) cite "usc1337.j"
{
  group presidential-review-group
  note "A 60-day window, delegated in practice to the U.S. Trade Representative (Presidential Memorandum of July 21, 2005, 70 Fed. Reg. 43,251), during which a Commission remedy is not yet enforceable as a final matter. Approval-by-silence authored at 0.9 / disapproval at 0.1 — APPROXIMATE and deliberately skewed toward approval: the veto is rare enough that its two confirmed modern instances (Certain Electronic Devices..., 337-TA-794 — the Samsung/Apple FRAND-SEP veto, August 2013, the first since 1987; and the 1987 DRAM veto candidate flagged in design/itc-classic-cases.md §2.10) are each individually notable. Contrast Certain Baseband Processor Chips, 337-TA-543, and Certain Tobacco Heating Articles, 337-TA-1199, where the same 60-day window ran and the remedy simply took effect — the ordinary case this node models most of the time."
  _ "President/USTR disapproves within 60 days for policy reasons — determination and remedy have no force or effect (§ 1337(j))" -> determination-vetoed p 0.1 {
    authority cite "usc1337.j"
  }
  _ "60 days elapse without disapproval — the remedy takes effect (§ 1337(j))" -> remedy-in-effect p 0.9 {
    authority cite "usc1337.j"
  }
}

terminal determination-vetoed: "Presidential/USTR Disapproval — No Force or Effect" outcome [final, no-remedy] effective [1995-01-01, ..) cite "usc1337.j"
{
  group presidential-review-group
  note "'[S]uch determination and the action taken... shall have no force or effect.' Not merely the remedy — the DETERMINATION ITSELF is voided, which is why this is modeled as a clean terminal with no onward Federal Circuit appeal edge: there is nothing left to appeal. A governor's-clemency-style override of what looked like a final civil judgment, with no FRCP analog. PLACEHOLDER PAYOFF: $50,000, override per matter. This terminal is only reachable after a VIOLATION finding and remedy (`remedy-determined`) -- the merits were won, but § 1337(j) voids the determination and remedy entirely, so self recovers no exclusion/cease-desist relief. The pack's authored `valence` of 'good' reflects the rarity/drama of a presidential override, not self's economic outcome; this payoff instead reflects the lost remedy (nominal vindication value only)."
  valence good
  payoff 50_000.usd
}

state remedy-in-effect: "Remedy Takes Effect" by applicant effective [1995-01-01, ..) cite "usc1337.j"
{
  group remedy-enforcement-group
  note "The exclusion order and/or cease-and-desist order become enforceable; U.S. Customs and Border Protection administers exclusion at the border. Post-order enforcement mechanics (advisory opinions, modification/enforcement proceedings under 19 CFR 210.75-210.79, and redesign-around fights like Certain Robotic Vacuum Cleaning Devices, 337-TA-1252, or the Masimo/Apple Watch saga, 337-TA-1276) are OUT OF SCOPE for this pack per its own scope note and are not modeled downstream of this node — a deliberate boundary matching content/rulepacks/itc-337-pack.json's stated first-pass limits, not an oversight."
  _ "Respondent (or another adversely affected person) considers appeal of the violation determination and remedy" -> federal-circuit-appeal-window {
    authority cite "usc1337.c"
    effort 0.hours
  }
}

/// Dated from the Court of Appeals Miscellaneous Fee Schedule's Dec. 1,
/// 2023 docketing fee ($600; the pack's `coa-fee-schedule` source), which
/// the notice-of-appeal edge charges; 19 U.S.C. § 1337(c)'s 60 days are
/// older (Pub. L. 103-465, § 321(a)(2), from Jan. 1, 1995). The earlier
/// fee is not in the pack or its sources, so no earlier version is modeled.
decision federal-circuit-appeal-window: "Federal Circuit Appeal Window" by applicant effective [2023-12-01, ..) cite "usc1337.c"
{
  group federal-circuit-appeal-group
  note "Any person adversely affected by a final Commission determination may appeal — reachable from BOTH a no-violation outcome (complainant appeals) and a remedy-in-effect outcome (respondent appeals), the same fork viewed from either side of the caption."
  _ "File Notice of Appeal to the Federal Circuit — 60 days after the determination becomes final (§ 1337(c); 28 U.S.C. § 1295(a)(6))" -> appeal-filed {
    authority cite "usc1337.c"
    effort 6.hours
    cost 600.usd
    within federal-circuit-appeal-period {
      note "19 U.S.C. § 1337(c): 60 days, unextendable. Missing it raises flag itc337/fedcir-appeal-forfeited."
    }
    duration { min 9.days, mode 30.days, max 60.days }
    valence good
    action_id "file.appeal.fedcir"
    note "Filing fee $600.00: the Court of Appeals docketing fee (Court of Appeals Miscellaneous Fee Schedule item 1, effective 12/1/2023) alone -- no ITC-clerk equivalent of 28 U.S.C. § 1917's $5.00 district-clerk notice fee applies to a direct agency-to-CAFC appeal (matches cafc-federal-circuit.json's itc-file-noa edge)."
  }
  _ "No appeal filed within 60 days — the Commission's determination stands (§ 1337(c))" -> determination-final-unappealed {
    authority cite "usc1337.c"
    effort 0.hours
    valence bad
  }
}

state appeal-filed: "Notice of Appeal Filed (Federal Circuit)" by office effective [1995-01-01, ..) cite "usc1337.c"
{
  group federal-circuit-appeal-group
  note "28 U.S.C. § 1295(a)(6) vests the Federal Circuit with exclusive jurisdiction over Section 337 appeals, reviewed 'in accordance with chapter 7 of title 5' (the APA)."
  _ "Federal Circuit reviews the Commission's determination" -> federal-circuit-review {
    authority cite "usc1337.c"
    duration { min 240.days, mode 365.days, max 540.days }
    note "Duration: estimate. The Federal Circuit's own published median time from docketing to disposition is roughly a year across all appeal types; § 337-appeal-specific data is not in the local corpus."
  }
}

terminal determination-final-unappealed: "Commission Determination Stands — Unappealed" outcome [final] effective [1995-01-01, ..) cite "usc1337.c"
{
  group federal-circuit-appeal-group
  note "The 60-day window closes with no notice of appeal; flag itc337/fedcir-appeal-forfeited raised. The Commission's determination and remedy (or its absence) stand unreviewed. PLACEHOLDER PAYOFF: $400,000, override per matter. This terminal is reached from either a no-violation or a violation/remedy-in-effect posture (the graph does not fork by which one before the appeal window lapses), so a single payoff necessarily blends a possible unappealed win with a possible unappealed loss; override once the matter's actual determination is known."
  valence bad
  payoff 400_000.usd
}

/// A ruling the tribunal makes under a legal standard, not a party's
/// choice: 19 U.S.C. § 1337(c): review "in accordance with chapter 7 of
/// title 5", a legal standard rather than discretion.
chance federal-circuit-review: "Federal Circuit Reviews the Determination" by office discretion effective [1995-01-01, ..) cite "usc1337.c"
{
  group federal-circuit-appeal-group
  note "Affirmance authored at 0.7 / reversal-or-remand at 0.3 — APPROXIMATE. Standard of review tracks APA § 706 (substantial evidence for Commission fact-finding, de novo for legal conclusions) — see e.g. TianRui Group Co. v. ITC (337-TA-655, extraterritorial trade-secret jurisdiction affirmed) and ClearCorrect Operating v. ITC (337-TA-833, 'articles' jurisdiction REVERSED as to purely digital transmissions)."
  _ "Federal Circuit affirms the Commission" -> cafc-affirmed p 0.7 {
    authority cite "usc1337.c"
    court_listener_url "https://www.courtlistener.com/opinion/615096/tianrui-group-co-v-international-trade-commission/"
  }
  _ "Federal Circuit reverses or remands to the Commission for further proceedings" -> cafc-remanded p 0.3 {
    authority cite "usc1337.c"
    court_listener_url "https://www.courtlistener.com/opinion/3153481/clearcorrect-operating-llc-v-international-trade-commission/"
  }
}

terminal cafc-affirmed: "Federal Circuit Affirms" outcome [affirmed, final] effective [1995-01-01, ..) cite "usc1337.c"
{
  group federal-circuit-appeal-group
  note "The Commission's determination and remedy stand as issued. PLACEHOLDER PAYOFF: $700,000, override per matter. Reached by affirming either a violation/remedy determination (a self win, the majority of the probability mass into this terminal) or a no-violation determination (a self loss); this blends both under one id -- override once the matter's actual determination is known."
  valence good
  court_listener_url "https://www.courtlistener.com/opinion/615096/tianrui-group-co-v-international-trade-commission/"
  payoff 700_000.usd
}

state cafc-remanded: "Federal Circuit Reverses or Remands" by office effective [1995-01-01, ..) cite "usc1337.c"
{
  group federal-circuit-appeal-group
  note "Remand does not simply 'send the case back' — it can produce a genuinely different final answer (cf. Certain Sleep-Disordered Breathing Treatment Systems, 337-TA-890: ALJ Pender's remand determination reversed the original violation finding to no violation, followed by a separate Commission Advisory Opinion in the same investigation number under 19 CFR 210.79). Closes a deliberate cycle back into commission-final-determination — the ITC analog of mpep-prosecution.json's RCE loop, except the 'loop' here is judicial rather than administrative."
  court_listener_url "https://www.courtlistener.com/opinion/3153481/clearcorrect-operating-llc-v-international-trade-commission/"
  _ "Commission reconsiders on remand — a remand determination can genuinely change the outcome (cf. Certain Sleep-Disordered Breathing Treatment Systems, 337-TA-890)" -> commission-final-determination {
    authority cite "usc1337.c"
  }
}
