// OUTLINE (unverified). The FRBP periods are imported from lit/frbp and its
// cites are bound to the vendored FRBP text; this package declares only the
// Bankr. N.D. Ind. court's local bankruptcy rule layer, every cite of which is ?(...) and
// every value ? until a fetch-first pass vendors the local rules and a later
// pass verifies and promotes the package.
module outline-bankr-inn

import frbp.appeals.{ notice-period }

import frbp.case.{
  adversary-answer-period,
  chapter13-plan-period,
  claim-period,
  discharge-objection-period,
  dischargeability-complaint-period,
  new-trial-period,
  schedules-period,
  summons-service-period,
}

start petition-filed

state petition-filed: "Petition filed" by applicant cite "FRBP 1002"
{
  note "Cases are referred from the district court under 28 U.S.C. § 157(a) (verify). Local petition, filing and electronic-filing requirements are holes (local rules 1002-1, 1007-1 and 5005-1 under the uniform numbering; verify the court's numbering)."
  edge-petition-filed-schedules "Schedules and statements filed" -> meeting-of-creditors {
    authority cite "FRBP 1007(c)(1)"
    within schedules-period
  }
  edge-petition-filed-schedules-local "Local list and schedule requirements" -> meeting-of-creditors {
    authority cite ?("LBR (Bankr. N.D. Ind.) 1007-1")
  }
  edge-petition-filed-dismissed "Schedules not filed; case dismissed" -> case-dismissed {
    authority cite "FRBP 1017(a)"
  }
}

state meeting-of-creditors: "Meeting of creditors" by office cite "FRBP 2003"
{
  note "The United States trustee or bankruptcy administrator convenes the section 341 meeting; local scheduling and appearance requirements are holes."
  edge-meeting-of-creditors-claims "Claims and objections period runs" -> claims-administration {
    authority cite "FRBP 3002(c)"
    within claim-period
  }
  edge-meeting-of-creditors-local "Local meeting practice" -> claims-administration {
    authority cite ?("LBR (Bankr. N.D. Ind.) 2003-1")
  }
}

decision claims-administration: "Claims, motions and objections" by applicant cite "FRBP 3007"
{
  note "Local claim-objection and motion practice (notice periods, negative notice, hearings) are holes. Key decisions (verify): City of Chicago v. Fulton, 592 U.S. 154 (2021) (automatic stay); Taylor v. Freeland & Kronz, 503 U.S. 638 (1992) (exemption objection timeliness); Kontrick v. Ryan, 540 U.S. 443 (2004) (FRBP 4004 time limits are claim-processing rules)."
  edge-claims-administration-stay-relief "Motion for relief from the automatic stay" -> stay-relief {
    authority cite "FRBP 4001(a)(1)"
  }
  edge-claims-administration-plan "Chapter 11, 12 or 13 plan" -> plan-confirmation {
    authority cite "FRBP 3015(b)"
    within chapter13-plan-period
  }
  edge-claims-administration-adversary "Complaint objecting to discharge or dischargeability" -> adversary-complaint {
    authority cite "FRBP 4007(c)"
    within dischargeability-complaint-period
  }
  edge-claims-administration-discharge "No objection to discharge" -> discharge-entered {
    authority cite "FRBP 4004(a)(1)"
    within discharge-objection-period
  }
  edge-claims-administration-objection "Claim objection" -> claims-administration-ruling {
    authority cite ?("LBR (Bankr. N.D. Ind.) 3007-1")
  }
}

decision claims-administration-ruling: "Contested matter decided" by court cite "FRBP 9014"
{
  note "Local motion practice for contested matters is a hole (LBR (Bankr. N.D. Ind.) 9013-1 and 9014-1 under the uniform numbering; verify)."
  edge-claims-administration-ruling-continue "Matter decided; case continues" -> plan-confirmation {
    authority cite ?("LBR (Bankr. N.D. Ind.) 9013-1")
  }
  edge-claims-administration-ruling-appeal "Order appealed" -> appeal-window {
    authority cite "FRBP 8002(a)(1)"
  }
}

decision stay-relief: "Relief from the automatic stay" by court cite "FRBP 4001(a)"
{
  note "Local stay-relief procedure (hearing, response period, required forms) is a hole. Key decision (verify): Ritzen Group, Inc. v. Jackson Masonry, LLC, 589 U.S. 35 (2020) (an order on a stay-relief motion is final and appealable)."
  edge-stay-relief-granted "Relief granted" -> stay-lifted {
    authority cite ?("LBR (Bankr. N.D. Ind.) 4001-1")
  }
  edge-stay-relief-denied "Relief denied" -> appeal-window { authority cite "FRBP 8002(a)(1)" }
}

terminal stay-lifted: "Stay lifted as to the movant" outcome [loss] cite "FRBP 4001(a)"
{
  note "OUTLINE. Ends the matter for the debtor as to the collateral; payoff is a hole."
  payoff ?
}

decision plan-confirmation: "Plan confirmation" by court cite "FRBP 3015"
{
  note "Local plan form, service and confirmation-hearing practice are holes (LBR (Bankr. N.D. Ind.) 3015-1 and 3020-1; verify). Key decisions (verify): Bullard v. Blue Hills Bank, 575 U.S. 496 (2015) (an order denying confirmation with leave to amend is not final); Till v. SCS Credit Corp., 541 U.S. 465 (2004) (cram-down interest rate); United Student Aid Funds, Inc. v. Espinosa, 559 U.S. 260 (2010) (confirmed plan binding)."
  edge-plan-confirmation-confirmed "Plan confirmed" -> discharge-entered {
    authority cite "FRBP 3020(b)"
  }
  edge-plan-confirmation-local "Local confirmation requirements" -> discharge-entered {
    authority cite ?("LBR (Bankr. N.D. Ind.) 3015-1")
  }
  edge-plan-confirmation-denied "Confirmation denied; case dismissed or converted" -> case-dismissed {
    authority cite "FRBP 1017(f)"
  }
}

state adversary-complaint: "Adversary proceeding commenced" by applicant cite "FRBP 7001"
{
  note "Local adversary cover sheet and summons practice are holes (LBR (Bankr. N.D. Ind.) 7003-1 and 7004-1; verify). Key decision (verify): Grogan v. Garner, 498 U.S. 279 (1991) (preponderance standard for dischargeability)."
  edge-adversary-complaint-served "Summons served" -> adversary-response {
    authority cite "FRBP 7004(e)(1)"
    within summons-service-period
  }
}

decision adversary-response: "Answer or Rule 12 motion" by applicant cite "FRBP 7012(a)"
{
  note "Pleading standard applies through FRBP 7012(b). Key decisions (verify): Bell Atlantic Corp. v. Twombly, 550 U.S. 544 (2007); Ashcroft v. Iqbal, 556 U.S. 662 (2009). Statement of consent to final orders: Stern v. Marshall, 564 U.S. 462 (2011); Wellness International Network, Ltd. v. Sharif, 575 U.S. 665 (2015)."
  edge-adversary-response-answered "Answer filed" -> adversary-discovery {
    authority cite "FRBP 7012(a)(1)"
    within adversary-answer-period
  }
  edge-adversary-response-default "No answer; default" -> adversary-default {
    authority cite "FRBP 7055"
  }
}

decision adversary-default: "Default and default judgment" by court cite "FRBP 7055"
{
  note "Local default-judgment procedure is a hole (LBR (Bankr. N.D. Ind.) 7055-1; verify)."
  edge-adversary-default-judgment "Default judgment entered" -> adversary-judgment {
    authority cite ?("LBR (Bankr. N.D. Ind.) 7055-1")
  }
}

state adversary-discovery: "Discovery and pretrial" by applicant cite "FRBP 7026"
{
  note "Local discovery, scheduling and pretrial-order practice are holes (LBR (Bankr. N.D. Ind.) 7016-1 and 7026-1; verify)."
  edge-adversary-discovery-dispositive "Discovery closed" -> adversary-dispositive {
    authority cite ?("LBR (Bankr. N.D. Ind.) 7026-1")
  }
}

decision adversary-dispositive: "Summary judgment" by court cite "FRBP 7056"
{
  note "Local statement-of-facts and briefing requirements are holes (LBR (Bankr. N.D. Ind.) 7056-1; verify). Key decisions (verify): Celotex Corp. v. Catrett, 477 U.S. 317 (1986); Anderson v. Liberty Lobby, Inc., 477 U.S. 242 (1986)."
  edge-adversary-dispositive-granted "Summary judgment granted" -> adversary-judgment {
    authority cite "FRBP 7056"
  }
  edge-adversary-dispositive-denied "Denied; trial" -> adversary-trial {
    authority cite ?("LBR (Bankr. N.D. Ind.) 7056-1")
  }
}

decision adversary-trial: "Trial" by court cite "FRBP 7052"
{
  note "Local trial-exhibit and witness practice are holes. Findings and conclusions under FRBP 7052; proposed findings in a non-core proceeding under FRBP 9033."
  edge-adversary-trial-judgment "Judgment entered" -> adversary-judgment {
    authority cite "FRBP 7052"
  }
}

state adversary-judgment: "Judgment in the adversary proceeding" by court cite "FRBP 7058"
{
  note "Post-judgment motion practice is a hole beyond the FRBP periods."
  edge-adversary-judgment-post-trial "Motion for new trial or to alter or amend" -> appeal-window {
    authority cite "FRBP 9023(b)"
    within new-trial-period
  }
  edge-adversary-judgment-appeal "Appeal directly" -> appeal-window {
    authority cite "FRBP 8002(a)(1)"
  }
}

decision appeal-window: "Notice of appeal" by applicant cite "FRBP 8002(a)(1)"
{
  note "Appeal lies to the district court or, where established, the bankruptcy appellate panel (28 U.S.C. § 158; verify). Local appeal-transmission practice is a hole (LBR (Bankr. N.D. Ind.) 8003-1 and 8009-1; verify)."
  edge-appeal-window-appealed "Notice filed in time" -> appeal-taken {
    authority cite "FRBP 8002(a)(1)"
    within notice-period
  }
  edge-appeal-window-final "No appeal" -> order-final { authority cite "FRBP 8002(a)(1)" }
}

terminal appeal-taken: "Appeal taken to the district court or BAP" outcome [appeal] cite "FRBP 8003"
{
  note "OUTLINE. The appeal proceeds under FRBP Part 8 and the appellate court's rules."
  payoff ?
}

terminal order-final: "Order or judgment final" outcome [judgment] cite "FRBP 8002(a)(1)"
{
  note "OUTLINE. Payoff is a hole."
  payoff ?
}

terminal discharge-entered: "Discharge entered" outcome [win] cite "FRBP 4004(c)"
{
  note "OUTLINE. Local discharge and case-closing practice are holes (LBR (Bankr. N.D. Ind.) 4004-1 and 5009-1; verify)."
  payoff ?
}

terminal case-dismissed: "Case dismissed" outcome [loss] cite "FRBP 1017(a)"
{
  note "OUTLINE. Local dismissal and conversion practice are holes (LBR (Bankr. N.D. Ind.) 1017-1; verify)."
  payoff ?
}
