{"parents":[{"StatuteId":2048328,"Type":"Title","Statute":"23A"},{"StatuteId":2049031,"Type":"Chapter","Statute":"33"}],"Previous":"23A-32-22","Next":"23A-33-1","StatuteId":2049031,"Statute":"23A-33","Type":"Chapter","CatchLine":"RELIEF PENDING APPEAL ","FilePath":null,"FileName":null,"Htmlpath":null,"Htmlfilename":null,"Title":23,"TitleLetter":"A","Chapter":33,"ChapterLetter":null,"Section":0,"SubSec":0,"SubSection":null,"Word":null,"Html":"                                                                   \r\n                                                                          \r\n                                                                          \r\n                                                                          \r\n                                                                          \r\n<html>\r\n<head>\r\n<html>\r\n<head>\r\n<title>23A-33 RELIEF PENDING APPEAL </title>\r\n<meta name=\"Keywords\" content=\"South Dakota Codified Laws SDCL 23A-33 RELIEF PENDING APPEAL \">\r\n<meta name=\"Description\" content=\"South Dakota Codified Laws 23A-33\">\r\n</head>\r\n<body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\">\r\n\r\n<!-- File converted by Wp2Html Version 4.0  -->\r\n<!-- Email Andrew@brackenbeds.co.uk for more details  -->\r\n\r\n<!-- WP Style Open: System_34 --><!-- WP Style End: System_34 -->\r\n<div align=\"full\">\r\n<!-- WP Paired Style On: HG4 --><div align=\"center\"><!-- WP Style End: HG4 -->\r\nCHAPTER 23A-33\r\n<!-- WP Paired Style Off: HG4 --><!-- WP Style End: HG4 -->\r\n</div>\r\n\r\n<br>\r\n\r\n<!-- WP Paired Style On: HG4C --><div align=\"center\"><!-- WP Style End: HG4C -->\r\nRELIEF PENDING APPEAL\r\n<!-- WP Paired Style Off: HG4C --><!-- WP Style End: HG4C -->\r\n</div>\r\n\r\n<br>\r\n<p>\r\n\r\n<!-- WP Paired Style On: B --><!-- WP Style End: B -->\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-33-1\">23A-33-1</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\nStay of execution by trial court on notice of intent to appeal.\r\n<!-- WP Paired Style Off: B --><!-- WP Style End: B -->\r\n<br>\r\n\r\n<!-- WP Paired Style On: B --><!-- WP Style End: B -->\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-33-2\">23A-33-2</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\n(Rule 38(a)(2)) Stay of imprisonment on appeal--Transfer of prisoner to\r\nfacilitate preparation of appeal.\r\n<!-- WP Paired Style Off: B --><!-- WP Style End: B -->\r\n<br>\r\n\r\n<!-- WP Paired Style On: B --><!-- WP Style End: B -->\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-33-3\">23A-33-3</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\nStay of further proceedings on appeal from order before judgment.\r\n<!-- WP Paired Style Off: B --><!-- WP Style End: B -->\r\n<br>\r\n\r\n<!-- WP Paired Style On: B --><!-- WP Style End: B -->\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-33-4\">23A-33-4</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\n(Rule 38(a)(3)) Stay of fine pending appeal--Security required of defendant.\r\n<!-- WP Paired Style Off: B --><!-- WP Style End: B -->\r\n<br>\r\n\r\n<!-- WP Paired Style On: B --><!-- WP Style End: B -->\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-33-5\">23A-33-5</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\n(Rule 38(a)(4)) Stay of order for probation.\r\n<!-- WP Paired Style Off: B --><!-- WP Style End: B -->\r\n<br>\r\n\r\n<!-- WP Paired Style On: B --><!-- WP Style End: B -->\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-33-6\">23A-33-6</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\nBail pending appeal.\r\n<!-- WP Paired Style Off: B --><!-- WP Style End: B -->\r\n<br>\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-33-7\">23A-33-7</a> to 23A-33-9.\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\n(Rules 38(b), 38(c), 39)) Reserved.<p>\r\n</p></div></div></body>\r\n</html>\r\n<hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2049024Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2049024SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049024CL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2049024Normal-000000 {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-indent: 0.50in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2049024DefaultParagraphFont {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049024000001 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049024SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049024SCL-000002 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2049024Normal\"><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-33-1\"><span class=\"s2049024SENU\">23A-33-1</span></a><span xml:space=\"preserve\" class=\"s2049024SENU\">. </span><span class=\"s2049024CL\">Stay of execution by trial court on notice of intent to appeal.</span></p><p dir=\"ltr\" class=\"s2049024Normal-000000\"><span class=\"s2049024DefaultParagraphFont\">After a judgment of conviction has been rendered but before execution of the sentence thereon, a trial court may in its discretion, if the defendant states that he desires to appeal, stay execution of the sentence for a period not to exceed thirty days.</span></p><p dir=\"ltr\" class=\"s2049024Normal\"><span xml:space=\"preserve\" class=\"s2049024000001\"> </span></p><p dir=\"ltr\" class=\"s2049024Normal\"><span class=\"s2049024SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2049024SCL-000002\"><span>  <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1907/120/null/null\" aria-label=\"SL 1907, ch 120\">SL 1907, ch 120</a>, § 3; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1915/146/null/null\" aria-label=\"SL 1915, ch 146\">SL 1915, ch 146</a>, § 3; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1917/200/null/null\" aria-label=\"SL 1917, ch 200\">SL 1917, ch 200</a>, § 1; RC 1919, § 5036; SDC 1939 &amp; Supp 1960, § 34.4106; SDCL, § 23-51-11; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 406.</span></span></p></div></div></body></html><hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2049025Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2049025SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049025CL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2049025Normal-000000 {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-indent: 0.50in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2049025DefaultParagraphFont {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049025000001 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049025SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049025SCL-000002 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2049025Normal\"><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-33-2\"><span class=\"s2049025SENU\">23A-33-2</span></a><span xml:space=\"preserve\" class=\"s2049025SENU\">. </span><span class=\"s2049025CL\">(Rule 38(a)(2)) Stay of imprisonment on appeal--Transfer of prisoner to facilitate preparation of appeal.</span></p><p dir=\"ltr\" class=\"s2049025Normal-000000\"><span class=\"s2049025DefaultParagraphFont\">A sentence of imprisonment shall be stayed if an appeal is taken and the defendant is admitted to bail. If the defendant is not admitted to bail, the trial court upon request of the defendant, may order that the defendant be retained at, or transferred to, a place of confinement near the place of trial or some other convenient place, for a period reasonably necessary to permit the defendant to assist in the preparation of his appeal to the Supreme Court.</span></p><p dir=\"ltr\" class=\"s2049025Normal\"><span xml:space=\"preserve\" class=\"s2049025000001\"> </span></p><p dir=\"ltr\" class=\"s2049025Normal\"><span class=\"s2049025SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2049025SCL-000002\"><span>  <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 407.</span></span></p></div></div></body></html><hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2049026Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2049026SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049026CL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2049026Normal-000000 {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-indent: 0.50in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2049026DefaultParagraphFont {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049026000001 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049026SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049026SCL-000002 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2049026Normal\"><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-33-3\"><span class=\"s2049026SENU\">23A-33-3</span></a><span xml:space=\"preserve\" class=\"s2049026SENU\">. </span><span class=\"s2049026CL\">Stay of further proceedings on appeal from order before judgment.</span></p><p dir=\"ltr\" class=\"s2049026Normal-000000\"><span xml:space=\"preserve\" class=\"s2049026DefaultParagraphFont\">An appeal from an order made before final judgment shall stay further proceedings only by order of the trial court or by order of the Supreme Court. A trial court, however, shall have no power to stay further proceedings on an appeal provided for by § </span><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-32-5\"><span class=\"s2049026DefaultParagraphFont\">23A-32-5</span></a><span xml:space=\"preserve\" class=\"s2049026DefaultParagraphFont\"> or </span><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-32-12\"><span class=\"s2049026DefaultParagraphFont\">23A-32-12</span></a><span class=\"s2049026DefaultParagraphFont\">.</span></p><p dir=\"ltr\" class=\"s2049026Normal\"><span xml:space=\"preserve\" class=\"s2049026000001\"> </span></p><p dir=\"ltr\" class=\"s2049026Normal\"><span class=\"s2049026SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2049026SCL-000002\"><span>  SDC 1939 &amp; Supp 1960, § 34.4106; SDCL, § 23-51-12; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 408.</span></span></p></div></div></body></html><hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2049027Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2049027SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049027CL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2049027Normal-000000 {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-indent: 0.50in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2049027DefaultParagraphFont {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049027000001 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049027SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049027SCL-000002 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2049027Normal\"><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-33-4\"><span class=\"s2049027SENU\">23A-33-4</span></a><span xml:space=\"preserve\" class=\"s2049027SENU\">. </span><span class=\"s2049027CL\">(Rule 38(a)(3)) Stay of fine pending appeal--Security required of defendant.</span></p><p dir=\"ltr\" class=\"s2049027Normal-000000\"><span class=\"s2049027DefaultParagraphFont\">A sentence to pay a fine or a fine and costs, if an appeal is taken, may be stayed by a trial court or by the Supreme Court upon such terms as the court deems proper. A court may require a defendant pending appeal to deposit the whole or any part of his fine and costs with the clerk of the trial court, to give bond for the payment thereof, or to submit to an examination of assets, and it may make any appropriate order to restrain the defendant from dissipating his assets.</span></p><p dir=\"ltr\" class=\"s2049027Normal\"><span xml:space=\"preserve\" class=\"s2049027000001\"> </span></p><p dir=\"ltr\" class=\"s2049027Normal\"><span class=\"s2049027SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2049027SCL-000002\"><span>  <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 409.</span></span></p></div></div></body></html><hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2049028Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2049028SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049028CL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2049028Normal-000000 {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-indent: 0.50in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2049028DefaultParagraphFont {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049028000001 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049028SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2049028SCL-000002 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2049028Normal\"><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-33-5\"><span class=\"s2049028SENU\">23A-33-5</span></a><span xml:space=\"preserve\" class=\"s2049028SENU\">. </span><span class=\"s2049028CL\">(Rule 38(a)(4)) Stay of order for probation.</span></p><p dir=\"ltr\" class=\"s2049028Normal-000000\"><span class=\"s2049028DefaultParagraphFont\">An order placing a defendant on probation may be stayed if an appeal is taken. If not stayed, the court shall specify when the term of probation shall commence. If an order is stayed the court shall fix the terms of the stay.</span></p><p dir=\"ltr\" class=\"s2049028Normal\"><span xml:space=\"preserve\" class=\"s2049028000001\"> </span></p><p dir=\"ltr\" class=\"s2049028Normal\"><span class=\"s2049028SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2049028SCL-000002\"><span>  <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 410.</span></span></p></div></div></body></html><hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2049029Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2049029SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: