', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-top: 0;\r\n    margin-right: 0;\r\n    margin-bottom: .001pt;\r\n}\r\nspan.s2a1b7b12a3a9457c9d192db4d235e366000000 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2a1b7b12a3a9457c9d192db4d235e366NoIndent {\r\n    text-indent: 0.00in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-top: 0;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n    margin-bottom: .001pt;\r\n}\r\nspan.s2a1b7b12a3a9457c9d192db4d235e366DefaultParagraphFont-000001 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2a1b7b12a3a9457c9d192db4d235e366SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta name=\"twitter:card\" content=\"summary\"><meta property=\"og:title\" content=\"SD 23A-1-1 - Proceedings governed by title.\"><meta property=\"og:description\" content=\"SDLRC Codified Law 23A-1-1 - Proceedings governed by title.\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:url\" content=\"https://sdlegislature.gov/Statutes/23A-1-1\"><meta property=\"og:image\" content=\"https://lawmakerdocuments.blob.core.usgovcloudapi.net/photos/logoshape.webp\"><meta property=\"og:site_name\" content=\"South Dakota Legislature\"></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2a1b7b12a3a9457c9d192db4d235e366Normal\"><a href=\"https://sdlegislature.gov/Statutes?Statute=23A-1-1\" rel=\"noopener\"><span class=\"s2a1b7b12a3a9457c9d192db4d235e366SENU\">23A-1-1</span></a><span xml:space=\"preserve\" class=\"s2a1b7b12a3a9457c9d192db4d235e366SENU\">. </span><span class=\"s2a1b7b12a3a9457c9d192db4d235e366CL\">Proceedings governed by title.</span></p><p dir=\"ltr\" class=\"s2a1b7b12a3a9457c9d192db4d235e366Statute\"><span class=\"s2a1b7b12a3a9457c9d192db4d235e366DefaultParagraphFont\">This title governs the procedure to be used in the courts of this state in  any:</span></p><p dir=\"ltr\" class=\"s2a1b7b12a3a9457c9d192db4d235e366StatuteNumber1\"><span class=\"s2a1b7b12a3a9457c9d192db4d235e366DefaultParagraphFont\">(1)    Criminal proceeding; and</span></p><p dir=\"ltr\" class=\"s2a1b7b12a3a9457c9d192db4d235e366StatuteNumber1\"><span class=\"s2a1b7b12a3a9457c9d192db4d235e366DefaultParagraphFont\">(2)    Prosecution for the violation of an ordinance, resolution, or the bylaws of a unit of local government of this state, which authorizes a criminal penalty.</span></p><p dir=\"ltr\" class=\"s2a1b7b12a3a9457c9d192db4d235e366Normal\"><span xml:space=\"preserve\" class=\"s2a1b7b12a3a9457c9d192db4d235e366000000\"> </span></p><p dir=\"ltr\" class=\"s2a1b7b12a3a9457c9d192db4d235e366NoIndent\"><span xml:space=\"preserve\" class=\"s2a1b7b12a3a9457c9d192db4d235e366DefaultParagraphFont-000001\">Source:  </span><span class=\"s2a1b7b12a3a9457c9d192db4d235e366SCL\"><span><a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 1; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/2026/33/null/null\" aria-label=\"SL 2026, ch 33\">SL 2026, ch 33</a>, § 57.</span></span></p></div></div></body></html><hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2048330Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048330SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048330CL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2048330Normal-000000 {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-indent: 0.50in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048330DefaultParagraphFont {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048330000001 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048330SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048330SCL-000002 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2048330Normal\"><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-1-2\"><span class=\"s2048330SENU\">23A-1-2</span></a><span xml:space=\"preserve\" class=\"s2048330SENU\">. </span><span class=\"s2048330CL\">(Rule 2) Purposes of title--Construction.</span></p><p dir=\"ltr\" class=\"s2048330Normal-000000\"><span class=\"s2048330DefaultParagraphFont\">This title is intended to provide for the just determination of every criminal proceeding. It shall be construed to secure simplicity in procedure, fairness in administration, and the elimination of unjustifiable expense and delay.</span></p><p dir=\"ltr\" class=\"s2048330Normal\"><span xml:space=\"preserve\" class=\"s2048330000001\"> </span></p><p dir=\"ltr\" class=\"s2048330Normal\"><span class=\"s2048330SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2048330SCL-000002\"><span>  <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 2.</span></span></p></div></div></body></html>","Credits":null,"StatuteText":null,"Article":null,"Created":null,"CreatedById":null,"LastUpdated":null,"LastUpdatedBy":null,"Repealed":false,"StatuteReferencesReferencesStatute":[],"StatuteReferencesStatute":[]}