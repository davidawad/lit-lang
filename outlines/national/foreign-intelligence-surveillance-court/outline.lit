// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
// Sources: FISC Rules of Procedure (fisc.uscourts.gov, fetched 2026-10-26); 50 U.S.C.
// headings (LII, fetched 2026-10-26). Proceedings are ex parte and sealed; this outline
// records structure only. Key decisions are unverified.
module outline-fisc

start government-application

state government-application: "Government application or certification filed" by applicant cite ?("50 U.S.C. § 1805; 50 U.S.C. § 1881a(i)")
{
  note "OUTLINE. Applications for electronic surveillance orders (50 U.S.C. § 1805) and certifications for targeting under § 1881a are filed ex parte. Submission timing and form are under FISC R. 9 and R. 7 (verify text)."
  edge-government-application-review "Application or certification submitted" -> ex-parte-ruling {
    authority cite ?("FISC R. 9")
  }
  edge-government-application-challenge "Recipient challenges a directive or order" -> directive-challenge {
    authority cite ?("FISC R. 21; FISC R. 33")
  }
}

decision ex-parte-ruling: "Judge's ruling on the application (ex parte)" by court cite ?("50 U.S.C. § 1805; 50 U.S.C. § 1881a(i)")
{
  note "OUTLINE. The judge approves, modifies or denies the application. Novel or significant questions may first require briefing and notice under FISC R. 11. Key decision (verify): In re Sealed Case, 310 F.3d 717 (FISA Ct. Rev. 2002) (FISCR decision on the FISA standard, cited for the Court's review posture)."
  edge-ex-parte-ruling-approved "Approved" -> order-approved {
    authority cite ?("50 U.S.C. § 1805")
  }
  edge-ex-parte-ruling-novel "Novel issue; briefing ordered" -> novel-issue-briefing {
    authority cite ?("FISC R. 11")
  }
  edge-ex-parte-ruling-denied "Denied or modified" -> denial-recorded {
    authority cite ?("50 U.S.C. § 1805")
  }
}

state novel-issue-briefing: "Notice and briefing of a novel issue" by court cite ?("FISC R. 11")
{
  note "OUTLINE. Briefing on a novel or significant question under FISC R. 11. The briefing schedule is a hole."
  edge-novel-issue-briefing-ruling "Briefing complete" -> ex-parte-ruling {
    authority cite ?("FISC R. 11")
  }
}

state denial-recorded: "Denial or modification recorded" by court cite ?("FISC R. 18")
{
  note "OUTLINE. The court's order is recorded under FISC R. 18 (court orders). Appeal to the Court of Review is outlined in the FISCR package. The government may appeal a denial (50 U.S.C. § 1803(b))."
  edge-denial-recorded-appeal "Government seeks review" -> review-routes {
    authority cite ?("50 U.S.C. § 1803(b)")
  }
}

decision review-routes: "Review route" by applicant cite ?("FISC R. 54; FISC R. 55(a)")
{
  note "OUTLINE. Appeals to the Court of Review are by petition for review filed with the Clerk, within 30 days after the decision (FISC R. 55(a)). Recipient challenges run through the petition rules below."
  edge-review-routes-appeal "Petition for review in time" -> fiscr-package {
    authority cite ?("FISC R. 55(a)")
  }
  edge-review-routes-late "Not filed in time" -> dismissed-untimely {
    authority cite ?("FISC R. 55(a)")
  }
  edge-review-routes-none "No review sought" -> denial-final {
    authority cite ?("FISC R. 55(a)")
  }
}

state fiscr-package: "Court of Review (see the FISCR package)" by court cite ?("50 U.S.C. § 1803(b)")
{
  note "OUTLINE. The Court of Review decides the appeal. See the outline-fiscr package. The record and en banc rules are in FISC R. 54 through R. 59."
  edge-fiscr-package-done "Court of Review decides" -> fiscr-decided {
    authority cite ?("50 U.S.C. § 1803(b)")
  }
}

decision directive-challenge: "Recipient challenge to a directive or production order" by applicant cite ?("FISC R. 21; FISC R. 22; FISC R. 33")
{
  note "OUTLINE. A provider may petition to modify or set aside a directive (FISC R. 21) or the government may petition to compel compliance (FISC R. 22). Petitions challenging a production or nondisclosure order under 50 U.S.C. § 1861(f) are under FISC R. 33 and R. 34. The response periods are set by the rules (verify each): FISC R. 24(a)-(b) gives seven days for the government and provider responses. Length limits are in FISC R. 25 and R. 35."
  edge-directive-challenge-review "Petition filed; initial review" -> initial-review {
    authority cite ?("FISC R. 39")
  }
}

state initial-review: "Initial review and assignment" by court cite ?("FISC R. 27; FISC R. 38; FISC R. 39")
{
  note "OUTLINE. The Presiding Judge notifies the court, assigns the petition, and the judge conducts initial review under FISC R. 26, R. 27, R. 37, R. 38 and R. 39."
  edge-initial-review-ruling "Review complete" -> petition-ruling {
    authority cite ?("FISC R. 41")
  }
}

decision petition-ruling: "Ruling on non-frivolous petition" by court cite ?("FISC R. 41; FISC R. 28; FISC R. 29")
{
  note "OUTLINE. A non-frivolous petition goes to review on the merits under FISC R. 28 (directive) or R. 29 (compel). Frivolous petitions are denied under FISC R. 41."
  edge-petition-ruling-granted "Petition granted" -> petition-granted {
    authority cite ?("FISC R. 28")
  }
  edge-petition-ruling-denied "Petition denied" -> petition-denied {
    authority cite ?("FISC R. 41")
  }
  edge-petition-ruling-appeal "Ruling appealed to the Court of Review" -> review-routes {
    authority cite ?("FISC R. 31; FISC R. 44")
  }
}

terminal order-approved: "Order approved" outcome [win] cite ?("50 U.S.C. § 1805")
{
  note "OUTLINE. The government obtains the approved order. Duration, minimization and renewal are holes."
  payoff ?
}

terminal denial-final: "Denial not reviewed" outcome [loss] cite ?("50 U.S.C. § 1805")
{
  note "OUTLINE. The denial stands if no review is sought."
  payoff ?
}

terminal petition-granted: "Directive set aside or modified" outcome [win] cite ?("FISC R. 28")
{
  note "OUTLINE. The petition succeeds in part or in full."
  payoff ?
}

terminal petition-denied: "Petition denied" outcome [loss] cite ?("FISC R. 41")
{
  note "OUTLINE. The petition is denied, and the directive or order is enforced."
  payoff ?
}

terminal dismissed-untimely: "Review dismissed as untimely" outcome [loss] cite ?("FISC R. 55(a)")
{
  note "OUTLINE. A petition for review more than 30 days after the decision is out of time under FISC R. 55(a)."
  payoff ?
}

terminal fiscr-decided: "Court of Review decision" outcome [decided] cite ?("50 U.S.C. § 1803(b)")
{
  note "OUTLINE. The Court of Review outcome. See the outline-fiscr package."
  payoff ?
}
