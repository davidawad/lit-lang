// leading file comment
module frcp.x

import a.{ y, z }
import b.c

package p { forum f, authority A }

start s // trailing start

/// doc for group
group g: "G"

type T = List<Map<A, B>>

state s: "S" by Court cite FRCP 1
  effective [2020-01-01, ..) {
  // leading comment on edge
  a "A" -> t p 1/3 { cost -5.usd, duration { min 1.days, mode 2.days, max 3.days } } // trailing
  b "B" -> t { within d { extendable true } }

  tags [x, y]
}

terminal t: "T" { payoff ?("why") }

default dd when has_event(X(a)) && !(a.b == 1) || c < d => match x { A => 1, _ => -2 }

/* block comment at end */
