// Imported by `litigate import` from packs/frcrimp-criminal-procedure.json.
//
// Effective intervals: a node in force from the last amendment of the
// Federal Rules of Criminal Procedure (or FRAP) its own `cite` or an edge's
// `authority` names, per the history
// notes in the vendored sources/frcrimp.txt ("As amended ..., eff. ...";
// `known_at` is the adopting order's or the statute's date). Constitutional
// provisions and case names don't bound the interval. A node whose cite
// names a statute, FRAP, or the Guidelines, none vendored with an amendment
// history, starts at the vendored texts' vintage, 2024-12-01.
module frcrimp.investigation-to-appeal

import core.authority.{ CaseOrder }

import frcrimp.deadlines.{
  criminal-appeal,
  indictment-period,
  prelim-in-custody,
  rule29-period,
  rule33-period,
  rule35-period,
  speedy-trial,
}

import frcrimp.{
  appeal-group,
  arraignment-group,
  charging-group,
  discovery-group,
  investigation-group,
  plea-group,
  pretrial-motions-group,
  trial-group,
  verdict-sentencing-group,
}

start investigation

/// imported
state investigation: "Pre-Charge Investigation" by applicant effective [2024-12-01, ..) cite "Fed. R. Crim. P. 41; 18 U.S.C. § 3282"
{
  group investigation-group
  note "Search warrants (Rule 41) require probable cause before a magistrate judge. The five-year statute of limitations in 18 U.S.C. § 3282 applies to non-capital federal offenses, measured from the offense date, not from discovery of the crime — a trap when investigating old conduct."
  edge-investigation-grand-jury-convened "Present case to grand jury" -> grand-jury-convened {
    authority cite "Fed. R. Crim. P. 6(a)"
    effort 40.hours
    note "Hours: BigLaw-honest estimate for the effort of this move; basis: estimate."
  }
  edge-investigation-complaint-filed "File criminal complaint" -> complaint-filed {
    authority cite "Fed. R. Crim. P. 3, 4"
    effort 5.hours
    cost 0.usd
    note "Hours: BigLaw-honest estimate for the effort of this move; basis: estimate. No filing fee: the district court civil filing fee (28 U.S.C. § 1914(a); District Court Miscellaneous Fee Schedule) applies only to civil actions, and Fed. R. Crim. P. 3/4 impose no fee for a criminal complaint."
  }
}

/// imported
state grand-jury-convened: "Grand Jury Convened" by office cite "Fed. R. Crim. P. 6(a), (e)"
  effective [2023-01-05, ..) known_at 2023-01-05 {
  group investigation-group
  note "Grand jury proceedings are sealed under Rule 6(e); the target has no right to have counsel present in the jury room. Probable cause is the standard, not proof beyond a reasonable doubt, so hearsay and comparatively weak evidence suffice."
  edge-grand-jury-convened-grand-jury-vote "Grand jury votes" -> grand-jury-vote {
    authority cite "Fed. R. Crim. P. 6(f)"
  }
}

/// imported
chance grand-jury-vote: "Grand Jury Votes" by office discretion effective [2023-01-05, ..) known_at 2023-01-05 cite "Fed. R. Crim. P. 6(f)"
{
  group investigation-group
  note "At least 12 of the 16-23 jurors must concur to return a true bill. If fewer than 12 concur, the foreperson must report the lack of concurrence to the magistrate judge in writing — the indictment is not effective."
  edge-grand-jury-vote-indictment-returned "Return true bill" -> indictment-returned p 0.97 {
    authority cite "Fed. R. Crim. P. 6(f)"
  }
  edge-grand-jury-vote-no-bill "Return no bill" -> no-bill p 0.03 {
    authority cite "Fed. R. Crim. P. 6(f)"
  }
}

/// imported
state indictment-returned: "Indictment Returned (True Bill)" by office delegable {
  to CaseOrder
  op set
} cite "Fed. R. Crim. P. 6(f), 7; U.S. Const. amend. V"
  effective [2023-01-05, ..) known_at 2023-01-05 {
  group investigation-group
  note "The Fifth Amendment requires grand jury indictment for federal felonies unless waived. The indictment must be returned in open court by the foreperson and starts the Speedy Trial Act clock together with arraignment (18 U.S.C. § 3161(c)(1))."
  edge-indictment-returned-arrest "Execute arrest warrant on indictment" -> arrest {
    authority cite "Fed. R. Crim. P. 9"
  }
  edge-indictment-returned-arraignment "Schedule arraignment on indictment" -> arraignment {
    authority cite "Fed. R. Crim. P. 10; 18 U.S.C. § 3161(c)(1)"
    within speedy-trial {
      extendable true
      extension_authority "18 U.S.C. § 3161(h)"
      note "Trial must commence within 70 days of indictment or initial appearance, whichever is later. Missing the deadline triggers dismissal with prejudice unless § 3161(h) exclusions (motions, continuances, ends-of-justice findings) apply."
    }
    duration { min 10.5.days, mode 35.days, max 70.days }
  }
}

/// imported
terminal no-bill: "No Bill — Grand Jury Declines to Indict" by applicant outcome [win, dismissal] cite "Fed. R. Crim. P. 6(f); United States v. Thompson, 251 U.S. 407 (1920)"
  effective [2023-01-05, ..) known_at 2023-01-05 {
  group investigation-group
  note "Double jeopardy does not attach at the grand jury stage, so the government may re-present the same charges to a different grand jury. Jeopardy attaches only when the trial jury is sworn (or the first witness is sworn in a bench trial). PLACEHOLDER PAYOFF: $1,000,000, override per matter, treating this playthrough's dispositive outcome as a full win even though double jeopardy has not yet attached and the government could theoretically re-present (not modeled as a loop back in this playthrough's payoff)."
  valence good
  payoff 1_000_000.usd
  edge-no-bill-grand-jury-convened "Re-present to new grand jury" -> grand-jury-convened {
    authority cite "Fed. R. Crim. P. 6(a); 18 U.S.C. § 3282"
    effort 20.hours
    note "Hours: BigLaw-honest estimate for the effort of this move; basis: estimate."
  }
}

/// imported
state complaint-filed: "Criminal Complaint Filed" by office effective [2016-12-01, ..) known_at 2016-04-28 cite "Fed. R. Crim. P. 3"
{
  group charging-group
  note "Sworn written statement of essential facts administered under oath before a magistrate judge. A separate probable-cause affidavit is typically attached; the complaint itself need only allege the essential elements of the offense."
  edge-complaint-filed-arrest "Execute arrest warrant or summons" -> arrest {
    authority cite "Fed. R. Crim. P. 4(c)(1)"
  }
}

/// imported
state arrest: "Arrest / Warrant or Summons Executed" by office delegable {
  to CaseOrder
  op set
} cite "Fed. R. Crim. P. 4, 5(a); 18 U.S.C. § 3501(c)"
  effective [2024-12-01, ..) {
  group charging-group
  note "Defendant must be brought before a magistrate 'without unnecessary delay' — the McNabb-Mallory rule, now codified at 18 U.S.C. § 3501(c). Violation is not itself unconstitutional but triggers suppression of statements as the remedy; there is no bright-line federal day count."
  edge-arrest-initial-appearance "Bring defendant before magistrate" -> initial-appearance {
    authority cite "Fed. R. Crim. P. 5(a); 18 U.S.C. § 3501(c)"
    note "Standard is 'without unnecessary delay' (McNabb-Mallory), not a fixed day count, so no deadline is declared; often ~72 hours in practice but no bright-line federal rule. Violation triggers suppression of statements, not invalidation of the arrest."
    duration { min 0.5.days, mode 1.5.days, max 3.days }
  }
  edge-arrest-information-filed "File information" -> information-filed by applicant {
    authority cite "Fed. R. Crim. P. 7(b)"
    effort 4.hours
    cost 0.usd
    note "Hours: BigLaw-honest estimate for the effort of this move; basis: estimate. No filing fee: as with a criminal complaint, 28 U.S.C. § 1914(a)'s civil filing fee doesn't apply, and Fed. R. Crim. P. 7 imposes none."
  }
}

/// imported
state initial-appearance: "Initial Appearance" by examiner effective [2020-10-21, ..) known_at 2020-10-21 cite "Fed. R. Crim. P. 5"
{
  group charging-group
  note "Magistrate advises the defendant of the charges and rights and appoints or confirms counsel. TRAP: many defendants unknowingly waive the preliminary hearing right at this stage — an invalid waiver requires the court to hold the hearing anyway."
  edge-initial-appearance-preliminary-hearing "Set preliminary hearing" -> preliminary-hearing {
    authority cite "Fed. R. Crim. P. 5.1(c)"
    within prelim-in-custody {
      extendable true
      extension_authority "Fed. R. Crim. P. 5.1(c) — good cause, or extraordinary circumstances where justice requires the delay, even without the defendant's consent"
      note "14 days if the defendant is in custody; 21 days if released. Missing the deadline does not dismiss the charge but may support a waiver or prejudicial-delay challenge."
    }
    duration { min 2.1.days, mode 7.days, max 14.days }
  }
  edge-initial-appearance-detention-hearing "Hold detention hearing" -> detention-hearing {
    authority cite "18 U.S.C. § 3142(f)"
  }
}

