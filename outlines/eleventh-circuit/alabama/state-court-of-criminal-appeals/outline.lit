// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
// Alabama Court of Criminal Appeals.
module outline-al-court-of-criminal-appeals

import outline-al-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start invoked

state invoked: "Review invoked" by applicant cite ?("Ala. R. App. P. 4(b)(1)") {
  note "OUTLINE. Alabama's intermediate appellate court for criminal cases. It hears appeals from circuit and district courts in criminal and post-conviction (Ala. R. Crim. P. 32) cases; further review is by certiorari to the Alabama Supreme Court (verify). Notice of appeal filed in the trial court; the period is a hole (?). The appeal lies of right from a conviction (Ala. Code § 12-3-9; verify)."
  edge-invoked-proceeds "Jurisdiction accepted" -> record-prepared { event NoticeOfAppealFiled()
    authority cite ?("Ala. Code § 12-3-9")
  }
  edge-invoked-dismissed "Untimely or not reviewable; dismissed" -> review-dismissed {
    authority cite ?("Ala. R. App. P. 2(a)(1)")
  }
}

state record-prepared: "Record filed" by office cite ?("Ala. R. App. P. 10, 11") {
  note "OUTLINE. Record and transcript periods are holes (?)."
  edge-record-prepared-briefing "Record complete" -> briefing { event RecordFiled()
    authority cite ?("Ala. R. App. P. 28, 31")
  }
}

state briefing: "Briefing" by applicant cite ?("Ala. R. App. P. 28, 31") {
  note "OUTLINE. Brief periods, length limits and extension practice are holes (?). Key decisions (verify): Strickland v. Washington, 466 U.S. 668 (1984); Batson v. Kentucky, 476 U.S. 79 (1986)."
  edge-briefing-submitted "Briefs filed" -> argument { authority cite ?("Ala. R. App. P. 34") }
}

decision argument: "Oral argument or submission on briefs" by court cite ?("Ala. R. App. P. 34") {
  note "OUTLINE. Whether argument is granted, and its time limits, are holes."
  edge-argument-argued "Argued" -> decision { authority cite ?("Ala. R. App. P. 34") }
  edge-argument-submitted "Submitted on the briefs" -> decision {
    authority cite ?("Ala. R. App. P. 34")
  }
}

decision decision: "Decision" by court cite ?("Ala. R. App. P. 53") {
  note "OUTLINE. Standards of review (sufficiency, harmless error) are holes until verified. Key decision (verify): Jackson v. Virginia, 443 U.S. 307 (1979)."
  edge-decision-affirmed "Conviction affirmed" -> after-affirmance {
    authority cite ?("Ala. R. App. P. 53")
  }
  edge-decision-reversed "Reversed or remanded" -> conviction-reversed {
    authority cite ?("Ala. R. App. P. 41")
  }
}

decision after-affirmance: "Rehearing, further review or mandate" by applicant cite ?("Ala. R. App. P. 40") {
  note "OUTLINE. The rehearing and further-review periods are holes (?)."
  edge-after-affirmance-rehearing "Motion for rehearing" -> rehearing {
    authority cite ?("Ala. R. App. P. 40")
  }
  edge-after-affirmance-further "Further review sought" -> further-review {
    authority cite ?("Ala. R. App. P. 39")
  }
  edge-after-affirmance-mandate "Mandate issues" -> conviction-affirmed {
    authority cite ?("Ala. R. App. P. 41")
  }
}

decision rehearing: "Rehearing ruling" by court cite ?("Ala. R. App. P. 40") {
  note "OUTLINE. Grounds for rehearing are holes until verified."
  edge-rehearing-granted "Rehearing granted" -> decision { authority cite ?("Ala. R. App. P. 40") }
  edge-rehearing-denied-further "Rehearing denied; further review sought" -> further-review {
    authority cite ?("Ala. R. App. P. 39")
  }
  edge-rehearing-denied "Rehearing denied; mandate issues" -> conviction-affirmed {
    authority cite ?("Ala. R. App. P. 41")
  }
}

terminal review-dismissed: "Review dismissed" outcome [loss] cite ?("Ala. R. App. P. 2(a)(1)") {
  note "OUTLINE. Payoff is a hole."
  payoff ?
}

terminal conviction-affirmed: "Conviction affirmed; mandate issued" outcome [loss] cite ?("Ala. R. App. P. 41") {
  note "OUTLINE. Collateral review is a hole (verify). Payoff is a hole."
  payoff ?
}

terminal conviction-reversed: "Conviction reversed or remanded" outcome [win] cite ?("Ala. R. App. P. 41") {
  note "OUTLINE. Retrial or resentencing on remand is a hole. Payoff is a hole."
  payoff ?
}

terminal further-review: "Further review sought" outcome [appeal] cite ?("Ala. R. App. P. 39") {
  note "OUTLINE. Payoff is a hole."
  payoff ?
}
