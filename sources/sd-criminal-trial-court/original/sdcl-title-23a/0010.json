{"parents":[{"StatuteId":2048328,"Type":"Title","Statute":"23A"},{"StatuteId":2048496,"Type":"Chapter","Statute":"10"}],"Previous":"23A-9-6","Next":"23A-10-1","StatuteId":2048496,"Statute":"23A-10","Type":"Chapter","CatchLine":"(RULE 12.2) NOTICE OF MENTAL ILLNESS DEFENSE ","FilePath":null,"FileName":null,"Htmlpath":null,"Htmlfilename":null,"Title":23,"TitleLetter":"A","Chapter":10,"ChapterLetter":null,"Section":0,"SubSec":0,"SubSection":null,"Word":null,"Html":"                                                                   \r\n                                                                          \r\n                                                                          \r\n                                                                          \r\n                                                                          \r\n<html>\r\n<head>\r\n<html>\r\n<head>\r\n<title>23A-10 (RULE 12.2) NOTICE OF MENTAL ILLNESS DEFENSE </title>\r\n<meta name=\"Keywords\" content=\"South Dakota Codified Laws SDCL 23A-10 (RULE 12.2) NOTICE OF MENTAL ILLNESS DEFENSE \">\r\n<meta name=\"Description\" content=\"South Dakota Codified Laws 23A-10\">\r\n</head>\r\n<body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\">\r\n\r\n<!-- File converted by Wp2Html Version 4.0  -->\r\n<!-- Email Andrew@brackenbeds.co.uk for more details  -->\r\n\r\n<!-- WP Style Open: System_34 --><!-- WP Style End: System_34 -->\r\n<div align=\"full\">\r\n<!-- WP Paired Style On: HG4 --><div align=\"center\"><!-- WP Style End: HG4 -->\r\nCHAPTER 23A-10\r\n<!-- WP Paired Style Off: HG4 --><!-- WP Style End: HG4 -->\r\n</div>\r\n\r\n<br>\r\n\r\n<!-- WP Paired Style On: HG4C --><div align=\"center\"><!-- WP Style End: HG4C -->\r\n(RULE 12.2) NOTICE OF MENTAL ILLNESS DEFENSE\r\n<!-- WP Paired Style Off: HG4C --><!-- WP Style End: HG4C -->\r\n</div>\r\n\r\n<br>\r\n<p>\r\n\r\n<!-- WP Paired Style On: B --><!-- WP Style End: B -->\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-10-1\">23A-10-1</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\n(Rule 12.2(a))Reserved.\r\n<!-- WP Paired Style Off: B --><!-- WP Style End: B -->\r\n<br>\r\n\r\n<!-- WP Paired Style On: B --><!-- WP Style End: B -->\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-10-2\">23A-10-2</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\nForm of plea raising defense.\r\n<!-- WP Paired Style Off: B --><!-- WP Style End: B -->\r\n<br>\r\n\r\n<!-- WP Paired Style On: B --><!-- WP Style End: B -->\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-10-3\">23A-10-3</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\n(Rule 12.2(b)) Notice to prosecutor of intention to use expert testimony relating to mental\r\ncondition--Additional time allowed.\r\n<!-- WP Paired Style Off: B --><!-- WP Style End: B -->\r\n<br>\r\n\r\n<!-- WP Paired Style On: B --><!-- WP Style End: B -->\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-10-4\">23A-10-4</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\n(Rule 12.2(c)) Order to defendant to submit to psychiatric examination--Court\r\nappointment of experts--Statements by accused privileged.\r\n<!-- WP Paired Style Off: B --><!-- WP Style End: B -->\r\n<br>\r\n\r\n<!-- WP Paired Style On: B --><!-- WP Style End: B -->\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-10-5\">23A-10-5</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\n(Rule 12.2(d)) Exclusion of testimony on failure to give notice or submit to examination.\r\n<!-- WP Paired Style Off: B --><!-- WP Style End: B -->\r\n<br>\r\n\r\n<!-- WP Paired Style On: B --><!-- WP Style End: B -->\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-10-6\">23A-10-6</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\nMistrial when defense raised without pleading--Subsequent trial.\r\n<!-- WP Paired Style Off: B --><!-- WP Style End: B -->\r\n<br>\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-10-7\">23A-10-7</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\nIndependent psychiatric examination--Court approval--Notice--Cost.<p>\r\n</p></div></div></body>\r\n</html>\r\n<hr><br>                                                                   \r\n                                                                          \r\n                                                                          \r\n                                                                          \r\n                                                                          \r\n<html>\r\n<head>\r\n<html>\r\n<head>\r\n<title>23A-10-1 </title>\r\n<meta name=\"Keywords\" content=\"South Dakota Codified Laws SDCL 23A-10-1 \">\r\n<meta name=\"Description\" content=\"South Dakota Codified Laws 23A-10-1\">\r\n</head>\r\n<body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\">\r\n\r\n<!-- File converted by Wp2Html Version 4.0  -->\r\n<!-- Email Andrew@brackenbeds.co.uk for more details  -->\r\n\r\n<!-- WP Style Open: System_34 --><!-- WP Style End: System_34 -->\r\n<div align=\"full\">\r\n<!-- WP Paired Style On: SENU -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: SENU -->\r\n23A-10-1.\r\n<!-- WP Paired Style Off: SENU -->&nbsp;<!-- WP Style End: SENU -->\r\n(Rule 12.2(a))Reserved<p>\r\n</p></div></div></body>\r\n</html>\r\n<hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2048490Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048490SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048490CL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2048490Normal-000000 {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-indent: 0.50in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048490DefaultParagraphFont {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048490000001 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048490SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048490SCL-000002 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2048490Normal\"><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-10-2\"><span class=\"s2048490SENU\">23A-10-2</span></a><span xml:space=\"preserve\" class=\"s2048490SENU\">. </span><span class=\"s2048490CL\">Form of plea raising defense.</span></p><p dir=\"ltr\" class=\"s2048490Normal-000000\"><span class=\"s2048490DefaultParagraphFont\">A defendant in a criminal case raising the defense of insanity shall, at his arraignment, specially plead \"not guilty and not guilty by reason of insanity.\"</span></p><p dir=\"ltr\" class=\"s2048490Normal\"><span xml:space=\"preserve\" class=\"s2048490000001\"> </span></p><p dir=\"ltr\" class=\"s2048490Normal\"><span class=\"s2048490SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2048490SCL-000002\"><span>  <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1953/201/null/null\" aria-label=\"SL 1953, ch 201\">SL 1953, ch 201</a>, § 1; SDC Supp 1960, § 34.20A01; SDCL, § </span></span><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23-37-1\"><span class=\"s2048490SCL-000002\">23-37-1</span></a><span class=\"s2048490SCL-000002\"><span>; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 124; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1983/174/null/null\" aria-label=\"SL 1983, ch 174\">SL 1983, ch 174</a>, § 8.</span></span></p></div></div></body></html><hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2048491Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048491SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048491CL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2048491Normal-000000 {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-indent: 0.50in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048491DefaultParagraphFont {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048491000001 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048491SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048491SCL-000002 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2048491Normal\"><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-10-3\"><span class=\"s2048491SENU\">23A-10-3</span></a><span xml:space=\"preserve\" class=\"s2048491SENU\">. </span><span class=\"s2048491CL\">(Rule 12.2(b)) Notice to prosecutor of intention to use expert testimony relating to mental condition--Additional time allowed.</span></p><p dir=\"ltr\" class=\"s2048491Normal-000000\"><span class=\"s2048491DefaultParagraphFont\">If a defendant intends to introduce expert testimony relating to mental illness or insanity relevant to the issue of whether he had the mental state required for the offense charged, he shall, not less than thirty days prior to the date set for trial or at any later time as the court may direct, notify the prosecuting attorney in writing of his intention and file a copy of the notice with the clerk of the court. The court may for cause shown allow late filing of the notice or grant additional time to the parties to prepare for trial or make any other order as is appropriate.</span></p><p dir=\"ltr\" class=\"s2048491Normal\"><span xml:space=\"preserve\" class=\"s2048491000001\"> </span></p><p dir=\"ltr\" class=\"s2048491Normal\"><span class=\"s2048491SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2048491SCL-000002\"><span>  <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 125; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1983/174/null/null\" aria-label=\"SL 1983, ch 174\">SL 1983, ch 174</a>, § 9.</span></span></p></div></div></body></html><hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2048492Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048492SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048492CL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2048492Normal-000000 {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-indent: 0.50in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048492DefaultParagraphFont {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048492DefaultParagraphFont-000001 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048492000002 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048492SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048492SCL-000003 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2048492Normal\"><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-10-4\"><span class=\"s2048492SENU\">23A-10-4</span></a><span xml:space=\"preserve\" class=\"s2048492SENU\">. </span><span class=\"s2048492CL\">(Rule 12.2(c)) Order to defendant to submit to psychiatric examination--Court appointment of experts--Statements by accused privileged.</span></p><p dir=\"ltr\" class=\"s2048492Normal-000000\"><span class=\"s2048492DefaultParagraphFont\">In an appropriate case a court shall, upon motion of a prosecuting attorney, order the defendant to submit to a psychiatric examination by a psychiatrist designated for this purpose by the prosecuting attorney in an order of the court. The court may also appoint medical experts and require that the defendant submit himself for examination by such court</span><span class=\"s2048492DefaultParagraphFont-000001\">-</span><span class=\"s2048492DefaultParagraphFont\">appointed medical experts. No statement made by an accused in the course of any examination provided for by this section, whether the examination was with or without the consent of the accused, shall be admitted in evidence against him on the issue of guilt in any criminal proceeding except for the purpose of impeaching the defendant.</span></p><p dir=\"ltr\" class=\"s2048492Normal\"><span xml:space=\"preserve\" class=\"s2048492000002\"> </span></p><p dir=\"ltr\" class=\"s2048492Normal\"><span class=\"s2048492SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2048492SCL-000003\"><span>  <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1953/201/null/null\" aria-label=\"SL 1953, ch 201\">SL 1953, ch 201</a>, § 1; SDC Supp 1960, § 34.20A01; SDCL, § 23-37-2; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 126; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1979/159/null/null\" aria-label=\"SL 1979, ch 159\">SL 1979, ch 159</a>, § 9.</span></span></p></div></div></body></html><hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2048493Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048493SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048493CL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2048493Normal-000000 {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-indent: 0.50in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048493DefaultParagraphFont {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048493000001 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048493SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048493SCL-000002 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2048493Normal\"><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-10-5\"><span class=\"s2048493SENU\">23A-10-5</span></a><span xml:space=\"preserve\" class=\"s2048493SENU\">. </span><span class=\"s2048493CL\">(Rule 12.2(d)) Exclusion of testimony on failure to give notice or submit to examination.</span></p><p dir=\"ltr\" class=\"s2048493Normal-000000\"><span xml:space=\"preserve\" class=\"s2048493DefaultParagraphFont\">If the defendant fails to give notice when required by § </span><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-10-3\"><span class=\"s2048493DefaultParagraphFont\">23A-10-3</span></a><span xml:space=\"preserve\" class=\"s2048493DefaultParagraphFont\"> or to submit to an examination when ordered under § </span><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-10-4\"><span class=\"s2048493DefaultParagraphFont\">23A-10-4</span></a><span class=\"s2048493DefaultParagraphFont\">, a court shall exclude the testimony of any witness offered by a defendant on the issue of his mental state.</span></p><p dir=\"ltr\" class=\"s2048493Normal\"><span xml:space=\"preserve\" class=\"s2048493000001\"> </span></p><p dir=\"ltr\" class=\"s2048493Normal\"><span class=\"s2048493SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2048493SCL-000002\"><span>  <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 127; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1983/174/null/null\" aria-label=\"SL 1983, ch 174\">SL 1983, ch 174</a>, § 11.</span></span></p></div></div></body></html><hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2048494Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048494SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048494CL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2048494Normal-000000 {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-indent: 0.50in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048494DefaultParagraphFont {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048494000001 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048494SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048494SCL-000002 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2048494Normal\"><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-10-6\"><span class=\"s2048494SENU\">23A-10-6</span></a><span xml:space=\"preserve\" class=\"s2048494SENU\">. </span><span class=\"s2048494CL\">Mistrial when defense raised without pleading--Subsequent trial.</span></p><p dir=\"ltr\" class=\"s2048494Normal-000000\"><span xml:space=\"preserve\" class=\"s2048494DefaultParagraphFont\">If, during the trial of a criminal case, where the plea of \"not guilty and not guilty by reason of insanity\" has not been made, a court deems that a substantial suggestion of a defendant's sanity was raised as a defense, the defendant shall be deemed to have consented to a mistrial. Former jeopardy may not attach on a subsequent trial of the same case. In those circumstances, a second trial shall be had as soon as is practical and without regard for regular terms of court and the court shall, in advance of the second trial, require the defendant to submit himself for examination as prescribed by § </span><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-10-4\"><span class=\"s2048494DefaultParagraphFont\">23A-10-4</span></a><span class=\"s2048494DefaultParagraphFont\">.</span></p><p dir=\"ltr\" class=\"s2048494Normal\"><span xml:space=\"preserve\" class=\"s2048494000001\"> </span></p><p dir=\"ltr\" class=\"s2048494Normal\"><span class=\"s2048494SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2048494SCL-000002\"><span>  <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1953/201/null/null\" aria-label=\"SL 1953, ch 201\">SL 1953, ch 201</a>, § 3; SDC Supp 1960, § 34.20A03; SDCL, § 23-37-4; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 128; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1983/174/null/null\" aria-label=\"SL 1983, ch 174\">SL 1983, ch 174</a>, § 12.</span></span></p></div></div></body></html><hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2048495Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048495SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048495CL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2048495Normal-000000 {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-indent: 0.50in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048495DefaultParagraphFont {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048495000001 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048495SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048495SCL-000002 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2048495Normal\"><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-10-7\"><span class=\"s2048495SENU\">23A-10-7</span></a><span xml:space=\"preserve\" class=\"s2048495SENU\">. </span><span class=\"s2048495CL\">Independent psychiatric examination--Court approval--Notice--Cost.</span></p><p dir=\"ltr\" class=\"s2048495Normal-000000\"><span class=\"s2048495DefaultParagraphFont\">Subject to court approval, the defendant may be examined at an approved community health center by a psychiatrist of his own choosing at his own expense or, if indigent, at county expense. Examination of the defendant shall be on the issue of his insanity when the offense occurred. Notice of the independent examination shall be given to the prosecuting attorney at least five days before the examination date. A psychiatrist who examines an indigent defendant may receive a reasonable fee.</span></p><p dir=\"ltr\" class=\"s2048495Normal\"><span xml:space=\"preserve\" class=\"s2048495000001\"> </span></p><p dir=\"ltr\" class=\"s2048495Normal\"><span class=\"s2048495SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2048495SCL-000002\"><span>  <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1983/174/null/null\" aria-label=\"SL 1983, ch 174\">SL 1983, ch 174</a>, § 10.</span></span></p></div></div></body></html></head></html></head></html>","Credits":null,"StatuteText":null,"Article":null,"Created":null,"CreatedById":null,"LastUpdated":null,"LastUpdatedBy":null,"Repealed":false,"StatuteReferencesReferencesStatute":[],"StatuteReferencesStatute":[]}