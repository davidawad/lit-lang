// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-co-industrial-claim-appeals-office

import outline-co-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start filed

state filed: "Claim, petition or appeal filed" by applicant cite ?("C.R.S. § 8-43-301(2) (verify)")
{
  note "OUTLINE. The panel reviews an administrative law judge's order on a petition to review; the Court of Appeals hears appeals. Proceedings before the Colorado Industrial Claim Appeals office: filing period, form and fees are holes. Leading decisions: not yet identified in this pass; verify before use."
  edge-filed-hearing "Set for hearing" -> hearing { event ActionCommenced() authority cite ?("C.R.S. § 8-43-301 (verify)") }
}

state hearing: "Hearing" by court cite ?("C.R.S. § 8-43-301 (verify)")
{
  note "OUTLINE. Hearing procedure, evidence and the record are holes."
  edge-hearing-decision "Decision issued" -> decision { authority cite ?("C.R.S. § 8-43-301(8) (verify)") }
}

chance decision: "Tribunal decides" by court cite ?("C.R.S. § 8-43-301(8) (verify)")
{
  note "OUTLINE. Outcome probabilities are holes."
  edge-decision-granted "Relief granted" -> review p ? { event DecisionFiled() }
  edge-decision-denied "Relief denied" -> review p ? { event DecisionFiled() }
}

decision review: "Review or appeal sought?" by applicant cite ?("C.R.S. § 8-43-307 (verify)")
{
  note "OUTLINE. Review period and the reviewing body are holes."
  edge-review-none "No review" -> final-decision { event JudgmentEntered() authority cite ?("C.R.S. § 8-43-301(8) (verify)") }
  edge-review-sought "Review or judicial review sought" -> review-sought { event NoticeOfAppealFiled() authority cite ?("C.R.S. § 8-43-307 (verify)") }
}

terminal final-decision: "Decision final" outcome [final] cite ?("C.R.S. § 8-43-301(8) (verify)")
{
  note "OUTLINE. Enforcement and payment are outside this outline."
  payoff ?
}

terminal review-sought: "Review or judicial review sought" outcome [final] cite ?("C.R.S. § 8-43-307 (verify)")
{
  note "OUTLINE. The reviewing court is its own package."
  payoff ?
}
