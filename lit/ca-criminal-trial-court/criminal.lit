module ca-superior-court-criminal.criminal

// Felony prosecutions in the California superior courts. Title 4 of the
// California Rules of Court and the vendored Penal Code sections are
// CURRENCY UNCONFIRMED (sources/ca-criminal-trial-court/PROVENANCE.md), so
// they are cited for the structure of each step and no period, limit or
// amount is taken from them: where a step has one, the note names the
// provision that sets it and says that it is not stated. The rest of Penal
// Code Part 2 (complaint, arrest and arraignment on the complaint, bail,
// preliminary examination, pleas, discovery, new trial and sentencing
// statutes) is not vendored, so those steps cite holes. The criminal
// notice of appeal (California Rules of Court, rule 8.308) is not
// vendored. Outcomes are from the defendant's side. The earlier outline's
// leading decisions (County of Riverside v. McLaughlin, Gerstein v. Pugh,
// Gideon v. Wainwright, Brady v. Maryland, Mapp v. Ohio, Barker v. Wingo,
// Boykin v. Alabama, Missouri v. Frye, Jackson v. Virginia, Apprendi v.
// New Jersey, Roe v. Flores-Ortega, Garza v. Idaho) are removed: no
// reporter text is vendored.
start arrested

state arrested: "Arrest and complaint" by applicant cite ?("Penal Code Part 2, arrest and arraignment on the complaint (Pen. Code §§ 825, 859, 859a): not vendored") {
  note "Arrest, the complaint and the arraignment on the complaint before a magistrate are governed by Penal Code Part 2 sections that are not vendored; their periods are holes. A felony plea before the magistrate is certified to the superior court under Penal Code section 859a (Cal. Rules of Court, rule 4.114)."
  edge-arrested-appearance "Arraignment on the complaint" -> initial-appearance {
    authority cite ?("Penal Code § 859 (arraignment on the complaint): not vendored")
  }
}

decision initial-appearance: "Bail or release" by court cite "Cal. Rules of Court, rule 4.101"
{
  note "Whether a defendant has asked for a jury trial may not be considered in fixing bail, and once set bail may not be increased or reduced for that reason (Cal. Rules of Court, rule 4.101). The bail and release statutes are not vendored."
  edge-initial-appearance-detained "Held on bail not posted" -> probable-cause {
    authority cite "Cal. Rules of Court, rule 4.101"
  }
  edge-initial-appearance-released "Released on bail or own recognizance" -> probable-cause {
    authority cite ?("Penal Code bail and own-recognizance release statutes: not vendored")
  }
}

decision probable-cause: "Preliminary examination or grand jury" by court cite ?("Penal Code preliminary examination statutes (Pen. Code § 859b et seq.): not vendored") {
  note "The preliminary examination and holding to answer, and grand jury indictment, are governed by Penal Code provisions that are not vendored. When a person has been held to answer and no information is filed within the period Penal Code section 1382(a)(1) and rule 4.110(1) set, the action is dismissed unless good cause is shown; the period is not stated here (currency unconfirmed)."
  edge-probable-cause-charged "Held to answer or indicted" -> charged {
    authority cite "Cal. Rules of Court, rule 4.110"
  }
  edge-probable-cause-none "Discharged" -> dismissed {
    authority cite ?("Penal Code § 871 (discharge on preliminary examination): not vendored")
  }
}

state charged: "Information or indictment" by office cite "Cal. Rules of Court, rule 4.110"
{
  note "Rule 4.110 sets the time limits for proceedings on an information or indictment, including filing the information after the holding to answer and holding the arraignment; they are not stated here (currency unconfirmed)."
  edge-charged-arraignment "Arraignment on the information or indictment" -> arraignment {
    authority cite "Cal. Rules of Court, rule 4.100"
  }
}

state arraignment: "Arraignment and plea of not guilty" by applicant cite "Cal. Rules of Court, rule 4.100"
{
  note "At the arraignment on the information or indictment, on a plea of not guilty, the court sets the dates for trial and for filing and serving motions, unless otherwise ordered for good cause (Cal. Rules of Court, rule 4.100). A felony defendant must be brought to trial within the period Penal Code section 1382(a)(2) sets after arraignment on the indictment or information, or after a mistrial, new-trial order or remittitur, unless good cause is shown or the defendant waives; the period is not stated here (currency unconfirmed)."
  edge-arraignment-discovery "Discovery and motions" -> discovery {
    authority cite "Cal. Rules of Court, rule 4.111"
  }
}

state discovery: "Pretrial motions and continuances" by applicant cite "Cal. Rules of Court, rule 4.111"
{
  note "Pretrial motions, oppositions and replies are served and filed within the court-day periods rule 4.111(a) sets, unless otherwise ordered or provided by law; the periods are not stated here (currency unconfirmed). Motions to continue a trial are disfavored and are denied unless the moving party shows under Penal Code section 1050 that the ends of justice require it (Cal. Rules of Court, rule 4.113); a continuance requires written notice within the period section 1050(b) sets and good cause, and neither the parties' convenience nor their stipulation is good cause in itself (Cal. Penal Code 1050(b), (e)). The discovery statutes (Pen. Code § 1054 et seq.) are not vendored."
  edge-discovery-motions "Pretrial motion filed" -> motions-ruling {
    authority cite "Cal. Rules of Court, rule 4.111"
  }
  edge-discovery-speedy "Motion to dismiss under section 1382" -> motions-ruling {
    authority cite "Cal. Penal Code 1382"
  }
  edge-discovery-plea "Plea negotiations" -> plea-decision {
    authority cite "Cal. Rules of Court, rule 4.112"
  }
}

decision motions-ruling: "Ruling on pretrial motions" by court cite "Cal. Rules of Court, rule 4.111"
{
  note "Unless good cause to the contrary is shown, the court orders the action dismissed when an information is not timely filed after a holding to answer or a felony defendant is not timely brought to trial (Cal. Penal Code 1382(a)); a court whose calendar may require such dismissals must notify the Chair of the Judicial Council (Cal. Penal Code 1050(j)). A prisoner's demand for trial is governed by Penal Code sections 1381 and 1381.5."
  edge-motions-ruling-speedy "Dismissed under section 1382" -> dismissed {
    authority cite "Cal. Penal Code 1382"
  }
  edge-motions-ruling-dismissed "Charges dismissed on another ground" -> dismissed {
    authority cite ?("Penal Code § 995 (motion to set aside) and § 1385 (dismissal in furtherance of justice): not vendored")
  }
  edge-motions-ruling-denied "Motions denied; case proceeds" -> plea-decision {
    authority cite "Cal. Rules of Court, rule 4.111"
  }
}

decision plea-decision: "Plea or trial" by applicant cite "Cal. Rules of Court, rule 4.112"
{
  note "The court may hold a readiness conference in a felony case within the window rule 4.112(a) sets before trial, at which trial counsel appear prepared to discuss disposition without trial (Cal. Rules of Court, rule 4.112); the window is not stated here (currency unconfirmed). Cases are assigned for trial under rule 4.115, and before jury selection the court holds a pre-voir dire conference (Cal. Rules of Court, rule 4.200). The plea statutes are not vendored."
  edge-plea-decision-plea "Guilty or no-contest plea accepted" -> sentencing {
    authority cite ?("Penal Code § 1016 et seq. (pleas): not vendored")
  }
  edge-plea-decision-trial "Trial" -> trial { authority cite "Cal. Rules of Court, rule 4.200" }
}

decision trial: "Verdict" by court cite ?("Penal Code trial and verdict statutes: not vendored") {
  note "Jury selection begins after the pre-voir dire conference (Cal. Rules of Court, rule 4.200); the trial, verdict, acquittal and new-trial statutes are not vendored."
  edge-trial-acquittal "Not guilty" -> acquitted {
    authority cite ?("Penal Code verdict statutes: not vendored")
  }
  edge-trial-guilty "Guilty; sentencing" -> sentencing {
    authority cite "Cal. Rules of Court, rule 4.433"
  }
  edge-trial-new-trial "New trial granted" -> trial {
    authority cite ?("Penal Code § 1181 (new trial): not vendored")
  }
}

state sentencing: "Sentencing" by court cite "Cal. Rules of Court, rule 4.433"
{
  note "At the time set for sentencing the judge holds a hearing and determines the matters rule 4.433(a) lists (Cal. Rules of Court, rule 4.433). Statements in aggravation and mitigation are filed and served within the period rule 4.437(a) sets before sentencing, not stated here (currency unconfirmed). The determinate sentencing rules are adopted under Penal Code section 1170.3 (Cal. Rules of Court, rule 4.401)."
  edge-sentencing-judgment "Sentence pronounced; judgment entered" -> judgment {
    authority cite "Cal. Rules of Court, rule 4.433"
  }
}

decision judgment: "Judgment of conviction" by applicant cite ?("California Rules of Court, rule 8.308 (time to appeal in a felony case): not vendored") {
  note "The notice of appeal in a felony case is governed by California Rules of Court, rule 8.308, which is not vendored, so its period is a hole."
  edge-judgment-appeal "Notice of appeal filed" -> appeal-taken {
    authority cite ?("California Rules of Court, rule 8.308: not vendored")
  }
  edge-judgment-no-appeal "No appeal" -> conviction-final {
    authority cite ?("California Rules of Court, rule 8.308: not vendored")
  }
}

terminal acquitted: "Acquitted" outcome [win] cite ?("Penal Code verdict statutes: not vendored") {
  note "Outcome from the defendant's side: a verdict of not guilty."
}

terminal dismissed: "Charges dismissed" outcome [win, dismissal] cite "Cal. Penal Code 1382"
{
  note "Outcome from the defendant's side: a dismissal under Penal Code section 1382, on a pretrial motion, or a discharge at the preliminary examination."
}

terminal appeal-taken: "Appeal taken" outcome [appeal] cite ?("California Rules of Court, rule 8.308: not vendored") {
  note "The appeal continues before the California Court of Appeal under Title 8 of the California Rules of Court (lit/ca-court-of-appeal)."
}

terminal conviction-final: "Conviction final" outcome [loss] cite "Cal. Penal Code 1473"
{
  note "Outcome from the defendant's side. A person unlawfully imprisoned or restrained may prosecute a writ of habeas corpus (Cal. Penal Code 1473(a)); federal habeas belongs to lit/habeas."
}
