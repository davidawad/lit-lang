// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
// Sources: JPML Rules of Procedure, effective February 19, 2026 (jpml.uscourts.gov,
// fetched 2026-10-26; rule headings from the table of contents); 28 U.S.C. § 1407
// (LII heading, fetched 2026-10-26). Key decisions are unverified.
module outline-jpml

start actions-pending

state actions-pending: "Civil actions with common fact questions pending in different districts" by applicant cite ?("28 U.S.C. § 1407(a)")
{
  note "OUTLINE. Transfer for coordinated or consolidated pretrial proceedings under 28 U.S.C. § 1407(a). Only the Panel decides transfer. Tag-along actions join through the conditional transfer process."
  edge-actions-pending-initiated "Transfer motion or conditional transfer order" -> initiation {
    authority cite ?("J.P.M.L. R. 6.2; J.P.M.L. R. 7.1")
  }
}

decision initiation: "Motion to transfer or conditional transfer order" by applicant cite ?("J.P.M.L. R. 6.2; J.P.M.L. R. 7.1")
{
  note "OUTLINE. A motion to transfer under J.P.M.L. R. 6.2 starts a full panel proceeding. A conditional transfer order (CTO) under J.P.M.L. R. 7.1 tags along an action already in an MDL. The filing periods and notice requirements are holes."
  edge-initiation-motion "Motion to transfer filed" -> motion-briefing {
    authority cite ?("J.P.M.L. R. 6.2")
  }
  edge-initiation-cto "CTO issued for a tag-along action" -> cto-stage {
    authority cite ?("J.P.M.L. R. 7.1")
  }
}

state motion-briefing: "Motion practice: responses and replies" by applicant cite ?("J.P.M.L. R. 6.1")
{
  note "OUTLINE. Responses and replies are due under J.P.M.L. R. 6.1. The periods and page limits are holes. Miscellaneous relief is under J.P.M.L. R. 6.3."
  edge-motion-briefing-hearing "Briefing closed" -> hearing-session {
    authority cite ?("J.P.M.L. R. 6.1")
  }
}

decision cto-stage: "CTO opposed or notice of opposition" by applicant cite ?("J.P.M.L. R. 7.2")
{
  note "OUTLINE. A party may oppose a CTO; the opposition procedure is in J.P.M.L. R. 7.2 (verify that the text places it there). The period is a hole. A show cause order can issue under J.P.M.L. R. 8.1 if the matter needs more process."
  edge-cto-stage-opposed "Opposed" -> show-cause-or-hearing {
    authority cite ?("J.P.M.L. R. 7.2")
  }
  edge-cto-stage-unopposed "No opposition" -> cto-final {
    authority cite ?("J.P.M.L. R. 7.2")
  }
}

decision show-cause-or-hearing: "Show cause order or hearing" by court cite ?("J.P.M.L. R. 8.1; J.P.M.L. R. 11.1")
{
  note "OUTLINE. A show cause order under J.P.M.L. R. 8.1 directs the parties to respond. Opposed CTOs are argued at a hearing session under J.P.M.L. R. 11.1."
  edge-show-cause-hearing "Hearing held" -> hearing-session {
    authority cite ?("J.P.M.L. R. 11.1")
  }
  edge-show-cause-cto-vacated "CTO vacated" -> denied-transfer {
    authority cite ?("J.P.M.L. R. 8.1")
  }
}

state hearing-session: "Hearing session and oral argument" by court cite ?("J.P.M.L. R. 11.1")
{
  note "OUTLINE. The Panel hears oral argument at its scheduled hearing sessions under J.P.M.L. R. 11.1. The session schedule is a hole."
  edge-hearing-session-order "Argument held" -> panel-order {
    authority cite ?("J.P.M.L. R. 11.1")
  }
}

decision panel-order: "Panel order on transfer" by court cite ?("28 U.S.C. § 1407(a)")
{
  note "OUTLINE. The Panel decides whether transfer serves the convenience of parties and witnesses and promotes the just and efficient conduct of the actions (28 U.S.C. § 1407(a)). It also selects the transferee court (verify the subsection). Key decision (verify): Lexecon Inc. v. Milberg Weiss Bershad Hynes & Lerach, 523 U.S. 26 (1998) (a transferee court may not itself try a transferred case, so remand is needed for trial)."
  edge-panel-order-transfer "Transfer ordered" -> transferred {
    authority cite ?("28 U.S.C. § 1407(a)")
  }
  edge-panel-order-denied "Transfer denied" -> denied-transfer {
    authority cite ?("28 U.S.C. § 1407(a)")
  }
}

state transferred: "Transferred to transferee judge" by court cite ?("28 U.S.C. § 1407(a)")
{
  note "OUTLINE. The actions are transferred and the transferee judge runs coordinated pretrial. The transfer of files is under J.P.M.L. R. 9.1."
  edge-transferred-pretrial "Pretrial proceedings begin" -> pretrial {
    authority cite ?("J.P.M.L. R. 9.1")
  }
}

state pretrial: "Coordinated pretrial proceedings in the transferee court" by court cite ?("28 U.S.C. § 1407(b)")
{
  note "OUTLINE. Pretrial management is the transferee judge's, under 28 U.S.C. § 1407(b). Dispositive motions, discovery and settlement programs run here (outside the Panel's rules). Verify the transferee's authority before use."
  edge-pretrial-remand "Remand decision" -> remand-or-termination {
    authority cite ?("J.P.M.L. R. 10.1")
  }
}

decision remand-or-termination: "Termination, suggestion of remand or conditional remand" by court cite ?("J.P.M.L. R. 10.1; J.P.M.L. R. 10.2; J.P.M.L. R. 10.3")
{
  note "OUTLINE. Termination and remand under J.P.M.L. R. 10.1. A conditional remand order under R. 10.2. A motion to remand under R. 10.3. Files are transferred back under R. 10.4. Trial in the transferor court follows Lexecon, cited above. The timing and the standard are holes."
  edge-remand-terminated "Actions terminated" -> terminated {
    authority cite ?("J.P.M.L. R. 10.1")
  }
  edge-remand-remanded "Remanded to transferor court" -> remanded {
    authority cite ?("J.P.M.L. R. 10.3")
  }
}

state cto-final: "CTO becomes final; action transferred" by court cite ?("J.P.M.L. R. 7.1")
{
  note "OUTLINE. An unopposed CTO takes effect and the tag-along action transfers. The transfer is then the same as a Panel transfer (see the transferred node)."
  edge-cto-final-transferred "Transfer effective" -> transferred {
    authority cite ?("J.P.M.L. R. 7.1")
  }
}

terminal denied-transfer: "Transfer denied" outcome [loss] cite ?("28 U.S.C. § 1407(a)")
{
  note "OUTLINE. The Panel denies transfer or vacates a CTO. The actions stay in their transferor courts."
  payoff ?
}

terminal terminated: "MDL terminated" outcome [decided] cite ?("J.P.M.L. R. 10.1")
{
  note "OUTLINE. Termination of the MDL after pretrial proceedings are complete."
  payoff ?
}

terminal remanded: "Remanded to transferor court" outcome [remand] cite ?("J.P.M.L. R. 10.3")
{
  note "OUTLINE. The action returns to the transferor court. Trial and further motions occur there. The file transfer is under J.P.M.L. R. 10.4."
  payoff ?
}
