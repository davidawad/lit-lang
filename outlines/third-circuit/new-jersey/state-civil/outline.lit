// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-outline-nj-state-civil

start filed

state filed: "Complaint filed" by applicant cite ?("N.J. Ct. R. 4:2-1")
{
  note "OUTLINE. Commencement by filing. Summons and complaint: N.J. Ct. R. 4:4 (verify). Federal Rule 4 does not apply."
  edge-filed-served "Defendant served" -> served {
    authority cite ?("N.J. Ct. R. 4:4-4")
  }
}

decision served: "Response due" by office cite ?("N.J. Ct. R. 4:6-1(a)")
{
  note "OUTLINE. Response period is a hole. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-served-answer "Answer filed" -> answered {
    authority cite ?("N.J. Ct. R. 4:6-1(a)")
  }
  edge-served-motion "Motion to dismiss under R. 4:6-2" -> motion-pending {
    authority cite ?("N.J. Ct. R. 4:6-2")
  }
  edge-served-default "No response by the deadline" -> default-entered {
    authority cite ?("N.J. Ct. R. 4:43-1")
  }
}

state motion-pending: "Pleading motion pending" by applicant cite ?("N.J. Ct. R. 4:6-2")
{
  note "OUTLINE. Motion to dismiss under R. 4:6-2. Printing Mart-Morristown v. Sharp Electronics Corp., 116 N.J. 739 (1989) (verify: motion to dismiss standard)."
  edge-motion-ruling "Court rules" -> motion-ruling {
  }
}

chance motion-ruling: "Ruling on pleading motion" by court cite ?("N.J. Ct. R. 4:6-2")
{
  note "OUTLINE. Probabilities are holes; no calibration."
  edge-mr-dismissed "Dismissed" -> dismissed-pleading p ? {
  }
  edge-mr-leave "Dismissed with leave to amend" -> amend p ? {
  }
  edge-mr-denied "Denied" -> answered p ? {
  }
}

state amend: "Amended pleading" by applicant cite ?("N.J. Ct. R. 4:9-1")
{
  note "OUTLINE. Amendment period and consent are holes."
  edge-amend-motion "Amended pleading tested again" -> motion-pending {
  }
}

state default-entered: "Default entered" by office cite ?("N.J. Ct. R. 4:43-1")
{
  note "OUTLINE. Default entry. Setting it aside: N.J. Ct. R. 4:50-1."
  edge-default-judgment "Default judgment sought" -> default-judgment {
    authority cite ?("N.J. Ct. R. 4:43-2")
  }
  edge-default-vacate "Default vacated" -> answered {
    authority cite ?("N.J. Ct. R. 4:50-1")
  }
}

terminal default-judgment: "Default judgment entered" outcome [loss] cite ?("N.J. Ct. R. 4:43-2")
{
  note "OUTLINE. Default judgment. Damages hearing and proof are holes."
  payoff ?
}

terminal dismissed-pleading: "Dismissed on the pleadings" outcome [loss] cite ?("N.J. Ct. R. 4:6-2")
{
  note "OUTLINE. Dismissal on a pleading motion. Appeal period is a hole. Printing Mart-Morristown v. Sharp Electronics Corp., 116 N.J. 739 (1989) (verify: motion to dismiss standard)."
  payoff ?
}

state answered: "Answer filed" by applicant cite ?("N.J. Ct. R. 4:6-1")
{
  note "OUTLINE. Answer and affirmative defenses."
  edge-answered-discovery "Case proceeds to discovery" -> discovery {
    authority cite ?("N.J. Ct. R. 4:10-2")
  }
}

state discovery: "Discovery" by applicant cite ?("N.J. Ct. R. 4:10-2")
{
  note "OUTLINE. Written discovery, depositions, expert disclosure. Scope and limits are holes."
  edge-disc-dispute "Discovery dispute" -> dispute {
    authority cite ?("N.J. Ct. R. 4:23-5 (verify)")
  }
  edge-disc-sj "Dispositive motion" -> sj-motion {
    authority cite ?("N.J. Ct. R. 4:46-1, 4:46-2(c)")
  }
  edge-disc-settle "Settlement" -> settled {
  }
}

decision dispute: "Discovery dispute ruling" by court cite ?("N.J. Ct. R. 4:23-5 (verify)")
{
  note "OUTLINE. Sanctions: N.J. Ct. R. 4:23-2 (verify). Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-dispute-resolved "Dispute resolved" -> discovery {
  }
  edge-dispute-sanction "Dismissal as a sanction" -> dismissed-sanction {
    authority cite ?("N.J. Ct. R. 4:23-2 (verify)")
  }
}

terminal dismissed-sanction: "Dismissed as a discovery sanction" outcome [loss] cite ?("N.J. Ct. R. 4:23-2 (verify)")
{
  note "OUTLINE. Dismissal as a sanction. Leading decisions for this stage: not yet identified in this pass; verify before use."
  payoff ?
}

state sj-motion: "Summary judgment motion" by applicant cite ?("N.J. Ct. R. 4:46-1, 4:46-2(c)")
{
  note "OUTLINE. Summary judgment standard and timing are holes. Brill v. Guardian Life Ins. Co., 142 N.J. 520 (1995) (verify: summary judgment standard)."
  edge-sj-ruling "Motion decided" -> sj-ruling {
  }
}

chance sj-ruling: "Summary judgment ruling" by court cite ?("N.J. Ct. R. 4:46-1, 4:46-2(c)")
{
  note "OUTLINE. Probabilities are holes."
  edge-sjr-granted "Granted" -> judgment-entered p ? {
  }
  edge-sjr-denied "Denied" -> pretrial p ? {
  }
}

state pretrial: "Pretrial conference and motions in limine" by court cite ?("N.J. Ct. R. 4:24-1 (verify)")
{
  note "OUTLINE. Pretrial conference and trial setting are holes."
  edge-pre-settle "Settlement" -> settled {
  }
  edge-pre-trial "Trial" -> trial {
    authority cite ?("N.J. Ct. R. 1:8-2 (verify)")
  }
}

state trial: "Trial" by court cite ?("N.J. Ct. R. 1:8-2 (verify)")
{
  note "OUTLINE. Trial by jury or the court. Jury demand timing is a hole."
  edge-trial-verdict "Verdict or decision" -> verdict {
  }
}

chance verdict: "Verdict or decision" by court cite ?("N.J. Ct. R. 4:40-1 (verify)")
{
  note "OUTLINE. Probabilities are holes."
  edge-v-favorable "For applicant" -> judgment-entered p ? {
  }
  edge-v-adverse "For opponent" -> judgment-entered p ? {
  }
}

decision judgment-entered: "Judgment entered" by office cite ?("N.J. Ct. R. 4:42-1")
{
  note "OUTLINE. Entry of judgment. Costs and fees are holes."
  edge-jud-post "Post-trial motion" -> post-trial {
    authority cite ?("N.J. Ct. R. 4:49-1, 4:50-1")
  }
  edge-jud-appeal "Notice of appeal" -> appeal-noticed {
    authority cite ?("N.J. Ct. R. 2:2-3(a) (verify)")
  }
  edge-jud-final "No further action" -> judgment-final {
    authority cite ?("N.J. Ct. R. 4:42-1")
  }
}

state post-trial: "Post-trial motion" by applicant cite ?("N.J. Ct. R. 4:49-1, 4:50-1")
{
  note "OUTLINE. Post-trial motion periods are holes. Relief from judgment: N.J. Ct. R. 4:50-1."
  edge-post-ruling "Motion decided" -> post-ruling {
  }
}

chance post-ruling: "Ruling on post-trial motion" by court cite ?("N.J. Ct. R. 4:49-1, 4:50-1")
{
  note "OUTLINE. Probabilities are holes."
  edge-pr-retrial "New trial" -> trial p ? {
  }
  edge-pr-denied "Denied" -> judgment-entered p ? {
  }
}

terminal settled: "Settled or dismissed" outcome [settle] cite ?("N.J. Ct. R. 4:10-2")
{
  note "OUTLINE. Settlement or voluntary dismissal. Payoff is a hole."
  payoff ?
}

terminal judgment-final: "Judgment final in trial court" outcome [final] cite ?("N.J. Ct. R. 4:42-1")
{
  note "OUTLINE. Final judgment. Appeal is governed by the state-appellate package."
  payoff ?
}

terminal appeal-noticed: "Notice of appeal filed" outcome [appeal] cite ?("N.J. Ct. R. 2:2-3(a) (verify)")
{
  note "OUTLINE. Appeal to the state appellate court; see the state-appellate package."
  payoff ?
}

