module frcp.pleading-to-trial

import frcp.judgment-appeal.{ notice-of-appeal-window }

import frcp.periods.{
  amended-response-period,
  amendment-as-of-course-period,
  answer-period,
  denial-answer-period,
  initial-disclosure-period,
  jury-demand-period,
  remand-motion-period,
  removal-period,
  removed-answer-period,
  service-period,
  waiver-answer-period,
}

import frcp.post-trial-motions.{ final-judgment-entered }

import frcp.{
  amendment-joinder-group,
  discovery-group,
  pleading-group,
  pretrial-motions-group,
  trial-group,
}

decision service-window: "Rule 4(m) Service Window" by applicant cite "FRCP 4(m)"
{
  group pleading-group
  note "Plaintiff has 90 days after filing to serve the summons and complaint. If service is not made within that window, the court -- on motion or on its own after notice -- must dismiss the action without prejudice against that defendant OR order that service be made within a specified time. If plaintiff shows good cause for the failure, the court MUST extend the time for an appropriate period; the 90 days is extendable on that showing but is not self-extending."
  edge-service-window-service-completed "Serve defendant via formal process" -> service-completed {
    authority cite "FRCP 4(e); 4(h); 4(f)"
    effort 3.hours
    cost 150.usd
    within service-period {
      extendable true
      extension_authority "FRCP 4(m) good-cause showing"
      note "90 days after filing. The court must extend for an appropriate period on a good-cause showing; absent good cause the court has discretion to extend or dismiss without prejudice."
    }
    duration { min 13.5.days, mode 45.days, max 90.days }
    valence good
  }
  edge-service-window-waiver-requested "Request waiver of service instead of formal process" -> waiver-requested {
    authority cite "FRCP 4(d)(1)"
    effort 2.hours
    cost 20.usd
  }
  edge-service-window-service-window-blown "Fail to serve within 90 days -- no good cause shown" -> service-window-blown {
    authority cite "FRCP 4(m)"
    effort 0.hours
    valence bad
  }
}

decision waiver-requested: "Waiver of Service Requested" by applicant cite "FRCP 4(d)(1)"
{
  group pleading-group
  note "Plaintiff may notify a defendant subject to service under Rule 4(e), (f), or (h) of the action and request a waiver, giving the defendant a reasonable time to return it -- at least 30 days after the request was sent, or at least 60 days if sent outside any U.S. judicial district. A defendant located in the U.S. who fails without good cause to waive must be charged the later costs of formal service and the fees of any motion required to collect them (Rule 4(d)(2)). Waiving service does NOT waive any defense or objection to personal jurisdiction or venue (Rule 4(d)(5))."
  edge-waiver-requested-waiver-response-window "Defendant returns executed waiver" -> waiver-response-window {
    authority cite "FRCP 4(d)(3)"
    effort 1.hours
    within waiver-answer-period {
      extendable true
      extension_authority "FRCP 6(b)(1): for good cause before the period expires, or on motion after it for excusable neglect"
      note "60 days after the waiver request was sent (90 days if sent to a defendant outside any U.S. judicial district) -- longer than the bare 21-day Rule 12(a)(1)(A)(i) clock, the incentive for waiving."
    }
    duration { min 9.days, mode 30.days, max 60.days }
  }
  edge-waiver-requested-service-completed "Defendant refuses waiver without good cause -- formal service completed, costs shift under Rule 4(d)(2)" -> service-completed {
    authority cite "FRCP 4(d)(2)"
    effort 3.hours
    cost 150.usd
  }
}

decision service-completed: "Service of Process Completed" by applicant cite "FRCP 4(c); 4(e); 4(h)"
{
  group pleading-group
  note "Formal service accomplished under Rule 4(e) (individuals), 4(h) (corporations/associations), or 4(f) (foreign defendants). Service triggers both the defendant's responsive-pleading clock and, if the case is removable, the defendant's independent 30-day removal clock under 28 U.S.C. 1446(b)(1) -- these two clocks run in parallel, not in sequence."
  edge-service-completed-removal-window "Defendant considers removal to federal court" -> removal-window {
    authority cite "28 U.S.C. 1441"
    effort 2.hours
  }
  edge-service-completed-rule12-response-window "No removal -- Rule 12 response clock runs in the original forum" -> rule12-response-window {
    authority cite "FRCP 12(a)(1)(A)(i)"
    effort 0.hours
    within answer-period {
      extendable true
      extension_authority "FRCP 6(b) stipulation or court order"
      note "21 days after service of the summons and complaint."
    }
    duration { min 3.1.days, mode 10.5.days, max 21.days }
    note "Hours: 0, a default/no-action transition with no billable work of its own."
  }
  edge-service-completed-voluntary-dismissal "Plaintiff dismisses by notice before an answer or SJ motion is served" -> voluntary-dismissal {
    authority cite "FRCP 41(a)(1)(A)(i)"
    effort 1.hours
  }
}

terminal service-window-blown: "DISMISSED WITHOUT PREJUDICE -- No Timely Service" outcome [loss, procedural-default, waiver-trap] cite "FRCP 4(m)"
{
  group pleading-group
  note "PERMADEATH for this action. No service within 90 days and no good-cause showing: the court must dismiss without prejudice as to the unserved defendant (or order service by a date certain). Dismissal without prejudice preserves the underlying claim if the statute of limitations has not since expired -- but for a claim near its limitations period, an unexcused blown Rule 4(m) window can be functionally fatal even though the dismissal itself is nominally 'without prejudice.' PLACEHOLDER PAYOFF: $0, override per matter."
  valence bad
  payoff 0.usd
}

/// Removal pays the district court's $405 civil filing fee, in force from
/// December 1, 2023 (usdc-fee-schedule); the pack records no earlier amount.
decision removal-window: "Removal Window (Defendant's Election)" by applicant effective [2023-12-01, ..) cite "28 U.S.C. 1441; 1446(b)(1)"
{
  group pleading-group
  note "A defendant sued in state court on a removable claim (federal question, or diversity absent an in-state defendant under the forum-defendant rule, 1441(b)(2)) has 30 days from formal service to remove -- not from informal receipt of a courtesy copy. Murphy Bros., Inc. v. Michetti Pipe Stringing, Inc., 526 U.S. 344 (1999): the clock runs from service, not notice. Where there are multiple defendants, all who have been served must join in or consent to removal (the 'rule of unanimity,' 1446(b)(2)(A))."
  edge-removal-window-removed-to-federal "File notice of removal within 30 days of formal service" -> removed-to-federal {
    authority cite "28 U.S.C. 1446(a); 1446(b)(1)"
    effort 6.hours
    cost 405.usd
    within removal-period {
      extendable false
      note "30 days from formal service, running from service under Murphy Bros., Inc. v. Michetti Pipe Stringing, Inc., 526 U.S. 344 (1999), not from informal receipt. Not extendable by stipulation or court order."
    }
    duration { min 4.5.days, mode 15.days, max 30.days }
    court_listener_url "https://www.courtlistener.com/opinion/118279/murphy-brothers-inc-v-michetti-pipe-stringing-inc/"
    note "Filing fee $405.00, same civil filing fee as an original complaint ($350.00 base under 28 U.S.C. § 1914(a) plus $55.00 administrative fee, District Court Miscellaneous Fee Schedule item 14, effective 12/1/2023) -- removal is treated as instituting the action in the new forum."
  }
  edge-removal-window-rule12-response-window "Decline removal -- remain in the original forum" -> rule12-response-window {
    authority cite "28 U.S.C. 1446(b)"
    effort 0.hours
    within answer-period {
      extendable true
      extension_authority "FRCP 6(b) stipulation or court order"
      note "The removal option itself is unextendable and lapses at 30 days; the underlying Rule 12(a)(1)(A)(i) response clock is unaffected by declining to remove."
    }
    duration { min 3.1.days, mode 10.5.days, max 21.days }
    note "Hours: 0, a default/no-action transition with no billable work of its own."
  }
}

decision removed-to-federal: "Case Removed to Federal Court" by applicant cite "28 U.S.C. 1441; 1446(a)"
{
  group pleading-group
  note "Notice of removal filed in the federal district embracing the state action, with a copy promptly filed in state court (which then loses jurisdiction to proceed further, 1446(d)). Under FRCP 81(c)(2), a defendant who has not yet answered when the case is removed has the longer of: the time remaining under state practice, 21 days after receipt of the initial pleading, or 7 days after the removal notice is filed."
  edge-removed-to-federal-remand-ruling "Plaintiff moves to remand" -> remand-ruling {
    authority cite "28 U.S.C. 1447(c)"
    effort 10.hours
    cost 3_000.usd
    within remand-motion-period {
      extendable false
      note "A motion to remand for a procedural defect must be made within 30 days after the notice of removal is filed; a motion (or the court's own initiative) based on lack of subject-matter jurisdiction has no outer time limit and may be raised at any time before final judgment."
    }
    duration { min 4.5.days, mode 15.days, max 30.days }
  }
  edge-removed-to-federal-removed-response-window "No remand motion -- case proceeds in federal court" -> removed-response-window {
    authority cite "FRCP 81(c)(2)"
    effort 0.hours
    within removed-answer-period {
      extendable true
      extension_authority "FRCP 6(b) stipulation or court order"
      note "Rule 81(c)(2) gives the longer of: time remaining under state practice, 21 days after receipt of the initial pleading, or 7 days after the removal notice is filed."
    }
    duration { min 3.1.days, mode 10.5.days, max 21.days }
    note "Hours: 0, a default/no-action transition with no billable work of its own."
  }
}

chance remand-ruling: "Court Rules on Motion to Remand" by examiner discretion cite "28 U.S.C. 1447(c)"
{
  group pleading-group
  note "A motion to remand for a procedural defect in removal must be made within 30 days after the notice of removal; a motion to remand for lack of subject-matter jurisdiction may be made at any time before final judgment, and the court must remand sua sponte if it discovers the jurisdictional defect itself. Remand probability authored at 0.3 grant / 0.7 deny -- APPROXIMATE, not a live empirical figure; removal is upheld more often than not when the removing defendant has correctly diagnosed diversity or federal-question jurisdiction, but improvidently removed cases (missing an in-state defendant's forum-defendant bar, incomplete diversity) are a recurring plaintiff win."
  edge-remand-ruling-remand-ordered "Court grants remand -- lack of subject-matter jurisdiction or removal defect" -> remand-ordered p 0.3 {
    authority cite "28 U.S.C. 1447(c)"
  }
  edge-remand-ruling-removed-response-window "Court denies remand -- federal forum retained" -> removed-response-window p 0.7 {
    authority cite "28 U.S.C. 1447(c)"
    within removed-answer-period {
      extendable true
      extension_authority "FRCP 6(b) stipulation or court order"
    }
    duration { min 3.1.days, mode 10.5.days, max 21.days }
  }
}

terminal remand-ordered: "Remanded to State Court" outcome [neutral] cite "28 U.S.C. 1447(c); 1447(d)"
{
  group pleading-group
  note "Case returns to state court; the federal action ends. A remand order based on a 1447(c) defect (lack of subject-matter jurisdiction or timely-raised procedural defect) is generally NOT reviewable on appeal or otherwise, 1447(d) -- one of the few genuinely unreviewable orders in federal practice. Exits the FRCP track modeled by this chart. PLACEHOLDER PAYOFF: $500,000 (stake midpoint), override per matter. The case continues in state court, outside this chart -- genuinely unresolved from here, not a plaintiff win or loss."
  valence caution
  payoff 500_000.usd
}

decision rule12-response-window: "Rule 12 Response Window" by applicant cite "FRCP 12(a)(1)(A)(i)"
{
  group pleading-group
  note "Defendant must serve an answer within 21 days after being served with the summons and complaint (Rule 12(a)(1)(A)(i)), the clock of the tracks that reach this node: formal service with no removal, or a defendant who declines to remove. A waiver of service, a removal and an amended pleading each run on their own clock and have their own response window (`waiver-response-window`, `removed-response-window`, `amended-response-window`); a denied Rule 12 motion reaches `answer-filed` directly on Rule 12(a)(4)(A)'s 14 days. Filing ANY Rule 12(b) motion before answering extends the responsive-pleading deadline to 14 days after the court rules."
  edge-rule12-response-window-answer-filed "File answer within 21 days (baseline)" -> answer-filed {
    authority cite "FRCP 12(a)(1)(A)(i)"
    effort 15.hours
    cost 4_000.usd
    within answer-period {
      extendable true
      extension_authority "FRCP 6(b) stipulation or court order"
      note "Baseline Rule 12(a)(1)(A)(i) clock -- see this node's own note for how the actual applicable length varies by entry path (waiver, removal, or a denied Rule 12 motion)."
    }
    duration { min 3.1.days, mode 10.5.days, max 21.days }
    valence good
  }
  12b-motion-filed "File pre-answer Rule 12(b) motion instead of answering" -> motion-to-dismiss-filed {
    authority cite "FRCP 12(b)"
    effort 30.hours
    cost 8_000.usd
    within answer-period {
      extendable true
      extension_authority "FRCP 6(b) stipulation or court order"
      note "Filing the motion extends the responsive-pleading deadline to 14 days after the court denies or postpones disposition (Rule 12(a)(4)(A))."
    }
    duration { min 3.1.days, mode 10.5.days, max 21.days }
    note "This pack doesn't separately model which Rule 12(b) defenses a motion raises, so sets waived-12h-defenses on every 12(b) motion as the conservative default: FRCP 12(h)(1)(A) waives lack of personal jurisdiction, improper venue, insufficient process, and insufficient service of process by omitting any of them from a motion made under the circumstances described in Rule 12(g)(2) (a motion raising some, but not all, available Rule 12 defenses). A pack that modeled motion content in more detail could instead set this flag only on the omitting variant."
    sets [waived-12h-defenses]
  }
  edge-rule12-response-window-default-entered "Fail to answer or move -- default exposure" -> default-entered {
    authority cite "FRCP 55(a)"
    effort 0.hours
    valence bad
  }
}

decision waiver-response-window: "Rule 12 Response Window (Service Waived)" by applicant cite "FRCP 12(a)(1)(A)(ii)"
{
  group pleading-group
  note "A defendant who timely returned a Rule 4(d) waiver answers within 60 days after the request was sent (90 if it was sent outside every judicial district of the United States, which the pack does not branch on), Rule 12(a)(1)(A)(ii) -- longer than the 21-day clock after formal service, the incentive for waiving. A pre-answer Rule 12(b) motion runs on the same clock."
  edge-waiver-response-window-answer-filed "File answer within 60 days of the waiver request" -> answer-filed {
    authority cite "FRCP 12(a)(1)(A)(ii)"
    effort 15.hours
    cost 4_000.usd
    within waiver-answer-period {
      extendable true
      extension_authority "FRCP 6(b)(1): for good cause before the period expires, or on motion after it for excusable neglect"
      note "60 days after the waiver request was sent (Rule 12(a)(1)(A)(ii))."
    }
    duration { min 9.days, mode 30.days, max 60.days }
    valence good
  }
  waiver-12b-motion-filed "File pre-answer Rule 12(b) motion instead of answering" -> motion-to-dismiss-filed {
    authority cite "FRCP 12(b)"
    effort 30.hours
    cost 8_000.usd
    within waiver-answer-period {
      extendable true
      extension_authority "FRCP 6(b)(1): for good cause before the period expires, or on motion after it for excusable neglect"
      note "Filing the motion extends the responsive-pleading deadline to 14 days after the court denies or postpones disposition (Rule 12(a)(4)(A))."
    }
    duration { min 9.days, mode 30.days, max 60.days }
    note "This pack doesn't separately model which Rule 12(b) defenses a motion raises, so sets waived-12h-defenses on every 12(b) motion as the conservative default: FRCP 12(h)(1)(A) waives lack of personal jurisdiction, improper venue, insufficient process, and insufficient service of process by omitting any of them from a motion made under the circumstances described in Rule 12(g)(2) (a motion raising some, but not all, available Rule 12 defenses). A pack that modeled motion content in more detail could instead set this flag only on the omitting variant."
    sets [waived-12h-defenses]
  }
  edge-waiver-response-window-default-entered "Fail to answer or move -- default exposure" -> default-entered {
    authority cite "FRCP 55(a)"
    effort 0.hours
    valence bad
  }
}

decision removed-response-window: "Rule 12 Response Window (After Removal)" by applicant cite "FRCP 81(c)(2)(A)"
{
  group pleading-group
  note "After removal, a defendant who has not answered answers within the longest of: 21 days after receiving the initial pleading, 21 days after service of the summons on an initial pleading on file, or 7 days after the notice of removal is filed (Rule 81(c)(2)); the pack models the first. A pre-answer Rule 12(b) motion runs on the same clock."
