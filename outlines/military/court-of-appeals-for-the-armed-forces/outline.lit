// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored text.
// Sources: 10 U.S.C. §§ 867, 867a, 869 (LII headings fetched 2026-10-26). The CAAF
// Rules of Practice and Procedure are not fetched, so their rule cites are holes.
// Key decisions are unverified.
module outline-caaf

start intake

decision intake: "Petition for review filed or certified case received" by office cite ?("10 U.S.C. § 867(a)")
{
  note "OUTLINE. CAAF's jurisdiction is under 10 U.S.C. § 867(a). Two entry routes: a petition for grant of review from a Court of Criminal Appeals decision, and a case certified by the Judge Advocate General under Article 67(a). Confirm the entry route text in § 867(a)."
  edge-intake-petition "Petition for grant of review" -> grant-decision {
    authority cite ?("10 U.S.C. § 867(a)")
  }
  edge-intake-certified "Case certified by the Judge Advocate General" -> briefing {
    authority cite ?("10 U.S.C. § 869")
  }
}

decision grant-decision: "Petition granted or denied" by court cite ?("10 U.S.C. § 867(a)")
{
  note "OUTLINE. The Court grants or denies review of specified issues. The petition period and filing requirements are holes. Key decision (verify): Ortiz v. United States, 138 S. Ct. 2165 (2018) (CAAF's review of Court of Criminal Appeals decisions; verify holding before citing)."
  edge-grant-decision-granted "Granted" -> briefing {
    authority cite ?("10 U.S.C. § 867(a)")
  }
  edge-grant-decision-denied "Denied" -> denied-final {
    authority cite ?("10 U.S.C. § 867(a)")
  }
}

state briefing: "Briefs on granted issues" by applicant cite ?("10 U.S.C. § 867(a)")
{
  note "OUTLINE. Briefs on the granted issues. Page limits, periods and the amicus rules are holes."
  edge-briefing-argument "Briefing complete" -> argument {
    authority cite ?("10 U.S.C. § 867(a)")
  }
}

state argument: "Oral argument" by court cite ?("10 U.S.C. § 867(a)")
{
  note "OUTLINE. Oral argument is scheduled by the Court. The argument format is a hole."
  edge-argument-opinion "Argument held" -> decision-on-merits {
    authority cite ?("10 U.S.C. § 867(a)")
  }
}

decision decision-on-merits: "Decision on the merits" by court cite ?("10 U.S.C. § 867(a)")
{
  note "OUTLINE. The Court affirms, reverses, or sets aside and returns the case. Standards of review are holes."
  edge-decision-affirmed "Affirmed" -> affirmed {
    authority cite ?("10 U.S.C. § 867(a)")
  }
  edge-decision-reversed "Reversed" -> reversed {
    authority cite ?("10 U.S.C. § 867(a)")
  }
  edge-decision-returned "Set aside and returned" -> returned {
    authority cite ?("10 U.S.C. § 867(a)")
  }
  edge-decision-cert "Supreme Court review sought" -> cert-petition {
    authority cite ?("10 U.S.C. § 867a")
  }
}

state cert-petition: "Petition for certiorari to the Supreme Court" by applicant cite ?("10 U.S.C. § 867a")
{
  note "OUTLINE. Review by the Supreme Court under Article 67a. Key decision (verify): Loving v. United States, 517 U.S. 748 (1996) (Supreme Court review of CAAF and CCA decisions; verify holding)."
  edge-cert-petition-decided "Supreme Court acts" -> scotus-decided {
    authority cite ?("10 U.S.C. § 867a")
  }
}

terminal denied-final: "Review denied; lower decision stands" outcome [loss] cite ?("10 U.S.C. § 867(a)")
{
  note "OUTLINE. The Court denies review; the Court of Criminal Appeals decision is final as to CAAF."
  payoff ?
}

terminal affirmed: "CAAF affirms" outcome [loss] cite ?("10 U.S.C. § 867(a)")
{
  note "OUTLINE. Affirmance."
  payoff ?
}

terminal reversed: "CAAF reverses" outcome [win] cite ?("10 U.S.C. § 867(a)")
{
  note "OUTLINE. Reversal. Scope of relief is a hole."
  payoff ?
}

terminal returned: "Set aside and returned for further proceedings" outcome [remand] cite ?("10 U.S.C. § 867(a)")
{
  note "OUTLINE. The case returns to the Court of Criminal Appeals or a lower level. Further route is a hole."
  payoff ?
}

terminal scotus-decided: "Supreme Court decision" outcome [decided] cite ?("10 U.S.C. § 867a")
{
  note "OUTLINE. The Supreme Court outcome. See the Supreme Court cert-practice package."
  payoff ?
}
