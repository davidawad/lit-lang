// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
// Outcome tags are labels only; payoff is a hole. Rule numbers are from memory: verify each.
module outline-fl-state-civil

start complaint-filed

state complaint-filed: "Complaint Filed" by applicant cite ?("Fla. R. Civ. P. 1.050")
{
  note "OUTLINE. Commencement of a civil action in Florida circuit court. Rule numbers from memory; verify against official text."
  edge-complaint-filed-service "Summons issued and served" -> service-check {
    authority cite ?("Fla. R. Civ. P. 1.070")
  }
}

decision service-check: "Service Within Required Period" by office cite ?("Fla. R. Civ. P. 1.070")
{
  note "OUTLINE. Service period is a hole. Rule numbers from memory; verify against official text."
  edge-service-check-served "Served" -> answer-due {
    authority cite ?("Fla. R. Civ. P. 1.140(a)")
  }
  edge-service-check-unserved "Not served in time" -> dismissed-unserved {
    authority cite ?("Fla. R. Civ. P. 1.070")
  }
}

decision answer-due: "Answer, Motion or Default" by office cite ?("Fla. R. Civ. P. 1.140(a)")
{
  note "OUTLINE. Response period is a hole. Rule numbers from memory; verify against official text."
  edge-answer-due-default "No response" -> default-entered {
    authority cite ?("Fla. R. Civ. P. 1.500")
  }
  edge-answer-due-motion "Pleading motion filed" -> pleading-motion {
    authority cite ?("Fla. R. Civ. P. 1.140(b)")
  }
  edge-answer-due-answer "Answer filed" -> case-management {
    authority cite ?("Fla. R. Civ. P. 1.200")
  }
}

decision pleading-motion: "Pleading Motion Decided" by court cite ?("Fla. R. Civ. P. 1.140(b)")
{
  note "OUTLINE. Leading decisions (verify): none named in this pass (verify). Rule numbers from memory; verify against official text."
  edge-pleading-motion-dismissed "Granted with prejudice" -> dismissed-pleading {
    authority cite ?("Fla. R. Civ. P. 1.140(b)")
  }
  edge-pleading-motion-leave "Granted with leave to amend" -> case-management {
    authority cite ?("Fla. R. Civ. P. 1.190")
  }
  edge-pleading-motion-denied "Denied" -> case-management {
    authority cite ?("Fla. R. Civ. P. 1.140(b)")
  }
}

terminal default-entered: "Default Entered" outcome [loss] cite ?("Fla. R. Civ. P. 1.500")
{
  note "OUTLINE. Default judgment and setting aside default are not modeled. Rule numbers from memory; verify against official text."
  payoff ?
}

terminal dismissed-unserved: "Dismissed for Failure to Serve" outcome [loss, dismissal] cite ?("Fla. R. Civ. P. 1.070")
{
  note "OUTLINE. Dismissal for untimely service (verify)."
  payoff ?
}

terminal dismissed-pleading: "Dismissed on Pleading Motion" outcome [win, dismissal] cite ?("Fla. R. Civ. P. 1.140(b)")
{
  note "OUTLINE. Dismissal on the pleadings (verify standard)."
  payoff ?
}

state case-management: "Case Management and Scheduling" by court cite ?("Fla. R. Civ. P. 1.200")
{
  note "OUTLINE. Scheduling and case-management order is a hole. Rule numbers from memory; verify against official text."
  edge-case-management-discovery "Scheduling order entered" -> discovery {
    authority cite ?("Fla. R. Civ. P. 1.280")
  }
}

state discovery: "Discovery" by applicant cite ?("Fla. R. Civ. P. 1.280")
{
  note "OUTLINE. Discovery scope and sanctions for failure to make discovery (verify). Rule numbers from memory; verify against official text."
  edge-discovery-sj "Discovery closed" -> sj-motion {
    authority cite ?("Fla. R. Civ. P. 1.510")
  }
  edge-discovery-settle "Settled during discovery" -> settled {
    authority cite ?("Fla. R. Civ. P. 1.420(a)")
  }
}

decision sj-motion: "Summary Judgment Motion Decided" by court cite ?("Fla. R. Civ. P. 1.510")
{
  note "OUTLINE. Leading decisions (verify): In re Amendments to Florida Rule of Civil Procedure 1.510, 317 So. 3d 72 (Fla. 2021) (verify). Rule numbers from memory; verify against official text."
  edge-sj-motion-granted "Granted" -> judgment-for-movant {
    authority cite ?("Fla. R. Civ. P. 1.510")
  }
  edge-sj-motion-denied "Denied or partly denied" -> trial {
    authority cite ?("Fla. R. Civ. P. 1.200")
  }
}

terminal judgment-for-movant: "Judgment for Movant on Summary Judgment" outcome [win, judgment] cite ?("Fla. R. Civ. P. 1.510")
{
  note "OUTLINE. Partial summary judgment is not modeled."
  payoff ?
}

state trial: "Trial or Bench Decision" by court cite ?("Fla. R. Civ. P. 1.430")
{
  note "OUTLINE. Jury demand and trial setting are holes. Rule numbers from memory; verify against official text."
  edge-trial-post "Verdict or decision" -> post-trial {
    authority cite ?("Fla. R. Civ. P. 1.480")
  }
}

decision post-trial: "Post-Trial Motions Decided" by court cite ?("Fla. R. Civ. P. 1.480")
{
  note "OUTLINE. Post-trial motions: judgment as a matter of law, new trial and relief from judgment. Time limits are holes. Rule numbers from memory; verify against official text."
  edge-post-trial-judgment "Motions resolved or none filed" -> judgment-entered {
    authority cite ?("Fla. R. Civ. P. 1.530")
  }
  edge-post-trial-jmol "Judgment as a matter of law granted" -> judgment-for-movant {
    authority cite ?("Fla. R. Civ. P. 1.480")
  }
}

state judgment-entered: "Judgment Entered" by office cite ?("Fla. R. Civ. P. 1.530")
{
  note "OUTLINE. Entry of judgment rule governs when the appeal clock starts. Rule numbers from memory; verify against official text."
  edge-judgment-entered-appeal "Next step" -> appeal-decision {
    authority cite ?("Fla. R. App. P. 9.110(b)")
  }
}

decision appeal-decision: "Notice of Appeal Within Time?" by applicant cite ?("Fla. R. App. P. 9.110(b)")
{
  note "OUTLINE. Notice of appeal period and form are holes. Rule numbers from memory; verify against official text."
  edge-appeal-decision-taken "Notice filed" -> appeal-taken {
    authority cite ?("Fla. R. App. P. 9.110(b)")
  }
  edge-appeal-decision-none "No notice filed" -> final-no-appeal {
    authority cite ?("Fla. R. App. P. 9.110(b)")
  }
}

terminal appeal-taken: "Appeal to Appellate Court" outcome [appeal] cite ?("Fla. R. App. P. 9.110(b)")
{
  note "OUTLINE. Continue in the state-appellate package."
  payoff ?
}

terminal final-no-appeal: "Final: No Appeal" outcome [final] cite ?("Fla. R. App. P. 9.110(b)")
{
  note "OUTLINE. Final judgment with no notice filed in time."
  payoff ?
}

terminal settled: "Settled or Stipulated Dismissal" outcome [settlement] cite ?("Fla. R. Civ. P. 1.420(a)")
{
  note "OUTLINE. Settlement or voluntary dismissal; terms are not modeled."
  payoff ?
}
