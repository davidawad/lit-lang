module bankr-nh-local-rules.local-rules

import core.states.new-hampshire.{ frbp9006-new-hampshire }
import frbp.events.{ PetitionFiled }

// The Bankr. D.N.H. court's own periods, counted under FRBP 9006(a). The
// FRBP periods (schedules, claims, discharge, dischargeability, the
// adversary answer and summons, appeals) are lit/frbp's and are not
// declared again; LBR 8003-1 and 8005-1 send the notice of appeal and the
// election to FRBP 8002 and 28 U.S.C. § 158(c)(1), and Interim Bankruptcy
// Rules 1007-I and 5012 are the national interim rules.
//
// Stated in the rules but not declared: the later installments of a filing
// fee, every 30 days in no more than three payments (LBR 1006-1); the court's
// retention of undistributed chapter 13 funds for the later of 14 days or a
// scheduled hearing (LBR 1017-1); a case closed no sooner than 30 days after
// the chapter 13 final report (LBR 2015-5(c)) and a reopened case closed 120
// days after the order (LBR 5010-1), court acts; the business-day and
// clock-time periods (seven business days for a chapter 13 debtor to object
// to producing an operating report, LBR 2083-3; the certificate of vote two
// business days before a chapter 11 confirmation hearing, LBR 3018-2; an
// agreed continuance docketed 24 hours before the hearing, LBR 5071-1(a)(2);
// an objection on shortened notice 24 hours before the hearing, LBR
// 9013-1(e)); the 45-day cap on an agreed continuance (LBR 5071-1(a)(2));
// the 60-day committee challenge period a cash collateral or credit order
// must afford (LBR 4001-2(d)(1)(A)); the debtor's report of a change in
// military status, which the rule says the debtor "should" make within 14
// days (LBR 9012-1(d)); and the 7 days after an affidavit of noncompliance
// before conditional relief may be granted (LBR 9071-1(a)), a court power.
// A continued hearing moves the 7-day objection deadline to the continued
// date only if the continuance is sought before the deadline expires (LBR
// 5071-1(b)); which hearing date applies is the matter's fact.
/// The debtor files a statement of a debtor's death in a chapter 11, 12 or
/// 13 case stating that the case should be dismissed (LBR 1016-1).
event DeathStatementFiled()
/// The § 341 meeting of creditors is held (LBR 2083-2).
event MeetingOfCreditorsHeld()
/// The § 341 meeting of creditors is concluded (LBR 3012-1(c), 3012-2(d)).
event MeetingOfCreditorsConcluded()
/// An attorney is admitted pro hac vice (LBR 2090-1(b)(3)).
event ProHacViceAdmitted()
/// The date set for the initial hearing on confirmation of a chapter 13
/// plan or amended plan (LBR 3015-3(a); AO 3015-4(a)).
event ConfirmationHearingScheduled()
/// The date set for the hearing on a motion to modify a confirmed chapter 13
/// plan (LBR 3015-5(b)).
event ModificationHearingScheduled()
/// The date set for the hearing on approval of a disclosure statement (LBR
/// 3017-1).
event DisclosureStatementHearingScheduled()
/// A chapter 11 plan is confirmed (LBR 3022-1).
event PlanConfirmed()
/// All payments under a subchapter V plan confirmed under 11 U.S.C.
/// § 1191(b) are completed (LBR 3022-1).
event SubchapterVPlanPaymentsCompleted()
/// The date set for the hearing on a motion to avoid a lien under 11 U.S.C.
/// § 522(f) (LBR 4003-2(c)).
event LienAvoidanceHearingScheduled()
/// The date set for the pretrial conference in an adversary proceeding (LBR
/// 7016-1(a)).
event PretrialConferenceScheduled()
/// The date set for the hearing on a motion (LBR 9013-1(d), (g)).
event HearingScheduled()
/// A hearing or trial after which the movant is directed to submit a
/// proposed order or judgment is held (LBR 9013-1(f)(3)).
event HearingHeld()
/// A proceeding in which exhibits were entered concludes (LBR 9070-1).
event ProceedingConcluded()
/// The last payment under a confirmed chapter 13 plan is made (AO
/// 3015-4(b)).
event LastPlanPaymentMade()

/// LBR 1006-1: a debtor paying the filing fee in installments pays no less
/// than one-fourth of the total fee within 14 days of filing the petition.
deadline first-installment-period: 14.days after PetitionFiled() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 1006-1"
/// LBR 1016-1: where the statement of a debtor's death says the chapter 11,
/// 12 or 13 case should be dismissed, the motion to dismiss is filed within
/// 14 days of the filing of the statement.
deadline death-dismissal-motion-period: 14.days after DeathStatementFiled() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 1016-1"
/// LBR 2016-4(b): a bankruptcy petition preparer seeking more than $150 in
/// compensation files a motion requesting a hearing within 14 days after
/// the filing of the petition.
deadline preparer-fee-motion-period: 14.days after PetitionFiled() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 2016-4(b)"
/// LBR 2083-2: a chapter 13 debtor with improved real estate provides proof
/// of value and insurance, and a business debtor proof of business
/// insurance, at least 7 days prior to the 341 Meeting.
deadline proof-of-value-period: 7.days before MeetingOfCreditorsHeld() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 2083-2"
/// LBR 2090-1(b)(3): an attorney admitted pro hac vice secures CM/ECF
/// access no later than 14 days after admission.
deadline pro-hac-vice-filing-access-period: 14.days after ProHacViceAdmitted() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 2090-1(b)"
/// LBR 3012-1(c): a motion to determine secured status and void a wholly
/// unsecured residential lien is served within 30 days of the concluded
/// 341 Meeting.
deadline residential-valuation-motion-period: 30.days after MeetingOfCreditorsConcluded() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 3012-1(c)"
/// LBR 3012-2(d): a motion to determine secured status and limit a claim
/// secured by personal or non-residential real property is served within
/// 30 days of the concluded 341 Meeting.
deadline collateral-valuation-motion-period: 30.days after MeetingOfCreditorsConcluded() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 3012-2(d)"
/// LBR 3015-3(a): an objection to confirmation of a chapter 13 plan is
/// filed no later than 14 days before the confirmation hearing.
deadline confirmation-objection-period: 14.days before ConfirmationHearingScheduled() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 3015-3(a)"
/// AO 3015-4(a): no later than 7 days prior to the initial confirmation
/// hearing on a plan, amended plan or motion to modify, the chapter 13
/// trustee files a recommendation whether it should be confirmed.
deadline trustee-recommendation-period: 7.days before ConfirmationHearingScheduled() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. AO 3015-4(a)"
/// LBR 3015-5(b): an objection to modifying a chapter 13 plan is filed no
/// later than 14 days before the hearing on the motion to modify.
deadline modification-objection-period: 14.days before ModificationHearingScheduled() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 3015-5(b)"
/// LBR 3017-1: the objection date for a disclosure statement is 7 days
/// prior to the disclosure statement hearing.
deadline disclosure-statement-objection-period: 7.days before DisclosureStatementHearingScheduled() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 3017-1"
/// LBR 3022-1: unless the plan or confirmation order designates another, the
/// plan proponent files the motion for final decree not later than 120 days
/// following plan confirmation, unless the court extends the time for
/// cause.
deadline final-decree-motion-period: 120.days after PlanConfirmed() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 3022-1"
/// LBR 3022-1: for a subchapter V plan confirmed non-consensually under 11
/// U.S.C. § 1191(b), the motion for final decree is filed not later than
/// 120 days following the completion of all plan payments.
deadline subchapter-v-final-decree-motion-period: 120.days after SubchapterVPlanPaymentsCompleted() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 3022-1"
/// LBR 4003-2(c): to be valid, service of a § 522(f) lien avoidance motion is
/// made at least 21 days prior to the hearing.
deadline lien-avoidance-service-period: 21.days before LienAvoidanceHearingScheduled() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 4003-2(c)"
/// LBR 7016-1(a): at least 7 days prior to the pretrial conference, the
/// parties meet and confer on a discovery plan and the dates for the
/// pretrial order.
deadline pretrial-confer-period: 7.days before PretrialConferenceScheduled() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 7016-1(a)"
/// LBR 9013-1(d): unless the Bankruptcy Rules or LBRs provide otherwise, a
/// motion and notice of hearing are served at least 14 days prior to the
/// hearing date.
deadline motion-service-period: 14.days before HearingScheduled() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 9013-1(d)"
/// LBR 9013-1(g)(1) and 5071-1(b): a party objecting to a motion who wants
/// it called files a written objection no later than 7 days prior to the
/// scheduled hearing date; otherwise the court may grant the motion without
/// a hearing.
deadline objection-period: 7.days before HearingScheduled() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 9013-1(g)"
/// LBR 9013-1(f)(3): a movant directed to submit a proposed order or
/// judgment after a hearing or trial submits it within 7 days following
/// the hearing or trial, or as the court directs.
deadline proposed-order-period: 7.days after HearingHeld() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 9013-1(f)"
/// LBR 9070-1: the offering party has 30 days after the conclusion of the
/// proceeding to request the return of its exhibits; the clerk then
/// disposes of them.
deadline exhibit-return-period: 30.days after ProceedingConcluded() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. LBR 9070-1"
/// AO 3015-4(b): no later than 60 days following the last payment under the
/// plan, the chapter 13 trustee certifies that all plan payments are
/// complete.
deadline plan-completion-certification-period: 60.days after LastPlanPaymentMade() counted_by frbp9006-new-hampshire cite "Bankr. D.N.H. AO 3015-4(b)"

start motion-filed

state motion-filed: "Motion filed and noticed for hearing" by applicant cite "Bankr. D.N.H. LBR 9013-1(b)"
{
  note "The movant selects a hearing date from the Website (LBR 9013-1(b)) and files with the motion a notice of hearing (LBF 7104-1), a certificate of service and, except for stay-relief and chapter 13 modification motions, a proposed order (LBR 9013-1(f)); the motion and notice are served at least 14 days before the hearing (LBR 9013-1(d)). The motions LBR 9013-1(c) lists may be considered ex parte; an emergency hearing on 48 hours' notice or less is sought by application (LBR 9013-2). The movant is the party designated to give notice (LBR 5075-1(a)). The motion's FRBP periods are lit/frbp's."
  edge-motion-filed-objection "Written objection filed" -> objection {
    authority cite "Bankr. D.N.H. LBR 9013-1(g)"
  }
  edge-motion-filed-unopposed "No timely objection; granted without a hearing" -> decided {
    authority cite "Bankr. D.N.H. LBR 9013-1(g)"
  }
}

state objection: "Objection filed; motion called at the hearing" by opponent cite "Bankr. D.N.H. LBR 9013-1(g)"
{
  note "An objection states in narrative form why the motion should be denied and is not in the form of an answer (LBR 9013-1(h)(1)); a reply may be filed at any time before the hearing (LBR 9013-1(h)(2))."
  edge-objection-ruling "Hearing held" -> ruling { authority cite "Bankr. D.N.H. LBR 9013-1(g)" }
}

decision ruling: "Motion decided" by court cite "Bankr. D.N.H. LBR 9013-1(g)"
{
  note "A movant directed to submit a proposed order does so within 7 days after the hearing (LBR 9013-1(f)(3))."
  edge-ruling-granted "Granted" -> decided { authority cite "Bankr. D.N.H. LBR 9013-1(f)" }
  edge-ruling-denied "Denied" -> decided { authority cite "Bankr. D.N.H. LBR 9013-1(g)" }
}

terminal decided: "Matter decided: the case continues under lit/frbp" outcome [procedural] cite "Bankr. D.N.H. LBR 9029-1"
{
  note "The LBRs govern practice before the court; where they conflict with the District Court's rules or the Bankruptcy Rules, the latter govern (LBR 9029-1(a))."
}

test "Deadline arithmetic: first-installment-period (14 days after)" cite "Bankr. D.N.H. LBR 1006-1"
{
  given PetitionFiled() on 2027-01-04
  expect deadline(first-installment-period) == 2027-01-19
}

test "Deadline arithmetic: death-dismissal-motion-period (14 days after)" cite "Bankr. D.N.H. LBR 1016-1"
{
  given DeathStatementFiled() on 2027-01-04
  expect deadline(death-dismissal-motion-period) == 2027-01-19
}

test "Deadline arithmetic: preparer-fee-motion-period (14 days after)" cite "Bankr. D.N.H. LBR 2016-4(b)"
{
  given PetitionFiled() on 2027-01-04
  expect deadline(preparer-fee-motion-period) == 2027-01-19
}

test "Deadline arithmetic: proof-of-value-period (7 days before)" cite "Bankr. D.N.H. LBR 2083-2"
{
  given MeetingOfCreditorsHeld() on 2027-01-04
  expect deadline(proof-of-value-period) == 2026-12-28
}

test "Deadline arithmetic: pro-hac-vice-filing-access-period (14 days after)" cite "Bankr. D.N.H. LBR 2090-1(b)"
{
  given ProHacViceAdmitted() on 2027-01-04
  expect deadline(pro-hac-vice-filing-access-period) == 2027-01-19
}

test "Deadline arithmetic: residential-valuation-motion-period (30 days after)" cite "Bankr. D.N.H. LBR 3012-1(c)"
{
  given MeetingOfCreditorsConcluded() on 2027-01-04
  expect deadline(residential-valuation-motion-period) == 2027-02-03
}

test "Deadline arithmetic: collateral-valuation-motion-period (30 days after)" cite "Bankr. D.N.H. LBR 3012-2(d)"
{
  given MeetingOfCreditorsConcluded() on 2027-01-04
  expect deadline(collateral-valuation-motion-period) == 2027-02-03
}

test "Deadline arithmetic: confirmation-objection-period (14 days before)" cite "Bankr. D.N.H. LBR 3015-3(a)"
{
  given ConfirmationHearingScheduled() on 2027-01-04
  expect deadline(confirmation-objection-period) == 2026-12-21
}

test "Deadline arithmetic: trustee-recommendation-period (7 days before)" cite "Bankr. D.N.H. AO 3015-4(a)"
{
  given ConfirmationHearingScheduled() on 2027-01-04
  expect deadline(trustee-recommendation-period) == 2026-12-28
}

test "Deadline arithmetic: modification-objection-period (14 days before)" cite "Bankr. D.N.H. LBR 3015-5(b)"
{
  given ModificationHearingScheduled() on 2027-01-04
  expect deadline(modification-objection-period) == 2026-12-21
}

test "Deadline arithmetic: disclosure-statement-objection-period (7 days before)" cite "Bankr. D.N.H. LBR 3017-1"
{
  given DisclosureStatementHearingScheduled() on 2027-01-04
  expect deadline(disclosure-statement-objection-period) == 2026-12-28
}

test "Deadline arithmetic: final-decree-motion-period (120 days after)" cite "Bankr. D.N.H. LBR 3022-1"
{
  given PlanConfirmed() on 2027-01-04
  expect deadline(final-decree-motion-period) == 2027-05-04
}

test "Deadline arithmetic: subchapter-v-final-decree-motion-period (120 days after)" cite "Bankr. D.N.H. LBR 3022-1"
{
  given SubchapterVPlanPaymentsCompleted() on 2027-01-04
  expect deadline(subchapter-v-final-decree-motion-period) == 2027-05-04
}

test "Deadline arithmetic: lien-avoidance-service-period (21 days before)" cite "Bankr. D.N.H. LBR 4003-2(c)"
{
  given LienAvoidanceHearingScheduled() on 2027-01-04
  expect deadline(lien-avoidance-service-period) == 2026-12-14
}

test "Deadline arithmetic: pretrial-confer-period (7 days before)" cite "Bankr. D.N.H. LBR 7016-1(a)"
{
  given PretrialConferenceScheduled() on 2027-01-04
  expect deadline(pretrial-confer-period) == 2026-12-28
}

test "Deadline arithmetic: motion-service-period (14 days before)" cite "Bankr. D.N.H. LBR 9013-1(d)"
{
  given HearingScheduled() on 2027-01-04
  expect deadline(motion-service-period) == 2026-12-21
}

test "Deadline arithmetic: objection-period (7 days before)" cite "Bankr. D.N.H. LBR 9013-1(g)"
{
  given HearingScheduled() on 2027-01-04
  expect deadline(objection-period) == 2026-12-28
}

test "Deadline arithmetic: proposed-order-period (7 days after)" cite "Bankr. D.N.H. LBR 9013-1(f)"
{
  given HearingHeld() on 2027-01-04
  expect deadline(proposed-order-period) == 2027-01-11
}

test "Deadline arithmetic: exhibit-return-period (30 days after)" cite "Bankr. D.N.H. LBR 9070-1"
{
  given ProceedingConcluded() on 2027-01-04
  expect deadline(exhibit-return-period) == 2027-02-03
}

test "Deadline arithmetic: plan-completion-certification-period (60 days after)" cite "Bankr. D.N.H. AO 3015-4(b)"
{
  given LastPlanPaymentMade() on 2027-01-04
  expect deadline(plan-completion-certification-period) == 2027-03-05
}
