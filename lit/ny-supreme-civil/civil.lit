module ny-supreme-court-civil.civil

import ny-state-rules.{ JudgmentEntered }

start commenced

state commenced: "Action commenced by filing" by applicant cite "CPLR 304(a)"
{
  note "An action is commenced by filing a summons and complaint or a summons with notice; where circumstances prevent immediate filing, an order requiring filing at a specific time not later than five days thereafter commences the action (CPLR 304(a)). Filing is delivery to the clerk of the court in the county where the action is brought, and is not accepted unless the fee CPLR 8018 specifies has been paid (CPLR 304(c)); CPLR 8018 is not vendored and the fee is not stated. Service is made within 120 days after commencement, or, where the statute of limitations is four months or less, not later than 15 days after it expires; otherwise the court, on motion, dismisses without prejudice as to that defendant or, on good cause or in the interest of justice, extends the time (CPLR 306-b). Periods in this package are stated, not counted: their computation (General Construction Law §§ 20, 25-a; CPLR 2103) is not vendored."
  edge-commenced-served "Defendant served" -> answer-due { authority cite "CPLR 306-b" }
  edge-commenced-unserved "Not served within 120 days" -> dismissed-unserved {
    authority cite "CPLR 306-b"
  }
}

terminal dismissed-unserved: "Dismissed without prejudice for untimely service" outcome [loss, dismissal] cite "CPLR 306-b"
{
  note "Dismissal is on motion and without prejudice as to the unserved defendant; the court may instead extend the time for service upon good cause shown or in the interest of justice (CPLR 306-b)."
}

decision answer-due: "Answer, motion or default" by office cite "CPLR 3012(a)"
{
  note "An answer is served within 20 days after service of the pleading to which it responds (CPLR 3012(a)), or within 30 days after service is complete where the summons and complaint were delivered to a state official or served under CPLR 303, 308(2)-(5), 313, 314 or 315 (CPLR 3012(c)). If the complaint was not served with the summons, the defendant may demand it within the time CPLR 320(a) allows for an appearance; the complaint is served within 20 days after the demand, and the time to appear runs until 20 days after its service (CPLR 3012(b)); CPLR 320 is not vendored. The court may extend the time to appear or plead on a showing of reasonable excuse (CPLR 3012(d)). The outline's leading decision on pleading challenges (Leon v. Martinez, 84 N.Y.2d 83 (1994)) is removed: no reporter text is vendored to check it against."
  edge-answer-due-default "No appearance or answer" -> default-entered {
    authority cite "CPLR 3215(a)"
  }
  edge-answer-due-motion "Motion to dismiss before answering" -> pleading-motion {
    authority cite "CPLR 3211(e)"
  }
  edge-answer-due-answer "Answer served" -> discovery { authority cite "CPLR 3012(a)" }
}

decision pleading-motion: "Motion to dismiss decided" by court cite "CPLR 3211(a)"
{
  note "A party may move to dismiss on the grounds CPLR 3211(a) lists, among them documentary evidence, lack of subject-matter or personal jurisdiction, another action pending, the statute of limitations and other defenses of paragraph 5, and failure to state a cause of action (CPLR 3211(a)(1)-(11)). The motion is made before service of the responsive pleading is required, and only one is permitted; the grounds of paragraphs 1 and 3-6 are waived unless raised by that motion or in the responsive pleading, and an objection of improper service raised in a pleading is waived unless the objecting party moves on it within 60 days after serving the pleading, unless the court extends the time for undue hardship (CPLR 3211(e)). Service of the notice of motion extends the time to serve the responsive pleading until 10 days after service of notice of entry of the order (CPLR 3211(f))."
  edge-pleading-motion-dismissed "Granted" -> dismissed-pleading { authority cite "CPLR 3211(a)" }
  edge-pleading-motion-denied "Denied: answer within 10 days after notice of entry" -> discovery {
    authority cite "CPLR 3211(f)"
  }
}

terminal dismissed-pleading: "Dismissed on the motion" outcome [win, dismissal] cite "CPLR 3211(a)"
{
  note "Outcome from the defending side."
}

terminal default-entered: "Default judgment" outcome [loss] cite "CPLR 3215(a)"
{
  note "When a defendant has failed to appear, plead or proceed to trial, the plaintiff may seek a default judgment; on a claim for a sum certain the application may be made to the clerk within one year after the default, and otherwise to the court (CPLR 3215(a)). If the plaintiff takes no proceedings for entry of judgment within one year after the default, the court dismisses the complaint as abandoned unless sufficient cause is shown (CPLR 3215(c)). A defendant who has appeared is entitled to at least five days' notice of the application (CPLR 3215(g)(1)). Outcome from the defending side."
}

state discovery: "Disclosure" by applicant cite "CPLR 3101(a)"
{
  note "There is full disclosure of all matter material and necessary in the prosecution or defense of an action, regardless of the burden of proof, by the persons CPLR 3101(a) lists. The note of issue (CPLR 3402) is not vendored."
  edge-discovery-sj "Summary judgment motion" -> sj-motion { authority cite "CPLR 3212(a)" }
  edge-discovery-trial "No dispositive motion" -> trial { authority cite "CPLR 4011" }
}

decision sj-motion: "Summary judgment decided" by court cite "CPLR 3212(b)"
{
  note "Any party may move for summary judgment after issue has been joined; the court may set a date after which no such motion may be made, no earlier than 30 days after the filing of the note of issue, and absent such a date the motion is made no later than 120 days after the filing of the note of issue, except with leave on good cause shown (CPLR 3212(a)). The motion is supported by affidavit, the pleadings and other available proof, and is granted if the cause of action or defense is established sufficiently to warrant judgment as a matter of law; it is denied if any party shows facts sufficient to require a trial of any issue of fact (CPLR 3212(b)). The outline's leading decision (Alvarez v. Prospect Hospital, 68 N.Y.2d 320 (1986)) is removed: no reporter text is vendored to check it against."
  edge-sj-motion-granted "Granted" -> judgment-for-movant { authority cite "CPLR 3212(b)" }
  edge-sj-motion-denied "Denied" -> trial { authority cite "CPLR 3212(b)" }
}

terminal judgment-for-movant: "Summary judgment for the movant" outcome [win, judgment] cite "CPLR 3212(b)"
{
  note "Partial summary judgment and the limitation of issues of fact for trial (CPLR 3212(e), (g)) are not modeled."
}

state trial: "Trial" by court cite "CPLR 4011"
{
  note "The court may determine the sequence in which the issues are tried and otherwise regulate the conduct of the trial (CPLR 4011). Any party may move for judgment as a matter of law after the close of the evidence presented by an opposing party on a cause of action or issue, or at any time on the basis of admissions (CPLR 4401)."
  edge-trial-post "Verdict or decision" -> post-trial { authority cite "CPLR 4404(a)" }
}

decision post-trial: "Post-trial motions decided" by court cite "CPLR 4404(a)"
{
  note "After a jury trial the court, on motion or its own initiative, may set aside the verdict and direct judgment as a matter of law, or order a new trial where the verdict is contrary to the weight of the evidence or in the interest of justice (CPLR 4404(a)); after a nonjury trial it may set aside its decision, make new findings and direct judgment or a new trial (CPLR 4404(b)). The time for the motion (CPLR 4405) is not vendored and is not stated."
  edge-post-trial-judgment "Motions resolved or none made" -> judgment-entered {
    event JudgmentEntered()
    authority cite "CPLR 5016(b)"
  }
}

state judgment-entered: "Judgment entered" by office cite "CPLR 5016(a)"
{
  note "A judgment is entered when, after it has been signed by the clerk, it is filed (CPLR 5016(a)). Judgment on a general jury verdict is entered by the clerk unless the court directs otherwise; on a special verdict the court directs entry (CPLR 5016(b)). The time to appeal runs from service of the judgment with written notice of its entry (lit/ny-appellate-division)."
  edge-judgment-entered-appeal "Next step" -> appeal-decision { authority cite "CPLR 5016(a)" }
}

decision appeal-decision: "Notice of appeal?" by applicant cite "CPLR 5016(a)"
{
  note "An appeal to the Appellate Division continues in lit/ny-appellate-division, which states the time to take it."
  edge-appeal-decision-taken "Notice of appeal filed" -> appeal-taken {
    authority cite "CPLR 5016(a)"
  }
  edge-appeal-decision-none "No appeal" -> final-no-appeal { authority cite "CPLR 5016(a)" }
}

terminal appeal-taken: "Appeal taken: continue in the Appellate Division package" outcome [appeal] cite "CPLR 5016(a)"
{
  note "Hand-off to lit/ny-appellate-division (ny-appellate-division-civil-appeals)."
}

terminal final-no-appeal: "Final: no appeal" outcome [final] cite "CPLR 5016(a)"
