  given IssueJoined() on 2026-11-02
  expect deadline(exempt-discovery-period) == 2027-02-01
}

test "exempt expert disclosure period: 28 days before the trigger" cite "D.S.C. Local Civ. Rule 26.04"
{
  given DiscoveryClosed() on 2027-02-02
  expect deadline(exempt-expert-disclosure-period) == 2027-01-05
}

test "pretrial brief period: 7 days before the trigger" cite "D.S.C. Local Civ. Rule 26.05"
{
  given JurySelected() on 2027-02-02
  expect deadline(pretrial-brief-period) == 2027-01-26
}

test "voir dire request period: 7 days before the trigger" cite "D.S.C. Local Civ. Rule 26.05(O)"
{
  given JurySelected() on 2027-02-02
  expect deadline(voir-dire-request-period) == 2027-01-26
}

test "exhibit exchange period: 7 days before the trigger" cite "D.S.C. Local Civ. Rule 26.07(A)"
{
  given PretrialBriefsDue() on 2027-02-02
  expect deadline(exhibit-exchange-period) == 2027-01-26
}

test "jury instruction period: 7 days before the trigger" cite "D.S.C. Local Civ. Rule 26.09"
{
  given TrialCommenced() on 2027-02-02
  expect deadline(jury-instruction-period) == 2027-01-26
}

