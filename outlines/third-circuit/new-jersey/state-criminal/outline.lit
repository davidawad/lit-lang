// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
// The speedy-trial, post-trial and criminal-appeal periods are holes.
module outline-nj-state-criminal

start arrested

state arrested: "Arrest or summons" by applicant cite ?("N.J. Ct. R. Part III, arrest, summons and complaint (verify rule number)") {
  note "OUTLINE. Prompt presentment before a judicial officer; the period is a hole (?). Key decisions (verify): County of Riverside v. McLaughlin, 500 U.S. 44 (1991); Gerstein v. Pugh, 420 U.S. 103 (1975)."
  edge-arrested-appearance "Initial appearance" -> initial-appearance {
    authority cite ?("N.J. Ct. R. Part III, initial appearance (verify rule number)")
  }
}

decision initial-appearance: "Bail, release or detention" by court cite ?("N.J. Ct. R. Part III, pretrial release (verify rule number)") {
  note "OUTLINE. Counsel appointed and release conditions set; the bail standard and any detention-hearing period are holes. Key decision (verify): Gideon v. Wainwright, 372 U.S. 335 (1963)."
  edge-initial-appearance-detained "Detained" -> probable-cause {
    authority cite ?("N.J. Ct. R. Part III, pretrial detention (verify rule number)")
  }
  edge-initial-appearance-released "Released on conditions" -> probable-cause {
    authority cite ?("N.J. Ct. R. Part III, pretrial release (verify rule number)")
  }
}

decision probable-cause: "Preliminary hearing or grand jury" by court cite ?("N.J. Ct. R. Part III, preliminary hearing (verify rule number)") {
  note "OUTLINE. Whether felonies proceed by indictment or information, and the period to the probable-cause determination, are holes."
  edge-probable-cause-charged "Indictment or information filed" -> charged {
    authority cite ?("N.J. Ct. R. Part III, indictment and information (verify rule number)")
  }
  edge-probable-cause-none "No probable cause; discharged" -> dismissed {
    authority cite ?("N.J. Ct. R. Part III, preliminary hearing (verify rule number)")
  }
}

state charged: "Indictment or information" by office cite ?("N.J. Ct. R. Part III, indictment and information (verify rule number)") {
  note "OUTLINE. The speedy-trial clock and its exclusions are holes (?)."
  edge-charged-arraignment "Arraignment" -> arraignment {
    authority cite ?("N.J. Ct. R. Part III, arraignment (verify rule number)")
  }
}

state arraignment: "Arraignment and plea of not guilty" by applicant cite ?("N.J. Ct. R. Part III, arraignment (verify rule number)") {
  note "OUTLINE. Discovery and disclosure duties and their periods are holes. Key decision (verify): Brady v. Maryland, 373 U.S. 83 (1963)."
  edge-arraignment-discovery "Discovery" -> discovery {
    authority cite ?("N.J. Ct. R. Part III, discovery (verify rule number)")
  }
}

state discovery: "Discovery and pretrial motions" by applicant cite ?("N.J. Ct. R. Part III, pretrial motions (verify rule number)") {
  note "OUTLINE. The pretrial-motion period and the waiver of untimely motions are holes. Key decisions (verify): Mapp v. Ohio, 367 U.S. 643 (1961); Barker v. Wingo, 407 U.S. 514 (1972)."
  edge-discovery-motions "Pretrial motion filed" -> motions-ruling {
    authority cite ?("N.J. Ct. R. Part III, pretrial motions (verify rule number)")
  }
  edge-discovery-speedy "Speedy-trial demand or motion" -> motions-ruling {
    authority cite ?("R. 3:25-4")
  }
  edge-discovery-plea "Plea negotiations" -> plea-decision {
    authority cite ?("N.J. Ct. R. Part III, pleas and plea agreements (verify rule number)")
  }
}

decision motions-ruling: "Ruling on pretrial motions" by court cite ?("N.J. Ct. R. Part III, pretrial motions (verify rule number)") {
  note "OUTLINE. Dismissal for a speedy-trial violation and its effect on refiling are holes until verified."
  edge-motions-ruling-speedy "Dismissed for a speedy-trial violation" -> dismissed {
    authority cite ?("R. 3:25-4")
  }
  edge-motions-ruling-dismissed "Charges dismissed on another ground" -> dismissed {
    authority cite ?("N.J. Ct. R. Part III, pretrial motions (verify rule number)")
  }
  edge-motions-ruling-denied "Motions denied; case proceeds" -> plea-decision {
    authority cite ?("N.J. Ct. R. Part III, pretrial motions (verify rule number)")
  }
}

decision plea-decision: "Plea or trial" by applicant cite ?("N.J. Ct. R. Part III, pleas and plea agreements (verify rule number)") {
  note "OUTLINE. The plea colloquy and withdrawal standard are holes. Key decisions (verify): Boykin v. Alabama, 395 U.S. 238 (1969); Missouri v. Frye, 566 U.S. 134 (2012)."
  edge-plea-decision-plea "Guilty plea accepted" -> sentencing {
    authority cite ?("N.J. Ct. R. Part III, pleas and plea agreements (verify rule number)")
  }
  edge-plea-decision-trial "Trial within the speedy-trial period" -> trial {
    authority cite ?("R. 3:25-4")
  }
}

decision trial: "Verdict" by court cite ?("N.J. Ct. R. Part III, trial and verdict (verify rule number)") {
  note "OUTLINE. Jury-trial right and jury size are holes. Key decisions (verify): Jackson v. Virginia, 443 U.S. 307 (1979); Ramos v. Louisiana, 590 U.S. 83 (2020)."
  edge-trial-acquittal "Not guilty" -> acquitted {
    authority cite ?("N.J. Ct. R. Part III, trial and verdict (verify rule number)")
  }
  edge-trial-guilty "Guilty; post-trial motions" -> post-trial {
    authority cite ?("N.J. Ct. R. Part III, motion for new trial or judgment of acquittal (verify rule number)")
  }
}

decision post-trial: "Post-trial motions" by court cite ?("N.J. Ct. R. Part III, motion for new trial or judgment of acquittal (verify rule number)") {
  note "OUTLINE. The post-trial motion periods, and whether a motion is needed to preserve issues for appeal, are holes (?)."
  edge-post-trial-acquittal "Judgment of acquittal" -> acquitted {
    authority cite ?("N.J. Ct. R. Part III, motion for judgment of acquittal (verify rule number)")
  }
  edge-post-trial-new-trial "New trial granted" -> trial {
    authority cite ?("N.J. Ct. R. Part III, motion for new trial (verify rule number)")
  }
  edge-post-trial-denied "Motions denied; sentencing" -> sentencing {
    authority cite ?("N.J. Ct. R. Part III, sentencing (verify rule number)")
  }
}

state sentencing: "Presentence report and sentencing" by court cite ?("N.J. Ct. R. Part III, sentencing (verify rule number)") {
  note "OUTLINE. Presentence-report disclosure and objection periods are holes. Key decision (verify): Apprendi v. New Jersey, 530 U.S. 466 (2000)."
  edge-sentencing-judgment "Sentence imposed; judgment entered" -> judgment {
    authority cite ?("N.J. Ct. R. Part III, judgment (verify rule number)")
  }
}

decision judgment: "Judgment of conviction" by applicant cite ?("N.J. Ct. R. Part III, judgment (verify rule number)") {
  note "OUTLINE. The criminal notice-of-appeal period is a hole (?); the appeal goes to the Appellate Division of the Superior Court. Key decisions (verify): Roe v. Flores-Ortega, 528 U.S. 470 (2000); Garza v. Idaho, 586 U.S. 232 (2019)."
  edge-judgment-appeal "Notice of appeal filed" -> appeal-taken { authority cite ?("R. 2:4-1") }
  edge-judgment-no-appeal "No appeal" -> conviction-final { authority cite ?("R. 2:4-1") }
}

terminal acquitted: "Acquitted" outcome [win] cite ?("N.J. Ct. R. Part III, trial and verdict (verify rule number)") {
  note "OUTLINE. Payoff is a hole."
  payoff ?
}

terminal dismissed: "Charges dismissed" outcome [win] cite ?("N.J. Ct. R. Part III, dismissal (verify rule number)") {
  note "OUTLINE. Whether the dismissal bars refiling is a hole; payoff is a hole."
  payoff ?
}

terminal appeal-taken: "Appeal taken" outcome [appeal] cite ?("R. 2:4-1") {
  note "OUTLINE. The appeal continues before the Appellate Division of the Superior Court; payoff is a hole."
  payoff ?
}

terminal conviction-final: "Conviction final" outcome [loss] cite ?("R. 3:22") {
  note "OUTLINE. Collateral review and its limitations period are holes (verify). Federal habeas: 28 U.S.C. § 2254 (verify). Payoff is a hole."
  payoff ?
}
