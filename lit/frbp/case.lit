module frbp.case

import core.frbp9006.{ frbp9006 }

import frbp.events.{
  AdversaryRule12MotionDenied,
  BankruptcyOrderEntered,
  CaseConverted,
  ExemptionEventOccurred,
  FindingsObjectionsServed,
  FirstMeetingDate,
  InvoluntarySummonsServed,
  OrderForReliefEntered,
  PetitionFiled,
  ProposedFindingsServed,
  SummonsIssued,
}

// The core FRBP case periods, Parts 1-7 and 9: what the debtor files after
// the petition, when creditors claim and object, the adversary-proceeding
// response periods, and the post-judgment and proposed-findings periods
// in the bankruptcy court. Chapter-specific periods name their chapter;
// which chapter a case is in is a matter fact. Counting: each
// period is counted under FRBP 9006(a) (`frbp9006`), the FRCP 6(a) method
// word for word, as a period of forum `frbp`.
/// FRBP 1007: in a voluntary case the schedules, statement of financial
/// affairs and the other (b)(1), (b)(4)-(6) documents are due with the
/// petition or within 14 days after it (1007(c)(1)). In an involuntary
/// case, the creditor list is due within 7 days after the order for relief
/// (1007(a)(2)) and the (b)(1) documents within 14 days (1007(c)(2)); a
/// Chapter 11 debtor's list of equity security holders is due within 14
/// days after the order for relief unless the court orders otherwise
/// (1007(a)(3)). The Rule 1007(c)(4) financial-management-course
/// certificate deadlines are not declared: the December 1, 2026
/// amendments delete them (sources/frbp/frbp-amendments-2026-12-01.txt),
/// and a period that ends with no successor needs a sunset relation the
/// package has no target for.
rule duty debtor-filings-duty effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 1007"
{
  deadline schedules-period: 14.days after PetitionFiled() counted_by frbp9006 cite "FRBP 1007(c)(1)"
  deadline involuntary-creditor-list-period: 7.days after OrderForReliefEntered() counted_by frbp9006 cite "FRBP 1007(a)(2)"
  deadline involuntary-schedules-period: 14.days after OrderForReliefEntered() counted_by frbp9006 cite "FRBP 1007(c)(2)"
  deadline equity-holders-list-period: 14.days after OrderForReliefEntered() counted_by frbp9006 cite "FRBP 1007(a)(3)"
}

/// FRBP 1011(b): a defense or objection to an involuntary petition is
/// filed and served within 21 days after the summons is served.
rule duty involuntary-answer-duty effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 1011(b)"
{
  deadline involuntary-answer-period: 21.days after InvoluntarySummonsServed() counted_by frbp9006 cite "FRBP 1011(b)"
}

/// FRBP 1017(e)(2): except as § 704(b)(2) provides otherwise, a motion to
/// dismiss for abuse under § 707(b) or (c) is due within 60 days after the
/// first date set for the § 341(a) meeting; on request made within the
/// period, the court may extend it for cause.
rule duty abuse-dismissal-duty effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 1017(e)(2)"
{
  deadline abuse-dismissal-period: 60.days after FirstMeetingDate() counted_by frbp9006 cite "FRBP 1017(e)(2)"
}

/// FRBP 3002(c): in a voluntary Chapter 7 case or a Chapter 12 or 13 case,
/// a proof of claim is timely within 70 days after the order for relief
/// or the order converting the case to Chapter 12 or 13; in an
/// involuntary Chapter 7 case, within 90 days after the order for relief;
/// a governmental unit's, within 180 days after the order for relief
/// (3002(c)(1); 11 U.S.C. § 502(b)(9)).
rule duty proof-of-claim-duty effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 3002(c)"
{
  deadline claim-period: 70.days after OrderForReliefEntered() counted_by frbp9006 cite "FRBP 3002(c)"
  deadline converted-claim-period: 70.days after CaseConverted() counted_by frbp9006 cite "FRBP 3002(c)"
  deadline involuntary-claim-period: 90.days after OrderForReliefEntered() counted_by frbp9006 cite "FRBP 3002(c)"
  deadline governmental-claim-period: 180.days after OrderForReliefEntered() counted_by frbp9006 cite "FRBP 3002(c)(1)"
}

/// FRBP 3015(b): a Chapter 13 plan is due with the petition or within 14
/// days after it, or within 14 days after conversion to Chapter 13; the
/// time is not extended except for cause and on notice as the court orders.
rule duty chapter13-plan-duty effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 3015(b)"
{
  deadline chapter13-plan-period: 14.days after PetitionFiled() counted_by frbp9006 cite "FRBP 3015(b)(1)"
  deadline converted-chapter13-plan-period: 14.days after CaseConverted() counted_by frbp9006 cite "FRBP 3015(b)(2)"
}

/// FRBP 4003(b)(1): a party in interest may object to a claimed exemption
/// within 30 days after the latest of the conclusion of the § 341 meeting,
/// an amendment to the list, or a supplemental schedule; on motion filed
/// before the time expires, the court may extend it for cause.
rule duty exemption-objection-duty effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 4003(b)(1)"
{
  deadline exemption-objection-period: 30.days after ExemptionEventOccurred() counted_by frbp9006 cite "FRBP 4003(b)(1)"
  {
    trigger latest
  }
}

/// FRBP 4004(a), 4007(c), 4008(a): each runs 60 days after the first date
/// set for the § 341(a) meeting: a Chapter 7 complaint objecting to
/// discharge (4004(a)(1)), a Chapter 13 motion objecting to discharge under
/// § 1328(f) (4004(a)(3)), a complaint to determine dischargeability under
/// § 523(c) (4007(c)), and a reaffirmation agreement (4008(a)).
rule duty discharge-duty effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 4004(a)"
{
  deadline discharge-objection-period: 60.days after FirstMeetingDate() counted_by frbp9006 cite "FRBP 4004(a)(1)"
  deadline chapter13-discharge-objection-period: 60.days after FirstMeetingDate() counted_by frbp9006 cite "FRBP 4004(a)(3)"
  deadline dischargeability-complaint-period: 60.days after FirstMeetingDate() counted_by frbp9006 cite "FRBP 4007(c)"
  deadline reaffirmation-period: 60.days after FirstMeetingDate() counted_by frbp9006 cite "FRBP 4008(a)"
}

/// FRBP 7004(e), 7012(a): in an adversary proceeding the summons and
/// complaint are served (or mailed) within 7 days after the summons is
/// issued; the answer is due within 30 days after the summons was issued
/// unless the court sets a different time (35 for the United States, its
/// officer or agency, 7012(a)(5)(A)); after the court denies a Rule 12
/// motion or postpones it, the responsive pleading is due within 14 days
/// after notice of that action (7012(a)(6)(A)).
rule duty adversary-response-duty effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 7012(a)"
{
  deadline summons-service-period: 7.days after SummonsIssued() counted_by frbp9006 cite "FRBP 7004(e)(1)"
  deadline adversary-answer-period: 30.days after SummonsIssued() counted_by frbp9006 cite "FRBP 7012(a)(1)"
  deadline adversary-us-answer-period: 35.days after SummonsIssued() counted_by frbp9006 cite "FRBP 7012(a)(5)(A)"
  deadline adversary-post-motion-answer-period: 14.days after AdversaryRule12MotionDenied() counted_by frbp9006 cite "FRBP 7012(a)(6)(A)"
}

/// The bankruptcy court's post-judgment motions, each within 14 days after
/// the judgment is entered: to amend or add findings (7052), for a new
/// trial or to alter or amend (9023(b)), a renewed motion for judgment or a
/// new-trial request in a jury case (9015(c)), and a Rule 9024 motion that
/// tolls the time to appeal (8002(b)(1)(D)).
rule duty post-judgment-duty effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9023(b)"
{
  deadline amend-findings-period: 14.days after BankruptcyOrderEntered() counted_by frbp9006 cite "FRBP 7052"
  deadline new-trial-period: 14.days after BankruptcyOrderEntered() counted_by frbp9006 cite "FRBP 9023(b)"
  deadline jury-renewed-motion-period: 14.days after BankruptcyOrderEntered() counted_by frbp9006 cite "FRBP 9015(c)"
  deadline tolling-relief-motion-period: 14.days after BankruptcyOrderEntered() counted_by frbp9006 cite "FRBP 8002(b)(1)(D)"
}

/// FRBP 9033(b): in a non-core proceeding a party may object to the
/// proposed findings and conclusions within 14 days after being served,
/// and respond to another party's objections within 14 days after being
/// served with them.
rule duty proposed-findings-duty effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9033(b)"
{
  deadline findings-objection-period: 14.days after ProposedFindingsServed() counted_by frbp9006 cite "FRBP 9033(b)(1)"
  deadline findings-response-period: 14.days after FindingsObjectionsServed() counted_by frbp9006 cite "FRBP 9033(b)(1)"
}

test "schedules period runs 14 days after petition filed" cite "FRBP 1007(c)(1)"
{
  given PetitionFiled() on 2026-03-03
  expect deadline(schedules-period) == 2026-03-17
}

test "involuntary creditor list period runs 7 days after order for relief entered" cite "FRBP 1007(a)(2)"
{
  given OrderForReliefEntered() on 2026-03-03
  expect deadline(involuntary-creditor-list-period) == 2026-03-10
}

