// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-mo-state-civil

start complaint-filed

state complaint-filed: "Action commenced" by applicant cite ?("Mo. Sup. Ct. R. 53.01")
{
  note "OUTLINE. Petition filed under Rule 53.01 (verify). Ultimate-facts pleading standard (verify)."
  edge-complaint-filed-response-due "Summons served" -> response-due {
    authority cite ?("Mo. Sup. Ct. R. 54.01, 54.13")
  }
}

state response-due: "Response due: answer or motion" cite ?("Mo. Sup. Ct. R. 55.25")
{
  note "OUTLINE. Response period is a hole. Rule 55.27(a)(6); response period is a hole."
  edge-response-due-default-entered "No timely response" -> default-entered {
    authority cite ?("Mo. Sup. Ct. R. 74.05")
  }
  edge-response-due-motion-ruling "Motion to dismiss filed" -> motion-ruling {
    authority cite ?("Mo. Sup. Ct. R. 55.27(a)(6)")
  }
  edge-response-due-sched "Answer filed" -> sched {
    authority cite ?("Mo. Sup. Ct. R. 55.25")
  }
}

decision motion-ruling: "Motion to dismiss ruling" by court cite ?("Mo. Sup. Ct. R. 55.27(a)(6)")
{
  note "OUTLINE. Nazeri v. Missouri Valley College, 860 S.W.2d 303 (Mo. banc 1993) (pleading; verify)."
  edge-motion-ruling-dismissed-with-prejudice "Dismissed with prejudice" -> dismissed-with-prejudice {
    authority cite ?("Mo. Sup. Ct. R. 67.01")
  }
  edge-motion-ruling-response-due "Dismissed with leave to amend" -> response-due {
    authority cite ?("Mo. Sup. Ct. R. 55.33")
  }
  edge-motion-ruling-sched "Denied" -> sched {
    authority cite ?("Mo. Sup. Ct. R. 55.27(a)(6)")
  }
}

state sched: "Scheduling order and initial disclosures" cite ?("Mo. Sup. Ct. R. 56.01")
{
  note "OUTLINE. Rule 56.01 scope; case management is a hole."
  edge-sched-discovery "Order entered" -> discovery {
    authority cite ?("Mo. Sup. Ct. R. 56.01")
  }
}

state discovery: "Discovery" cite ?("Mo. Sup. Ct. R. 56.01, 57.01, 58.01, 59.01")
{
  note "OUTLINE. Discovery Rules 56 to 59 (verify); limits are holes."
  edge-discovery-sj-ruling "Dispositive motion filed" -> sj-ruling {
    authority cite ?("Mo. Sup. Ct. R. 74.04")
  }
  edge-discovery-dismissed-with-prejudice "Discovery sanction dismisses claims" -> dismissed-with-prejudice {
    authority cite ?("Mo. Sup. Ct. R. 61.01")
  }
  edge-discovery-settled "Settlement or voluntary dismissal" -> settled {
    authority cite ?("Mo. Sup. Ct. R. 67.01")
  }
  edge-discovery-pretrial "No dispositive motion" -> pretrial {
    authority cite ?("Mo. Sup. Ct. R. 56.01")
  }
}

decision sj-ruling: "Summary judgment ruling" by court cite ?("Mo. Sup. Ct. R. 74.04")
{
  note "OUTLINE. ITT Commercial Finance Corp. v. Mid-America Marine Supply Corp., 854 S.W.2d 371 (Mo. banc 1993) (summary judgment; verify)."
  edge-sj-ruling-judgment-applicant "Granted for applicant" -> judgment-applicant {
    authority cite ?("Mo. Sup. Ct. R. 74.01")
  }
  edge-sj-ruling-judgment-opponent "Granted for opponent" -> judgment-opponent {
    authority cite ?("Mo. Sup. Ct. R. 74.01")
  }
  edge-sj-ruling-pretrial "Denied" -> pretrial {
    authority cite ?("Mo. Sup. Ct. R. 74.04")
  }
}

state pretrial: "Pretrial order" cite ?("Mo. Sup. Ct. R. 56.01")
{
  note "OUTLINE. Pretrial conference, order and trial setting."
  edge-pretrial-trial "Trial set" -> trial {
    authority cite ?("Mo. Sup. Ct. R. 56.01")
  }
}

state trial: "Trial (jury or bench)" cite ?("Mo. Sup. Ct. R. 69.01")
{
  note "OUTLINE. Trial and findings or verdict."
  edge-trial-judgment-applicant "Verdict or findings for applicant" -> judgment-applicant {
    authority cite ?("Mo. Sup. Ct. R. 74.01")
  }
  edge-trial-judgment-opponent "Verdict or findings for opponent" -> judgment-opponent {
    authority cite ?("Mo. Sup. Ct. R. 74.01")
  }
}

state judgment-applicant: "Judgment for applicant entered" cite ?("Mo. Sup. Ct. R. 74.01")
{
  note "OUTLINE. Entry of judgment. Court keeps control under Rule 75.01 (verify); new trial under Rule 78.07 (verify)."
  edge-judgment-applicant-post-judgment-ruling "Post-judgment motion" -> post-judgment-ruling {
    authority cite ?("Mo. Sup. Ct. R. 75.01, 78.07")
  }
  edge-judgment-applicant-appellate-review "Notice of appeal filed" -> appellate-review {
    authority cite ?("Mo. Sup. Ct. R. 81.04")
  }
  edge-judgment-applicant-final-win "No appeal within time" -> final-win {
    authority cite ?("Mo. Sup. Ct. R. 81.04(a)")
  }
}

state judgment-opponent: "Judgment for opponent entered" cite ?("Mo. Sup. Ct. R. 74.01")
{
  note "OUTLINE. Entry of judgment. Court keeps control under Rule 75.01 (verify); new trial under Rule 78.07 (verify)."
  edge-judgment-opponent-post-judgment-ruling "Post-judgment motion" -> post-judgment-ruling {
    authority cite ?("Mo. Sup. Ct. R. 75.01, 78.07")
  }
  edge-judgment-opponent-appellate-review "Notice of appeal filed" -> appellate-review {
    authority cite ?("Mo. Sup. Ct. R. 81.04")
  }
  edge-judgment-opponent-final-loss "No appeal within time" -> final-loss {
    authority cite ?("Mo. Sup. Ct. R. 81.04(a)")
  }
}

decision post-judgment-ruling: "Post-judgment motion ruling" by court cite ?("Mo. Sup. Ct. R. 75.01, 78.07")
{
  note "OUTLINE. Post-judgment motions toll the appeal clock; verify tolling rule."
  edge-post-judgment-ruling-pretrial "Granted: new trial" -> pretrial {
    authority cite ?("Mo. Sup. Ct. R. 75.01, 78.07")
  }
  edge-post-judgment-ruling-appellate-review "Denied: appeal clock runs from order" -> appellate-review {
    authority cite ?("Mo. Sup. Ct. R. 81.04(a)")
  }
}

terminal default-entered: "Default entered against opponent" outcome [win] cite ?("Mo. Sup. Ct. R. 74.05")
{
  note "OUTLINE. Default under the rule; judgment by default is a separate entry. Outcome is from the applicant's side."
  payoff ?
}

terminal dismissed-with-prejudice: "Dismissed with prejudice" outcome [loss] cite ?("Mo. Sup. Ct. R. 67.01")
{
  note "OUTLINE. Outcome from the applicant's side."
  payoff ?
}

terminal settled: "Settled or voluntarily dismissed" outcome [settlement] cite ?("Mo. Sup. Ct. R. 67.01")
{
  note "OUTLINE. Settlement terms are a hole."
  payoff ?
}

terminal final-win: "Final judgment for applicant, no appeal" outcome [win] cite ?("Mo. Sup. Ct. R. 81.04(a)")
{
  note "OUTLINE. Judgment final when the appeal period lapses."
  payoff ?
}

terminal final-loss: "Final judgment for opponent, no appeal" outcome [loss] cite ?("Mo. Sup. Ct. R. 81.04(a)")
{
  note "OUTLINE. Judgment final when the appeal period lapses."
  payoff ?
}

terminal appellate-review: "Appeal taken: continue in the appellate package" cite ?("Mo. Sup. Ct. R. 81.04")
{
  note "OUTLINE. Hand-off to the state-appellate or court-of-appeals package."
  payoff ?
}
