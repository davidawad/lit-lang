    {
      "id": "not-barred",
      "from": "time-barred",
      "to": "respond",
      "label": "Timely",
      "actor": "Court",
      "probability": 0.9
    },
    {
      "id": "answer",
      "from": "respond",
      "to": "answered",
      "label": "File an answer",
      "actor": "Defendant",
