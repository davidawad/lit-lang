}

state briefing: "Briefing: opening, response, reply" cite ?("Ark. Sup. Ct. R. 4-2(a)")
{
  note "OUTLINE. Briefing schedule is a hole. Brief content under Ark. Sup. Ct. R. 4-2 (verify); length is a hole."
  edge-briefing-argument "Briefs complete" -> argument {
    authority cite ?("Ark. Sup. Ct. R. 4-2(a)")
  }
}

state argument: "Oral argument or submission on briefs" cite ?("Ark. Sup. Ct. R. 4-6(a) (verify)")
{
  note "OUTLINE. Argument may be waived."
  edge-argument-disposition "Submitted for decision" -> disposition {
