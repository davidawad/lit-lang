module ks-court-of-appeals-civil.appeal

import ks-state-rules.{ DecisionFiled, MandateIssued, NoticeOfAppealFiled, ReviewPetitionFiled }

// Civil appeals from a Kansas district court, from the appellant's side.
// Every period below is stated in a note, not counted: time is computed as
// K.S.A. 60-206(a) and (d) describe (Kan. S. Ct. R. 1.05(g)), K.S.A. 60-206
// is not vendored, and lit/core has no Kansas counting rule. The brief page
// limits are lit/ks-rules' limit declarations. Direct appeals to the Supreme Court and
// transfers under K.S.A. 20-3016 and 20-3017 are not modeled; those
// sections are not vendored. The outline named no leading decisions.

start threshold

decision threshold: "Appealable judgment or order?" by applicant cite "K.S.A. 60-2101(a)"
{
  note "The Court of Appeals has jurisdiction to hear appeals from district courts, except cases reviewable by law in the district court and cases where a direct appeal to the Supreme Court is required by law; appeals in civil actions are subject to K.S.A. 60-2102 (K.S.A. 60-2101(a)). An appeal from a final judgment in a civil action in which a Kansas or federal statute has been held unconstitutional goes directly to the Supreme Court (K.S.A. 60-2101(b)). K.S.A. 60-2102, which lists the appealable orders, is not vendored."
  edge-threshold-no "Not appealable" -> dismissed-jurisdiction {
    authority cite "K.S.A. 60-2101(a)"
  }
  edge-threshold-yes "Appealable" -> notice { authority cite "K.S.A. 60-2101(a)" }
}

decision notice: "Notice of appeal within time?" by applicant cite "K.S.A. 60-2103(a)"
{
  note "The time to appeal is 30 days from the entry of judgment as provided by K.S.A. 60-258; on a showing of excusable neglect based on a party's failure to learn of the entry, the district court may extend it by not more than 30 days from the expiration of the original time. A timely motion under K.S.A. 60-250(b), 60-252(b) or 60-259 terminates the running of the time, which runs in full from the order on the motion (K.S.A. 60-2103(a)); a party challenging the order on the last such motion, or on a motion under K.S.A. 60-260 filed within 28 days after judgment, files its notice no later than 30 days after that order (Kan. S. Ct. R. 2.03(b)). The notice is filed with the clerk of the district court, specifies the parties taking the appeal, designates the judgment appealed from and names the appellate court, and is served on all other parties (K.S.A. 60-2103(a), (b)); it is under the district court caption in substantial compliance with the judicial council form (Kan. S. Ct. R. 2.02). A notice filed after the judge announces a judgment but before its entry is effective if it identifies the judgment with sufficient certainty (Kan. S. Ct. R. 2.03(a)). An appellee files notice of cross-appeal within 21 days after the notice of appeal has been served on it and filed (K.S.A. 60-2103(h))."
  edge-notice-late "Untimely notice" -> dismissed-untimely { authority cite "K.S.A. 60-2103(a)" }
  edge-notice-timely "Timely notice" -> docketing { event NoticeOfAppealFiled() authority cite "Kan. S. Ct. R. 2.04(a)" }
}

decision docketing: "Appeal docketed and transcript ordered" by applicant cite "Kan. S. Ct. R. 2.04(a)"
{
  note "No later than 60 days after the notice of appeal is filed, the appellant files with the clerk of the appellate courts the docketing statement under Rule 2.041, certified copies of the notice of appeal, the judgment and any posttrial motion and ruling, any K.S.A. 60-254(b) certification, and the transcript request or a statement that none will be requested; a cross-appellant does the same within 60 days after its notice of cross-appeal (Kan. S. Ct. R. 2.04(a), 2.041(a)). Unless excused, the appellant pays at docketing a nonrefundable docket fee of $145 plus any applicable surcharge; the state, its agencies, and Kansas cities and counties are exempt (Kan. S. Ct. R. 2.04(d)). An appellant who needs a hearing transcript requests it no later than 21 days after filing the notice of appeal; the appellee may request additional transcript within 14 days after service of that request (Kan. S. Ct. R. 3.03(a), (c)). The reporter completes the transcript within 40 days after service of the request unless extended under Rule 5.02; a reporter who serves an estimate and demand within 14 days after the request need not begin until paid, and failure to pay within 14 days after the demand is ground for dismissal (Kan. S. Ct. R. 3.03(e), (f)). The district court clerk compiles the record within 14 days after notice of docketing (Kan. S. Ct. R. 3.02(a))."
  edge-docketing-docketed "Docketed within 60 days" -> briefing {
    authority cite "Kan. S. Ct. R. 6.01(b)"
  }
  edge-docketing-abandoned "Not docketed: appeal presumed abandoned" -> dismissed-abandoned {
    authority cite "Kan. S. Ct. R. 5.051(a)"
  }
}

state briefing: "Briefs served and filed" by applicant cite "Kan. S. Ct. R. 6.01(b)"
{
  note "An appellant files its brief no later than 40 days after docketing if no transcript was ordered or all ordered transcripts were filed before docketing; no later than 30 days after service of the certificate of filing of a transcript ordered but not filed before docketing; or no later than 30 days after a statement under Rule 3.04 or 3.05 is filed. An appellee, or appellee/cross-appellant, files no later than 30 days after the appellant's brief is served; a cross-appellee, and an appellee/cross-appellee, no later than 21 days after the cross-appellant's brief is served; a reply brief no later than 14 days after service of the brief replied to (Kan. S. Ct. R. 6.01(b)). The page limits are declared above (Kan. S. Ct. R. 6.07(c)); a motion to exceed them is submitted before the brief, with a specific page request (Kan. S. Ct. R. 6.07(d)). A response to an appellate motion may be filed no later than 7 days after service of the motion (Kan. S. Ct. R. 5.01(b))."
  edge-briefing-submitted "Briefing complete" -> hearing { authority cite "Kan. S. Ct. R. 7.02(c)" }
}

state hearing: "Hearing or summary calendar" by court cite "Kan. S. Ct. R. 7.02(c)"
{
  note "The chief judge of the Court of Appeals designates hearing panels; a case is heard by a panel unless a majority of the judges orders it heard en banc (Kan. S. Ct. R. 7.02(a)(1)). A suggestion for hearing en banc is filed no later than the time for the appellee's brief (Kan. S. Ct. R. 7.02(b)). After screening, a case that presents no new question of law and in which oral argument is neither helpful nor essential may be placed on the summary calendar and is submitted without argument unless a motion for oral argument, filed no later than 14 days after the clerk mails notice of calendaring, is granted; argument is then limited to 15 minutes a side unless 20, 25 or 30 minutes are granted (Kan. S. Ct. R. 7.02(c))."
  edge-hearing-decided "Submitted for decision" -> decision {
    authority cite "Kan. S. Ct. R. 7.03(a)"
  }
}

state decision: "Decision filed" by court cite "Kan. S. Ct. R. 7.03(a)"
{
  note "A decision of an appellate court is announced by electronically filing the opinion with the clerk of the appellate courts, who sends a copy to an unrepresented party that has appeared and notifies the district judge (Kan. S. Ct. R. 7.03(a)). Disposition may affirm, reverse or remand; the Court of Appeals may correct, modify, vacate or reverse any act, order or judgment of a district court (K.S.A. 60-2101(a))."
  edge-decision-filed "Opinion filed" -> post-decision { event DecisionFiled() authority cite "Kan. S. Ct. R. 7.05(a)" }
}

decision post-decision: "Rehearing or review sought?" by applicant cite "Kan. S. Ct. R. 7.05(a)"
{
  note "A motion for rehearing or modification of a Court of Appeals decision may be served and filed no later than 14 days after the decision is filed, with the opinion attached; it stays the mandate but is not a prerequisite for review and does not extend the time for a petition for review (Kan. S. Ct. R. 7.05(a), (b)). A suggestion for rehearing en banc is filed within the time for a motion for rehearing (Kan. S. Ct. R. 7.02(b)). A party aggrieved by a Court of Appeals decision may petition the Supreme Court for review within 30 days after the date of the decision (K.S.A. 20-3018(b)); the 30-day period is jurisdictional and cannot be extended (Kan. S. Ct. R. 8.03(b)(1)). In the Supreme Court a motion for rehearing or modification is due no later than 21 days after its decision is filed (Kan. S. Ct. R. 7.06(a))."
  edge-post-decision-none "No motion or petition" -> mandate {
    authority cite "Kan. S. Ct. R. 7.03(b)"
  }
  edge-post-decision-rehearing "Motion for rehearing or modification" -> rehearing-order {
    authority cite "Kan. S. Ct. R. 7.05(a)"
  }
  edge-post-decision-review "Petition for review" -> review-petitioned { event ReviewPetitionFiled()
    authority cite "Kan. S. Ct. R. 8.03(b)"
  }
}

decision rehearing-order: "Rehearing or modification decided" by court cite "Kan. S. Ct. R. 7.05(c)"
{
  note "A granted motion for rehearing suspends the effect of the original decision until the matter is decided on rehearing (Kan. S. Ct. R. 7.05(c)). While a timely motion is pending the Court of Appeals keeps jurisdiction and the Supreme Court takes no action on a petition for review; a petitioner seeking review of a modified decision files an amended petition no later than 30 days after the date of the modified decision (Kan. S. Ct. R. 8.03(b)(2))."
  edge-rehearing-order-mandate "Decided: no further review" -> mandate {
    authority cite "Kan. S. Ct. R. 7.03(b)"
  }
  edge-rehearing-order-review "Petition for review" -> review-petitioned { event ReviewPetitionFiled()
    authority cite "Kan. S. Ct. R. 8.03(b)"
  }
}

terminal review-petitioned: "Petition for review filed in the Supreme Court" outcome [appeal] cite "Kan. S. Ct. R. 8.03(b)"
{
  note "A party aggrieved by the Court of Appeals decision petitions the Supreme Court for review within 30 days after the decision (K.S.A. 20-3018(b); Kan. S. Ct. R. 8.03(b)(1)). The petition and its disposition are the Supreme Court's: lit/ks-supreme-court."
}

state mandate: "Mandate issued" by office cite "Kan. S. Ct. R. 7.03(b)"
{
  note "The mandate issues 7 days after the time to file a petition for review or motion for rehearing or modification expires, after entry of an order denying a timely petition or motion, or after any other event that finally disposes of the appeal; the court may shorten or extend the time, and the mandate is effective when issued. A timely petition for review or motion for rehearing or modification stays the mandate until its disposition unless the court orders otherwise (Kan. S. Ct. R. 7.03(b))."
  edge-mandate-final "Mandate issued" -> final-decision { event MandateIssued() authority cite "Kan. S. Ct. R. 7.03(b)" }
}

terminal dismissed-jurisdiction: "Dismissed: no appellate jurisdiction" outcome [loss, dismissal, jurisdictional] cite "K.S.A. 60-2101(a)"
{
  note "Outcome from the appellant's side: the order or judgment is not one from which an appeal lies to the Court of Appeals (K.S.A. 60-2101(a))."
}

terminal dismissed-untimely: "Dismissed: untimely notice" outcome [loss, dismissal] cite "K.S.A. 60-2103(a)"
{
  note "Outcome from the appellant's side: no notice of appeal within the 30 days from entry of judgment or any extension (K.S.A. 60-2103(a))."
}

terminal dismissed-abandoned: "Dismissed: appeal not docketed" outcome [loss, dismissal] cite "Kan. S. Ct. R. 5.051(a)"
{
  note "An appeal noticed but not docketed under Rule 2.04 is presumed abandoned and the district court may dismiss it. The dismissal is final unless, no later than 30 days after its entry, the appellant applies to the clerk of the appellate courts for reinstatement showing good cause, submits the docketing documents and pays the docket fee, and the appellate court reinstates the appeal (Kan. S. Ct. R. 5.051(b)). A motion to docket out of time states good cause (Kan. S. Ct. R. 2.04(a)(4))."
}

terminal final-decision: "Final: decision stands" outcome [final] cite "Kan. S. Ct. R. 7.03(b)"
{
  note "The appellate decision stands after the mandate issues; the mandate goes to the clerk of the district court with a certified copy of the opinion (Kan. S. Ct. R. 7.03(b))."
}
