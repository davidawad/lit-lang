// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-in-tax-court

import outline-in-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start commenced

state commenced: "Complaint, petition or appeal filed" by applicant cite ?("Ind. Code § 33-26-6-2 (verify)")
{
  note "OUTLINE. The Tax Court reviews final determinations of the Department of State Revenue and the Indiana Board of Tax Review; the Supreme Court reviews it on petition for review. Commencement in the Indiana Tax Court: filing period, fees and pleading form are holes. Leading decisions: not yet identified in this pass; verify before use."
  edge-commenced-served "Process served" -> pleadings { event ActionCommenced() authority cite ?("Ind. Tax Ct. R. 4 (verify)") }
}

chance pleadings: "Answer or motion to dismiss" by court cite ?("Ind. Trial Rule 12 (verify)")
{
  note "OUTLINE. Response period and dismissal grounds are holes."
  edge-pleadings-dismissed "Dismissed on the pleadings" -> dismissed p ? { authority cite ?("Ind. Trial Rule 12 (verify)") }
  edge-pleadings-answered "Answered; case proceeds" -> discovery p ? { authority cite ?("Ind. Trial Rule 12 (verify)") }
  edge-pleadings-settled "Settled or withdrawn" -> settled p ? { }
}

state discovery: "Discovery and pretrial" by applicant cite ?("Ind. Trial Rule 26 (verify)")
{
  note "OUTLINE. Discovery scope, limits and scheduling are holes."
  edge-discovery-dispositive "Dispositive motion or trial setting" -> dispositive { authority cite ?("Ind. Trial Rule 56 (verify)") }
}

chance dispositive: "Summary disposition?" by court cite ?("Ind. Trial Rule 56 (verify)")
{
  note "OUTLINE. Summary-judgment standard and timing are holes."
  edge-dispositive-granted "Decided without trial" -> judgment p ? { authority cite ?("Ind. Trial Rule 56 (verify)") }
  edge-dispositive-trial "Tried" -> trial p ? { authority cite ?("Ind. Code § 33-26-6-3 (verify)") }
}

state trial: "Trial or hearing" by court cite ?("Ind. Code § 33-26-6-3 (verify)")
{
  note "OUTLINE. Jury availability and trial procedure are holes."
  edge-trial-judgment "Decision rendered" -> judgment { authority cite ?("Ind. Tax Ct. R. (verify)") }
}

state judgment: "Judgment or decision entered" by court cite ?("Ind. Tax Ct. R. (verify)")
{
  note "OUTLINE. Entry, notice of entry and post-judgment motion periods are holes."
  edge-judgment-entered "Judgment entered" -> post-judgment { event JudgmentEntered() authority cite ?("Ind. Tax Ct. R. (verify)") }
}

decision post-judgment: "Appeal or review?" by applicant cite ?("Ind. Appellate Rule 63 (verify)")
{
  note "OUTLINE. The appeal period and the court that hears it are holes."
  edge-post-appeal "Appeal or petition for review filed" -> appeal-taken { event NoticeOfAppealFiled() authority cite ?("Ind. Appellate Rule 63 (verify)") }
  edge-post-final "No appeal" -> final-no-appeal { }
}

terminal dismissed: "Dismissed" outcome [loss, dismissal] cite ?("Ind. Trial Rule 12 (verify)")
{
  note "OUTLINE. With or without prejudice is a hole."
  payoff ?
}

terminal settled: "Settled or withdrawn" outcome [settlement] cite ?("Ind. Code § 33-26-6-2 (verify)")
{
  note "OUTLINE. Settlement terms are outside this outline."
  payoff ?
}

terminal appeal-taken: "Appeal or review taken" outcome [final] cite ?("Ind. Appellate Rule 63 (verify)")
{
  note "OUTLINE. The reviewing court is its own package."
  payoff ?
}

terminal final-no-appeal: "Judgment final without appeal" outcome [final] cite ?("Ind. Tax Ct. R. (verify)")
{
  note "OUTLINE. Enforcement is outside this outline."
  payoff ?
}
