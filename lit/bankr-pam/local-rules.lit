module bankr-pam-local-rules.local-rules

import core.frbp9006.{ frbp9006 }
import frbp.events.{ OrderForReliefEntered, PetitionFiled }

// The Bankr. M.D. Pa. court's own periods and page and word limits, counted
// under FRBP 9006(a): the Local Bankruptcy Rules effective January 1, 2005
// as modified October 1, 2025. The FRBP periods (schedules, claims, the
// chapter 13 plan, discharge, dischargeability, exemptions, the adversary
// answer and summons, appeals) are lit/frbp's and are not declared again.
//
// Stated in the rules but not declared: the FRBP's own periods the rules run
// on (a motion for reconsideration within 14 days after entry of the
// judgment or order, L.B.R. 9023-1, FRBP 9023; the payment advices
// certification within FRBP 1007(c)'s time, L.B.R. 1007-1(c); a sale
// objection deadline not less than 21 days after the notice is mailed and
// service of a sale notice 21 days before the hearing, L.B.R. 6004-1(c)(9),
// 6004-5(f), FRBP 2002(a)(2)); the hour and working-day periods (the pre-
// confirmation certifications 24 hours before the hearing, L.B.R. 3015-3(a);
// a motion to exceed the brief limits 2 working days before the brief is
// due, L.B.R. 9013-2(c); continuance requests and notice within 24 hours of
// the hearing, L.B.R. 9013-4; a Request to Remove 24 hours before the
// hearing, L.B.R. 9019-1(b); filing during a technical failure of up to 72
// hours, L.B.R. 5005-3); the court's, clerk's and mediator's own acts (the
// clerk's 21 days' notice of the exemption objection response date, L.B.R.
// 4003-1(a); the bankruptcy judge's report and recommendation on withdrawal
// of the reference within 14 days, L.B.R. 5011-1(e); the clerk's 30-day
// notice before an involuntary dismissal, L.B.R. 7041-1; a mediator's
// rejection of an appointment within 7 days, the session within 30 days of
// referral and continued no later than 45, and the mediator's reports,
// L.B.R. 9019-2(g)-(h), 9019-3(e), (g)); the conditions that are not
// deadlines (a stipulation expected within 60 days, L.B.R. 9019-1(b); a
// financing order's 75- and 60-day investigation periods, L.B.R.
// 4001-3(c)(3)(B); a final financing hearing at least 14 days after the
// committee's organizational meeting, L.B.R. 4001-3(g); dismissal for want
// of prosecution 45 days after the response date and default judgment 7 days
// after the motion is served, L.B.R. 7055-1; the mortgage mediation
// program's 75 percent payment, two years of returns and 60 days of payment
// advices, L.B.R. 9019-3(a)(3)-(4); the 30- to 45-day mediation window,
// L.B.R. 9019-3(e)(6); records kept 2 years, L.B.R. 5005-1). The Local
// Bankruptcy Forms are not vendored.
/// A brief filed in any matter, adversary or contested: no more than 15
/// pages, or more than 15 pages if no more than 5,000 words with a word-count
/// certificate (L.B.R. 9013-2(a)-(b)); a longer brief needs prior
/// authorization (L.B.R. 9013-2(c)).
limit brief {
  pages <= 15 cite "Bankr. M.D. Pa. L.B.R. 9013-2"
  words <= 5_000 cite "Bankr. M.D. Pa. L.B.R. 9013-2"
} cite "Bankr. M.D. Pa. L.B.R. 9013-2"

/// A mediation conference memorandum sent to the mediator (L.B.R.
/// 9019-2(h)(1)).
limit mediation-memorandum {
  pages <= 2 cite "Bankr. M.D. Pa. L.B.R. 9019-2(h)"
} cite "Bankr. M.D. Pa. L.B.R. 9019-2(h)"

/// A mortgage modification mediation conference memorandum sent to the
/// mediator and the opposing party (L.B.R. 9019-3(f)(1)).
limit mmm-mediation-memorandum {
  pages <= 2 cite "Bankr. M.D. Pa. L.B.R. 9019-3(f)"
} cite "Bankr. M.D. Pa. L.B.R. 9019-3(f)"

/// A petition signed by neither the petitioner nor counsel is filed (L.B.R.
/// 1002-1(a)).
event UnsignedPetitionFiled()
/// The clerk notifies a party that a pleading was filed without the required
/// fee (L.B.R. 1006-1(b)).
event FeeDeficiencyNoticed()
/// A motion to extend the time to file lists, schedules, statements, plans or
/// other documents is served (L.B.R. 1007-1(b)).
event ExtensionMotionServed()
/// The passive notice of a motion for joint administration is served (L.B.R.
/// 1015-1(a)(2)).
event JointAdministrationNoticeServed()
/// The notice of a request for substantive consolidation is served (L.B.R.
/// 1015-1(b)).
event ConsolidationNoticeServed()
/// A motion to sever jointly administered cases is served (L.B.R.
/// 1015-1(c)(2)).
event SeveranceMotionServed()
/// A chapter 13 case is converted to chapter 7 (L.B.R. 1019-1).
event ConversionFromChapter13()
/// Notice is served under L.B.R. 2002-1 (L.B.R. 2002-1(g)).
event NoticeServed()
/// A motion under FRBP 2004(a) is served on the respondent (L.B.R. 2004-1).
event ExaminationMotionServed()
/// An application to employ a professional, filed more than 14 days after the
/// petition, is served (L.B.R. 2014-1(c)).
event LateEmploymentApplicationServed()
/// The confirmation hearing on a chapter 11 or chapter 13 plan, or its
/// continued date (L.B.R. 2016-2(d), 3018-1, 3020-1).
event ConfirmationHearing()
/// The objection to a claim and the L.B.F. 3007-1 notice are served (L.B.R.
/// 3007-1(c)).
event ClaimObjectionNoticeServed()
/// A self-represented debtor files an amended chapter 12 or 13 plan before
/// confirmation (L.B.R. 3015-2(d)).
event ProSeAmendedPlanFiled()
/// A pro se debtor files a motion to modify a confirmed chapter 12 or 13 plan
/// (L.B.R. 3015-2(g)).
event ProSeModificationMotionFiled()
/// A motion to withdraw the reference and its supporting brief are served
/// (L.B.R. 5011-1(d)).
event WithdrawalMotionServed()
/// The bankruptcy judge's report and recommendation on withdrawal of the
/// reference is served (L.B.R. 5011-1(e)).
event RecommendationServed()
/// A motion in an adversary proceeding, other than one under FRCP
/// 12(b)(1)-(6), is served (L.B.R. 7007-1(b)).
event AdversaryMotionServed()
/// The initial mediation conference (L.B.R. 9019-2(h)).
event MediationConference()
/// A party sends its mediation conference memorandum to the mediator (L.B.R.
/// 9019-2(h)(1)).
event MediationMemorandumSent() paper mediation-memorandum
/// The debtor files and serves a Motion to Participate in the Mortgage
/// Modification Mediation Program (L.B.R. 9019-3(b)(1)).
event ParticipationMotionFiled()
/// The order granting entry into the MMM Program is entered (L.B.R.
/// 9019-3(b)(2)(C)).
event ParticipationOrderEntered()
/// The mortgage creditor registers with the portal after the Participation
/// Order (L.B.R. 9019-3(c)(2)).
event PortalRegistered()
/// The debtor submits a completed loss mitigation application (L.B.R.
/// 9019-3(c)(3), (d)(3)).
event LossMitigationApplicationSubmitted()
/// The mortgage creditor requests additional or missing information (L.B.R.
/// 9019-3(c)(4)).
event DocumentsRequested()
/// The scheduled transfer or assignment of servicing of the loan under review
/// (L.B.R. 9019-3(c)(6)).
event ServicingTransfer()
/// The service transfer of the loan under review takes place (L.B.R.
/// 9019-3(c)(6)).
event ServicingTransferred()
/// The scheduled MMM Program mediation session (L.B.R. 9019-3(f)).
event MmmMediationSession()
/// A party sends its MMM mediation conference memorandum (L.B.R.
/// 9019-3(f)(1)).
event MmmMemorandumSent() paper mmm-mediation-memorandum
/// Passive notice of the motion to approve a final loan modification is given
/// (L.B.R. 9019-3(j)(2)).
event ModificationNoticeGiven()
/// The MMM Program ends without a loan modification agreed (L.B.R.
/// 9019-3(j)(3)).
event MmmProgramUnsuccessful()
/// A post-trial motion is filed (L.B.R. 9023-2).
event PostTrialMotionFiled()
/// The moving party's post-trial brief is served (L.B.R. 9023-2(e)).
event PostTrialBriefServed()
/// A trial or evidentiary hearing (L.B.R. 9070-1, 9074-1).
event TrialOrHearing()
/// A final, non-appealable judgment is entered (L.B.R. 9070-2).
event FinalJudgmentEntered()

/// L.B.R. 1002-1(a): the clerk accepts an unsigned petition, but a signed
/// document must be filed within seven days or the petition may be dismissed.
deadline unsigned-petition-cure-period: 7.days after UnsignedPetitionFiled() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 1002-1(a)"
/// L.B.R. 1006-1(b): when a pleading is filed without the required fee, the
/// filing party has seven days after the clerk's notice to pay it or the
/// pleading may be stricken.
deadline fee-deficiency-period: 7.days after FeeDeficiencyNoticed() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 1006-1(b)"
/// L.B.R. 1007-1(a): a motion to extend the time to file lists, schedules,
/// statements, plans or other required documents is filed within fourteen
/// days of the entry of an order for relief or before any earlier extension
/// expires; an untimely motion may be denied and the case dismissed.
deadline schedules-extension-motion-period: 14.days after OrderForReliefEntered() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 1007-1(a)"
/// L.B.R. 1007-1(b): an objection to an extension of time is filed within
/// seven days of service of the motion.
deadline schedules-extension-objection-period: 7.days after ExtensionMotionServed() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 1007-1(b)"
/// L.B.R. 1015-1(a)(2): the passive notice of a motion for joint
/// administration provides a twenty-one day objection period; with no
/// objection the court may enter the order.
deadline joint-administration-objection-period: 21.days after JointAdministrationNoticeServed() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 1015-1(a)"
/// L.B.R. 1015-1(b): the notice of a request for substantive consolidation
/// provides a twenty-one day objection period.
deadline consolidation-objection-period: 21.days after ConsolidationNoticeServed() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 1015-1(b)"
/// L.B.R. 1015-1(c)(2): no hearing is held on a motion to sever jointly
/// administered cases unless an objection is filed within fourteen days of
/// service.
deadline severance-objection-period: 14.days after SeveranceMotionServed() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 1015-1(c)"
/// L.B.R. 1019-1: the chapter 13 trustee files a final report and account
/// within sixty days after conversion of the case (FRBP 1019's 30 days run
/// unless the court orders otherwise).
deadline converted-chapter13-final-report-period: 60.days after ConversionFromChapter13() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 1019-1"
/// L.B.R. 2002-1(g): the certificate of service showing compliance with
/// L.B.R. 2002-1 is filed no later than seven days following the date of
/// service.
deadline notice-certificate-period: 7.days after NoticeServed() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 2002-1(g)"
/// L.B.R. 2004-1: the court considers a motion under FRBP 2004(a) fourteen
/// days after service on the respondent; if no objection or answer is filed
/// within fourteen days an order may be entered.
deadline examination-objection-period: 14.days after ExaminationMotionServed() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 2004-1"
/// L.B.R. 2014-1(c): the United States trustee files any objection to an
/// application to employ within seven days from service of the application,
/// unless it is filed within fourteen days of the petition.
deadline ust-employment-objection-period: 7.days after LateEmploymentApplicationServed() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 2014-1(c)"
/// L.B.R. 2014-1(c): if the application to employ is filed within fourteen
/// days of the petition, any objection is filed within twenty-one days of the
/// filing of the petition.
deadline early-ust-employment-objection-period: 21.days after PetitionFiled() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 2014-1(c)"
/// L.B.R. 2016-2(d): an attorney to be paid through a proposed chapter 13
/// plan files a Request for Payment (L.B.F. 2016-2(c)) no later than seven
/// days before the confirmation hearing, or before a continued hearing when
/// additional fees are requested.
deadline chapter13-fee-request-period: 7.days before ConfirmationHearing() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 2016-2(d)"
/// L.B.R. 3007-1(c): unless the court orders otherwise, no hearing on an
/// objection to claim is scheduled unless the claimant files a request for
/// hearing or response no later than thirty days from the date the notice is
/// served.
deadline claim-objection-hearing-request-period: 30.days after ClaimObjectionNoticeServed() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 3007-1(c)"
/// L.B.R. 3015-2(d): within five days after a self-represented debtor files
/// an amended plan before confirmation, the debtor serves it on each party on
/// the mailing matrix and files a certificate of service.
deadline pro-se-amended-plan-service-period: 5.days after ProSeAmendedPlanFiled() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 3015-2(d)"
/// L.B.R. 3015-2(g): within five days a pro se debtor moving to modify a
/// confirmed plan mails the amended plan, the motion and a proposed order to
/// each creditor and party in interest.
deadline pro-se-modification-service-period: 5.days after ProSeModificationMotionFiled() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 3015-2(g)"
/// L.B.R. 3018-1: no less than seven days before the confirmation hearing,
/// the plan proponent files the Section 1126 Ballot Report Form (L.B.F.
/// 3018-1) and serves it on the debtor and each committee.
deadline ballot-report-period: 7.days before ConfirmationHearing() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 3018-1"
/// L.B.R. 3020-1: an individual chapter 11 debtor's confirmation order is not
/// entered unless, at least seven days before the confirmation hearing, the
/// debtor has filed the domestic support obligations certification (L.B.F.
/// 3020-1).
deadline individual-chapter11-dso-period: 7.days before ConfirmationHearing() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 3020-1"
/// L.B.R. 4001-5(a): a motion to extend the automatic stay under §
/// 362(c)(3)(B) is filed and served within seven days after the petition is
/// filed; a later motion must meet L.B.R. 9075-1 (emergency orders).
deadline stay-extension-motion-period: 7.days after PetitionFiled() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 4001-5(a)"
/// L.B.R. 5011-1(d): a party opposing a motion to withdraw the reference
/// files with the district court and serves an objection and brief within
/// fourteen days after service of the motion and supporting brief.
deadline withdrawal-objection-period: 14.days after WithdrawalMotionServed() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 5011-1(d)"
/// L.B.R. 5011-1(e): any party may object to the bankruptcy judge's report
/// and recommendation on withdrawal of the reference within fourteen days
/// after being served with it.
deadline recommendation-objection-period: 14.days after RecommendationServed() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 5011-1(e)"
/// L.B.R. 7007-1(b): the response to a motion in an adversary proceeding (no
/// response being required to an FRCP 12(b)(1)-(6) motion unless ordered) is
/// filed and served within fourteen days after service of the motion.
deadline adversary-motion-response-period: 14.days after AdversaryMotionServed() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 7007-1(b)"
/// L.B.R. 9019-2(h)(1): not later than seven days before the initial
/// conference, each party sends the mediator a mediation conference
/// memorandum of no more than two pages.
deadline mediation-memorandum-period: 7.days before MediationConference() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-2(h)"
/// L.B.R. 9019-3(b)(2): the mortgage creditor has twenty-one days to file a
/// response (a Creditor Consent Form or an objection) to the Motion to
/// Participate; if it files neither, it waives any objection (L.B.R.
/// 9019-3(b)(2)(C)).
deadline participation-response-period: 21.days after ParticipationMotionFiled() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-3(b)"
/// L.B.R. 9019-3(c)(1): within fourteen days of entry of a Participation
/// Order, the mortgage creditor (unless already registered) registers with
/// the portal and posts the loss mitigation application.
deadline portal-registration-period: 14.days after ParticipationOrderEntered() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-3(c)"
/// L.B.R. 9019-3(c)(2): the debtor uploads and submits a completed loss
/// mitigation application on the portal within thirty days after the mortgage
/// creditor registers (or after the Participation Order, if the creditor was
/// already registered).
deadline portal-application-period: 30.days after PortalRegistered() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-3(c)"
/// L.B.R. 9019-3(c)(3), (d)(3): within fourteen days after the debtor submits
/// the loss mitigation application, the mortgage creditor designates a single
/// point of contact and acknowledges the application.
deadline portal-contact-designation-period: 14.days after LossMitigationApplicationSubmitted() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-3(c)"
/// L.B.R. 9019-3(c)(4): the debtor submits additional or missing information
/// promptly, and in no event more than twenty-one days after the mortgage
/// creditor requests it.
deadline requested-documents-period: 21.days after DocumentsRequested() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-3(c)"
/// L.B.R. 9019-3(c)(6): no less than fourteen days before a scheduled
/// servicing transfer or assignment, the mortgage creditor files a Proposed
/// Order Substituting MMM Servicer (L.B.F. 9019-3(c)) and updates the portal.
deadline servicing-substitution-period: 14.days before ServicingTransfer() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-3(c)"
/// L.B.R. 9019-3(c)(6): within thirty days of the service transfer, the
/// substituted creditor designates a single point of contact for the loss
/// mitigation process.
deadline substituted-contact-period: 30.days after ServicingTransferred() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-3(c)"
/// L.B.R. 9019-3(d)(1): outside the portal, the mortgage creditor provides
/// the debtor the loss mitigation package and document checklist within
/// fourteen days of the Participation Order.
deadline loss-mitigation-package-period: 14.days after ParticipationOrderEntered() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-3(d)"
/// L.B.R. 9019-3(d)(2): within thirty days of the Participation Order, the
/// debtor provides two years' signed tax returns, sixty days' payment advices
/// and any other document the creditor requests.
deadline off-portal-documents-period: 30.days after ParticipationOrderEntered() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-3(d)"
/// L.B.R. 9019-3(f)(1): not later than seven days before the scheduled
/// mediation session, the debtor and the mortgage creditor each send the
/// mediator and the opposing party a memorandum of no more than two pages.
deadline mmm-memorandum-period: 7.days before MmmMediationSession() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-3(f)"
/// L.B.R. 9019-3(j)(2): the passive notice of a motion to approve a final
/// modification allows a twenty-one day objection period, and a certificate
/// of mailing is filed within seven days following the date of the notice.
deadline modification-mailing-certificate-period: 7.days after ModificationNoticeGiven() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-3(j)"
/// L.B.R. 9019-3(j)(2): the passive notice allows a twenty-one day objection
/// period to the motion to approve the final loan modification.
deadline modification-objection-period: 21.days after ModificationNoticeGiven() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-3(j)"
/// L.B.R. 9019-3(j)(3): if no loan modification is agreed, the debtor files
/// an amended or modified chapter 13 plan within twenty-one days to address
/// the mortgage arrears; otherwise the creditor may move for stay relief.
deadline mmm-amended-plan-period: 21.days after MmmProgramUnsuccessful() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-3(j)"
/// L.B.R. 9019-3(j)(4): if within one hundred and twenty days from the
/// Participation Order neither a motion to approve a modification nor an
/// amended plan addressing the lien is filed, the debtor files and serves a
/// Loss Mitigation Status Report.
deadline mmm-status-report-period: 120.days after ParticipationOrderEntered() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9019-3(j)"
/// L.B.R. 9023-2(b): affidavits, transcripts and other documents supporting a
/// post-trial motion on facts not of record are filed within fourteen days
/// after the motion, unless the court orders otherwise.
deadline post-trial-documents-period: 14.days after PostTrialMotionFiled() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9023-2(b)"
/// L.B.R. 9023-2(d): the moving party's post-trial brief is filed within
/// fourteen days after the motion, or the motion may be deemed withdrawn.
deadline post-trial-brief-period: 14.days after PostTrialMotionFiled() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9023-2(d)"
/// L.B.R. 9023-2(e): the respondent's brief is filed within fourteen days
/// after service of the moving party's brief, or the respondent may be deemed
/// not to oppose.
deadline post-trial-response-brief-period: 14.days after PostTrialBriefServed() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9023-2(e)"
/// L.B.R. 9070-1(a): a complete copy of the case-in-chief paper exhibits is
/// provided to all parties at least three days before the trial or hearing.
deadline paper-exhibits-period: 3.days before TrialOrHearing() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9070-1(a)"
/// L.B.R. 9070-1(b)(3)-(4): electronic case-in-chief exhibits are uploaded to
/// the Cloud Evidence System and shared with opposing parties at least three
/// days before the hearing or trial.
deadline electronic-exhibits-period: 3.days before TrialOrHearing() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9070-1(b)"
/// L.B.R. 9070-2: fourteen days after entry of a final, non-appealable
/// judgment, each party retrieves its exhibits and physical evidence, or the
/// clerk may dispose of them without notice.
deadline exhibit-retrieval-period: 14.days after FinalJudgmentEntered() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9070-2"
/// L.B.R. 9074-1(b): a request to present testimony by remote appearance
/// alleges cause and is filed at least seven days before the scheduled
/// hearing.
deadline remote-testimony-request-period: 7.days before TrialOrHearing() counted_by frbp9006 cite "Bankr. M.D. Pa. L.B.R. 9074-1(b)"

start motion-served

state motion-served: "Motion to participate in mortgage modification mediation filed and served" by applicant cite "Bankr. M.D. Pa. L.B.R. 9019-3(b)"
{
  note "A chapter 13 debtor meeting the program criteria files a Motion to Participate with the L.B.F. 9019-3(a) notice, serves the mortgage creditor and counsel, and elects whether to use the portal (L.B.R. 9019-3(a)-(b)(1))."
  edge-motion-served-consent "Creditor consents" -> participating {
    authority cite "Bankr. M.D. Pa. L.B.R. 9019-3(b)"
    within participation-response-period
  }
  edge-motion-served-objection "Creditor objects; motion denied without prejudice" -> concluded {
    authority cite "Bankr. M.D. Pa. L.B.R. 9019-3(b)"
  }
  edge-motion-served-silent "No response; objection waived" -> participating {
    authority cite "Bankr. M.D. Pa. L.B.R. 9019-3(b)"
  }
}

state participating: "Participation Order entered; loss mitigation review" by applicant cite "Bankr. M.D. Pa. L.B.R. 9019-3(c)"
{
  note "Through the portal or outside it, the creditor posts or sends the loss mitigation package, the debtor submits the application and documents, and the creditor designates a single point of contact (L.B.R. 9019-3(c)-(d)); the court may refer the matter to a mediator (L.B.R. 9019-3(e))."
  edge-participating-result "Review and any mediation concluded" -> result {
    authority cite "Bankr. M.D. Pa. L.B.R. 9019-3(j)"
  }
}

decision result: "Program result" by court cite "Bankr. M.D. Pa. L.B.R. 9019-3(j)"
{
  note "If successful, the creditor moves to approve the final modification on 21 days' passive notice (L.B.R. 9019-3(j)(1)-(2)); if not, the debtor files an amended or modified plan within 21 days (L.B.R. 9019-3(j)(3))."
  edge-result-modified "Modification approved" -> concluded {
    authority cite "Bankr. M.D. Pa. L.B.R. 9019-3(j)"
  }
  edge-result-unsuccessful "No modification; amended plan filed" -> concluded {
    authority cite "Bankr. M.D. Pa. L.B.R. 9019-3(j)"
  }
}

terminal concluded: "Mortgage modification mediation concluded: the case continues under lit/frbp" outcome [procedural] cite "Bankr. M.D. Pa. L.B.R. 1001-1(a)"
{
  note "The Local Bankruptcy Rules and Forms govern practice and procedure before the court (L.B.R. 1001-1(a))."
}
