// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
// Sources: FISC Rules of Procedure, Rules 31, 44, 45-59 (fisc.uscourts.gov, fetched
// 2026-10-26); 50 U.S.C. §§ 1803, 1861 (LII headings, fetched 2026-10-26). Proceedings
// are sealed; this outline records structure only. Key decisions are unverified.
module outline-fiscr

start ruling-appealed

state ruling-appealed: "Judge's ruling appealed to the Court of Review" by applicant cite ?("50 U.S.C. § 1803(b); FISC R. 31; FISC R. 44")
{
  note "OUTLINE. The Court of Review hears appeals from FISC rulings on petitions under 50 U.S.C. § 1881a(h)(6) (FISC R. 31) and § 1861(f)(3) (FISC R. 44). Key decision (verify): In re Directives [REDACTED], 551 F.3d 1004 (FISA Ct. Rev. 2008) (review of directive challenges, cited for the Court of Review posture)."
  edge-ruling-appealed-petition "Petition for review" -> petition-filed {
    authority cite ?("FISC R. 54")
  }
}

decision petition-filed: "Petition for review filed in time" by applicant cite ?("FISC R. 54; FISC R. 55(a)")
{
  note "OUTLINE. A petition for review is filed with the Clerk (FISC R. 54), within 30 days after the decision (FISC R. 55(a)). If a timely en banc petition is filed under 50 U.S.C. § 1803(a)(2), the appeal period runs from the denial or dismissal, or from the en banc decision (FISC R. 55(b))."
  edge-petition-filed-timely "Filed in time" -> record-transmitted {
    authority cite ?("FISC R. 55(a)")
  }
  edge-petition-filed-late "Filed late" -> dismissed-untimely {
    authority cite ?("FISC R. 55(a)")
  }
}

state record-transmitted: "Record transmitted under seal" by office cite ?("FISC R. 57; FISC R. 58")
{
  note "OUTLINE. The petitioner moves to transmit the record (FISC R. 57). The Clerk transmits the record under seal (FISC R. 58) and notifies the Presiding Judge (FISC R. 59). Stay pending appeal is under FISC R. 56 and 50 U.S.C. § 1803(f)."
  edge-record-transmitted-en-banc "Record transmitted" -> en-banc-request {
    authority cite ?("FISC R. 58")
  }
}

decision en-banc-request: "En banc request or court-initiated review" by applicant cite ?("FISC R. 45; FISC R. 46; FISC R. 47; FISC R. 49")
{
  note "OUTLINE. Hearing or rehearing en banc is ordered only where necessary to secure uniformity or the question is of exceptional importance (FISC R. 45; 50 U.S.C. § 1803(a)(2)(A)). Party petitions are under FISC R. 47 and government initial requests under FISC R. 46. Court-initiated proceedings are under FISC R. 49. Polling is under FISC R. 50 and stays under FISC R. 51."
  edge-en-banc-request-granted "En banc granted" -> en-banc-review {
    authority cite ?("FISC R. 53")
  }
  edge-en-banc-request-none "No en banc" -> court-review-decision {
    authority cite ?("FISC R. 53")
  }
}

state en-banc-review: "En banc proceeding" by court cite ?("FISC R. 52; FISC R. 53")
{
  note "OUTLINE. En banc supplemental briefing and order under FISC R. 52 and R. 53. The effect on the appeal period is in FISC R. 55(b)."
  edge-en-banc-review-decision "En banc decision issued" -> court-review-decision {
    authority cite ?("FISC R. 53")
  }
}

decision court-review-decision: "Court of Review decision" by court cite ?("50 U.S.C. § 1803(b)")
{
  note "OUTLINE. The Court of Review decides the appeal. Key decision (verify): In re Sealed Case, 310 F.3d 717 (FISA Ct. Rev. 2002) (the Court of Review's first published decision on FISA)."
  edge-court-review-affirmed "Affirmed" -> review-affirmed {
    authority cite ?("50 U.S.C. § 1803(b)")
  }
  edge-court-review-reversed "Reversed or remanded" -> review-reversed {
    authority cite ?("50 U.S.C. § 1803(b)")
  }
  edge-court-review-supreme "Supreme Court review sought" -> supreme-court-review {
    authority cite ?("50 U.S.C. § 1803(b)")
  }
}

state supreme-court-review: "Petition for certiorari to the Supreme Court" by applicant cite ?("50 U.S.C. § 1803(b); 28 U.S.C. § 1254")
{
  note "OUTLINE. The Supreme Court reviews Court of Review decisions under 50 U.S.C. § 1803(b). The petition period and rules are holes (verify the Supreme Court rules package)."
  edge-supreme-court-review-decided "Supreme Court acts" -> supreme-court-decided {
    authority cite ?("50 U.S.C. § 1803(b)")
  }
}

terminal dismissed-untimely: "Petition dismissed as untimely" outcome [loss] cite ?("FISC R. 55(a)")
{
  note "OUTLINE. A petition for review filed after the 30-day period is dismissed."
  payoff ?
}

terminal review-affirmed: "Court of Review affirms" outcome [loss] cite ?("50 U.S.C. § 1803(b)")
{
  note "OUTLINE. The FISC ruling stands."
  payoff ?
}

terminal review-reversed: "Court of Review reverses or remands" outcome [win] cite ?("50 U.S.C. § 1803(b)")
{
  note "OUTLINE. The FISC ruling is reversed or remanded. The disposition on remand is a hole."
  payoff ?
}

terminal supreme-court-decided: "Supreme Court decision" outcome [decided] cite ?("50 U.S.C. § 1803(b)")
{
  note "OUTLINE. The Supreme Court outcome. Supreme Court packages cover the review."
  payoff ?
}
