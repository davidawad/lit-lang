module cofc.rules-general

import core.authority.{ CaseOrder }
import core.rcfc6.{ rcfc6 }

/// The answer (or the reply to a counterclaim) is filed and served. Both
/// the Appendix A Joint Preliminary Status Report and the Appendix J patent
/// cascade count from it.
event AnswerFiled()
/// All discovery, including expert discovery, closes (RCFC 56(b)).
event DiscoveryClosed()

/// What the order concluding an ADR proceeding indicates: "whether a
/// proposed settlement has been reached in whole or in part" (Appendix H ¶
/// 3(h)). `NoWholeSettlement` is a settlement in part or none, either of
/// which leaves claims to litigate.
enum AdrOutcome { WholeSettlement, NoWholeSettlement }

/// The settlement judge or third-party neutral enters the order concluding
/// the ADR proceeding, indicating `outcome` (Appendix H ¶ 3(h)).
event AdrConcluded(outcome: AdrOutcome)

/// Appendix A ¶4 (case management under RCFC 16(b)): the Joint Preliminary
/// Status Report is due 49 days after the answer, deferred while a
/// case-dispositive motion is pending (¶6). Appendix A is not in the
/// vendored corpus, so the cite stays a hole; in force as the rules stood
/// amended through July 27, 2026 (the RCFC 16 amendment of that date). The
/// court sets the schedule by order, the delegation the legacy pack records
/// as "court order".
rule duty joint-preliminary-status-report cite ?("RCFC 16(b)(1)(A); RCFC Appendix A ¶4") {
  deadline jpsr-period: 49.days after AnswerFiled() counted_by rcfc6 delegable { to CaseOrder, op set } cite ?("RCFC Appendix A ¶4") {
    extendable true
    extension_authority "court order"
  }
}

/// RCFC 56(b): "Unless the court orders otherwise, a party may file a
/// motion for summary judgment at any time until 30 days after the close of
/// all discovery." A power, not a duty: the motion is optional. The text
/// dates from the July 15, 2011 rewrite conforming to FRCP 56 as revised
/// December 1, 2010 (2011 Amendment note).
deadline sj-motion-period: 30.days after DiscoveryClosed() counted_by rcfc6 effective [2011-07-15, ..) delegable { to CaseOrder, op set } cite "RCFC 56(b)"
{
  extendable true
  extension_authority "court order / local practice"
}

test "the JPSR is due 49 days after the answer" cite ?("RCFC Appendix A ¶4") {
  given AnswerFiled() on 2026-08-03
  expect deadline(jpsr-period) == 2026-09-21
}

test "a JPSR due on Thanksgiving rolls to Friday" cite "RCFC 6(a)(6)(A)"
{
  given AnswerFiled() on 2026-10-08
  expect deadline(jpsr-period) == 2026-11-27
}

test "a JPSR due on Veterans Day rolls to Thursday" cite "RCFC 6(a)(6)(A)"
{
  given AnswerFiled() on 2026-09-23
  expect deadline(jpsr-period) == 2026-11-12
}

test "summary judgment may be sought until 30 days after discovery closes" cite "RCFC 56(b)"
{
  given DiscoveryClosed() on 2026-08-03
  expect deadline(sj-motion-period) == 2026-09-02
}

test "a summary-judgment window ending on Sunday before Labor Day runs to Tuesday" cite "RCFC 6(a)(1)(C)"
{
  given DiscoveryClosed() on 2026-08-07
  expect deadline(sj-motion-period) == 2026-09-08
}
