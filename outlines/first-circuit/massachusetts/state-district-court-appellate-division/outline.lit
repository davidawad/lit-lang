// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-ma-district-court-appellate-division

import ma-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start notice

decision notice: "Notice of appeal within time?" by applicant cite ?("Dist./Mun. Cts. R. A. D. A. 4 (verify)")
{
  note "OUTLINE. The Appellate Division hears civil appeals from the District Court and the Boston Municipal Court; the Appeals Court reviews its decisions. Appeal to the Massachusetts District Court, Appellate Division: appealability, the notice period and service are holes. Leading decisions: not yet identified in this pass; verify before use."
  edge-notice-late "No timely notice" -> dismissed-untimely { authority cite ?("Dist./Mun. Cts. R. A. D. A. 4 (verify)") }
  edge-notice-filed "Timely notice" -> record { event NoticeOfAppealFiled() authority cite ?("Dist./Mun. Cts. R. A. D. A. 4 (verify)") }
}

state record: "Record or transcript prepared" by office cite ?("Dist./Mun. Cts. R. A. D. A. 8 (verify)")
{
  note "OUTLINE. Record contents, transcript and fees are holes."
  edge-record-briefing "Record filed" -> briefing { event RecordFiled() authority cite ?("Dist./Mun. Cts. R. A. D. A. 8 (verify)") }
}

state briefing: "Briefs filed" by applicant cite ?("Dist./Mun. Cts. R. A. D. A. 19 (verify)")
{
  note "OUTLINE. Briefing periods, form and length are holes."
  edge-briefing-argument "Argument or submission" -> argument { authority cite ?("Dist./Mun. Cts. R. A. D. A. 22 (verify)") }
}

state argument: "Argument or submission" by court cite ?("Dist./Mun. Cts. R. A. D. A. 22 (verify)")
{
  note "OUTLINE. Argument may be discretionary."
  edge-argument-decision "Decision issued" -> decision { authority cite ?("G.L. c. 231, § 108 (verify)") }
}

chance decision: "Court decides" by court cite ?("G.L. c. 231, § 108 (verify)")
{
  note "OUTLINE. Outcome probabilities are holes."
  edge-decision-affirmed "Affirmed" -> post-decision p ? { event DecisionFiled() }
  edge-decision-reversed "Reversed, vacated or remanded" -> post-decision p ? { event DecisionFiled() }
}

decision post-decision: "Rehearing or further review?" by applicant cite ?("G.L. c. 231, § 109 (verify)")
{
  note "OUTLINE. Rehearing and further-review periods are holes."
  edge-post-mandate "No further review" -> mandate-issued { event MandateIssued() authority cite ?("Dist./Mun. Cts. R. A. D. A. 28 (verify)") }
  edge-post-further "Further review sought" -> further-review { event ReviewPetitionFiled() authority cite ?("G.L. c. 231, § 109 (verify)") }
}

terminal dismissed-untimely: "Dismissed: no timely notice" outcome [loss, dismissal] cite ?("Dist./Mun. Cts. R. A. D. A. 4 (verify)")
{
  note "OUTLINE. Whether the time limit is jurisdictional is a hole."
  payoff ?
}

terminal mandate-issued: "Mandate or remittitur issued" outcome [final] cite ?("Dist./Mun. Cts. R. A. D. A. 28 (verify)")
{
  note "OUTLINE. The case returns to the court below; costs are holes."
  payoff ?
}

terminal further-review: "Further review sought in a higher court" outcome [final] cite ?("G.L. c. 231, § 109 (verify)")
{
  note "OUTLINE. Review in the higher court is its own package."
  payoff ?
}
