  _ "ALJ issues sua sponte order to show cause why respondent should not be found in default (Rule 210.16(b))" -> show-cause-order {
    authority cite cfr210.16.b
  }
}

/// imported
decision show-cause-order: "Order to Show Cause (Default)" by applicant cite cfr210.16.b
{
  group response-period-group
  note "The ALJ may issue a show-cause order sua sponte; a proposed respondent may instead file a Notice of Intent to Default at any time before the final Initial Determination, skipping the show-cause exchange entirely. Both are respondent choices, not ALJ determinations — modeled as a pure player node."
  _ "Respond to the show-cause order — cure the default with a belated response (Rule 210.16(b))" -> response-filed {
    authority cite cfr210.16.b
    effort 10.hours
    cost 2_000.usd
