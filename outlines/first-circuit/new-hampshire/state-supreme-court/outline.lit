// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-nh-supreme-court

import outline-nh-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start notice-filed

state notice-filed: "Notice of Appeal Filed" by applicant cite ?("N.H. Sup. Ct. R. 7 (verify period)")
{
  note "OUTLINE. The filing deadline is a hole until verified. Leading decision on timeliness (verify): No leading decision confirmed in this run; verify before use."
  edge-notice-filed-timeliness "Notice filed" -> timeliness {
    authority cite ?("N.H. Sup. Ct. R. 7 (verify period)")
  }
}

decision timeliness: "Timeliness Reviewed" by court cite ?("N.H. Sup. Ct. R. 7 (verify)")
{
  note "OUTLINE. Late notice is dismissed; timely post-judgment motions and tolling change the clock."
  edge-timeliness-dismissed "Untimely" -> dismissed-untimely {
    authority cite ?("N.H. Sup. Ct. R. 7 (verify)")
  }
  edge-timeliness-record "Timely" -> record-transmitted {
    authority cite ?("N.H. Sup. Ct. R. 13 (verify)")
  }
}

terminal dismissed-untimely: "Appeal dismissed as untimely" outcome [loss] cite ?("N.H. Sup. Ct. R. 7 (verify)")
{
  note "OUTLINE. Jurisdictional bar. Leading decision (verify): No leading decision confirmed in this run; verify before use."
  payoff ?
}

state record-transmitted: "Record Transmitted and Docketed" by office cite ?("N.H. Sup. Ct. R. 13 (verify)")
{
  note "OUTLINE. Record contents, appendix and docketing steps are holes until verified."
  edge-record-briefing "Briefing schedule set" -> briefing { event RecordFiled()
    authority cite ?("N.H. Sup. Ct. R. 16 (verify)")
  }
}

state briefing: "Briefs Filed" by applicant cite ?("N.H. Sup. Ct. R. 16 (verify)")
{
  note "OUTLINE. Brief length, format and copy counts are holes. Every rule number here is a hole until verified."
  edge-briefing-argument "Briefing complete" -> argument-decision {
    authority cite ?("N.H. Sup. Ct. R. 20 (verify)")
  }
}

decision argument-decision: "Argument or Submission on Briefs" by court cite ?("N.H. Sup. Ct. R. 20 (verify)")
{
  note "OUTLINE. Leading decision on standard of review (verify): No leading decision confirmed in this run; verify before use."
  edge-argument-panel "Panel decides" -> panel-decision {
    authority cite ?("N.H. Sup. Ct. R. 21 (verify)")
  }
}

decision panel-decision: "Panel Decision" by court cite ?("N.H. Sup. Ct. R. 21 (verify)")
{
  note "OUTLINE. Affirmance and reversal both move to the rehearing step."
  edge-panel-affirmed "Affirmed" -> rehearing {
    authority cite ?("N.H. Sup. Ct. R. 21 (verify)")
  }
  edge-panel-reversed "Reversed or vacated" -> rehearing {
    authority cite ?("N.H. Sup. Ct. R. 21 (verify)")
  }
}

decision rehearing: "Rehearing or En Banc Petition" by court cite ?("N.H. Sup. Ct. R. 22 (verify)")
{
  note "OUTLINE. Petition deadline is a hole until verified. Petitions are usually denied."
  edge-rehearing-mandate-denied "Denied" -> mandate { event MandateIssued()
    authority cite ?("N.H. Sup. Ct. R. 22 (verify)")
  }
  edge-rehearing-mandate-none "No petition filed" -> mandate { event MandateIssued()
    authority cite ?("N.H. Sup. Ct. R. 22 (verify)")
  }
}

state mandate: "Mandate Issues" by office cite ?("N.H. Sup. Ct. R. 24 (verify)")
{
  note "OUTLINE. The mandate issues after the rehearing period; the stay of mandate is a hole until verified."
  edge-mandate-further-review "Further review sought" -> further-review {
    authority cite ?("N.H. Sup. Ct. R. 25 (verify)")
  }
  edge-mandate-final "No further review" -> final-judgment {
    authority cite ?("N.H. Sup. Ct. R. 24 (verify)")
  }
}

decision further-review: "Further Review Petition Decided" by court cite ?("N.H. Sup. Ct. R. 25 (verify)")
{
  note "OUTLINE. Leading decision on further review (verify): No leading decision confirmed in this run; verify before use."
  edge-further-denied "Denied" -> review-denied {
    authority cite ?("N.H. Sup. Ct. R. 25 (verify)")
  }
  edge-further-granted "Granted" -> review-granted {
    authority cite ?("N.H. Sup. Ct. R. 25 (verify)")
  }
}

terminal final-judgment: "Judgment final after mandate" outcome [loss] cite ?("N.H. Sup. Ct. R. 24 (verify)")
{
  note "OUTLINE. Outcome follows the panel disposition: affirmance is a loss for the appellant, reversal a win. Re-label before use."
  payoff ?
}

terminal review-denied: "Further review denied" outcome [loss] cite ?("N.H. Sup. Ct. R. 25 (verify)")
{
  note "OUTLINE. Judgment final."
  payoff ?
}

terminal review-granted: "Further review granted" outcome [win] cite ?("N.H. Sup. Ct. R. 25 (verify)")
{
  note "OUTLINE. Review granted; merits outcome not modeled here."
  payoff ?
}

