module core.states.vermont

import core.calendar.{ us-federal-holidays }

/// The legal holidays of Vermont (1 V.S.A. § 371(a)) that `us-federal-holidays`
/// does not already close: Town Meeting Day, the first Tuesday in March, and
/// Bennington Battle Day, August 16, observed on the Friday before a Saturday
/// and the Monday after a Sunday (§ 371(b)). The section's other days are
/// federal holidays, observed as § 6103(b)(1) observes them. Closed from the
/// date the vendored text, which includes the 2026 session, was retrieved
/// (October 29, 2026).
calendar vermont-holidays cite "1 V.S.A. § 371(a)"
{
  town-meeting-day: nth(1, tuesday, 3) effective [2026-10-29, ..)
  bennington-battle-day: fixed(8, 16) effective [2026-10-29, ..) observed nearest_weekday
}

/// FRCP 6 in the district courts of Vermont: the 2023 text
/// (`frcp6@2023-12-01`) with `vermont-holidays`, which 6(a)(6)(C)
/// ("any day declared a holiday by ... the state where the district court
/// is located") makes legal holidays "for periods that are measured after
/// an event" only. A district package there names it as its `counting`
/// rule and `recounts` lit/frcp. A calendar day is closed only from the
/// date its entry is in force; before it the count is `frcp6`'s.
counting frcp6-vermont effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCP 6(d)"
  holidays us-federal-holidays
  forward_holidays vermont-holidays cite "FRCP 6(a)(6)(C)"
  forums [frcp]
  allow_hours
  end_of_month clamp
}

/// FRBP 9006(a) (`frbp9006`) in the bankruptcy courts of Vermont:
/// `vermont-holidays` are legal holidays for a period counted forward only (FRBP
/// 9006(a)(6)(C), "any day declared a holiday by the state where the
/// district court is located"). A bankruptcy package there names it as its
/// `counting` rule and `recounts` lit/frbp. A calendar day is closed only
/// from the date its entry is in force.
counting frbp9006-vermont effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays vermont-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-vt]
  allow_hours
  end_of_month clamp
}
