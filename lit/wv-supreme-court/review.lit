module wv-supreme-court-civil.review

import wv-state-rules.{ DecisionFiled, MandateIssued, NoticeOfAppealFiled, RecordFiled }

// A civil appeal in the Supreme Court of Appeals, chiefly from a mandate of
// the Intermediate Court of Appeals (lit/wv-appellate-civil), from the
// applicant's (petitioner's) side. Every period below is stated in a note,
// not counted: time is computed under W. Va. R. App. P. 39(a), and lit/core
// has no counting rule for it or for West Virginia's legal holidays.
/// A petitioner's or respondent's brief: at most 40 pages, not counting
/// the cover page, tables of contents and authorities, or certificate of
/// service (Rule 38(c)).
limit principal-brief { pages <= 40 cite "W. Va. R. App. P. 38(c)" } cite "W. Va. R. App. P. 38(c)"
/// A reply brief: at most 20 pages (Rule 38(c)).
limit reply-brief { pages <= 20 cite "W. Va. R. App. P. 38(c)" } cite "W. Va. R. App. P. 38(c)"

/// A petition for rehearing and a response to it: at most 15 pages each
/// (Rule 38(c)).
limit rehearing-petition {
  pages <= 15 cite "W. Va. R. App. P. 38(c)"
} cite "W. Va. R. App. P. 38(c)"

start notice-filed

/// Rule 5(b) as amended by the order of August 21, 2026 (No. 25-57), a
/// dated layer over the base text: it supersedes the base version from the
/// day the order was entered.
state notice-filed: "Notice of appeal filed in the Supreme Court" by applicant effective [2026-08-21, ..) known_at 2026-10-28 supersedes notice-filed@2022-07-01 cite "W. Va. R. App. P. (2026) 5(b)"
{
  note "The order of August 21, 2026 (No. 25-57) amends Rule 5(a) and (b), marking additions by underscoring and deletions by strike-through, which the vendored text extract does not show; the original order is the authority for which words were added or struck. Rule 5(a) as printed reaches appeals from \"a mandate or other final decision order of the Intermediate Court\". Rule 5(b) as printed reads \"To appeal an opinion or memorandum decision of the Intermediate Court to the Supreme Court, the party appealing shall attach the Intermediate Court's mandate.\" The notice is filed within thirty days of entry of the final order or mandate being appealed, as in the base text; filing in the Office of the Clerk under Rule 38 and service are printed unchanged."
  edge-notice-filed-record "Appendix record and transcripts prepared" -> record {
    event NoticeOfAppealFiled()
    authority cite "W. Va. R. App. P. 7(d)"
  }
}

state notice-filed: "Notice of appeal filed in the Supreme Court" by applicant effective [2022-07-01, 2026-08-21) known_at 2026-10-28 cite "W. Va. R. App. P. 5(b)"
{
  note "Rule 5 governs appeals from a mandate or other final order of the Intermediate Court and from an appealable circuit court order, except abuse and neglect, workers' compensation, family court, Public Service Commission appeals and certified questions (Rule 5(a)). The Intermediate Court has no jurisdiction over, among others, criminal judgments, extraordinary remedy proceedings, certified questions and interlocutory appeals not provided for by law, and the Supreme Court may, on its own motion or a party's, obtain jurisdiction over any civil case filed in the Intermediate Court (Rule 1(b)). Within thirty days of entry of the final order or mandate being appealed, the party appealing files the notice of appeal with the attachments the Appendix A form requires, attaching the Intermediate Court's mandate to appeal its opinion or memorandum decision, in the Office of the Clerk, and serves it on all parties (Rule 5(b)). The Clerk charges $200 for docketing any civil appeal in the Supreme Court, except as provided by law for indigent parties (Rule 24(a)(1)). The court may extend the time to file a notice of appeal for good cause shown (Rule 5(i)(1)). As soon as practicable after the notice is properly filed, the court issues a scheduling order setting the dates for the briefs, the appendix or designated record, any transcript and motions (Rule 5(d)); failure to comply may bring sanctions or dismissal (Rule 5(e))."
  edge-notice-filed-record "Appendix record and transcripts prepared" -> record {
    event NoticeOfAppealFiled()
    authority cite "W. Va. R. App. P. 7(d)"
  }
}

state record: "Appendix record prepared" by applicant cite "W. Va. R. App. P. 7(d)"
{
  note "The record on appeal is not transmitted automatically; the petitioner prepares and files the appendix (Rule 6(c), 7(d)) unless the court permits a designated record by order (Rule 6(d), 8(a)). Unless otherwise provided by law, an appeal must be perfected within four months of the date the judgment being appealed was entered (Rule 5(f)); the appellate court with jurisdiction may extend that time for good cause, by order entered of record, by no more than two months in total, if a complete notice of appeal was timely and properly filed (Rule 5(i)(2))."
  edge-record-briefing "Petitioner's brief and appendix filed" -> briefing {
    event RecordFiled()
    authority cite "W. Va. R. App. P. 5(g)"
  }
  edge-record-unperfected "Appeal not perfected" -> dismissed-unperfected {
    authority cite "W. Va. R. App. P. 5(g)"
  }
}

terminal dismissed-unperfected: "Dismissed for failure to perfect" outcome [loss, dismissal] cite "W. Va. R. App. P. 5(g)"
{
  note "Failure by the petitioner to perfect an appeal results in the case being dismissed from the docket (Rule 5(g)). If an appeal is dismissed, costs are taxed against the petitioner unless the parties agree or the court orders otherwise (Rule 24(b))."
}

state briefing: "Briefs filed" by applicant cite "W. Va. R. App. P. 10(b)"
{
  note "An appeal is perfected by timely and properly filing the petitioner's brief under Rule 10 and the appendix record under Rule 7 (Rule 5(g)). Briefs are due when the scheduling order sets and are filed when received in the Clerk's Office in proper form, not when mailed (Rule 10(b)). The respondent may file a summary response instead of a brief, which waives oral argument (Rule 10(e)). After the response and any reply are filed or their time expires, the appeal is mature (Rule 5(h))."
  edge-briefing-mature "Appeal mature for consideration" -> argument {
    authority cite "W. Va. R. App. P. 5(h)"
  }
}

decision argument: "Decided on the briefs, or set for Rule 19 or Rule 20 argument" by court cite "W. Va. R. App. P. 5(h)"
{
  note "Once the appeal is mature the court decides it on the merits without oral argument, sets it for oral argument and then decides it, or issues an appropriate order (Rule 5(h)). Rule 19 argument suits the application of settled law, an exercise of discretion under settled law, sufficiency or weight of the evidence and narrow issues of law; Rule 20 argument suits first impression, fundamental public importance, constitutional questions and conflicts among lower tribunals (Rule 19(a), 20(a)). Rule 19 argument is limited to ten minutes per side and Rule 20 argument to twenty minutes per side unless the notice or an order provides otherwise, before the Chief Justice (Rule 19(e), 20(e))."
  edge-argument-rule19 "Set for Rule 19 argument" -> merits-decision {
    authority cite "W. Va. R. App. P. 19(a)"
  }
  edge-argument-rule20 "Set for Rule 20 argument" -> merits-decision {
    authority cite "W. Va. R. App. P. 20(a)"
  }
  edge-argument-briefs "Decided without oral argument" -> merits-decision {
    authority cite "W. Va. R. App. P. 18(a)"
  }
}

decision merits-decision: "Memorandum decision or opinion released" by court cite "W. Va. R. App. P. 21(a)"
{
  note "At any time after the case is mature the court may issue a memorandum decision addressing the merits (Rule 21(a)); after Rule 20 argument it decides by opinion or other order and not by memorandum decision absent exceptional or compelling circumstances (Rule 20(g)). A memorandum decision affirms where there is no substantial question of law, no prejudicial error or other just cause (Rule 21(c)). Opinions and memorandum decisions take effect only when the mandate issues (Rule 21(f), 26(a))."
  edge-merits-decision-affirmed "Affirmed" -> after-decision {
    event DecisionFiled()
    authority cite "W. Va. R. App. P. 21(c)"
  }
  edge-merits-decision-reversed "Reversed, vacated or remanded" -> after-decision {
    event DecisionFiled()
    authority cite "W. Va. R. App. P. 21(d)"
  }
}

decision after-decision: "Rehearing sought?" by applicant cite "W. Va. R. App. P. 25(a)"
{
  note "A petition for rehearing may be filed within thirty days of release of a memorandum decision or opinion that passes upon the merits, unless an order shortens or enlarges the time (Rule 25(a))."
  edge-after-decision-rehearing "Petition for rehearing filed" -> rehearing {
    authority cite "W. Va. R. App. P. 25(a)"
  }
  edge-after-decision-mandate "No rehearing" -> mandate-issued {
    event MandateIssued()
    authority cite "W. Va. R. App. P. 26(b)"
  }
}

decision rehearing: "Rehearing petition decided" by court cite "W. Va. R. App. P. 25(d)"
{
  note "Rehearing is granted only in exceptional cases; the petition states with particularity the points of law or fact the court overlooked or misapprehended (Rule 25(b)). An opposing party may respond within fourteen days of the filing of the petition, after which the petition is mature (Rule 25(c), (d)). A timely petition stays issuance of the mandate (Rule 26(b))."
  edge-rehearing-refused "Rehearing refused" -> mandate-issued {
    event MandateIssued()
    authority cite "W. Va. R. App. P. 26(b)"
  }
  edge-rehearing-granted "Rehearing granted: further proceedings ordered" -> merits-decision {
    authority cite "W. Va. R. App. P. 25(d)"
  }
}

terminal mandate-issued: "Mandate issued" outcome [final] cite "W. Va. R. App. P. 26(b)"
{
  note "If no petition for rehearing is timely filed, the Clerk issues the mandate as soon as practicable after thirty days from release of the opinion or memorandum decision; if rehearing is refused, within seven days of the order refusing it, unless an order shortens or enlarges the time (Rule 26(b)). The mandate terminates the court's jurisdiction (Rule 26(a)). Costs are taxed against the petitioner if the judgment is affirmed and against the respondent if it is reversed, unless otherwise ordered (Rule 24(b)). A stay of the Supreme Court's mandate pending a petition for certiorari to the Supreme Court of the United States may be granted on motion, for no more than ninety days unless the order provides otherwise (Rule 26(c)); federal certiorari is outside this package."
}
