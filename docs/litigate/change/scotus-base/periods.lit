module change-certiorari-base.periods

import core.calendar.{ us-federal-holidays }

// A base layer declares rules from nothing (docs/litigate/CHANGE.md §2.1).
// The certiorari period of a civil case as four editions of the Rules of
// the Supreme Court state it, one version per edition, each in force from
// the edition's effective date (Rule 48.1) to the next's. The 2013
// edition's has no end here: the later editions (effective November 13,
// 2017 and after, not vendored by this layer) are a later layer's to
// record. Rules 13.1, 13.3 and 30.1 read word for word alike in all four,
// so every version counts the same 90 days the same way.
/// After a United States court of appeals enters its judgment, a party may
/// petition the Supreme Court for a writ of certiorari.
start judgment-below

/// Entry of the court of appeals' judgment (Sup. Ct. R. 13.1), or, after a
/// timely petition for rehearing there, the denial of rehearing or the
/// later judgment on rehearing (Sup. Ct. R. 13.3).
event LowerCourtEntry()
/// An application to a Justice to extend the time to file the petition
/// (Sup. Ct. R. 13.5, 22, 30.2, 30.3).
event PetitionExtensionApplied()
/// A Justice's denial of the application: "Once denied, such an
/// application may not be renewed" (Sup. Ct. R. 30.3).
event PetitionExtensionDenied()
/// A Justice's order extending the time to file the petition to `until`
/// (Sup. Ct. R. 13.5).
event PetitionTimeExtended(until: Date) extends petition-period to until
/// The petition for a writ of certiorari is filed with the Clerk (Sup. Ct.
/// R. 12.1, 13.1).
event PetitionFiled()

/// Sup. Ct. R. 30.1 of the Rules effective May 2, 2005: the day of the act
/// or event is not included; the last day is, "unless it is a Saturday,
/// Sunday, federal legal holiday listed in 5 U. S. C. § 6103, or day on
/// which the Court building is closed by order of the Court or the Chief
/// Justice". No closure order is vendored, so none is declared. Service
/// adds no time: Rule 29.3 serves "personally, by mail, or by third-party
/// commercial carrier", and Rule 30 adds nothing for any of them.
counting sup-ct-30 effective [2005-05-02, 2007-10-01) known_at 2005-03-14 cite "Sup. Ct. R. (2005) 30.1"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday]
  service_extension {
    Personal: 0.days
    Electronic: unrecognized
    Mail: 0.days
    Clerk: unrecognized
    OtherConsented: unrecognized
    CommercialCarrier: 0.days
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "Sup. Ct. R. (2005) 29.3"
  holidays us-federal-holidays
  forums [scotus]
}

/// The Rules effective October 1, 2007 re-adopt Rules 29.3 and 30.1 word
/// for word.
counting sup-ct-30 effective [2007-10-01, 2010-02-16) known_at 2007-07-17 supersedes sup-ct-30@2005-05-02 cite "Sup. Ct. R. (2007) 30.1"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday]
  service_extension {
    Personal: 0.days
    Electronic: unrecognized
    Mail: 0.days
    Clerk: unrecognized
    OtherConsented: unrecognized
    CommercialCarrier: 0.days
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "Sup. Ct. R. (2007) 29.3"
  holidays us-federal-holidays
  forums [scotus]
}

/// The Rules effective February 16, 2010 re-adopt Rules 29.3 and 30.1 word
/// for word.
counting sup-ct-30 effective [2010-02-16, 2013-07-01) known_at 2010-01-12 supersedes sup-ct-30@2007-10-01 cite "Sup. Ct. R. (2010) 30.1"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday]
  service_extension {
    Personal: 0.days
    Electronic: unrecognized
    Mail: 0.days
    Clerk: unrecognized
    OtherConsented: unrecognized
    CommercialCarrier: 0.days
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "Sup. Ct. R. (2010) 29.3"
  holidays us-federal-holidays
  forums [scotus]
}

/// The Rules effective July 1, 2013 re-adopt Rule 30.1 word for word; Rule
/// 29.3 adds an electronic copy "transmitted" to the other parties, which
/// is not service and adds no time.
counting sup-ct-30 effective [2013-07-01, ..) known_at 2013-04-19 supersedes sup-ct-30@2010-02-16 cite "Sup. Ct. R. (2013) 30.1"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday]
  service_extension {
    Personal: 0.days
    Electronic: unrecognized
    Mail: 0.days
    Clerk: unrecognized
    OtherConsented: unrecognized
    CommercialCarrier: 0.days
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "Sup. Ct. R. (2013) 29.3"
  holidays us-federal-holidays
  forums [scotus]
}

/// Sup. Ct. R. 13.1 of the Rules effective May 2, 2005: a petition to
/// review a judgment of a United States court of appeals "is timely when
/// it is filed with the Clerk of this Court within 90 days after entry of
/// the judgment"; after a timely petition for rehearing below it runs from
/// the denial of rehearing (Rule 13.3), so from the latest entry. In a
/// civil case the limit is jurisdictional: "The Clerk will not file any
/// petition for a writ of certiorari that is jurisdictionally out of time.
/// See, e. g., 28 U. S. C. § 2101(c)" (Rule 13.2). Its only extension is a
/// Justice's, for good cause, "for a period not exceeding 60 days", on an
/// application filed "at least 10 days before the date the petition is
/// due, except in extraordinary circumstances" (Rule 13.5, 30.2); "Once
/// denied, such an application may not be renewed" (Rule 30.3).
deadline petition-period: 90.days after LowerCourtEntry() counted_by sup-ct-30 effective [2005-05-02, 2007-10-01) known_at 2005-03-14 cite "Sup. Ct. R. (2005) 13.1"
{
  trigger latest
  characterization jurisdictional cite "Sup. Ct. R. (2005) 13.2"
  extend {
    by justice
    discretion GoodCause
    max 60.days
    on PetitionExtensionApplied()
    within current_due - 10.days
    unless PetitionExtensionDenied()
  }
  extend {
    by justice
    discretion ExtraordinaryCircumstances
    max 60.days
    on PetitionExtensionApplied()
    within current_due
    unless PetitionExtensionDenied()
  }
}

/// The Rules effective October 1, 2007 restate Rules 13.1, 13.2, 13.3 and
/// 13.5 word for word.
deadline petition-period: 90.days after LowerCourtEntry() counted_by sup-ct-30 effective [2007-10-01, 2010-02-16) known_at 2007-07-17 supersedes petition-period@2005-05-02 cite "Sup. Ct. R. (2007) 13.1"
{
  trigger latest
  characterization jurisdictional cite "Sup. Ct. R. (2007) 13.2"
  extend {
    by justice
    discretion GoodCause
    max 60.days
    on PetitionExtensionApplied()
    within current_due - 10.days
    unless PetitionExtensionDenied()
  }
  extend {
    by justice
    discretion ExtraordinaryCircumstances
    max 60.days
    on PetitionExtensionApplied()
    within current_due
    unless PetitionExtensionDenied()
  }
}

/// The Rules effective February 16, 2010 restate Rules 13.1, 13.2, 13.3
/// and 13.5 word for word.
deadline petition-period: 90.days after LowerCourtEntry() counted_by sup-ct-30 effective [2010-02-16, 2013-07-01) known_at 2010-01-12 supersedes petition-period@2007-10-01 cite "Sup. Ct. R. (2010) 13.1"
{
  trigger latest
  characterization jurisdictional cite "Sup. Ct. R. (2010) 13.2"
  extend {
    by justice
    discretion GoodCause
    max 60.days
    on PetitionExtensionApplied()
    within current_due - 10.days
    unless PetitionExtensionDenied()
  }
  extend {
    by justice
    discretion ExtraordinaryCircumstances
    max 60.days
    on PetitionExtensionApplied()
    within current_due
    unless PetitionExtensionDenied()
  }
}

/// The Rules effective July 1, 2013 restate Rules 13.1, 13.2 and 13.3 word
/// for word; Rule 13.5 adds that an extension applies "solely to the party
/// or parties named in the application".
deadline petition-period: 90.days after LowerCourtEntry() counted_by sup-ct-30 effective [2013-07-01, ..) known_at 2013-04-19 supersedes petition-period@2010-02-16 cite "Sup. Ct. R. (2013) 13.1"
{
  trigger latest
  characterization jurisdictional cite "Sup. Ct. R. (2013) 13.2"
  extend {
    by justice
    discretion GoodCause
    max 60.days
    on PetitionExtensionApplied()
    within current_due - 10.days
    unless PetitionExtensionDenied()
  }
  extend {
    by justice
    discretion ExtraordinaryCircumstances
    max 60.days
    on PetitionExtensionApplied()
    within current_due
    unless PetitionExtensionDenied()
  }
}

decision judgment-below: "Judgment of the court of appeals entered: petition for certiorari?" by petitioner effective [2005-05-02, ..) known_at 2005-03-14 cite "Sup. Ct. R. (2005) 13.1"
{
  petition "File the petition for a writ of certiorari" -> petition-filed {
    event PetitionFiled()
    within petition-period
  }
  forgo "File no petition" -> judgment-stands
}

terminal petition-filed: "Petition for a writ of certiorari filed" effective [2005-05-02, ..) known_at 2005-03-14
terminal judgment-stands: "The judgment of the court of appeals stands" effective [2005-05-02, ..) known_at 2005-03-14
