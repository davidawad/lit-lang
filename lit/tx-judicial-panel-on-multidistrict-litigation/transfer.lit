module tx-judicial-panel-on-multidistrict-litigation.transfer

import tx-state-rules.{ ActionCommenced, DecisionFiled }

// A motion to the Texas Judicial Panel on Multidistrict Litigation to
// transfer related cases involving common questions of fact to a pretrial
// court, from the movant's side, as structure only. Rule 13 of the Rules
// of Judicial Administration and the Government Code provisions creating
// the panel are not vendored, so each of the panel's cites is a hole
// naming the text it needs and no period, form or standard is stated. No
// leading decision was named; none is kept.
start request

state request: "Motion to transfer filed" by applicant cite ?("Tex. R. Jud. Admin. 13.3 (not vendored)") {
  note "Who may move, the form of the motion and the response periods are stated in Rule 13 of the Rules of Judicial Administration, which is not vendored; they stay holes. Pretrial proceedings in multidistrict litigation may also be governed by Rules 11 and 13 of the Rules of Judicial Administration (Tex. R. Civ. P. 166)."
  edge-request-decision "Submitted for decision" -> decision {
    event ActionCommenced()
    authority cite "Tex. R. Civ. P. 166"
  }
}

decision decision: "Panel decides" by court cite ?("Tex. Gov't Code § 74.162 (not vendored)") {
  note "The panel's standard for transfer and the effect of its order are stated in text that is not vendored; they stay holes."
  edge-decision-granted "Transfer ordered" -> granted {
    event DecisionFiled()
    authority cite ?("Tex. Gov't Code § 74.162 (not vendored)")
  }
  edge-decision-denied "Transfer denied" -> denied {
    event DecisionFiled()
    authority cite ?("Tex. Gov't Code § 74.162 (not vendored)")
  }
}

terminal granted: "Transfer to a pretrial court ordered" outcome [win] cite ?("Tex. Gov't Code § 74.162 (not vendored)") {
  note "Pretrial proceedings in the pretrial court may be governed by Rules 11 and 13 of the Rules of Judicial Administration (Tex. R. Civ. P. 166), which are not vendored."
}

terminal denied: "Transfer denied" outcome [loss] cite ?("Tex. Gov't Code § 74.162 (not vendored)") {
  note "Whether and how the panel's order may be reviewed is stated in text that is not vendored; it stays a hole."
}
