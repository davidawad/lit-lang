module mo-supreme-court-civil.review

// Review in the Supreme Court of Missouri of a Court of Appeals civil
// decision, from the applicant's view of outcomes.
// The Missouri Supreme Court Rules are not vendored: courts.mo.gov answered
// HTTP 403 to every fetch (sources/mo-criminal-trial-court/PROVENANCE.md),
// tracked as lg-3sut (#15). Every cite is therefore a hole naming that
// issue, its rule number carried from the outline unverified, and no
// period, count, limit, probability or payoff is stated: each is a hole
// until the rule text is vendored and read.

import mo-state-rules.{ DecisionFiled, MandateIssued, ReviewPetitionFiled }

start petition

decision petition: "Petition for discretionary review?" by applicant cite ?("Mo. Sup. Ct. R. 83.04; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
{
  note "Review in the Supreme Court of Missouri of an intermediate appellate decision: the petition period, form, length and grounds are holes. Direct appeals and original proceedings, where the state allows them, are not modeled. Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  edge-petition-none "No petition: the intermediate decision stands" -> review-not-sought { authority cite ?("Mo. Sup. Ct. R. 84.22-84.24; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)") }
  edge-petition-filed "Petition filed" -> review-decision { event ReviewPetitionFiled() authority cite ?("Mo. Sup. Ct. R. 83.04; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)") }
}

chance review-decision: "Court grants or denies review" by court cite ?("Mo. Sup. Ct. R. 83.04; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
{
  note "Review is discretionary; the grant probability is a hole. Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  edge-review-denied "Review denied" -> review-denied p ? { }
  edge-review-granted "Review granted" -> briefing p ? { }
}

state briefing: "Merits briefs filed" by applicant cite ?("Mo. Sup. Ct. R. 84.04, 84.06; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
{
  note "Merits briefing periods, form and length limits are holes. Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  edge-briefing-argument "Argument or submission" -> argument { authority cite ?("Mo. Sup. Ct. R. 84.16; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)") }
}

state argument: "Argument or submission" by court cite ?("Mo. Sup. Ct. R. 84.16; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
{
  note "Whether argument is heard is a hole. Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  edge-argument-decision "Decision issued" -> decision { authority cite ?("Mo. Sup. Ct. R. 84.14; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)") }
}

chance decision: "Court decides" by court cite ?("Mo. Sup. Ct. R. 84.14; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
{
  note "Outcome probabilities are holes. Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  edge-decision-affirmed "Affirmed" -> rehearing p ? { event DecisionFiled() }
  edge-decision-reversed "Reversed, vacated or remanded" -> rehearing p ? { event DecisionFiled() }
}

decision rehearing: "Rehearing or reconsideration sought?" by applicant cite ?("Mo. Sup. Ct. R. 84.17; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
{
  note "Rehearing period and grounds are holes. Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  edge-rehearing-none "No rehearing" -> mandate-issued { event MandateIssued() authority cite ?("Mo. Sup. Ct. R. 84.22-84.24; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)") }
  edge-rehearing-sought "Rehearing sought" -> rehearing-decision { authority cite ?("Mo. Sup. Ct. R. 84.17; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)") }
}

chance rehearing-decision: "Rehearing decided" by court cite ?("Mo. Sup. Ct. R. 84.17; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
{
  note "Rehearing is rarely granted; the probability is a hole. Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  edge-rehearing-denied "Rehearing denied" -> mandate-issued p ? { event MandateIssued() authority cite ?("Mo. Sup. Ct. R. 84.22-84.24; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)") }
  edge-rehearing-granted "Rehearing granted" -> rehearing-granted p ? { }
}

terminal review-not-sought: "Review not sought: intermediate decision final" outcome [final] cite ?("Mo. Sup. Ct. R. 84.22-84.24; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
{
  note "The intermediate court's mandate issues; costs are holes. Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  payoff ?
}

terminal review-denied: "Review denied" outcome [final, loss] cite ?("Mo. Sup. Ct. R. 83.04; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
{
  note "Denial leaves the intermediate decision in place. Federal certiorari (28 U.S.C. § 1257) is outside this package. Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  payoff ?
}

terminal mandate-issued: "Mandate or remittitur issued" outcome [final] cite ?("Mo. Sup. Ct. R. 84.22-84.24; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
{
  note "The case returns to the court below; costs are holes. Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  payoff ?
}

terminal rehearing-granted: "Rehearing granted" outcome [final] cite ?("Mo. Sup. Ct. R. 84.17; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
{
  note "Proceedings on rehearing are outside this package. Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  payoff ?
}
