/// E.D. Okla. LBR 7016-1(A): fourteen days prior to the pretrial
/// conference, counsel exchange final witness and exhibit lists and copies
/// of all exhibits (LBR 7016-1(B)).
deadline final-lists-period: 14.days before PretrialConference() counted_by frcp6 cite ?("E.D. Okla. LBR 7016-1(A), undated printable rules 'effective as of December 1, 2009' as later amended: CURRENCY UNCONFIRMED (no edition date on the document or the court's page); the value is the vendored text, unverified")
{
  forum frcp
}

/// E.D. Okla. LBR 7016-1(B): seven days prior to trial, counsel provide two
/// sets of exhibits to the judge.
deadline judge-exhibits-period: 7.days before TrialDate() counted_by frcp6 cite ?("E.D. Okla. LBR 7016-1(B), undated printable rules 'effective as of December 1, 2009' as later amended: CURRENCY UNCONFIRMED (no edition date on the document or the court's page); the value is the vendored text, unverified")
{
  forum frcp
}

/// E.D. Okla. LBR 7016-1(C): seven days prior to the pretrial conference,
/// counsel submit a pretrial order under LBR 9072-1; a motion to continue
/// the pretrial conference is due by the same day (LBR 7016-1(F)).
deadline pretrial-order-period: 7.days before PretrialConference() counted_by frcp6 cite ?("E.D. Okla. LBR 7016-1(C), undated printable rules 'effective as of December 1, 2009' as later amended: CURRENCY UNCONFIRMED (no edition date on the document or the court's page); the value is the vendored text, unverified")
{
  forum frcp
}

/// E.D. Okla. LBR 7056-1(B): a response brief to a motion for summary
/// judgment is filed within fourteen days after the filing of the brief in
/// support.
deadline summary-judgment-response-period: 14.days after SummaryJudgmentBriefFiled() counted_by frcp6 cite ?("E.D. Okla. LBR 7056-1(B), undated printable rules 'effective as of December 1, 2009' as later amended: CURRENCY UNCONFIRMED (no edition date on the document or the court's page); the value is the vendored text, unverified")
{
  forum frcp
}

/// E.D. Okla. LBR 7056-1(C): the movant may file a reply brief addressing
/// only new matters within fourteen days after the response brief was
/// filed.
deadline summary-judgment-reply-period: 14.days after SummaryJudgmentResponseFiled() counted_by frcp6 cite ?("E.D. Okla. LBR 7056-1(C), undated printable rules 'effective as of December 1, 2009' as later amended: CURRENCY UNCONFIRMED (no edition date on the document or the court's page); the value is the vendored text, unverified")
{
  forum frcp
}

/// E.D. Okla. LBR 9006-1(C): applications for continuances of hearings are
/// in writing and filed at least three days prior to the date set for the
/// hearing.
deadline continuance-application-period: 3.days before HearingDate() counted_by frcp6 cite ?("E.D. Okla. LBR 9006-1(C), undated printable rules 'effective as of December 1, 2009' as later amended: CURRENCY UNCONFIRMED (no edition date on the document or the court's page); the value is the vendored text, unverified")
{
  forum frcp
}

/// E.D. Okla. LBR 9013-1: the objection date certain the court sets on its
/// website is fourteen days from entry of the motion on the docket,
/// including three days for service by mail, unless a statute, rule or
/// order prescribes otherwise.
deadline motion-objection-period: 14.days after MotionDocketed() counted_by frcp6 cite ?("E.D. Okla. LBR 9013-1, undated printable rules 'effective as of December 1, 2009' as later amended: CURRENCY UNCONFIRMED (no edition date on the document or the court's page); the value is the vendored text, unverified")
{
  forum frcp
}

/// E.D. Okla. LBR 9015-1(G): settlement or other disposition other than by
/// trial is given to the clerk in writing not less than three days prior to
/// the jury trial setting, or jury costs may be assessed.
deadline jury-settlement-notice-period: 3.days before JuryTrialSetting() counted_by frcp6 cite ?("E.D. Okla. LBR 9015-1(G), undated printable rules 'effective as of December 1, 2009' as later amended: CURRENCY UNCONFIRMED (no edition date on the document or the court's page); the value is the vendored text, unverified")
{
  forum frcp
}

/// E.D. Okla. LBR 9017-1: unless otherwise ordered, seven days prior to an
/// evidentiary hearing each counsel exchanges and files witness lists and
/// exhibit lists (LBR 9017-2(A)).
deadline witness-exhibit-list-period: 7.days before EvidentiaryHearing() counted_by frcp6 cite ?("E.D. Okla. LBR 9017-1, undated printable rules 'effective as of December 1, 2009' as later amended: CURRENCY UNCONFIRMED (no edition date on the document or the court's page); the value is the vendored text, unverified")
{
  forum frcp
}

/// E.D. Okla. LBR 9019-1: once a compromise is approved, the parties file
/// the appropriate pleadings in the related adversary proceeding within
/// fourteen days from its entry in the bankruptcy case.
deadline settlement-pleadings-period: 14.days after CompromiseApproved() counted_by frcp6 cite ?("E.D. Okla. LBR 9019-1, undated printable rules 'effective as of December 1, 2009' as later amended: CURRENCY UNCONFIRMED (no edition date on the document or the court's page); the value is the vendored text, unverified")
{
  forum frcp
}

/// E.D. Okla. LBR 9019-2: a governmental entity unable to send a
/// representative with full authority delivers (not files) its motion for
/// leave to the settlement judge not later than eleven days prior to the
/// settlement conference.
deadline limited-authority-motion-period: 11.days before SettlementConference() counted_by frcp6 cite ?("E.D. Okla. LBR 9019-2, undated printable rules 'effective as of December 1, 2009' as later amended: CURRENCY UNCONFIRMED (no edition date on the document or the court's page); the value is the vendored text, unverified")
