module as-high-court-appellate.appeal

import as-state-rules.{ DecisionFiled, MandateIssued, NoticeOfAppealFiled, RecordFiled }

start notice-filed

state notice-filed: "Notice of appeal filed" by applicant cite "A.C.R. 3(a)"
{
  note "An appeal permitted by law as of right from the trial division, the land and titles division or the district court is taken by filing a notice of appeal with the clerk of court within the time allowed by Rule 4 (A.C.R. 3(a)). In a civil case a motion for a new trial, required by 43.0802 A.S.C.A. (not vendored), is filed within 10 days after entry of the judgment or order appealed from, and the notice of appeal within 10 days after the motion is denied; a timely Rule 52(b) motion to amend findings runs the time from the order disposing of it (A.C.R. 4(a)). The rule text is the American Samoa Bar Association's posting, UNOFFICIAL and CURRENCY UNCONFIRMED (sources/as-high-court-appellate/PROVENANCE.md). Periods are stated, not counted: Rule 26(a) excludes the trigger day, includes the last day unless it is a Saturday, Sunday or legal holiday, and excludes intermediate Saturdays, Sundays and legal holidays from a period of less than 7 days; 6 days are added after service by mail (A.C.R. 26(a), (c)). The filing fee is set by 26 HCR, which is not vendored (A.C.R. 3(e))."
  edge-notice-filed-timely "Timely notice" -> appealability {
    event NoticeOfAppealFiled()
    authority cite "A.C.R. 4(a)"
  }
  edge-notice-filed-untimely "Late notice: motion to dismiss" -> dismissed-untimely {
    authority cite "A.C.R. 4(a)"
  }
}

terminal dismissed-untimely: "Appeal fails: notice untimely" outcome [loss, dismissal] cite "A.C.R. 4(a)"
{
  note "If a timely notice of appeal is not filed by a party, any other party may move to dismiss the appeal, and the appellate division or a single judge may determine the motion (A.C.R. 4(a)). The earlier outline named no leading decision on timeliness."
}

decision appealability: "Appeal permitted by law as of right?" by court cite "A.C.R. 3(a)"
{
  note "The rules govern appeals permitted by law as of right (A.C.R. 1, 3(a)); the statute that permits them is not vendored. Failure to take any step other than the timely filing of the notice does not affect the validity of the appeal but is ground for such action as the appellate division deems appropriate, which may include dismissal (A.C.R. 3(a)). Review where no appeal is allowed or the remedy by appeal is inadequate is by extraordinary writ under Rules 87 to 102 TCRCP (A.C.R. 21). The earlier outline named no leading decision."
  edge-appealability-not "Not appealable" -> dismissed-jurisdiction { authority cite "A.C.R. 3(a)" }
  edge-appealability-yes "Appealable" -> record { authority cite "A.C.R. 3(a)" }
}

terminal dismissed-jurisdiction: "Dismissed: no appeal of right" outcome [loss, dismissal] cite "A.C.R. 3(a)"

state record: "Record and transcript" by applicant cite "A.C.R. 10(b)"
{
  note "The notice of appeal requests an estimate of the transcript; the appellant has 5 days from filing the notice to request the estimate from the court reporters, and if no request is made or no transcript will be ordered, the appellant's brief is due 35 days from the filing of the notice of appeal (A.C.R. 3(c)). Within 10 days after receiving the estimate the appellant orders the needed transcript in writing, or certifies that none is ordered, and unless the entire transcript is ordered files a statement of the issues; the appellee may designate additional parts within 10 days after service (A.C.R. 10(b)). If the transcript cannot be completed within 30 days of the order the reporter requests an extension from the clerk (A.C.R. 11(b)). On assembly the clerk files the record and notifies the parties of the filing date (A.C.R. 12(b))."
  edge-record-filed "Record filed" -> briefing {
    event RecordFiled()
    authority cite "A.C.R. 12(b)"
  }
}

state briefing: "Briefing" by applicant cite "A.C.R. 31(a)"
{
  note "The appellant serves and files a brief within 40 days after the record is filed; the appellee within 30 days after service of the appellant's brief; a reply brief may follow within 14 days after service of the appellee's brief and, except for good cause, at least 3 days before argument (A.C.R. 31(a)). Except by permission, principal briefs may not exceed 50 pages and reply briefs 25 pages, exclusive of tables and addenda (A.C.R. 28(g))."
  edge-briefing-complete "Briefing complete" -> argument { authority cite "A.C.R. 31(a)" }
}

decision argument: "Oral argument or submission on the briefs" by court cite "A.C.R. 34(a)"
{
  note "Oral argument is allowed unless the appellate division, after examining the briefs and record, is unanimously of the opinion that it is not needed because the appeal is frivolous, the dispositive issue has recently been authoritatively decided, or the briefs and record adequately present the case (A.C.R. 34(a)). By agreement a case may be submitted on the briefs (A.C.R. 34(f))."
  edge-argument-decided "Argued or submitted" -> decision-issued { authority cite "A.C.R. 34(a)" }
}

decision decision-issued: "Decision and entry of judgment" by court cite "A.C.R. 36"
{
  note "The notation of a judgment in the docket is its entry; the clerk enters it on receipt of the opinion and on that date mails or places in the attorney's court box a copy of the opinion or judgment and notice of the date of entry (A.C.R. 36). A frivolous appeal may draw just damages and single or double costs (A.C.R. 38); a bill of costs is filed within 14 days after entry of judgment, objections within 10 days of its service (A.C.R. 39(d))."
  edge-decision-issued-entered "Judgment entered" -> rehearing-window {
    event DecisionFiled()
    authority cite "A.C.R. 36"
  }
}

decision rehearing-window: "Petition for rehearing?" by applicant cite "A.C.R. 40(a)"
{
  note "A petition for rehearing is filed within 14 days after entry of judgment unless the time is shortened or enlarged by order, stating with particularity the points overlooked or misapprehended; no oral argument and no answer unless requested (A.C.R. 40(a)). Except by permission it may not exceed 15 pages (A.C.R. 40(b))."
  edge-rehearing-window-none "No petition" -> mandate-issued { authority cite "A.C.R. 41(a)" }
  edge-rehearing-window-petition "Petition filed" -> rehearing-ruling {
    authority cite "A.C.R. 40(a)"
  }
}

decision rehearing-ruling: "Rehearing decided" by court cite "A.C.R. 40(a)"
{
  note "If rehearing is granted the appellate division may dispose of the cause without reargument, restore it to the calendar for reargument or resubmission, or make other appropriate orders (A.C.R. 40(a)). If the mandate was stayed to consider the petition and the petition is denied, the mandate issues 7 days after entry of the order denying it unless the time is shortened or enlarged by order (A.C.R. 41(a))."
  edge-rehearing-ruling-denied "Denied" -> mandate-issued { authority cite "A.C.R. 41(a)" }
  edge-rehearing-ruling-granted "Granted" -> rehearing-granted { authority cite "A.C.R. 40(a)" }
}

terminal rehearing-granted: "Rehearing granted: the case is redecided or reargued" outcome [appeal] cite "A.C.R. 40(a)"

state mandate-issued: "Mandate issued" by court cite "A.C.R. 41(a)"
{
  note "The mandate issues 21 days after entry of judgment unless the time is shortened or enlarged by order; a timely petition for rehearing does not stay it unless the appellate division orders otherwise (A.C.R. 41(a))."
  edge-mandate-issued-final "Mandate issued" -> final-appellate {
    event MandateIssued()
    authority cite "A.C.R. 41(a)"
  }
}

terminal final-appellate: "Mandate issued: appeal concluded" outcome [final] cite "A.C.R. 41(a)"
{
  note "The vendored rules provide no further review of an Appellate Division judgment, and no federal court has appellate jurisdiction over the Appellate Division (28 U.S.C. § 1259 is certiorari to the Court of Appeals for the Armed Forces). Further review, if any, is Secretarial review by the Secretary of the Interior under 48 U.S.C. § 1661(c) and Exec. Order No. 10264 (see Corp. of Presiding Bishop v. Hodel, 830 F.2d 374 (D.C. Cir. 1987)); that text is not vendored, so its procedure, period and grounds are not modeled here."
}
