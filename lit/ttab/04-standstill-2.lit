// Imported by `litigate import` from packs/ttab-trademark-trial-and-appeal-board.json.
module ttab.standstill-2

import ttab.lapse.{ period-lapsed }
import ttab.opposition-to-trial.{ opposition-filed }
import ttab.{ standstill }

/// imported
decision opposer-d180: "Standstill expired without a deal: the opposer must oppose by day 180 or lose the right to oppose" effective [2026-10-19, ..) by opposer cite 37 CFR 2.102(c)(3)
{
  group standstill
  tags [opponent-decision]
  _ "Opposer files notice of opposition by day 180" -> opposition-filed {
    authority cite ?("37 CFR 2.101(c), 2.102(c)(3)")
    deadline 180.days { extendable false }
    tags [file-opposition]
    attrs { opp_fees: 600, opp_hours: 14 }
  }
  _ "Opposer lets the opposition period lapse" -> period-lapsed {
    authority cite 37 CFR 2.101(c); 15 USC 1063(b)
    tags [lapse]
  }
}
