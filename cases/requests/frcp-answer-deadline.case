// litigate run cases/requests/frcp-answer-deadline.case --op '{"op":"deadlines","trigger":"2026-01-05","node":"service-completed"}'
case frcp-answer-deadline
uses frcp-civil-procedure ^2024.12.0
as_of 2026-09-28
summary "The FRCP deadlines that start when service is completed on 2026-01-05."
notes "Ported from examples/frcp-answer-deadline.json: no matter facts, only the package's own deadlines counted from service under FRCP 6."

// The post-dismissal remedies (`lit/frcp`, after litgraph-final) carry no
// payoff of their own; as in cases/frcp-civil-case.case, they are worth
// nothing here.
stakes {
  frcp-civil-procedure::rule41d-costs-ordered: 0.usd
  frcp-civil-procedure::refiling-proceeds: 0.usd
  frcp-civil-procedure::dismissal-fees-eligible: 0.usd
  frcp-civil-procedure::dismissal-fees-ineligible: 0.usd
}
