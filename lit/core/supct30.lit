module core.supct30

import core.calendar.{ us-federal-holidays }
import core.time.{ Served, ServiceMethod }

/// Sup. Ct. R. 29.1 (Rules adopted April 14, 1980, effective June 30,
/// 1980): the day of the act is excluded and the last day included
/// "unless it is a Sunday or a federal legal holiday", when the period
/// "runs until the end of the next day which is neither a Sunday nor a
/// federal legal holiday". A Saturday last day stands. Rule 28.3 serves
/// "personally or by mail" and Rule 29 adds nothing for either; a
/// commercial carrier is no manner of service. UNVERIFIED: whether a
/// holiday falling on a Saturday, observed on the Friday, is itself "a
/// federal legal holiday" that rolls a Saturday last day; the calendar
/// closes the day it observes.
counting sup-ct-30 effective [1980-06-30, 1990-01-01) known_at 1980-04-14 cite "Sup. Ct. R. (1980) 29.1"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [sunday, legal_holiday]
  service_extension {
    Personal: 0.days
    Electronic: unrecognized
    Mail: 0.days
    Clerk: unrecognized
    OtherConsented: unrecognized
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "Sup. Ct. R. (1980) 28.3"
  holidays us-federal-holidays
  forums [scotus]
}

/// Sup. Ct. R. 30.1 (Rules adopted December 5, 1989, effective January 1,
/// 1990): Saturdays join Sundays, federal legal holidays ("See 5 U. S. C.
/// § 6103") and days the Court building is closed by order. Rule 29.3
/// serves "personally or by mail" and adds no time.
counting sup-ct-30 effective [1990-01-01, 1995-10-02) known_at 1989-12-05 supersedes sup-ct-30@1980-06-30 cite "Sup. Ct. R. (1990) 30.1"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday]
  service_extension {
    Personal: 0.days
    Electronic: unrecognized
    Mail: 0.days
    Clerk: unrecognized
    OtherConsented: unrecognized
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "Sup. Ct. R. (1990) 29.3"
  holidays us-federal-holidays
  forums [scotus]
}

