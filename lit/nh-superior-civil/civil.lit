module nh-superior-court-civil.civil

import nh-state-rules.{ ActionCommenced, JudgmentEntered, NoticeOfAppealFiled }

/// A motion for reconsideration or other post-decision relief: at most 10
/// pages (N.H. Super. Ct. R. 12(e)).
limit reconsideration-motion {
  pages <= 10 cite "N.H. Super. Ct. R. 12(e)"
} cite "N.H. Super. Ct. R. 12(e)"

start commenced

state commenced: "Complaint filed" by applicant cite "N.H. Super. Ct. R. 4(b)"
{
  note "A civil action is initiated by filing the Complaint, an Appearance and either the filing fee or a motion to waive it, and is deemed commenced for the statute of limitations on the date the Complaint is filed (N.H. Super. Ct. R. 4(b)). The fee for the original entry of an action at law or equity is $285.00 (N.H. Super. Ct. R. 201). The court issues a Summons stating the court-ordered deadline for service; proof of service is filed within 21 days of that deadline, and a defendant not served by it is dismissed with or without prejudice (N.H. Super. Ct. R. 4(c)). Periods in this package are stated, not counted: computation is N.H. Super. Ct. R. 2, which excludes the day of the triggering act and carries a last day that falls on a Saturday, Sunday or legal holiday under RSA ch. 288 to the next day that is none of them."
  edge-commenced-served "Defendant served" -> answer-due {
    event ActionCommenced()
    authority cite "N.H. Super. Ct. R. 9(a)"
  }
  edge-commenced-unserved "Not served by the court-ordered deadline" -> dismissed-unserved {
    authority cite "N.H. Super. Ct. R. 4(c)"
  }
}

terminal dismissed-unserved: "Dismissed for want of service" outcome [loss, dismissal] cite "N.H. Super. Ct. R. 4(c)"
{
  note "The court dismisses the action with or without prejudice, as justice may require (N.H. Super. Ct. R. 4(c))."
}

decision answer-due: "Answer, motion to dismiss or default" by office cite "N.H. Super. Ct. R. 9(a)"
{
  note "Appearances and Answers are due within 30 days of the date the defendant is served with the Summons and Complaint (N.H. Super. Ct. R. 4(e), 9(a)). Instead of an Answer the defendant may, within the same 30 days, file a Motion to Dismiss (N.H. Super. Ct. R. 9(b)). Affirmative defenses not pleaded or raised by motion within that time are waived (N.H. Super. Ct. R. 9(d)); a challenge to personal jurisdiction, process or service of process is waived unless made by a Motion to Dismiss filed within 30 days after service (N.H. Super. Ct. R. 9(e)). A defendant demands a jury on the first page of the Answer (N.H. Super. Ct. R. 9(c)). No leading decision is named."
  edge-answer-due-default "No timely Answer" -> default-entered {
    authority cite "N.H. Super. Ct. R. 42(a)"
  }
  edge-answer-due-motion "Motion to Dismiss filed" -> pleading-motion {
    authority cite "N.H. Super. Ct. R. 9(b)"
  }
  edge-answer-due-answer "Answer filed" -> scheduling { authority cite "N.H. Super. Ct. R. 5(a)" }
}

decision pleading-motion: "Motion to dismiss decided" by court cite "N.H. Super. Ct. R. 9(b)"
{
  note "A non-moving party may object within 10 days after the motion is filed unless a court order sets another deadline (N.H. Super. Ct. R. 13(a)); any party may reply within 10 days of the filing of an objection, and surreplies need the court's permission (N.H. Super. Ct. R. 13A). Oral argument is held only on a request filed within 10 days after the motion (N.H. Super. Ct. R. 13(b)). If the motion is denied, the Answer is due within 30 days after the date on the Notice of the Decision finally denying it (N.H. Super. Ct. R. 9(b)); a denied jurisdiction, process or service challenge is waived unless review is sought in the supreme court within 30 days of the clerk's final written notice (N.H. Super. Ct. R. 9(e), 46(b))."
  edge-pleading-motion-dismissed "Granted" -> dismissed-pleading {
    authority cite "N.H. Super. Ct. R. 9(b)"
  }
  edge-pleading-motion-denied "Denied: Answer within 30 days after notice" -> scheduling {
    authority cite "N.H. Super. Ct. R. 9(b)"
  }
}

terminal default-entered: "Default entered" outcome [loss] cite "N.H. Super. Ct. R. 42(a)"
{
  note "A party that fails to timely Answer or otherwise defend is defaulted; the default is struck only by agreement or on motion and affidavit of defense (N.H. Super. Ct. R. 42(a)). Final default and judgment on the non-defaulting party's motion with an affidavit of damages or proposed decree (N.H. Super. Ct. R. 42(b)-(e)) are not modeled. Outcome from the defending side."
}

terminal dismissed-pleading: "Dismissed on the motion" outcome [win, dismissal] cite "N.H. Super. Ct. R. 9(b)"

state scheduling: "Case structuring" by court cite "N.H. Super. Ct. R. 5(a)"
{
  note "Within 20 days of the Answer date the parties confer on the trial date, discovery and expert deadlines, ADR and motion deadlines, with dispositive motions due not less than 120 days before trial and other pretrial motions not later than 14 days before trial, and file an agreed stipulation within those 20 days (N.H. Super. Ct. R. 5(a)-(b)). Without agreement a case structuring conference is held no later than 75 days after the Answer is filed (N.H. Super. Ct. R. 5(c))."
  edge-scheduling-discovery "Case structuring order issued" -> discovery {
    authority cite "N.H. Super. Ct. R. 5(d)"
  }
}

state discovery: "Discovery" by applicant cite "N.H. Super. Ct. R. 21"
{
  note "Automatic disclosures are due from the plaintiff not later than 30 days, and from the defendant not later than 60 days, after the defendant files its Answer (N.H. Super. Ct. R. 22). Interrogatories are answered within 30 days after service (N.H. Super. Ct. R. 23(i)); document requests within 30 days after service (N.H. Super. Ct. R. 24); requests for admission are deemed admitted unless answered within 30 days after service (N.H. Super. Ct. R. 28). Discovery ordered by the court is provided within 10 days of the order unless the court directs otherwise (N.H. Super. Ct. R. 29(f))."
  edge-discovery-sj "Summary judgment motion filed" -> sj-motion {
    authority cite "N.H. Super. Ct. R. 12(g)"
  }
  edge-discovery-trial "No dispositive motion" -> trial {
    authority cite "N.H. Super. Ct. R. 35(a)"
  }
  edge-discovery-settle "Case settled" -> settled { authority cite "N.H. Super. Ct. R. 39(a)" }
}

decision sj-motion: "Summary judgment decided" by court cite "N.H. Super. Ct. R. 12(g)"
{
  note "Summary judgment motions are filed, defended and disposed of under RSA 491:8-a; without advance permission the motion and memorandum together, and the objection and memorandum together, may not exceed 25 double-spaced pages (N.H. Super. Ct. R. 12(g)(1)). The motion carries a separate statement of material facts; the nonmoving party has 30 days after the motion is filed to object, and facts not controverted are deemed admitted; the moving party replies to additional facts within 20 days (N.H. Super. Ct. R. 12(g)(2)-(3)). No leading decision is named."
  edge-sj-motion-granted "Granted" -> judgment-for-movant {
    event JudgmentEntered()
    authority cite "N.H. Super. Ct. R. 12(g)"
  }
  edge-sj-motion-denied "Denied or partly denied" -> trial {
    authority cite "N.H. Super. Ct. R. 12(g)"
  }
}

terminal judgment-for-movant: "Judgment for the movant" outcome [win, judgment] cite "N.H. Super. Ct. R. 12(g)"
{
  note "Partial summary judgment on liability (N.H. Super. Ct. R. 12(g)(7)) is not modeled."
}

state trial: "Trial" by court cite "N.H. Super. Ct. R. 35(a)"
{
  note "In a case scheduled for jury trial the trial management conference takes place within 14 days before jury selection unless the court orders otherwise, and pretrial statements are filed and served 14 days before that conference (N.H. Super. Ct. R. 35(a)-(b)). A plaintiff demands a jury on the first page of the Complaint, and failure to do so waives it (N.H. Super. Ct. R. 8(c))."
  edge-trial-post "Verdict or decree" -> post-trial { authority cite "N.H. Super. Ct. R. 43" }
}

decision post-trial: "Post-trial motions decided" by court cite "N.H. Super. Ct. R. 43"
{
  note "A motion to set aside a jury verdict is filed within 10 days after its rendition, and a motion to set aside any other verdict or decree within 10 days from the date on the court's written notice (N.H. Super. Ct. R. 43). A motion for reconsideration or other post-decision relief is filed within 10 days of the date on the written Notice of the order or decision and may not exceed 10 pages; no objection is required unless ordered (N.H. Super. Ct. R. 12(e))."
  edge-post-trial-judgment "Motions resolved or none filed" -> judgment-entered {
    event JudgmentEntered()
    authority cite "N.H. Super. Ct. R. 46(d)"
  }
}

state judgment-entered: "Final judgment" by office cite "N.H. Super. Ct. R. 46(d)"
{
  note "Unless a notice of appeal has been filed with the supreme court, final judgment is entered on the 31st day from the date on the court's written notice of the verdict or decree, or, after a timely post-verdict motion, of the court's action on the motion (N.H. Super. Ct. R. 46(d)). A party aggrieved by an order on costs may appeal within 30 days from the date of notice of the order (N.H. Super. Ct. R. 45(a))."
  edge-judgment-entered-appeal "Next step" -> appeal-decision {
    authority cite "N.H. Sup. Ct. R. 7"
  }
}

decision appeal-decision: "Notice of appeal within 30 days of the clerk's notice?" by applicant cite "N.H. Sup. Ct. R. 7"
{
  note "A mandatory appeal, and any other appeal from a decision on the merits, is filed within 30 days from the date on the clerk's written notice of the decision on the merits; a timely post-decision motion stays the appeal period (N.H. Sup. Ct. R. 7(1)). The superior court grants no extension of time to file an appeal document in the supreme court (N.H. Super. Ct. R. 46(e))."
  edge-appeal-decision-taken "Notice filed" -> appeal-taken {
    event NoticeOfAppealFiled()
    authority cite "N.H. Sup. Ct. R. 7"
  }
  edge-appeal-decision-none "No notice filed" -> final-no-appeal {
    authority cite "N.H. Super. Ct. R. 46(d)"
  }
}

terminal appeal-taken: "Appeal taken: continue in the New Hampshire appellate package" outcome [appeal] cite "N.H. Sup. Ct. R. 7"
{
  note "Hand-off to lit/nh-supreme (nh-supreme-court-civil-appeals)."
}

terminal final-no-appeal: "Final: no appeal" outcome [final] cite "N.H. Super. Ct. R. 46(d)"

terminal settled: "Settled" outcome [settlement] cite "N.H. Super. Ct. R. 39(a)"
{
  note "When the court is told a case has settled it notifies the parties, and if the agreements or docket markings are not filed within thirty days after that notice the court takes such action as justice may require (N.H. Super. Ct. R. 39(a))."
}
