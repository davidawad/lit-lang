{
  given DiscoveryResponseReceived() on 2026-11-02
  expect deadline(motion-to-compel-period) == 2026-11-23
}

test "motion to compel no response period: 21 days after the trigger" cite "D.S.C. Local Civ. Rule 37.01(A)"
{
  given DiscoveryResponseOverdue() on 2026-11-02
  expect deadline(motion-to-compel-no-response-period) == 2026-11-23
}

test "jury cost notice period: 1 days before the trigger" cite "D.S.C. Local Civ. Rule 54.01"
{
  given TrialDateScheduled() on 2027-02-02
  expect deadline(jury-cost-notice-period) == 2027-02-01
}

