module core.states.massachusetts

import core.calendar.{ us-federal-holidays }

/// The legal holidays of Massachusetts (M.G.L. c. 4, § 7, clause Eighteenth)
/// that `us-federal-holidays` does not already close: Patriots' Day, the third
/// Monday in April. The clause's other days are federal holidays, a Sunday one
/// held the day after as § 6103(b)(1) holds it. FRCP 6(a)(6)(C) and FRBP
/// 9006(a)(6)(C) make it a legal holiday of the District of Massachusetts for a
/// period counted forward only. Closed from the date the vendored text was
/// retrieved (October 29, 2026). Not modeled: Evacuation Day (March 17) and
/// Bunker Hill Day (June 17), holidays "with respect to Suffolk county only" on
/// which the offices there stay open, so a last day on one is the earlier date.
calendar massachusetts-holidays cite "M.G.L. c. 4, § 7"
{
  patriots-day: nth(3, monday, 4) effective [2026-10-29, ..)
}

/// FRCP 6 in the district courts of Massachusetts: the 2023 text
/// (`frcp6@2023-12-01`) with `massachusetts-holidays`, which 6(a)(6)(C)
/// ("any day declared a holiday by ... the state where the district court
/// is located") makes legal holidays "for periods that are measured after
/// an event" only. A district package there names it as its `counting`
/// rule and `recounts` lit/frcp. A calendar day is closed only from the
/// date its entry is in force; before it the count is `frcp6`'s.
counting frcp6-massachusetts effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCP 6(d)"
  holidays us-federal-holidays
  forward_holidays massachusetts-holidays cite "FRCP 6(a)(6)(C)"
  forums [frcp]
  allow_hours
  end_of_month clamp
}

/// FRBP 9006(a) (`frbp9006`) in the bankruptcy courts of Massachusetts:
/// `massachusetts-holidays` are legal holidays for a period counted forward only (FRBP
/// 9006(a)(6)(C), "any day declared a holiday by the state where the
/// district court is located"). A bankruptcy package there names it as its
/// `counting` rule and `recounts` lit/frbp. A calendar day is closed only
/// from the date its entry is in force.
counting frbp9006-massachusetts effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays massachusetts-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-ma]
  allow_hours
  end_of_month clamp
}
