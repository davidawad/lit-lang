{
  given FeeApplicationFiled() on 2026-10-01
  expect deadline(eaja-response-period) == 2026-11-02
}

test "the EAJA reply is due 30 days after the response" cite "CAVC R. 39(a)(2)"
{
  given FeeResponseServed() on 2026-10-01
  expect deadline(eaja-reply-period) == 2026-11-02
}

test "a supplemental application is due 20 days after the grant" cite "CAVC R. 39(b)"
{
  given FeeApplicationGranted() on 2026-10-01
  expect deadline(supplemental-application-period) == 2026-10-21
}

