# Bowles v. Russell (2007) at ca1 (lg-wvlf.4): the same two Supreme Court
# layers as ca6.world, Thompson v. INS (1964) and Bowles, which overrules
# it from June 14, 2007. Both bind in every circuit, so the matter gives
# the values it gives at the Sixth Circuit.
layers = ["change-thompson-v-ins", "change-bowles-v-russell"]

[location]
family = "circuit-appellate"
circuit = "ca1"
