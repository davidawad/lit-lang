test "instructions petition notice period: 7 days before the trigger" cite "D.N.M.I. LR 63.1(f)"
{
  given InstructionsPetitionHearingHeld() on 2027-03-02
  expect deadline(instructions-petition-notice-period) == 2027-02-23
