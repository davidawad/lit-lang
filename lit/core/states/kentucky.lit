module core.states.kentucky

import core.calendar.{ us-federal-holidays }

/// The holidays of Kentucky (KRS 2.110(1)) that `us-federal-holidays` does not
/// already close: Robert E. Lee Day (January 19), Franklin D. Roosevelt Day
/// (January 30), Lincoln's Birthday (February 12) and Confederate Memorial Day
/// and Jefferson Davis Day (June 3). The section moves no weekend holiday.
/// Closed from the date of the vendored text's last amendment (1992 Ky. Acts
/// ch. 77, effective July 14, 1992). Not modeled: the days the President or the
/// Governor appoints as days of thanksgiving, which no vendored source lists (a
/// last day on one is the earlier date).
calendar kentucky-holidays cite "KRS 2.110(1)"
{
  robert-e-lee-day: fixed(1, 19) effective [1992-07-14, ..)
  franklin-d-roosevelt-day: fixed(1, 30) effective [1992-07-14, ..)
  lincolns-birthday: fixed(2, 12) effective [1992-07-14, ..)
  confederate-memorial-day: fixed(6, 3) effective [1992-07-14, ..)
}

/// FRCP 6 in the district courts of Kentucky: the 2023 text
/// (`frcp6@2023-12-01`) with `kentucky-holidays`, which 6(a)(6)(C)
/// ("any day declared a holiday by ... the state where the district court
/// is located") makes legal holidays "for periods that are measured after
/// an event" only. A district package there names it as its `counting`
/// rule and `recounts` lit/frcp. A calendar day is closed only from the
/// date its entry is in force; before it the count is `frcp6`'s.
counting frcp6-kentucky effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCP 6(d)"
  holidays us-federal-holidays
  forward_holidays kentucky-holidays cite "FRCP 6(a)(6)(C)"
  forums [frcp]
  allow_hours
  end_of_month clamp
}

/// FRBP 9006(a) (`frbp9006`) in the bankruptcy courts of Kentucky:
/// `kentucky-holidays` are legal holidays for a period counted forward only (FRBP
/// 9006(a)(6)(C), "any day declared a holiday by the state where the
/// district court is located"). A bankruptcy package there names it as its
/// `counting` rule and `recounts` lit/frbp. A calendar day is closed only
/// from the date its entry is in force.
counting frbp9006-kentucky effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays kentucky-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-kye, bankr-kyw]
  allow_hours
  end_of_month clamp
}
