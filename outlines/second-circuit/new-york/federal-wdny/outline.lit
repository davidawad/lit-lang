// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-ny-federal-wdny

start commenced

state commenced: "Complaint Filed" by applicant cite ?("Fed. R. Civ. P. 3")
{
  note "OUTLINE. A civil action commences with the filing of the complaint. Filing fee and service period are holes."
  edge-commenced-response-due "Defendant served" -> response-due {
    authority cite ?("Fed. R. Civ. P. 4(m)")
  }
}

decision response-due: "Answer or Motion Due" by office cite ?("Fed. R. Civ. P. 12(a)(1)(A)(i)")
{
  note "OUTLINE. The response period is a hole until verified. Leading decision on pleading challenges (verify): Bell Atlantic Corp. v. Twombly, 550 U.S. 544 (2007); Ashcroft v. Iqbal, 556 U.S. 662 (2009)"
  edge-response-due-default "No response" -> default-entered {
    authority cite ?("Fed. R. Civ. P. 55(a)")
  }
  edge-response-due-motion "Pre-answer motion filed" -> pleading-ruling {
    authority cite ?("Fed. R. Civ. P. 12(b)(6)")
  }
  edge-response-due-discovery "Answer filed" -> discovery {
    authority cite ?("Fed. R. Civ. P. 12(a)(1)(A)(i)")
  }
}

decision pleading-ruling: "Pre-answer Motion Decided" by court cite ?("Fed. R. Civ. P. 12(b)(6)")
{
  note "Motion practice follows W.D.N.Y. Local Civ. R. 7(a) (verify number) and the judge's standing orders (holes). "
  edge-pleading-ruling-dismissed "Dismissed" -> dismissed {
    authority cite ?("Fed. R. Civ. P. 12(b)(6)")
  }
  edge-pleading-ruling-discovery "Motion denied; case proceeds" -> discovery {
    authority cite ?("Fed. R. Civ. P. 12(a)(1)(A)(i)")
  }
}

state discovery: "Discovery" by applicant cite ?("Fed. R. Civ. P. 26(a), 26(f)")
{
  note "OUTLINE. FRCP 26 and 33-37 govern, subject to local rules and the scheduling order. Scope, deadlines and sanctions are holes until verified."
  edge-discovery-sj-ruling "Dispositive motion filed" -> sj-ruling {
    authority cite ?("Fed. R. Civ. P. 56(a); W.D.N.Y. Local Civ. R. 56(a) (verify number)")
  }
  edge-discovery-trial-ready "No dispositive motion" -> trial-ready {
    authority cite ?("Fed. R. Civ. P. 16(b), 16(e)")
  }
}

decision sj-ruling: "Summary Judgment Decided" by court cite ?("Fed. R. Civ. P. 56(a); W.D.N.Y. Local Civ. R. 56(a) (verify number)")
{
  note "OUTLINE. Summary judgment statement under W.D.N.Y. Local Civ. R. 56(a) (verify number) (verify text). Leading decision on summary judgment (verify): Celotex Corp. v. Catrett, 477 U.S. 317 (1986); Anderson v. Liberty Lobby, Inc., 477 U.S. 242 (1986)"
  edge-sj-ruling-granted "Granted" -> sj-granted {
    authority cite ?("Fed. R. Civ. P. 56(a); W.D.N.Y. Local Civ. R. 56(a) (verify number)")
  }
  edge-sj-ruling-denied "Denied" -> trial-ready {
    authority cite ?("Fed. R. Civ. P. 56(a); W.D.N.Y. Local Civ. R. 56(a) (verify number)")
  }
}

decision trial-ready: "Pretrial and Trial Setting" by court cite ?("Fed. R. Civ. P. 16(b), 16(e)")
{
  note "OUTLINE. Pretrial order, jury demand and trial setting. Settlement and dismissal paths are not modeled."
  edge-trial-ready-verdict "Tried" -> verdict {
    authority cite ?("Fed. R. Civ. P. 50(a)")
  }
}

state verdict: "Verdict Returned" by applicant cite ?("Fed. R. Civ. P. 50(a)")
{
  note "OUTLINE. Motions for judgment as a matter of law and for a new trial follow the verdict."
  edge-verdict-post-trial "Post-trial motions" -> post-trial {
    authority cite ?("Fed. R. Civ. P. 50(b), 59(b)")
  }
}

decision post-trial: "Post-trial Motions Decided" by court cite ?("Fed. R. Civ. P. 50(b), 59(b)")
{
  note "OUTLINE. Deadlines for renewed motions are holes until verified."
  edge-post-trial-judgment "Judgment entered" -> judgment-entered {
    authority cite ?("Fed. R. Civ. P. 58")
  }
}

terminal judgment-entered: "Judgment entered on verdict" outcome [win] cite ?("Fed. R. Civ. P. 58")
{
  note "OUTLINE. Notice of appeal runs from entry of judgment; appeal lies to the Second Circuit Court of Appeals (verify: 28 U.S.C. § 1291; Fed. R. App. P. 4(a)(1)(A)); see the second-circuit-court-of-appeals and frap-appellate-procedure packages."
  payoff ?
}

terminal default-entered: "Default entered" outcome [loss] cite ?("Fed. R. Civ. P. 55(a)")
{
  note "OUTLINE. Default judgment and relief from default are holes until verified."
  payoff ?
}

terminal dismissed: "Dismissed on the pleadings" outcome [loss] cite ?("Fed. R. Civ. P. 12(b)(6)")
{
  note "OUTLINE. Leading decision on pleading standard (verify): Bell Atlantic Corp. v. Twombly, 550 U.S. 544 (2007); Ashcroft v. Iqbal, 556 U.S. 662 (2009)"
  payoff ?
}

terminal sj-granted: "Summary judgment granted" outcome [loss] cite ?("Fed. R. Civ. P. 56(a); W.D.N.Y. Local Civ. R. 56(a) (verify number)")
{
  note "OUTLINE. Leading decision on summary judgment (verify): Celotex Corp. v. Catrett, 477 U.S. 317 (1986); Anderson v. Liberty Lobby, Inc., 477 U.S. 242 (1986)"
  payoff ?
}

