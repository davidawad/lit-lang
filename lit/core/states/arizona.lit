module core.states.arizona

import core.calendar.{ us-federal-holidays }

/// The holidays of Arizona (A.R.S. § 1-301(A)) add no day `us-federal-holidays`
/// does not already close: the weekday holidays are federal holidays on the
/// same days, observed as § 6103(b)(1) observes them (§ 1-301(B), (C)), and
/// Mothers' Day, Fathers' Day, American Family Day and the Sunday
/// observances of Native American Day, National Navajo Code Talkers Day and
/// Constitution Commemoration Day (§ 1-301(A), (D)-(F)) are Sundays, closed
/// by `weekend`. The calendar is declared, empty, so the District of
/// Arizona's counts (core's `frcp6-arizona` and `frbp9006-arizona`) name
/// the state whose FRCP 6(a)(6)(C) and FRBP 9006(a)(6)(C) days they read.
calendar arizona-holidays cite "A.R.S. § 1-301(A)"
{}

/// FRCP 6 in the district courts of Arizona: the 2023 text
/// (`frcp6@2023-12-01`) with `arizona-holidays`, which 6(a)(6)(C)
/// ("any day declared a holiday by ... the state where the district court
/// is located") makes legal holidays "for periods that are measured after
/// an event" only. A district package there names it as its `counting`
/// rule and `recounts` lit/frcp. A calendar day is closed only from the
/// date its entry is in force; before it the count is `frcp6`'s.
counting frcp6-arizona effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCP 6(d)"
  holidays us-federal-holidays
  forward_holidays arizona-holidays cite "FRCP 6(a)(6)(C)"
  forums [frcp]
  allow_hours
  end_of_month clamp
}

/// FRBP 9006(a) (`frbp9006`) in the bankruptcy courts of Arizona:
/// `arizona-holidays` are legal holidays for a period counted forward only (FRBP
/// 9006(a)(6)(C), "any day declared a holiday by the state where the
/// district court is located"). A bankruptcy package there names it as its
/// `counting` rule and `recounts` lit/frbp. A calendar day is closed only
/// from the date its entry is in force.
counting frbp9006-arizona effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays arizona-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-az]
  allow_hours
  end_of_month clamp
}
