// The source pack stores fixed-day edge windows. These typed test declarations
// exercise every legacy length against the USPTO 37 C.F.R. § 1.7 clock.
module mpep.deadlines

import core.calendar.{ us-federal-holidays }

event MpepAction()

counting uspto1 effective [2013-12-18, ..) cite 37 CFR 1.7
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday]
  holidays us-federal-holidays
}

/// imported
deadline edge-period-01: 365.days from MpepAction() counted_by uspto1 effective [2024-01-31, ..) cite ?("35 U.S.C. 111(b); 37 CFR 1.53(c)")

test "edge-period-01 counts under USPTO 37 C.F.R. § 1.7" {
  given MpepAction() on 2025-01-01
  expect deadline(edge-period-01) == 2026-01-02
}

