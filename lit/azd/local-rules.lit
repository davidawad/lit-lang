{
  given ShowCauseNoticeSent() on 2026-11-02
  expect deadline(discipline-response-period) == 2026-11-16
}

test "client notice period: 7 days after the trigger" cite "D. Ariz. LRCiv 83.2"
{
  given SuspensionNoticeSent() on 2026-11-02
  expect deadline(client-notice-period) == 2026-11-09
