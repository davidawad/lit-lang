module az-appellate-civil.appeal

/// An opening or answering brief: at most 14,000 words (ARCAP 14(a)(1)).
limit principal-brief { words <= 14_000 cite "ARCAP 14(a)" } cite "ARCAP 14(a)"
/// A reply brief: at most 7,000 words (ARCAP 14(a)(2)).
limit reply-brief { words <= 7_000 cite "ARCAP 14(a)" } cite "ARCAP 14(a)"
/// A motion for reconsideration, or a response to one: at most 3,500 words
/// (ARCAP 22(e)).
limit reconsideration-motion { words <= 3_500 cite "ARCAP 22(e)" } cite "ARCAP 22(e)"
/// A petition or cross-petition for review, or a response to one: at most
/// 3,500 words (ARCAP 23(g)(2)).
limit review-petition { words <= 3_500 cite "ARCAP 23(g)" } cite "ARCAP 23(g)"

/// The appellant's opening brief is filed (ARCAP 15(a)(1)).
event OpeningBriefFiled() paper principal-brief
/// The appellee's answering brief is filed (ARCAP 15(a)(2)).
event AnsweringBriefFiled() paper principal-brief
/// The appellant's reply brief is filed (ARCAP 15(a)(3)).
event ReplyBriefFiled() paper reply-brief
/// A motion for reconsideration is filed (ARCAP 22(c)).
event ReconsiderationMotionFiled() paper reconsideration-motion
/// A petition for review is filed (ARCAP 23(b)).
event ReviewPetitionFiled() paper review-petition

start notice-filed

state notice-filed: "Notice of appeal filed" by applicant cite "ARCAP 9(a)"
{
  note "The notice of appeal is filed with the clerk of the superior court that entered the judgment no later than 30 days after entry of the judgment, unless ARCAP 9 or the law provides another time; a notice of cross-appeal is due 20 days after the appellant's notice or 30 days after entry, whichever is later (ARCAP 8(a), (b), 9(a), (b)). A notice filed after the court announces its decision but before entry of the judgment is treated as filed after entry (ARCAP 9(c)). A timely motion under Civil Rule 50(b), 52(b), 59(a) or 59(d), or under Rule 60 filed within 15 days after entry, restarts the time from entry of the signed order disposing of the last such motion (ARCAP 9(e)(1)). The statutory filing fee is paid to the superior court clerk with the notice unless exempt, waived or deferred; the amount is not stated in the rules (ARCAP 8(e)). Periods are stated, not counted: Civil Rules 6(a) and, except for electronically served documents, 6(c) compute them (ARCAP 5(a))."
  edge-notice-filed-timely "Timely notice" -> appealability { authority cite "ARCAP 9(a)" }
  edge-notice-filed-late "Notice not filed in time" -> dismissed-untimely {
    authority cite "ARCAP 5(b)"
  }
}

terminal dismissed-untimely: "Appeal fails: notice untimely and time not reopened" outcome [loss, dismissal] cite "ARCAP 5(b)"
{
  note "Neither the appellate court nor the superior court may extend the time for filing a notice of appeal, except as ARCAP 9(f) provides (ARCAP 5(b)). The superior court may reopen the time for 14 days after its order only if the movant did not receive notice of entry under Civil Rule 58(c) within 21 days after entry, moves within 30 days after the time for appeal expired or within 7 days of receiving notice, whichever is earlier, and no party would be prejudiced (ARCAP 9(f)). Failure to perform any act other than timely filing the notice does not affect the appellate court's jurisdiction (ARCAP 8(d))."
}

decision appealability: "Appealable judgment?" by court cite "Ariz. R. Civ. P. 54(a)"
{
  note "A judgment includes a decree and any order from which an appeal lies (Ariz. R. Civ. P. 54(a)). A judgment as to all claims and parties is final only if it recites that no further matters remain pending and that it is entered under Rule 54(c); a judgment on fewer than all claims or parties needs the express Rule 54(b) determination of no just reason for delay and its recital (Ariz. R. Civ. P. 54(b), (c)). The statute listing appealable judgments and orders, A.R.S. § 12-2101, is not vendored, so the statutory routes are not stated here. The outline named no appealability decision."
  edge-appealability-final "Appealable judgment" -> record {
    authority cite "Ariz. R. Civ. P. 54(c)"
  }
  edge-appealability-not-final "No appealable judgment" -> dismissed-jurisdiction {
    authority cite "Ariz. R. Civ. P. 54(b)"
  }
}

terminal dismissed-jurisdiction: "Dismissed: no appealable judgment" outcome [loss, dismissal] cite "Ariz. R. Civ. P. 54(b)"

state record: "Transcripts ordered; record transmitted" by applicant cite "ARCAP 11(c)"
{
  note "The appellant orders transcripts within 10 days after filing the notice of appeal (or after entry of the order disposing of the last ARCAP 9(e) motion, whichever is later), and within 15 days files in the superior court and serves a notice of transcript order and, if less than a complete transcript is ordered, a statement of the issues (ARCAP 11(c)(2), (3)). Another party's designation of additional transcripts, the appellant's notice of intention not to order them (5 days after service of the designation) and the response (5 days) follow ARCAP 11(c)(4). Within 30 days after the notice of appeal is filed, the superior court clerk transmits the index, documents and exhibits to the appellate clerk; the reporter provides an ordered and paid-for transcript within 30 days after the order, and the ordering party serves it within 5 days after receipt (ARCAP 11.1(b), (c), (d)). The appellate clerk assigns a case number no later than 10 days after receiving the record items, and its initial notice directs the appellant to pay the appellate filing fee within 10 days and to file the opening brief within 60 days; in Division One the appellant files a case management statement within 20 days after that notice (ARCAP 12(a), (b), (d))."
  edge-record-briefing "Initial notice distributed" -> briefing { authority cite "ARCAP 12(b)" }
}

state briefing: "Briefing" by applicant cite "ARCAP 15(a)"
{
  note "The opening brief is due within 60 days after the appellate clerk distributes the initial notice, and the appeal may be dismissed if it is not timely filed; the answering brief within 40 days after service of the opening brief, failing which the appeal may be submitted on the opening brief and the record; and the optional reply brief within 20 days after service of the answering brief (ARCAP 15(a)(1)-(3)). On a cross-appeal the combined briefs are due 40, 40 and 20 days after service of the brief before (ARCAP 15(a)(4), (5)). Opening and answering briefs may not exceed 14,000 words and reply briefs 7,000, each with a certificate of compliance (ARCAP 14(a)). The appeal is at issue when the final reply brief is filed or due, whichever is earlier (ARCAP 15(b)). A party claiming attorneys' fees on appeal gives notice in its brief (ARCAP 21(a))."
  edge-briefing-argument "Appeal at issue" -> argument { authority cite "ARCAP 15(b)" }
}

decision argument: "Oral argument or decision on the briefs" by court cite "ARCAP 18(a)"
{
  note "The Court of Appeals may schedule oral argument if a party files a separate request no later than 10 days after the due date for the final reply brief, or 10 days after the final reply brief is actually filed, whichever is earlier (ARCAP 18(a)); it may decide the appeal without argument on the factors of ARCAP 18(b)."
  edge-argument-decision "Argued or submitted" -> decision-issued { authority cite "ARCAP 18(b)" }
}

decision decision-issued: "Decision" by court cite "ARCAP 28(a)"
{
  note "The decision is in writing and captioned \"Opinion,\" \"Memorandum Decision,\" \"Decision Order\" or \"Order\"; it issues as an opinion if a majority of the judges finds it meets a criterion of ARCAP 28(b), and a motion to publish a memorandum decision is treated as a motion for reconsideration (ARCAP 28(a)-(c), (g)). Within 10 days after notice of a decision granting a fee claim, the party files an itemized and verified statement of fees and costs (ARCAP 21(b)(1)). The outline asked for the standard of review; ARCAP states none."
  edge-decision-issued-entered "Decision entered" -> reconsideration-window {
    authority cite "ARCAP 28(a)"
  }
}

decision reconsideration-window: "Move for reconsideration?" by applicant cite "ARCAP 22(c)"
{
  note "A motion for reconsideration is filed within 15 days after the appellate court enters its decision and may not exceed 3,500 words; it is not required before a petition for review (ARCAP 22(a), (c), (e))."
  edge-reconsideration-window-none "No motion" -> review-window { authority cite "ARCAP 22(a)" }
  edge-reconsideration-window-filed "Motion filed" -> reconsideration-ruling {
    authority cite "ARCAP 22(c)"
  }
}

decision reconsideration-ruling: "Reconsideration decided" by court cite "ARCAP 22(d)"
{
  note "No response is filed unless the court requests one, but the court will not grant the motion without requesting a response (ARCAP 22(d)). No motion for reconsideration of an order denying reconsideration is permitted without a specific order (ARCAP 22(f))."
  edge-reconsideration-ruling-denied "Denied" -> review-window { authority cite "ARCAP 22(d)" }
  edge-reconsideration-ruling-granted "Granted" -> reconsideration-granted {
    authority cite "ARCAP 22(d)"
  }
}

terminal reconsideration-granted: "Reconsideration granted: decision revisited" outcome [appeal] cite "ARCAP 22(b)"
{
  note "Modeled as an exit: the court reconsiders the points of law or fact the motion showed it erroneously determined (ARCAP 22(b)), and a new decision returns to the decision stage."
}

decision review-window: "Petition for review?" by applicant cite "ARCAP 23(b)"
{
  note "A petition for review to the Supreme Court is filed within 30 days after entry of the Court of Appeals' decision or, if any party timely moved for reconsideration, within 15 days after final disposition of the motion or 30 days after entry of the decision, whichever is later; a cross-petition within 15 days after service of the petition or 30 days after entry, whichever is later (ARCAP 23(b)). A petition, cross-petition or response may not exceed 3,500 words (ARCAP 23(g)(2))."
  edge-review-window-none "No petition: mandate issues" -> final-appellate {
    authority cite "ARCAP 24(b)"
  }
  edge-review-window-filed "Petition filed" -> further-review { authority cite "ARCAP 23(b)" }
}

decision further-review: "Petition for review decided" by court cite "ARCAP 23(a)"
{
  note "A response is filed within 30 days after service of the petition; failure to respond is not an admission that review should be granted; a reply is filed only if the Supreme Court authorizes one (ARCAP 23(f)(1), (4))."
  edge-further-review-denied "Denied" -> review-denied { authority cite "ARCAP 24(b)" }
  edge-further-review-granted "Granted" -> review-granted { authority cite "ARCAP 23(a)" }
}

terminal review-denied: "Review denied: mandate issues" outcome [loss] cite "ARCAP 24(b)"
{
  note "The Court of Appeals clerk issues the mandate 15 days after receiving the Supreme Court's order denying the petition (ARCAP 24(b)(2)); a motion to stay the mandate is filed within 15 days after that order, and a stay may not exceed 90 days unless extended for good cause or a certiorari petition is noticed (ARCAP 24(d))."
}

terminal review-granted: "Review granted: continue in the Supreme Court" outcome [appeal] cite "ARCAP 23(a)"
{
  note "When the Supreme Court enters a disposition requiring the mandate, its clerk issues it 15 days after entry, or 15 days after final disposition of a motion for reconsideration (ARCAP 24(b)(3))."
}

terminal final-appellate: "Appellate decision final: mandate issued" outcome [final] cite "ARCAP 24(a)"
{
  note "If no party petitions for review, the Court of Appeals clerk issues the mandate when the time to petition expires (ARCAP 24(b)(1)). The mandate is the appellate court's final order, and the court retains jurisdiction until it issues (ARCAP 24(a))."
}
