module ak-appellate-civil.appeal

import ak-state-rules.{ NoticeOfAppealFiled }

// A principal brief may not exceed 50 numbered pages exclusive of
// appendices (Alaska R. App. P. 212(c)(4)); it stays a note, not a `limit`:
// the rule states "50 numbered pages", a form the limit check does not read.
/// The appellant's reply brief: at most 20 pages (Alaska R. App. P.
/// 212(c)(4)).
limit reply-brief { pages <= 20 cite "Alaska R. App. P. 212(c)" } cite "Alaska R. App. P. 212(c)"

/// The appellant's reply brief is served and filed (Alaska R. App. P.
/// 212(a)).
event ReplyBriefServed() paper reply-brief

start notice-filed

state notice-filed: "Notice of appeal filed" by applicant cite "Alaska R. App. P. 204(a)"
{
  note "The notice of appeal is filed within 30 days from the date shown in the clerk's certificate of distribution on the judgment, unless Rules 216-219 or AS 23.30.128(g) set another time; another party may appeal within 14 days of a timely notice or within the 30 days, whichever expires last (Alaska R. App. P. 204(a)(1), (2)). A timely motion under Civil Rules 50(b), 52(b), 59 or 77(k) terminates the running of the time, which runs again in full from notice of the order deciding it (Alaska R. App. P. 204(a)(3)). Unless exempt, a $750.00 cost bond is filed with the notice in a civil case, unless the court fixes another amount or a supersedeas bond is filed (Alaska R. App. P. 204(c)(1)). Periods are stated, not counted: Appellate Rule 502(a) computes them. The earlier outline cited Appellate Rule 602, which governs appeals to the superior court, not this appeal."
  edge-notice-filed-appealable "Timely notice from a final judgment" -> appealability {
    event NoticeOfAppealFiled()
    authority cite "Alaska R. App. P. 204(a)"
  }
  edge-notice-filed-late "Notice not filed in time" -> dismissed-untimely {
    authority cite "Alaska R. App. P. 204(a)"
  }
}

terminal dismissed-untimely: "Appeal fails: notice untimely and not validated" outcome [loss, dismissal] cite "Alaska R. App. P. 502(b)"
{
  note "The appellate court may, on motion showing good cause or on its own, extend a time period or validate an act done after it expired (Alaska R. App. P. 502(b)); a late notice of appeal not so validated does not bring the appeal."
}

decision appealability: "Appealable final judgment?" by court cite "Alaska R. App. P. 202(a)"
{
  note "An appeal may be taken to the supreme court from a final judgment entered by the superior court in the circumstances AS 22.05.010 specifies (Alaska R. App. P. 202(a)); the statute is not vendored. A non-appealable order is reviewed, if at all, by petition for review (Alaska R. App. P. 402). The earlier outline named no appealability decision."
  edge-appealability-final "Final judgment" -> record { authority cite "Alaska R. App. P. 202(a)" }
  edge-appealability-not-final "Not a final judgment" -> dismissed-jurisdiction {
    authority cite "Alaska R. App. P. 202(a)"
  }
}

terminal dismissed-jurisdiction: "Dismissed: no appealable judgment" outcome [loss, dismissal] cite "Alaska R. App. P. 202(a)"
{
  note "Review of a non-appealable order lies only by petition for review (Alaska R. App. P. 402), not modeled here."
}

state record: "Record and transcript" by applicant cite "Alaska R. App. P. 210"
{
  note "Any other party may designate additional parts of the electronic record to be transcribed within 10 days after service of the appellant's designation; preparation of the transcript, and receipt and page numbering of the record, are completed within 40 days after issuance of the opening notice (Alaska R. App. P. 210(b), (e)). The court then gives notice of the due date for the appellant's brief (Alaska R. App. P. 210(f))."
  edge-record-briefing "Notice of the brief due date" -> briefing {
    authority cite "Alaska R. App. P. 210(f)"
  }
}

state briefing: "Briefing" by applicant cite "Alaska R. App. P. 212(a)"
{
  note "The appellant serves and files its brief within 30 days after the court's notice of the due date; the appellee within 30 days after service of the appellant's brief; within 20 days after service of the appellee's brief the appellant files a reply or a notice that none will be filed; separate briefs of multiple parties preparing excerpts get 10 more days (Alaska R. App. P. 212(a)(1)(A)). Principal briefs may not exceed 50 numbered pages and a reply 20 pages (Alaska R. App. P. 212(c)(4)). Routine extensions by notice may not exceed 30 days for the opening brief, 15 for the reply and 30 for the appellee (Alaska R. App. P. 503.5)."
  edge-briefing-argument "Briefing complete" -> argument {
    authority cite "Alaska R. App. P. 212(a)"
  }
}

decision argument: "Oral argument or submission on the briefs" by court cite "Alaska R. App. P. 505(a)"
{
  note "In an appeal under Part Two, oral argument is held if it is timely requested: not later than 10 days after the due date of the reply brief or, if no reply is allowed, of the appellee's brief (Alaska R. App. P. 505(a)(2)); Rule 213 refers to Rule 505. An appeal may instead be disposed of summarily (Alaska R. App. P. 214)."
  edge-argument-decided "Argued or submitted" -> decision-issued {
    authority cite "Alaska R. App. P. 505(a)"
  }
}

decision decision-issued: "Opinion or order decides the appeal" by court cite "Alaska R. App. P. 507(a)"
{
  note "The opinion, a summary disposition order under Rule 214, or an order dismissing the appeal is the appellate court's judgment; no mandate issues (Alaska R. App. P. 507(a)). The prevailing party serves and files a verified bill of costs within 10 days after notice of the opinion or order, objections follow within 7 days, and a motion for attorney's fees is filed within 10 days after that notice (Alaska R. App. P. 508)."
  edge-decision-issued-rehearing "Petition for rehearing" -> rehearing {
    authority cite "Alaska R. App. P. 506(b)"
  }
  edge-decision-issued-final "No petition" -> jurisdiction-returned {
    authority cite "Alaska R. App. P. 507(c)"
  }
}

decision rehearing: "Rehearing decided" by court cite "Alaska R. App. P. 506(a)"
{
  note "An original petition for rehearing is filed within 10 days after the date of notice of the opinion or other decision (Alaska R. App. P. 506(b)). Rehearing may be ordered if the court overlooked, misapplied or failed to consider a directly controlling statute, decision or principle, or overlooked or misconceived a material fact, proposition of law or question; it is not granted merely to reargue matters fully considered (Alaska R. App. P. 506(a))."
  edge-rehearing-denied "Denied or disposed of" -> jurisdiction-returned {
    authority cite "Alaska R. App. P. 507(c)"
  }
  edge-rehearing-granted "Rehearing granted" -> rehearing-granted {
    authority cite "Alaska R. App. P. 506(a)"
  }
}

terminal rehearing-granted: "Rehearing granted: the matter is reheard" outcome [appeal] cite "Alaska R. App. P. 506(a)"
{
  note "Modeled as an exit; in practice it returns to decision."
}

terminal jurisdiction-returned: "Judgment effective: jurisdiction returns to the trial court" outcome [final] cite "Alaska R. App. P. 507(c)"
{
  note "In a case decided by the supreme court, full jurisdiction returns to the trial court on the day after the court disposes of a timely petition for rehearing or motion for reconsideration, or, if none is filed, on the day after the deadline for filing one expires (Alaska R. App. P. 507(b), (c)). Further review in the Supreme Court of the United States is not modeled. The earlier outline's petition for hearing (Appellate Rules 302-304) reviews decisions of the court of appeals and superior court, not a supreme court civil appeal."
}
