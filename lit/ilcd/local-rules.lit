module ilcd-local-rules.local-rules

import core.frcp6.{ frcp6 }

// The Central District of Illinois's own civil periods, computed under the
// federal rules (FRCP 6(a) governs "any local rule"). Each period applies
// "unless otherwise ordered" where the rule says so. Rules that state no
// period or limit stay out, and so do periods that bind the court or the
// clerk, not a party: the scheduling conference within the earlier of 90
// days after service or 60 days after appearance (Civ. LR 16.2(A)), the 90
// days a transcript stays unavailable to copy (Civ. LR 5.11(C)), and the
// 180-day date certain on a stay (Civ. LR 16.1). The memorandum limit of
// Civ. LR 7.1(B)(4), 15 pages unless the memorandum complies with the type
// volume limitation ("not more than 7000 words" or 650 lines of monospaced
// type), is stated here and not declared: the cite check reads a word bound
// only as "7,000 words", which the vendored text does not write, and a
// limit without its word alternative would judge a compliant memorandum
// over it. Objections to a magistrate judge's order or report under Civ. LR
// 72.2 within 14 days after service restate FRCP 72(a) and 72(b)(2) and
// belong to lit/frcp; only the local opposition period on an appeal of a
// non-dispositive order is declared. The 21-day answer of other defendants
// in prisoner cases (Civ. LR 16.3(E)) restates FRCP 12(a) and is not
// declared. The criminal rules of the same document are outside this civil
// layer. The earlier C.D. Ill. outline's FRCP flow and its Supreme Court
// decisions (Twombly, Iqbal, Celotex, Anderson v. Liberty Lobby) are FRCP
// authority and belong to lit/frcp and lit/frap; its Seventh Circuit
// decisions (Cracco v. Vitran Express, Inc.; Swanson v. Citibank, N.A.) are
// removed: no reporter text is vendored.
/// The plaintiff mails the notice of lawsuit and request for waiver of
/// service (Civ. LR 4.1).
event WaiverRequestMailed()
/// A registered attorney's or pro se party's email address, mailing
/// address, telephone or fax number changes (Civ. LR 5.2).
event ContactInformationChanged()
/// The court reporter files an official transcript in CM/ECF (Civ. LR
/// 5.11(C)).
event TranscriptFiled()
/// A motion raising a question of law and its memorandum are served (Civ.
/// LR 7.1(B)(2)).
event MotionServed()
/// The response to a motion is served (Civ. LR 7.1(B)(3)).
event ResponseServed()
/// A motion for summary judgment is served (Civ. LR 7.1(D)(2)).
event SummaryJudgmentMotionServed()
/// The response to a motion for summary judgment is served (Civ. LR
/// 7.1(D)(3)).
event SummaryJudgmentResponseServed()
/// A petition or motion within the scope of Civ. LR 8.2 is filed (Civ. LR
/// 8.2(6)).
event HabeasPetitionFiled()
/// A party or non-filing signatory receives notice that an electronically
/// filed document has been filed (Civ. LR 11.4(C)).
event FilingNoticeReceived()
/// Trial is scheduled to start (Civ. LR 16.1(E)(8)).
event TrialBegins()
/// The final pretrial conference is held on the date set (Civ. LR 16.1(F),
/// 16.3).
event FinalPretrialConferenceHeld()
/// A defendant that is the State of Illinois or its officer, agent,
/// department or employee is served, or sent a waiver of service, in a
/// prisoner or detainee case (Civ. LR 16.3(E)).
event StateDefendantServed()
/// A motion is filed in a prisoner or detainee case (Civ. LR 16.3(H)).
event PrisonerCaseMotionFiled()
/// A private mediation concludes (Civ. LR 16.4).
event PrivateMediationConcluded()
/// The first mediation meeting is held (Civ. LR 16.4).
event FirstMediationMeeting()
/// A civil action seeking to bar or mandate nationwide enforcement of a
/// federal law is assigned or reassigned (Civ. LR 40.1(E)(4)(b)(ii)).
event CaseAssigned()
/// Judgment is entered (Civ. LR 54.1(A)).
event JudgmentEntered()
/// An appeal from a magistrate judge's non-dispositive order is served
/// (Civ. LR 72.2(A)).
event MagistrateAppealServed()
/// The case is decided and no appeal is taken (Civ. LR 79.1(B)).
event CaseDecidedUnappealed()
/// The mandate of the reviewing court disposing of the case is filed (Civ.
/// LR 79.1(B)).
event MandateFiled()
/// The clerk gives notice to remove models, diagrams, exhibits or materials
/// (Civ. LR 79.1(C)).
event ExhibitRemovalNoticeGiven()

/// Civ. LR 4.1: proof of the written notice of lawsuit and request for
/// waiver of service is filed with the clerk within 7 days of the mailing
/// of the notice.
deadline waiver-notice-proof-period: 7.days after WaiverRequestMailed() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 4.1"
{
  forum frcp
}

/// Civ. LR 5.2: an attorney or pro se party whose contact information
/// changes after registering for electronic filing files notice of the
/// change within 14 days and serves it on all other parties.
deadline contact-change-notice-period: 14.days after ContactInformationChanged() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 5.2"
{
  forum frcp
}

/// Civ. LR 5.11(C): a party files a Notice of Intent to Request Redaction
/// within 7 days of the filing of the transcript.
deadline redaction-notice-period: 7.days after TranscriptFiled() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 5.11(C)"
{
  forum frcp
}

/// Civ. LR 5.11(C): within 21 days from the filing of the transcript, the
/// parties file under seal a Motion of Requested Redactions.
deadline redaction-motion-period: 21.days after TranscriptFiled() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 5.11(C)"
{
  forum frcp
}

/// Civ. LR 7.1(B)(2): a response to a motion is filed within 14 days after
/// service of the motion and memorandum; without a timely response the
/// judge presumes no opposition.
deadline response-period: 14.days after MotionServed() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 7.1(B)"
{
  forum frcp
}

/// Civ. LR 7.1(B)(3): a reply is permitted only with leave; the motion for
/// leave, with the proposed reply attached, is filed within 7 days after
/// service of the response.
deadline reply-leave-period: 7.days after ResponseServed() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 7.1(B)"
{
  forum frcp
}

/// Civ. LR 7.1(D)(2): within 21 days after service of a motion for summary
/// judgment, any party opposing it files a response.
deadline sj-response-period: 21.days after SummaryJudgmentMotionServed() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 7.1(D)"
{
  forum frcp
}

/// Civ. LR 7.1(D)(3): within 14 days after service of the response, the
/// movant may file a reply.
deadline sj-reply-period: 14.days after SummaryJudgmentResponseServed() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 7.1(D)"
{
  forum frcp
}

/// Civ. LR 8.2(6): the petitioner or movant files legible copies of the
/// listed documents within 14 days after filing the petition or motion, or
/// explains the omission.
deadline habeas-documents-period: 14.days after HabeasPetitionFiled() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 8.2"
{
  forum frcp
}

/// Civ. LR 11.4(C): a party or non-filing signatory disputing the
/// authenticity of an electronically filed document or its signatures files
/// an objection within 14 days of receiving notice of the filing.
deadline authenticity-objection-period: 14.days after FilingNoticeReceived() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 11.4(C)"
{
  forum frcp
}

/// Civ. LR 16.1(E)(8): unless the presiding judge directs otherwise, trial
/// briefs and motions in limine are submitted on or before 14 days prior to
/// the scheduled start of trial.
deadline trial-brief-period: 14.days before TrialBegins() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 16.1(E)"
{
  forum frcp
}

/// Civ. LR 16.1(F): unless otherwise ordered, plaintiff's counsel submits
/// the proposed final pretrial order to opposing counsel at least 7 days
/// prior to the final pretrial conference.
deadline pretrial-order-draft-period: 7.days before FinalPretrialConferenceHeld() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 16.1(F)"
{
  forum frcp
}

/// Civ. LR 16.3(E)(1): in a prisoner or detainee case, a defendant that is
/// the State of Illinois or its officer, agent, department or employee
/// files a responsive pleading within 60 days of service or of the date the
/// waiver of service was sent.
deadline state-defendant-answer-period: 60.days after StateDefendantServed() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 16.3(E)"
{
  forum frcp
}

/// Civ. LR 16.3(H): in a prisoner or detainee case, responses to motions
/// are filed within 14 days, or a timely motion for extension is filed
/// within that time.
deadline prisoner-motion-response-period: 14.days after PrisonerCaseMotionFiled() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 16.3(H)"
{
  forum frcp
}

/// Civ. LR 16.3: in a prisoner or detainee case, the statements and lists
/// of the final pretrial order are exchanged between the litigants, not
/// filed, at least 30 days before the final pretrial conference.
deadline prisoner-pretrial-exchange-period: 30.days before FinalPretrialConferenceHeld() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 16.3"
{
  forum frcp
}

/// Civ. LR 16.3: in a prisoner or detainee case, defendants' attorney files
/// the proposed final pretrial order at least 14 days before the final
/// pretrial conference.
deadline prisoner-pretrial-order-period: 14.days before FinalPretrialConferenceHeld() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 16.3"
{
  forum frcp
}

/// Civ. LR 16.4: the parties notify the ADR Administrator upon initiating
/// private mediation and within 14 days after its conclusion.
deadline private-mediation-notice-period: 14.days after PrivateMediationConcluded() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 16.4"
{
  forum frcp
}

/// Civ. LR 16.4: within 7 days prior to the first mediation meeting, the
/// parties submit to the mediator a confidential memorandum of their legal
/// and factual positions.
deadline mediation-memorandum-period: 7.days before FirstMediationMeeting() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 16.4"
{
  forum frcp
}

/// Civ. LR 40.1(E)(4)(b)(ii): a civil action seeking to bar or mandate
/// nationwide enforcement of a federal law is randomly assigned or
/// reassigned district-wide unless a party objects within 14 days of
/// assignment or reassignment because the remedy has no implications beyond
/// the parties or a local judge should hear it.
deadline assignment-objection-period: 14.days after CaseAssigned() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 40.1(E)"
{
  forum frcp
}

/// Civ. LR 54.1(A): in all civil cases, requests for attorney's fees are
/// filed no later than 14 days after entry of judgment.
deadline fee-request-period: 14.days after JudgmentEntered() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 54.1(A)"
{
  forum frcp
}

/// Civ. LR 54.1(A): bills of costs are filed within 30 days after entry of
/// judgment.
deadline bill-of-costs-period: 30.days after JudgmentEntered() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 54.1(A)"
{
  forum frcp
}

/// Civ. LR 72.2(A): a party opposing an appeal from a magistrate judge's
/// non-dispositive order files its memorandum of law within 14 days after
/// service of the appeal.
deadline magistrate-appeal-opposition-period: 14.days after MagistrateAppealServed() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 72.2(A)"
{
  forum frcp
}

/// Civ. LR 79.1(B): exhibits in the clerk's custody are taken away by the
/// party who offered them within 60 days after the case is decided unless
/// an appeal is taken.
deadline exhibit-removal-period: 60.days after CaseDecidedUnappealed() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 79.1(B)"
{
  forum frcp
}

/// Civ. LR 79.1(B): where an appeal is taken, exhibits are taken away
/// within 30 days after the filing of the reviewing court's mandate
/// disposing of the case.
deadline exhibit-removal-after-mandate-period: 30.days after MandateFiled() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 79.1(B)"
{
  forum frcp
}

/// Civ. LR 79.1(C): exhibits not removed within 30 days after notice from
/// the clerk may be sold or disposed of as the presiding judge directs.
deadline exhibit-neglect-period: 30.days after ExhibitRemovalNoticeGiven() counted_by frcp6 cite "C.D. Ill. Civ. L.R. 79.1(C)"
{
  forum frcp
}
