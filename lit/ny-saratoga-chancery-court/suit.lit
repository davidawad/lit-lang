module ny-saratoga-chancery-court.suit

// No rule text is vendored: every cite ?(...) and every value ? is a hole
// (Lit.toml).
import ny-state-rules.{ ActionCommenced, JudgmentEntered, NoticeOfAppealFiled }

start commenced

state commenced: "Complaint, petition or appeal filed" by applicant cite ?("N.Y. Rev. Stat. pt. III, ch. 1 (1829): not vendored") {
  note "Historical court: the Court of Chancery sat at Saratoga Springs under Chancellor Walworth until the Constitution of 1846 abolished it; that history is unverified here, no source being vendored. Commencement in the Saratoga Chancery Court: filing period, fees and pleading form are holes. No leading decision is named."
  edge-commenced-served "Process served" -> pleadings {
    event ActionCommenced()
    authority cite ?("N.Y. Ch. R.: not vendored")
  }
}

chance pleadings: "Answer or motion to dismiss" by court cite ?("N.Y. Ch. R.: not vendored") {
  note "Response period and dismissal grounds are holes."
  edge-pleadings-dismissed "Dismissed on the pleadings" -> dismissed p ? {
    authority cite ?("N.Y. Ch. R.: not vendored")
  }
  edge-pleadings-answered "Answered; case proceeds" -> discovery p ? {
    authority cite ?("N.Y. Ch. R.: not vendored")
  }
  edge-pleadings-settled "Settled or withdrawn" -> settled p ? {}
}

state discovery: "Discovery and pretrial" by applicant cite ?("N.Y. Ch. R.: not vendored") {
  note "Discovery scope, limits and scheduling are holes."
  edge-discovery-dispositive "Dispositive motion or trial setting" -> dispositive {
    authority cite ?("N.Y. Ch. R.: not vendored")
  }
}

chance dispositive: "Summary disposition?" by court cite ?("N.Y. Ch. R.: not vendored") {
  note "Summary-judgment standard and timing are holes."
  edge-dispositive-granted "Decided without trial" -> judgment p ? {
    authority cite ?("N.Y. Ch. R.: not vendored")
  }
  edge-dispositive-trial "Tried" -> trial p ? { authority cite ?("N.Y. Ch. R.: not vendored") }
}

state trial: "Trial or hearing" by court cite ?("N.Y. Ch. R.: not vendored") {
  note "Jury availability and trial procedure are holes."
  edge-trial-judgment "Decision rendered" -> judgment {
    authority cite ?("N.Y. Ch. R.: not vendored")
  }
}

state judgment: "Judgment or decision entered" by court cite ?("N.Y. Ch. R.: not vendored") {
  note "Entry, notice of entry and post-judgment motion periods are holes."
  edge-judgment-entered "Judgment entered" -> post-judgment {
    event JudgmentEntered()
    authority cite ?("N.Y. Ch. R.: not vendored")
  }
}

decision post-judgment: "Appeal or review?" by applicant cite ?("N.Y. Ct. for Corr. of Errors: not vendored") {
  note "The appeal period and the court that hears it are holes."
  edge-post-appeal "Appeal or petition for review filed" -> appeal-taken {
    event NoticeOfAppealFiled()
    authority cite ?("N.Y. Ct. for Corr. of Errors: not vendored")
  }
  edge-post-final "No appeal" -> final-no-appeal {}
}

terminal dismissed: "Dismissed" outcome [loss, dismissal] cite ?("N.Y. Ch. R.: not vendored") {
  note "With or without prejudice is a hole."
  payoff ?
}

terminal settled: "Settled or withdrawn" outcome [settlement] cite ?("N.Y. Rev. Stat. pt. III, ch. 1 (1829): not vendored") {
  note "Settlement terms are outside this outline."
  payoff ?
}

terminal appeal-taken: "Appeal or review taken" outcome [final] cite ?("N.Y. Ct. for Corr. of Errors: not vendored") {
  note "The reviewing court is its own package."
  payoff ?
}

terminal final-no-appeal: "Judgment final without appeal" outcome [final] cite ?("N.Y. Ch. R.: not vendored") {
  note "Enforcement is outside this outline."
  payoff ?
}
