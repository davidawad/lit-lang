module core.frcrimp45

import core.calendar.{ delaware-holidays, us-federal-holidays }
import core.time.{ Served, Scheduled, ServiceMethod }

/// FRCrimP 45 from the 1985 amendments (effective August 1, 1985) as the
/// 1996 edition of 18 U.S.C. App. prints it (as amended August 1, 1987; the
/// 1987 Advisory Committee Note calls those amendments "technical. No
/// substantive change is intended"): exclude the day of the act or event,
/// include the last day unless it is a Saturday, Sunday or legal holiday,
/// or, for a filing, a day the clerk's office is inaccessible, and in a
/// period "less than 11 days" exclude intermediate Saturdays, Sundays and
/// legal holidays (45(a); the 1985 Advisory Committee Note extends that
/// exclusion from periods of less than 7 days). 45(e) adds 3 days after
/// service by mail only, "added to the prescribed period": whether before
/// or after the period is counted was contested until the 2007 amendment
/// (see the 2007 version below), and the engine has the 2007 order (SPEC
/// §5.3 step 5); UNVERIFIED for this version and the 2002 one, as for
/// `frcp6` before 2005. Personal delivery and leaving a copy with the clerk
/// add nothing; consented electronic and other means came to criminal
/// cases (through Rule 49(b)) with Civil Rule 5(b)(2)(D) in 2001 and stay
/// unrecognized here. Earlier versions (the credits list 1966 through
/// 1982) are not vendored and stay undeclared. 45(a)'s state holidays are
/// a district's own count, as in every later version. Rule 45 is silent
/// on periods stated in months or years and on hours.
counting frcrimp45 effective [1985-08-01, 2002-12-01) known_at 1985-04-29 cite "FRCrimP (1996 ed.) 45(a)" historical
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  short_period { below: 11.days, count: business_days }
  service_extension {
    Personal: 0.days
    Electronic: unrecognized
    Mail: 3.days
    Clerk: 0.days
    OtherConsented: unrecognized
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCrimP (1996 ed.) 45(e)"
  holidays us-federal-holidays
  forums [frcrimp]
}

/// The 2002 restyling (adopted April 29, 2002, effective December 1, 2002),
/// as the 2002 edition prints it: 45(a) keeps the count, and 45(c) adds 3
/// days after service "in the manner provided under Federal Rule of Civil
/// Procedure 5(b)(2)(B), (C), or (D)": mailing, leaving it with the clerk,
/// and other means consented to, electronic means included (2002 Committee
/// Note). The days are still "added to the period", in the contested
/// order (see the 1985 version). The 2005 amendment (effective December 1,
/// 2005) changes only 45(b)(2) (2005 Committee Note), so this version runs
/// to the 2007 one.
counting frcrimp45 effective [2002-12-01, 2007-12-01) known_at 2002-04-29 supersedes frcrimp45@1985-08-01 cite "FRCrimP (2002 ed.) 45(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  short_period { below: 11.days, count: business_days }
  service_extension {
    Personal: 0.days
    Electronic: 3.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCrimP (2002 ed.) 45(c)"
  holidays us-federal-holidays
  forums [frcrimp]
}

/// The 2007 amendment (adopted April 30, 2007, effective December 1, 2007):
/// the 3 days "are added after the period would otherwise expire under
/// subdivision (a)", the order the pipeline uses (2007 Committee Note,
/// paralleling Civil Rule 6(e)). The 2008 amendment (effective December 1,
/// 2008) renumbers 45(c)'s cross-reference to the restyled Civil Rule
/// 5(b)(2)(C), (D), (E), or (F), "No substantive change is intended" (2008
/// Committee Note): the same four methods, so one version covers both
/// texts. The 2008 edition prints the 2008 text, a later text, cited for
/// 2007-2008 on purpose.
counting frcrimp45 effective [2007-12-01, 2009-12-01) known_at 2007-04-30 supersedes frcrimp45@2002-12-01 cite "FRCrimP (2008 ed.) 45(a)" historical
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  short_period { below: 11.days, count: business_days }
  service_extension {
    Personal: 0.days
    Electronic: 3.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCrimP (2008 ed.) 45(c)"
  holidays us-federal-holidays
  forums [frcrimp]
}

/// FRCrimP 45 as amended by the 2009 time-computation amendments (adopted
/// March 26, 2009, effective December 1, 2009), the text the 2011 edition
/// of 18 U.S.C. App. prints: 45(a) is the count of the 2023 version below,
/// and 45(c) adds 3 days after service "in the manner provided under
/// Federal Rule of Civil Procedure 5(b)(2)(C), (D), (E), or (F)": mailing,
/// leaving it with the clerk, electronic means (E) and other means
/// consented to. Every day now counts: the short-period exclusion of the
/// versions above is gone.
counting frcrimp45 effective [2009-12-01, 2016-12-01) known_at 2009-03-26 supersedes frcrimp45@2007-12-01 cite "FRCrimP (2011 ed.) 45(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 3.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCrimP (2011 ed.) 45(c)"
  holidays us-federal-holidays
  forums [frcrimp]
  allow_hours
}

/// The 2016 amendment (adopted April 28, 2016, effective December 1, 2016)
/// removes electronic service from 45(c): the 3 days follow service under
/// Civil Rule "5(b)(2)(C) (mailing), (D) (leaving with the clerk), or (F)
/// (other means consented to)" only (2017 ed.). The 2018 amendment
/// (effective December 1, 2018) re-points 45(c) at the criminal rules' own
/// service rule, "Rule 49(a)(4)(C), (D), and (E)" (2019 ed.): the same
/// three methods (mailing, leaving with the clerk, other consented
/// nonelectronic means), so the count is unchanged and one version covers
/// both texts.
counting frcrimp45 effective [2016-12-01, 2023-12-01) known_at 2016-04-28 supersedes frcrimp45@2009-12-01 cite "FRCrimP (2017 ed.) 45(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCrimP (2017 ed.) 45(c)"
  holidays us-federal-holidays
  forums [frcrimp]
  allow_hours
}

/// FRCrimP 45 as amended to December 1, 2023 (the vendored edition, as
/// amended to December 1, 2024, prints that as its last amendment): every
/// period "specified in these rules, in any local rule or court order, or in
/// any statute that does not specify a method of computing time" (45(a)),
/// the Speedy Trial Act's included. Its 45(a)(1)-(3) is FRCP 6(a)(1)-(3):
/// exclude the trigger day, count every day, roll a last day off a
/// Saturday, Sunday or legal holiday, count hours, and extend past an
/// inaccessible clerk's office. 45(c) adds 3 days after service "under
/// Rule 49(a)(4)(C), (D), and (E)": mailing, leaving it with the court
/// clerk, and other nonelectronic means consented to in writing; service
/// by the court's electronic-filing system or other consented electronic
/// means (49(a)(3)) and personal delivery (49(a)(4)(A)-(B)) add nothing.
/// The 2023 amendment adds Juneteenth National Independence Day to
/// 45(a)(6)(A)'s list; `us-federal-holidays` has closed it since June 17,
/// 2021, when Congress declared it a holiday (45(a)(6)(B)), so the count is
/// that of the 2016 version above. 45(a)(6)(B)'s other declared holidays
/// stay undeclared (no declaration is vendored), and (C)'s state holidays
/// are a district's own count (`frcrimp45-delaware` below). Rule 45 is
/// silent on periods stated in months or years, so none is counted.
counting frcrimp45 effective [2023-12-01, ..) known_at 2023-04-24 supersedes frcrimp45@2016-12-01 cite "FRCrimP 45(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCrimP 45(c)"
  holidays us-federal-holidays
  forums [frcrimp]
  allow_hours
}

/// FRCrimP 45 in the District of Delaware: each version of `frcrimp45`
/// with Delaware's legal holidays, which 45(a)(6)(C) ("for periods that are
/// measured after an event, any other day declared a holiday by the state
/// where the district court is located", in every text from 2009) makes
/// legal holidays of a forward-counted period only. A D. Del. criminal
/// package names it as its `counting` rule; core's `frcrimp45` stays the
/// federal-only count of every other district. Only the Delaware days the
/// federal calendar lacks close here. It is in force from May 2, 2011, when
/// core's `delaware-holidays` is, and counts no period before.
counting frcrimp45-delaware effective [2011-05-02, 2016-12-01) known_at 2009-03-26 cite "FRCrimP (2011 ed.) 45(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 3.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCrimP (2011 ed.) 45(c)"
  holidays us-federal-holidays
  forward_holidays delaware-holidays cite "FRCrimP 45(a)(6)(C)"
  forums [frcrimp]
  allow_hours
}

/// The 2016 and 2018 texts (2017 and 2019 eds.), as `frcrimp45@2016-12-01`.
counting frcrimp45-delaware effective [2016-12-01, 2023-12-01) known_at 2016-04-28 supersedes frcrimp45-delaware@2011-05-02 cite "FRCrimP (2017 ed.) 45(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCrimP (2017 ed.) 45(c)"
  holidays us-federal-holidays
  forward_holidays delaware-holidays cite "FRCrimP 45(a)(6)(C)"
  forums [frcrimp]
  allow_hours
}

/// The 2023 text, as `frcrimp45@2023-12-01`.
counting frcrimp45-delaware effective [2023-12-01, ..) known_at 2023-04-24 supersedes frcrimp45-delaware@2016-12-01 cite "FRCrimP 45(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCrimP 45(c)"
  holidays us-federal-holidays
  forward_holidays delaware-holidays cite "FRCrimP 45(a)(6)(C)"
  forums [frcrimp]
  allow_hours
}

// Fixtures cite nothing: they are periods for the tests, not rules in
// force, and each test cites the rule it checks.
deadline frcrimp45-14-days: 14.days after Served() counted_by frcrimp45 { forum frcrimp }
deadline frcrimp45-7-days-before: 7.days before Scheduled() counted_by frcrimp45 { forum frcrimp }

deadline frcrimp45-delaware-2-days: 2.days after Served() counted_by frcrimp45-delaware {
  forum frcrimp
}

test "fourteen days count every day" cite "FRCrimP 45(a)(1)(B)"
{
  given Served(Personal) on 2025-03-03
  expect deadline(frcrimp45-14-days) == 2025-03-17
}

test "a last day on a Saturday runs to Monday" cite "FRCrimP 45(a)(1)(C)"
{
  given Served(Personal) on 2025-03-01
  expect deadline(frcrimp45-14-days) == 2025-03-17
}

test "mail adds three days after the period would otherwise expire" cite "FRCrimP 45(c)"
{
  given Served(Mail) on 2025-03-03
  expect deadline(frcrimp45-14-days) == 2025-03-20
}

test "electronic service adds nothing" cite "FRCrimP 45(c)"
{
  given Served(Electronic) on 2025-03-03
  expect deadline(frcrimp45-14-days) == 2025-03-17
}

test "counted back, a Sunday last day moves to Friday" cite "FRCrimP 45(a)(5)"
{
  given Scheduled() on 2025-03-16
  expect deadline(frcrimp45-7-days-before) == 2025-03-07
}

test "Delaware Good Friday rolls a criminal-rule deadline" cite "FRCrimP 45(a)(6)(C)"
{
  given Served(Personal) on 2024-03-27
  expect deadline(frcrimp45-delaware-2-days) == 2024-04-01
}
