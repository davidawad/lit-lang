==> cases/demo-matter.case <- tests/fixtures/demo-scenario.json
// Imported by `litigate import` from tests/fixtures/demo-scenario.json.
case demo-matter
uses demo-court ^0.1.0
as_of 2024-12-01
summary "A demo matter."
notes "Illustrative only."
source "Rule text" { url "https://example.org/rules", as_of 2024-12-01 }
source "Docket study" { as_of ?("2026-06") }
start demo-court::ruling
perspective { applicant: opponent, examiner: self }
facts { demo-court::ruling: demo-court::denied }
stakes { demo-court::won: 1_000_000.usd, demo-court::lost: -2_500.75.usd }
beliefs { observe demo-court::ruling: { demo-court::denied: 3 } }

analysis {
  params: { rate: 650, p_merits: 0.6 }
  remove_edges: [demo-court::denied]
  utility: "applicant_value"
  metrics: { opponent_dollars: "attr(\"opp_hours\", 0) * rate" }
}
==> lit/demo/01-pleading.lit <- tests/fixtures/demo-pack.json
// Imported by `litigate import` from tests/fixtures/demo-pack.json.
module demo.pleading

import demo.pleading-2.{ lost }
import demo.ruling.{ ruling }
import demo.{ pleading-group }

start filed

/// imported
decision filed: "Complaint \"filed\"" by applicant cite "DR 3"
{
  group pleading-group
  note "Line one.\nLine two."
  tags [entry]
  attrs { weight: -1.5 }
  12b-move "Move to dismiss" -> ruling {
    authority cite "DR 12(b)(6)"
    effort 30.hours
    cost 405.usd
    deadline 21.court_days {
      extendable true
      extension_authority "DR 6(b)"
      note "Not jurisdictional."
    }
    duration { mode 4.5.days, max 10.5.days }
    sets [moved]
  }
  _ "Default" -> lost by either {
    deadline 30.days
    duration { min 1.days, mode 2.1.days, max 3.days }
    valence bad
    tags [waiver-trap]
    attrs { opp_hours: 40 }
  }
  _ "Wait" -> filed { duration 7.days }
}
==> lit/demo/02-ruling.lit <- tests/fixtures/demo-pack.json
// Imported by `litigate import` from tests/fixtures/demo-pack.json.
module demo.ruling

import demo.pleading-2.{ lost }
import demo.{ ruling-group }

/// imported
chance ruling: "Ruling" by office cite "DR 12, 56"
{
  group ruling-group
  valence caution
  court_listener_url "https://example.org/op"
  tags [fact]
  _ "Granted" -> won p 0.35 { authority cite ?("Court's inherent power, see DR 1") }
  denied "Denied" -> lost p 0.65 {
    court_listener_url "https://example.org/x"
    action_id "deny-1"
    note "Typical."
    clears [moved]
    requires [moved]
    forbids [late]
  }
}

/// imported
terminal won: "Won" outcome [win, fee-eligible] {
  group ruling-group
  payoff 1_000_000.usd
  payoff_by_flag { sanctioned: 12.5.usd }
}
