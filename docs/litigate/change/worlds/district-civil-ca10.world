# The law in force for the collected rulings at ca10 (lg-fq2.6): the FRCP periods with the 2009 amendment.
# Versions are selected by each trigger's date, so one world holds for every
# ruling there, before and after each amendment.
layers = ["change-deadline-frcp-base", "change-deadline-frcp-2009-amendment"]

[location]
family = "district-civil"
circuit = "ca10"
