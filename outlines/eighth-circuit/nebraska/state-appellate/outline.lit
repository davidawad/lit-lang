// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-ne-state-appellate

start notice-filed

state notice-filed: "Notice of appeal filed" by applicant cite ?("Neb. Rev. Stat. § 25-1912")
{
  note "OUTLINE. Notice under section 25-1912; period is a hole."
  edge-notice-filed-appealability "Notice filed" -> appealability {
    authority cite ?("Neb. Rev. Stat. § 25-1912")
  }
}

decision appealability: "Appellate jurisdiction check" by court cite ?("Neb. Rev. Stat. §§ 25-1902, 24-1106")
{
  note "OUTLINE. Final order under section 25-1902 (verify). No leading decision named."
  edge-appealability-dismissed-jurisdiction "Not an appealable order, or untimely" -> dismissed-jurisdiction {
    authority cite ?("Neb. Rev. Stat. §§ 25-1902, 24-1106")
  }
  edge-appealability-record "Appealable order" -> record {
    authority cite ?("Neb. Rev. Stat. §§ 25-1902, 24-1106")
  }
}

terminal dismissed-jurisdiction: "Dismissed for lack of appellate jurisdiction" outcome [loss] cite ?("Neb. Rev. Stat. §§ 25-1902, 24-1106")
{
  note "OUTLINE. Outcome from the applicant's side."
  payoff ?
}

state record: "Record settled and transmitted" cite ?("Neb. Ct. R. App. P. § 2-107 (verify)")
{
  note "OUTLINE. Record (verify)."
