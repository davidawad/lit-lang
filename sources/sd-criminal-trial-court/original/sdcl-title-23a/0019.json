an xml:space=\"preserve\" class=\"s2048621SENU\">. </span><span class=\"s2048621CL\">Costs and fees on transferred case paid by original county.</span></p><p dir=\"ltr\" class=\"s2048621Normal-000000\"><span class=\"s2048621DefaultParagraphFont\">The payment of all costs and fees incurred as a result of a transfer and all subsequent proceedings shall be paid by the county where the prosecution was commenced.</span></p><p dir=\"ltr\" class=\"s2048621Normal\"><span xml:space=\"preserve\" class=\"s2048621000001\"> </span></p><p dir=\"ltr\" class=\"s2048621Normal\"><span class=\"s2048621SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2048621SCL-000002\"><span>  <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 228.</span></span></p></div></div></body></html></head></html></head></html></head></html>","Credits":null,"StatuteText":null,"Article":null,"Created":null,"CreatedById":null,"LastUpdated":null,"LastUpdatedBy":null,"Repealed":false,"StatuteReferencesReferencesStatute":[],"StatuteReferencesStatute":[]}