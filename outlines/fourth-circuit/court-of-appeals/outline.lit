// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-outline-ca4

start notice-filed

state notice-filed: "Notice of appeal filed in district court" by applicant cite ?("Fed. R. App. P. 3(a)(1)")
{
  note "OUTLINE. Notice is filed with the district court clerk and transmitted here. Notice period is a hole under Fed. R. App. P. 4(a)(1). Tolling: Fed. R. App. P. 4(a)(4)(A). Jurisdictional character of the deadline: Bowles v. Russell, 551 U.S. 205 (2007) (verify). Fees: docketing fee per the court's fee schedule (?)."
  edge-notice-appealability "Appellate jurisdiction checked" -> appealability {
    authority cite ?("Fed. R. App. P. 3(a)(1)")
  }
}

decision appealability: "Court checks appellate jurisdiction" by court cite ?("Fed. R. App. P. 3(a)(1)")
{
  note "OUTLINE. Final decision: 28 U.S.C. § 1291; Catlin v. United States, 324 U.S. 229 (1945) (verify). Interlocutory orders: 28 U.S.C. § 1292(a)-(b). Collateral order doctrine: Mohawk Industries, Inc. v. Carpenter, 558 U.S. 100 (2009) (verify). Pendent appellate jurisdiction: Swint v. Chambers County Commission, 514 U.S. 35 (1995) (verify)."
  edge-appeal-final "Final decision" -> docketed {
    authority cite ?("Fed. R. App. P. 3(a)(1)")
  }
  edge-appeal-leave "Interlocutory, leave sought" -> leave-petition {
    authority cite ?("Fed. R. App. P. 5")
  }
  edge-appeal-dismissed "Not appealable" -> dismissed-jurisdiction {
    authority cite ?("Fed. R. App. P. 3(a)(1)")
  }
}

state leave-petition: "Petition for permission to appeal" by applicant cite ?("Fed. R. App. P. 5")
{
  note "OUTLINE. Permissive appeal from an interlocutory order: 28 U.S.C. § 1292(b) and Fed. R. App. P. 5. Petition period is a hole."
  edge-leave-granted "Leave granted" -> docketed {
    authority cite ?("Fed. R. App. P. 5(c)")
  }
  edge-leave-denied "Leave denied" -> dismissed-jurisdiction {
    authority cite ?("Fed. R. App. P. 5(d)")
  }
}

state docketed: "Appeal docketed; briefing schedule set" by office cite ?("Fed. R. App. P. 12(a)")
{
  note "OUTLINE. Docketing and fee. Disclosure statement: Fed. R. App. P. 26.1 and 4th Cir. R. 26.1. Fed. R. App. P. 26.1 is a separate filing for corporate parties."
  edge-docketed-record "Record transmitted" -> record-filed {
    authority cite ?("Fed. R. App. P. 11(b)")
  }
}

state record-filed: "Record on appeal transmitted" by office cite ?("Fed. R. App. P. 10, 11(b)")
{
  note "OUTLINE. Record and appendix. Form and content: 4th Cir. R. 28 and 32 (verify)."
  edge-record-briefing "Briefing begins" -> briefing {
    authority cite ?("Fed. R. App. P. 31(a)(1)")
  }
}

state briefing: "Opening, answering and reply briefs" by applicant cite ?("Fed. R. App. P. 28, 31(a)")
{
  note "OUTLINE. Principal briefs under Fed. R. App. P. 28 and 31(a). Length and form limits: Fed. R. App. P. 32(a)(7); numbers are holes here. Local brief rules: 4th Cir. R. 28 and 32 (verify). Amicus briefs: Fed. R. App. P. 29."
  edge-briefing-argument "Briefing closed" -> argument {
    authority cite ?("Fed. R. App. P. 31(a)(2)-(3)")
  }
}

decision argument: "Oral argument or submission on briefs" by court cite ?("Fed. R. App. P. 34(a)")
{
  note "OUTLINE. Argument decision under Fed. R. App. P. 34(a). Local argument rules: 4th Cir. R. 34 (verify)."
  edge-argument-argued "Argued" -> disposition {
    authority cite ?("Fed. R. App. P. 34")
  }
  edge-argument-submitted "Submitted without argument" -> disposition {
    authority cite ?("Fed. R. App. P. 34(a)(2)")
  }
}

chance disposition: "Panel decision" by court cite ?("Fed. R. App. P. 36")
{
  note "OUTLINE. Probabilities are holes; no calibration. Judgment and mandate: Fed. R. App. P. 36 and 41. Standards of review are case-specific."
  edge-disp-affirmed "Affirmed" -> opinion-issued p ? {
  }
  edge-disp-reversed "Reversed or vacated" -> opinion-issued p ? {
  }
  edge-disp-remanded "Remanded for further proceedings" -> opinion-issued p ? {
  }
}

decision opinion-issued: "Opinion and judgment issued" by court cite ?("Fed. R. App. P. 36, 40")
{
  note "OUTLINE. Next step: rehearing or mandate. Panel rehearing: Fed. R. App. P. 40. Rehearing en banc: Fed. R. App. P. 35. Local rehearing rules: 4th Cir. R. 35 and 40 (verify)."
  edge-opinion-rehearing "Petition for rehearing" -> rehearing {
    authority cite ?("Fed. R. App. P. 40")
  }
  edge-opinion-cert "Petition for certiorari" -> cert-petition {
    authority cite ?("Sup. Ct. R. 13")
  }
  edge-opinion-mandate "No further review; mandate issues" -> mandate-issued {
    authority cite ?("Fed. R. App. P. 41(b)")
  }
}

state rehearing: "Rehearing petition pending" by applicant cite ?("Fed. R. App. P. 35, 40")
{
  note "OUTLINE. Rehearing period is a hole. A timely petition stays the mandate under Fed. R. App. P. 41(b)."
  edge-rehearing-decided "Rehearing decided" -> opinion-issued {
    authority cite ?("Fed. R. App. P. 40")
  }
}

state cert-petition: "Petition for certiorari to the Supreme Court" by applicant cite ?("Sup. Ct. R. 13")
{
  note "OUTLINE. Certiorari period and extensions are holes under Sup. Ct. R. 13. Stay of mandate only on order."
  edge-cert-decided "Court acts on petition" -> cert-decision {
  }
}

chance cert-decision: "Supreme Court acts on petition" by court cite ?("Sup. Ct. R. 10")
{
  note "OUTLINE. Certiorari is discretionary. Probabilities are holes."
  edge-certd-granted "Granted" -> supreme-court-merits p ? {
  }
  edge-certd-denied "Denied" -> mandate-issued p ? {
  }
}

terminal mandate-issued: "Mandate issued; appeal concluded" outcome [final] cite ?("Fed. R. App. P. 41(a)")
{
  note "OUTLINE. Mandate issues under Fed. R. App. P. 41(b) after the rehearing period and any stay. Costs: Fed. R. App. P. 39."
  payoff ?
}

terminal dismissed-jurisdiction: "Appeal dismissed for want of jurisdiction" outcome [loss] cite ?("Fed. R. App. P. 3(a)(1)")
{
  note "OUTLINE. Dismissal for lack of appellate jurisdiction or untimely notice. See Bowles v. Russell, above (verify)."
  payoff ?
}

terminal supreme-court-merits: "Supreme Court grants review" outcome [final] cite ?("Sup. Ct. R. 10")
{
  note "OUTLINE. Merits review in the Supreme Court. Outcome is outside this outline."
  payoff ?
}

