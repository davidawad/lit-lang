module core.states.connecticut

import core.calendar.{ us-federal-holidays }

/// The legal holidays of Connecticut (Conn. Gen. Stat. § 1-4) that
/// `us-federal-holidays` does not already close: Lincoln Day, February 12, held
/// the Friday before when it falls on a Saturday and the Monday after when on a
/// Sunday. The section's other days are federal holidays, observed as §
/// 6103(b)(1) observes them. Closed from the date of the vendored edition (the
/// 2026 Supplement, revised to January 1, 2026). Not modeled: the days the
/// Governor or the President appoints for thanksgiving, fasting or religious
/// observance, which no vendored source lists (a last day on one is the earlier
/// date).
calendar connecticut-holidays cite "Conn. Gen. Stat. § 1-4"
{
  lincoln-day: fixed(2, 12) effective [2026-01-01, ..) observed nearest_weekday
}

/// FRCP 6 in the district courts of Connecticut: the 2023 text
/// (`frcp6@2023-12-01`) with `connecticut-holidays`, which 6(a)(6)(C)
/// ("any day declared a holiday by ... the state where the district court
/// is located") makes legal holidays "for periods that are measured after
/// an event" only. A district package there names it as its `counting`
/// rule and `recounts` lit/frcp. A calendar day is closed only from the
/// date its entry is in force; before it the count is `frcp6`'s.
counting frcp6-connecticut effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCP 6(d)"
  holidays us-federal-holidays
  forward_holidays connecticut-holidays cite "FRCP 6(a)(6)(C)"
  forums [frcp]
  allow_hours
  end_of_month clamp
}

/// FRBP 9006(a) (`frbp9006`) in the bankruptcy courts of Connecticut:
/// `connecticut-holidays` are legal holidays for a period counted forward only (FRBP
/// 9006(a)(6)(C), "any day declared a holiday by the state where the
/// district court is located"). A bankruptcy package there names it as its
/// `counting` rule and `recounts` lit/frbp. A calendar day is closed only
/// from the date its entry is in force.
counting frbp9006-connecticut effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays connecticut-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-ct]
  allow_hours
  end_of_month clamp
}
