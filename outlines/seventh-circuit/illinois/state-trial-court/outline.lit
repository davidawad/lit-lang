// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-il-trial-court

import outline-il-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start complaint-filed

state complaint-filed: "Action commenced" by applicant cite ?("735 ILCS 5/2-201")
{
  note "OUTLINE. Commencement by filing and summons (verify). Illinois is a fact-pleading state (verify)."
  edge-complaint-filed-response-due "Summons served" -> response-due { event ActionCommenced()
    authority cite ?("735 ILCS 5/2-203")
  }
}

state response-due: "Response due: answer or motion" cite ?("Ill. S. Ct. R. 181(a)")
{
  note "OUTLINE. Response period is a hole. Section 2-615 tests legal sufficiency; section 2-619 tests affirmative matter. Response period is a hole."
  edge-response-due-default-entered "No timely response" -> default-entered {
    authority cite ?("735 ILCS 5/2-1301")
  }
  edge-response-due-motion-ruling "Motion to dismiss filed" -> motion-ruling {
    authority cite ?("735 ILCS 5/2-615")
  }
  edge-response-due-sched "Answer filed" -> sched {
    authority cite ?("Ill. S. Ct. R. 181(a)")
  }
}

decision motion-ruling: "Motion to dismiss ruling" by court cite ?("735 ILCS 5/2-615")
{
  note "OUTLINE. Marshall v. Burger King Corp., 222 Ill. 2d 422 (2006) (fact pleading under 2-615; verify)."
  edge-motion-ruling-dismissed-with-prejudice "Dismissed with prejudice" -> dismissed-with-prejudice {
    authority cite ?("735 ILCS 5/2-619")
  }
  edge-motion-ruling-response-due "Dismissed with leave to amend" -> response-due { event ActionCommenced()
    authority cite ?("735 ILCS 5/2-616")
  }
  edge-motion-ruling-sched "Denied" -> sched {
    authority cite ?("735 ILCS 5/2-615")
  }
}

state sched: "Scheduling order and initial disclosures" cite ?("Ill. S. Ct. R. 218")
{
  note "OUTLINE. Case management under Rule 218; standing orders are holes."
  edge-sched-discovery "Order entered" -> discovery {
    authority cite ?("Ill. S. Ct. R. 218")
  }
}

state discovery: "Discovery" cite ?("Ill. S. Ct. R. 201(k), 213, 214, 216")
{
  note "OUTLINE. Rule 201(k) meet-and-confer; discovery limits are holes."
  edge-discovery-sj-ruling "Dispositive motion filed" -> sj-ruling {
    authority cite ?("735 ILCS 5/2-1005")
  }
  edge-discovery-dismissed-with-prejudice "Discovery sanction dismisses claims" -> dismissed-with-prejudice {
    authority cite ?("Ill. S. Ct. R. 219(c)")
  }
  edge-discovery-settled "Settlement or voluntary dismissal" -> settled {
    authority cite ?("735 ILCS 5/2-1009")
  }
  edge-discovery-pretrial "No dispositive motion" -> pretrial {
    authority cite ?("Ill. S. Ct. R. 218")
  }
}

decision sj-ruling: "Summary judgment ruling" by court cite ?("735 ILCS 5/2-1005")
{
  note "OUTLINE. Adams v. Northern Illinois Gas Co., 211 Ill. 2d 32 (2004) (summary judgment; verify)."
  edge-sj-ruling-judgment-applicant "Granted for applicant" -> judgment-applicant {
    authority cite ?("735 ILCS 5/2-1201")
  }
  edge-sj-ruling-judgment-opponent "Granted for opponent" -> judgment-opponent {
    authority cite ?("735 ILCS 5/2-1201")
  }
  edge-sj-ruling-pretrial "Denied" -> pretrial {
    authority cite ?("735 ILCS 5/2-1005")
  }
}

state pretrial: "Pretrial order" cite ?("Ill. S. Ct. R. 218")
{
  note "OUTLINE. Pretrial conference, order and trial setting."
  edge-pretrial-trial "Trial set" -> trial {
    authority cite ?("Ill. S. Ct. R. 218")
  }
}

state trial: "Trial (jury or bench)" cite ?("735 ILCS 5/2-1105")
{
  note "OUTLINE. Trial and findings or verdict."
  edge-trial-judgment-applicant "Verdict or findings for applicant" -> judgment-applicant {
    authority cite ?("735 ILCS 5/2-1201")
  }
  edge-trial-judgment-opponent "Verdict or findings for opponent" -> judgment-opponent {
    authority cite ?("735 ILCS 5/2-1201")
  }
}

state judgment-applicant: "Judgment for applicant entered" cite ?("735 ILCS 5/2-1201")
{
  note "OUTLINE. Entry of judgment. Post-trial motions under 2-1202; relief from final judgment under 2-1401 (verify)."
  edge-judgment-applicant-post-judgment-ruling "Post-judgment motion" -> post-judgment-ruling { event JudgmentEntered()
    authority cite ?("735 ILCS 5/2-1202")
  }
  edge-judgment-applicant-appellate-review "Notice of appeal filed" -> appellate-review { event NoticeOfAppealFiled()
    authority cite ?("Ill. S. Ct. R. 303(a)")
  }
  edge-judgment-applicant-final-win "No appeal within time" -> final-win {
    authority cite ?("Ill. S. Ct. R. 303(a)(1)")
  }
}

state judgment-opponent: "Judgment for opponent entered" cite ?("735 ILCS 5/2-1201")
{
  note "OUTLINE. Entry of judgment. Post-trial motions under 2-1202; relief from final judgment under 2-1401 (verify)."
  edge-judgment-opponent-post-judgment-ruling "Post-judgment motion" -> post-judgment-ruling { event JudgmentEntered()
    authority cite ?("735 ILCS 5/2-1202")
  }
  edge-judgment-opponent-appellate-review "Notice of appeal filed" -> appellate-review { event NoticeOfAppealFiled()
    authority cite ?("Ill. S. Ct. R. 303(a)")
  }
  edge-judgment-opponent-final-loss "No appeal within time" -> final-loss {
    authority cite ?("Ill. S. Ct. R. 303(a)(1)")
  }
}

decision post-judgment-ruling: "Post-judgment motion ruling" by court cite ?("735 ILCS 5/2-1202")
{
  note "OUTLINE. Post-judgment motions toll the appeal clock; verify tolling rule."
  edge-post-judgment-ruling-pretrial "Granted: new trial" -> pretrial {
    authority cite ?("735 ILCS 5/2-1202")
  }
  edge-post-judgment-ruling-appellate-review "Denied: appeal clock runs from order" -> appellate-review { event NoticeOfAppealFiled()
    authority cite ?("Ill. S. Ct. R. 303(a)(1)")
  }
}

terminal default-entered: "Default entered against opponent" outcome [win] cite ?("735 ILCS 5/2-1301")
{
  note "OUTLINE. Default under the rule; judgment by default is a separate entry. Outcome is from the applicant's side."
  payoff ?
}

terminal dismissed-with-prejudice: "Dismissed with prejudice" outcome [loss] cite ?("735 ILCS 5/2-619")
{
  note "OUTLINE. Outcome from the applicant's side."
  payoff ?
}

terminal settled: "Settled or voluntarily dismissed" outcome [settlement] cite ?("735 ILCS 5/2-1009")
{
  note "OUTLINE. Settlement terms are a hole."
  payoff ?
}

terminal final-win: "Final judgment for applicant, no appeal" outcome [win] cite ?("Ill. S. Ct. R. 303(a)(1)")
{
  note "OUTLINE. Judgment final when the appeal period lapses."
  payoff ?
}

terminal final-loss: "Final judgment for opponent, no appeal" outcome [loss] cite ?("Ill. S. Ct. R. 303(a)(1)")
{
  note "OUTLINE. Judgment final when the appeal period lapses."
  payoff ?
}

terminal appellate-review: "Appeal taken: continue in the appellate package" cite ?("Ill. S. Ct. R. 303(a)")
{
  note "OUTLINE. Hand-off to the state's appellate court packages."
  payoff ?
}
