module flnd-local-rules.local-rules

import core.frcp6.{ frcp6-florida }

// The Northern District's own periods. A motion memorandum must not
// exceed 8,000 words, a reply memorandum 3200 words, a notice of
// supplemental authority 350 words, each with a word-count certificate
// (Local Rule 7.1(F), (I), (J)); a summary judgment memorandum is up to
// 8,000 words and its reply up to 3,200 (Local Rule 56.1(B)-(D)). A
// reply is filed only on a summary judgment motion or by leave (Local
// Rule 7.1(I)). Before a motion, the attorneys confer and certify it
// (Local Rule 7.1(B), (C)), with at least 24 hours, counted under FRCP 6,
// ordinarily afforded to answer a written communication (Local Rule
// 7.1(B)). Without an order, the FRCP 26(f) conference deadline is the
// Federal Rules' (Local Rule 16.1).
/// A motion other than a summary judgment motion is served (Local Rule
/// 7.1(E)).
event MotionServed()
/// A case is removed from state court (Local Rule 7.2).
event CaseRemoved()
/// The supporting memorandum for a motion pending on removal is filed
/// (Local Rule 7.2(B)).
event RemovedMotionMemorandumFiled()
/// A summary judgment motion is filed and served (Local Rule 56.1(C)).
event SummaryJudgmentMotionServed()
/// A memorandum opposing summary judgment is filed (Local Rule 56.1(D)).
event SummaryJudgmentOppositionFiled()
/// Judgment is entered, or with no judgment the case is closed (Local
/// Rules 54.1(B), 54.2(A)).
event JudgmentEntered()
/// The court determines that a party is entitled to a fee award (Local
/// Rule 54.1(E)).
event FeeEntitlementDetermined()
/// A motion to determine the fee amount is served (Local Rule 54.1(F)).
event FeeAmountMotionServed()
/// A memorandum opposing the fee amount is filed (Local Rule 54.1(G)).
event FeeAmountOppositionFiled()
/// A verified bill of costs is filed (Local Rule 54.2(A)).
event BillOfCostsFiled()
/// The clerk acts on the bill of costs (Local Rule 54.2(C)).
event ClerkTaxedCosts()

/// Local Rule 7.1(E): unless otherwise ordered, a memorandum opposing a
/// motion (other than a summary judgment motion) is due 14 days after
/// service, without a 3-day extension for electronic service. The court
/// may grant a motion by default if no required memorandum is filed (Local
/// Rule 7.1(H)).
deadline opposition-memorandum-period: 14.days after MotionServed() counted_by frcp6-florida cite "N.D. Fla. Loc. R. 7.1(E)"
/// Local Rule 7.2(A): the removing party files a copy of each paper filed
/// or served in the state court at removal if feasible, and in any event
/// within 14 days after removal.
deadline state-court-papers-period: 14.days after CaseRemoved() counted_by frcp6-florida cite "N.D. Fla. Loc. R. 7.2(A)"
/// Local Rule 7.2(B): for a motion pending in state court at removal, the
/// supporting memorandum is due 14 days after removal.
deadline removed-motion-memorandum-period: 14.days after CaseRemoved() counted_by frcp6-florida cite "N.D. Fla. Loc. R. 7.2(B)"
/// Local Rule 7.2(B): the opposing memorandum is due 14 days after the
/// later of the removal or the filing of the supporting memorandum; this
/// period runs from the supporting memorandum.
deadline removed-motion-opposition-period: 14.days after RemovedMotionMemorandumFiled() counted_by frcp6-florida cite "N.D. Fla. Loc. R. 7.2(B)"
/// Local Rule 56.1(C): an opposing party files its memorandum within 21
/// days, without a 3-day extension for electronic service of the motion.
deadline summary-judgment-opposition-period: 21.days after SummaryJudgmentMotionServed() counted_by frcp6-florida cite "N.D. Fla. Loc. R. 56.1(C)"
/// Local Rule 56.1(D): a reply memorandum is due 7 days after the opposing
/// memorandum is filed, without a 3-day extension for electronic service.
deadline summary-judgment-reply-period: 7.days after SummaryJudgmentOppositionFiled() counted_by frcp6-florida cite "N.D. Fla. Loc. R. 56.1(D)"
/// Local Rule 54.1(B): a motion to determine entitlement to fees is due 14
/// days after entry of the judgment or, with no judgment, after the case is
/// closed; an appeal does not extend it unless the court so orders.
deadline fee-entitlement-motion-period: 14.days after JudgmentEntered() counted_by frcp6-florida cite "N.D. Fla. Loc. R. 54.1(B)"
/// Local Rule 54.1(E): once entitlement is determined, the party files its
/// time and independent-attorney declarations within 30 days.
deadline fee-amount-filing-period: 30.days after FeeEntitlementDetermined() counted_by frcp6-florida cite "N.D. Fla. Loc. R. 54.1(E)"
/// Local Rule 54.1(F): an opposing memorandum on the fee amount is due
/// within 30 days after the motion is served.
deadline fee-amount-opposition-period: 30.days after FeeAmountMotionServed() counted_by frcp6-florida cite "N.D. Fla. Loc. R. 54.1(F)"
/// Local Rule 54.1(G): after the attorneys confer again, the parties file
/// a notice of any agreement 14 days after the opposing memorandum was
/// filed.
deadline fee-conference-notice-period: 14.days after FeeAmountOppositionFiled() counted_by frcp6-florida cite "N.D. Fla. Loc. R. 54.1(G)"
/// Local Rule 54.2(A): the bill of costs is due 14 days after entry of the
/// judgment or, with no judgment, after the case is closed.
deadline bill-of-costs-period: 14.days after JudgmentEntered() counted_by frcp6-florida cite "N.D. Fla. Loc. R. 54.2(A)"
/// Local Rule 54.2(A): any other party may file a memorandum in opposition
/// within 14 days after the bill of costs is filed.
deadline cost-opposition-period: 14.days after BillOfCostsFiled() counted_by frcp6-florida cite "N.D. Fla. Loc. R. 54.2(A)"
/// Local Rule 54.2(C): the court may review the clerk's action on a motion
/// filed within 7 days after it.
deadline cost-review-period: 7.days after ClerkTaxedCosts() counted_by frcp6-florida cite "N.D. Fla. Loc. R. 54.2(C)"

test "an opposing memorandum is due 14 days after service" cite "N.D. Fla. Loc. R. 7.1(E)"
{
  given MotionServed() on 2026-03-02
  expect deadline(opposition-memorandum-period) == 2026-03-16
}

test "state-court papers are filed within 14 days after removal" cite "N.D. Fla. Loc. R. 7.2(A)"
{
  given CaseRemoved() on 2026-03-02
  expect deadline(state-court-papers-period) == 2026-03-16
}

test "a removed motion's supporting memorandum is due 14 days after removal" cite "N.D. Fla. Loc. R. 7.2(B)"
{
  given CaseRemoved() on 2026-03-02
  expect deadline(removed-motion-memorandum-period) == 2026-03-16
}

test "a removed motion's opposition is due 14 days after the supporting memorandum" cite "N.D. Fla. Loc. R. 7.2(B)"
{
  given RemovedMotionMemorandumFiled() on 2026-03-16
  expect deadline(removed-motion-opposition-period) == 2026-03-30
}

test "a summary judgment opposition is due 21 days after service" cite "N.D. Fla. Loc. R. 56.1(C)"
{
  given SummaryJudgmentMotionServed() on 2026-03-02
  expect deadline(summary-judgment-opposition-period) == 2026-03-23
}

test "a summary judgment reply is due 7 days after the opposition" cite "N.D. Fla. Loc. R. 56.1(D)"
{
  given SummaryJudgmentOppositionFiled() on 2026-03-23
  expect deadline(summary-judgment-reply-period) == 2026-03-30
}

test "a fee entitlement motion is due 14 days after judgment" cite "N.D. Fla. Loc. R. 54.1(B)"
{
  given JudgmentEntered() on 2026-06-01
  expect deadline(fee-entitlement-motion-period) == 2026-06-15
}

test "fee amount declarations are due 30 days after entitlement" cite "N.D. Fla. Loc. R. 54.1(E)"
{
  given FeeEntitlementDetermined() on 2026-07-01
  expect deadline(fee-amount-filing-period) == 2026-07-31
}

test "a fee amount opposition is due 30 days after service" cite "N.D. Fla. Loc. R. 54.1(F)"
{
  given FeeAmountMotionServed() on 2026-07-31
  expect deadline(fee-amount-opposition-period) == 2026-08-31
}

test "the notice after the second fee conference is due 14 days after the opposition" cite "N.D. Fla. Loc. R. 54.1(G)"
{
  given FeeAmountOppositionFiled() on 2026-08-31
  expect deadline(fee-conference-notice-period) == 2026-09-14
}

test "the bill of costs is due 14 days after judgment" cite "N.D. Fla. Loc. R. 54.2(A)"
{
  given JudgmentEntered() on 2026-06-01
  expect deadline(bill-of-costs-period) == 2026-06-15
}

test "a cost opposition is due 14 days after the bill" cite "N.D. Fla. Loc. R. 54.2(A)"
{
  given BillOfCostsFiled() on 2026-06-15
  expect deadline(cost-opposition-period) == 2026-06-29
}

test "review of the clerk's action is moved within 7 days" cite "N.D. Fla. Loc. R. 54.2(C)"
{
  given ClerkTaxedCosts() on 2026-07-01
  expect deadline(cost-review-period) == 2026-07-08
}
