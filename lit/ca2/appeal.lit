module ca2.appeal

import core.frap26.{ frap26 }
import frap.events.{ NoticeOfAppealFiled }
import frap.filing

// The FRAP periods are lit/frap's: the notice-of-appeal periods of FRAP
// 4(a)(1), the transcript-order period of FRAP 10(b)(1), the rehearing
// periods of FRAP 40(d)(1), which 2d Cir. R. 40.1(e) and 40.2 adopt, and
// the mandate period of FRAP 41(b). This package is the Second Circuit's
// layer over them: it declares the circuit's own periods, the briefing
// schedule the clerk "so orders" from the parties' scheduling requests in
// place of FRAP 31(a)(1) (2d Cir. R. 31.2(a)), and the word limits that
// replace FRAP 32(a)(7)'s, as FRAP 32(e) lets a local rule do. The leading
// decisions on appellate jurisdiction and the notice deadline are
// lit/frap's.
/// The circuit clerk's docketing notice, assigning a docket number and
/// enclosing the appellate docket sheet, is received (2d Cir. R. 12.3(a)).
event DocketingNoticeReceived()
/// The "ready date": the later of the appellant's receipt of the last
/// transcript, its filing of the certificate that no transcript will be
/// ordered, or the filing of the record in a FRAP 15 proceeding (2d Cir.
/// R. 31.2(a)(1)(A)).
event ReadyDate()
/// The last appellant's brief is filed (2d Cir. R. 31.2(a)(1)(B)).
event LastAppellantBriefFiled()
/// The last cross-appellant's brief is filed (2d Cir. R. 31.2(a)(1)(C)).
event LastCrossAppellantBriefFiled()
/// The last appellee's brief is filed (2d Cir. R. 31.2(a)(2), 34.1(a)).
event LastAppelleeBriefFiled()
/// The clerk notifies the parties that the appeal, from a threshold
/// dismissal, is placed on the Expedited Appeals Calendar (2d Cir. R.
/// 31.2(b)(1)-(3)).
event XacPlacementNotified()
/// On the Expedited Appeals Calendar, the last appellant's brief is filed
/// (2d Cir. R. 31.2(b)(3)(B)).
event XacLastAppellantBriefFiled()
/// On the Expedited Appeals Calendar, the last appellee's brief is filed
/// (2d Cir. R. 31.2(b)(3)(C)).
event XacLastAppelleeBriefFiled()
/// The date a brief is due, the anchor of the motion to file an oversized
/// brief (2d Cir. R. 27.1(e)(3)).
event BriefDue()
/// The court enters an order on a motion under FRAP 27(b) (2d Cir. R.
/// 27.1(g)).
event MotionOrderEntered()
/// An order dismisses the appeal for failure to timely file a brief (2d
/// Cir. R. 27.1(i)).
event BriefDefaultDismissalEntered()
/// Judgment is entered in a direct criminal appeal (2d Cir. R. 40.1(b)).
event CriminalAppealJudgmentEntered()

/// A principal brief is acceptable if it contains no more than 14,000
/// words, in place of FRAP 32(a)(7)'s limits.
limit principal-brief override frap.filing.principal-brief {
  words <= 14_000 cite "2d Cir. R. 32.1(a)(4)(A)"
} cite "2d Cir. R. 32.1(a)(4)(A)"

/// A reply brief is acceptable if it contains no more than 7,000 words.
limit reply-brief { words <= 7_000 cite "2d Cir. R. 32.1(a)(4)(B)" } cite "2d Cir. R. 32.1(a)(4)(B)"

/// In a cross-appeal, the appellant's principal brief and its
/// response-and-reply brief: no more than 14,000 words each.
limit cross-appellant-brief {
  words <= 14_000 cite "2d Cir. R. 28.1.1(a)"
} cite "2d Cir. R. 28.1.1(a)"

/// In a cross-appeal, the appellee's principal-and-response brief: no
/// more than 16,500 words.
limit cross-appellee-principal-brief {
  words <= 16_500 cite "2d Cir. R. 28.1.1(b)"
} cite "2d Cir. R. 28.1.1(b)"

/// In a cross-appeal, the appellee's reply brief: no more than 7,000
/// words.
limit cross-appellee-reply-brief {
  words <= 7_000 cite "2d Cir. R. 28.1.1(c)"
} cite "2d Cir. R. 28.1.1(c)"

/// An appendix over 300 pages is divided into volumes, none over 300
/// pages.
limit appendix-volume { pages <= 300 cite "2d Cir. R. 32.1(b)(2)" } cite "2d Cir. R. 32.1(b)(2)"

/// A reply brief (2d Cir. R. 31.2(a)(2)).
event ReplyBriefFiled() paper reply-brief
/// In a cross-appeal, the appellant's principal or response-and-reply
/// brief (2d Cir. R. 28.1.1(a)).
event CrossAppellantBriefFiled() paper cross-appellant-brief
/// In a cross-appeal, the appellee's principal-and-response brief (2d
/// Cir. R. 28.1.1(b)).
event CrossAppelleePrincipalBriefFiled() paper cross-appellee-principal-brief
/// In a cross-appeal, the appellee's reply brief (2d Cir. R. 28.1.1(c)).
event CrossAppelleeReplyBriefFiled() paper cross-appellee-reply-brief
/// One volume of an appendix (2d Cir. R. 30.1, 32.1(b)).
event AppendixVolumeFiled() paper appendix-volume

/// In a civil or agency case, the appellant completes the docketing
/// requirements (Form C or C-A with addenda, Form D or D-P, and the
/// docketing fee or notice of an in forma pauperis motion) within 14 days
/// after filing the notice of appeal. (The same period runs from a FRAP 15
/// petition or an order granting permission under FRAP 5, not modeled.)
deadline docketing-requirements-period: 14.days after NoticeOfAppealFiled() counted_by frap26 cite "2d Cir. R. 12.1(a)"
{
  forum frap
}

/// Every party files the Acknowledgment and Notice of Appearance Form
/// within 14 days after receiving the clerk's docketing notice.
deadline appearance-form-period: 14.days after DocketingNoticeReceived() counted_by frap26 cite "2d Cir. R. 12.3(a)"
{
  forum frap
}

/// The appellant notifies the clerk in writing of the deadline it requests
/// for its brief within 14 days after the ready date.
deadline appellant-scheduling-request-period: 14.days after ReadyDate() counted_by frap26 cite "2d Cir. R. 31.2(a)(1)(A)"
{
  forum frap
}

/// The deadline the appellant requests must be within 91 days after the
/// ready date, unless a voluminous record or extreme hardship justifies a
/// later one (2d Cir. R. 31.2(a)(1)(D)).
deadline appellant-brief-latest-request-period: 91.days after ReadyDate() counted_by frap26 cite "2d Cir. R. 31.2(a)(1)(A)"
{
  forum frap
}

/// If the appellant submits no scheduling request, its brief is due 40
/// days after the ready date.
deadline appellant-brief-default-period: 40.days after ReadyDate() counted_by frap26 cite "2d Cir. R. 31.2(a)(1)(A)"
{
  forum frap
}

/// The appellee notifies the clerk in writing of the deadline it requests
/// for its brief within 14 days after the last appellant's brief is filed.
deadline appellee-scheduling-request-period: 14.days after LastAppellantBriefFiled() counted_by frap26 cite "2d Cir. R. 31.2(a)(1)(B)"
{
  forum frap
}

/// The deadline the appellee requests must be within 91 days after the
/// last appellant's brief is filed, absent the showing of 2d Cir. R.
/// 31.2(a)(1)(D).
deadline appellee-brief-latest-request-period: 91.days after LastAppellantBriefFiled() counted_by frap26 cite "2d Cir. R. 31.2(a)(1)(B)"
{
  forum frap
}

/// If the appellee submits no scheduling request, its brief is due 30 days
/// after the last appellant's brief is filed.
deadline appellee-brief-default-period: 30.days after LastAppellantBriefFiled() counted_by frap26 cite "2d Cir. R. 31.2(a)(1)(B)"
{
  forum frap
}

/// In a cross-appeal, the appellant-cross-appellee notifies the clerk of
/// the deadline it requests for its brief within 14 days after the last
/// cross-appellant's brief is filed.
deadline cross-appeal-scheduling-request-period: 14.days after LastCrossAppellantBriefFiled() counted_by frap26 cite "2d Cir. R. 31.2(a)(1)(C)"
{
  forum frap
}

/// The deadline the appellant-cross-appellee requests must be within 60
/// days after the last cross-appellant's brief is filed, absent the
/// showing of 2d Cir. R. 31.2(a)(1)(D).
deadline cross-appeal-brief-latest-request-period: 60.days after LastCrossAppellantBriefFiled() counted_by frap26 cite "2d Cir. R. 31.2(a)(1)(C)"
{
  forum frap
}

/// If the appellant-cross-appellee submits no scheduling request, its
/// brief is due 30 days after the last cross-appellant's brief is filed.
deadline cross-appeal-brief-default-period: 30.days after LastCrossAppellantBriefFiled() counted_by frap26 cite "2d Cir. R. 31.2(a)(1)(C)"
{
  forum frap
}

/// A reply brief must be filed within 21 days after the last appellee's
/// brief is filed, a trigger FRAP 31(a)(1) (service) does not have.
deadline circuit-reply-brief-period: 21.days after LastAppelleeBriefFiled() counted_by frap26 cite "2d Cir. R. 31.2(a)(2)"
{
  forum frap
}

/// Each party files an Oral Argument Statement Form within 14 days after
/// the last appellee's brief is filed; a party that does not is taken not
/// to seek argument. Not on the Non-Argument Calendar (2d Cir. R.
/// 34.1(f)).
deadline oral-argument-statement-period: 14.days after LastAppelleeBriefFiled() counted_by frap26 cite "2d Cir. R. 34.1(a)"
{
  forum frap
}

/// On the Expedited Appeals Calendar, the appellant files its brief within
/// 35 days of the clerk's notice of placement.
deadline xac-appellant-brief-period: 35.days after XacPlacementNotified() counted_by frap26 cite "2d Cir. R. 31.2(b)(3)(A)"
{
  forum frap
}

/// On the Expedited Appeals Calendar, the appellee files its brief within
/// 35 days after the last appellant's brief is filed.
deadline xac-appellee-brief-period: 35.days after XacLastAppellantBriefFiled() counted_by frap26 cite "2d Cir. R. 31.2(b)(3)(B)"
{
  forum frap
}

/// On the Expedited Appeals Calendar, the appellant may submit a reply
/// brief within 14 days after the last appellee's brief is filed.
deadline xac-reply-brief-period: 14.days after XacLastAppelleeBriefFiled() counted_by frap26 cite "2d Cir. R. 31.2(b)(3)(C)"
{
  forum frap
}

/// A motion to file an oversized brief must be made at least 14 days
/// before the brief is due; an untimely one is denied absent extraordinary
/// circumstances.
deadline oversized-brief-motion-period: 14.days before BriefDue() counted_by frap26 cite "2d Cir. R. 27.1(e)(3)"
{
  forum frap
}

/// A motion for reconsideration of an order under FRAP 27(b) must be filed
/// within 14 days after the date of the order.
deadline reconsideration-period: 14.days after MotionOrderEntered() counted_by frap26 cite "2d Cir. R. 27.1(g)"
{
  forum frap
}

/// A motion to reinstate an appeal dismissed for failure to timely file a
/// brief is filed within 14 days of the dismissal order, the brief
/// attached.
deadline reinstatement-motion-period: 14.days after BriefDefaultDismissalEntered() counted_by frap26 cite "2d Cir. R. 27.1(i)"
{
  forum frap
}

/// In a direct criminal appeal, a petition for panel rehearing may be
/// filed within 45 days after entry of judgment.
deadline criminal-rehearing-period: 45.days after CriminalAppealJudgmentEntered() counted_by frap26 cite "2d Cir. R. 40.1(b)"
{
  forum frap
}

test "the docketing requirements are due 14 days after the notice of appeal" cite "2d Cir. R. 12.1(a)"
{
  given NoticeOfAppealFiled() on 2026-08-03
  expect deadline(docketing-requirements-period) == 2026-08-17
}

test "the appearance form is due 14 days after the docketing notice is received" cite "2d Cir. R. 12.3(a)"
{
  given DocketingNoticeReceived() on 2026-08-03
  expect deadline(appearance-form-period) == 2026-08-17
}

test "the appellant's scheduling request is due 14 days after the ready date" cite "2d Cir. R. 31.2(a)(1)(A)"
{
  given ReadyDate() on 2026-08-03
  expect deadline(appellant-scheduling-request-period) == 2026-08-17
}

test "the appellant may request a brief deadline up to 91 days after the ready date" cite "2d Cir. R. 31.2(a)(1)(A)"
{
  given ReadyDate() on 2026-08-03
  expect deadline(appellant-brief-latest-request-period) == 2026-11-02
}

test "without a request the appellant's brief is due 40 days after the ready date, rolled past a Saturday" cite "2d Cir. R. 31.2(a)(1)(A)"
{
  given ReadyDate() on 2026-08-03
  expect deadline(appellant-brief-default-period) == 2026-09-14
}

test "the appellee's scheduling request is due 14 days after the last appellant's brief" cite "2d Cir. R. 31.2(a)(1)(B)"
{
  given LastAppellantBriefFiled() on 2026-08-03
  expect deadline(appellee-scheduling-request-period) == 2026-08-17
}

test "the appellee may request a brief deadline up to 91 days after the last appellant's brief" cite "2d Cir. R. 31.2(a)(1)(B)"
{
  given LastAppellantBriefFiled() on 2026-08-03
  expect deadline(appellee-brief-latest-request-period) == 2026-11-02
}

test "without a request the appellee's brief is due 30 days after the last appellant's brief" cite "2d Cir. R. 31.2(a)(1)(B)"
{
  given LastAppellantBriefFiled() on 2026-08-03
  expect deadline(appellee-brief-default-period) == 2026-09-02
}

test "the cross-appeal scheduling request is due 14 days after the last cross-appellant's brief" cite "2d Cir. R. 31.2(a)(1)(C)"
{
  given LastCrossAppellantBriefFiled() on 2026-08-03
  expect deadline(cross-appeal-scheduling-request-period) == 2026-08-17
}

test "the appellant-cross-appellee may request a deadline up to 60 days out" cite "2d Cir. R. 31.2(a)(1)(C)"
{
  given LastCrossAppellantBriefFiled() on 2026-08-03
  expect deadline(cross-appeal-brief-latest-request-period) == 2026-10-02
}

test "without a request the appellant-cross-appellee's brief is due in 30 days" cite "2d Cir. R. 31.2(a)(1)(C)"
{
  given LastCrossAppellantBriefFiled() on 2026-08-03
  expect deadline(cross-appeal-brief-default-period) == 2026-09-02
}

test "the reply brief is due 21 days after the last appellee's brief is filed" cite "2d Cir. R. 31.2(a)(2)"
{
  given LastAppelleeBriefFiled() on 2026-08-03
  expect deadline(circuit-reply-brief-period) == 2026-08-24
}

test "the oral argument statement is due 14 days after the last appellee's brief" cite "2d Cir. R. 34.1(a)"
{
  given LastAppelleeBriefFiled() on 2026-08-03
  expect deadline(oral-argument-statement-period) == 2026-08-17
}

test "an expedited appeal's opening brief is due 35 days after placement, rolled past Labor Day" cite "2d Cir. R. 31.2(b)(3)(A)"
{
  given XacPlacementNotified() on 2026-08-03
  expect deadline(xac-appellant-brief-period) == 2026-09-08
}

test "an expedited appeal's appellee brief is due 35 days after the last appellant's brief" cite "2d Cir. R. 31.2(b)(3)(B)"
{
  given XacLastAppellantBriefFiled() on 2026-08-03
  expect deadline(xac-appellee-brief-period) == 2026-09-08
}

test "an expedited appeal's reply is due 14 days after the last appellee's brief" cite "2d Cir. R. 31.2(b)(3)(C)"
{
  given XacLastAppelleeBriefFiled() on 2026-08-03
  expect deadline(xac-reply-brief-period) == 2026-08-17
}

test "an oversized-brief motion is due 14 days before the brief, back past Labor Day" cite "2d Cir. R. 27.1(e)(3)"
{
  given BriefDue() on 2026-09-21
  expect deadline(oversized-brief-motion-period) == 2026-09-04
}

test "reconsideration of a motion order is due 14 days after the order" cite "2d Cir. R. 27.1(g)"
{
  given MotionOrderEntered() on 2026-08-03
  expect deadline(reconsideration-period) == 2026-08-17
}

test "a motion to reinstate is due 14 days after the dismissal order" cite "2d Cir. R. 27.1(i)"
{
  given BriefDefaultDismissalEntered() on 2026-08-03
  expect deadline(reinstatement-motion-period) == 2026-08-17
}

test "criminal panel rehearing is due 45 days after judgment" cite "2d Cir. R. 40.1(b)"
{
  given CriminalAppealJudgmentEntered() on 2026-08-03
  expect deadline(criminal-rehearing-period) == 2026-09-17
}

start threshold

decision threshold: "Appealable Order or Judgment?" by applicant cite "28 U.S.C. § 1291"
{
  note "A final decision of a district court is appealable under 28 U.S.C. § 1291; interlocutory routes are lit/frap's."
  edge-threshold-no "Not appealable" -> dismissed-jurisdiction { authority cite "28 U.S.C. § 1291" }
  edge-threshold-yes "Appealable" -> notice { authority cite "28 U.S.C. § 1291" }
}

decision notice: "Notice of Appeal Within Time?" by applicant cite "FRAP 4(a)(1)(A)"
{
  note "The notice is due 30 days after entry of judgment, or 60 days when the United States is a party (FRAP 4(a)(1)); lit/frap encodes both periods. The district clerk may serve an electronically filed notice on counseled parties electronically (2d Cir. R. 3.1)."
  edge-notice-late "Untimely notice" -> dismissed-untimely { authority cite "FRAP 4(a)(1)(A)" }
  edge-notice-timely "Timely notice" -> docketing {
    authority cite "FRAP 3(a)(1); 2d Cir. R. 12.1(a)"
  }
}

state docketing: "Appeal Docketed" by applicant cite "2d Cir. R. 12.1"
{
  note "Within 14 days after the notice of appeal, a counseled civil appellant files Form C (Civil Appeal Pre-Argument Statement) with its addenda and Form D (Civil Appeal Transcript Information Form), and pays the docketing fee fixed by the Judicial Conference under 28 U.S.C. § 1913 unless it seeks or has leave to proceed in forma pauperis (2d Cir. R. 12.1(a)-(c)). The fee amount is not stated in the vendored rules, so no cost is encoded. Every party files the Acknowledgment and Notice of Appearance Form within 14 days after receiving the docketing notice (2d Cir. R. 12.3(a)). Counseled civil appeals are referred to the Civil Appeals Mediation Program (2d Cir. R. 33.1)."
  edge-docketing-record "Docketing requirements met" -> record {
    authority cite "2d Cir. R. 12.1(a)"
  }
  edge-docketing-default "Docketing requirements not met" -> dismissed-prosecution {
    authority cite "2d Cir. R. 12.1(d)"
  }
}

state record: "Record and Transcript Assembled" by applicant cite "FRAP 10; 2d Cir. R. 11.1"
{
  note "The transcript order is due within 14 days after the notice of appeal (FRAP 10(b)(1)); lit/frap encodes it. The ready date, the later of receipt of the last transcript or the certificate that none will be ordered, starts the briefing schedule (2d Cir. R. 31.2(a)(1)(A))."
  edge-record-brief "Ready date" -> briefing { authority cite "2d Cir. R. 31.2(a)" }
}

state briefing: "Briefs Filed" by applicant cite "2d Cir. R. 31.2"
{
  note "Within 14 days after the ready date the appellant requests a brief deadline within 91 days of it, or its brief is due in 40 days; the appellee likewise within 14 days after the last appellant's brief, within 91 days, or in 30 days; the reply is due 21 days after the last appellee's brief (2d Cir. R. 31.2(a)(1)-(2)). A dispositive motion, an in forma pauperis motion or an LR 42.1 stipulation tolls these periods (2d Cir. R. 31.2(a)(3)). An appeal from a threshold dismissal on the Expedited Appeals Calendar is briefed in 35, 35 and 14 days (2d Cir. R. 31.2(b)(3)). Principal briefs are limited to 14,000 words and reply briefs to 7,000 (2d Cir. R. 32.1(a)(4)); a motion for an oversized brief is due 14 days before the brief (2d Cir. R. 27.1(e)(3)), and an extension needs an extraordinary circumstance (2d Cir. R. 27.1(f)). Six paper copies of each brief are submitted (2d Cir. R. 31.1)."
  edge-briefing-argue "Briefing complete" -> argument {
    authority cite "2d Cir. R. 31.2(a)(2); 2d Cir. R. 34.1(a)"
  }
  edge-briefing-default "Brief not timely filed" -> dismissed-prosecution {
    authority cite "2d Cir. R. 31.2(d)"
    note "A motion to reinstate is due within 14 days of the dismissal order, the brief attached (2d Cir. R. 27.1(i))."
  }
}

state argument: "Oral Argument or Submission" by court cite "FRAP 34; 2d Cir. R. 34.1"
{
  note "Each party files an Oral Argument Statement Form within 14 days after the last appellee's brief; one that does not is taken not to seek argument (2d Cir. R. 34.1(a)). The court may take the case on submission under FRAP 34(a)(2) (2d Cir. R. 34.1(b)); cases on the Non-Argument Calendar are decided without argument unless the court orders otherwise (2d Cir. R. 34.2(c))."
  edge-argument-decide "Decision" -> decision { authority cite "FRAP 34" }
}

state decision: "Decision Issued" by court cite "FRAP 36"
{
  note "Judgment is entered on the disposition (FRAP 36). When the decision is unanimous and no jurisprudential purpose is served by an opinion, the panel may rule by summary order (2d Cir. IOP 32.1.1(a)), which has no precedential effect (2d Cir. R. 32.1.1(a))."
  edge-decision-issued "Disposition entered" -> rehearing-decision { authority cite "FRAP 36" }
}

decision rehearing-decision: "Rehearing Sought?" by applicant cite "FRAP 40(d)(1)"
{
  note "A petition for rehearing is due 14 days after entry of judgment, or 45 days in a civil case with a United States party (FRAP 40(d)(1)); lit/frap encodes both periods. Panel and en banc requests go in a single document (2d Cir. R. 40.1(a)). In a direct criminal appeal the panel rehearing period is 45 days (2d Cir. R. 40.1(b))."
  edge-rehearing-decision-none "No petition" -> mandate { authority cite "FRAP 41(b)" }
  edge-rehearing-decision-sought "Petition filed" -> rehearing-order {
    authority cite "FRAP 40(d)(1); 2d Cir. R. 40.1"
  }
}

state rehearing-order: "Rehearing Order" by court cite "FRAP 40; 2d Cir. IOP 40.1"
{
  note "Only an active judge, or a senior judge who sat on the panel, may request an en banc poll; only active judges vote (2d Cir. IOP 40.1(a)-(b))."
  edge-rehearing-order-mandate "Rehearing decided" -> mandate { authority cite "FRAP 41(b)" }
}

state mandate: "Mandate Issued" by office cite "FRAP 41(b)"
{
  note "The mandate issues 7 days after the time to petition for rehearing expires or 7 days after an order denying a timely petition (FRAP 41(b)); lit/frap encodes the period."
  edge-mandate-further "Mandate issued" -> further-review { authority cite "FRAP 41(b)" }
}

decision further-review: "Further Review Sought?" by applicant cite "28 U.S.C. § 1254"
{
  note "Certiorari under 28 U.S.C. § 1254; its period is lit/frap's."
  edge-further-review-none "No further review" -> final-decision {
    authority cite "28 U.S.C. § 1254"
  }
  edge-further-review-petition "Petition for certiorari" -> review-decided {
    authority cite "28 U.S.C. § 1254"
  }
}

state review-decided: "Further Review Decided" by court cite "28 U.S.C. § 1254"
{
  edge-review-decided-denied "Denied" -> review-denied { authority cite "28 U.S.C. § 1254" }
  edge-review-decided-granted "Granted" -> review-granted { authority cite "28 U.S.C. § 1254" }
}

terminal dismissed-jurisdiction: "Dismissed: No Appellate Jurisdiction" outcome [loss, dismissal, jurisdictional] cite "28 U.S.C. § 1291"
terminal dismissed-untimely: "Dismissed: Untimely Notice" outcome [loss, dismissal] cite "FRAP 4(a)(1)(A)"
terminal dismissed-prosecution: "Dismissed: Failure to Prosecute" outcome [loss, dismissal] cite "2d Cir. R. 31.2(d); 2d Cir. R. 12.1(d)"
terminal final-decision: "Final: Decision Stands" outcome [final] cite "FRAP 41(b)"
terminal review-denied: "Further Review Denied" outcome [final] cite "28 U.S.C. § 1254"

terminal review-granted: "Further Review Granted" outcome [neutral] cite "28 U.S.C. § 1254"
{
  note "Certiorari granted; the merits are not modeled."
}
