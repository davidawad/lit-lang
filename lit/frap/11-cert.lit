module frap.cert

import frap.{ cert-group }

decision cert-petition-window: "Certiorari Petition Window" by applicant cite ?("Sup. Ct. R. 13.1, 13.3; 28 U.S.C. § 1254(1)") {
  group cert-group
  note "90 days from entry of judgment or from denial of a timely rehearing petition — not extendable except by a single application to a Circuit Justice for good cause, filed before the deadline expires."
  _ "File petition for certiorari" -> cert-petition-filed {
    authority cite ?("Sup. Ct. R. 13.1; 28 U.S.C. § 1254(1)")
    effort 80.hours
    deadline 90.days {
      extendable false
      extension_authority "Sup. Ct. R. 13.3 (single application to Circuit Justice only)"
      note "Failure to file within 90 days permanently bars federal review; there is no tolling, no exceptions for attorney mistake, and no relief even if the court of appeals misled the parties about the deadline."
    }
    duration { min 13.5.days, mode 45.days, max 90.days }
    note "Hours: BigLaw-honest estimate for the effort of this move; basis: estimate."
  }
  _ "90-day window lapses" -> cert-not-sought {
    authority cite ?("Sup. Ct. R. 13.1")
    effort 0.hours
    note "Hours: BigLaw-honest estimate for the effort of this move; basis: estimate."
  }
}

terminal cert-not-sought: "FINAL — Certiorari Not Sought" outcome [final] cite ?("Sup. Ct. R. 13.1") {
  group cert-group
  note "The vast majority of court of appeals decisions end here — no petition filed, judgment final and unreviewable by any federal court. PLACEHOLDER PAYOFF: $400,000, override per matter. Blended for the same reason as `rehearing-en-banc-both-denied`: the panel's disposition, whatever it was, simply stands."
  valence good
  payoff 400_000.usd
}

state cert-petition-filed: "Petition for Certiorari Filed" by examiner cite ?("Sup. Ct. R. 10; 28 U.S.C. § 1254(1)") {
  group cert-group
  note "Governed by the 'rule of four' — cert is granted on the vote of any four Justices, not a majority. Discretionary review, not a matter of right; the petition must meet one of the Rule 10 criteria (typically a circuit split, an important federal question, or conflict with Supreme Court precedent)."
  _ "Supreme Court considers petition" -> cert-review-decision {
    authority cite ?("Sup. Ct. R. 10")
  }
}

decision cert-review-decision: "Supreme Court Grants or Denies Certiorari" by office cite ?("Sup. Ct. R. 10") {
  group cert-group
  note "The Supreme Court grants certiorari to only about 1% of petitions. Most petitions receive zero substantive review; the Court's denial is typically summary and involves only a screening review by law clerks. No opinions are issued on the merits of denied petitions."
  _ "Certiorari denied" -> cert-denied p 0.99 { authority cite ?("Sup. Ct. R. 10") }
  _ "Certiorari granted" -> cert-granted p 0.01 {
    authority cite ?("28 U.S.C. § 1254(1); Sup. Ct. R. 10")
  }
}

terminal cert-denied: "CERT DENIED (Final)" outcome [final] cite ?("Sup. Ct. R. 10") {
  group cert-group
  note "A denial of certiorari is not a ruling on the merits and carries zero precedential weight — parties cannot cite a cert denial as support for any legal proposition, and the denial expresses no view on the correctness of the lower court's decision. PLACEHOLDER PAYOFF: $400,000, override per matter. Blended for the same reason as `rehearing-en-banc-both-denied`: the panel's disposition, whatever it was, simply stands."
  valence good
  payoff 400_000.usd
}

terminal cert-granted: "CERT GRANTED — Case Transfers to the Supreme Court" outcome [pending] cite ?("28 U.S.C. § 1254(1); Sup. Ct. R. 10") {
  group cert-group
  note "Once certiorari is granted, the case is removed from the court of appeals docket and briefing proceeds under the Supreme Court's own rules, not FRAP. This pack's jurisdiction over the case ends here. PLACEHOLDER PAYOFF: $500,000 (stake midpoint), override per matter. Certiorari being granted decides nothing on the merits -- the case's actual outcome is now genuinely open before the Supreme Court."
  valence good
  payoff 500_000.usd
}
