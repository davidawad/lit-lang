{
  given CostsObjectionFiled() on 2026-11-02
  expect deadline(costs-response-period) == 2026-11-09
}

test "costs review period: 7 days after the trigger" cite "M.D.N.C. LR 54.1(b)"
{
  given CostsTaxed() on 2026-11-02
  expect deadline(costs-review-period) == 2026-11-09
}

test "fee motion period: 21 days after the trigger" cite "M.D.N.C. LR 54.2"
{
  given JudgmentEntered() on 2026-11-02
  expect deadline(fee-motion-period) == 2026-11-23
}

test "dispositive notice period: 14 days after the trigger" cite "M.D.N.C. LR 56.1(a)"
{
  given DiscoveryClosed() on 2026-11-02
  expect deadline(dispositive-notice-period) == 2026-11-16
}

test "dispositive motion period: 30 days after the trigger" cite "M.D.N.C. LR 56.1(b)"
{
  given DiscoveryClosed() on 2026-11-02
  expect deadline(dispositive-motion-period) == 2026-12-02
}

test "summary judgment response period: 30 days after the trigger" cite "M.D.N.C. LR 56.1(d)"
{
  given SummaryJudgmentMotionServed() on 2026-11-02
  expect deadline(summary-judgment-response-period) == 2026-12-02
}
