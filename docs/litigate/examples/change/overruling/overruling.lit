module change-bowles-v-russell.overruling

import change-thompson-v-ins.doctrine.{ unique-circumstances }

// An overruling withdraws a precedent (`overrules` in its instrument),
// from its date (docs/litigate/CHANGE.md §2.10), and with `invalidate` the
// doctrine it holds illegitimate. It needs no procedure, so no `start`.

/// "[U]se of the 'unique circumstances' doctrine is illegitimate."
/// (The vendored opinion has no section heading to bind, so the cite is a
/// hole.)
invalidate no-unique-circumstances: unique-circumstances effective [2007-06-14, ..) cite ?("Bowles v. Russell, 551 U.S. 205, 214 (2007)")
