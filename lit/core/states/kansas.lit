module core.states.kansas

import core.calendar.{ us-federal-holidays }

/// The legal public holidays of Kansas (K.S.A. 35-107(a)) that
/// `us-federal-holidays` does not already close: none. Every day the
/// section lists (New Year's Day, Martin Luther King, Jr. Day, President's
/// Day, Memorial Day, Independence Day, Labor Day, Columbus Day, Veterans'
/// Day, Thanksgiving Day, Christmas Day) is a 5 U.S.C. § 6103(a) holiday
/// on the same day, and the section states no weekend-observance shift, so
/// no observed day falls outside the federal ones. The calendar is
/// declared empty from the vendored text so that FRCP 6(a)(6)(C) and FRBP
/// 9006(a)(6)(C) read a sourced Kansas list (core's `frcp6-kansas` and
/// `frbp9006-kansas`) rather than the unsourced `district-state-holidays`.
/// Not modeled: a day the Governor proclaims, which no vendored source
/// lists (a last day on it stays the earlier date).
calendar kansas-holidays cite "K.S.A. 35-107"
{}

/// FRCP 6 in the district courts of Kansas: the 2023 text
/// (`frcp6@2023-12-01`) with `kansas-holidays`, which 6(a)(6)(C)
/// ("any day declared a holiday by ... the state where the district court
/// is located") makes legal holidays "for periods that are measured after
/// an event" only. A district package there names it as its `counting`
/// rule and `recounts` lit/frcp. A calendar day is closed only from the
/// date its entry is in force; before it the count is `frcp6`'s.
counting frcp6-kansas effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCP 6(d)"
  holidays us-federal-holidays
  forward_holidays kansas-holidays cite "FRCP 6(a)(6)(C)"
  forums [frcp]
  allow_hours
  end_of_month clamp
}

/// FRBP 9006(a) (`frbp9006`) in the bankruptcy courts of Kansas:
/// `kansas-holidays` are legal holidays for a period counted forward only (FRBP
/// 9006(a)(6)(C), "any day declared a holiday by the state where the
/// district court is located"). A bankruptcy package there names it as its
/// `counting` rule and `recounts` lit/frbp. A calendar day is closed only
/// from the date its entry is in force.
counting frbp9006-kansas effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays kansas-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-ks]
  allow_hours
  end_of_month clamp
}
