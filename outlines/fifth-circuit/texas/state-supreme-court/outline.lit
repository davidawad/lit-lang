// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-tx-supreme-court

import outline-tx-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start petition

decision petition: "Petition for discretionary review?" by applicant cite ?("Tex. R. App. P. 53.2, 53.7")
{
  note "OUTLINE. Review in the Texas Supreme Court of an intermediate appellate decision: the petition period, form, length and grounds are holes. Direct appeals and original proceedings, where the state allows them, are not modeled. Leading decisions on the grant standard: not yet identified in this pass; verify before use."
  edge-petition-none "No petition: the intermediate decision stands" -> review-not-sought { authority cite ?("Texas appellate rules (verify)") }
  edge-petition-filed "Petition filed" -> review-decision { event ReviewPetitionFiled() authority cite ?("Tex. R. App. P. 53.2, 53.7") }
}

chance review-decision: "Court grants or denies review" by court cite ?("Tex. R. App. P. 53.2, 53.7")
{
  note "OUTLINE. Review is discretionary; the grant probability is a hole."
  edge-review-denied "Review denied" -> review-denied p ? { }
  edge-review-granted "Review granted" -> briefing p ? { }
}

state briefing: "Merits briefs filed" by applicant cite ?("Tex. R. App. P. 38.1")
{
  note "OUTLINE. Merits briefing periods, form and length limits are holes."
  edge-briefing-argument "Argument or submission" -> argument { authority cite ?("Tex. R. App. P. 39.1") }
}

state argument: "Argument or submission" by court cite ?("Tex. R. App. P. 39.1")
{
  note "OUTLINE. Whether argument is heard is a hole."
  edge-argument-decision "Decision issued" -> decision { authority cite ?("Tex. R. App. P. 43.2") }
}

chance decision: "Court decides" by court cite ?("Tex. R. App. P. 43.2")
{
  note "OUTLINE. Outcome probabilities are holes."
  edge-decision-affirmed "Affirmed" -> rehearing p ? { event DecisionFiled() }
  edge-decision-reversed "Reversed, vacated or remanded" -> rehearing p ? { event DecisionFiled() }
}

decision rehearing: "Rehearing or reconsideration sought?" by applicant cite ?("Tex. R. App. P. 49.1")
{
  note "OUTLINE. Rehearing period and grounds are holes."
  edge-rehearing-none "No rehearing" -> mandate-issued { event MandateIssued() authority cite ?("Texas appellate rules (verify)") }
  edge-rehearing-sought "Rehearing sought" -> rehearing-decision { authority cite ?("Tex. R. App. P. 49.1") }
}

chance rehearing-decision: "Rehearing decided" by court cite ?("Tex. R. App. P. 49.1")
{
  note "OUTLINE. Rehearing is rarely granted; the probability is a hole."
  edge-rehearing-denied "Rehearing denied" -> mandate-issued p ? { event MandateIssued() authority cite ?("Texas appellate rules (verify)") }
  edge-rehearing-granted "Rehearing granted" -> rehearing-granted p ? { }
}

terminal review-not-sought: "Review not sought: intermediate decision final" outcome [final] cite ?("Texas appellate rules (verify)")
{
  note "OUTLINE. The intermediate court's mandate issues; costs are holes."
  payoff ?
}

terminal review-denied: "Review denied" outcome [final, loss] cite ?("Tex. R. App. P. 53.2, 53.7")
{
  note "OUTLINE. Denial leaves the intermediate decision in place. Federal certiorari (28 U.S.C. § 1257) is outside this outline."
  payoff ?
}

terminal mandate-issued: "Mandate or remittitur issued" outcome [final] cite ?("Texas appellate rules (verify)")
{
  note "OUTLINE. The case returns to the court below; costs are holes."
  payoff ?
}

terminal rehearing-granted: "Rehearing granted" outcome [final] cite ?("Tex. R. App. P. 49.1")
{
  note "OUTLINE. Proceedings on rehearing are outside this outline."
  payoff ?
}
