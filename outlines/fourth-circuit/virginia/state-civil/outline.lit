// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-outline-va-state-civil

start filed

state filed: "Complaint filed" by applicant cite ?("Va. Sup. Ct. R. 3:2")
{
  note "OUTLINE. Commencement by filing. Appeal notice and tolling: Va. Sup. Ct. R. 5A:6 (30-day period confirmed, verify text). Other circuit court rule numbers are to be verified."
  edge-filed-served "Defendant served" -> served {
    authority cite ?("Va. Code § 8.01-296 (verify)")
  }
}

decision served: "Response due" by office cite ?("Va. Sup. Ct. R. 3:8")
{
  note "OUTLINE. Response period is a hole. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-served-answer "Answer filed" -> answered {
    authority cite ?("Va. Sup. Ct. R. 3:8")
  }
  edge-served-motion "Demurrer under Va. Code § 8.01-273" -> motion-pending {
    authority cite ?("Va. Code § 8.01-273")
  }
  edge-served-default "No response by the deadline" -> default-entered {
    authority cite ?("Va. Sup. Ct. R. 3:19 (verify)")
  }
}

state motion-pending: "Pleading motion pending" by applicant cite ?("Va. Code § 8.01-273")
{
  note "OUTLINE. Demurrer under Va. Code § 8.01-273. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-motion-ruling "Court rules" -> motion-ruling {
  }
}

chance motion-ruling: "Ruling on pleading motion" by court cite ?("Va. Code § 8.01-273")
{
  note "OUTLINE. Probabilities are holes; no calibration."
  edge-mr-dismissed "Dismissed" -> dismissed-pleading p ? {
  }
  edge-mr-leave "Dismissed with leave to amend" -> amend p ? {
  }
  edge-mr-denied "Denied" -> answered p ? {
  }
}

state amend: "Amended pleading" by applicant cite ?("Va. Sup. Ct. R. 1:8")
{
  note "OUTLINE. Amendment period and consent are holes."
  edge-amend-motion "Amended pleading tested again" -> motion-pending {
  }
}

state default-entered: "Default entered" by office cite ?("Va. Sup. Ct. R. 3:19 (verify)")
{
  note "OUTLINE. Default entry. Setting it aside: Va. Sup. Ct. R. 3:19 (verify)."
  edge-default-judgment "Default judgment sought" -> default-judgment {
    authority cite ?("Va. Sup. Ct. R. 3:19 (verify)")
  }
  edge-default-vacate "Default vacated" -> answered {
    authority cite ?("Va. Sup. Ct. R. 3:19 (verify)")
  }
}

terminal default-judgment: "Default judgment entered" outcome [loss] cite ?("Va. Sup. Ct. R. 3:19 (verify)")
{
  note "OUTLINE. Default judgment. Damages hearing and proof are holes."
  payoff ?
}

terminal dismissed-pleading: "Dismissed on the pleadings" outcome [loss] cite ?("Va. Code § 8.01-273")
{
  note "OUTLINE. Dismissal on a pleading motion. Appeal period is a hole. Leading decisions for this stage: not yet identified in this pass; verify before use."
  payoff ?
}

state answered: "Answer filed" by applicant cite ?("Va. Sup. Ct. R. 3:8")
{
  note "OUTLINE. Answer and affirmative defenses."
  edge-answered-discovery "Case proceeds to discovery" -> discovery {
    authority cite ?("Va. Sup. Ct. R. 4:1")
  }
}

state discovery: "Discovery" by applicant cite ?("Va. Sup. Ct. R. 4:1")
{
  note "OUTLINE. Written discovery, depositions, expert disclosure. Scope and limits are holes."
  edge-disc-dispute "Discovery dispute" -> dispute {
    authority cite ?("Va. Sup. Ct. R. 4:12")
  }
  edge-disc-sj "Dispositive motion" -> sj-motion {
    authority cite ?("Va. Sup. Ct. R. 3:20")
  }
  edge-disc-settle "Settlement" -> settled {
  }
}

decision dispute: "Discovery dispute ruling" by court cite ?("Va. Sup. Ct. R. 4:12")
{
  note "OUTLINE. Sanctions: Va. Sup. Ct. R. 4:12 (verify). Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-dispute-resolved "Dispute resolved" -> discovery {
  }
  edge-dispute-sanction "Dismissal as a sanction" -> dismissed-sanction {
    authority cite ?("Va. Sup. Ct. R. 4:12 (verify)")
  }
}

terminal dismissed-sanction: "Dismissed as a discovery sanction" outcome [loss] cite ?("Va. Sup. Ct. R. 4:12 (verify)")
{
  note "OUTLINE. Dismissal as a sanction. Leading decisions for this stage: not yet identified in this pass; verify before use."
  payoff ?
}

state sj-motion: "Summary judgment motion" by applicant cite ?("Va. Sup. Ct. R. 3:20")
{
  note "OUTLINE. Summary judgment standard and timing are holes. Va. Sup. Ct. R. 3:20 governs. Leading decisions not yet identified (verify)."
  edge-sj-ruling "Motion decided" -> sj-ruling {
  }
}

chance sj-ruling: "Summary judgment ruling" by court cite ?("Va. Sup. Ct. R. 3:20")
{
  note "OUTLINE. Probabilities are holes."
  edge-sjr-granted "Granted" -> judgment-entered p ? {
  }
  edge-sjr-denied "Denied" -> pretrial p ? {
  }
}

state pretrial: "Pretrial conference and motions in limine" by court cite ?("Va. Sup. Ct. R. 4:1 (verify)")
{
  note "OUTLINE. Pretrial conference and trial setting are holes."
  edge-pre-settle "Settlement" -> settled {
  }
  edge-pre-trial "Trial" -> trial {
    authority cite ?("Va. Sup. Ct. R. 3:25 (verify)")
  }
}

state trial: "Trial" by court cite ?("Va. Sup. Ct. R. 3:25 (verify)")
{
  note "OUTLINE. Trial by jury or the court. Jury demand timing is a hole."
  edge-trial-verdict "Verdict or decision" -> verdict {
  }
}

chance verdict: "Verdict or decision" by court cite ?("Va. Sup. Ct. R. 3:25 (verify)")
{
  note "OUTLINE. Probabilities are holes."
  edge-v-favorable "For applicant" -> judgment-entered p ? {
  }
  edge-v-adverse "For opponent" -> judgment-entered p ? {
  }
}

decision judgment-entered: "Judgment entered" by office cite ?("Va. Sup. Ct. R. 1:1")
{
  note "OUTLINE. Entry of judgment. Costs and fees are holes."
  edge-jud-post "Post-trial motion" -> post-trial {
    authority cite ?("Va. Sup. Ct. R. 1:1 (verify)")
  }
  edge-jud-appeal "Notice of appeal" -> appeal-noticed {
    authority cite ?("Va. Sup. Ct. R. 5A:6")
  }
  edge-jud-final "No further action" -> judgment-final {
    authority cite ?("Va. Sup. Ct. R. 1:1")
  }
}

state post-trial: "Post-trial motion" by applicant cite ?("Va. Sup. Ct. R. 1:1 (verify)")
{
  note "OUTLINE. Post-trial motion periods are holes. Relief from judgment: Va. Sup. Ct. R. 1:1 (verify)."
  edge-post-ruling "Motion decided" -> post-ruling {
  }
}

chance post-ruling: "Ruling on post-trial motion" by court cite ?("Va. Sup. Ct. R. 1:1 (verify)")
{
  note "OUTLINE. Probabilities are holes."
  edge-pr-retrial "New trial" -> trial p ? {
  }
  edge-pr-denied "Denied" -> judgment-entered p ? {
  }
}

terminal settled: "Settled or dismissed" outcome [settle] cite ?("Va. Sup. Ct. R. 4:1")
{
  note "OUTLINE. Settlement or voluntary dismissal. Payoff is a hole."
  payoff ?
}

terminal judgment-final: "Judgment final in trial court" outcome [final] cite ?("Va. Sup. Ct. R. 1:1")
{
  note "OUTLINE. Final judgment. Appeal is governed by the state-appellate package."
  payoff ?
}

terminal appeal-noticed: "Notice of appeal filed" outcome [appeal] cite ?("Va. Sup. Ct. R. 5A:6")
{
  note "OUTLINE. Appeal to the state appellate court; see the state-appellate package."
  payoff ?
}

