# Environment variables litgraph reads. Copy to .env (gitignored) to override.
#
# Directory of pack JSON files to use instead of the packs built into the binary
# (`--packs-dir` wins over it). `just lit-sync` writes the repo's built packs
# here; packs/ itself holds no pack files. A missing directory is an error.
# LITGRAPH_PACKS=./target/lit-build/packs
