{
  given PlaintiffBriefDue() on 2026-11-02
  expect deadline(commissioner-pro-se-brief-period) == 2026-12-02
}

test "pro se opposition period: 14 days after the trigger" cite "S.D.N.Y. Local Soc. Sec. R. 8.1"
{
  given CommissionerBriefServed() on 2026-11-02
  expect deadline(pro-se-opposition-period) == 2026-11-16
}

