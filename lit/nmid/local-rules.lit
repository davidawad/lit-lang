{
  given TrialBegins() on 2027-03-02
  expect deadline(translation-service-period) == 2027-02-02
}

test "translation objection period: 14 days before the trigger" cite "D.N.M.I. LR 16.5(a)"
{
  given TrialBegins() on 2027-03-02
  expect deadline(translation-objection-period) == 2027-02-16
}

test "final pretrial conference period: 7 days before the trigger" cite "D.N.M.I. LR 16.6(a)"
{
  given TrialBegins() on 2027-03-02
  expect deadline(final-pretrial-conference-period) == 2027-02-23
}

test "juror cost notice period: 14 days before the trigger" cite "D.N.M.I. LR 54.2"
{
  given TrialBegins() on 2027-03-02
  expect deadline(juror-cost-notice-period) == 2027-02-16
}

test "nonresident cost bond period: 10 days after the trigger" cite "D.N.M.I. LR 62.1(a)"
{
  given CostBondDemanded() on 2026-11-02
  expect deadline(nonresident-cost-bond-period) == 2026-11-12
