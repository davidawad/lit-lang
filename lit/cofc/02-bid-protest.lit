module cofc.bid-protest

import cofc.rules-protest.{ protest-notice-window }
import cofc.{ bid-protest-group }

state bid-protest-prefiling-notice: "Pre-Filing Notice to DOJ, Clerk, Contracting Officer & Awardee" by applicant cite ?("RCFC Appendix C ¶2-3") {
  group bid-protest-group
  note "Except in exceptional circumstances, protest counsel must give advance notice of the intent to file -- at least 1 day but no more than 5 days before filing (excluding Saturdays/Sundays/legal holidays) -- to DOJ Commercial Litigation Branch, the CoFC clerk, the procuring agency's contracting officer, and (if known) the apparently successful offeror. The notice must include the disclosure required by RCFC 7.1(a) plus solicitation number, contracting officer, whether injunctive relief will be sought, any prior GAO protest, and whether a protective order will be needed."
  e-protest-notice-to-complaint "File the protest complaint (1-5 days after pre-filing notice)" -> bid-protest-complaint-filed {
    authority cite ?("RCFC Appendix C ¶2; RCFC 3")
    effort 20.hours
    cost 405.usd
    within protest-notice-window {
      note "Notice must precede filing by at least 1 but no more than 5 days (excluding weekends/legal holidays); filing follows once that window is satisfied."
    }
  }
}

state bid-protest-complaint-filed: "Protest Complaint Filed (Possibly Under Seal)" by office cite ?("RCFC 3; RCFC Appendix C ¶4-7") {
  group bid-protest-group
  note "Filed as any civil action (RCFC 3), fee $405.00 (§1491(b) protests pay the standard complaint fee, not a separate schedule). If the complaint contains confidential/proprietary information, plaintiff must move for leave to file under seal with a proposed redacted version attached."
  e-protest-complaint-to-conference "Court schedules and holds the initial status conference as soon as practicable" -> bid-protest-initial-status-conference {
    authority cite ?("RCFC Appendix C ¶8")
  }
}

state bid-protest-initial-status-conference: "Initial Status Conference" cite ?("RCFC Appendix C ¶8") {
  group bid-protest-group
  note "Scheduled as soon as practicable after filing -- NOT on the 49-day Appendix A JPSR clock that governs standard cases. Addresses interested-party identification, intervention by the successful offeror, protective-order content, administrative-record timing, and TRO/PI issues."
  e-protest-conference-to-pi-fork "Conference addresses intervention, protective order, AR timing, and injunctive relief" -> bid-protest-injunctive-relief-fork
}

decision bid-protest-injunctive-relief-fork: "Temporary Restraining Order / Preliminary Injunction Sought?" by applicant cite ?("RCFC Appendix C ¶9-15; RCFC 65") {
  group bid-protest-group
  note "An application for a TRO/PI must be filed with (or promptly after) the complaint, accompanied by affidavits and proof that DOJ and the awardee received copies. The court expedites PI hearings in protest cases specifically so plaintiffs rarely need a standalone TRO first."
  e-protest-no-pi "No TRO/PI sought -- proceed directly to administrative-record briefing" -> bid-protest-merits-briefing {
    effort 5.hours
  }
  e-protest-pi-sought "TRO/PI sought and resolved (granted or denied); case proceeds to AR briefing either way" -> bid-protest-merits-briefing {
    authority cite ?("RCFC Appendix C ¶9-15; RCFC 65")
    effort 45.hours
    cost 5_000.usd
    note "PI outcome (withhold award / suspend performance or not) shapes leverage but is not itself case-dispositive; cost reflects an illustrative surety-bond/expedited-motion estimate, not a rule-set figure."
  }
}

state bid-protest-merits-briefing: "Administrative-Record Briefing (Cross-Motions for Judgment on the AR)" by applicant cite ?("RCFC 52.1; RCFC Appendix C ¶8(e)-(f)") {
  group bid-protest-group
  note "Protests are ordinarily decided on the administrative record via cross-motions for judgment on the AR under RCFC 52.1 rather than a full RCFC 56 summary-judgment/trial sequence -- the record is what the agency actually considered, supplemented only on a showing of necessity."
  e-protest-briefing-to-ruling "Complete cross-motions for judgment on the administrative record" -> bid-protest-merits-ruling {
    authority cite RCFC 52.1
    effort 140.hours
    cost 0.usd
  }
}

chance bid-protest-merits-ruling: "Court Rules on the Protest" by office discretion cite RCFC 52.1; 28 U.S.C. §1491(b)(4) (arbitrary-and-capricious/APA-derived standard)
{
  group bid-protest-group
  note "Outcome distribution authored at 0.20 sustained / 0.80 denied -- TEACHING ESTIMATE only, not a cited empirical GAO/CoFC bid-protest sustain-rate figure (publicly reported CoFC-specific sustain rates were not verified against a primary source in this pass; flag as UNVERIFIED if precision matters). The arbitrary-and-capricious standard is highly deferential to the procuring agency."
  e-protest-sustained "Court sustains the protest" -> protest-sustained p 0.2 {
    authority cite 28 U.S.C. §1491(b)(4)
    note "TEACHING ESTIMATE -- not a cited empirical CoFC sustain-rate figure; UNVERIFIED against a primary statistical source in this pass."
  }
  e-protest-denied "Court denies the protest" -> protest-denied p 0.8 {
    note "TEACHING ESTIMATE, see sibling edge note."
  }
}

terminal protest-sustained: "PROTEST SUSTAINED" outcome [win, injunctive-relief] cite 28 U.S.C. §1491(b)(2)
{
  group bid-protest-group
  note "PLACEHOLDER PAYOFF: $200,000, override per matter. Relief in a sustained protest is typically injunctive/equitable (enjoining award, directing re-evaluation or re-procurement) plus bid-and-proposal-preparation costs -- rarely a damages award on the scale of a §1498 or breach claim, so the payoff here approximates recovered B&P costs and re-compete value rather than the full parameterized $1M claim baseline used elsewhere in this pack."
  valence good
  payoff 200_000.usd
}

terminal protest-denied: "PROTEST DENIED" outcome [loss] cite 28 U.S.C. §1491(b)
{
  group bid-protest-group
  note "PLACEHOLDER PAYOFF: $0, override per matter."
  valence bad
  payoff 0.usd
}
