    authority cite ?("Mo. Const. art. V, § 3; Mo. Sup. Ct. R. 81.04 (verify)")
  }
  edge-appealability-record "Appealable order" -> record { event NoticeOfAppealFiled()
    authority cite ?("Mo. Const. art. V, § 3; Mo. Sup. Ct. R. 81.04 (verify)")
  }
}

terminal dismissed-jurisdiction: "Dismissed for lack of appellate jurisdiction" outcome [loss] cite ?("Mo. Const. art. V, § 3; Mo. Sup. Ct. R. 81.04 (verify)")
{
  note "OUTLINE. Outcome from the applicant's side."
