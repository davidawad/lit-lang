// Cross-appeals: FRAP 4(a)(3)'s 14-day notice and Fed. Cir. R. 28.1's
// cross-appeal briefing.
module cafc.cross-appeal

import cafc.appeal-periods.{ cross-appeal-period }
import cafc.briefing.{ appellant-brief-window }
import cafc.{ Filed, Paper, cross-appeal-group }

decision cross-appeal-fork: "Appellee Considers a Cross-Appeal" by applicant cite "FRAP 4(a)(3); Fed. Cir. R. 28.1"
{
  group cross-appeal-group
  note "A cross-appeal is proper only where the appellee seeks to modify or overturn the judgment, not merely to defend it on alternative grounds — Bailey v. Dart Container Corp., 292 F.3d 1360 (Fed. Cir. 2002). Fed. Cir. R. 28.1 sets Federal-Circuit-specific page/word/color-cover limits and the four-brief sequence for cross-appeals; the 14-day filing deadline itself is the general FRAP 4(a)(3) deadline, not separately shortened by a Federal Circuit rule."
  cross-appeal-file "File notice of cross-appeal" -> cross-appeal-filed {
    authority cite "FRAP 4(a)(3); Fed. Cir. R. 28.1"
    effort 10.hours
    cost 605.usd
    event Filed(CrossAppealNotice)
    within cross-appeal-period {
      extendable true
      extension_authority "FRAP 4(a)(5): on motion no later than 30 days after the period expires, for excusable neglect or good cause"
      note "14 days after the first notice of appeal, or the otherwise-applicable FRAP 4(a)(1) period, whichever is later. Extendable only under FRAP 4(a)(5)."
    }
    tags [appeal]
  }
  cross-appeal-decline "Decline to cross-appeal" -> no-cross-appeal {
    authority cite "FRAP 4(a)(3)"
  }
}

state cross-appeal-filed: "Notice of Cross-Appeal Filed" by office cite "FRAP 4(a)(3); Fed. Cir. R. 28.1"
{
  group cross-appeal-group
  cross-appeal-filed-to-briefing "Cross-appeal docketed — briefing under Fed. Cir. R. 31(a)(1)(C)-(D)/28.1" -> appellant-brief-window {
    authority cite "Fed. Cir. R. 28.1; Fed. Cir. R. 31(a)(1)(D)"
  }
}

state no-cross-appeal: "No Cross-Appeal — Judgment Defended Only" by office cite "FRAP 4(a)(3)"
{
  group cross-appeal-group
  no-cross-appeal-to-briefing "Proceed to ordinary briefing" -> appellant-brief-window {
    authority cite "Fed. Cir. R. 31(a)(1)"
  }
}
