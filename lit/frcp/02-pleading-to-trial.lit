chance rule37-sanctions-ruling: "Court Rules on Rule 37 Sanctions" by examiner discretion cite "FRCP 37(b)(2); 37(e)"
{
  group discovery-group
  note "If a party disobeys a discovery order, the court may issue further just orders, including: directing that facts be taken as established, prohibiting the disobedient party from supporting or opposing designated claims/defenses, striking pleadings, staying proceedings, dismissing the action, or rendering a default judgment (37(b)(2)(A)). For lost electronically stored information, Rule 37(e)(2)'s severe measures (adverse-inference instruction, dismissal, default) require a finding of INTENT to deprive -- mere negligence supports only 37(e)(1)'s narrower 'no greater than necessary' curative measures. Case-dispositive sanction authored at 0.15 dismissal / 0.15 default -- APPROXIMATE but grounded: Certain Opaque Polymers (ITC Inv. No. 337-TA-883) is the paradigm case for this exact branch, where the Federal Circuit affirmed a case-dispositive default sanction for 'spoliation on a staggering scale.'"
  court_listener_url "https://www.courtlistener.com/opinion/8757285/zubulake-v-ubs-warburg-llc/"
  edge-rule37-sanctions-ruling-discovery-open "Lesser sanction imposed -- adverse inference, fee-shifting, or evidence preclusion (Rule 37(b)(2)(A)(i)-(iv))" -> discovery-open p 0.7 {
    authority cite "FRCP 37(b)(2)(A)"
  }
  edge-rule37-sanctions-ruling-discovery-sanctions-dismissal "Case-dispositive sanction -- dismissal for willful noncompliance or spoliation" -> discovery-sanctions-dismissal p 0.15 {
    authority cite "FRCP 37(b)(2)(A)(v); 37(e)(2)(C)"
  }
  edge-rule37-sanctions-ruling-discovery-sanctions-default "Case-dispositive sanction -- default judgment against the disobedient defendant" -> discovery-sanctions-default p 0.15 {
    authority cite "FRCP 37(b)(2)(A)(vi)"
  }
}

