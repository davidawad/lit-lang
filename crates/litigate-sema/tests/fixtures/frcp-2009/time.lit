module frcp.time

/// FRCP 6(a)(6) legal holidays (abbreviated to the holidays of 2007-2010;
/// mirrors packs/clock/us-federal-holidays.json).
calendar federal-holidays cite "FRCP 6(a)(6)"
{
  new-year: fixed(1, 1) effective [1870-06-28, ..) observed nearest_weekday
  mlk-day: nth(3, monday, 1) effective [1986-01-01, ..)
  washingtons-birthday: nth(3, monday, 2) effective [1971-01-01, ..)
  memorial-day: last(monday, 5) effective [1971-01-01, ..)
  independence-day: fixed(7, 4) effective [1870-06-28, ..) observed nearest_weekday
  labor-day: nth(1, monday, 9) effective [1894-06-28, ..)
  columbus-day: nth(2, monday, 10) effective [1971-01-01, ..)
  veterans-day: fixed(11, 11) effective [1978-01-01, ..) observed nearest_weekday
  thanksgiving: nth(4, thursday, 11) effective [1942-01-01, ..)
  christmas: fixed(12, 25) effective [1870-06-28, ..) observed nearest_weekday
}

/// FRCP 6(a) as restyled in 2007: exclude intermediate Saturdays, Sundays,
/// and legal holidays when the period is less than 11 days (6(a)(2)).
counting frcp6
  effective [2007-12-01, 2009-12-01) known_at 2007-04-30
  cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  short_period { below: 11.days, count: business_days }
  service_extension { Mail: 3.days }
  holidays federal-holidays
}

/// FRCP 6(a) as amended in 2009: count every day (6(a)(1)(B)).
counting frcp6
  effective [2009-12-01, ..) known_at 2009-03-26 supersedes frcp6@2007-12-01
  cite "FRCP 6(a)(1)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension { Mail: 3.days }
  holidays federal-holidays
  allow_hours
}
