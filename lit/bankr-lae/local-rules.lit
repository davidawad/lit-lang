module bankr-lae-local-rules.local-rules

import core.frbp9006.{ frbp9006 }
import frbp.events.{ FirstMeetingDate, OrderForReliefEntered, PetitionFiled }

// The Bankr. E.D. La. court's own periods, counted under FRBP 9006(a). The
// FRBP periods (schedules, claims, discharge, dischargeability,
// exemptions, the adversary answer and summons, new trial, appeals) are
// lit/frbp's and are not declared again; the 30-day temporary stay of 11
// U.S.C. § 362(c)(3) the rules refer to (LR 4001-2(C)) is the Code's.
// Stated in the rules but not declared: the clock periods (remote filing
// fees within forty-eight hours, LR 1006-1(A)(1); the United States
// Trustee's 48-hour scheduling of the § 341 meeting, LR 2003-1(A),
// 4002-1(A)(5); the confirmation docket published 24 hours before the
// hearing, LR 3015-4(B)); notice periods a movant gives for a hearing it
// sets (21 days on a motion requiring a hearing, LR 9013-1(B); dismissal
// or conversion of a chapter 11 case, LR 1017-1(C); fees under $1,000, LR
// 2016-1(C); final employment approval and counsel's withdrawal, LR
// 2014-1(B), (C); cash collateral and credit, LR 4001-3(A); default
// judgment, LR 7055-1(C); a Rule 2004 motion on 14 days' notice, LR
// 2004-1(A); seven days' notice of an ex parte chapter 13 conversion or a
// chapter 7 conversion order, LR 1017-1(A), (B); interim employment, LR
// 2014-1(B); 28 days' notice of a post-confirmation modification, LR
// 3015-2(B), 4002-1(A)(4)); the seven-day opposition windows of LR
// 1017-1(B), which name no trigger; the bar on extending the time for
// schedules beyond seven days before the § 341 meeting, a limit on the
// court (LR 1007-1); the 14 days' written notice of default before an ex
// parte stay-relief motion (LR 4001-4), measured to the creditor's own
// filing; the 30-day automatic extension of the stay pending a late
// hearing (LR 4001-1(B)); the six-month post-confirmation reports (LR
// 3020-1); the cash-collateral challenge periods a financing order must
// preserve (75 days from entry, 60 days from a committee's formation, LR
// 4001-3(D)(2)), which are terms of the order; and the 14-day minimum
// reasonable notice of a deposition (LR 7030-1(A)). The rules state no
// page limit. The earlier outline's Supreme Court decisions (City of
// Chicago v. Fulton, Taylor v. Freeland & Kronz, Kontrick v. Ryan)
// construe the Code and the FRBP, not these rules, and are removed here:
// no reporter text is vendored.
/// Notice of entry of an order granting an amendment that adds a creditor
/// after the claims bar date or the discharge and dischargeability
/// deadlines is given (Bankr. E.D. La. LR 1007-2(E)).
event AddedCreditorOrderNoticed()
/// The movant receives notice of the United States Trustee's denial of a
/// request to reschedule the meeting of creditors or to appear through a
/// representative (Bankr. E.D. La. LR 2003-1(B)(2)).
event RescheduleDenialReceived()
/// A § 341(a) meeting of creditors rescheduled at the debtor's request in a
/// chapter 7, 12 or 13 case concludes (Bankr. E.D. La. LR 2003-1(B)(4)).
event RescheduledMeetingConcluded()
/// The date proposed for an examination under FRBP 2004 sought by ex parte
/// motion (Bankr. E.D. La. LR 2004-1(B)(1)).
event ProposedExaminationDate()
/// The hearing on confirmation of a plan (Bankr. E.D. La. LR 3015-1(B),
/// 3015-2(A), 3015-4(B), 3018-1).
event ConfirmationHearing()
/// The hearing on a chapter 11 disclosure statement or on plan confirmation
/// (Bankr. E.D. La. LR 3015-1(D)).
event DisclosureOrConfirmationHearing()
/// All obligations under a confirmed plan are completed (Bankr. E.D. La. LR
/// 3022-1(A)).
event PlanObligationsCompleted()
/// A chapter 13 debtor receives a tax refund (Bankr. E.D. La. LR
/// 4002-1(A)(1)).
event TaxRefundReceived()
/// The chapter 13 trustee receives the debtor's tax refund (Bankr. E.D. La.
/// LR 4002-1(A)(1)).
event TaxRefundReceivedByTrustee()
/// The time at which a pleading in an adversary proceeding would otherwise
/// be due (Bankr. E.D. La. LR 7007-1).
event PleadingOtherwiseDue()
/// An evidentiary trial or hearing concludes (Bankr. E.D. La. LR 7040-1(D),
/// 9017-1(B)).
event EvidentiaryHearingConcluded()
/// A party receives notice of entry of a judgment (Bankr. E.D. La. LR
/// 7054-1).
event JudgmentEntryNoticed()
/// The deadline for a defendant's answer passes without a timely answer
/// (Bankr. E.D. La. LR 7055-1(A)).
event AnswerDeadlinePassed()
/// The Clerk enters a default (Bankr. E.D. La. LR 7055-1(B)).
event DefaultEntered()
/// The hearing on a motion noticed under Bankr. E.D. La. LR 9013-1 (LR
/// 9013-1(E), (G), 9014-1(A)).
event MotionHearing()
/// The final disposition of a case or adversary proceeding (Bankr. E.D. La.
/// LR 9017-1(C)).
event FinalDisposition()

/// Bankr. E.D. La. LR 1007-2(A): in an involuntary case, the debtor files a
/// complete mailing matrix of all known creditors and parties in interest
/// within fourteen days of entry of the order for relief.
deadline involuntary-mailing-matrix-period: 14.days after OrderForReliefEntered() counted_by frbp9006 cite "Bankr. E.D. La. LR 1007-2(A)"
/// Bankr. E.D. La. LR 1007-2(D)(1): when an amendment adds a creditor
/// before the § 341(a) meeting, the debtor notices the added party at least
/// twenty-one days before the meeting; later, or with less notice, the
/// debtor moves ex parte to amend (D)(2).
deadline added-creditor-notice-period: 21.days before FirstMeetingDate() counted_by frbp9006 cite "Bankr. E.D. La. LR 1007-2(D)"
/// Bankr. E.D. La. LR 1007-2(E): when an amendment adding a creditor after
/// the bar date or the discharge and dischargeability deadlines is granted,
/// those deadlines are automatically extended as to the added party twenty-
/// eight days from notice of entry of the order.
deadline added-creditor-extended-deadline-period: 28.days after AddedCreditorOrderNoticed() counted_by frbp9006 cite "Bankr. E.D. La. LR 1007-2(E)"
/// Bankr. E.D. La. LR 1008-1(A): within seven days after filing the
/// petition, the debtor delivers to the Clerk an original Declaration
/// Regarding Electronic Filing.
deadline electronic-filing-declaration-period: 7.days after PetitionFiled() counted_by frbp9006 cite "Bankr. E.D. La. LR 1008-1(A)"
/// Bankr. E.D. La. LR 2003-1(B)(2): a motion under FRBP 2020 for review of
/// the United States Trustee's denial of a request to reschedule a meeting
/// of creditors, or to appear through a representative, is filed no later
/// than seven days after the movant receives notice of the denial.
deadline meeting-denial-review-motion-period: 7.days after RescheduleDenialReceived() counted_by frbp9006 cite "Bankr. E.D. La. LR 2003-1(B)"
/// Bankr. E.D. La. LR 2003-1(B)(4)(a): when a chapter 13 debtor's request
/// to reschedule the § 341(a) meeting is granted, the debtor is deemed to
/// consent to a claims bar date ninety days after the conclusion of the
/// rescheduled meeting.
deadline rescheduled-meeting-chapter-13-bar-period: 90.days after RescheduledMeetingConcluded() counted_by frbp9006 cite "Bankr. E.D. La. LR 2003-1(B)"
/// Bankr. E.D. La. LR 2003-1(B)(4)(b): in chapter 7, 12 and 13 cases,
/// granting the debtor's request to reschedule the § 341(a) meeting
/// extends, by the debtor's deemed consent, the deadline to object to
/// discharge or dischargeability to sixty days after the conclusion of the
/// rescheduled meeting.
deadline rescheduled-meeting-discharge-objection-period: 60.days after RescheduledMeetingConcluded() counted_by frbp9006 cite "Bankr. E.D. La. LR 2003-1(B)"
/// Bankr. E.D. La. LR 2003-1(B)(4)(c): by the same deemed consent, motions
/// to dismiss under 11 U.S.C. § 707(a) or (b) may be filed until sixty days
/// after the conclusion of the § 341(a) meeting.
deadline rescheduled-meeting-dismissal-motion-period: 60.days after RescheduledMeetingConcluded() counted_by frbp9006 cite "Bankr. E.D. La. LR 2003-1(B)"
/// Bankr. E.D. La. LR 2003-1(B)(4)(d): by the same deemed consent,
/// objections to claims of exemptions may be filed until thirty days after
/// the conclusion of the § 341(a) meeting.
deadline rescheduled-meeting-exemption-objection-period: 30.days after RescheduledMeetingConcluded() counted_by frbp9006 cite "Bankr. E.D. La. LR 2003-1(B)"
/// Bankr. E.D. La. LR 2004-1(B)(1): a person objecting to a Rule 2004
/// examination sought by ex parte motion files the objection at least seven
/// days before the proposed examination, unless the motion was filed fewer
/// than seven days before it, and notices the objection for hearing before
/// the examination date (B)(2).
deadline examination-objection-period: 7.days before ProposedExaminationDate() counted_by frbp9006 cite "Bankr. E.D. La. LR 2004-1(B)"
/// Bankr. E.D. La. LR 3015-1(B): a chapter 13 plan not filed with the
/// petition is served in full on the mailing matrix at least twenty-eight
/// days before the first confirmation hearing (also LR 4002-1(A)(5)).
deadline chapter-13-plan-service-period: 28.days before ConfirmationHearing() counted_by frbp9006 cite "Bankr. E.D. La. LR 3015-1(B)"
/// Bankr. E.D. La. LR 3015-1(B): the proposed chapter 13 plan is filed and
/// served on the chapter 13 trustee at least fourteen days before the §
/// 341(a) meeting (also LR 4002-1(A)(5)).
deadline chapter-13-plan-trustee-period: 14.days before FirstMeetingDate() counted_by frbp9006 cite "Bankr. E.D. La. LR 3015-1(B)"
/// Bankr. E.D. La. LR 3015-1(D): in chapter 11 cases, written objections to
/// a disclosure statement or to plan confirmation are filed and served no
/// later than seven days before the hearing, unless the court orders
/// otherwise.
deadline chapter-11-objection-period: 7.days before DisclosureOrConfirmationHearing() counted_by frbp9006 cite "Bankr. E.D. La. LR 3015-1(D)"
/// Bankr. E.D. La. LR 3015-2(A)(2): in chapter 11, 12 and 13 cases, an
/// amended plan is filed no later than seven days before the confirmation
/// hearing, with a redline copy to chambers; a later amendment may not be
/// considered.
deadline amended-plan-filing-period: 7.days before ConfirmationHearing() counted_by frbp9006 cite "Bankr. E.D. La. LR 3015-2(A)"
/// Bankr. E.D. La. LR 3015-2(A)(2): the movant files the notice of hearing
/// and certificate of service of the amended plan at least seven days
/// before the confirmation hearing.
deadline amended-plan-certificate-period: 7.days before ConfirmationHearing() counted_by frbp9006 cite "Bankr. E.D. La. LR 3015-2(A)"
/// Bankr. E.D. La. LR 3015-2(A)(2), (4): material amendments without
/// consent are noticed, and in chapter 13 cases served on the affected
/// parties and the trustee, at least twenty-eight days before the hearing
/// on confirmation.
deadline material-amendment-notice-period: 28.days before ConfirmationHearing() counted_by frbp9006 cite "Bankr. E.D. La. LR 3015-2(A)"
/// Bankr. E.D. La. LR 3015-4(B): in a chapter 13 case, if debtor's counsel
/// files a confirmation affidavit no later than five days before the
/// confirmation hearing and no objection is made, the court may confirm the
/// plan without a hearing.
deadline confirmation-affidavit-period: 5.days before ConfirmationHearing() counted_by frbp9006 cite "Bankr. E.D. La. LR 3015-4(B)"
/// Bankr. E.D. La. LR 3018-1(A): at least three days before the hearing on
/// confirmation, the chapter 11 plan proponent certifies the amount and
/// number of allowed claims and interests of each class accepting or
/// rejecting the plan.
deadline ballot-certification-period: 3.days before ConfirmationHearing() counted_by frbp9006 cite "Bankr. E.D. La. LR 3018-1(A)"
/// Bankr. E.D. La. LR 3018-1(B): unless otherwise ordered, all ballots are
/// delivered to chambers no later than three days before confirmation.
deadline ballot-delivery-period: 3.days before ConfirmationHearing() counted_by frbp9006 cite "Bankr. E.D. La. LR 3018-1(B)"
/// Bankr. E.D. La. LR 3022-1(A): the proponent of a confirmed plan files a
/// motion for final decree within thirty days after completion of all
/// obligations under the plan; the court may extend the date for good
/// cause.
deadline final-decree-motion-period: 30.days after PlanObligationsCompleted() counted_by frbp9006 cite "Bankr. E.D. La. LR 3022-1(A)"
/// Bankr. E.D. La. LR 4001-2(A): to obtain an extension of the automatic
/// stay, the debtor files a motion to extend or impose it within seven days
/// of the filing of the petition.
deadline stay-extension-motion-period: 7.days after PetitionFiled() counted_by frbp9006 cite "Bankr. E.D. La. LR 4001-2(A)"
/// Bankr. E.D. La. LR 4002-1(A)(1): a chapter 13 debtor provides all tax
/// refunds to the trustee within seven days of receipt.
deadline tax-refund-turnover-period: 7.days after TaxRefundReceived() counted_by frbp9006 cite "Bankr. E.D. La. LR 4002-1(A)"
/// Bankr. E.D. La. LR 4002-1(A)(1): a chapter 13 debtor who wishes to
/// receive any portion of a tax refund moves for use of the funds within
/// twenty-one days of the trustee's receipt of them.
deadline tax-refund-use-motion-period: 21.days after TaxRefundReceivedByTrustee() counted_by frbp9006 cite "Bankr. E.D. La. LR 4002-1(A)"
/// Bankr. E.D. La. LR 4002-1(C)(1)(a): within seven days of the filing of
/// the petition, an individual chapter 11 debtor provides the United States
/// Trustee a proposed budget of monthly income and expenses.
deadline chapter-11-budget-period: 7.days after PetitionFiled() counted_by frbp9006 cite "Bankr. E.D. La. LR 4002-1(C)"
/// Bankr. E.D. La. LR 4002-1(C)(1)(a): the United States Trustee files a
/// notice of approval attaching the individual chapter 11 debtor's budget
/// within thirty days of the petition date.
deadline chapter-11-budget-approval-period: 30.days after PetitionFiled() counted_by frbp9006 cite "Bankr. E.D. La. LR 4002-1(C)"
/// Bankr. E.D. La. LR 4002-1(C)(1)(a): if no agreement is reached, the
/// individual chapter 11 debtor moves for approval of a budget within
/// thirty-seven days of the petition.
deadline chapter-11-budget-motion-period: 37.days after PetitionFiled() counted_by frbp9006 cite "Bankr. E.D. La. LR 4002-1(C)"
/// Bankr. E.D. La. LR 7007-1: on certification of no previous extension and
/// no objection, the court allows by ex parte motion one extension of
/// twenty-one days from the time the pleading would otherwise be due.
deadline pleading-extension-period: 21.days after PleadingOtherwiseDue() counted_by frbp9006 cite "Bankr. E.D. La. LR 7007-1"
/// Bankr. E.D. La. LR 7040-1(D), 9017-1(B): unless the presiding judge
/// orders otherwise, within seven days after the conclusion of an
/// evidentiary trial or hearing counsel jointly submit, electronically, all
/// documentary exhibits admitted.
deadline trial-exhibits-submission-period: 7.days after EvidentiaryHearingConcluded() counted_by frbp9006 cite "Bankr. E.D. La. LR 7040-1(D)"
/// Bankr. E.D. La. LR 7054-1: within thirty days after receiving notice of
/// entry of judgment, the prevailing party claiming costs serves and files
/// a notice of application to have the costs taxed, with a supporting
/// memorandum.
deadline costs-application-period: 30.days after JudgmentEntryNoticed() counted_by frbp9006 cite "Bankr. E.D. La. LR 7054-1"
/// Bankr. E.D. La. LR 7055-1(A): when the defendant has not timely
/// answered, the plaintiff requests the Clerk's entry of default within
/// fourteen days after the answer deadline, or the court may dismiss the
/// adversary proceeding.
deadline default-request-period: 14.days after AnswerDeadlinePassed() counted_by frbp9006 cite "Bankr. E.D. La. LR 7055-1(A)"
/// Bankr. E.D. La. LR 7055-1(B): the plaintiff files a motion for default
/// judgment within fourteen days after the Clerk's entry of default, or the
/// court may dismiss the adversary proceeding.
deadline default-judgment-motion-period: 14.days after DefaultEntered() counted_by frbp9006 cite "Bankr. E.D. La. LR 7055-1(B)"
/// Bankr. E.D. La. LR 9013-1(E): objections and responses to a motion
/// noticed for hearing are filed no later than seven days before the
/// hearing unless the court orders otherwise; a later filing needs leave
/// and may be stricken.
deadline motion-objection-period: 7.days before MotionHearing() counted_by frbp9006 cite "Bankr. E.D. La. LR 9013-1(E)"
/// Bankr. E.D. La. LR 9013-1(G): evidence on a non-routine matter may be
/// presented by affidavit submitted into the record at least seven days
/// before the hearing.
deadline affidavit-evidence-period: 7.days before MotionHearing() counted_by frbp9006 cite "Bankr. E.D. La. LR 9013-1(G)"
/// Bankr. E.D. La. LR 9014-1(A)(1): motions to continue may be filed ex
/// parte no later than seven days before the hearing date and are served on
/// all interested parties.
deadline continuance-motion-period: 7.days before MotionHearing() counted_by frbp9006 cite "Bankr. E.D. La. LR 9014-1(A)"
/// Bankr. E.D. La. LR 9017-1(C): exhibits admitted into evidence are
/// retrieved within thirty days of the final disposition of the case or
/// adversary proceeding, after which the Clerk may destroy them.
deadline exhibit-retrieval-period: 30.days after FinalDisposition() counted_by frbp9006 cite "Bankr. E.D. La. LR 9017-1(C)"

start motion-filed

state motion-filed: "Motion filed and set for hearing" by applicant cite "Bankr. E.D. La. LR 9013-1(B)"
{
  note "A motion that requires a hearing is set, when filed, for the first motion day at least 21 days after it is noticed, except as the FRBP or the court provides; the motions LR 9013-1(D) lists may be submitted ex parte (LR 9013-1(B), (D)). The motion's FRBP periods are lit/frbp's."
  edge-motion-filed-opposed "Objection or response filed" -> opposed {
    authority cite "Bankr. E.D. La. LR 9013-1(E)"
  }
  edge-motion-filed-unopposed "No timely objection" -> ruling {
    authority cite "Bankr. E.D. La. LR 9013-1(E)"
  }
}

state opposed: "Objection filed; heard on motion day" by opponent cite "Bankr. E.D. La. LR 9013-1(E)"
{
  note "Objections and responses are filed no later than seven days before the hearing; a later filing needs leave (LR 9013-1(E)). Matters needing evidence or argument over twenty minutes are specially set (LR 9013-1(G))."
  edge-opposed-ruling "Hearing held" -> ruling { authority cite "Bankr. E.D. La. LR 9013-1(F)" }
}

decision ruling: "Motion decided" by court cite "Bankr. E.D. La. LR 9013-1(F)"
{
  note "Motions are heard on the motion days each judge designates (LR 9013-1(F))."
  edge-ruling-granted "Granted" -> decided { authority cite "Bankr. E.D. La. LR 9013-1(F)" }
  edge-ruling-denied "Denied" -> decided { authority cite "Bankr. E.D. La. LR 9013-1(F)" }
}

terminal decided: "Matter decided: the case continues under lit/frbp" outcome [procedural] cite "Bankr. E.D. La. LR 1001-1"
