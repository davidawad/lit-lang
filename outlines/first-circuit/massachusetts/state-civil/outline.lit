// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-ma-state-civil

start commenced

state commenced: "Complaint Filed" by applicant cite ?("Mass. R. Civ. P. 3")
{
  note "OUTLINE. A civil action commences with the filing of the complaint. Filing fee and service period are holes."
  edge-commenced-response-due "Defendant served" -> response-due {
    authority cite ?("Mass. R. Civ. P. 4(j)")
  }
}

decision response-due: "Answer or Motion Due" by office cite ?("Mass. R. Civ. P. 12(a)")
{
  note "OUTLINE. The response period is a hole until verified. Leading decision on pleading challenges (verify): Iannacchino v. Ford Motor Co., 451 Mass. 623 (2008)"
  edge-response-due-default "No response" -> default-entered {
    authority cite ?("Mass. R. Civ. P. 55")
  }
  edge-response-due-motion "Pre-answer motion filed" -> pleading-ruling {
    authority cite ?("Mass. R. Civ. P. 12(b)(6)")
  }
  edge-response-due-discovery "Answer filed" -> discovery {
    authority cite ?("Mass. R. Civ. P. 12(a)")
  }
}

decision pleading-ruling: "Pre-answer Motion Decided" by court cite ?("Mass. R. Civ. P. 12(b)(6)")
{
  note "OUTLINE. Motion practice follows Mass. R. Civ. P. 7 and superior court standing orders (holes)."
  edge-pleading-ruling-dismissed "Dismissed" -> dismissed {
    authority cite ?("Mass. R. Civ. P. 12(b)(6)")
  }
  edge-pleading-ruling-discovery "Motion denied; case proceeds" -> discovery {
    authority cite ?("Mass. R. Civ. P. 12(a)")
  }
}

state discovery: "Discovery" by applicant cite ?("Mass. R. Civ. P. 26")
{
  note "OUTLINE. Discovery under Mass. R. Civ. P. 26-37 (verify). Scope, deadlines and sanctions are holes until verified."
  edge-discovery-sj-ruling "Dispositive motion filed" -> sj-ruling {
    authority cite ?("Mass. R. Civ. P. 56")
  }
  edge-discovery-trial-ready "No dispositive motion" -> trial-ready {
    authority cite ?("Mass. R. Civ. P. 16")
  }
}

decision sj-ruling: "Summary Judgment Decided" by court cite ?("Mass. R. Civ. P. 56")
{
  note "OUTLINE. Leading decision on summary judgment (verify): Kourouvacilis v. General Motors Corp., 410 Mass. 706 (1991)"
  edge-sj-ruling-granted "Granted" -> sj-granted {
    authority cite ?("Mass. R. Civ. P. 56")
  }
  edge-sj-ruling-denied "Denied" -> trial-ready {
    authority cite ?("Mass. R. Civ. P. 56")
  }
}

decision trial-ready: "Pretrial and Trial Setting" by court cite ?("Mass. R. Civ. P. 16")
{
  note "OUTLINE. Pretrial order, jury demand and trial setting. Settlement and dismissal paths are not modeled."
  edge-trial-ready-verdict "Tried" -> verdict {
    authority cite ?("Mass. R. Civ. P. 50(a)")
  }
}

state verdict: "Verdict Returned" by applicant cite ?("Mass. R. Civ. P. 50(a)")
{
  note "OUTLINE. Motions for judgment as a matter of law and for a new trial follow the verdict."
  edge-verdict-post-trial "Post-trial motions" -> post-trial {
    authority cite ?("Mass. R. Civ. P. 50(b), 59")
  }
}

decision post-trial: "Post-trial Motions Decided" by court cite ?("Mass. R. Civ. P. 50(b), 59")
{
  note "OUTLINE. Deadlines for renewed motions are holes until verified."
  edge-post-trial-judgment "Judgment entered" -> judgment-entered {
    authority cite ?("Mass. R. Civ. P. 58")
  }
}

terminal judgment-entered: "Judgment entered on verdict" outcome [win] cite ?("Mass. R. Civ. P. 58")
{
  note "OUTLINE. Notice of appeal runs from entry of judgment; see the state-appellate package for this state."
  payoff ?
}

terminal default-entered: "Default entered" outcome [loss] cite ?("Mass. R. Civ. P. 55")
{
  note "OUTLINE. Default judgment and relief from default are holes until verified."
  payoff ?
}

terminal dismissed: "Dismissed on the pleadings" outcome [loss] cite ?("Mass. R. Civ. P. 12(b)(6)")
{
  note "OUTLINE. Leading decision on pleading standard (verify): Iannacchino v. Ford Motor Co., 451 Mass. 623 (2008)"
  payoff ?
}

terminal sj-granted: "Summary judgment granted" outcome [loss] cite ?("Mass. R. Civ. P. 56")
{
  note "OUTLINE. Leading decision on summary judgment (verify): Kourouvacilis v. General Motors Corp., 410 Mass. 706 (1991)"
  payoff ?
}

