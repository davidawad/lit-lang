/// imported
decision response-period-open: "Response Window Open" by applicant cite cfr210.13.a
{
  group response-period-group
  note "Respondent has 20 days from service of the complaint and notice of investigation to answer under oath, admitting/denying/explaining each allegation (10 days if a temporary-relief motion is pending in an uncomplicated investigation). Direct structural analog of mpep-prosecution.json's applicant-response-window: the canonical player node opening this pack's response fork."
  _ "File response to the complaint and notice of investigation (Rule 210.13(a))" -> response-filed {
    authority cite cfr210.13.a
    effort 90.hours
    cost 20_000.usd
    deadline 20.days {
      extendable true
      extension_authority "ALJ good-cause order (Rule 210.6(a))"
      note "20 days from service of the complaint and notice of investigation; 10 days if a motion for temporary relief is pending in an uncomplicated investigation (19 CFR 210.13(a))."
    }
    duration { min 3.days, mode 10.days, max 20.days }
    valence good
    action_id "file.response"
  }
  _ "Fail to respond within 20 days — default exposure (Rule 210.13(default); 210.16(a))" -> default-track {
    authority cite cfr210.13.default
    effort 0.hours
    valence bad
  }
}

/// imported
state response-filed: "Response Filed" by office cite cfr210.13.a
{
  group response-period-group
  note "Written response under oath addressing each allegation; for patent complaints, non-infringement claim charts and, if invalidity is asserted, its basis and prior art."
  _ "Discovery is open (Federal Register publication triggers it — modeled here as concurrent with the response period, see instituted's note) (Rule 210.27(b))" -> discovery-open {
    authority cite cfr210.27.b
  }
}

