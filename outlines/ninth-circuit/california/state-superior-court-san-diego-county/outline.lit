// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-ca-superior-court-san-diego-county

import ca-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start commenced

state commenced: "Complaint, petition or appeal filed" by applicant cite ?("Code Civ. Proc., § 411.10 (verify)")
{
  note "OUTLINE. The San Diego County Superior Court's local rules (divisions I and II, civil) layer over the statewide Code of Civil Procedure and Rules of Court (verify). Commencement in the California Superior Court, San Diego County: filing period, fees and pleading form are holes. Leading decisions: not yet identified in this pass; verify before use."
  edge-commenced-served "Process served" -> pleadings { event ActionCommenced() authority cite ?("Code Civ. Proc., § 412.20 (verify)") }
}

chance pleadings: "Answer or motion to dismiss" by court cite ?("Code Civ. Proc., § 430.10 (verify)")
{
  note "OUTLINE. Response period and dismissal grounds are holes."
  edge-pleadings-dismissed "Dismissed on the pleadings" -> dismissed p ? { authority cite ?("Code Civ. Proc., § 430.10 (verify)") }
  edge-pleadings-answered "Answered; case proceeds" -> discovery p ? { authority cite ?("Code Civ. Proc., § 430.10 (verify)") }
  edge-pleadings-settled "Settled or withdrawn" -> settled p ? { }
}

state discovery: "Discovery and pretrial" by applicant cite ?("Code Civ. Proc., § 2017.010 (verify)")
{
  note "OUTLINE. Discovery scope, limits and scheduling are holes."
  edge-discovery-dispositive "Dispositive motion or trial setting" -> dispositive { authority cite ?("Code Civ. Proc., § 437c (verify)") }
}

chance dispositive: "Summary disposition?" by court cite ?("Code Civ. Proc., § 437c (verify)")
{
  note "OUTLINE. Summary-judgment standard and timing are holes."
  edge-dispositive-granted "Decided without trial" -> judgment p ? { authority cite ?("Code Civ. Proc., § 437c (verify)") }
  edge-dispositive-trial "Tried" -> trial p ? { authority cite ?("Super. Ct. San Diego County, Local Rules, div. II (verify)") }
}

state trial: "Trial or hearing" by court cite ?("Super. Ct. San Diego County, Local Rules, div. II (verify)")
{
  note "OUTLINE. Jury availability and trial procedure are holes."
  edge-trial-judgment "Decision rendered" -> judgment { authority cite ?("Code Civ. Proc., § 664 (verify)") }
}

state judgment: "Judgment or decision entered" by court cite ?("Code Civ. Proc., § 664 (verify)")
{
  note "OUTLINE. Entry, notice of entry and post-judgment motion periods are holes."
  edge-judgment-entered "Judgment entered" -> post-judgment { event JudgmentEntered() authority cite ?("Code Civ. Proc., § 664 (verify)") }
}

decision post-judgment: "Appeal or review?" by applicant cite ?("Cal. Rules of Court, rule 8.104 (verify)")
{
  note "OUTLINE. The appeal period and the court that hears it are holes."
  edge-post-appeal "Appeal or petition for review filed" -> appeal-taken { event NoticeOfAppealFiled() authority cite ?("Cal. Rules of Court, rule 8.104 (verify)") }
  edge-post-final "No appeal" -> final-no-appeal { }
}

terminal dismissed: "Dismissed" outcome [loss, dismissal] cite ?("Code Civ. Proc., § 430.10 (verify)")
{
  note "OUTLINE. With or without prejudice is a hole."
  payoff ?
}

terminal settled: "Settled or withdrawn" outcome [settlement] cite ?("Code Civ. Proc., § 411.10 (verify)")
{
  note "OUTLINE. Settlement terms are outside this outline."
  payoff ?
}

terminal appeal-taken: "Appeal or review taken" outcome [final] cite ?("Cal. Rules of Court, rule 8.104 (verify)")
{
  note "OUTLINE. The reviewing court is its own package."
  payoff ?
}

terminal final-no-appeal: "Judgment final without appeal" outcome [final] cite ?("Code Civ. Proc., § 664 (verify)")
{
  note "OUTLINE. Enforcement is outside this outline."
  payoff ?
}
