state motion-filed: "Motion filed and noted for hearing" by applicant cite "Bankr. W.D. Wash. LBR 9013-1(d)"
{
  note "A motion is filed and served at least 21 days before the hearing (28 for summary judgment and lien avoidance, 30 for claim objections), and a response is due 7 days before it (LBR 9013-1(d)). The motion's FRBP periods are lit/frbp's."
  edge-motion-filed-opposed "Response filed and served" -> opposed {
    authority cite "Bankr. W.D. Wash. LBR 9013-1(d)"
  }
  edge-motion-filed-unopposed "No timely response" -> ruling {
    authority cite "Bankr. W.D. Wash. LBR 9013-1(d)"
  }
}

state opposed: "Response filed; hearing" by opponent cite "Bankr. W.D. Wash. LBR 9013-1(d)"
{
  note "Any reply follows LBR 9013-1(d)."
  edge-opposed-ruling "Hearing held" -> ruling { authority cite "Bankr. W.D. Wash. LBR 9013-1(d)" }
}

decision ruling: "Motion decided" by court cite "Bankr. W.D. Wash. LBR 9013-1(i)"
{
  note "A proposed order presented after the hearing is served with at least 7 days' notice unless its form is agreed; objections are due 3 days before presentation (LBR 9013-1(i))."
  edge-ruling-granted "Granted" -> decided { authority cite "Bankr. W.D. Wash. LBR 9013-1(i)" }
  edge-ruling-denied "Denied" -> decided { authority cite "Bankr. W.D. Wash. LBR 9013-1(i)" }
}

