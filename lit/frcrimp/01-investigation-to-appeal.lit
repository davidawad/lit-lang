terminal judgment-entered: "Judgment and Commitment Entered" outcome [loss, conviction] delegable_to [CaseOrder] cite Fed. R. Crim. P. 32(k)
  effective [2024-12-01, ..)
{
  group verdict-sentencing-group
  note "Written judgment is the appealable final disposition; it simultaneously starts the Rule 35(a) 14-day correction clock and the FRAP 4(b) 14-day appeal clock. Modeled as terminal because it is reached identically whether the conviction came by plea or by jury verdict, even though Rule 35/appeal paths still branch from it. PLACEHOLDER PAYOFF: $50,000, override per matter. A conviction (by plea or verdict); modeled as terminal here even though Rule 35/appeal paths still branch from it in the pack's own edges (see this node's note)."
  valence caution
  payoff 50_000.usd
  _ "Consider Rule 35 relief" -> rule35-motion {
    authority cite Fed. R. Crim. P. 35(a)
    deadline 14.days {
      extendable false
      note "After 14 days from judgment entry, the trial court is powerless to correct the sentence under Rule 35(a), even for obvious clear error; the government's separate Rule 35(b) substantial-assistance motion has its own 1-year window and does not extend this one."
    }
    duration { min 2.1.days, mode 7.days, max 14.days }
  }
  _ "Start appeal clock" -> notice-of-appeal-window by office {
    authority cite Fed. R. App. P. 4(b)(1)
    deadline 14.days {
      extendable true
      extension_authority "Fed. R. App. P. 4(b)(1)(B) — up to 30 additional days for good cause shown, before or after the deadline expires"
      note "Appeal deadline is 14 days from judgment entry; if it passes without a notice of appeal or a timely extension request, appellate jurisdiction is lost and the sentence becomes final."
    }
    duration { min 2.1.days, mode 7.days, max 14.days }
  }
}

