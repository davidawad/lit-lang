// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
// Outcome tags are labels only; payoff is a hole. Rule numbers are from memory: verify each.
module outline-ca10-bap

start threshold

decision threshold: "Appealable Order or Judgment?" by applicant cite ?("28 U.S.C. § 158(a)")
{
  note "OUTLINE. Final decision under 28 U.S.C. 1291 or interlocutory route under 28 U.S.C. 1292 (verify). Leading decisions (verify): Mohawk Industries, Inc. v. Carpenter, 558 U.S. 100 (2009) (collateral order); Coopers & Lybrand v. Livesay, 437 U.S. 463 (1978) (collateral order); Microsoft Corp. v. Baker, 582 U.S. 23 (2017) (voluntary dismissal). Local: Tenth Circuit BAP local rules (number to verify); election between BAP and district court under 28 U.S.C. 158(c) (verify)."
  edge-threshold-no "Not appealable" -> dismissed-jurisdiction {
    authority cite ?("28 U.S.C. § 158(a)")
  }
  edge-threshold-yes "Appealable" -> notice {
    authority cite ?("28 U.S.C. § 158(a)")
  }
}

decision notice: "Notice of Appeal Within Time?" by applicant cite ?("Fed. R. Bankr. P. 8002")
{
  note "OUTLINE. Leading decisions (verify): Bowles v. Russell, 551 U.S. 205 (2007); Hamer v. Neighborhood Housing Services, Inc., 583 U.S. 17 (2017). Local: Tenth Circuit BAP local rules (number to verify); election between BAP and district court under 28 U.S.C. 158(c) (verify)."
  edge-notice-late "Untimely notice" -> dismissed-untimely {
    authority cite ?("Fed. R. Bankr. P. 8002")
  }
  edge-notice-timely "Timely notice" -> record {
    authority cite ?("Fed. R. Bankr. P. 8002")
  }
}

state record: "Record and Transcript Assembled" by office cite ?("Fed. R. Bankr. P. 8009")
{
  note "OUTLINE. Record and transcript under FRAP 10 and 11; circuit rules control docketing (verify). Local: Tenth Circuit BAP local rules (number to verify); election between BAP and district court under 28 U.S.C. 158(c) (verify)."
  edge-record-brief "Record filed" -> briefing {
    authority cite ?("Fed. R. Bankr. P. 8009")
  }
}

state briefing: "Briefs Filed" by applicant cite ?("Fed. R. Bankr. P. 8018")
{
  note "OUTLINE. Briefs, page and word limits (verify; circuit rules). Local: Tenth Circuit BAP local rules (number to verify); election between BAP and district court under 28 U.S.C. 158(c) (verify)."
  edge-briefing-argue "Briefing complete" -> argument {
    authority cite ?("Fed. R. Bankr. P. 8018")
  }
}

state argument: "Oral Argument or Submission" by court cite ?("Fed. R. Bankr. P. 8019")
{
  note "OUTLINE. Oral argument calendaring and submission (verify; circuit rules). Local: Tenth Circuit BAP local rules (number to verify); election between BAP and district court under 28 U.S.C. 158(c) (verify)."
  edge-argument-decide "Decision" -> decision {
    authority cite ?("Fed. R. Bankr. P. 8019")
  }
}

state decision: "Decision Issued" by court cite ?("28 U.S.C. § 158(c)")
{
  note "OUTLINE. Judgment or opinion under FRAP 36 (verify). Local: Tenth Circuit BAP local rules (number to verify); election between BAP and district court under 28 U.S.C. 158(c) (verify)."
  edge-decision-issued "Opinion or judgment issued" -> rehearing-decision {
    authority cite ?("28 U.S.C. § 158(c)")
  }
}

decision rehearing-decision: "Rehearing Sought?" by applicant cite ?("Fed. R. Bankr. P. 8022")
{
  note "OUTLINE. Panel and en banc rehearing; FRAP 35 and 40 (verify). Local: Tenth Circuit BAP local rules (number to verify); election between BAP and district court under 28 U.S.C. 158(c) (verify)."
  edge-rehearing-decision-none "No petition" -> mandate {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
  edge-rehearing-decision-sought "Petition filed" -> rehearing-order {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
}

state rehearing-order: "Rehearing Order" by court cite ?("Fed. R. Bankr. P. 8022")
{
  note "OUTLINE. Court order on rehearing or en banc petition."
  edge-rehearing-order-mandate "Rehearing decided" -> mandate {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
}

state mandate: "Mandate or Remittitur Issued" by office cite ?("28 U.S.C. § 158(c)")
{
  note "OUTLINE. Mandate under FRAP 41 (verify)."
  edge-mandate-further "Mandate issued" -> further-review {
    authority cite ?("28 U.S.C. § 158(c)")
  }
}

decision further-review: "Further Review Sought?" by applicant cite ?("28 U.S.C. § 158(d)")
{
  note "OUTLINE. Certiorari under 28 U.S.C. 1254 and Sup. Ct. R. 13 (verify period). Leading decision: none named."
  edge-further-review-none "No further review" -> final-decision {
    authority cite ?("28 U.S.C. § 158(d)")
  }
  edge-further-review-petition "Petition for review or certiorari" -> review-decided {
    authority cite ?("28 U.S.C. § 158(d)")
  }
}

state review-decided: "Further Review Decided" by court cite ?("28 U.S.C. § 158(d)")
{
  note "OUTLINE. Court decision on the petition."
  edge-review-decided-denied "Denied" -> review-denied {
    authority cite ?("28 U.S.C. § 158(d)")
  }
  edge-review-decided-granted "Granted" -> review-granted {
    authority cite ?("28 U.S.C. § 158(d)")
  }
}

terminal dismissed-jurisdiction: "Dismissed: No Appellate Jurisdiction" outcome [loss, dismissal, jurisdictional] cite ?("28 U.S.C. § 158(a)")
{
  note "OUTLINE. Dismissal for lack of appellate jurisdiction."
  payoff ?
}

terminal dismissed-untimely: "Dismissed: Untimely Notice" outcome [loss, dismissal] cite ?("Fed. R. Bankr. P. 8002")
{
  note "OUTLINE. Dismissal for untimely notice of appeal."
  payoff ?
}

terminal final-decision: "Final: Decision Stands" outcome [final] cite ?("28 U.S.C. § 158(c)")
{
  note "OUTLINE. Decision stands; mandate issued."
  payoff ?
}

terminal review-denied: "Further Review Denied" outcome [final] cite ?("28 U.S.C. § 158(d)")
{
  note "OUTLINE. Certiorari denied."
  payoff ?
}

terminal review-granted: "Further Review Granted" outcome [neutral] cite ?("28 U.S.C. § 158(d)")
{
  note "OUTLINE. Certiorari granted; merits not modeled."
  payoff ?
}
