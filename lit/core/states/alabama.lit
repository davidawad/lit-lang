module core.states.alabama

import core.calendar.{ us-federal-holidays }

/// The official state holidays of Alabama (Ala. Code § 1-3-8(a)), on which all
/// state offices close (§ 1-3-8(c)), that `us-federal-holidays` does not
/// already close: Confederate Memorial Day, the fourth Monday in April, and
/// Jefferson Davis' birthday, the first Monday in June. The section's other
/// days are federal holidays, observed as § 6103(b)(1) observes them (§
/// 1-3-8(b)). Closed from the date the vendored text was retrieved (October 29,
/// 2026; its history ends with Act 2025-303). Not modeled: Thanksgiving "as
/// designated by the Governor" on a day other than the federal one, and Mardi
/// Gras, a holiday "in Baldwin and Mobile Counties" only (§ 1-3-8(e)(1)), so a
/// last day on one is the earlier date.
calendar alabama-holidays cite "Ala. Code § 1-3-8"
{
  confederate-memorial-day: nth(4, monday, 4) effective [2026-10-29, ..)
  jefferson-davis-birthday: nth(1, monday, 6) effective [2026-10-29, ..)
}

/// FRCP 6 in the district courts of Alabama: the 2023 text
/// (`frcp6@2023-12-01`) with `alabama-holidays`, which 6(a)(6)(C)
/// ("any day declared a holiday by ... the state where the district court
/// is located") makes legal holidays "for periods that are measured after
/// an event" only. A district package there names it as its `counting`
/// rule and `recounts` lit/frcp. A calendar day is closed only from the
/// date its entry is in force; before it the count is `frcp6`'s.
counting frcp6-alabama effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCP 6(d)"
  holidays us-federal-holidays
  forward_holidays alabama-holidays cite "FRCP 6(a)(6)(C)"
  forums [frcp]
  allow_hours
  end_of_month clamp
}

/// FRBP 9006(a) (`frbp9006`) in the bankruptcy courts of Alabama:
/// `alabama-holidays` are legal holidays for a period counted forward only (FRBP
/// 9006(a)(6)(C), "any day declared a holiday by the state where the
/// district court is located"). A bankruptcy package there names it as its
/// `counting` rule and `recounts` lit/frbp. A calendar day is closed only
/// from the date its entry is in force.
counting frbp9006-alabama effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays alabama-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-alm, bankr-aln, bankr-als]
  allow_hours
  end_of_month clamp
}
