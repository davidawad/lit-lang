// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.

module outline-or-trial-court

import outline-or-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start commenced

state commenced: "Complaint Filed" by applicant cite ?("ORCP 1 A")
{
  note "Commencement by filing. Filing fee is a hole."
  edge-commenced-response-due "Summons and complaint served" -> response-due { event ActionCommenced()
    authority cite ?("ORCP 7")
  }
}

decision response-due: "Answer or Motion Due" by office cite ?("ORCP 22")
{
  note "Response period is a hole. Verify against the rule and any stipulation practice."
  edge-response-due-default-entered "No response" -> default-entered {
    authority cite ?("ORCP 69")
  }
  edge-response-due-motion-ruling "Motion filed" -> motion-ruling {
    authority cite ?("ORCP 21")
  }
  edge-response-due-discovery "Answer filed" -> discovery {
    authority cite ?("ORCP 22")
  }
}

terminal default-entered: "Default entered" outcome [loss] cite ?("ORCP 69")
{
  note "Default entry and set-aside standard are holes. Verify."
  payoff ?
}

decision motion-ruling: "Motion Ruling" by court cite ?("ORCP 21")
{
  note "Pleading standard: identify and verify the leading Oregon decision."
  edge-motion-ruling-dismissed "Dismissed" -> dismissed {
    authority cite ?("ORCP 21")
  }
  edge-motion-ruling-discovery "Denied" -> discovery {
    authority cite ?("ORCP 21")
  }
}

terminal dismissed: "Dismissed on the pleadings" outcome [loss] cite ?("ORCP 21")
{
  note "Leave to amend and with or without prejudice are holes. Verify."
  payoff ?
}

state discovery: "Discovery" by applicant cite ?("ORCP 36")
{
  note "Disclosure, discovery limits and deadlines are holes. Verify."
  edge-discovery-settled "Settlement or dismissal" -> settled {
    authority cite ?("ORCP 54")
  }
  edge-discovery-summary-judgment "Discovery closed; dispositive motion" -> summary-judgment {
    authority cite ?("ORCP 47")
  }
}

decision summary-judgment: "Summary Judgment" by court cite ?("ORCP 47")
{
  note "Summary judgment: identify and verify the leading Oregon decision."
  edge-summary-judgment-judgment-merits "Granted" -> judgment-merits {
    authority cite ?("ORCP 47")
  }
  edge-summary-judgment-trial "Denied" -> trial {
    authority cite ?("ORCP 47")
  }
}

terminal judgment-merits: "Summary judgment entered" outcome [win] cite ?("ORCP 47")
{
  note "OUTLINE. Written from the applicant side; the winner depends on who moved (verify)."
  payoff ?
}

decision trial: "Jury or Bench Trial" by court cite ?("ORCP 51")
{
  note "Jury demand timing is a hole. Verify."
  edge-trial-post-trial "Verdict or decision" -> post-trial { event JudgmentEntered()
    authority cite ?("ORCP 51")
  }
  edge-trial-settled "Settled before verdict" -> settled {
    authority cite ?("ORCP 54")
  }
}

decision post-trial: "Post-Trial Motions" by applicant cite ?("ORCP 60")
{
  note "Post-trial motion timing and standard are holes. Verify."
  edge-post-trial-judgment-entered "Motions resolved or none filed" -> judgment-entered { event JudgmentEntered()
    authority cite ?("ORCP 59")
  }
}

decision judgment-entered: "Judgment Entered" by court cite ?("ORCP 67")
{
  note "Entry of judgment and finality are holes. Verify."
  edge-judgment-entered-appeal-filed "Notice of appeal" -> appeal-filed {
    authority cite ?("ORAP 5.05")
  }
  edge-judgment-entered-judgment-final "No appeal" -> judgment-final {
    authority cite ?("ORCP 67")
  }
}

terminal appeal-filed: "Notice of appeal filed; continue in appellate package" outcome [appeal] cite ?("ORAP 5.05")
{
  note "Notice period is a hole. Verify the appellate notice rule and tolling."
  payoff ?
}

terminal judgment-final: "Final judgment, no appeal" outcome [judgment] cite ?("ORCP 67")
{
  note "OUTLINE. Outcome depends on the judgment entered (verify)."
  payoff ?
}

terminal settled: "Settled or dismissed by agreement" outcome [settle] cite ?("ORCP 54")
{
  note "OUTLINE. Settlement terms and any dismissal mechanics are holes."
  payoff ?
}

