module change-validation.splits

import core.frap26.{ frap26 }

// The circuit split `frap-4a6-notice` of the lg-fq2.3 corpus
// (sources/change-corpus/rulings/README.md): which notice of entry opens
// the 7-day window of FRAP 4(a)(6)(A) as amended in 1991 and 1998. The
// text says only that the moving party "receives notice of the entry";
// each circuit's precedent reads the notice its own way, and the engine
// selects the reading that binds at a world's circuit (lg-i1qw):
//
// - reading A, written notice from the clerk or a party: D.C. Cir.
//   (Benavides v. Bureau of Prisons, 79 F.3d 1211 (1996), holding), 1st
//   Cir. (Scott-Harris, 1997), 2d Cir. (Avolio, 1994);
// - reading B, any written notice, whoever sends it: 5th Cir. (Bass v.
//   U.S. Dep't of Agriculture, 211 F.3d 959 (2000), written notice
//   required, holding; Wilkens v. Johnson, 238 F.3d 328 (2001), any
//   source), 2d Cir. (Ryan, 1999);
// - reading C, actual notice: 8th Cir. (Zimmer St. Louis, Inc. v. Zimmer
//   Co., 32 F.3d 357 (1994), dictum), 9th Cir. (Nunley v. City of Los
//   Angeles, 52 F.3d 792 (1995), notice by reading the docket). Neither
//   decides whether oral notice is actual notice (Bass: they "speak in
//   terms of 'actual notice,' without expressly taking a position on
//   whether oral notice is enough"): VALIDATION.md §4 records it as a
//   source ambiguity.
//
// The text is `reopen-window` below, opened by any notice; Benavides, Bass
// and Nunley are precedent layers that each `interprets` it as one reading
// (cases/precedents), and the split cases replay through them in a world
// per circuit (cases/split-*.world; VALIDATION.md §4).
/// How a notice of entry reaches the moving party.
enum NoticeForm {
  Oral,
  Written,
}

/// Who sends a notice of entry.
enum NoticeSource {
  ClerkOrParty,
  Other,
}

/// The moving party receives notice of the entry, in `form`, from
/// `source`.
event NoticeReceived(form: NoticeForm, source: NoticeSource)

/// FRAP 4(a)(6)(A) from 1991 to the 2005 amendment, as written: "within 7
/// days after the moving party receives notice of the entry", any notice.
/// Where a precedent binds, its reading of the notice governs instead.
deadline reopen-window: 7.days after NoticeReceived() counted_by frap26 effective [1991-12-01, 2005-12-01) cite "FRAP (2008 ed.) 4(a)(6)" historical
{
  forum frap
}

test "frap-4a6-notice, the text alone: any notice, oral notice of May 26, 1999 included, opens the window" cite "FRAP (2008 ed.) 4(a)(6)"
{
  given NoticeReceived(Oral, Other) on 1999-05-26
  expect deadline(reopen-window) == 1999-06-02
}

/// The moving party is served formal notice of entry under FRCP 77(d)
/// (by the clerk or a party, under FRCP 5(b)).
event Rule77dNoticeServed()

/// From December 1, 2005, FRAP 4(a)(6)(B) itself settles the split: the
/// window is still 7 days, "after the moving party receives notice under
/// Federal Rule of Civil Procedure 77(d) of the entry" (order of April 25,
/// 2005), and "only formal notice of the entry of a judgment or order under
/// Civil Rule 77(d) will trigger the 7-day period" (2005 Committee Note,
/// which cites Bass, Benavides and Ryan). The published draft's "written
/// notice of the entry from any source" (reading B) was not adopted (the
/// Note's "Changes Made After Publication"). The amendment ends every
/// reading: each interprets only the 1991 text.
deadline reopen-window-rule-77d: 7.days after Rule77dNoticeServed() counted_by frap26 effective [2005-12-01, 2009-12-01) known_at 2005-04-25 supersedes reopen-window cite "FRAP (2008 ed.) 4(a)(6)"
{
  forum frap
}

/// From December 1, 2009 the window is 14 days (order of March 26, 2009).
deadline reopen-window-rule-77d: 14.days after Rule77dNoticeServed() counted_by frap26 effective [2009-12-01, ..) known_at 2009-03-26 supersedes reopen-window-rule-77d@2005-12-01 cite "FRAP (2009) 4(a)(6)"
{
  forum frap
}

test "frap-4a6-notice, after the 2005 amendment: formal notice under Rule 77(d) opens a 7-day window in every circuit" cite "FRAP (2008 ed.) 4(a)(6)"
{
  given Rule77dNoticeServed() on 2007-03-02
  expect deadline(reopen-window-rule-77d) == 2007-03-13
}

test "frap-4a6-notice, after the 2009 amendment: the window is 14 days" cite "FRAP (2009) 4(a)(6)"
{
  given Rule77dNoticeServed() on 2012-03-02
  expect deadline(reopen-window-rule-77d) == 2012-03-16
}
