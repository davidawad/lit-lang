# A world (docs/litigate/CHANGE.md §5): the set of layers in force, where,
# and in which modality. Order and repetition mean nothing: precedence comes
# from the instruments. `as_of` and `known_at` are query coordinates, not
# part of the world.
modality = "actual"
layers = ["change-frcp-base", "change-frcp-2009-amendment", "change-sdny-local-civil-rules"]

[location]
family = "district-civil"
court = "d-sdny"
circuit = "ca2"
