{"parents":[{"StatuteId":2048328,"Type":"Title","Statute":"23A"},{"StatuteId":2048992,"Type":"Chapter","Statute":"29"}],"Previous":"23A-28C-16","Next":"23A-29-1","StatuteId":2048992,"Statute":"23A-29","Type":"Chapter","CatchLine":"(RULE 33) NEW TRIAL ","FilePath":null,"FileName":null,"Htmlpath":null,"Htmlfilename":null,"Title":23,"TitleLetter":"A","Chapter":29,"ChapterLetter":null,"Section":0,"SubSec":0,"SubSection":null,"Word":null,"Html":"                                                                   \r\n                                                                          \r\n                                                                          \r\n                                                                          \r\n                                                                          \r\n<html>\r\n<head>\r\n<html>\r\n<head>\r\n<title>23A-29 (RULE 33) NEW TRIAL </title>\r\n<meta name=\"Keywords\" content=\"South Dakota Codified Laws SDCL 23A-29 (RULE 33) NEW TRIAL \">\r\n<meta name=\"Description\" content=\"South Dakota Codified Laws 23A-29\">\r\n</head>\r\n<body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\">\r\n\r\n<!-- File converted by Wp2Html Version 4.0  -->\r\n<!-- Email Andrew@brackenbeds.co.uk for more details  -->\r\n\r\n<!-- WP Style Open: System_34 --><!-- WP Style End: System_34 -->\r\n<div align=\"full\">\r\n<!-- WP Paired Style On: HG4 --><div align=\"center\"><!-- WP Style End: HG4 -->\r\nCHAPTER 23A-29\r\n<!-- WP Paired Style Off: HG4 --><!-- WP Style End: HG4 -->\r\n</div>\r\n\r\n<br>\r\n\r\n<!-- WP Paired Style On: HG4C --><div align=\"center\"><!-- WP Style End: HG4C -->\r\n(RULE 33) NEW TRIAL\r\n<!-- WP Paired Style Off: HG4C --><!-- WP Style End: HG4C -->\r\n</div>\r\n\r\n<br>\r\n<p>\r\n\r\n<!-- WP Paired Style On: B --><!-- WP Style End: B -->\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-29-1\">23A-29-1</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\nTime for motion for new trial--Rulings thereon--Extension of time.\r\n<!-- WP Paired Style Off: B --><!-- WP Style End: B -->\r\n<br>\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-29-2\">23A-29-2</a>\r\n<!-- WP Style Open: IN -->&nbsp;&nbsp;&nbsp;&nbsp;<!-- WP Style End: IN -->\r\nEffect of grant of new trial--Evidence received.<p>\r\n</p></div></div></body>\r\n</html>\r\n<hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2048990Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048990SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048990CL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2048990Normal-000000 {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-indent: 0.50in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048990DefaultParagraphFont {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048990000001 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048990SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048990SCL-000002 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2048990Normal\"><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-29-1\"><span class=\"s2048990SENU\">23A-29-1</span></a><span xml:space=\"preserve\" class=\"s2048990SENU\">. </span><span class=\"s2048990CL\">Time for motion for new trial--Rulings thereon--Extension of time.</span></p><p dir=\"ltr\" class=\"s2048990Normal-000000\"><span class=\"s2048990DefaultParagraphFont\">A motion for new trial may be made under the same conditions specified and in the same manner as provided by § 15-6-59(b), except that said motion shall be served and filed not later than ten days after filing of the judgment.</span></p><p dir=\"ltr\" class=\"s2048990Normal\"><span xml:space=\"preserve\" class=\"s2048990000001\"> </span></p><p dir=\"ltr\" class=\"s2048990Normal\"><span class=\"s2048990SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2048990SCL-000002\"><span>  SDC 1939 &amp; Supp 1960, §§ 34.4003, 34.4004; SDCL, §§ 23-50-3, 23-50-4; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 377; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1987/411/null/null\" aria-label=\"SL 1987, ch 411\">SL 1987, ch 411</a> (Supreme Court Rule 86-37); <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1988/433/null/null\" aria-label=\"SL 1988, ch 433\">SL 1988, ch 433</a> (Supreme Court Rule 87-14).</span></span></p></div></div></body></html><hr><br><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"UTF-8\"><title></title><meta name=\"Generator\" content=\"PowerTools for Open XML\"><style>span { white-space: pre-wrap; }\r\np.s2048991Normal {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048991SENU {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048991CL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\np.s2048991Normal-000000 {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    text-indent: 0.50in;\r\n    text-align: justify;\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    line-height: 108%;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n}\r\nspan.s2048991DefaultParagraphFont {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048991000001 {\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048991SCL {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: bold;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\nspan.s2048991SCL-000002 {\r\n    font-family: 'Times New Roman', 'serif';\r\n    font-size: 12pt;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n</style></head><body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\"><div><p dir=\"ltr\" class=\"s2048991Normal\"><a href=\"https://sdlegislature.gov/Statutes/Codified_Laws/DisplayStatute.aspx?Type=Statute&amp;Statute=23A-29-2\"><span class=\"s2048991SENU\">23A-29-2</span></a><span xml:space=\"preserve\" class=\"s2048991SENU\">. </span><span class=\"s2048991CL\">Effect of grant of new trial--Evidence received.</span></p><p dir=\"ltr\" class=\"s2048991Normal-000000\"><span class=\"s2048991DefaultParagraphFont\">The granting of a new trial places the parties in the same position as if no trial had been had. All evidence must be produced anew, and the former verdict cannot be used or referred to, either in evidence or in argument.</span></p><p dir=\"ltr\" class=\"s2048991Normal\"><span xml:space=\"preserve\" class=\"s2048991000001\"> </span></p><p dir=\"ltr\" class=\"s2048991Normal\"><span class=\"s2048991SCL\">Source:</span><span xml:space=\"preserve\" class=\"s2048991SCL-000002\"><span>  SDC 1939 &amp; Supp 1960, § 34.4001; SDCL, § 23-50-12; <a rel=\"noopener nofollow\" target=\"_blank\" href=\"/api/SessionLaws/1978/178/null/null\" aria-label=\"SL 1978, ch 178\">SL 1978, ch 178</a>, § 380.</span></span></p></div></div></body></html></head></html>","Credits":null,"StatuteText":null,"Article":null,"Created":null,"CreatedById":null,"LastUpdated":null,"LastUpdatedBy":null,"Repealed":false,"StatuteReferencesReferencesStatute":[],"StatuteReferencesStatute":[]}