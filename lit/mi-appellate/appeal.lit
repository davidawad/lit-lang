module mi-appellate-civil.appeal

import mi-state-rules.{ DecisionFiled, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

// Civil appeals from a Michigan circuit court to the Court of Appeals, from
// the appellant's side, to the application for leave to the Supreme Court
// (its procedure is lit/mi-supreme-court's).
// Every period below is stated in a note, not counted: time is computed
// under MCR 1.108, with Michigan's legal holidays and court-closure days,
// for which lit/core has no counting rule. The appeal entry fee is the fee
// the claim of appeal must carry (MCR 7.204(B)(2)); the vendored rules do
// not state its amount. The outline named no leading decisions.
/// A brief in the Court of Appeals: at most 16,000 words unless
/// the court orders otherwise; a self-represented party without a
/// word-processing system may file a typewritten or handwritten brief of
/// at most 50 pages (MCR 7.212(B)(1)).
limit brief { words <= 16_000 cite "MCR 7.212(B)" } cite "MCR 7.212(B)"
/// A reply brief: at most 3,200 words (MCR 7.212(G)).
limit reply-brief { words <= 3_200 cite "MCR 7.212(G)" } cite "MCR 7.212(G)"
/// A motion for reconsideration in the Court of Appeals: at most 3,200
/// words (MCR 7.215(I)(1)).
limit reconsideration-motion { words <= 3_200 cite "MCR 7.215(I)" } cite "MCR 7.215(I)"
/// An answer to a motion for reconsideration: at most 2,500 words (MCR
/// 7.215(I)(2)).
limit reconsideration-answer { words <= 2_500 cite "MCR 7.215(I)" } cite "MCR 7.215(I)"

start judgment-entered

state judgment-entered: "Final judgment entered in the circuit court" by applicant cite "MCR 7.203(A)"
{
  note "The Court of Appeals has jurisdiction of an appeal of right by an aggrieved party from a final judgment or final order of the circuit court, except one on appeal from another court (MCR 7.203(A)(1)); other orders are reviewed by leave (MCR 7.203(B)). The time limit for an appeal of right is jurisdictional and MCR 1.108 computes it; 'entry' is the date the judgment is signed or entered in the register of actions (MCR 7.204(A)). In a civil case the appeal of right is taken within 21 days after entry of the judgment, or of an order deciding a motion for new trial, rehearing, reconsideration or other relief filed within the initial 21-day period (MCR 7.204(A)(1))."
  edge-judgment-entered-claim "Claim of appeal filed within 21 days" -> claim-filed {
    event NoticeOfAppealFiled()
    authority cite "MCR 7.204(A)"
  }
  edge-judgment-entered-late "21 days pass without a claim of appeal" -> late-application {
    authority cite "MCR 7.205(A)"
  }
}

decision late-application: "Delayed application for leave granted?" by court cite "MCR 7.205(A)"
{
  note "When an appeal of right was not timely filed, the court may grant leave to appeal (MCR 7.203(B)(5)). A delayed application for leave may be filed within 6 months of the entry of the judgment, with a statement of facts explaining the reasons for delay (MCR 7.205(A)(4)(a))."
  edge-late-application-granted "Leave granted" -> claim-filed { authority cite "MCR 7.203(B)" }
  edge-late-application-denied "No application, or leave denied" -> time-barred {
    authority cite "MCR 7.205(A)"
  }
}

state claim-filed: "Claim of appeal filed" by applicant cite "MCR 7.204(B)"
{
  note "To vest the Court of Appeals with jurisdiction the appellant files the claim of appeal and the entry fee with the clerk within the time for taking an appeal (MCR 7.204(B)). With the claim the appellant files the judgment appealed from, the court reporter's certificate or a statement that the transcript has been ordered or that there is no record to transcribe, proof of service, any bond, the register of actions and a jurisdictional checklist (MCR 7.204(C))."
  edge-claim-filed-record "Transcript ordered; record assembled" -> record {
    authority cite "MCR 7.210"
  }
}

state record: "Record and transcript" by office cite "MCR 7.210"
{
  note "Within seven days after a transcript is ordered, the court reporter or recorder files a certificate that it has been ordered and paid for or secured, with the estimated number of pages (MCR 7.210(B)(3)(a))."
  edge-record-briefing "Transcript filed; briefing" -> briefing {
    event RecordFiled()
    authority cite "MCR 7.212(A)"
  }
}

state briefing: "Briefs filed" by applicant cite "MCR 7.212(A)"
{
  note "In an ordinary civil appeal the appellant files its brief within 56 days after the claim of appeal is filed or the transcript is filed, whichever is later; the parties may extend that time by 28 days by signed stipulation (MCR 7.212(A)(1)(a)(iii)). The appellee may file its brief within 35 days after the appellant's brief is served, also extendable by 28 days by stipulation (MCR 7.212(A)(2)(a)(ii)). The appellant may reply within 21 days after service of the appellee's brief (MCR 7.212(G)). A party that fails to file its brief in time forfeits oral argument (MCR 7.212(A)(4)), and filing a motion does not stay the time for a brief (MCR 7.212(A)(5))."
  edge-briefing-argument "Oral argument requested in the brief" -> argument {
    authority cite "MCR 7.214(A)"
  }
  edge-briefing-submitted "Submitted on briefs" -> decision { authority cite "MCR 7.214(E)" }
}

state argument: "Oral argument" by office cite "MCR 7.214(B)"
{
  note "Oral argument is not permitted unless a party states 'ORAL ARGUMENT REQUESTED' on the title page of its brief or the court orders it (MCR 7.214(A)). Each side has 30 minutes; a side alone represented has 15 minutes, and the court may extend the time on a motion filed at least 21 days before the session (MCR 7.214(B))."
  edge-argument-decision "Argued" -> decision { authority cite "MCR 7.215(A)" }
}

decision decision: "Court of Appeals decision" by court cite "MCR 7.216(A)"
{
  note "The court may enter any judgment or order or grant further or different relief as the case requires, remand to take additional evidence, or dismiss an appeal for lack of jurisdiction or failure to pursue it in conformity with the rules (MCR 7.216(A)(5), (7), (10)). An opinion is published if it meets the standards of MCR 7.215(B). A motion for reconsideration may be filed within 21 days after the date of the order or opinion, and a party may answer within 14 days after service (MCR 7.215(I)(1), (2)). Unless otherwise ordered, the judgment is effective after the time for an application for leave to the Supreme Court expires or, if one is filed, after the Supreme Court disposes of the case (MCR 7.215(F)(1)(a))."
  edge-decision-affirmed "Affirmed" -> affirmed {
    event DecisionFiled()
    authority cite "MCR 7.216(A)"
  }
  edge-decision-reversed "Reversed or modified" -> reversed {
    event DecisionFiled()
    authority cite "MCR 7.216(A)"
  }
  edge-decision-remanded "Remanded" -> remanded {
    event DecisionFiled()
    authority cite "MCR 7.216(A)"
  }
  edge-decision-dismissed "Appeal dismissed" -> appeal-dismissed {
    event DecisionFiled()
    authority cite "MCR 7.216(A)"
  }
  edge-decision-reconsideration "Reconsideration sought" -> reconsideration {
    authority cite "MCR 7.215(I)"
  }
}

decision reconsideration: "Motion for reconsideration decided" by court cite "MCR 7.215(I)"
{
  note "The motion must include all facts, arguments and authorities in a single document and include the order or opinion; it is subject to the palpable-error standard of MCR 2.119(F)(3) (MCR 7.215(I)(1))."
  edge-reconsideration-granted "Granted" -> decision { authority cite "MCR 7.215(I)" }
  edge-reconsideration-denied "Denied" -> supreme-review { authority cite "MCR 7.305(C)" }
}

decision supreme-review: "Application for leave to appeal to the Supreme Court?" by applicant cite "MCR 7.305(C)"
{
  note "In a civil case the application is filed within 42 days after the Court of Appeals order or opinion resolving the appeal, or its order denying a timely motion for reconsideration (MCR 7.305(C)(2)); it must show one of the grounds of MCR 7.305(B). The Supreme Court will not accept a motion to file a late application (MCR 7.316(B)). The application, its answer and reply, and the Court's decision on it are lit/mi-supreme-court's."
  edge-supreme-review-none "Not sought: the Court of Appeals decision stands" -> review-not-sought {
    authority cite "MCR 7.215(F)"
  }
  edge-supreme-review-filed "Application for leave filed" -> leave-sought {
    event ReviewPetitionFiled()
    authority cite "MCR 7.305(C)"
  }
}

terminal time-barred: "Appeal time missed" outcome [loss, dismissal] cite "MCR 7.204(A)"
{
  note "The time limit for an appeal of right is jurisdictional (MCR 7.204(A)), and the time for a delayed application for leave is jurisdictional as well (MCR 7.205(A))."
}

terminal affirmed: "Affirmed" outcome [loss] cite "MCR 7.216(A)"
{
  note "Leave to appeal may be sought in the Supreme Court within 42 days (MCR 7.305(C)(2))."
}

terminal reversed: "Reversed or modified" outcome [win, judgment] cite "MCR 7.216(A)"

terminal remanded: "Remanded to the circuit court" outcome [win] cite "MCR 7.216(A)"
{
  note "An application for leave to the Supreme Court from a decision remanding for further proceedings may be filed within 42 days in a civil case (MCR 7.305(C)(5))."
}

terminal appeal-dismissed: "Appeal dismissed" outcome [loss, dismissal] cite "MCR 7.216(A)"

terminal review-not-sought: "Court of Appeals decision final" outcome [final, loss] cite "MCR 7.215(F)"
{
  note "Unless otherwise ordered, the Court of Appeals judgment is effective after the time for an application for leave to the Supreme Court expires (MCR 7.215(F)(1)(a))."
}

terminal leave-sought: "Application for leave pending in the Supreme Court" outcome [appeal] cite "MCR 7.305(C)"
{
  note "The application proceeds in the Supreme Court under MCR 7.305 (lit/mi-supreme-court). If one is filed, the Court of Appeals judgment is effective after the Supreme Court disposes of the case (MCR 7.215(F)(1)(a))."
}
