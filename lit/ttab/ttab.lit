// Imported by `litigate import` from packs/ttab-trademark-trial-and-appeal-board.json.
module ttab

import core.authority.{ CaseOrder }
import core.frcp6.{ frcp6 }

group pre: "Pre-opposition"
group standstill: "Standstill and negotiation"
group lapse: "Lapse, allowance, registration"
group opposition: "Opposition: institution and answer"
group discovery: "Discovery"
group trial: "Trial and briefs"
group decision: "Decision"
group appeal: "Appeal"
group abandon: "Abandon now"
group threat: "Infringement suit threat"
group terminals: "Terminals"

// The deadlines every `within` edge of the pack reads. The legacy pack
// counts them under FRCP 6 (its `counting`); the Board's own computation
// rule is 37 C.F.R. § 2.196, which agrees for every period here (calendar
// days, a last day on a Saturday, Sunday, or Federal holiday rolls to the
// next day that is none of them).
//
// Effective dates: the vendored eCFR text drops its amendment-history lines
// (sources/PROVENANCE.md), so the dates below come from the Federal
// Register. 37 C.F.R. §§ 2.101, 2.102, 2.105, 2.120, and 2.145 read as
// cited since the TTAB rules revision, 81 FR 69950 (Oct. 7, 2016),
// effective January 14, 2017.
/// Publication of the application for opposition (15 U.S.C. § 1062(a),
/// 37 C.F.R. § 2.80).
event Published()
/// Day 30 from publication, the unextended end of the opposition period;
/// extensions of time to oppose run from it.
event OppositionPeriodExpired()
/// Day 60 from publication, the end of a first 30-day extension.
event FirstExtensionExpired()

/// The extension of time to oppose an opposer requests (37 C.F.R.
/// § 2.102(c)): a first 30 days on request or 90 days for good cause, then
/// 60 more days for good cause after the 30.
enum ExtensionTerm { Thirty, Ninety, Sixty }

/// A request for an extension of time to oppose, filed before the period
/// it extends expires (37 C.F.R. § 2.102(a), (c)).
event ExtensionRequested(term: ExtensionTerm)
/// Day 120 from publication, the end of a period extended by 90 days in all
/// (37 C.F.R. § 2.102(c)(3)): the point an opposer must oppose, or seek the
/// final extension, by.
event ExtendedPeriodExpired()
/// The Board's notice of institution, which designates the answer time
/// and sets the trial schedule (37 C.F.R. §§ 2.105(a), 2.120(a)(1)). Its
/// date is the notice's mailing date; `due` is the date it designates for
/// the answer, as the notice states it (`?` when the matter does not have
/// it: the answer deadline is then unknown).
event InstitutionNoticed(due: Date)
/// The Board's designation of the time to answer a counterclaim (37
/// C.F.R. § 2.106(b)(3)(iii)). Its date is the designation's mailing date;
/// `due` is the date it designates.
event CounterclaimAnswerTimeDesignated(due: Date)
/// The Board's notice of institution of a cancellation proceeding (37
/// C.F.R. § 2.113(a)). Its date is the notice's mailing date; `due` is the
/// date it designates for the answer.
event CancellationInstitutionNoticed(due: Date)
/// The opening of the discovery period set in the institution order.
event DiscoveryOpened()
/// The Board's final decision in the opposition.
event FinalDecision()
/// A written request to the Director to extend the time for commencing a
/// civil action (37 C.F.R. § 2.145(e)(1)). Its date is its receipt date:
/// the Eastern Time date the Office receives the email, "regardless of
/// whether that date is a Saturday, Sunday, or Federal holiday within the
/// District of Columbia" (§ 2.145(e)(2)(i)). That date is `request_made`.
event CivilActionExtensionRequested()
/// The Director, or the Director's designee, extends the time for
/// commencing a civil action to `until` (37 C.F.R. § 2.145(e)(1)).
event CivilActionPeriodExtended(until: Date) extends civil-action-period to until

/// 37 C.F.R. § 2.101(c): an opposition is due within thirty days after
/// publication, and a request to extend must be filed before those thirty
/// days expire (§ 2.102(c)).
rule duty opposition-time effective [2017-01-14, ..) known_at 2016-10-07 cite "37 CFR 2.101(c)"
{
  deadline opposition-period: 30.days from Published() counted_by frcp6
}

test "the opposition period runs 30 days from publication" cite "37 CFR 2.101(c)"
{
  given Published() on 2025-03-03
  expect deadline(opposition-period) == 2025-04-02
}

test "an opposition period ending on Thanksgiving rolls to Friday" cite "37 CFR 2.101(c)"
{
  given Published() on 2025-10-28
  expect deadline(opposition-period) == 2025-11-28
}

/// 37 C.F.R. § 2.102(c): extensions of time to oppose. A first request
/// for 90 days (good cause) or 30 days (on request), then 60 more days
/// for good cause after the 30, then one final 60 days on the applicant's
/// consent or extraordinary circumstances, never beyond 180 days from
/// publication.
rule duty extensions-of-time effective [2017-01-14, ..) known_at 2016-10-07 cite "37 CFR 2.102(c)"
{
  deadline first-extension-90: 90.days from OppositionPeriodExpired() counted_by frcp6 cite "37 CFR 2.102(c)(1)(ii)"
  deadline second-extension-60: 60.days from FirstExtensionExpired() counted_by frcp6 cite "37 CFR 2.102(c)(2)"
  deadline extended-period-120: 120.days from Published() counted_by frcp6 cite "37 CFR 2.102(c)(3)"
  deadline outer-limit-180: 180.days from Published() counted_by frcp6 cite "37 CFR 2.102(c)"
}

test "a 90-day first extension runs from the end of the original period" cite "37 CFR 2.102(c)(1)(ii)"
{
  given OppositionPeriodExpired() on 2025-01-02
  expect deadline(first-extension-90) == 2025-04-02
}

test "a 90-day extension ending on Memorial Day rolls to Tuesday" cite "37 CFR 2.102(c)(1)(ii)"
{
  given OppositionPeriodExpired() on 2025-02-25
  expect deadline(first-extension-90) == 2025-05-27
}

test "a 90-day extension ending on a Saturday rolls to Monday" cite "37 CFR 2.102(c)(1)(ii)"
{
  given OppositionPeriodExpired() on 2025-04-13
  expect deadline(first-extension-90) == 2025-07-14
}

test "the additional 60 days run from the end of the 30-day extension" cite "37 CFR 2.102(c)(2)"
{
  given FirstExtensionExpired() on 2025-03-03
  expect deadline(second-extension-60) == 2025-05-02
}

test "an additional 60 days ending on a Saturday roll to Monday" cite "37 CFR 2.102(c)(2)"
{
  given FirstExtensionExpired() on 2025-04-08
  expect deadline(second-extension-60) == 2025-06-09
}

test "extensions totaling 90 days end on day 120 from publication" cite "37 CFR 2.102(c)(3)"
{
  given Published() on 2025-01-06
  expect deadline(extended-period-120) == 2025-05-06
}

test "a day 120 on a Sunday rolls to Monday" cite "37 CFR 2.102(c)(3)"
{
  given Published() on 2025-01-11
  expect deadline(extended-period-120) == 2025-05-12
}

test "no extension reaches beyond 180 days from publication" cite "37 CFR 2.102(c)"
{
  given Published() on 2025-05-10
  expect deadline(outer-limit-180) == 2025-11-06
}

test "a day 180 on the Saturday before Labor Day rolls to Tuesday" cite "37 CFR 2.102(c)"
{
  given Published() on 2025-03-03
  expect deadline(outer-limit-180) == 2025-09-02
}

/// 37 C.F.R. § 2.105(a): the notice of institution "shall designate a
/// time, not less than thirty days from the mailing date of the notice,
/// within which an answer must be filed". The answer is due on the date
/// the notice designates, an input of each matter, never a period counted
/// in its place: thirty days is only the least time the regulation allows,
/// and a notice designating less is rejected. § 2.106(a) lets the Board
/// reset it ("the time initially set, or as may later be reset by the
/// Board"): an order of the Board in the proceeding is a `CaseOrder`
/// layer, which the deadline delegates to. A designated last day on a
/// Saturday, Sunday, or Federal holiday rolls to the next day that is none
/// of them (§ 2.196).
///
/// In force from the TTAB rules revision, 81 FR 69950 (Oct. 7, 2016),
/// effective January 14, 2017: the eCFR's last amendment of §§ 2.105 and
/// 2.106 (sources/cfr-37-part2-answer-time-history.txt).
rule duty answer-time effective [2017-01-14, ..) known_at 2016-10-07 cite "37 CFR 2.105(a)"
{
  deadline answer-period: 30.days from InstitutionNoticed() counted_by frcp6 delegable_to [CaseOrder] cite "37 CFR 2.105(a)"
  {
    designated due
  }
}

test "a notice designating 30 days sets the answer date" cite "37 CFR 2.105(a)"
{
  given InstitutionNoticed(2025-04-02) on 2025-03-03
  expect deadline(answer-period) == 2025-04-02
}

test "a notice designating 40 days sets the answer date" cite "37 CFR 2.105(a)"
{
  given InstitutionNoticed(2025-04-14) on 2025-03-05
  expect deadline(answer-period) == 2025-04-14
}

test "a notice designating 60 days sets the answer date" cite "37 CFR 2.105(a)"
{
  given InstitutionNoticed(2026-09-04) on 2026-07-06
  expect deadline(answer-period) == 2026-09-04
}

test "a designated answer day on a Saturday rolls to Monday" cite "37 CFR 2.105(a)"
{
  given InstitutionNoticed(2026-08-08) on 2026-06-09
  expect deadline(answer-period).nominal == 2026-08-08
  expect deadline(answer-period) == 2026-08-10
}

test "a designated answer day on Labor Day rolls to Tuesday" cite "37 CFR 2.105(a)"
{
  given InstitutionNoticed(2026-09-07) on 2026-07-09
  expect deadline(answer-period) == 2026-09-08
}

/// 37 C.F.R. § 2.106(b)(3)(iii): "A time, not less than thirty days, will
/// be designated by the Board within which an answer to the counterclaim
/// must be filed." As for the answer, the date is the Board's designation,
/// thirty days from its mailing date the least it may allow; the Board may
/// reset it (§ 2.106(b)(3)(iv)). In force from 81 FR 69950, effective
/// January 14, 2017 (sources/cfr-37-part2-answer-time-history.txt).
rule duty counterclaim-answer-time effective [2017-01-14, ..) known_at 2016-10-07 cite "37 CFR 2.106(b)(3)(iii)"
{
  deadline counterclaim-answer-period: 30.days from CounterclaimAnswerTimeDesignated() counted_by frcp6 delegable_to [CaseOrder] cite "37 CFR 2.106(b)(3)(iii)"
  {
    designated due
  }
}

test "the counterclaim answer is due on the date the Board designates" cite "37 CFR 2.106(b)(3)(iii)"
{
  given CounterclaimAnswerTimeDesignated(2025-12-10) on 2025-11-10
  expect deadline(counterclaim-answer-period) == 2025-12-10
}

test "a designated counterclaim answer day on a Saturday rolls to Monday" cite "37 CFR 2.106(b)(3)(iii)"
{
  given CounterclaimAnswerTimeDesignated(2025-12-20) on 2025-11-10
  expect deadline(counterclaim-answer-period) == 2025-12-22
}

/// 37 C.F.R. § 2.113(a): the notice of institution of a cancellation
/// "shall designate a time, not less than thirty days from the mailing
/// date of the notice, within which an answer must be filed", which the
/// Board may later reset (§ 2.114(a)(1)). In force from 81 FR 69950,
/// effective January 14, 2017 (sources/cfr-37-part2-answer-time-history.txt).
rule duty cancellation-answer-time effective [2017-01-14, ..) known_at 2016-10-07 cite "37 CFR 2.113(a)"
{
  deadline cancellation-answer-period: 30.days from CancellationInstitutionNoticed() counted_by frcp6 delegable_to [CaseOrder] cite "37 CFR 2.113(a)"
  {
    designated due
  }
}

test "a cancellation answer is due on the date the notice designates" cite "37 CFR 2.113(a)"
{
  given CancellationInstitutionNoticed(2025-04-14) on 2025-03-05
  expect deadline(cancellation-answer-period) == 2025-04-14
}

/// 37 C.F.R. § 2.120(a)(2): a 180-day discovery period, initial
/// disclosures within its first thirty days. Both may be extended or
/// modified "by order of the Board" (§ 2.120(a)(2)(iv)).
rule duty discovery-schedule effective [2017-01-14, ..) known_at 2016-10-07 cite "37 CFR 2.120(a)(2)"
{
  deadline disclosure-period: 30.days from DiscoveryOpened() counted_by frcp6 delegable_to [CaseOrder] cite "37 CFR 2.120(a)(2)(ii)"
  deadline discovery-period: 180.days from DiscoveryOpened() counted_by frcp6 delegable_to [CaseOrder] cite "37 CFR 2.120(a)(2)(i)"
}

test "initial disclosures are due 30 days after discovery opens" cite "37 CFR 2.120(a)(2)(ii)"
{
  given DiscoveryOpened() on 2025-03-03
  expect deadline(disclosure-period) == 2025-04-02
}

test "initial disclosures due on a Saturday roll to Monday" cite "37 CFR 2.120(a)(2)(ii)"
{
  given DiscoveryOpened() on 2026-03-05
  expect deadline(disclosure-period) == 2026-04-06
}

test "discovery closes 180 days after it opens" cite "37 CFR 2.120(a)(2)(i)"
{
  given DiscoveryOpened() on 2025-05-10
  expect deadline(discovery-period) == 2025-11-06
}

test "a discovery close on a Saturday rolls to Monday" cite "37 CFR 2.120(a)(2)(i)"
{
  given DiscoveryOpened() on 2026-01-12
  expect deadline(discovery-period) == 2026-07-13
}

/// 37 C.F.R. § 2.145(d)(3): a civil action under 15 U.S.C. § 1071(b) must
/// be commenced no later than 63 days after the final decision. The
/// Director, not the Board and not a court, may extend it "upon written
/// request if: (i) Requested before the expiration of the period ..., and
/// upon a showing of good cause; or (ii) Requested after the expiration of
/// the period ..., and upon a showing that the failure to act was the
/// result of excusable neglect" (§ 2.145(e)(1)): both turn on when the
/// request was made, and neither has a numeric ceiling.
rule duty review-time effective [2017-01-14, ..) known_at 2016-10-07 cite "37 CFR 2.145(d)"
{
  deadline civil-action-period: 63.days from FinalDecision() counted_by frcp6 cite "37 CFR 2.145(d)(3)"
  {
    extend { by director, discretion GoodCause, on CivilActionExtensionRequested() }
    extend {
      by director
      discretion ExcusableNeglect
      after_expiry
      on CivilActionExtensionRequested()
    }
  }
}

test "a civil action is due 63 days after the final decision" cite "37 CFR 2.145(d)(3)"
{
  given FinalDecision() on 2025-09-02
  expect deadline(civil-action-period) == 2025-11-04
}

test "a day 63 on a Saturday rolls to Monday" cite "37 CFR 2.145(d)(3)"
{
  given FinalDecision() on 2025-05-03
  expect deadline(civil-action-period) == 2025-07-07
}

test "a day 63 on Veterans Day rolls to Wednesday" cite "37 CFR 2.145(d)(3)"
{
  given FinalDecision() on 2025-09-09
  expect deadline(civil-action-period) == 2025-11-12
}
