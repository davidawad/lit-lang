state acr-record: "ACR: stipulated record, Board decides on summary-judgment-style briefs" by board cite ?("TBMP 702.04; TBMP 528.05(a)(2); TTAB ACR notice (2011-12-22)") {
  group trial
  note "Accelerated Case Resolution. Cost saving is an assumption (see edge)."
  _ "Board decides on the ACR record" -> final-decision {
    authority cite ?("TBMP 702.04")
    duration { min 90.days, mode 120.days, max 180.days }
  }
}

state trial-periods: "Trial periods: pretrial disclosures, plaintiff 30d, defendant 30d, rebuttal 15d" by applicant cite ?("37 CFR 2.121(a)-(c); TBMP 702.01") {
  group trial
  _ "Take trial testimony / notices of reliance" -> trial-closed {
    authority cite "37 CFR 2.121; 2.123; 2.125"
    effort 30.hours
    duration { min 120.days, mode 150.days, max 240.days }
    attrs { opp_hours: 35 }
  }
}

decision trial-closed: "Trial closed; briefing decision" by applicant cite "37 CFR 2.128(a)"
{
  group trial
  _ "Abandon application without opposer's consent (judgment, 37 CFR 2.135)" -> judgment-2135 {
    authority cite ?("37 CFR 2.135; TBMP 602.01")
    effort 1.hours
    valence bad
    tags [abandon-no-consent]
    attrs { opp_hours: 1 }
  }
  _ "Seek opposer's written consent to abandonment" -> opposer-consent-decision {
    authority cite ?("37 CFR 2.135; TBMP 602.01")
    effort 3.hours
    tags [abandon-with-consent]
    attrs { opp_hours: 2 }
  }
  _ "Suspend for settlement negotiations" -> talks-briefs {
    authority cite ?("37 CFR 2.117(c); TBMP 605.02")
    effort 15.hours
    duration { min 45.days, mode 90.days, max 180.days }
    tags [suspend-settle]
    attrs { opp_hours: 12 }
    sets [talked]
    forbids [talked]
  }
  _ "File briefs (55-page cap) and any oral hearing" -> briefs-filed {
    authority cite ?("37 CFR 2.128(a)-(b); TBMP 801.02")
    effort 30.hours
    duration { min 105.days, mode 105.days, max 150.days }
    tags [continue]
    attrs { opp_hours: 35 }
  }
}

