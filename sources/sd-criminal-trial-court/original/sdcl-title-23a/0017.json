{"parents":[{"StatuteId":2048328,"Type":"Title","Statute":"23A"},{"StatuteId":2048593,"Type":"Chapter","Statute":"15"}],"Previous":"23A-14A-10","Next":"23A-15-1","StatuteId":2048593,"Statute":"23A-15","Type":"Chapter","CatchLine":"(RULE 17.1) PRETRIAL CONFERENCE ","FilePath":null,"FileName":null,"Htmlpath":null,"Htmlfilename":null,"Title":23,"TitleLetter":"A","Chapter":15,"ChapterLetter":null,"Section":0,"SubSec":0,"SubSection":null,"Word":null,"Html":"                                                                   \r\n                                                                          \r\n                                                                          \r\n                                                                          \r\n                                                                          \r\n<html>\r\n<head>\r\n<html>\r\n<head>\r\n<title>23A-15 (RULE 17.1) PRETRIAL CONFERENCE </title>\r\n<meta name=\"Keywords\" content=\"South Dakota Codified Laws SDCL 23A-15 (RULE 17.1) PRETRIAL CONFERENCE \">\r\n<meta name=\"Description\" content=\"South Dakota Codified Laws 23A-15\">\r\n</head>\r\n<body><div style=\"font-family: 'Times New Roman', 'serif'; font-size: 12pt; line-height: 1;\">\r\n\r\n<!-- File converted by Wp2Html Version 4.0  -->\r\n<!-- Email Andrew@brackenbeds.co.uk for more details  -->\r\n\r\n<!-- WP Style Open: System_34 --><!-- WP Style End: System_34 -->\r\n<div align=\"full\">\r\n<!-- WP Paired Style On: HG4 --><div align=\"center\"><!-- WP Style End: HG4 -->\r\nCHAPTER 23A-15\r\n<!-- WP Paired Style Off: HG4 --><!-- WP Style End: HG4 -->\r\n</div>\r\n\r\n<br>\r\n\r\n<!-- WP Paired Style On: HG4C --><div align=\"center\"><!-- WP Style End: HG4C -->\r\n(RULE 17.1) PRETRIAL CONFERENCE\r\n<!-- WP Paired Style Off: HG4C --><!-- WP Style End: HG4C -->\r\n</div>\r\n\r\n<br>\r\n<p>\r\n\r\n<!-- WP Paired Style On: B --><!-- WP Style End: B -->\r\n<a href=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=23A-15-1\">23A-15-1</