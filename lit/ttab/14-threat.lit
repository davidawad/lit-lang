// Imported by `litigate import` from packs/ttab-trademark-trial-and-appeal-board.json.
module ttab.threat

import ttab.terminals.{ rebrand-orderly, suit-lost, suit-lost-fees, suit-won, suit-won-fees }
import ttab.{ threat }

decision infringement-suit-filed: "Opposer files federal infringement suit" by applicant cite 15 USC 1114(1); 15 USC 1125(a); 15 USC 1117(a)
{
  group threat
  note "Fees only in exceptional cases (15 USC 1117(a)); no fee shifting otherwise."
  tags [threat]
  _ "Litigate to judgment" -> suit-merits {
    authority cite 15 USC 1114(1); 1125(a)
    effort 160.hours
    cost 15_000.usd
    duration { min 420.days, mode 540.days, max 900.days }
    tags [litigate-suit]
    attrs { opp_hours: 260 }
  }
  _ "Settle early: rebrand on transition (no cost share)" -> rebrand-orderly {
    authority cite FRCP 41(a)(1)(A)(ii)
    effort 20.hours
    note "Teaching estimate. Assumption."
    tags [settle-suit]
    attrs { opp_hours: 25 }
  }
}

chance suit-merits: "Suit tried to judgment" by board cite ?("15 USC 1114(1); Frisch's Restaurants v. Elby's Big Boy, 670 F.2d 642 (6th Cir. 1982)") {
  group threat
  _ "Opposer wins: injunction, rebrand" -> suit-lost-fees-chance p 0.45 {
    authority cite 15 USC 1116; 1114(1)
    note "Teaching estimate (generic prior; a matter scenario overrides it via scenario.probabilities / probability_fn / observe). No docket statistic is claimed."
  }
  _ "Applicant wins: no infringement" -> suit-won-fees-chance p 0.55 {
    authority cite 15 USC 1114(1)
    note "Teaching estimate. Complement."
  }
}

chance suit-lost-fees-chance: "Opposer won: exceptional-case fee award?" discretion by board cite 15 USC 1117(a)
{
  group threat
  _ "Exceptional case: fees shifted to applicant" -> suit-lost-fees p 0.05 {
    authority cite 15 USC 1117(a)
    note "Teaching estimate. Exceptional-case standard (Octane Fitness applied to Lanham Act) is hard to meet; assumption."
  }
  _ "No fee award" -> suit-lost p 0.95 {
    authority cite 15 USC 1117(a)
    note "Teaching estimate. Complement."
  }
}

chance suit-won-fees-chance: "Applicant won: exceptional-case fee award?" discretion by board cite 15 USC 1117(a)
{
  group threat
  _ "Exceptional case: fees shifted to the opposer" -> suit-won-fees p 0.05 {
    authority cite 15 USC 1117(a)
    note "Teaching estimate. Assumption."
  }
  _ "No fee award" -> suit-won p 0.95 {
    authority cite 15 USC 1117(a)
    note "Teaching estimate. Complement."
  }
}
