module mied-local-rules.local-rules

import core.states.michigan.{ frcp6-michigan }

// The Eastern District of Michigan's own civil periods and limits, computed
// under FRCP 6(a), which governs a period stated in a local rule (LR 58.1's
// comment notes the same for its seven-day periods). Rules that state no
// period or limit, or one this layer cannot count, stay out: the Social
// Security fee motion under 42 U.S.C. § 406, due 14 days after entry of
// judgment or receipt of the notice of award, "whichever is later" (LR
// 54.2(a)), keyed to the later of two events; the rescheduled final
// pretrial order "no earlier than 7 days" after a dispositive motion is
// decided (LR 16.1(f)), an earliest time set by the court; the mediator's
// seven-day report of completion (LR 16.4(e)(6)), which binds the mediator,
// not a party; the six-month retention of discovery material after the
// last appeal period (LR 26.2(c)); the motion to alter or amend a judgment,
// whose time is FRCP 59(e)'s (LR 59.1(a)); trial briefs, jury instructions
// and proposed findings on the first or before the last day of trial (LR
// 16.2(d), 16.8, 52.1), which no event here models; the $200 civil
// penalty limit of the magistrate judges' duties (LR 72.1(a)(2)(N)); and
// the criminal and admiralty rules. The earlier E.D. Mich. outline's FRCP
// flow and its Supreme Court decisions (Twombly, Iqbal, Celotex, Anderson
// v. Liberty Lobby, Matsushita, Frow v. De La Vega) are FRCP authority and
// belong to lit/frcp and lit/frap; no reporter text is vendored, so they
// are removed here. LR 54.1's and LR 54.1.2's comments cite Miltimore
// Sales, Inc. v. International Rectifier, Inc., 412 F.3d 685 (6th Cir.
// 2005), for the rule that a post-judgment motion extending the time to
// appeal also extends the bill-of-costs and fee periods; no reporter text
// is vendored, so that tolling is not modeled.
/// The text of a brief supporting a motion or response, including
/// footnotes and signatures: at most 25 pages; a longer brief needs leave
/// applied for ex parte in writing (LR 7.1(d)(3)(A)).
limit motion-brief { pages <= 25 cite "E.D. Mich. LR 7.1(d)" } cite "E.D. Mich. LR 7.1(d)"
/// The text of a reply brief, including footnotes and signatures: at most
/// 7 pages (LR 7.1(d)(3)(B)).
limit reply-brief { pages <= 7 cite "E.D. Mich. LR 7.1(d)" } cite "E.D. Mich. LR 7.1(d)"

/// A motion on the standard briefing schedule is served (LR 7.1(e)(1)).
event MotionServed() paper motion-brief
/// A motion on the enlarged briefing schedule is served: for injunctive
/// relief, judgment on the pleadings, summary judgment, to certify or
/// decertify a class, to dismiss under FRCP 12(b), or to dismiss
/// involuntarily under FRCP 41(b) (LR 7.1(e)(2)(A)).
event EnlargedMotionServed() paper motion-brief
/// A response to a motion on the standard schedule is served (LR
/// 7.1(e)(1)(B)).
event ResponseServed() paper motion-brief
/// A response to a motion on the enlarged schedule is served (LR
/// 7.1(e)(2)(B)).
event EnlargedResponseServed() paper motion-brief
/// A reply brief is filed (LR 7.1(d)(1)(A), (d)(3)(B)).
event ReplyBriefFiled() paper reply-brief
/// The motion hearing is held (LR 7.1(f)).
event MotionHearing()
/// A non-final order is entered (LR 7.1(h)(2)).
event NonFinalOrderEntered()
/// A mediation session is held (LR 16.4(e)(3)).
event MediationSession()
/// A case referred to mediation settles (LR 16.4(e)(7)).
event MediationSettlement()
/// An order to file discovery material is served (LR 26.2(d)).
event DiscoveryFilingOrderServed()
/// Judgment is entered (LR 54.1, 54.1.2(a)).
event JudgmentEntered()
/// A motion for attorneys' fees under FRCP 54(d)(2) is filed (LR
/// 54.1.2(b)).
event FeeMotionFiled()
/// Final judgment is entered in a social security disability action (LR
/// 54.2(a)).
event SocialSecurityFinalJudgment()
/// The court grants a judgment or order whose entry a party will seek on
/// notice (LR 58.1(c)).
event JudgmentOrOrderGranted()
/// A proposed judgment or order is served with notice that it will be
/// submitted for signing (LR 58.1(c)).
event ProposedJudgmentNoticeServed()
/// Notice of written objections to a proposed judgment or order is
/// received (LR 58.1(c)(3)).
event ProposedJudgmentObjectionsReceived()
/// Objections permitted by FRCP 72 to a magistrate judge's order or
/// report are served (LR 72.1(d)(2), (3)).
event MagistrateObjectionsServed()
/// A response to objections to a magistrate judge's ruling is served (LR
/// 72.1(d)(4)).
event MagistrateObjectionResponseServed()
/// Trial of a civil case is scheduled to begin (LR 73.1(c)).
event ScheduledTrial()
/// A party added after reference of the case to a magistrate judge on
/// consent appears (LR 73.1(e)).
event AddedPartyAppearance()

/// LR 7.1(e)(1)(A): a response to a motion other than one on the enlarged
/// schedule is filed within 14 days after service of the motion.
deadline motion-response-period: 14.days after MotionServed() counted_by frcp6-michigan cite "E.D. Mich. LR 7.1(e)"
/// LR 7.1(e)(2)(A): a response to a motion on the enlarged schedule is
/// filed within 21 days following service of the motion.
deadline enlarged-motion-response-period: 21.days after EnlargedMotionServed() counted_by frcp6-michigan cite "E.D. Mich. LR 7.1(e)"
/// LR 7.1(e)(1)(B): a reply brief, if filed, is filed within 7 days after
/// service of the response.
deadline motion-reply-period: 7.days after ResponseServed() counted_by frcp6-michigan cite "E.D. Mich. LR 7.1(e)"
/// LR 7.1(e)(2)(B): a reply brief supporting a motion on the enlarged
/// schedule, if filed, is filed within 14 days after service of the
/// response.
deadline enlarged-motion-reply-period: 14.days after EnlargedResponseServed() counted_by frcp6-michigan cite "E.D. Mich. LR 7.1(e)"
/// LR 7.1(e)(1)(B), (e)(2)(B): on either schedule a reply brief is filed
/// at least 3 days before the motion hearing.
deadline motion-reply-before-hearing: 3.days before MotionHearing() counted_by frcp6-michigan cite "E.D. Mich. LR 7.1(e)"
/// LR 7.1(h)(2): a motion for reconsideration of a non-final order is
/// filed within 14 days after entry of the order; no response and no
/// argument unless the court orders otherwise (LR 7.1(h)(3)). Final orders
/// and judgments are reconsidered only under FRCP 59(e) or 60(b) (LR
/// 7.1(h)(1)).
deadline reconsideration-period: 14.days after NonFinalOrderEntered() counted_by frcp6-michigan cite "E.D. Mich. LR 7.1(h)"
/// LR 16.4(e)(3): unless the mediator directs otherwise, each party
/// provides the mediator a concise memorandum no later than seven
/// calendar days before the mediation session.
deadline mediation-memorandum-period: 7.days before MediationSession() counted_by frcp6-michigan cite "E.D. Mich. LR 16.4(e)"
/// LR 16.4(e)(7): if the case settles, the parties notify the court
/// without delay and submit documents to conclude the case within 21 days
/// of settlement.
deadline mediation-closing-papers-period: 21.days after MediationSettlement() counted_by frcp6-michigan cite "E.D. Mich. LR 16.4(e)"
/// LR 26.2(d): if the court orders discovery material filed, the party or
/// person with custody files it within 14 days of service of the order.
deadline discovery-filing-period: 14.days after DiscoveryFilingOrderServed() counted_by frcp6-michigan cite "E.D. Mich. LR 26.2(d)"
/// LR 54.1: a party seeking costs files a bill of costs no later than 28
/// days after the entry of judgment.
deadline bill-of-costs-period: 28.days after JudgmentEntered() counted_by frcp6-michigan cite "E.D. Mich. LR 54.1"
/// LR 54.1.2(a): a motion for attorneys' fees and related non-taxable
/// expenses under FRCP 54(d)(2) is filed no later than 28 days after entry
/// of judgment.
deadline fee-motion-period: 28.days after JudgmentEntered() counted_by frcp6-michigan cite "E.D. Mich. LR 54.1.2(a)"
/// LR 54.1.2(b): within 14 days after the fee motion is filed, the party
/// against whom the award is requested responds with any objections.
deadline fee-motion-response-period: 14.days after FeeMotionFiled() counted_by frcp6-michigan cite "E.D. Mich. LR 54.1.2(b)"
/// LR 54.2(a): an attorney seeking approval of fees under the Equal
/// Access to Justice Act, 28 U.S.C. § 2412(d), files the motion within 30
/// days of final judgment.
deadline eaja-fee-motion-period: 30.days after SocialSecurityFinalJudgment() counted_by frcp6-michigan cite "E.D. Mich. LR 54.2(a)"
/// LR 58.1(c): within seven days after the court grants a judgment or
/// order, or later if the court allows, a person seeking its entry may
/// serve the proposed judgment or order with notice that it will be
/// submitted for signing.
deadline proposed-judgment-notice-period: 7.days after JudgmentOrOrderGranted() counted_by frcp6-michigan cite "E.D. Mich. LR 58.1(c)"
/// LR 58.1(c), (c)(1): written objections to the proposed judgment or
/// order are filed within seven days after service of the notice, or the
/// court signs it if it comports with its decision.
deadline proposed-judgment-objection-period: 7.days after ProposedJudgmentNoticeServed() counted_by frcp6-michigan cite "E.D. Mich. LR 58.1(c)"
/// LR 58.1(c)(3): if objections are filed, the person who proposed the
/// judgment or order notices it for settlement before the court within
/// seven days after receiving notice of the objections.
deadline proposed-judgment-settlement-period: 7.days after ProposedJudgmentObjectionsReceived() counted_by frcp6-michigan cite "E.D. Mich. LR 58.1(c)"
/// LR 72.1(d)(3): a person may respond to objections to a magistrate
/// judge's order or report within 14 days of service of the objections.
deadline magistrate-objection-response-period: 14.days after MagistrateObjectionsServed() counted_by frcp6-michigan cite "E.D. Mich. LR 72.1(d)"
/// LR 72.1(d)(4): a reply brief is filed within 7 days of service of a
/// response.
deadline magistrate-objection-reply-period: 7.days after MagistrateObjectionResponseServed() counted_by frcp6-michigan cite "E.D. Mich. LR 72.1(d)"
/// LR 73.1(c): consent to a magistrate judge's civil consent authority may
/// be entered until 28 days before the scheduled trial unless the
/// district judge orders otherwise.
deadline magistrate-consent-cutoff: 28.days before ScheduledTrial() counted_by frcp6-michigan cite "E.D. Mich. LR 73.1(c)"
/// LR 73.1(e): a party added after reference on consent who chooses to
/// consent files the signed form within 28 days of appearance, or the case
/// returns to the district judge.
deadline added-party-consent-period: 28.days after AddedPartyAppearance() counted_by frcp6-michigan cite "E.D. Mich. LR 73.1(e)"

test "motion response: 14 days after service of the motion" cite "E.D. Mich. LR 7.1(e)"
{
  given MotionServed() on 2026-11-02
  expect deadline(motion-response-period) == 2026-11-16
}

test "enlarged motion response: 21 days after service of the motion" cite "E.D. Mich. LR 7.1(e)"
{
  given EnlargedMotionServed() on 2026-11-02
  expect deadline(enlarged-motion-response-period) == 2026-11-23
}

test "reply: 7 days after service of the response" cite "E.D. Mich. LR 7.1(e)"
{
  given ResponseServed() on 2026-11-02
  expect deadline(motion-reply-period) == 2026-11-09
}

test "enlarged reply: 14 days after service of the response" cite "E.D. Mich. LR 7.1(e)"
{
  given EnlargedResponseServed() on 2026-11-02
  expect deadline(enlarged-motion-reply-period) == 2026-11-16
}

test "reply: at least 3 days before the hearing" cite "E.D. Mich. LR 7.1(e)"
{
  given MotionHearing() on 2026-11-20
  expect deadline(motion-reply-before-hearing) == 2026-11-17
}

test "reconsideration of a non-final order: 14 days after entry" cite "E.D. Mich. LR 7.1(h)"
{
  given NonFinalOrderEntered() on 2026-11-02
  expect deadline(reconsideration-period) == 2026-11-16
}

test "mediation memorandum: 7 calendar days before the session" cite "E.D. Mich. LR 16.4(e)"
{
  given MediationSession() on 2026-11-20
  expect deadline(mediation-memorandum-period) == 2026-11-13
}

test "closing papers: 21 days after settlement" cite "E.D. Mich. LR 16.4(e)"
{
  given MediationSettlement() on 2026-11-02
  expect deadline(mediation-closing-papers-period) == 2026-11-23
}

test "discovery material: 14 days after service of the order" cite "E.D. Mich. LR 26.2(d)"
{
  given DiscoveryFilingOrderServed() on 2026-11-02
  expect deadline(discovery-filing-period) == 2026-11-16
}

test "bill of costs: 28 days after entry of judgment" cite "E.D. Mich. LR 54.1"
{
  given JudgmentEntered() on 2026-11-02
  expect deadline(bill-of-costs-period) == 2026-11-30
}

test "fee motion: 28 days after entry of judgment" cite "E.D. Mich. LR 54.1.2(a)"
{
  given JudgmentEntered() on 2026-11-02
  expect deadline(fee-motion-period) == 2026-11-30
}

test "fee motion response: 14 days after the motion is filed" cite "E.D. Mich. LR 54.1.2(b)"
{
  given FeeMotionFiled() on 2026-11-02
  expect deadline(fee-motion-response-period) == 2026-11-16
}

test "EAJA fee motion: 30 days after final judgment" cite "E.D. Mich. LR 54.2(a)"
{
  given SocialSecurityFinalJudgment() on 2026-11-02
  expect deadline(eaja-fee-motion-period) == 2026-12-02
}

test "proposed judgment notice: 7 days after the grant" cite "E.D. Mich. LR 58.1(c)"
{
  given JudgmentOrOrderGranted() on 2026-11-02
  expect deadline(proposed-judgment-notice-period) == 2026-11-09
}

test "objections to a proposed judgment: 7 days, Veterans Day rolls to Thursday" cite "E.D. Mich. LR 58.1(c)"
{
  given ProposedJudgmentNoticeServed() on 2026-11-04
  expect deadline(proposed-judgment-objection-period) == 2026-11-12
}

test "notice for settlement: 7 days after notice of objections" cite "E.D. Mich. LR 58.1(c)"
{
  given ProposedJudgmentObjectionsReceived() on 2026-11-02
  expect deadline(proposed-judgment-settlement-period) == 2026-11-09
}

test "response to magistrate objections: 14 days after service" cite "E.D. Mich. LR 72.1(d)"
{
  given MagistrateObjectionsServed() on 2026-11-02
  expect deadline(magistrate-objection-response-period) == 2026-11-16
}

test "reply on magistrate objections: 7 days after the response" cite "E.D. Mich. LR 72.1(d)"
{
  given MagistrateObjectionResponseServed() on 2026-11-02
  expect deadline(magistrate-objection-reply-period) == 2026-11-09
}

test "magistrate consent: until 28 days before the scheduled trial" cite "E.D. Mich. LR 73.1(c)"
{
  given ScheduledTrial() on 2026-12-18
  expect deadline(magistrate-consent-cutoff) == 2026-11-20
}

test "added party consent: 28 days after appearance" cite "E.D. Mich. LR 73.1(e)"
{
  given AddedPartyAppearance() on 2026-11-02
  expect deadline(added-party-consent-period) == 2026-11-30
}
