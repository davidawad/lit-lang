// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-pr-state-civil

start commenced

state commenced: "Complaint Filed" by applicant cite ?("Reglas de Procedimiento Civil de 2009, Regla 3.1 (verify)")
{
  note "OUTLINE. A civil action commences with the filing of the complaint. Filing fee and service period are holes."
  edge-commenced-response-due "Defendant served" -> response-due {
    authority cite ?("Reglas de Procedimiento Civil de 2009, Regla 4 (verify)")
  }
}

decision response-due: "Answer or Motion Due" by office cite ?("Reglas de Procedimiento Civil de 2009, Regla 10.1")
{
  note "OUTLINE. The response period is a hole until verified. Leading decision on pleading challenges (verify): No leading decision confirmed in this run; verify before use."
  edge-response-due-default "No response" -> default-entered {
    authority cite ?("Reglas de Procedimiento Civil de 2009, Regla 45 (verify)")
  }
  edge-response-due-motion "Pre-answer motion filed" -> pleading-ruling {
    authority cite ?("Reglas de Procedimiento Civil de 2009, Regla 10.2 (verify)")
  }
  edge-response-due-discovery "Answer filed" -> discovery {
    authority cite ?("Reglas de Procedimiento Civil de 2009, Regla 10.1")
  }
}

decision pleading-ruling: "Pre-answer Motion Decided" by court cite ?("Reglas de Procedimiento Civil de 2009, Regla 10.2 (verify)")
{
  note "OUTLINE. Answer period under Regla 10.1 is a hole until verified; sovereign-defendant periods are a separate hole."
  edge-pleading-ruling-dismissed "Dismissed" -> dismissed {
    authority cite ?("Reglas de Procedimiento Civil de 2009, Regla 10.2 (verify)")
  }
  edge-pleading-ruling-discovery "Motion denied; case proceeds" -> discovery {
    authority cite ?("Reglas de Procedimiento Civil de 2009, Regla 10.1")
  }
}

state discovery: "Discovery" by applicant cite ?("Reglas de Procedimiento Civil de 2009, Regla 23.1 (verify)")
{
  note "OUTLINE. Discovery under the 2009 rules (verify rule numbers). Scope, deadlines and sanctions are holes until verified."
  edge-discovery-sj-ruling "Dispositive motion filed" -> sj-ruling {
    authority cite ?("Reglas de Procedimiento Civil de 2009, Regla 36 (verify)")
  }
  edge-discovery-trial-ready "No dispositive motion" -> trial-ready {
    authority cite ?("Reglas de Procedimiento Civil de 2009, Regla 37 (verify)")
  }
}

decision sj-ruling: "Summary Judgment Decided" by court cite ?("Reglas de Procedimiento Civil de 2009, Regla 36 (verify)")
{
  note "OUTLINE. Leading decision on summary judgment (verify): No leading decision confirmed in this run; verify before use."
  edge-sj-ruling-granted "Granted" -> sj-granted {
    authority cite ?("Reglas de Procedimiento Civil de 2009, Regla 36 (verify)")
  }
  edge-sj-ruling-denied "Denied" -> trial-ready {
    authority cite ?("Reglas de Procedimiento Civil de 2009, Regla 36 (verify)")
  }
}

decision trial-ready: "Pretrial and Trial Setting" by court cite ?("Reglas de Procedimiento Civil de 2009, Regla 37 (verify)")
{
  note "OUTLINE. Pretrial order, jury demand and trial setting. Settlement and dismissal paths are not modeled."
  edge-trial-ready-verdict "Tried" -> verdict {
    authority cite ?("Reglas de Procedimiento Civil de 2009, Regla 39 (verify)")
  }
}

state verdict: "Verdict Returned" by applicant cite ?("Reglas de Procedimiento Civil de 2009, Regla 39 (verify)")
{
  note "OUTLINE. Motions for judgment as a matter of law and for a new trial follow the verdict."
  edge-verdict-post-trial "Post-trial motions" -> post-trial {
    authority cite ?("Reglas de Procedimiento Civil de 2009, Regla 47 (verify)")
  }
}

decision post-trial: "Post-trial Motions Decided" by court cite ?("Reglas de Procedimiento Civil de 2009, Regla 47 (verify)")
{
  note "OUTLINE. Deadlines for renewed motions are holes until verified."
  edge-post-trial-judgment "Judgment entered" -> judgment-entered {
    authority cite ?("Reglas de Procedimiento Civil de 2009, Regla 42.1 (verify)")
  }
}

terminal judgment-entered: "Judgment entered on verdict" outcome [win] cite ?("Reglas de Procedimiento Civil de 2009, Regla 42.1 (verify)")
{
  note "OUTLINE. Notice of appeal runs from entry of judgment; see the state-appellate package for this state."
  payoff ?
}

terminal default-entered: "Default entered" outcome [loss] cite ?("Reglas de Procedimiento Civil de 2009, Regla 45 (verify)")
{
  note "OUTLINE. Default judgment and relief from default are holes until verified."
  payoff ?
}

terminal dismissed: "Dismissed on the pleadings" outcome [loss] cite ?("Reglas de Procedimiento Civil de 2009, Regla 10.2 (verify)")
{
  note "OUTLINE. Leading decision on pleading standard (verify): No leading decision confirmed in this run; verify before use."
  payoff ?
}

terminal sj-granted: "Summary judgment granted" outcome [loss] cite ?("Reglas de Procedimiento Civil de 2009, Regla 36 (verify)")
{
  note "OUTLINE. Leading decision on summary judgment (verify): No leading decision confirmed in this run; verify before use."
  payoff ?
}

