// PTAB <-> Federal Circuit. A party dissatisfied with an inter partes review
// final written decision may appeal (35 U.S.C. §§ 141(c), 319) to the court
// with exclusive jurisdiction of Board appeals (28 U.S.C. § 1295(a)(4)(A));
// the notice is due 63 days after the decision (37 C.F.R. § 90.3(a)(1),
// lit/cafc's `ptab-noa-period`).
//
// The appeal authority stays a cite hole carrying the legacy text: its
// comma (`§§ 141(c), 319`) has no `CiteText` spelling (SPEC §2).
module links.ptab

/// The Federal Circuit as entered from a final written decision. Only
/// `origin-to-ptab` and `remand-route-ptab` survive. No rehearing patch:
/// the appellee is the other party to the review, so lit/cafc's 30-day
/// `rehearing-period` applies unless the Director intervenes (35 U.S.C.
/// § 143), which a matter models, not this instance.
instance cafc@ptab {
  pack cafc
  note "Federal Circuit as entered from a PTAB final written decision (35 U.S.C. §§ 141, 319). Remand can only return to the PTAB."
  remove_edges [origin-to-district-court, origin-to-itc, origin-to-cofc, remand-route-district-court, remand-route-itc, remand-route-cofc, origin-to-ttab, remand-route-ttab]
  probabilities { remand-route-ptab: 1 }
}

/// Replaces the PTAB pack's own abstract notice-of-appeal edge, so the
/// composed graph has one route into the Federal Circuit; either party may
/// take it, at the pack's 0.92 appeal rate.
link ptab-appeal-to-cafc "Appeal the final written decision to the Federal Circuit": ptab-patent-trial-appeal-board::federal-circuit-window -> cafc@ptab::entry-ptab p 0.92 {
  authority cite ?("35 U.S.C. §§ 141(c), 319; 37 C.F.R. § 90.3")
  note "Supersedes the PTAB pack's abstract Federal Circuit region when both packs are loaded; keeps its 0.92 appeal rate."
  tags [appeal]
  replaces ["ptab-patent-trial-appeal-board::federal-circuit-window->federal-circuit-notice-of-appeal#0"]
}

/// On remand the Board issues a new final written decision. The legacy
/// authority is 28 U.S.C. § 2106, whose text speaks of the judgment "of a
/// court"; kept as the pack has it.
link cafc-remand-to-ptab "Remand: Board issues a new final written decision": cafc@ptab::remanded-to-ptab -> ptab-patent-trial-appeal-board::fwd-issued by office p 1 {
  authority cite 28 U.S.C. § 2106
  tags [remand]
}
