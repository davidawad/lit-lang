// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-ar-workers-compensation-commission

import outline-ar-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start filed

state filed: "Claim, petition or appeal filed" by applicant cite ?("Ark. Code Ann. § 11-9-702 (verify)")
{
  note "OUTLINE. An administrative law judge hears the claim; the Full Commission reviews on appeal and the Arkansas Court of Appeals reviews the Commission. Proceedings before the Arkansas Workers' Compensation Commission: filing period, form and fees are holes. Leading decisions: not yet identified in this pass; verify before use."
  edge-filed-hearing "Set for hearing" -> hearing { event ActionCommenced() authority cite ?("Ark. Code Ann. § 11-9-705 (verify)") }
}

state hearing: "Hearing" by court cite ?("Ark. Code Ann. § 11-9-705 (verify)")
{
  note "OUTLINE. Hearing procedure, evidence and the record are holes."
  edge-hearing-decision "Decision issued" -> decision { authority cite ?("Ark. Code Ann. § 11-9-704 (verify)") }
}

chance decision: "Tribunal decides" by court cite ?("Ark. Code Ann. § 11-9-704 (verify)")
{
  note "OUTLINE. Outcome probabilities are holes."
  edge-decision-granted "Relief granted" -> review p ? { event DecisionFiled() }
  edge-decision-denied "Relief denied" -> review p ? { event DecisionFiled() }
}

decision review: "Review or appeal sought?" by applicant cite ?("Ark. Code Ann. § 11-9-711 (verify)")
{
  note "OUTLINE. Review period and the reviewing body are holes."
  edge-review-none "No review" -> final-decision { event JudgmentEntered() authority cite ?("Ark. Code Ann. § 11-9-704 (verify)") }
  edge-review-sought "Review or judicial review sought" -> review-sought { event NoticeOfAppealFiled() authority cite ?("Ark. Code Ann. § 11-9-711 (verify)") }
}

terminal final-decision: "Decision final" outcome [final] cite ?("Ark. Code Ann. § 11-9-704 (verify)")
{
  note "OUTLINE. Enforcement and payment are outside this outline."
  payoff ?
}

terminal review-sought: "Review or judicial review sought" outcome [final] cite ?("Ark. Code Ann. § 11-9-711 (verify)")
{
  note "OUTLINE. The reviewing court is its own package."
  payoff ?
}
