module bankr-alm-local-rules.local-rules

import core.frbp9006.{ frbp9006 }
import frbp.events.{ PetitionFiled }

// The Bankr. M.D. Ala. court's own periods, counted under FRBP 9006(a): the
// Local Rules effective April 1, 2024. The FRBP periods (schedules, claims,
// the chapter 13 plan, discharge, dischargeability, exemptions, the
// adversary answer and summons, appeals) are lit/frbp's and are not
// declared again; LBR 1007-1(a)'s § 522(q) certification runs with the
// discharge motion (LBR 4004-1) or before the chapter 11 plan, not on a
// period of its own.
//
// Stated in the rules but not declared: the business-day periods (the
// ballot tabulation three business days before the confirmation hearing,
// LBR 3018-1(c); a notice of default filed within one business day of
// mailing, LBR 4001-2(c); a certificate of service within three business
// days of the related filing, LBR 9013-3); the clock-time periods (agreed
// continuances and settlement announcements by 12:00 PM the business day
// before the hearing, LBR 5071-1(c), 9019-1(a)); the conditions that are not
// deadlines (180 days' residence for venue, LBR 1014-2(a); a conditional
// denial's default provision expiring within 24 months, LBR 4001-2(a); the
// one-year retention of wet-ink originals after the case closes, LBR
// 1002-1(b), 1007-5(a), 5005-4(i)); and LBR 4002-1(b)(3)'s documents brought
// to the meeting of creditors "within seven (7) days' notice", which states
// no trigger a deadline can run from. The rules state no page limit.
/// The court denies an application to pay the filing fee in installments
/// because the debtor owes an unpaid fee from a prior case (LBR 1006-1(d)).
event InstallmentApplicationDenied()
/// A trustee's or the Bankruptcy Administrator's motion to dismiss under
/// LBR 1017-2 is served (LBR 1017-2(b)).
event DismissalMotionServed()
/// The order excusing a debtor's personal appearance at the meeting of
/// creditors is entered (LBR 2003-1(b)(2)).
event AppearanceExcusedOrder()
/// The notice of a Rule 2004 examination is served (LBR 2004-1(c)).
event ExaminationNoticeServed()
/// The date of a proposed Rule 2004 examination or production (LBR
/// 2004-1(d)-(e)).
event ExaminationDate()
/// An objection to claim or other filing under the negative notice
/// procedure is served (LBR 3007-1(c)(3), 9007-1(c)).
event NegativeNoticeServed()
/// The court enters a "Declaration and Order Due" event on CM/ECF after no
/// response to a negative-notice filing (LBR 3007-1(c)(6), 9007-1(f)).
event DeclarationAndOrderDue()
/// A creditor mails a notice of default under a chapter 13 conditional
/// denial order (LBR 4001-2(c)).
event DefaultNoticeMailed()
/// An order conditionally denying stay relief in a chapter 13 case is
/// entered (LBR 4001-2(f)).
event ConditionalDenialEntered()
/// A trustee, the Bankruptcy Administrator or a party in interest makes a
/// written request for proof of a plan payment (LBR 4002-1(b)(2)).
event PaymentProofRequested()
/// The notice of completion of plan payments in a chapter 12 or 13 case is
/// filed (LBR 4004-1(a)).
event PlanCompletionNoticeFiled()
/// A creditor files a Notice (Local Form 9) demanding proof of insurance on
/// a motor vehicle (LBR 4070-1(a)).
event InsuranceNoticeFiled()
/// The date of a scheduling conference set by order (LBR 7016-1).
event SchedulingConference()
/// A notice of removal is filed (LBR 9027-1(b)).
event RemovalNoticeFiled()
/// The date of a trial or hearing (LBR 9070-1(b)).
event TrialOrHearing()
/// The later of the order or judgment concluding the matter, the order on
/// any post-judgment motion with no appeal pending, or the mandate (LBR
/// 9070-1(e)).
event MatterConcluded()

/// M.D. Ala. LBR 1002-1(b): an attorney for an individual debtor files the
/// signed Local Form 1 declaration regarding electronic filing no later than
/// 14 days following the filing date of the petition.
deadline filing-declaration-period: 14.days after PetitionFiled() counted_by frbp9006 cite "M.D. Ala. LBR 1002-1(b)"

/// M.D. Ala. LBR 1006-1(d): when an installment application is denied
/// because of an unpaid fee from a prior case, the debtor has 14 days from
/// the denial date to pay the filing fee in full, or the case is dismissed.
deadline installment-denial-fee-period: 14.days after InstallmentApplicationDenied() counted_by frbp9006 cite "M.D. Ala. LBR 1006-1(d)"

/// M.D. Ala. LBR 1017-2(b): a case may be dismissed without further notice
/// or hearing when no response to a motion to dismiss served under the rule
/// is filed within 21 days of its service.
deadline dismissal-response-period: 21.days after DismissalMotionServed() counted_by frbp9006 cite "M.D. Ala. LBR 1017-2(b)"

/// M.D. Ala. LBR 2003-1(b)(2): unless otherwise ordered, a debtor excused
/// from appearing at the meeting of creditors files the completed
/// interrogatories no later than 14 days after the order excusing the
/// appearance.
deadline excused-interrogatories-period: 14.days after AppearanceExcusedOrder() counted_by frbp9006 cite "M.D. Ala. LBR 2003-1(b)(2)"

/// M.D. Ala. LBR 2004-1(c): a request for production under the rule may be
/// construed as one under FRBP 7034 with the time to respond shortened to
/// 21 days; attendance and production may not be required less than 21
/// days after service of the notice.
deadline examination-production-period: 21.days after ExaminationNoticeServed() counted_by frbp9006 cite "M.D. Ala. LBR 2004-1(c)"

/// M.D. Ala. LBR 2004-1(d): a party in interest who wishes to attend files
/// and serves a cross-notice of examination at least 14 days in advance of
/// the scheduled examination.
deadline cross-notice-period: 14.days before ExaminationDate() counted_by frbp9006 cite "M.D. Ala. LBR 2004-1(d)"

/// M.D. Ala. LBR 2004-1(e): an interested party may object to the notice
/// of examination or production no later than seven days prior to its
/// date; the examination is stayed until the court rules.
deadline examination-objection-period: 7.days before ExaminationDate() counted_by frbp9006 cite "M.D. Ala. LBR 2004-1(e)"

/// M.D. Ala. LBR 3007-1(c)(3): an objection to claim under negative notice
/// may be ruled upon unless a party in interest files a response within 30
/// days of the date of its service.
deadline claim-objection-response-period: 30.days after NegativeNoticeServed() counted_by frbp9006 cite "M.D. Ala. LBR 3007-1(c)(3)"

/// M.D. Ala. LBR 3007-1(c)(6): absent a response, the objecting party has
/// seven days from the "Declaration and Order Due" event to file the Local
/// Form 5 declaration and submit the order, or the objection is set for
/// hearing.
deadline claim-objection-declaration-period: 7.days after DeclarationAndOrderDue() counted_by frbp9006 cite "M.D. Ala. LBR 3007-1(c)(6)"

/// M.D. Ala. LBR 4001-2(c), (g)-(h): a chapter 13 conditional denial order
/// provides that the creditor mails any notice of default with at least 21
/// days' notice to cure, from the date of mailing.
deadline default-cure-period: 21.days after DefaultNoticeMailed() counted_by frbp9006 cite "M.D. Ala. LBR 4001-2(c)"

/// M.D. Ala. LBR 4001-2(f): an amended or supplemental proof of claim for
/// post-petition arrearage or fees a conditional denial order authorizes is
/// filed within 60 days of the order's entry.
deadline conditional-denial-claim-period: 60.days after ConditionalDenialEntered() counted_by frbp9006 cite "M.D. Ala. LBR 4001-2(f)"

/// M.D. Ala. LBR 4001-3: a motion to extend the automatic stay under 11
/// U.S.C. § 362(c)(3) is filed and served within seven days of the filing
/// of the petition.
deadline stay-extension-motion-period: 7.days after PetitionFiled() counted_by frbp9006 cite "M.D. Ala. LBR 4001-3"

/// M.D. Ala. LBR 4002-1(b)(2): without formal discovery, a debtor produces
/// proof of a plan payment within 14 days of a written request.
deadline payment-proof-period: 14.days after PaymentProofRequested() counted_by frbp9006 cite "M.D. Ala. LBR 4002-1(b)(2)"

/// M.D. Ala. LBR 4004-1(a): within 30 days of the filing of the notice of
/// completion of plan payments in a chapter 12 or 13 case, the debtor files
/// the motion and certification for entry of a discharge.
deadline discharge-motion-period: 30.days after PlanCompletionNoticeFiled() counted_by frbp9006 cite "M.D. Ala. LBR 4004-1(a)"

/// M.D. Ala. LBR 4070-1(a), (c): if the creditor does not receive proof of
/// insurance within 14 days of the filing of its Notice, it may submit an
/// order lifting the stay as to the collateral.
deadline insurance-proof-period: 14.days after InsuranceNoticeFiled() counted_by frbp9006 cite "M.D. Ala. LBR 4070-1(c)"

/// M.D. Ala. LBR 4070-1(d): a debtor who objects to the creditor's order has
/// seven days from the filing of the Notice to file a detailed objection.
deadline insurance-objection-period: 7.days after InsuranceNoticeFiled() counted_by frbp9006 cite "M.D. Ala. LBR 4070-1(d)"

/// M.D. Ala. LBR 7016-1: no later than seven days prior to a scheduling
/// conference set by order, counsel confer on the FRCP 26(f) matters.
deadline scheduling-conference-period: 7.days before SchedulingConference() counted_by frbp9006 cite "M.D. Ala. LBR 7016-1"

/// M.D. Ala. LBR 9007-1(c): a filing under the negative notice procedure may
/// be granted unless a party in interest files a response within 21 days of
/// the date of service.
deadline negative-notice-response-period: 21.days after NegativeNoticeServed() counted_by frbp9006 cite "M.D. Ala. LBR 9007-1(c)"

/// M.D. Ala. LBR 9007-1(f): for a filing on the court's List for LBR
/// 9007-1(f), absent a response the moving party has seven days from the
/// "Declaration and Order Due" event to file the declaration and submit an
/// order, or the matter is set for hearing.
deadline negative-notice-declaration-period: 7.days after DeclarationAndOrderDue() counted_by frbp9006 cite "M.D. Ala. LBR 9007-1(f)"

/// M.D. Ala. LBR 9027-1(b): within 14 days of filing the notice of removal,
/// the removing party files proof that it filed a copy with the clerk of the
/// court from which the claim was removed.
deadline removal-proof-period: 14.days after RemovalNoticeFiled() counted_by frbp9006 cite "M.D. Ala. LBR 9027-1(b)"

/// M.D. Ala. LBR 9070-1(b): except impeachment evidence, exhibits are
/// submitted to the court and made available to opposing parties
/// electronically no later than seven days prior to the trial or hearing.
deadline exhibits-period: 7.days before TrialOrHearing() counted_by frbp9006 cite "M.D. Ala. LBR 9070-1(b)"

/// M.D. Ala. LBR 9070-1(e): the clerk may dispose of unclaimed paper
/// exhibits unless a party notifies the clerk that it intends to reclaim
/// them within 30 days after the matter concludes.
deadline exhibit-reclaim-period: 30.days after MatterConcluded() counted_by frbp9006 cite "M.D. Ala. LBR 9070-1(e)"

start filing-served

state filing-served: "Filing served under the negative notice procedure" by applicant cite "M.D. Ala. LBR 9007-1(b)"
{
  note "A filing on the court's Negative Notice List carries the LBR 9007-1(c) legend and may be granted unless a party in interest files a response within 21 days of service (30 days for an objection to claim, LBR 3007-1(c)(3)); the court may set any such filing for hearing sua sponte."
  edge-filing-served-response "Response filed" -> responded {
    authority cite "M.D. Ala. LBR 9007-1(c)"
  }
  edge-filing-served-unopposed "No response; declaration and order due" -> declaration-due {
    authority cite "M.D. Ala. LBR 9007-1(f)"
  }
}

state responded: "Response filed; matter set for hearing" by opponent cite "M.D. Ala. LBR 9007-1(d)"
{
  note "Once a response is filed, amendments to the filing omit the negative notice legend (LBR 9007-1(d)) and the matter is heard."
  edge-responded-hearing "Hearing held" -> ruling { authority cite "M.D. Ala. LBR 9007-1(b)" }
}

state declaration-due: "Declaration in support of entry of order due" by applicant cite "M.D. Ala. LBR 9007-1(f)"
{
  note "The moving party files the Local Form 5 declaration and submits an order within seven days of the \"Declaration and Order Due\" event (LBR 9007-1(f), 9072-1(e)(3)); otherwise the matter is set for hearing."
  edge-declaration-due-filed "Declaration filed and order submitted" -> ruling {
    authority cite "M.D. Ala. LBR 9072-1(e)"
  }
  edge-declaration-due-missed "Declaration not timely filed; set for hearing" -> ruling {
    authority cite "M.D. Ala. LBR 9007-1(f)"
  }
}

decision ruling: "Filing decided" by court cite "M.D. Ala. LBR 9007-1(b)"
{
  note "The court grants or approves the filing without further notice or hearing, or decides it after a hearing."
  edge-ruling-granted "Granted" -> decided { authority cite "M.D. Ala. LBR 9007-1(b)" }
  edge-ruling-denied "Denied" -> decided { authority cite "M.D. Ala. LBR 9007-1(g)" }
}

terminal decided: "Matter decided: the case continues under lit/frbp" outcome [procedural] cite "M.D. Ala. LBR 9011-2(a)"
{
  note "Parties comply with the federal statutes, the Federal Rules of Bankruptcy Procedure and the Local Rules (LBR 9011-2(a)), which are not construed inconsistently with the FRBP (preamble)."
}
