// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
// Sources: Tax Court Rules (ustaxcourt.gov/rules, individual rule PDFs fetched 2026-10-26);
// 26 U.S.C. headings (LII, fetched 2026-10-26). Key decisions are unverified.
module outline-tax-court

start notice-of-deficiency

state notice-of-deficiency: "Notice of deficiency mailed" by office cite ?("26 U.S.C. § 6212; 26 U.S.C. § 6213(a)")
{
  note "OUTLINE. The notice of deficiency starts the petition window under 26 U.S.C. § 6213(a). The window is 90 days, or 150 days if the notice is addressed to a person outside the United States (verify both periods against § 6213(a) text). Key decision (verify): Boechler, P.C. v. Commissioner, 596 U.S. 199 (2022) (analogous § 6330 deadline is non-jurisdictional, cited for the timing rule)."
  edge-notice-of-deficiency-petition "Petitioner files petition" -> petition-window {
    authority cite ?("26 U.S.C. § 6213(a)")
  }
}

decision petition-window: "Petition filed within the § 6213(a) period" by applicant cite ?("26 U.S.C. § 6213(a)")
{
  note "OUTLINE. A petition filed after the period is outside the Court's jurisdiction for a deficiency case. The filing mechanics and the fee are holes. Confirm the timing and the fee against T.C. R. 20 and 22."
  edge-petition-window-timely "Timely" -> petition-track {
    authority cite ?("26 U.S.C. § 6213(a)")
  }
  edge-petition-window-late "Late" -> dismissed-jurisdiction {
    authority cite ?("26 U.S.C. § 6213(a)")
  }
}

decision petition-track: "Small tax case election or regular case" by applicant cite ?("26 U.S.C. § 7463(a); T.C. R. 20")
{
  note "OUTLINE. Small tax cases (amount in dispute at or below the § 7463 threshold, with an election) use the simplified track, and the decision is not appealable under § 7463(b). Confirm the threshold and the election mechanics. Regular cases follow the full rules."
  edge-petition-track-small "Small tax case election" -> small-case-decision {
    authority cite ?("26 U.S.C. § 7463(a)")
  }
  edge-petition-track-regular "Regular case" -> answer-due {
    authority cite ?("T.C. R. 20")
  }
}

decision answer-due: "Commissioner answer or motion" by office cite ?("T.C. R. 36(a)")
{
  note "OUTLINE. The Commissioner answers or moves within the period in T.C. R. 36(a). The periods are holes. Confirm the answer and the motion periods in Rule 36(a)."
  edge-answer-due-answer "Answer filed" -> reply-or-pleadings-closed {
    authority cite ?("T.C. R. 36")
  }
  edge-answer-due-motion "Motion to dismiss" -> motion-to-dismiss-ruling {
    authority cite ?("T.C. R. 36")
  }
}

decision motion-to-dismiss-ruling: "Ruling on motion to dismiss" by court cite ?("T.C. R. 36; 26 U.S.C. § 6213(a)")
{
  note "OUTLINE. A motion to dismiss for lack of jurisdiction or for failure to state a claim. The standard is a hole. Key decision: none named until the dismissal standard is verified."
  edge-motion-to-dismiss-granted "Granted" -> dismissed-jurisdiction {
    authority cite ?("T.C. R. 36")
  }
  edge-motion-to-dismiss-denied "Denied" -> reply-or-pleadings-closed {
    authority cite ?("T.C. R. 36")
  }
}

state reply-or-pleadings-closed: "Reply, if any; pleadings closed" by applicant cite ?("T.C. R. 37")
{
  note "OUTLINE. A reply is required only where the answer contains affirmative allegations (T.C. R. 37). The period is a hole."
  edge-pleadings-closed-discovery "Pleadings closed" -> discovery {
    authority cite ?("T.C. R. 37")
  }
}

state discovery: "Discovery (depositions, interrogatories, document requests)" by applicant cite ?("T.C. R. 70; T.C. R. 74")
{
  note "OUTLINE. General discovery under T.C. R. 70 and depositions for discovery under T.C. R. 74. Limits and deadlines are holes. Stipulations of fact and settlement discussions run in parallel and are not modeled."
  edge-discovery-pretrial "Discovery complete" -> pretrial-disposition {
    authority cite ?("T.C. R. 70")
  }
}

decision pretrial-disposition: "Summary judgment, trial calendar or settlement" by court cite ?("T.C. R. 121; T.C. R. 131")
{
  note "OUTLINE. Summary judgment under T.C. R. 121 may be filed after the period in Rule 121(b)(1) and no later than 60 days before the first day of the session calendaring the case (verify the period text). Key decision (verify): Sundstrand Corp. v. Commissioner, 96 T.C. 226 (1991) (summary judgment standard, cited in the Court's practice)."
  edge-pretrial-summary-judgment "Summary judgment motion" -> summary-judgment {
    authority cite ?("T.C. R. 121")
  }
  edge-pretrial-trial "Case calendared for trial" -> trial {
    authority cite ?("T.C. R. 131")
  }
  edge-pretrial-settled "Settled" -> settled {
    authority cite ?("T.C. R. 131")
  }
}

decision summary-judgment: "Summary judgment ruling" by court cite ?("T.C. R. 121(a)(2)")
{
  note "OUTLINE. The Court grants summary judgment if there is no genuine dispute as to any material fact and the movant is entitled to judgment as a matter of law (T.C. R. 121(a)(2))."
  edge-summary-judgment-granted "Granted in full" -> decision-entered {
    authority cite ?("T.C. R. 121(a)(2)")
  }
  edge-summary-judgment-denied "Denied in whole or part" -> trial {
    authority cite ?("T.C. R. 121(a)(2)")
  }
}

state trial: "Trial on the calendar" by court cite ?("T.C. R. 131")
{
  note "OUTLINE. Trial in the calendared city under T.C. R. 131. The burden of proof and the standard are holes."
  edge-trial-opinion "Trial complete" -> opinion {
    authority cite ?("T.C. R. 131")
  }
}

state opinion: "Findings and opinion; decision computed" by court cite ?("26 U.S.C. § 7459(a); T.C. R. 155")
{
  note "OUTLINE. Findings and opinion under 26 U.S.C. § 7459. The parties compute the decision under T.C. R. 155. Computation and any dispute are holes."
  edge-opinion-decision "Decision computed and entered" -> decision-entered {
    authority cite ?("T.C. R. 155")
  }
  edge-opinion-reconsideration "Post-opinion motion" -> reconsideration-ruling {
    authority cite ?("T.C. R. 161; T.C. R. 162")
  }
}

decision reconsideration-ruling: "Motion for reconsideration or to vacate or revise" by court cite ?("T.C. R. 161; T.C. R. 162")
{
  note "OUTLINE. Motions for reconsideration of findings or opinion (T.C. R. 161) and to vacate or revise a decision (T.C. R. 162). The periods are holes."
  edge-reconsideration-ruling-revised "Granted; opinion revised" -> opinion {
    authority cite ?("T.C. R. 161")
  }
  edge-reconsideration-ruling-denied "Denied" -> decision-entered {
    authority cite ?("T.C. R. 161")
  }
}

state decision-entered: "Decision entered" by court cite ?("26 U.S.C. § 7481(a)")
{
  note "OUTLINE. The decision becomes final under 26 U.S.C. § 7481(a) absent a timely appeal. Verify the finality period in § 7481(a)."
  edge-decision-entered-appeal "Party appeals" -> decision-appeal-decision {
    authority cite ?("26 U.S.C. § 7483")
  }
  edge-decision-entered-final "No appeal" -> decision-final {
    authority cite ?("26 U.S.C. § 7481(a)")
  }
}

decision decision-appeal-decision: "Notice of appeal filed in time" by applicant cite ?("26 U.S.C. § 7483; T.C. R. 190(a)")
{
  note "OUTLINE. Notice of appeal with the filing fee within 90 days after entry (T.C. R. 190(a); 26 U.S.C. § 7483). A cross-appeal may be filed within 120 days after the decision is entered. The record is prepared under T.C. R. 191 and the bond rules are in T.C. R. 192. Venue is in 26 U.S.C. § 7482(b)."
  edge-decision-appeal-noa "Notice of appeal filed" -> record-on-appeal {
    authority cite ?("T.C. R. 190(a)")
  }
  edge-decision-appeal-none "Notice not filed in time" -> decision-final {
    authority cite ?("T.C. R. 190(a)")
  }
}

state record-on-appeal: "Record on appeal prepared; bond to stay assessment" by applicant cite ?("T.C. R. 191; T.C. R. 192")
{
  note "OUTLINE. Preparation of the record under T.C. R. 191 and a bond to stay assessment and collection under T.C. R. 192. The bond amount is a hole."
  edge-record-on-appeal-cafc "Record transmitted" -> court-of-appeals-review {
    authority cite ?("26 U.S.C. § 7482(a)")
  }
}

state court-of-appeals-review: "Review by the court of appeals" by court cite ?("26 U.S.C. § 7482(a)")
{
  note "OUTLINE. Review by the court of appeals designated under 26 U.S.C. § 7482. The circuit's own packages cover the appeal."
  edge-court-of-appeals-decided "Court of appeals decides" -> appeal-decided {
    authority cite ?("26 U.S.C. § 7482(a)")
  }
}

terminal dismissed-jurisdiction: "Dismissed for lack of jurisdiction (untimely petition or motion granted)" outcome [loss] cite ?("26 U.S.C. § 6213(a)")
{
  note "OUTLINE. Dismissal of a deficiency case for an untimely petition or on a jurisdictional motion."
  payoff ?
}

terminal small-case-decision: "Small tax case decision (no appeal)" outcome [decided] cite ?("26 U.S.C. § 7463(b)")
{
  note "OUTLINE. A decision in a small tax case under § 7463 is not reviewable on appeal. Verify § 7463(b) before relying on it."
  payoff ?
}

terminal settled: "Settled or stipulated decision" outcome [settle] cite ?("T.C. R. 131")
{
  note "OUTLINE. Settlement and a stipulated decision. The decision entry and computation are holes."
  payoff ?
}

terminal decision-final: "Decision final" outcome [decided] cite ?("26 U.S.C. § 7481(a)")
{
  note "OUTLINE. The decision is final. Refund and assessment follow the decision (outside this outline)."
  payoff ?
}

terminal appeal-decided: "Court of appeals decision" outcome [decided] cite ?("26 U.S.C. § 7482(a)")
{
  note "OUTLINE. The court of appeals outcome; see the circuit packages."
  payoff ?
}
