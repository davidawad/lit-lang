// The Appellate Mediation Program (Appellate Mediation Program Guidelines,
// effective December 6, 2013, vendored as
// sources/fedcir-mediation-guidelines.txt). Selection is the Office of
// General Counsel's discretion and no selection or settlement rate is
// published, so the screening draw carries the pack's teaching estimate.
module cafc.mediation

import cafc.motions.{ motions-fork }
import cafc.{ mediation-group }

/// A tribunal-discretion draw (Guidelines § 3: OGC "determine[s] whether a
/// case is a good mediation candidate"). It stays a `decision` by `office`,
/// as in the pack: a `chance` node lowers to kind `state`, which would break
/// semantic equality with the pack. Fed. Cir. R. 33(b) makes the
/// guidelines binding on the parties; the rule is not cited, since the
/// vendored amendment history records no Fed. Cir. R. 33 version.
chance mediation-screening: "OGC Screens for the Mediation Program" by office discretion cite "Appellate Mediation Program Guidelines §§ 2-3"
{
  group mediation-group
  note "Participation is mandatory for cases the Office of General Counsel selects; OGC contacts principal counsel, reviews the docketing statement and briefs, and determines whether a case is a good mediation candidate. If counsel represents to OGC that mediation would not be fruitful, efforts cease. No published selection rate exists: the 0.15 / 0.85 split is the pack's teaching estimate, unsourced, for `litigate calibration` to rank."
  screening-to-conference "Case selected — mediation is mandatory for the parties" -> mediation-conference p 0.15 {
    authority cite "Appellate Mediation Program Guidelines § 3"
    note "No published selection rate; teaching estimate, unsourced."
  }
  screening-to-motions "Case not selected for mediation, or counsel represents mediation would not be fruitful" -> motions-fork p 0.85 {
    authority cite "Appellate Mediation Program Guidelines § 3"
    note "No published selection rate; teaching estimate, unsourced."
  }
}

state mediation-conference: "Mediation Conference Held" cite "Appellate Mediation Program Guidelines §§ 1, 4-6"
{
  group mediation-group
  note "Confidential, risk-free settlement discussion before a volunteer mediator, outside mediator, or magistrate judge. Mediation committee members do not discuss the substance with the deciding judges."
  conference-to-outcome "Mediation concludes" -> mediation-outcome {
    authority cite "Appellate Mediation Program Guidelines § 8"
  }
}

decision mediation-outcome: "Mediation Concludes" cite "Appellate Mediation Program Guidelines § 8"
{
  group mediation-group
  note "No published settlement rate for the program — probability deliberately left unauthored on both outgoing edges rather than invented."
  outcome-to-settled "Parties reach a settlement" -> settled-in-mediation {
    authority cite "Appellate Mediation Program Guidelines § 8"
    note "No published settlement rate; probability intentionally unauthored."
    tags [settlement]
  }
  outcome-to-unsuccessful "Mediation does not produce a settlement" -> mediation-unsuccessful {
    authority cite "Appellate Mediation Program Guidelines § 8"
    note "No published settlement rate; probability intentionally unauthored."
  }
}

terminal settled-in-mediation: "Case Settled Through Mediation" outcome [settlement] {
  group mediation-group
  note "Illustrative payoff only (per the $1,000,000-stake authoring convention): mediated settlements plausibly land well above 0 (affirmance) and below the full-reversal value, but no published average settlement value exists for this program. UNVERIFIED dollar figure."
  valence good
  tags [settlement]
  payoff 350_000.usd
}

state mediation-unsuccessful: "Mediation Unsuccessful — Appeal Proceeds" by office cite "Appellate Mediation Program Guidelines § 8"
{
  group mediation-group
  unsuccessful-to-motions "Appeal proceeds" -> motions-fork {
    authority cite "Appellate Mediation Program Guidelines § 8"
  }
}
