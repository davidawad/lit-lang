// Imported by `litigate import` from packs/ttab-trademark-trial-and-appeal-board.json.
module ttab.opposition-to-trial

import ttab.decision.{ final-decision }

import ttab.terminals.{
  judgment-2135,
  opposition-sustained,
  rebrand-orderly,
  registration-restricted,
  settle-coexistence,
  settle-rebrand-transition,
}

import ttab.{
  AnswerFiled,
  InstitutionNoticed,
  answer-period,
  disclosure-period,
  discovery,
  discovery-period,
  opposition,
  trial,
}

state opposition-filed: "Notice of opposition filed (commenced)" by board cite "37 CFR 2.101(a); 37 CFR 2.105"
{
  group opposition
  note "From here, abandonment without the opposer's written consent = judgment against the applicant (37 CFR 2.135). Opposers can add grounds (e.g. void ab initio for wrong applicant / no bona fide intent) after discovery."
  tags [commenced]
  _ "Board issues notice of institution (answer clock starts)" -> instituted {
    authority cite "37 CFR 2.105(a)"
    event InstitutionNoticed()
    effort 4.hours
    duration { min 7.days, mode 21.days, max 45.days }
    note "Teaching estimate. 4 h review of the complaint and institution order."
  }
}

decision instituted: "Board institutes; answer due on the date the notice of institution designates" by applicant cite ?("37 CFR 2.105(a); 2.106(a); TBMP 310.03(a)") {
  group opposition
  answer-plain "File answer (denials, crowded-field amplification), no counterclaim" -> answered {
    authority cite "37 CFR 2.106(b)(1)-(2)"
    effort 8.hours
    event AnswerFiled(Plain)
    within answer-period {
      extendable true
      extension_authority "37 CFR 2.127(a); consented motion TBMP 509"
    }
    note "Answer due on the date the notice of institution designates, no less than 30 days from its mailing (37 CFR 2.105(a)), or as the Board resets it (2.106(a))."
    tags [answer-plain]
  }
  answer-s18 "File answer WITH Section 18 restriction counterclaim against the opposer's pleaded registration ($600/class)" -> answered {
    authority cite ?("37 CFR 2.106(b)(3); 2.133(d); 15 USC 1068; 37 CFR 2.6(a)(16)(ii); TBMP 313.02, 309.03(d)")
    effort 33.hours
    cost 600.usd
    event AnswerFiled(WithCounterclaim)
    within answer-period { extendable true, extension_authority "37 CFR 2.127(a)" }
    note "Counterclaim to restrict the opposer's pleaded registration (Section 18, 15 USC 1068; 37 CFR 2.133(d)); compulsory if grounds are known at answer (2.106(b)(3)(i)). $600 per class (2.6(a)(16)(ii)). Hours: 8 answer + 25 counterclaim (teaching estimate)."
    tags [answer-s18]
    attrs { opp_hours: 18 }
    sets [s18]
  }
  _ "File no answer (waiver trap)" -> notice-of-default {
    authority cite "37 CFR 2.106(a)"
    within answer-period
    valence bad
    tags [waiver-trap]
  }
  _ "Abandon application without opposer's consent (judgment)" -> judgment-2135 {
    authority cite ?("37 CFR 2.135; TBMP 602.01")
    effort 1.hours
    valence bad
    tags [abandon-no-consent]
    attrs { opp_hours: 1 }
  }
  _ "Suspend for settlement negotiations (stipulated, up to 6 months)" -> talks-instituted {
    authority cite ?("37 CFR 2.117(c); TBMP 605.02")
    effort 15.hours
    duration { min 45.days, mode 90.days, max 180.days }
    tags [suspend-settle]
    attrs { opp_hours: 12 }
    sets [talked]
    forbids [talked]
  }
}

chance notice-of-default: "Notice of default for no answer: applicant must show good cause" discretion by board cite "37 CFR 2.106(a); FRCP 55(c) via 37 CFR 2.116(a)"
{
  group opposition
  _ "Default set aside for good cause; answer filed" -> answered p 0.7 {
    authority cite ?("FRCP 55(c) via 37 CFR 2.116(a); TBMP 312")
    effort 12.hours
    note "Teaching estimate. Board applies liberal good-cause standard for setting aside default; first-time pro-se-adjacent applicant, short delay. No data point in the KB; treat as an assumption."
  }
  _ "Judgment by default" -> opposition-sustained p 0.3 {
    authority cite "37 CFR 2.106(a)"
    note "Teaching estimate. Complement."
  }
}

decision answered: "Answer on file; exits and next stage" by applicant cite ?("37 CFR 2.106(b); TBMP 311") {
  group opposition
  _ "Abandon application without opposer's consent (judgment, 37 CFR 2.135)" -> judgment-2135 {
    authority cite ?("37 CFR 2.135; TBMP 602.01")
    effort 1.hours
    valence bad
    tags [abandon-no-consent]
    attrs { opp_hours: 1 }
  }
  _ "Seek opposer's written consent to abandonment" -> opposer-consent-decision {
    authority cite ?("37 CFR 2.135; TBMP 602.01")
    effort 3.hours
    tags [abandon-with-consent]
    attrs { opp_hours: 2 }
  }
  _ "Suspend for settlement negotiations" -> talks-answered {
    authority cite ?("37 CFR 2.117(c); TBMP 605.02")
    effort 15.hours
    duration { min 45.days, mode 90.days, max 180.days }
    tags [suspend-settle]
    attrs { opp_hours: 12 }
    sets [talked]
    forbids [talked]
  }
  _ "Proceed to discovery conference (30 days after answer due)" -> discovery-conference {
    authority cite ?("37 CFR 2.120(a)(2)(i); TBMP 401.01")
    effort 5.hours
    duration { min 30.days, mode 30.days, max 45.days }
    tags [continue]
    attrs { opp_hours: 6 }
  }
}

chance talks-instituted: "Suspended for settlement after institution" by board cite ?("37 CFR 2.117(c); TBMP 605.02") {
  group opposition
  tags [negotiation]
  _ "Settlement: rebrand on transition period, cost contribution" -> settle-rebrand-transition p 0.3 {
    authority cite ?("TBMP 605.03")
    note "Teaching estimate (generic prior; a matter scenario overrides it via scenario.probabilities / probability_fn / observe). No docket statistic is claimed."
    tags [deal, inproc]
  }
  _ "Settlement: coexistence agreement" -> settle-coexistence p 0.25 {
    authority cite ?("TBMP 605.03")
    note "Teaching estimate (generic prior; a matter scenario overrides it via scenario.probabilities / probability_fn / observe). No docket statistic is claimed."
    tags [deal, inproc]
  }
  _ "Settlement: consent with narrowed ID (2.133(a) approval)" -> registration-restricted p 0.1 {
    authority cite "37 CFR 2.133(a)"
    note "Teaching estimate (generic prior; a matter scenario overrides it via scenario.probabilities / probability_fn / observe). No docket statistic is claimed."
    tags [deal, inproc]
  }
  _ "Talks fail; proceedings resume" -> answered p 0.35 {
    authority cite ?("TBMP 605.02")
    note "Teaching estimate (generic prior; a matter scenario overrides it via scenario.probabilities / probability_fn / observe). No docket statistic is claimed."
    tags [no-deal, inproc]
  }
}

decision opposer-consent-decision: "Opposer decides whether to consent to abandonment" by opposer cite "37 CFR 2.135"
{
  group opposition
  note "Consent is the opposer's to give. Refusing yields a judgment against the applicant (issue-preclusion value for a later infringement suit, B&B Hardware v. Hargis, 575 U.S. 138 (2015)), so the opposer will not consent for free."
  tags [opponent-decision]
  _ "Opposer consents (no judgment)" -> rebrand-orderly {
    authority cite "37 CFR 2.135"
    tags [consent]
  }
  _ "Opposer withholds consent; judgment entered" -> judgment-2135 {
    authority cite "37 CFR 2.135"
    tags [no-consent]
  }
}

chance talks-answered: "Suspended for settlement after answer" by board cite ?("37 CFR 2.117(c); TBMP 605.02") {
  group opposition
  tags [negotiation]
  _ "Settlement: rebrand on transition period, cost contribution" -> settle-rebrand-transition p 0.3 {
    authority cite ?("TBMP 605.03")
    note "Teaching estimate (generic prior; a matter scenario overrides it via scenario.probabilities / probability_fn / observe). No docket statistic is claimed."
    tags [deal, inproc]
  }
  _ "Settlement: coexistence agreement" -> settle-coexistence p 0.25 {
    authority cite ?("TBMP 605.03")
    note "Teaching estimate (generic prior; a matter scenario overrides it via scenario.probabilities / probability_fn / observe). No docket statistic is claimed."
    tags [deal, inproc]
  }
  _ "Settlement: consent with narrowed ID (2.133(a) approval)" -> registration-restricted p 0.1 {
    authority cite "37 CFR 2.133(a)"
    note "Teaching estimate (generic prior; a matter scenario overrides it via scenario.probabilities / probability_fn / observe). No docket statistic is claimed."
    tags [deal, inproc]
  }
  _ "Talks fail; proceedings resume" -> discovery-conference p 0.35 {
    authority cite ?("TBMP 605.02")
    note "Teaching estimate (generic prior; a matter scenario overrides it via scenario.probabilities / probability_fn / observe). No docket statistic is claimed."
    tags [no-deal, inproc]
  }
}

state discovery-conference: "Discovery conference held (Board attorney on request)" by applicant cite "37 CFR 2.120(a)(2)(i); FRCP 26(f)"
{
  group discovery
  _ "Serve initial disclosures" -> initial-disclosures {
    authority cite "37 CFR 2.120(a)(2)(ii)"
    effort 8.hours
    within disclosure-period { extendable true, extension_authority "37 CFR 2.120(a)(2)(iv)" }
    duration { min 30.days, mode 30.days, max 45.days }
    attrs { opp_hours: 8 }
  }
}

state initial-disclosures: "Initial disclosures served (30 days after discovery opens)" by board cite ?("37 CFR 2.120(a)(2)(ii); TBMP 401.02") {
  group discovery
  _ "Discovery period opens" -> discovery-open {
    authority cite "37 CFR 2.120(a)(2)(i)"
    duration { min 0.days, mode 0.days, max 1.days }
  }
}

decision discovery-open: "Discovery open (180 days)" by applicant cite "37 CFR 2.120(a)(2)(i)"
{
  group discovery
  _ "Abandon application without opposer's consent (judgment, 37 CFR 2.135)" -> judgment-2135 {
    authority cite ?("37 CFR 2.135; TBMP 602.01")
    effort 1.hours
    valence bad
    tags [abandon-no-consent]
    attrs { opp_hours: 1 }
  }
  _ "Seek opposer's written consent to abandonment" -> opposer-consent-decision {
    authority cite ?("37 CFR 2.135; TBMP 602.01")
    effort 3.hours
    tags [abandon-with-consent]
    attrs { opp_hours: 2 }
  }
  _ "Suspend for settlement negotiations" -> talks-discovery {
    authority cite ?("37 CFR 2.117(c); TBMP 605.02")
    effort 15.hours
    duration { min 45.days, mode 90.days, max 180.days }
    tags [suspend-settle]
    attrs { opp_hours: 12 }
    sets [talked]
    forbids [talked]
  }
  _ "Conduct discovery (written discovery, depositions, protective order)" -> discovery-closed {
    authority cite "37 CFR 2.120(a)(2)(i); 2.120(a)(3)"
    effort 35.hours
    within discovery-period { extendable true, extension_authority "37 CFR 2.120(a)(2)(iv)" }
    duration { min 180.days, mode 180.days, max 270.days }
    tags [continue]
    attrs { opp_hours: 40 }
  }
}

decision discovery-closed: "Discovery closed; ACR/trial/settlement decision" by applicant cite ?("37 CFR 2.121(a); TBMP 702.04") {
  group discovery
  _ "Abandon application without opposer's consent (judgment, 37 CFR 2.135)" -> judgment-2135 {
    authority cite ?("37 CFR 2.135; TBMP 602.01")
    effort 1.hours
    valence bad
    tags [abandon-no-consent]
    attrs { opp_hours: 1 }
  }
  _ "Seek opposer's written consent to abandonment" -> opposer-consent-decision {
    authority cite ?("37 CFR 2.135; TBMP 602.01")
    effort 3.hours
    tags [abandon-with-consent]
    attrs { opp_hours: 2 }
  }
  _ "Suspend for settlement negotiations" -> talks-trial {
    authority cite ?("37 CFR 2.117(c); TBMP 605.02")
    effort 15.hours
    duration { min 45.days, mode 90.days, max 180.days }
    tags [suspend-settle]
    attrs { opp_hours: 12 }
    sets [talked]
    forbids [talked]
  }
  _ "Propose ACR (stipulate to record and expedited decision)" -> acr-record {
    authority cite ?("TBMP 702.04; 37 CFR 2.120(a)(2)(iv)")
    effort 40.hours
    duration { min 90.days, mode 150.days, max 240.days }
    note "Teaching estimate. ACR assumed to cost ~55% of full trial + briefs (hours 40 vs 65 for trial 30 + briefs 30 + prep). Evidence: ACR notice and FAQ in the KB describe stipulated records; no cost data there."
    tags [acr]
    attrs { opp_hours: 45 }
  }
  _ "Proceed to trial" -> trial-periods {
    authority cite "37 CFR 2.121"
    duration { min 45.days, mode 45.days, max 60.days }
    tags [continue]
  }
}

