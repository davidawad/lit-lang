        "fact"
      ]
    },
    {
      "id": "respond",
      "kind": "decision",
      "label": "Answer or move under Rule 12",
      "cite": "FRCP 12(a)(1)(A)(i)",
      "group": "pleadings"
    },
    {
      "id": "mtd-ruling",
      "kind": "state",
      "label": "Ruling on the motion to dismiss",
      "cite": "FRCP 12(b)(6)",
      "group": "motions"
    },
    {
      "id": "answered",
      "kind": "state",
      "label": "Answer filed",
      "group": "pleadings"
    },
    {
      "id": "default-risk",
      "kind": "state",
      "label": "Failure to respond",
      "group": "outcomes"
    },
    {
      "id": "judgment-entered",
      "kind": "terminal",
      "label": "Judgment entered",
      "group": "outcomes",
      "outcome": [
        "judgment",
        "loss"
      ]
    },
    {
      "id": "dismissed",
      "kind": "terminal",
      "label": "Action dismissed",
      "group": "outcomes",
      "payoff": 0.0,
      "outcome": [
        "judgment",
        "win"
      ]
    }
