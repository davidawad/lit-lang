  }
}

/// imported
terminal complaint-dismissed-no-pc: "Complaint Dismissed — No Probable Cause" outcome [win, dismissal] effective [2009-12-01, ..) known_at 2009-03-26 cite "Fed. R. Crim. P. 5.1(f)"
{
  group charging-group
  note "Magistrate finds no probable cause; defendant discharged on this complaint. Not a double jeopardy bar — jeopardy has not attached, so the government routinely re-prosecutes via grand jury indictment on the same conduct. PLACEHOLDER PAYOFF: $800,000, override per matter. Slightly discounted from a full win because, per this terminal's own note, the government 'routinely re-prosecutes via grand jury indictment' on the same conduct."
  valence good
  payoff 800_000.usd
}

