module bankr-can-local-rules.local-rules

import core.frbp9006.{ frbp9006 }
import frbp.events.{ FirstMeetingDate }

// The Bankr. N.D. Cal. court's own periods, counted under FRBP 9006(a).
// The FRBP periods (schedules and their extension, the chapter 13 plan,
// claims in chapter 7, 12 and 13 cases, exemptions, discharge,
// dischargeability, the adversary answer and summons, new trial, appeals)
// are lit/frbp's and are not declared again. Not repeated either, as only
// restating a national period: the Clerk's service of a chapter 13 plan 28
// days before the § 341 meeting (B.L.R. 3015-1(b)(1); FRBP 2002(b)); a
// governmental unit's claim 180 days after the order for relief (B.L.R.
// 3003-1; 11 U.S.C. § 502(b)(9)); the hearing on continuing the stay within
// 30 days of the petition (B.L.R. 4001-2(e); 11 U.S.C. § 362(c)(3)(B));
// the statement on consent to final orders within 14 days of a notice of
// removal (B.L.R. 9027-1(b); FRBP 9027(e)(3)).
//
// Stated in the rules but not declared: the periods B.L.R. 9014-1(b)(3)
// sets for particular motions by substituting their own (14 and 7 days on
// conversion, B.L.R. 1017-1(b); 5 days on stay extension, B.L.R.
// 4001-2(d)); the 7-day tentative hearing setback (B.L.R. 4001-2(d)); the
// 3-day telephone, ballot and memoranda periods before a hearing (B.L.R.
// 3017-1(b), 3020-1); the hearing on a delayed discharge not more than 10
// days before entry and the discharge not earlier than 30 days after the
// statement (B.L.R. 4004-1(d)); the 60 days' notice of a fund's policy
// change (B.L.R. 2015-1(c)); a chapter 7 trustee's 7-day shortened notice
// (B.L.R. 9014-1(d)); the 7-day lodging of an order not approved as to form
// (B.L.R. 9021-1(c)); the Clerk's 28 days to transmit proposed findings
// (B.L.R. 9033-1(c)); the District Court briefing schedules on withdrawal of
// the reference and dismissal of an appeal (B.L.R. 5011-2(d), 8009-1(b));
// and the Bankruptcy Dispute Resolution Program's periods (B.L.R. 9040-3
// through 9050-1). B.L.R. 9039-1, also vendored on its own
// (sources/bankr-can/canb-blr-9039-1-2026-05-04.txt), is part of the same
// May 4, 2026 amendment set, is in the consolidation as served, and states
// no period. The earlier outline's Supreme Court decisions construe the
// Code and the FRBP, not these rules, and are removed here: no reporter
// text is vendored.
/// An initial or response memorandum of points and authorities: not more
/// than 25 pages of text unless the court orders otherwise (Bankr. N.D.
/// Cal. B.L.R. 9013-1(c)).
limit memorandum {
  pages <= 25 cite "Bankr. N.D. Cal. B.L.R. 9013-1(c)"
} cite "Bankr. N.D. Cal. B.L.R. 9013-1(c)"

/// A reply memorandum: not more than 15 pages of text unless the court
/// orders otherwise (Bankr. N.D. Cal. B.L.R. 9013-1(c)).
limit reply-memorandum {
  pages <= 15 cite "Bankr. N.D. Cal. B.L.R. 9013-1(c)"
} cite "Bankr. N.D. Cal. B.L.R. 9013-1(c)"

/// Notice of a deposit in a Designated Fund is mailed (Bankr. N.D. Cal.
/// B.L.R. 2015-1(c)).
event FundNoticeMailed()
/// Notice and opportunity for hearing on a claim objection is mailed
/// (Bankr. N.D. Cal. B.L.R. 3007-1(c)).
event ClaimObjectionNoticeMailed()
/// The scheduled hearing on a claim objection (Bankr. N.D. Cal. B.L.R.
/// 3007-1(c)).
event ClaimObjectionHearing()
/// The hearing on confirmation of a chapter 12 plan (Bankr. N.D. Cal.
/// B.L.R. 3015-1(a)).
event ChapterTwelveConfirmationHearing()
/// The hearing on confirmation of an amended chapter 13 plan (Bankr. N.D.
/// Cal. B.L.R. 3015-1(b)).
event AmendedPlanHearing()
/// An amended chapter 13 plan is served (Bankr. N.D. Cal. B.L.R.
/// 3015-1(b)).
event AmendedPlanServed()
/// The hearing on approval of a disclosure statement (Bankr. N.D. Cal.
/// B.L.R. 3017-1(a)).
event DisclosureStatementHearing()
/// Notice of an application for a final decree is served (Bankr. N.D. Cal.
/// B.L.R. 3022-1(b)).
event FinalDecreeNoticeServed()
/// A debtor's statement and certification for a delayed discharge is served
/// (Bankr. N.D. Cal. B.L.R. 4004-1(d)).
event DischargeStatementServed()
/// The hearing date of a motion (Bankr. N.D. Cal. B.L.R. 7007-1,
/// 9014-1(c)).
event MotionHearing()
/// A notice and opportunity for hearing is mailed (Bankr. N.D. Cal. B.L.R.
/// 9014-1(b)).
event OpportunityNoticeMailed()
/// The last date to object or request a hearing on a notice and opportunity
/// for hearing (Bankr. N.D. Cal. B.L.R. 9014-1(b)).
event ObjectionDeadline()
/// A tentative hearing on a notice and opportunity for hearing (Bankr. N.D.
/// Cal. B.L.R. 9014-1(b)).
event TentativeHearing()

/// Bankr. N.D. Cal. B.L.R. 2015-1(c): a party in interest may object to a
/// deposit in a Designated Fund within 14 days of the mailing of the
/// notice, or within the time the court fixes.
deadline fund-objection-period: 14.days after FundNoticeMailed() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 2015-1(c)"
/// Bankr. N.D. Cal. B.L.R. 3003-1: unless the court orders otherwise under
/// FRBP 3003(c)(3), a proof of claim or interest in a chapter 11 case is
/// filed within 90 days after the first date set for the § 341(a) meeting.
deadline chapter-11-claim-period: 90.days after FirstMeetingDate() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 3003-1"
/// Bankr. N.D. Cal. B.L.R. 3007-1(c): on a claim objection, the time to
/// object and request a hearing under B.L.R. 9014-1(b)(3)(A) is 30 days.
deadline claim-objection-request-period: 30.days after ClaimObjectionNoticeMailed() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 3007-1(c)"
/// Bankr. N.D. Cal. B.L.R. 3007-1(c): on a claim objection, notice of the
/// scheduled hearing date under B.L.R. 9014-1(c)(1) and (2) is 30 days.
deadline claim-objection-hearing-notice-period: 30.days before ClaimObjectionHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 3007-1(c)"
/// Bankr. N.D. Cal. B.L.R. 3015-1(a)(1): unless otherwise ordered, notice
/// of the hearing on confirmation of a chapter 12 plan is served not less
/// than 35 days before the hearing.
deadline chapter-12-confirmation-notice-period: 35.days before ChapterTwelveConfirmationHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 3015-1(a)"
/// Bankr. N.D. Cal. B.L.R. 3015-1(a)(1): objections to confirmation of a
/// chapter 12 plan are filed and served not less than 7 days before the
/// hearing.
deadline chapter-12-confirmation-objection-period: 7.days before ChapterTwelveConfirmationHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 3015-1(a)"
/// Bankr. N.D. Cal. B.L.R. 3015-1(b)(2): before confirmation, the debtor
/// serves an amended chapter 13 plan with at least 21 days' notice of the
/// hearing on its confirmation.
deadline amended-plan-notice-period: 21.days before AmendedPlanHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 3015-1(b)"
/// Bankr. N.D. Cal. B.L.R. 3015-1(b)(3): objections to an amended chapter
/// 13 plan are filed and served within 14 days of service of the amended
/// plan.
deadline amended-plan-objection-period: 14.days after AmendedPlanServed() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 3015-1(b)"
/// Bankr. N.D. Cal. B.L.R. 3017-1(a): notice of the hearing on a disclosure
/// statement is served not less than 35 days before the hearing.
deadline disclosure-statement-notice-period: 35.days before DisclosureStatementHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 3017-1(a)"
/// Bankr. N.D. Cal. B.L.R. 3017-1(a): unless the court orders otherwise,
/// the deadline for objections to a disclosure statement is 7 days before
/// the hearing; a certificate of service is filed at least 7 days before
/// it.
deadline disclosure-statement-objection-period: 7.days before DisclosureStatementHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 3017-1(a)"
/// Bankr. N.D. Cal. B.L.R. 3022-1(b): an application for a final decree is
/// considered without a hearing unless within 14 days after service of the
/// notice a party in interest files and serves an objection.
deadline final-decree-objection-period: 14.days after FinalDecreeNoticeServed() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 3022-1(b)"
/// Bankr. N.D. Cal. B.L.R. 4004-1(d)(2): a party requesting delay of the
/// entry of discharge files a written response no later than 21 days from
/// service of the debtor's statement and certification.
deadline discharge-delay-request-period: 21.days after DischargeStatementServed() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 4004-1(d)"
/// Bankr. N.D. Cal. B.L.R. 7007-1(a): except as otherwise ordered, a motion
/// in an adversary proceeding is filed and served at least 28 days before
/// the hearing.
deadline adversary-motion-notice-period: 28.days before MotionHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 7007-1(a)"
/// Bankr. N.D. Cal. B.L.R. 7007-1(b): any opposition is filed and served at
/// least 14 days before the hearing.
deadline adversary-opposition-period: 14.days before MotionHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 7007-1(b)"
/// Bankr. N.D. Cal. B.L.R. 7007-1(e): any reply is filed and served by the
/// moving party at least 7 days before the hearing.
deadline adversary-reply-period: 7.days before MotionHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 7007-1(e)"
/// Bankr. N.D. Cal. B.L.R. 9014-1(b)(3)(A): an objection to relief sought
/// on notice and opportunity for hearing, or a request for hearing, is
/// filed and served within 21 days of mailing the notice.
deadline opportunity-objection-period: 21.days after OpportunityNoticeMailed() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 9014-1(b)"
/// Bankr. N.D. Cal. B.L.R. 9014-1(b)(3)(B): a tentative hearing is set at
/// least 14 days after the last date to object or request a hearing.
deadline tentative-hearing-period: 14.days after ObjectionDeadline() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 9014-1(b)"
/// Bankr. N.D. Cal. B.L.R. 9014-1(b)(3)(B): on a timely objection, the
/// initiating party files and serves not less than 7 days before the
/// hearing notice that the tentative hearing will be conducted as an actual
/// hearing.
deadline actual-hearing-notice-period: 7.days before TentativeHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 9014-1(b)"
/// Bankr. N.D. Cal. B.L.R. 9014-1(c)(1): where relief is sought against an
/// identified, named entity, the motion and papers are filed and served at
/// least 28 days before the hearing.
deadline named-entity-motion-period: 28.days before MotionHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 9014-1(c)"
/// Bankr. N.D. Cal. B.L.R. 9014-1(c)(1): opposition is filed and served at
/// least 14 days before the hearing.
deadline named-entity-opposition-period: 14.days before MotionHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 9014-1(c)"
/// Bankr. N.D. Cal. B.L.R. 9014-1(c)(1): any reply is filed and served at
/// least 7 days before the hearing.
deadline named-entity-reply-period: 7.days before MotionHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 9014-1(c)"
/// Bankr. N.D. Cal. B.L.R. 9014-1(c)(2): where relief is sought generally,
/// the motion and papers are filed and served at least 21 days before the
/// hearing.
deadline general-relief-motion-period: 21.days before MotionHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 9014-1(c)"
/// Bankr. N.D. Cal. B.L.R. 9014-1(c)(2): opposition to relief sought
/// generally is filed and served no less than 7 days before the hearing.
deadline general-relief-opposition-period: 7.days before MotionHearing() counted_by frbp9006 cite "Bankr. N.D. Cal. B.L.R. 9014-1(c)"

start motion-filed

state motion-filed: "Request for relief with notice and opportunity for hearing" by applicant cite "Bankr. N.D. Cal. B.L.R. 9014-1(b)"
{
  note "Any objection or request for hearing is filed and served within 21 days of mailing the notice (B.L.R. 9014-1(b)(3)(A)); a claim objection gives 30 days (B.L.R. 3007-1(c)). Matters set for hearing follow B.L.R. 9014-1(c). The motion's FRBP periods are lit/frbp's."
  edge-motion-filed-opposed "Objection or request for hearing filed" -> opposed {
    authority cite "Bankr. N.D. Cal. B.L.R. 9014-1(b)"
    within opportunity-objection-period
  }
  edge-motion-filed-unopposed "No timely objection" -> ruling {
    authority cite "Bankr. N.D. Cal. B.L.R. 9014-1(b)"
  }
}

state opposed: "Objection filed; hearing noticed" by opponent cite "Bankr. N.D. Cal. B.L.R. 9014-1(b)"
{
  note "The initiating party gives at least seven days' written notice of the hearing, or the tentative hearing goes forward as an actual hearing on notice filed not less than 7 days before it (B.L.R. 9014-1(b)(3))."
  edge-opposed-ruling "Hearing held" -> ruling {
    authority cite "Bankr. N.D. Cal. B.L.R. 9014-1(c)"
  }
}

decision ruling: "Relief decided" by court cite "Bankr. N.D. Cal. B.L.R. 9014-1(b)"
{
  note "Without a timely objection or request for hearing the court may enter an order granting the relief by default."
  edge-ruling-granted "Granted" -> decided { authority cite "Bankr. N.D. Cal. B.L.R. 9021-1" }
  edge-ruling-denied "Denied" -> decided { authority cite "Bankr. N.D. Cal. B.L.R. 9021-1" }
}

terminal decided: "Matter decided: the case continues under lit/frbp" outcome [procedural] cite "Bankr. N.D. Cal. B.L.R. 1001-1"

test "fund objection period: 14 days after" cite "Bankr. N.D. Cal. B.L.R. 2015-1(c)"
{
  given FundNoticeMailed() on 2027-01-04
  expect deadline(fund-objection-period) == 2027-01-19
}

test "chapter 11 claim period: 90 days after" cite "Bankr. N.D. Cal. B.L.R. 3003-1"
{
  given FirstMeetingDate() on 2027-01-04
  expect deadline(chapter-11-claim-period) == 2027-04-05
}

test "claim objection request period: 30 days after" cite "Bankr. N.D. Cal. B.L.R. 3007-1(c)"
{
  given ClaimObjectionNoticeMailed() on 2027-01-04
  expect deadline(claim-objection-request-period) == 2027-02-03
}

test "claim objection hearing notice period: 30 days before" cite "Bankr. N.D. Cal. B.L.R. 3007-1(c)"
{
  given ClaimObjectionHearing() on 2027-01-04
  expect deadline(claim-objection-hearing-notice-period) == 2026-12-04
}

test "chapter 12 confirmation notice period: 35 days before" cite "Bankr. N.D. Cal. B.L.R. 3015-1(a)"
{
  given ChapterTwelveConfirmationHearing() on 2027-01-04
  expect deadline(chapter-12-confirmation-notice-period) == 2026-11-30
}

test "chapter 12 confirmation objection period: 7 days before" cite "Bankr. N.D. Cal. B.L.R. 3015-1(a)"
{
  given ChapterTwelveConfirmationHearing() on 2027-01-04
  expect deadline(chapter-12-confirmation-objection-period) == 2026-12-28
}

test "amended plan notice period: 21 days before" cite "Bankr. N.D. Cal. B.L.R. 3015-1(b)"
{
  given AmendedPlanHearing() on 2027-01-04
  expect deadline(amended-plan-notice-period) == 2026-12-14
}

test "amended plan objection period: 14 days after" cite "Bankr. N.D. Cal. B.L.R. 3015-1(b)"
{
  given AmendedPlanServed() on 2027-01-04
  expect deadline(amended-plan-objection-period) == 2027-01-19
}

test "disclosure statement notice period: 35 days before" cite "Bankr. N.D. Cal. B.L.R. 3017-1(a)"
{
  given DisclosureStatementHearing() on 2027-01-04
  expect deadline(disclosure-statement-notice-period) == 2026-11-30
}

test "disclosure statement objection period: 7 days before" cite "Bankr. N.D. Cal. B.L.R. 3017-1(a)"
{
  given DisclosureStatementHearing() on 2027-01-04
  expect deadline(disclosure-statement-objection-period) == 2026-12-28
}

test "final decree objection period: 14 days after" cite "Bankr. N.D. Cal. B.L.R. 3022-1(b)"
{
  given FinalDecreeNoticeServed() on 2027-01-04
  expect deadline(final-decree-objection-period) == 2027-01-19
}

test "discharge delay request period: 21 days after" cite "Bankr. N.D. Cal. B.L.R. 4004-1(d)"
{
  given DischargeStatementServed() on 2027-01-04
  expect deadline(discharge-delay-request-period) == 2027-01-25
}

test "adversary motion notice period: 28 days before" cite "Bankr. N.D. Cal. B.L.R. 7007-1(a)"
{
  given MotionHearing() on 2027-01-04
  expect deadline(adversary-motion-notice-period) == 2026-12-07
}

test "adversary opposition period: 14 days before" cite "Bankr. N.D. Cal. B.L.R. 7007-1(b)"
{
  given MotionHearing() on 2027-01-04
  expect deadline(adversary-opposition-period) == 2026-12-21
}

test "adversary reply period: 7 days before" cite "Bankr. N.D. Cal. B.L.R. 7007-1(e)"
{
  given MotionHearing() on 2027-01-04
  expect deadline(adversary-reply-period) == 2026-12-28
}

test "opportunity objection period: 21 days after" cite "Bankr. N.D. Cal. B.L.R. 9014-1(b)"
{
  given OpportunityNoticeMailed() on 2027-01-04
  expect deadline(opportunity-objection-period) == 2027-01-25
}

test "tentative hearing period: 14 days after" cite "Bankr. N.D. Cal. B.L.R. 9014-1(b)"
{
  given ObjectionDeadline() on 2027-01-04
  expect deadline(tentative-hearing-period) == 2027-01-19
}

test "actual hearing notice period: 7 days before" cite "Bankr. N.D. Cal. B.L.R. 9014-1(b)"
{
  given TentativeHearing() on 2027-01-04
  expect deadline(actual-hearing-notice-period) == 2026-12-28
}

test "named entity motion period: 28 days before" cite "Bankr. N.D. Cal. B.L.R. 9014-1(c)"
{
  given MotionHearing() on 2027-01-04
  expect deadline(named-entity-motion-period) == 2026-12-07
}

test "named entity opposition period: 14 days before" cite "Bankr. N.D. Cal. B.L.R. 9014-1(c)"
{
  given MotionHearing() on 2027-01-04
  expect deadline(named-entity-opposition-period) == 2026-12-21
}

test "named entity reply period: 7 days before" cite "Bankr. N.D. Cal. B.L.R. 9014-1(c)"
{
  given MotionHearing() on 2027-01-04
  expect deadline(named-entity-reply-period) == 2026-12-28
}

test "general relief motion period: 21 days before" cite "Bankr. N.D. Cal. B.L.R. 9014-1(c)"
{
  given MotionHearing() on 2027-01-04
  expect deadline(general-relief-motion-period) == 2026-12-14
}

test "general relief opposition period: 7 days before" cite "Bankr. N.D. Cal. B.L.R. 9014-1(c)"
{
  given MotionHearing() on 2027-01-04
  expect deadline(general-relief-opposition-period) == 2026-12-28
}
