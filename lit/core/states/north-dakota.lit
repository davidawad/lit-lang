module core.states.north-dakota

import core.calendar.{ us-federal-holidays }

calendar north-dakota-holidays cite "N.D.C.C. 1-03-01"
{
  good-friday-2027: once(2027-03-26) effective [2026-10-22, ..)
  good-friday-2028: once(2028-04-14) effective [2026-10-22, ..)
  good-friday-2029: once(2029-03-30) effective [2026-10-22, ..)
  good-friday-2030: once(2030-04-19) effective [2026-10-22, ..)
  good-friday-2031: once(2031-04-11) effective [2026-10-22, ..)
  good-friday-2032: once(2032-03-26) effective [2026-10-22, ..)
  good-friday-2033: once(2033-04-15) effective [2026-10-22, ..)
  good-friday-2034: once(2034-04-07) effective [2026-10-22, ..)
  good-friday-2035: once(2035-03-23) effective [2026-10-22, ..)
  good-friday-2036: once(2036-04-11) effective [2026-10-22, ..)
  good-friday-2037: once(2037-04-03) effective [2026-10-22, ..)
  good-friday-2038: once(2038-04-23) effective [2026-10-22, ..)
  good-friday-2039: once(2039-04-08) effective [2026-10-22, ..)
  good-friday-2040: once(2040-03-30) effective [2026-10-22, ..)
  good-friday-2041: once(2041-04-19) effective [2026-10-22, ..)
  good-friday-2042: once(2042-04-04) effective [2026-10-22, ..)
  good-friday-2043: once(2043-03-27) effective [2026-10-22, ..)
  good-friday-2044: once(2044-04-15) effective [2026-10-22, ..)
  good-friday-2045: once(2045-04-07) effective [2026-10-22, ..)
  good-friday-2046: once(2046-03-23) effective [2026-10-22, ..)
  good-friday-2047: once(2047-04-12) effective [2026-10-22, ..)
  good-friday-2048: once(2048-04-03) effective [2026-10-22, ..)
