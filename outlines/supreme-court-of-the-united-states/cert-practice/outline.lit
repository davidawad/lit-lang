// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
// Sources: Rules of the Supreme Court (supremecourt.gov/ctrules/2019RulesoftheCourt.pdf,
// adopted April 18, 2019, effective July 1, 2019; fetched 2026-10-26). Rule 13.5 allows an
// extension of up to 60 days (fetched text). Rule 38(a) docketing fee and Rule 38(b)
// rehearing fee are amounts stated in that text and are holes here. 28 U.S.C. § 2101(c)
// (LII heading, fetched 2026-10-26). Key decisions are unverified.
module outline-scotus-cert-practice

start judgment-below

state judgment-below: "Judgment or decision of a state court of last resort or federal court of appeals" by office cite ?("S. Ct. R. 13.1")
{
  note "OUTLINE. The judgment that may be reviewed under 28 U.S.C. § 1254 and Rule 13. Certiorari to a state court of last resort is covered by Rule 13.1 as well. The clock starts at entry of the judgment, not at the mandate (Rule 13.3)."
  edge-judgment-below-petition "Petition clock starts" -> petition-window {
    authority cite ?("S. Ct. R. 13.1")
  }
}

decision petition-window: "Petition filed within the Rule 13 period" by applicant cite ?("S. Ct. R. 13.1; S. Ct. R. 13.3; S. Ct. R. 30")
{
  note "OUTLINE. Time to petition is 90 days after entry of the judgment (Rule 13.1, fetched text). A timely petition for rehearing in the lower court tolls the period under Rule 13.3 (verify the text). The Clerk will not file a petition that is jurisdictionally out of time (Rule 13.2, citing 28 U.S.C. § 2101(c)). Computation of time is under Rule 30. Key decision (verify): Hohn v. United States, 524 U.S. 236 (1998) (scope of the Court's certiorari jurisdiction; cited as the jurisdictional threshold)."
  edge-petition-window-filed "Petition filed in time" -> petition-docketed {
    authority cite ?("S. Ct. R. 13.1")
  }
  edge-petition-window-extension "Extension requested" -> extension-ruling {
    authority cite ?("S. Ct. R. 13.5")
  }
  edge-petition-window-late "Filed out of time" -> dismissed-late {
    authority cite ?("28 U.S.C. § 2101(c)")
  }
}

decision extension-ruling: "Extension of time granted or denied" by court cite ?("S. Ct. R. 13.5; S. Ct. R. 22")
{
  note "OUTLINE. A Justice may extend the time for good cause for a period not exceeding 60 days (Rule 13.5, fetched text; source https://www.supremecourt.gov/ctrules/2019RulesoftheCourt.pdf, retrieved 2026-10-26). The application goes to the Justice under Rule 22. The filing deadline for the application is a hole."
  edge-extension-ruling-granted "Granted" -> petition-docketed {
    authority cite ?("S. Ct. R. 13.5")
  }
  edge-extension-ruling-denied "Denied" -> dismissed-late {
    authority cite ?("S. Ct. R. 13.5")
  }
}

state petition-docketed: "Petition filed and docketed; fee or IFP motion" by applicant cite ?("S. Ct. R. 12; S. Ct. R. 14; S. Ct. R. 38; S. Ct. R. 39")
{
  note "OUTLINE. Filing and copy requirements in Rule 12. Contents and the questions presented in Rule 14 (word limit in Rule 33.1 is a hole). The docketing fee is under Rule 38(a) (amount is a hole). In forma pauperis petitions are under Rule 39. Veterans and military cases have a special rule at Rule 40."
  edge-petition-docketed-response "Docketed; response period starts" -> response-decision {
    authority cite ?("S. Ct. R. 15.3")
  }
}

decision response-decision: "Brief in opposition filed or response waived" by office cite ?("S. Ct. R. 15.1; S. Ct. R. 15.3; S. Ct. R. 15.5")
{
  note "OUTLINE. A brief in opposition is optional except in a capital case or when ordered (Rule 15.1). It is due 30 days after the case is docketed unless extended (Rule 15.3, fetched text). Express waiver lets the Clerk distribute the petition (Rule 15.5, fetched text). Objections to jurisdiction go in the brief in opposition (Rule 15.4). Brief in opposition content is in Rule 15.2."
  edge-response-decision-bio "Brief in opposition filed" -> reply-brief {
    authority cite ?("S. Ct. R. 15.3")
  }
  edge-response-decision-waived "Express waiver" -> distribution {
    authority cite ?("S. Ct. R. 15.5")
  }
}

state reply-brief: "Reply to new matter (optional)" by applicant cite ?("S. Ct. R. 15.6")
{
  note "OUTLINE. A reply addresses new matter in the brief in opposition (Rule 15.6). A supplemental brief may be filed at any time under Rule 15.8. Reply periods and page limits are holes."
  edge-reply-brief-distribution "Reply filed or period lapsed" -> distribution {
    authority cite ?("S. Ct. R. 15.6")
  }
}

state distribution: "Distributed to the Justices for conference" by office cite ?("S. Ct. R. 15.5")
{
  note "OUTLINE. The Clerk distributes the petition for conference (Rule 15.5). The conference and the relisting practice are Court practice, not rule text (verify)."
  edge-distribution-conference "Distributed" -> conference {
    authority cite ?("S. Ct. R. 15.5")
  }
}

state conference: "Conference" by court cite ?("S. Ct. R. 16.1; S. Ct. R. 10")
{
  note "OUTLINE. The Court considers the documents distributed under Rule 15 (Rule 16.1). The considerations governing review are in Rule 10 (not a binding test, per the rule text: verify). Key decision (verify): none named; grant-standard decisions are not outlined here."
  edge-conference-disposition "Conference held" -> disposition {
    authority cite ?("S. Ct. R. 16.1")
  }
}

decision disposition: "Order: grant, deny, summary disposition, or further consideration" by court cite ?("S. Ct. R. 16.1; S. Ct. R. 16.2; S. Ct. R. 16.3; S. Ct. R. 11")
{
  note "OUTLINE. A grant is entered by order and the case is scheduled for briefing (Rule 16.2). A denial is entered by order (Rule 16.3). A summary disposition on the merits is possible (Rule 16.1). Certiorari before judgment is under Rule 11. Further consideration (relisting) is practice, not rule text (verify)."
  edge-disposition-granted "Granted" -> grant-order {
    authority cite ?("S. Ct. R. 16.2")
  }
  edge-disposition-denied "Denied" -> denial-order {
    authority cite ?("S. Ct. R. 16.3")
  }
  edge-disposition-summary "Summary disposition on the merits" -> summary-disposition {
    authority cite ?("S. Ct. R. 16.1")
  }
  edge-disposition-held "Further consideration at a later conference" -> conference {
    authority cite ?("S. Ct. R. 16.1")
  }
}

state grant-order: "Grant order; case scheduled for briefing" by court cite ?("S. Ct. R. 16.2")
{
  note "OUTLINE. The Clerk enters the grant and requests the record if not yet filed (Rule 16.2)."
  edge-grant-order-merits "Briefing begins" -> petitioner-merits-brief {
    authority cite ?("S. Ct. R. 25.1")
  }
}

state petitioner-merits-brief: "Petitioner's brief on the merits" by applicant cite ?("S. Ct. R. 24.1; S. Ct. R. 25.1")
{
  note "OUTLINE. The petitioner's brief is due 45 days after the grant (Rule 25.1, fetched text). Form and content: Rule 24.1 (questions presented on the first page after the cover; the brief may not add questions, Rule 24.1(a)). Word limits are in Rule 33.1 (a hole). Forty copies are required (Rule 25.1)."
  edge-petitioner-merits-respondent "Petitioner's brief filed" -> respondent-merits-brief {
    authority cite ?("S. Ct. R. 25.2")
  }
}

state respondent-merits-brief: "Respondent's brief on the merits" by applicant cite ?("S. Ct. R. 25.2; S. Ct. R. 37")
{
  note "OUTLINE. The respondent's brief is due 30 days after the petitioner's brief (Rule 25.2, fetched text). Amicus briefs in support of a party are governed by Rule 37 (timing text is a hole; verify Rule 37.3). Joint appendix is under Rule 26."
  edge-respondent-merits-reply "Respondent's brief filed" -> reply-merits-brief {
    authority cite ?("S. Ct. R. 25.3")
  }
}

state reply-merits-brief: "Petitioner's reply brief" by applicant cite ?("S. Ct. R. 25.3")
{
  note "OUTLINE. The reply is due 30 days after the respondent's brief and must be received at least 10 days before argument (Rule 25.3, fetched text)."
  edge-reply-merits-calendar "Reply filed" -> argument-calendar {
    authority cite ?("S. Ct. R. 25.3")
  }
}

state argument-calendar: "Case calendared for argument" by office cite ?("S. Ct. R. 27; S. Ct. R. 26")
{
  note "OUTLINE. The argument calendar is under Rule 27. The joint appendix must be filed under Rule 26. Motions for extra argument time are under Rule 28.3 and Rule 21 (verify)."
  edge-argument-calendar-argument "Argued" -> argument {
    authority cite ?("S. Ct. R. 28")
  }
}

state argument: "Oral argument" by court cite ?("S. Ct. R. 28.1; S. Ct. R. 28.2; S. Ct. R. 28.3")
{
  note "OUTLINE. Oral argument emphasizes the briefs (Rule 28.1). The petitioner opens and may conclude; a cross-petition is argued with the initial case (Rule 28.2). Each side gets one-half hour unless the Court directs otherwise (Rule 28.3, fetched text)."
  edge-argument-opinion "Argument concluded" -> merits-decision {
    authority cite ?("S. Ct. R. 41")
  }
}

decision merits-decision: "Opinion and judgment on the merits" by court cite ?("S. Ct. R. 41; S. Ct. R. 45")
{
  note "OUTLINE. Opinions of the Court under Rule 41. Judgment and mandate under Rule 45. Key decision (verify): none named for the procedural stage."
  edge-merits-decision-affirmed "Judgment affirmed" -> affirmed {
    authority cite ?("S. Ct. R. 41")
  }
  edge-merits-decision-reversed "Judgment reversed or vacated" -> reversed {
    authority cite ?("S. Ct. R. 41")
  }
  edge-merits-decision-remanded "Remanded for further proceedings" -> remanded {
    authority cite ?("S. Ct. R. 41")
  }
  edge-merits-decision-dismissed "Case dismissed" -> dismissed-merits {
    authority cite ?("S. Ct. R. 46")
  }
  edge-merits-decision-rehearing "Rehearing sought" -> rehearing-petition {
    authority cite ?("S. Ct. R. 44.1")
  }
}

state rehearing-petition: "Petition for rehearing of a merits judgment" by applicant cite ?("S. Ct. R. 44.1")
{
  note "OUTLINE. A petition for rehearing of a merits judgment is due 25 days after entry (Rule 44.1, fetched text). It is not subject to oral argument and is granted only by a majority, at the instance of a Justice who concurred in the judgment (Rule 44.1). A certificate of good faith is required. Fee is under Rule 38(b) (amount is a hole)."
  edge-rehearing-petition-decided "Rehearing acted on" -> rehearing-decision {
    authority cite ?("S. Ct. R. 44.1")
  }
}

decision rehearing-decision: "Rehearing denied or granted" by court cite ?("S. Ct. R. 44.1; S. Ct. R. 45")
{
  note "OUTLINE. A grant of rehearing requires a majority and a concurring-Justice initiative (Rule 44.1). Denial leads to the mandate under Rule 45 (verify the timing of the judgment's issue)."
  edge-rehearing-decision-denied "Denied" -> mandate-issued {
    authority cite ?("S. Ct. R. 45")
  }
  edge-rehearing-decision-granted "Granted; case reconsidered" -> merits-decision {
    authority cite ?("S. Ct. R. 44.1")
  }
}

state denial-order: "Order denying certiorari entered" by court cite ?("S. Ct. R. 16.3")
{
  note "OUTLINE. The order of denial is entered (Rule 16.3). The order is not suspended by a rehearing petition unless the Court or a Justice orders otherwise (Rule 16.3, fetched text)."
  edge-denial-order-rehearing "Petition for rehearing of the denial" -> denial-order-rehearing {
    authority cite ?("S. Ct. R. 44.2")
  }
  edge-denial-order-final "No rehearing petition" -> denial-final {
    authority cite ?("S. Ct. R. 16.3")
  }
}

state denial-order-rehearing: "Petition for rehearing of an order denying certiorari" by applicant cite ?("S. Ct. R. 44.2")
{
  note "OUTLINE. A petition for rehearing of a denial of certiorari is due 25 days after the order (Rule 44.2, fetched text). It must comply with the same form and filing rules as Rule 44.1."
  edge-denial-order-rehearing-decided "Rehearing acted on" -> denial-final {
    authority cite ?("S. Ct. R. 44.2")
  }
}

terminal dismissed-late: "Petition dismissed or not filed; out of time" outcome [loss] cite ?("28 U.S.C. § 2101(c)")
{
  note "OUTLINE. A petition out of time under Rule 13.2 is not filed."
  payoff ?
}

terminal summary-disposition: "Summary disposition on the merits" outcome [decided] cite ?("S. Ct. R. 16.1")
{
  note "OUTLINE. A summary disposition is entered without argument."
  payoff ?
}

terminal affirmed: "Judgment affirmed" outcome [loss] cite ?("S. Ct. R. 41")
{
  note "OUTLINE. The judgment below is affirmed."
  payoff ?
}

terminal reversed: "Judgment reversed or vacated" outcome [win] cite ?("S. Ct. R. 41")
{
  note "OUTLINE. The judgment below is reversed or vacated."
  payoff ?
}

terminal remanded: "Remanded for further proceedings" outcome [remand] cite ?("S. Ct. R. 41")
{
  note "OUTLINE. The case is remanded. Further proceedings are outside this outline."
  payoff ?
}

terminal dismissed-merits: "Case dismissed" outcome [decided] cite ?("S. Ct. R. 46")
{
  note "OUTLINE. Dismissal under Rule 46."
  payoff ?
}

terminal mandate-issued: "Judgment issued; case closed" outcome [decided] cite ?("S. Ct. R. 45")
{
  note "OUTLINE. The judgment issues to the lower court under Rule 45."
  payoff ?
}

terminal denial-final: "Rehearing of certiorari denial denied; case final" outcome [loss] cite ?("S. Ct. R. 44.2")
{
  note "OUTLINE. The denial of certiorari is final."
  payoff ?
}
