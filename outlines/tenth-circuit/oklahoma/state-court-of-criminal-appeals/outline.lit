// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
// Oklahoma Court of Criminal Appeals.
module outline-ok-court-of-criminal-appeals

import outline-ok-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start invoked

state invoked: "Review invoked" by applicant cite ?("Okla. Ct. Crim. App. R. 2.1") {
  note "OUTLINE. Oklahoma's court of last resort in criminal cases. It hears direct appeals, certiorari from guilty pleas, and post-conviction appeals under the Rules of the Court of Criminal Appeals (Okla. Stat. tit. 22, ch. 18, App.; verify). A notice of intent to appeal and designation of record filed in the trial court, then a petition in error in this court (Rules 2.1, 2.5; verify); a guilty-plea conviction is reviewed by certiorari after a motion to withdraw the plea (Rule 4.2; verify). Every period is a hole (?)."
  edge-invoked-proceeds "Jurisdiction accepted" -> record-prepared { event NoticeOfAppealFiled()
    authority cite ?("Okla. Ct. Crim. App. R. 4.2")
  }
  edge-invoked-dismissed "Untimely or not reviewable; dismissed" -> review-dismissed {
    authority cite ?("Okla. Ct. Crim. App. R. 2.1")
  }
}

state record-prepared: "Record filed" by office cite ?("Okla. Ct. Crim. App. R. 2.2") {
  note "OUTLINE. Record and transcript periods are holes (?)."
  edge-record-prepared-briefing "Record complete" -> briefing { event RecordFiled()
    authority cite ?("Okla. Ct. Crim. App. R. 3.4")
  }
}

state briefing: "Briefing" by applicant cite ?("Okla. Ct. Crim. App. R. 3.4") {
  note "OUTLINE. Brief periods, length limits and extension practice are holes (?). Key decisions (verify): Simpson v. State, 1994 OK CR 40, 876 P.2d 690 (harmless-error framework); Spuehler v. State, 1985 OK CR 132, 709 P.2d 202 (sufficiency review)."
  edge-briefing-submitted "Briefs filed" -> argument {
    authority cite ?("Rules of the Oklahoma Court of Criminal Appeals, oral argument (verify rule number)")
  }
}

decision argument: "Oral argument or submission on briefs" by court cite ?("Rules of the Oklahoma Court of Criminal Appeals, oral argument (verify rule number)") {
  note "OUTLINE. Whether argument is granted, and its time limits, are holes."
  edge-argument-argued "Argued" -> decision {
    authority cite ?("Rules of the Oklahoma Court of Criminal Appeals, oral argument (verify rule number)")
  }
  edge-argument-submitted "Submitted on the briefs" -> decision {
    authority cite ?("Rules of the Oklahoma Court of Criminal Appeals, oral argument (verify rule number)")
  }
}

decision decision: "Decision" by court cite ?("Rules of the Oklahoma Court of Criminal Appeals, opinions and summary opinions (verify rule number)") {
  note "OUTLINE. Standards of review (sufficiency, harmless error) are holes until verified. Key decision (verify): Jackson v. Virginia, 443 U.S. 307 (1979)."
  edge-decision-affirmed "Conviction affirmed" -> after-affirmance {
    authority cite ?("Rules of the Oklahoma Court of Criminal Appeals, opinions and summary opinions (verify rule number)")
  }
  edge-decision-reversed "Reversed or remanded" -> conviction-reversed {
    authority cite ?("Okla. Ct. Crim. App. R. 3.15")
  }
}

decision after-affirmance: "Rehearing, further review or mandate" by applicant cite ?("Okla. Ct. Crim. App. R. 3.14") {
  note "OUTLINE. The rehearing and further-review periods are holes (?)."
  edge-after-affirmance-rehearing "Motion for rehearing" -> rehearing {
    authority cite ?("Okla. Ct. Crim. App. R. 3.14")
  }
  edge-after-affirmance-further "Further review sought" -> further-review {
    authority cite ?("Petition for a writ of certiorari to the Supreme Court of the United States under 28 U.S.C. section 1257(a) (verify)")
  }
  edge-after-affirmance-mandate "Mandate issues" -> conviction-affirmed {
    authority cite ?("Okla. Ct. Crim. App. R. 3.15")
  }
}

decision rehearing: "Rehearing ruling" by court cite ?("Okla. Ct. Crim. App. R. 3.14") {
  note "OUTLINE. Grounds for rehearing are holes until verified."
  edge-rehearing-granted "Rehearing granted" -> decision {
    authority cite ?("Okla. Ct. Crim. App. R. 3.14")
  }
  edge-rehearing-denied-further "Rehearing denied; further review sought" -> further-review {
    authority cite ?("Petition for a writ of certiorari to the Supreme Court of the United States under 28 U.S.C. section 1257(a) (verify)")
  }
  edge-rehearing-denied "Rehearing denied; mandate issues" -> conviction-affirmed {
    authority cite ?("Okla. Ct. Crim. App. R. 3.15")
  }
}

terminal review-dismissed: "Review dismissed" outcome [loss] cite ?("Okla. Ct. Crim. App. R. 2.1") {
  note "OUTLINE. Payoff is a hole."
  payoff ?
}

terminal conviction-affirmed: "Conviction affirmed; mandate issued" outcome [loss] cite ?("Okla. Ct. Crim. App. R. 3.15") {
  note "OUTLINE. Collateral review is a hole (verify). Payoff is a hole."
  payoff ?
}

terminal conviction-reversed: "Conviction reversed or remanded" outcome [win] cite ?("Okla. Ct. Crim. App. R. 3.15") {
  note "OUTLINE. Retrial or resentencing on remand is a hole. Payoff is a hole."
  payoff ?
}

terminal further-review: "Further review sought" outcome [appeal] cite ?("Petition for a writ of certiorari to the Supreme Court of the United States under 28 U.S.C. section 1257(a) (verify)") {
  note "OUTLINE. Payoff is a hole."
  payoff ?
}
