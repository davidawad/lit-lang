module ca7.appeal

import core.frap26.{ frap26 }
import frap.events.{ NoticeOfAppealFiled }

// The FRAP periods are lit/frap's: the notice-of-appeal periods of FRAP
// 4(a)(1), the transcript-order period of FRAP 10(b)(1), the appellee and
// reply brief periods of FRAP 31(a)(1), the rehearing periods of FRAP
// 40(d)(1) and the mandate period of FRAP 41(b). This package is the
// Seventh Circuit's layer over them: it declares the circuit's own periods.
// Except in agency cases the time for filing briefs runs from docketing,
// not from the filing of the record (7th Cir. R. 31(a)), so the appellant's
// 40 days of FRAP 31(a)(1) are a period of their own here rather than an
// override of lit/frap's period from the record. The leading decisions on
// appellate jurisdiction and the notice deadline (Catlin v. United States,
// Bowles v. Russell) are lit/frap's. The counsel-names notice due five
// business days before argument (7th Cir. R. 34(a)) is not declared: the
// language counts no business days.
/// The appeal is docketed in the court of appeals (7th Cir. R. 3(b), 12(a),
/// 26.1(c), 31(a)).
event AppealDocketed()
/// The appellant files its docketing statement (7th Cir. R. 3(c)(1)).
event DocketingStatementFiled()
/// The information a disclosure statement must give changes (7th Cir. R.
/// 26.1(d)).
event DisclosureChanged()
/// The date a brief, petition or other document is due, the anchor of the
/// periods that run backward from it (7th Cir. R. 25(b), 26).
event DocumentDue()
/// The clerk enters an order directing counsel to show cause after a brief
/// is not filed when due (7th Cir. R. 31(c)(1), 31(d)).
event BriefShowCauseEntered()
/// The appellee's brief is filed (7th Cir. R. 34(b)(4)).
event AppelleeBriefFiled()
/// The date of oral argument (7th Cir. R. 34(e), 34(h)).
event ArgumentHeard()
/// The clerk sends a pro se criminal appellant notice of a motion to
/// dismiss, or of appointed counsel's motion to withdraw, by certified mail
/// (7th Cir. R. 51(a), 51(b)).
event Rule51NoticeMailed()
/// A certified copy of the Supreme Court's judgment remanding the case
/// issues under its Rule 45.3 (7th Cir. R. 54).
event SupremeCourtRemandIssued()
/// The clerk sends notice, by certified mail, that a docket fee, docketing
/// statement or brief is overdue (7th Cir. I.O.P. 7(a)(1)).
event ProsecutionNoticeSent()
/// The court requests an answer to a petition for rehearing en banc (7th
/// Cir. I.O.P. 5(a)).
event EnBancAnswerRequested()
/// The appeal is docketed in a capital case on direct appeal in a federal
/// criminal prosecution (7th Cir. R. 22(c)(1)(A)).
event CapitalAppealDocketed()
/// The appellant's brief is served in a capital case (7th Cir. R. 22(c)(1)).
event CapitalAppellantBriefServed()
/// The appellee's brief is served in a capital case (7th Cir. R. 22(c)(1)).
event CapitalAppelleeBriefServed()

/// A proceeding docketed without prepayment of the docketing fee: the
/// appellant pays it within 14 days after docketing, or the clerk may
/// dismiss the appeal.
deadline docketing-fee-period: 14.days after AppealDocketed() counted_by frap26 cite "7th Cir. R. 3(b)"
/// The appellant files its docketing statement with the district clerk
/// with the notice of appeal or with the clerk of this court within seven
/// days of filing the notice.
deadline docketing-statement-period: 7.days after NoticeOfAppealFiled() counted_by frap26 cite "7th Cir. R. 3(c)(1)"
/// Failure to file the docketing statement within 14 days of the filing of
/// the notice of appeal leads to a $100 fine on counsel.
deadline docketing-statement-fine-period: 14.days after NoticeOfAppealFiled() counted_by frap26 cite "7th Cir. R. 3(c)(2)"
/// Failure to file the docketing statement within 28 days of the filing of
/// the notice of appeal is treated as abandonment and the appeal is
/// dismissed.
deadline docketing-statement-abandonment-period: 28.days after NoticeOfAppealFiled() counted_by frap26 cite "7th Cir. R. 3(c)(2)"
/// If the appellant's docketing statement is not complete and correct, the
/// appellee provides a complete one within 14 days after its filing.
deadline appellee-docketing-statement-period: 14.days after DocketingStatementFiled() counted_by frap26 cite "7th Cir. R. 3(c)(1)"
/// Within 14 days of the notice of appeal the district court makes its
/// docket complete and available electronically to the court of appeals.
deadline district-docket-period: 14.days after NoticeOfAppealFiled() counted_by frap26 cite "7th Cir. R. 10(a)(1)"
/// Counsel ensures, within 21 days of filing the notice of appeal, that all
/// documents necessary for review are on the district court docket.
deadline record-documents-period: 21.days after NoticeOfAppealFiled() counted_by frap26 cite "7th Cir. R. 10(a)(3)"
/// In a criminal case outside the Criminal Justice Act, the appellant
/// deposits the estimated transcript cost with the reporter within 14 days
/// after filing the notice of appeal.
deadline criminal-transcript-deposit-period: 14.days after NoticeOfAppealFiled() counted_by frap26 cite "7th Cir. R. 10(d)(2)"
/// A motion for exemption from electronic filing is filed at least seven
/// days before the document is due.
deadline electronic-filing-exemption-period: 7.days before DocumentDue() counted_by frap26 cite "7th Cir. R. 25(b)"
/// A motion to extend the time to file a brief is filed at least seven days
/// before the brief is due, unless its basis did not exist or could not be
/// known earlier.
deadline brief-extension-motion-period: 7.days before DocumentDue() counted_by frap26 cite "7th Cir. R. 26"
/// The disclosure statements are filed no later than 21 days after
/// docketing, or earlier with a party's first motion or response or when
/// the court directs.
deadline disclosure-statement-period: 21.days after AppealDocketed() counted_by frap26 cite "7th Cir. R. 26.1(c)"
/// Counsel files an updated disclosure statement within 14 days of any
/// change in the information it must disclose.
deadline disclosure-update-period: 14.days after DisclosureChanged() counted_by frap26 cite "7th Cir. R. 26.1(d)"
/// The time for briefs runs from docketing: the appellant's FRAP 31(a)(1)
/// 40 days count from the date the appeal is docketed, whatever the state
/// of the record.
deadline appellant-brief-period: 40.days after AppealDocketed() counted_by frap26 cite "FRAP 31(a)(1); 7th Cir. R. 31(a)"
/// Counsel answers the clerk's order to show cause for a brief not filed
/// when due within 14 days.
deadline brief-show-cause-period: 14.days after BriefShowCauseEntered() counted_by frap26 cite "7th Cir. R. 31(c)(1); 7th Cir. R. 31(d)"
/// Requests about scheduling argument should be made by letter no later
/// than seven days after the filing of the appellee's brief.
deadline argument-scheduling-request-period: 7.days after AppelleeBriefFiled() counted_by frap26 cite "7th Cir. R. 34(b)(4)"
/// Unless good cause is shown, a motion to waive, postpone or present
/// argument remotely is filed no later than 14 days before the argument.
deadline argument-motion-period: 14.days before ArgumentHeard() counted_by frap26 cite "7th Cir. R. 34(e)"
/// A supervising attorney's motion for argument by a law student is filed
/// at least 14 days before the argument.
deadline law-student-argument-motion-period: 14.days before ArgumentHeard() counted_by frap26 cite "7th Cir. R. 34(h)"
/// Trial counsel in a criminal case, unless retained for the appeal, files
/// a motion to withdraw or for appointment within 14 days of the notice of
/// appeal.
deadline trial-counsel-motion-period: 14.days after NoticeOfAppealFiled() counted_by frap26 cite "7th Cir. R. 46.1(c)"
/// If no response to a Rule 51 notice is received within 30 days after the
/// mailing, the appeal may be dismissed.
deadline rule51-response-period: 30.days after Rule51NoticeMailed() counted_by frap26 cite "7th Cir. R. 51(c)"
/// On a remand from the Supreme Court, counsel file statements of position
/// within 21 days after the certified copy of its judgment issues.
deadline remand-statement-period: 21.days after SupremeCourtRemandIssued() counted_by frap26 cite "7th Cir. R. 54"
/// The clerk dismisses for want of prosecution if the party does not
/// respond within 21 days of the clerk's notice.
deadline prosecution-notice-response-period: 21.days after ProsecutionNoticeSent() counted_by frap26 cite "7th Cir. I.O.P. 7(a)(2)"
/// The prevailing party files an answer to a petition for rehearing en banc
/// within 14 days from the court's request.
deadline en-banc-answer-period: 14.days after EnBancAnswerRequested() counted_by frap26 cite "7th Cir. I.O.P. 5(a)"
/// In a capital case on direct criminal appeal the appellant serves and
/// files its brief within 63 days after docketing.
deadline capital-appellant-brief-period: 63.days after CapitalAppealDocketed() counted_by frap26 cite "7th Cir. R. 22(c)(1)(A)"
/// The capital appellee's brief is due within 49 days after service of the
/// appellant's brief.
deadline capital-appellee-brief-period: 49.days after CapitalAppellantBriefServed() counted_by frap26 cite "7th Cir. R. 22(c)(1)(A)"
/// The capital appellant may serve and file a reply brief within 21 days
/// after service of the appellee's brief.
deadline capital-reply-brief-period: 21.days after CapitalAppelleeBriefServed() counted_by frap26 cite "7th Cir. R. 22(c)(1)(A)"

test "unpaid docketing fee is due 14 days after docketing" cite "7th Cir. R. 3(b)"
{
  given AppealDocketed() on 2026-11-02
  expect deadline(docketing-fee-period) == 2026-11-16
}

test "docketing statement is due 7 days after the notice of appeal" cite "7th Cir. R. 3(c)(1)"
{
  given NoticeOfAppealFiled() on 2026-11-02
  expect deadline(docketing-statement-period) == 2026-11-09
}

test "a docketing statement later than 14 days draws the fine" cite "7th Cir. R. 3(c)(2)"
{
  given NoticeOfAppealFiled() on 2026-11-02
  expect deadline(docketing-statement-fine-period) == 2026-11-16
}

test "a docketing statement later than 28 days is abandonment" cite "7th Cir. R. 3(c)(2)"
{
  given NoticeOfAppealFiled() on 2026-11-02
  expect deadline(docketing-statement-abandonment-period) == 2026-11-30
}

test "appellee's complete docketing statement is due 14 days after the appellant's" cite "7th Cir. R. 3(c)(1)"
{
  given DocketingStatementFiled() on 2026-11-02
  expect deadline(appellee-docketing-statement-period) == 2026-11-16
}

test "district docket is complete 14 days after the notice" cite "7th Cir. R. 10(a)(1)"
{
  given NoticeOfAppealFiled() on 2026-11-02
  expect deadline(district-docket-period) == 2026-11-16
}

test "record documents are on the docket 21 days after the notice" cite "7th Cir. R. 10(a)(3)"
{
  given NoticeOfAppealFiled() on 2026-11-02
  expect deadline(record-documents-period) == 2026-11-23
}

test "criminal transcript deposit is due 14 days after the notice" cite "7th Cir. R. 10(d)(2)"
{
  given NoticeOfAppealFiled() on 2026-11-02
  expect deadline(criminal-transcript-deposit-period) == 2026-11-16
}

test "electronic filing exemption motion is due 7 days before the document" cite "7th Cir. R. 25(b)"
{
  given DocumentDue() on 2026-11-20
  expect deadline(electronic-filing-exemption-period) == 2026-11-13
}

test "brief extension motion is due 7 days before the brief" cite "7th Cir. R. 26"
{
  given DocumentDue() on 2026-11-20
  expect deadline(brief-extension-motion-period) == 2026-11-13
}

test "disclosure statement is due 21 days after docketing" cite "7th Cir. R. 26.1(c)"
{
  given AppealDocketed() on 2026-11-02
  expect deadline(disclosure-statement-period) == 2026-11-23
}

test "updated disclosure statement is due 14 days after a change" cite "7th Cir. R. 26.1(d)"
{
  given DisclosureChanged() on 2026-11-02
  expect deadline(disclosure-update-period) == 2026-11-16
}

test "appellant's brief is due 40 days after docketing, past a Saturday" cite "7th Cir. R. 31(a)"
{
  given AppealDocketed() on 2026-11-02
  expect deadline(appellant-brief-period) == 2026-12-14
}

test "show-cause response is due 14 days after the order" cite "7th Cir. R. 31(c)(1)"
{
  given BriefShowCauseEntered() on 2026-11-02
  expect deadline(brief-show-cause-period) == 2026-11-16
}

test "argument scheduling request is due 7 days after the appellee's brief" cite "7th Cir. R. 34(b)(4)"
{
  given AppelleeBriefFiled() on 2026-11-02
  expect deadline(argument-scheduling-request-period) == 2026-11-09
}

test "motion to waive or postpone argument is due 14 days before it" cite "7th Cir. R. 34(e)"
{
  given ArgumentHeard() on 2026-11-30
  expect deadline(argument-motion-period) == 2026-11-16
}

test "law-student argument motion is due 14 days before argument" cite "7th Cir. R. 34(h)"
{
  given ArgumentHeard() on 2026-11-30
  expect deadline(law-student-argument-motion-period) == 2026-11-16
}

test "trial counsel's withdrawal or appointment motion is due 14 days after the notice" cite "7th Cir. R. 46.1(c)"
{
  given NoticeOfAppealFiled() on 2026-11-02
  expect deadline(trial-counsel-motion-period) == 2026-11-16
}

test "Rule 51 response is due 30 days after mailing" cite "7th Cir. R. 51(c)"
{
  given Rule51NoticeMailed() on 2026-11-02
  expect deadline(rule51-response-period) == 2026-12-02
}

test "remand statements are due 21 days after the Supreme Court's judgment issues" cite "7th Cir. R. 54"
{
  given SupremeCourtRemandIssued() on 2026-11-02
  expect deadline(remand-statement-period) == 2026-11-23
}

test "response to the clerk's prosecution notice is due within 21 days" cite "7th Cir. I.O.P. 7(a)(2)"
{
  given ProsecutionNoticeSent() on 2026-11-02
  expect deadline(prosecution-notice-response-period) == 2026-11-23
}

test "en banc answer is due 14 days after the court's request" cite "7th Cir. I.O.P. 5(a)"
{
  given EnBancAnswerRequested() on 2026-11-02
  expect deadline(en-banc-answer-period) == 2026-11-16
}

test "capital appellant's brief is due 63 days after docketing" cite "7th Cir. R. 22(c)(1)(A)"
{
  given CapitalAppealDocketed() on 2026-11-02
  expect deadline(capital-appellant-brief-period) == 2027-01-04
}

test "capital appellee's brief is due 49 days after the appellant's" cite "7th Cir. R. 22(c)(1)(A)"
{
  given CapitalAppellantBriefServed() on 2026-11-02
  expect deadline(capital-appellee-brief-period) == 2026-12-21
}

test "capital reply brief is due 21 days after the appellee's" cite "7th Cir. R. 22(c)(1)(A)"
{
  given CapitalAppelleeBriefServed() on 2026-11-02
  expect deadline(capital-reply-brief-period) == 2026-11-23
}

start threshold

decision threshold: "Appealable Order or Judgment?" by applicant cite "28 U.S.C. § 1291"
{
  note "A final decision of a district court is appealable under 28 U.S.C. § 1291; interlocutory routes, including permission to appeal under FRAP 5, are lit/frap's. The appellant's jurisdictional statement must give the statutory basis of appellate jurisdiction and the dates of judgment, any tolling motion and its disposition, and the notice of appeal (7th Cir. R. 28(a)(2))."
  edge-threshold-no "Not appealable" -> dismissed-jurisdiction { authority cite "28 U.S.C. § 1291" }
  edge-threshold-yes "Appealable" -> notice { authority cite "28 U.S.C. § 1291" }
}

decision notice: "Notice of Appeal Within Time?" by applicant cite "FRAP 4(a)(1)(A)"
{
  note "The notice is due 30 days after entry of judgment, or 60 days when the United States is a party (FRAP 4(a)(1)); lit/frap encodes both periods. Fees follow the Judicial Conference's Court of Appeals Miscellaneous Fee Schedule (7th Cir. R. 45(a)); the circuit rules state no amount, so no fee is carried here."
  edge-notice-late "Untimely notice" -> dismissed-untimely { authority cite "FRAP 4(a)(1)(A)" }
  edge-notice-timely "Timely notice" -> docketed { authority cite "FRAP 3(a)(1); 7th Cir. R. 3(a)" }
}

state docketed: "Appeal Docketed" by office cite "FRAP 12(a); 7th Cir. R. 12(a)"
{
  note "The clerk notifies counsel of the docketing date (7th Cir. R. 12(a)). An unpaid docketing fee is due within 14 days after docketing (7th Cir. R. 3(b)). The docketing statement is due with the notice or within seven days of it; after 14 days counsel is fined $100 and after 28 days the appeal is dismissed as abandoned (7th Cir. R. 3(c)). The attorney named on the docketing statement or first filing is counsel of record (7th Cir. R. 3(d)). Disclosure statements are due within 21 days after docketing or with a first motion or response, whichever is earliest (7th Cir. R. 26.1(c)); a disclosure statement is an appearance and replaces the FRAP 12(b) representation statement (7th Cir. R. 26.1(a))."
  edge-docketed-record "Record and transcript" -> record {
    authority cite "FRAP 10; 7th Cir. R. 10"
  }
  edge-docketed-default "Docket fee or docketing statement not supplied" -> dismissed-prosecution {
    authority cite "7th Cir. R. 3(b); 7th Cir. R. 3(c)(2); 7th Cir. I.O.P. 7(a)"
  }
}

state record: "Record and Transcript" by applicant cite "FRAP 10; 7th Cir. R. 10"
{
  note "The district court makes its docket complete and available electronically within 14 days of the notice (7th Cir. R. 10(a)(1)); counsel ensures within 21 days that every document needed for review is on it (7th Cir. R. 10(a)(3)). Transcripts are ordered on the court's form (7th Cir. R. 10(c)); a reporter's request to extend the transcript time beyond 30 days from the order is filed with the clerk on the court's form, and beyond 60 days needs a statement from the district judge (7th Cir. R. 10(h))."
  edge-record-brief "Briefing runs from docketing" -> briefing {
    authority cite "7th Cir. R. 31(a)"
  }
}

state briefing: "Briefs Filed" by applicant cite "FRAP 31(a)(1); 7th Cir. R. 31(a)"
{
  note "Except in agency cases the brief periods run from docketing, regardless of the record (7th Cir. R. 31(a)). Extensions are not favored and need a motion with an affidavit filed at least seven days before the due date (7th Cir. R. 26). A principal brief may contain up to 14,000 words and a reply 7,000, in 12-point type with 11-point footnotes (7th Cir. R. 32(b), (c)); in a cross-appeal the appellee's combined brief may contain 16,500 words (7th Cir. R. 28.1), and an amicus brief 7,000 (7th Cir. R. 29). The appendix bound with the brief holds the judgment and the reasons for it (7th Cir. R. 30(a))."
  edge-briefing-argue "Briefing complete" -> argument {
    authority cite "FRAP 31(a)(1); 7th Cir. R. 31(a)"
  }
  edge-briefing-default "Appellant's brief not filed and show-cause unanswered" -> dismissed-prosecution {
    authority cite "7th Cir. R. 31(c)(2); 7th Cir. I.O.P. 7(a)"
  }
}

state argument: "Oral Argument or Submission" by court cite "FRAP 34; 7th Cir. R. 34"
{
  note "The clerk notifies counsel of the time allotted about 21 days before argument (7th Cir. R. 34(b)(1)). Scheduling requests by letter are due no later than seven days after the appellee's brief (7th Cir. R. 34(b)(4)); a motion to waive, postpone or argue remotely no later than 14 days before argument unless good cause is shown (7th Cir. R. 34(e)). An appellee whose brief is late may be denied argument (7th Cir. R. 31(d))."
  edge-argument-decide "Decision" -> decision { authority cite "FRAP 34" }
}

state decision: "Decision Issued" by court cite "FRAP 36; 7th Cir. R. 32.1"
{
  note "The court disposes of an appeal by a published opinion, which is precedent, or by an unsigned nonprecedential order (7th Cir. R. 32.1(b)). On a remand for a new trial the case is reassigned to a different district judge unless the remand order directs or all parties request otherwise (7th Cir. R. 36)."
  edge-decision-issued "Judgment entered" -> rehearing-decision { authority cite "FRAP 36" }
}

decision rehearing-decision: "Rehearing Sought?" by applicant cite "FRAP 40(d)(1)"
{
  note "lit/frap encodes the FRAP 40(d)(1) periods. In an agency case the period runs from the final order or dispositive opinion, not a later formal judgment (7th Cir. R. 40(c)); after a decision from the bench it runs from the written order (7th Cir. R. 40(d))."
  edge-rehearing-decision-none "No petition" -> mandate { authority cite "FRAP 41(b)" }
  edge-rehearing-decision-sought "Petition filed" -> rehearing-order {
    authority cite "FRAP 40(d)(1); 7th Cir. R. 40"
  }
}

state rehearing-order: "Rehearing Order" by court cite "FRAP 40; 7th Cir. R. 40"
{
  note "A request for an answer to a petition for rehearing en banc is made within 14 days of its filing, and the prevailing party answers within 14 days of the request (7th Cir. I.O.P. 5(a))."
  edge-rehearing-order-mandate "Rehearing decided" -> mandate { authority cite "FRAP 41(b)" }
}

state mandate: "Mandate Issued" by office cite "FRAP 41(b); 7th Cir. R. 41"
{
  note "The mandate issues under FRAP 41(b); lit/frap encodes the period. It issues immediately when an appeal is dismissed voluntarily, for failure to pay the docket fee, for failure to file the docketing statement, or for failure to file the appellant's brief (7th Cir. R. 41)."
  edge-mandate-further "Mandate issued" -> further-review { authority cite "FRAP 41(b)" }
}

decision further-review: "Further Review Sought?" by applicant cite "28 U.S.C. § 1254"
{
  note "Certiorari under 28 U.S.C. § 1254; its period is lit/frap's. On a remand from the Supreme Court, counsel file statements of position within 21 days after its judgment issues (7th Cir. R. 54)."
  edge-further-review-none "No further review" -> final-decision {
    authority cite "28 U.S.C. § 1254"
  }
  edge-further-review-petition "Petition for certiorari" -> review-decided {
    authority cite "28 U.S.C. § 1254"
  }
}

state review-decided: "Further Review Decided" by court cite "28 U.S.C. § 1254"
{
  edge-review-decided-denied "Denied" -> review-denied { authority cite "28 U.S.C. § 1254" }
  edge-review-decided-granted "Granted" -> review-granted { authority cite "28 U.S.C. § 1254" }
}

terminal dismissed-jurisdiction: "Dismissed: No Appellate Jurisdiction" outcome [loss, dismissal, jurisdictional] cite "28 U.S.C. § 1291"
terminal dismissed-untimely: "Dismissed: Untimely Notice" outcome [loss, dismissal] cite "FRAP 4(a)(1)(A)"
terminal dismissed-prosecution: "Dismissed: Failure to Prosecute" outcome [loss, dismissal] cite "7th Cir. I.O.P. 7(a)"
terminal final-decision: "Final: Decision Stands" outcome [final] cite "FRAP 41(b)"
terminal review-denied: "Further Review Denied" outcome [final] cite "28 U.S.C. § 1254"

terminal review-granted: "Further Review Granted" outcome [neutral] cite "28 U.S.C. § 1254"
{
  note "Certiorari granted; the merits are not modeled."
}
