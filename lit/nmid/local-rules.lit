module nmid-local-rules.local-rules

import core.frcp6.{ frcp6 }

// The District Court for the Northern Mariana Islands' own periods,
// computed under the federal rules: LR 6.1 makes FRCP 6(a) govern
// computation of time under the Local Rules. Rules that state no period or
// limit, or state one this layer cannot count, stay out: the two business
// days to cure a format nonconformity (LR 5.2) and to request a remote
// appearance (LR 83.4(b)), the case management conference set
// "approximately thirty-five (35) days" after the order (LR 16.2(a)), the
// track discovery guidelines (LR 16.1(b), counts of interrogatories and
// requests, not paper limits), the six months of inaction after which the
// court may order cause shown (LR 41.1), the criminal-case review and
// unsealing periods (LR 72.4(e), 79.2(c)(1)-(4)), and the attorney
// admission and renewal fees and notices (LR 83.5). The FRCP 26(f)
// conference at least 21 days before the case management conference (LR
// 16.2(b)) is the FRCP's own period and stays in lit/frcp. The earlier
// D.N.M.I. outline's FRCP flow and its Supreme Court decisions (Twombly,
// Iqbal, Celotex, Anderson v. Liberty Lobby, Reeves, Catlin, Bowles,
// Hamer) are FRCP and FRAP authority and belong to lit/frcp and lit/frap;
// its Ninth Circuit decisions (Eitel v. McCool; Lopez v. Smith) are
// removed: no reporter text is vendored.
/// A brief or memorandum supporting or opposing a motion: at most 25
/// pages; one over 10 pages has a table of contents and a table of
/// authorities, and a party wishing to exceed the limit first moves to do
/// so (LR 7.1(d)(1)).
limit motion-memorandum { pages <= 25 cite "D.N.M.I. LR 7.1(d)" } cite "D.N.M.I. LR 7.1(d)"
/// A reply memorandum: at most 10 pages (LR 7.1(d)(1)).
limit reply-memorandum { pages <= 10 cite "D.N.M.I. LR 7.1(d)" } cite "D.N.M.I. LR 7.1(d)"

// A memorandum on a written discovery motion may not exceed "two
// typewritten, double-spaced pages" (LR 26.2(a)(4)(A)); it stays a note,
// not a `limit`: the rule states typewritten pages, a form the limit check
// does not read.
/// A motion that is not a non-hearing motion is filed and noticed for
/// hearing (LR 7.1(b)(1), (c)(1)).
event MotionFiled() paper motion-memorandum
/// A motion is served (LR 7.1(c)(2)).
event MotionServed() paper motion-memorandum
/// An opposition, or statement of non-opposition, is served (LR
/// 7.1(c)(2), (3)).
event OppositionServed() paper motion-memorandum
/// The movant's reply is served and filed (LR 7.1(c)(3)).
event ReplyFiled() paper reply-memorandum
/// A defendant appears (LR 16.2(a)).
event DefendantAppeared()
/// The case management conference is held (LR 16.2(b)).
event CaseManagementConferenceHeld()
/// Trial in an Expedited or Standard Track case begins (LR 16.1(b)(1)).
event TrackTrialBegins()
/// The scheduled trial date arrives (LR 16.5, 16.6, 54.2).
event TrialBegins()
/// In a jury trial, the plaintiff files and serves proposed voir dire
/// questions and jury instructions (LR 16.5(a)(2)).
event PlaintiffJuryInstructionsFiled()
/// An adverse party demands that a nonresident plaintiff file a bond for
/// costs (LR 62.1(a)).
event CostBondDemanded()
/// A party is served with the order to show cause on the appointment of a
/// permanent receiver (LR 63.1(a)(2)).
event ReceivershipOrderServed()
/// The hearing on the order to show cause for a permanent receiver is held
/// (LR 63.1(a)(2)).
event ReceivershipHearingHeld()
/// A permanent receiver is appointed (LR 63.1(f)).
event PermanentReceiverAppointed()
/// The hearing on the receiver's petition for instructions is held (LR
/// 63.1(f)).
event InstructionsPetitionHearingHeld()
/// A hearing on a receiver's dividends, sales, reports or fee applications
/// is held (LR 63.1(g)).
event ReceivershipMatterHearingHeld()
/// The time for filing a notice of appeal expires with no notice filed (LR
/// 79.1(b)(1)).
event AppealTimeExpired()
/// The Court of Appeals' mandate issues (LR 79.1(b)(2)).
event MandateIssued()
/// The time set for removing exhibits arrives (LR 79.1(c)).
event ExhibitRemovalTimeArrived()
/// A sealing order, other than for a criminal warrant, indictment or
/// complaint, is entered (LR 79.2(c)(5)).
event SealingOrderEntered()
/// An attorney temporarily admitted as a government or legal services
/// attorney leaves that employment (LR 83.5(d)(3)).
event QualifyingEmploymentEnded()

/// LR 7.1(b)(1), (c)(1): a motion, other than a non-hearing motion, a
/// temporary restraining order application or a motion made during trial
/// or hearing, is noticed for hearing not less than 34 days after filing;
/// unless the parties arrange another date with the docket clerk, it is
/// heard on the first Thursday not less than 34 days after filing. The
/// date is the earliest hearing date, not a filing deadline.
deadline earliest-hearing-date: 34.days after MotionFiled() counted_by frcp6 cite "D.N.M.I. LR 7.1(b)"
/// LR 7.1(c)(2): the opposing party files an opposition, or a statement of
/// non-opposition, no later than 14 days after the motion is served. An
/// untimely opposition may be disregarded and stricken, and failure to
/// oppose may be deemed an admission that the motion is meritorious.
deadline opposition-period: 14.days after MotionServed() counted_by frcp6 cite "D.N.M.I. LR 7.1(c)"
/// LR 7.1(c)(3): the movant serves and files any reply no later than 7
/// days after the opposition is served; no further filing is accepted
/// without leave (LR 7.1(c)(4)).
deadline reply-period: 7.days after OppositionServed() counted_by frcp6 cite "D.N.M.I. LR 7.1(c)"
/// LR 16.2(a): except in exempt cases or for good cause, the court issues
/// an order setting the case management conference within 14 days after
/// any defendant has appeared.
deadline cmc-order-period: 14.days after DefendantAppeared() counted_by frcp6 cite "D.N.M.I. LR 16.2(a)"
/// LR 16.2(b): the parties file a joint case management statement not
/// less than 7 days before the case management conference.
deadline joint-cmc-statement-period: 7.days before CaseManagementConferenceHeld() counted_by frcp6 cite "D.N.M.I. LR 16.2(b)"
/// LR 16.1(b)(1)(A), (B): an Expedited or Standard Track case has a
/// discovery cut-off no later than 60 days before trial; a Complex Track
/// case's cut-off is set by the Case Management Scheduling Order.
deadline track-discovery-cutoff: 60.days before TrackTrialBegins() counted_by frcp6 cite "D.N.M.I. LR 16.1(b)"
/// LR 16.5(a)(1)-(3): unless the judge otherwise orders, not less than 14
/// days before the scheduled trial date each party serves and files briefs
/// on the significant disputed issues of law, the plaintiff in a jury
/// trial files and serves proposed voir dire questions and jury
/// instructions, and the parties exchange their pre-marked trial exhibits.
deadline pretrial-filings-period: 14.days before TrialBegins() counted_by frcp6 cite "D.N.M.I. LR 16.5(a)"
/// LR 16.5(a)(2): the defendant files and serves any additional or
/// different proposed jury instructions seven days after the plaintiff's;
/// the rule's "after" is read as after the plaintiff's filing.
deadline defendant-jury-instructions-period: 7.days after PlaintiffJuryInstructionsFiled() counted_by frcp6 cite "D.N.M.I. LR 16.5(a)"
/// LR 16.5(a)(4)(B): at least 28 days before trial commences, the
/// proponent of a foreign language document serves the translation, the
/// document and the translator's affidavit; absent good cause, failure
/// renders both inadmissible (LR 16.5(a)(4)(D)).
deadline translation-service-period: 28.days before TrialBegins() counted_by frcp6 cite "D.N.M.I. LR 16.5(a)"
/// LR 16.5(a)(4)(C): at least 14 days before trial commences, a party
/// serves written objections to the accuracy of a translation; absent good
/// cause, failure waives the objection (LR 16.5(a)(4)(D)).
deadline translation-objection-period: 14.days before TrialBegins() counted_by frcp6 cite "D.N.M.I. LR 16.5(a)"
/// LR 16.6(a): under FRCP 16(e), a final pretrial conference is held not
/// later than 7 days before the scheduled trial date, unless the court and
/// counsel deem it unnecessary.
deadline final-pretrial-conference-period: 7.days before TrialBegins() counted_by frcp6 cite "D.N.M.I. LR 16.6(a)"
/// LR 54.2: when a civil action set for jury trial settles or is otherwise
/// disposed of before trial, juror costs are assessed against the parties,
/// except for good cause, unless the Clerk's Office is notified in writing
/// at least 14 days before the day the action is scheduled for trial.
deadline juror-cost-notice-period: 14.days before TrialBegins() counted_by frcp6 cite "D.N.M.I. LR 54.2"
/// LR 62.1(a): a nonresident plaintiff files a bond for costs of $500
/// within 10 days after an adverse party's demand, unless the court
/// dispenses with the bond or fixes a different amount; if a sufficient
/// bond ordered is not filed, the clerk enters dismissal.
deadline nonresident-cost-bond-period: 10.days after CostBondDemanded() counted_by frcp6 cite "D.N.M.I. LR 62.1(a)"
/// LR 63.1(a)(2): the defendant provides the temporary receiver (or, if
/// none, the plaintiff) a list of its creditors and their addresses within
/// 7 days after being served with the order to show cause.
deadline creditor-list-period: 7.days after ReceivershipOrderServed() counted_by frcp6 cite "D.N.M.I. LR 63.1(a)"
/// LR 63.1(a)(2): not less than 5 days before the hearing, the temporary
/// receiver (or, if none, the plaintiff) mails the listed creditors notice
/// of the hearing and files proof of mailing.
deadline creditor-hearing-notice-period: 5.days before ReceivershipHearingHeld() counted_by frcp6 cite "D.N.M.I. LR 63.1(a)"
/// LR 63.1(f): within 28 days of appointment, a permanent receiver files a
/// verified report and petition for instructions.
deadline receiver-report-period: 28.days after PermanentReceiverAppointed() counted_by frcp6 cite "D.N.M.I. LR 63.1(f)"
/// LR 63.1(f): the petition for instructions is heard on 7 days' notice to
/// all known creditors and parties.
deadline instructions-petition-notice-period: 7.days before InstructionsPetitionHearingHeld() counted_by frcp6 cite "D.N.M.I. LR 63.1(f)"
/// LR 63.1(g): the receiver gives all interested parties at least 10 days'
/// notice of hearings on dividends, confirmation of sales, the receiver's
/// reports, and fee applications.
deadline receivership-hearing-notice-period: 10.days before ReceivershipMatterHearingHeld() counted_by frcp6 cite "D.N.M.I. LR 63.1(g)"
/// LR 79.1(b)(1): unless the court permits otherwise, an exhibit in the
/// clerk's custody is not removed earlier than 14 days after the time for
/// filing a notice of appeal expires, if no notice is filed. The date is
/// the earliest removal date.
deadline exhibit-removal-no-appeal: 14.days after AppealTimeExpired() counted_by frcp6 cite "D.N.M.I. LR 79.1(b)"
/// LR 79.1(b)(2): if an appeal was taken, an exhibit is not removed
/// earlier than 14 days after the mandate issues. The date is the earliest
/// removal date.
deadline exhibit-removal-after-mandate: 14.days after MandateIssued() counted_by frcp6 cite "D.N.M.I. LR 79.1(b)"
/// LR 79.1(c): unless the court directs otherwise, the clerk may destroy
/// or dispose of exhibits not reclaimed within 21 days after the time set
/// for removal.
deadline unclaimed-exhibit-period: 21.days after ExhibitRemovalTimeArrived() counted_by frcp6 cite "D.N.M.I. LR 79.1(c)"
/// LR 79.2(c)(5): unless the court orders otherwise, the clerk unseals
/// sealed documents, other than the criminal ones LR 79.2(c)(1)-(4) name,
/// 120 days from entry of the sealing order, unless the order provides
/// otherwise.
deadline unsealing-period: 120.days after SealingOrderEntered() counted_by frcp6 cite "D.N.M.I. LR 79.2(c)"
/// LR 83.5(d)(3): an attorney temporarily admitted under LR 83.5(d)(1)
/// notifies the clerk in writing of the end of the qualifying employment
/// within 14 days.
deadline temporary-admission-termination-notice: 14.days after QualifyingEmploymentEnded() counted_by frcp6 cite "D.N.M.I. LR 83.5(d)"

test "earliest hearing date: 34 days after the trigger" cite "D.N.M.I. LR 7.1(b)"
{
  given MotionFiled() on 2026-11-02
  expect deadline(earliest-hearing-date) == 2026-12-07
}

test "opposition period: 14 days after the trigger" cite "D.N.M.I. LR 7.1(c)"
{
  given MotionServed() on 2026-11-02
  expect deadline(opposition-period) == 2026-11-16
}

test "reply period: 7 days after the trigger" cite "D.N.M.I. LR 7.1(c)"
{
  given OppositionServed() on 2026-11-02
  expect deadline(reply-period) == 2026-11-09
}

test "cmc order period: 14 days after the trigger" cite "D.N.M.I. LR 16.2(a)"
{
  given DefendantAppeared() on 2026-11-02
  expect deadline(cmc-order-period) == 2026-11-16
}

test "joint cmc statement period: 7 days before the trigger" cite "D.N.M.I. LR 16.2(b)"
{
  given CaseManagementConferenceHeld() on 2027-03-02
  expect deadline(joint-cmc-statement-period) == 2027-02-23
}

test "track discovery cutoff: 60 days before the trigger" cite "D.N.M.I. LR 16.1(b)"
{
  given TrackTrialBegins() on 2027-03-02
  expect deadline(track-discovery-cutoff) == 2026-12-31
}

test "pretrial filings period: 14 days before the trigger" cite "D.N.M.I. LR 16.5(a)"
{
  given TrialBegins() on 2027-03-02
  expect deadline(pretrial-filings-period) == 2027-02-16
}

