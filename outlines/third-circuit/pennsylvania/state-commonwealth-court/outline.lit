// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-pa-commonwealth-court

import pa-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start notice

decision notice: "Notice of appeal within time?" by applicant cite ?("Pa.R.A.P. 1512 (verify)")
{
  note "OUTLINE. The Commonwealth Court hears petitions for review of state agency orders, appeals from the common pleas courts in government matters (42 Pa.C.S. § 762), and original-jurisdiction actions against the Commonwealth (42 Pa.C.S. § 761) (verify). Appeal to the Commonwealth Court of Pennsylvania: appealability, the notice period and service are holes. Leading decisions: not yet identified in this pass; verify before use."
  edge-notice-late "No timely notice" -> dismissed-untimely { authority cite ?("Pa.R.A.P. 1512 (verify)") }
  edge-notice-filed "Timely notice" -> record { event NoticeOfAppealFiled() authority cite ?("Pa.R.A.P. 1512 (verify)") }
}

state record: "Record or transcript prepared" by office cite ?("Pa.R.A.P. 1951 (verify)")
{
  note "OUTLINE. Record contents, transcript and fees are holes."
  edge-record-briefing "Record filed" -> briefing { event RecordFiled() authority cite ?("Pa.R.A.P. 1951 (verify)") }
}

state briefing: "Briefs filed" by applicant cite ?("Pa.R.A.P. 2185 (verify)")
{
  note "OUTLINE. Briefing periods, form and length are holes."
  edge-briefing-argument "Argument or submission" -> argument { authority cite ?("Pa.R.A.P. 2315 (verify)") }
}

state argument: "Argument or submission" by court cite ?("Pa.R.A.P. 2315 (verify)")
{
  note "OUTLINE. Argument may be discretionary."
  edge-argument-decision "Decision issued" -> decision { authority cite ?("42 Pa.C.S. § 763 (verify)") }
}

chance decision: "Court decides" by court cite ?("42 Pa.C.S. § 763 (verify)")
{
  note "OUTLINE. Outcome probabilities are holes."
  edge-decision-affirmed "Affirmed" -> post-decision p ? { event DecisionFiled() }
  edge-decision-reversed "Reversed, vacated or remanded" -> post-decision p ? { event DecisionFiled() }
}

decision post-decision: "Rehearing or further review?" by applicant cite ?("Pa.R.A.P. 1112 (verify)")
{
  note "OUTLINE. Rehearing and further-review periods are holes."
  edge-post-mandate "No further review" -> mandate-issued { event MandateIssued() authority cite ?("Pa.R.A.P. 2572 (verify)") }
  edge-post-further "Further review sought" -> further-review { event ReviewPetitionFiled() authority cite ?("Pa.R.A.P. 1112 (verify)") }
}

terminal dismissed-untimely: "Dismissed: no timely notice" outcome [loss, dismissal] cite ?("Pa.R.A.P. 1512 (verify)")
{
  note "OUTLINE. Whether the time limit is jurisdictional is a hole."
  payoff ?
}

terminal mandate-issued: "Mandate or remittitur issued" outcome [final] cite ?("Pa.R.A.P. 2572 (verify)")
{
  note "OUTLINE. The case returns to the court below; costs are holes."
  payoff ?
}

terminal further-review: "Further review sought in a higher court" outcome [final] cite ?("Pa.R.A.P. 1112 (verify)")
{
  note "OUTLINE. Review in the higher court is its own package."
  payoff ?
}
