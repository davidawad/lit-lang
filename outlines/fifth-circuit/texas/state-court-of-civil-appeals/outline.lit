// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-tx-court-of-civil-appeals

import outline-tx-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start notice

decision notice: "Notice of appeal within time?" by applicant cite ?("Tex. Const. art. V, § 6 (1891) (verify)")
{
  note "OUTLINE. Historical court: the Courts of Civil Appeals became the Courts of Appeals on September 1, 1981, when they gained criminal jurisdiction (verify). Appeal to the Court of Civil Appeals of Texas: appealability, the notice period and service are holes. Leading decisions: not yet identified in this pass; verify before use."
  edge-notice-late "No timely notice" -> dismissed-untimely { authority cite ?("Tex. Const. art. V, § 6 (1891) (verify)") }
  edge-notice-filed "Timely notice" -> record { event NoticeOfAppealFiled() authority cite ?("Tex. Const. art. V, § 6 (1891) (verify)") }
}

state record: "Record or transcript prepared" by office cite ?("Tex. R. Civ. P. (1941) (verify)")
{
  note "OUTLINE. Record contents, transcript and fees are holes."
  edge-record-briefing "Record filed" -> briefing { event RecordFiled() authority cite ?("Tex. R. Civ. P. (1941) (verify)") }
}

state briefing: "Briefs filed" by applicant cite ?("Tex. R. Civ. P. (1941) (verify)")
{
  note "OUTLINE. Briefing periods, form and length are holes."
  edge-briefing-argument "Argument or submission" -> argument { authority cite ?("Tex. R. Civ. P. (1941) (verify)") }
}

state argument: "Argument or submission" by court cite ?("Tex. R. Civ. P. (1941) (verify)")
{
  note "OUTLINE. Argument may be discretionary."
  edge-argument-decision "Decision issued" -> decision { authority cite ?("Tex. R. Civ. P. (1941) (verify)") }
}

chance decision: "Court decides" by court cite ?("Tex. R. Civ. P. (1941) (verify)")
{
  note "OUTLINE. Outcome probabilities are holes."
  edge-decision-affirmed "Affirmed" -> post-decision p ? { event DecisionFiled() }
  edge-decision-reversed "Reversed, vacated or remanded" -> post-decision p ? { event DecisionFiled() }
}

decision post-decision: "Rehearing or further review?" by applicant cite ?("Tex. R. Civ. P. (1941) (verify)")
{
  note "OUTLINE. Rehearing and further-review periods are holes."
  edge-post-mandate "No further review" -> mandate-issued { event MandateIssued() authority cite ?("Tex. R. Civ. P. (1941) (verify)") }
  edge-post-further "Further review sought" -> further-review { event ReviewPetitionFiled() authority cite ?("Tex. R. Civ. P. (1941) (verify)") }
}

terminal dismissed-untimely: "Dismissed: no timely notice" outcome [loss, dismissal] cite ?("Tex. Const. art. V, § 6 (1891) (verify)")
{
  note "OUTLINE. Whether the time limit is jurisdictional is a hole."
  payoff ?
}

terminal mandate-issued: "Mandate or remittitur issued" outcome [final] cite ?("Tex. R. Civ. P. (1941) (verify)")
{
  note "OUTLINE. The case returns to the court below; costs are holes."
  payoff ?
}

terminal further-review: "Further review sought in a higher court" outcome [final] cite ?("Tex. R. Civ. P. (1941) (verify)")
{
  note "OUTLINE. Review in the higher court is its own package."
  payoff ?
}
