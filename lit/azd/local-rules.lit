{
  given BillOfCostsServed() on 2026-11-02
  expect deadline(costs-objection-period) == 2026-11-16
}

test "taxation review period: 7 days after the trigger" cite "D. Ariz. LRCiv 54.1"
{
  given TaxationNoticeSent() on 2026-11-02
  expect deadline(taxation-review-period) == 2026-11-09
}

test "fee motion period: 14 days after the trigger" cite "D. Ariz. LRCiv 54.2"
{
  given FinalJudgmentEntered() on 2026-11-02
  expect deadline(fee-motion-period) == 2026-11-16
}

test "summary judgment response period: 30 days after the trigger" cite "D. Ariz. LRCiv 56.1"
{
  given SummaryJudgmentMotionServed() on 2026-11-02
  expect deadline(summary-judgment-response-period) == 2026-12-02
}

test "summary judgment reply period: 15 days after the trigger" cite "D. Ariz. LRCiv 56.1"
{
  given SummaryJudgmentResponseServed() on 2026-11-02
  expect deadline(summary-judgment-reply-period) == 2026-11-17
}

