module core.states.texas

import core.calendar.{ us-federal-holidays }

/// The legal holidays of Texas (Tex. Gov't Code § 662.021) that
/// `us-federal-holidays` does not already close: the state holidays of §
/// 662.003(b)(1)-(3), (5) and (6), Confederate Heroes Day (January 19), Texas
/// Independence Day (March 2), San Jacinto Day (April 21), Lyndon Baines
/// Johnson Day (August 27) and the Friday after Thanksgiving (Emancipation Day,
/// June 19, is a federal day too). No section of the vendored subchapter moves
/// a weekend holiday. The Friday after Thanksgiving is listed with `once` from
/// the date the vendored text was retrieved (October 29, 2026) to the end of
/// 2050. Not modeled: December 24 and 26 (§ 662.003(b)(7), (8)) and the
/// optional holidays of § 662.003(c), which § 662.021 does not make legal
/// holidays.
calendar texas-holidays cite "Tex. Gov't Code § 662.021"
{
  confederate-heroes-day: fixed(1, 19) effective [2026-10-29, ..)
  texas-independence-day: fixed(3, 2) effective [2026-10-29, ..)
  san-jacinto-day: fixed(4, 21) effective [2026-10-29, ..)
  lyndon-baines-johnson-day: fixed(8, 27) effective [2026-10-29, ..)
  day-after-thanksgiving-2026: once(2026-11-27) effective [2026-10-29, ..)
  day-after-thanksgiving-2027: once(2027-11-26) effective [2026-10-29, ..)
  day-after-thanksgiving-2028: once(2028-11-24) effective [2026-10-29, ..)
  day-after-thanksgiving-2029: once(2029-11-23) effective [2026-10-29, ..)
  day-after-thanksgiving-2030: once(2030-11-29) effective [2026-10-29, ..)
  day-after-thanksgiving-2031: once(2031-11-28) effective [2026-10-29, ..)
  day-after-thanksgiving-2032: once(2032-11-26) effective [2026-10-29, ..)
  day-after-thanksgiving-2033: once(2033-11-25) effective [2026-10-29, ..)
  day-after-thanksgiving-2034: once(2034-11-24) effective [2026-10-29, ..)
  day-after-thanksgiving-2035: once(2035-11-23) effective [2026-10-29, ..)
  day-after-thanksgiving-2036: once(2036-11-28) effective [2026-10-29, ..)
  day-after-thanksgiving-2037: once(2037-11-27) effective [2026-10-29, ..)
  day-after-thanksgiving-2038: once(2038-11-26) effective [2026-10-29, ..)
  day-after-thanksgiving-2039: once(2039-11-25) effective [2026-10-29, ..)
  day-after-thanksgiving-2040: once(2040-11-23) effective [2026-10-29, ..)
  day-after-thanksgiving-2041: once(2041-11-29) effective [2026-10-29, ..)
  day-after-thanksgiving-2042: once(2042-11-28) effective [2026-10-29, ..)
  day-after-thanksgiving-2043: once(2043-11-27) effective [2026-10-29, ..)
  day-after-thanksgiving-2044: once(2044-11-25) effective [2026-10-29, ..)
  day-after-thanksgiving-2045: once(2045-11-24) effective [2026-10-29, ..)
  day-after-thanksgiving-2046: once(2046-11-23) effective [2026-10-29, ..)
  day-after-thanksgiving-2047: once(2047-11-29) effective [2026-10-29, ..)
  day-after-thanksgiving-2048: once(2048-11-27) effective [2026-10-29, ..)
  day-after-thanksgiving-2049: once(2049-11-26) effective [2026-10-29, ..)
  day-after-thanksgiving-2050: once(2050-11-25) effective [2026-10-29, ..)
}

/// FRCP 6 in the district courts of Texas: the 2023 text
/// (`frcp6@2023-12-01`) with `texas-holidays`, which 6(a)(6)(C)
/// ("any day declared a holiday by ... the state where the district court
/// is located") makes legal holidays "for periods that are measured after
/// an event" only. A district package there names it as its `counting`
/// rule and `recounts` lit/frcp. A calendar day is closed only from the
/// date its entry is in force; before it the count is `frcp6`'s.
counting frcp6-texas effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCP 6(d)"
  holidays us-federal-holidays
  forward_holidays texas-holidays cite "FRCP 6(a)(6)(C)"
  forums [frcp]
  allow_hours
  end_of_month clamp
}

/// FRBP 9006(a) (`frbp9006`) in the bankruptcy courts of Texas:
/// `texas-holidays` are legal holidays for a period counted forward only (FRBP
/// 9006(a)(6)(C), "any day declared a holiday by the state where the
/// district court is located"). A bankruptcy package there names it as its
/// `counting` rule and `recounts` lit/frbp. A calendar day is closed only
/// from the date its entry is in force.
counting frbp9006-texas effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays texas-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-txe, bankr-txn, bankr-txs, bankr-txw]
  allow_hours
  end_of_month clamp
}
