# The FRAP 4(a) periods at ca6: the base layer with the 2005 and 2009
# amendments (docs/litigate/change; versions selected by each trigger's
# date). The Supreme Court's holding binds in every circuit, so every
# circuit world gives the same values.
layers = ["change-deadline-frap-base", "change-deadline-frap-2005-amendment", "change-deadline-frap-2009-amendment"]

[location]
family = "circuit-appellate"
circuit = "ca6"
