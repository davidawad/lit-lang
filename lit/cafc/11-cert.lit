// Certiorari to the Supreme Court. The Supreme Court Rules are not vendored
// under sources/, so their cites stay holes carrying the pack's text.
module cafc.cert

import cafc.{ Entered, Filed, Order, Paper, cert-group }
import core.supct30.{ sup-ct-30 }

decision cert-petition-window: "Certiorari Petition Window" by applicant cite "28 U.S.C. § 2101(c); Sup. Ct. R. 13.1, 13.3"
{
  group cert-group
  cert-window-file "File petition for certiorari" -> cert-petition-filed {
    authority cite "28 U.S.C. § 2101(c); Sup. Ct. R. 13.1, 13.3"
    effort 150.hours
    cost 15_000.usd
    event Filed(CertPetition)
    within cert-period {
      extendable true
      extension_authority "Sup. Ct. R. 13.5 (single application to a Circuit Justice, before the deadline, for good cause)"
      note "90 days from entry of judgment or from denial of a timely rehearing petition."
    }
    tags [appeal]
  }
  cert-window-lapse "90-day window lapses" -> cert-not-sought { authority cite "Sup. Ct. R. 13.1" }
}

terminal cert-not-sought: "FINAL — Certiorari Not Sought" outcome [final] cite "Sup. Ct. R. 13.1"
{
  group cert-group
  note "Not seeking certiorari leaves the panel's disposition undisturbed, so this restores whatever the panel actually decided (panel-decision's own panel-to-affirmed/panel-to-reversed/panel-to-mixed edges `sets` the matching flag, carried forward through rehearing/mandate by the state-flag product graph — docs/PACK_SCHEMA.md#state-flags). `payoff: 0` is the fallback only when this terminal is reached with none of those flags set (e.g. a direct scenario.start here). See docs/CRITIQUE.md and cafc-SOURCES-NOTES.md."
  valence good
  payoff 0.usd
  payoff_by_flag { panel-affirmed: 0.usd, panel-mixed: 250_000.usd, panel-reversed: 1_000_000.usd }
}

state cert-petition-filed: "Petition for Certiorari Filed" by office cite ?("Sup. Ct. R. 10; 28 U.S.C. § 1254(1)") {
  group cert-group
  cert-filed-to-review "Supreme Court considers the petition" -> cert-review-decision {
    authority cite ?("Sup. Ct. R. 10")
  }
}

/// A tribunal-discretion draw. It stays a `decision` by `office`, as in the
/// pack, because a `chance` node lowers to kind `state`; its probabilities
/// are the pack's, with their bases in each edge's note.
chance cert-review-decision: "Supreme Court Grants or Denies Certiorari" by office discretion cite ?("Sup. Ct. R. 10") {
  group cert-group
  cert-review-deny "Certiorari denied" -> cert-denied p 0.99 {
    authority cite ?("Sup. Ct. R. 10")
    note "Widely cited SCOTUS-wide grant rate of roughly 1% of petitions (rule of four, Sup. Ct. R. 10); not Federal-Circuit-specific. Carried over from frap-appellate-procedure.json's identical figure."
  }
  cert-review-grant "Certiorari granted" -> cert-granted p 0.01 {
    authority cite ?("28 U.S.C. § 1254(1); Sup. Ct. R. 10")
    note "See cert-review-deny's note — same source and basis."
  }
}

terminal cert-denied: "CERT DENIED (Final)" outcome [final] cite ?("Sup. Ct. R. 10") {
  group cert-group
  note "Denial of certiorari is not a ruling on the merits and carries zero precedential weight — the Federal Circuit's judgment simply stands, so payoffByFlag restores whatever the panel actually decided, same mechanism and rationale as cert-not-sought."
  valence good
  payoff 0.usd
  payoff_by_flag { panel-affirmed: 0.usd, panel-mixed: 250_000.usd, panel-reversed: 1_000_000.usd }
}

terminal cert-granted: "CERT GRANTED — Case Transfers to the Supreme Court" outcome [remand] cite ?("28 U.S.C. § 1254(1); Sup. Ct. R. 10") {
  group cert-group
  note "This pack's jurisdiction over the case ends here; payoff is a neutral placeholder, not a merits prediction about the eventual Supreme Court disposition."
  valence good
  payoff 0.usd
}

/// A Justice's order extending the time to file the petition to `until`
/// (28 U.S.C. § 2101(c)).
event CertPeriodExtended(until: Date) extends cert-period to until
/// An application to a Justice to extend the time to file the petition.
event CertExtensionApplied()
/// A Justice's denial of the application, which "may not be renewed"
/// (Sup. Ct. R. 30.3).
event CertExtensionDenied()

/// 28 U.S.C. § 2101(c): a petition for certiorari in a civil case is due 90
/// days after entry of the judgment. The period dates from the 1948
/// recodification of Title 28 (Act of June 25, 1948, effective September 1,
/// 1948). It is a period of the Supreme Court's Rules, counted by Sup. Ct.
/// R. 30.1 (`core.supct30`), not by FRAP 26; that rule's vendored text is
/// in force from January 1, 2023, so an earlier entry has no counting rule.
///
/// "A justice of the Supreme Court, for good cause shown, may extend the
/// time for applying for a writ of certiorari for a period not exceeding
/// sixty days" (§ 2101(c)): a Justice is the only extender, so no court or
/// case order may move it (no `delegable_to`). The application's timing
/// is `frap.cert`'s reading of Sup. Ct. R. 13.5, 30.2 and 30.3: for good
/// cause when made at least 10 days before the due date, on extraordinary
/// circumstances when made later within the period, and never once
/// denied.
rule duty certiorari-petition cite "28 U.S.C. § 2101(c)"
{
  deadline cert-period: 90.days after Entered(PanelJudgment) counted_by sup-ct-30 effective [1948-09-01, ..) known_at 1948-06-25 cite "28 U.S.C. § 2101(c)"
  {
    forum scotus
    extend {
      by justice
      discretion GoodCause
      max 60.days
      on CertExtensionApplied()
      within current_due - 10.days
      unless CertExtensionDenied()
    }
    extend {
      by justice
      discretion ExtraordinaryCircumstances
      max 60.days
      on CertExtensionApplied()
      within current_due
      unless CertExtensionDenied()
    }
  }
}

test "a certiorari petition is due 90 days after entry of judgment" cite "28 U.S.C. § 2101(c)"
{
  given Entered(PanelJudgment) on 2026-04-08
  expect deadline(cert-period) == 2026-07-07
}

test "a Sunday 90th day rolls the certiorari petition to Monday" cite "Sup. Ct. R. 30.1"
{
  given Entered(PanelJudgment) on 2026-03-02
  expect deadline(cert-period) == 2026-06-01
}
