            }
          },
          "observed": "nearest-weekday",
          "effective": {
            "from": "1870-06-28"
          }
        }
      ]
    }
  ],
  "countingRules": [
    {
      "id": "frcp6",
      "label": "FRCP 6(a)",
      "sourceUrl": "https://www.law.cornell.edu/rules/frcp",
      "closedWeekdays": [
        "saturday",
        "sunday"
      ],
      "holidays": [
        "federal-holidays"
      ],
      "steps": [
        {
          "op": "anchor",
          "kind": "trigger",
          "text": "FRCP 6(a): exclude the trigger date {trigger}"
        },
        {
          "op": "count",
          "periods": [
            {
              "unit": "calendar",
              "count": "calendar",
              "text": "FRCP 6(a): count {n} calendar day(s) {after} the anchor -> {date}"
            },
            {
              "unit": "court",
              "count": "business",
              "text": "FRCP 6(a): count {n} court day(s) {forward}, skipping weekends and holidays -> {date}"
            }
          ]
        },
        {
          "op": "roll",
          "forward": {
            "toward": "later",
            "text": "FRCP 6(a): the last day is a weekend or legal holiday; roll forward -> {date}"
          },
          "backward": {
            "toward": "earlier",
            "text": "FRCP 6(a): the last day is a weekend or legal holiday; roll backward -> {date}"
          }
        },
        {
          "op": "base"
        },
        {
          "op": "service",
          "methods": [
            {
              "method": "personal",
              "days": 0
            },
            {
              "method": "electronic",
              "days": 0
            },
            {
              "method": "mail",
              "days": 3
            }
          ],
          "unrecognized": [
            "clerk",
            "other-consented",
            "commercial-carrier",
            "prison-mail",
            "mail-foreign",
            "express",
            "express-foreign"
          ],
          "text": "FRCP 6(a): service by {method} adds {days} day(s) -> {date}",
          "backwardText": "FRCP 6(a): service extensions apply to forward periods only; ignored"
        },
        {
          "op": "roll",
          "forward": {
            "toward": "later",
            "text": "FRCP 6(a): the last day is a weekend or legal holiday; roll forward -> {date}"
          },
          "backward": {
            "toward": "earlier",
            "text": "FRCP 6(a): the last day is a weekend or legal holiday; roll backward -> {date}"
          }
        },
        {
          "op": "clerkInaccessible",
          "text": "FRCP 6(a): the clerk's office is inaccessible on the last day; extend -> {date}",
          "ignoredText": "FRCP 6(a): no inaccessibility extension applies; ignored"
        }
      ],
      "hours": {
        "text": "FRCP 6(a): count every hour from the trigger; +{n} hour(s)",
        "rollText": "FRCP 6(a): the period ends on a weekend or legal holiday; continue to the same time on {date}",
        "inaccessibleText": "FRCP 6(a): the clerk's office is inaccessible during the last hour; extend to the same time on {date}"
      }
    }
  ]
}
