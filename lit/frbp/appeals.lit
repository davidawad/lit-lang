  given BankruptcyOrderEntered() on 2026-03-03
  given NoticeOfAppealFiled() on 2026-03-10
  expect deadline(cross-notice-period) == 2026-03-24
}

test "a cross-notice is never due before the notice period ends" cite "FRBP 8002(a)(3)"
{
  given BankruptcyOrderEntered() on 2026-03-03
  given NoticeOfAppealFiled() on 2026-03-03
  expect deadline(cross-notice-period) == 2026-03-17
}
