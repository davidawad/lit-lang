// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.

module outline-ca9-bap

start notice-filed

state notice-filed: "Notice of Appeal Filed" by applicant cite ?("Fed. R. Bankr. P. 8002(a)(1)")
{
  note "Notice period is a hole. Verify Bankruptcy Rule 8002 timing."
  edge-notice-filed-appealability "Timely notice" -> appealability {
    authority cite ?("Fed. R. Bankr. P. 8002(a)(1)")
  }
  edge-notice-filed-dismissed-untimely "Late or defective notice" -> dismissed-untimely {
    authority cite ?("Fed. R. Bankr. P. 8002(a)(1)")
  }
}

terminal dismissed-untimely: "Dismissed as untimely" outcome [loss] cite ?("Fed. R. Bankr. P. 8002(a)(1)")
{
  note "Dismissal for untimely notice. Verify."
  payoff ?
}

decision appealability: "Appealable Order or Judgment" by court cite ?("28 U.S.C. § 158(a)")
{
  note "Appeal from final or leave-granted interlocutory order: 28 U.S.C. 158(a). Verify."
  edge-appealability-dismissed-jurisdiction "Not appealable" -> dismissed-jurisdiction {
    authority cite ?("28 U.S.C. § 158(a)")
  }
  edge-appealability-record-assembled "Appealable" -> record-assembled {
    authority cite ?("28 U.S.C. § 158(a)")
  }
}

terminal dismissed-jurisdiction: "Dismissed for lack of appealable order" outcome [loss] cite ?("28 U.S.C. § 158(a)")
{
  note "OUTLINE. Interlocutory review routes are holes (verify)."
  payoff ?
}

state record-assembled: "Record Assembled" by applicant cite ?("Fed. R. Bankr. P. 8009")
{
  note "Designation and transcript deadlines are holes. Verify."
  edge-record-assembled-briefing "Record transmitted" -> briefing {
    authority cite ?("Fed. R. Bankr. P. 8009")
  }
}

state briefing: "Briefing" by applicant cite ?("Fed. R. Bankr. P. 8018")
{
  note "Brief length and due dates are holes. Ninth Circuit BAP rules: identify and verify."
  edge-briefing-argument "Briefing complete" -> argument {
    authority cite ?("Fed. R. Bankr. P. 8018")
  }
}

decision argument: "Argument or Submission" by court cite ?("Fed. R. Bankr. P. 8019")
{
  note "Calendaring is a hole. Verify."
  edge-argument-decision-issued "Argued or submitted" -> decision-issued {
    authority cite ?("Fed. R. Bankr. P. 8019")
  }
}

decision decision-issued: "Decision" by court cite ?("28 U.S.C. § 158(c)(1)")
{
  note "Panel decision and publication are holes. Verify."
  edge-decision-issued-rehearing-window "Disposition entered" -> rehearing-window {
    authority cite ?("28 U.S.C. § 158(c)(1)")
  }
}

decision rehearing-window: "Rehearing or Reconsideration" by applicant cite ?("Fed. R. Bankr. P. 8022")
{
  note "Period is a hole. Verify."
  edge-rehearing-window-mandate-issued "No petition" -> mandate-issued {
    authority cite ?("Fed. R. Bankr. P. 8001")
  }
  edge-rehearing-window-rehearing-ruling "Petition filed" -> rehearing-ruling {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
}

decision rehearing-ruling: "Rehearing Decided" by court cite ?("Fed. R. Bankr. P. 8022")
{
  note "Period is a hole. Verify."
  edge-rehearing-ruling-mandate-issued "Denied" -> mandate-issued {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
  edge-rehearing-ruling-rehearing-granted "Granted" -> rehearing-granted {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
}

terminal rehearing-granted: "Rehearing granted; new decision" outcome [appeal] cite ?("Fed. R. Bankr. P. 8022")
{
  note "OUTLINE. Loops back to the decision stage in practice; modeled as an exit here."
  payoff ?
}

state mandate-issued: "Mandate or Remittitur Issued" by court cite ?("Fed. R. Bankr. P. 8001")
{
  note "Mandate or judgment issuance is a hole. Verify."
  edge-mandate-issued-further-review "Review sought" -> further-review {
    authority cite ?("28 U.S.C. § 158(d)(1)")
  }
  edge-mandate-issued-final-appellate "No further review sought" -> final-appellate {
    authority cite ?("Fed. R. Bankr. P. 8001")
  }
}

decision further-review: "Further Review Petition" by applicant cite ?("28 U.S.C. § 158(d)(1)")
{
  note "Appeal to the Ninth Circuit or certification is a hole. Verify."
  edge-further-review-review-denied "Denied" -> review-denied {
    authority cite ?("28 U.S.C. § 158(d)(1)")
  }
  edge-further-review-review-granted "Granted" -> review-granted {
    authority cite ?("28 U.S.C. § 158(d)(1)")
  }
}

terminal review-denied: "Further review denied" outcome [loss] cite ?("28 U.S.C. § 158(d)(1)")
{
  note "OUTLINE. Denial ends further review; finality of the appellate judgment is a hole."
  payoff ?
}

terminal review-granted: "Further review granted" outcome [appeal] cite ?("28 U.S.C. § 158(d)(1)")
{
  note "OUTLINE. Merits of further review are a hole."
  payoff ?
}

terminal final-appellate: "Appellate judgment final" outcome [judgment] cite ?("Fed. R. Bankr. P. 8001")
{
  note "OUTLINE. Trial court regains jurisdiction on issuance (verify)."
  payoff ?
}

