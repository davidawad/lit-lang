module frcp.periods

import core.authority.{ CaseOrder }
import core.frap26.{ frap26 }
import core.frcp6.{ frcp6 }
import core.time.{ ServiceMethod }

// The periods the pack's edges run on. Each is counted by a `lit/core`
// counting rule: FRCP 6(a) for the civil rules and for statutes that state no
// method of their own (FRCP 6(a) reaches "any statute that does not specify a
// method of computing time"), FRAP 26(a) for the FRAP 4 appeal clocks.
//
// Effective dates. A period is in force from the earliest date a vendored
// primary source shows the same period (length and trigger) in force, and
// never earlier. By default that is the latest amendment of its rule the
// vendored history line records (`sources/frcp.txt` "(As amended ...)"
// notes; `sources/usc-cfr-prosecution-fragments.txt` for 28 U.S.C.
// § 1447): an earlier text, not vendored, may have said otherwise. A period
// reaches back past that amendment only where `sources/change-corpus/`
// holds the earlier text: the 2009 Rule 12(a) (U.S. Reports vol. 556,
// `rules/us-reports/ur556-civ-2009-text.txt`) and the pre-2023 Rule
// 15(a)(1) (`rules/congress-packages/2022_scotus_package_0.txt`), which
// state the same periods, and the 2015 Rule 4(m) change from 120 days to
// 90 (`rules/congress-packages/2015-10-09-supreme_court_package_final_0.txt`).
// The FRAP 4(a) periods date from the 2009 amendments, which kept 30-day
// and longer periods (FRAP 26, 2009 Committee Note), the start `lit/frap`
// uses. 28 U.S.C. § 1446 carries no vendored history, so the removal
// period is in force from the package default, December 1, 2024: a lower
// bound, never an invented enactment date. Before a period's start no
// version is in force (L3007 for a query on that date).
//
// Delegation. `delegable_to [CaseOrder]` marks a period the court may change
// in one case: where the rule's own text says so ("unless the court sets a
// different time", "unless the court orders otherwise", "unless a different
// time is set by stipulation or court order"), and where the pack records an
// FRCP 6(b)(1) extension ("the court may, for good cause, extend the time").
// FRCP 6(b)(2) forbids extending the Rule 50(b), 59(b), 59(e) and 60(b)
// periods, and 28 U.S.C. §§ 1446(b) and 1447(c) state no extension, so
// those periods delegate nothing.
//
// Extension. FRCP 6(b)(1) reaches any act that "may or must be done within
// a specified time", so every civil-rule period not on the 6(b)(2) list
// grants its two powers, neither with a numeric ceiling: "(A) with or
// without motion or notice if the court acts, or if a request is made,
// before the original time or its extension expires" (`discretion
// GoodCause` when the court acts before expiry; `discretion GoodCause, on
// ExtensionMoved(...)` when the request is: (A) turns on when the request
// was made, so an order entered after expiry on a request made before it
// is good cause, not excusable neglect), and "(B) on motion made after
// the time has expired if the party failed to act because of excusable
// neglect" (`discretion ExcusableNeglect, after_expiry, on
// ExtensionMoved(...)`). The motion is a matter fact, and its date is
// `request_made`, distinct from the order's. This includes the Rule
// 12(a)(1)(A)(ii) waiver period and the Rule 15(a)(1) period. The four
// 6(b)(2) periods are `extend { never cite FRCP 6(b)(2) }`. The FRAP
// 4(a)(1) and 4(a)(3) periods are FRAP 4(a)(5)'s, not Rule 6(b)'s, and
// FRAP 26(b)(1) locks them against any other extension; see their
// declarations. An order extending one of them is the `...Extended` event
// that names it, done by the court and cited (SPEC §5.6).
/// The periods a party may move to extend.
enum ExtendedPeriod {
  ServicePeriod,
  AnswerPeriod,
  WaiverAnswerPeriod,
  RemovedAnswerPeriod,
  DenialAnswerPeriod,
  AmendmentAsOfCoursePeriod,
  AmendedResponsePeriod,
  InitialDisclosurePeriod,
  JuryDemandPeriod,
  NoticeOfAppealPeriod,
  CrossAppealPeriod,
}

/// A party moves to extend `period` (FRCP 6(b)(1)(B); FRAP 4(a)(5)(A)(i)).
event ExtensionMoved(period: ExtendedPeriod)
/// The complaint is filed (FRCP 3): the Rule 4(m) service clock starts.
event ComplaintFiled()
/// The summons and complaint are served under Rule 4. Service of process is
/// never Rule 5(b) service, so FRCP 6(d) adds no days to periods it starts.
event ProcessServed()
/// The plaintiff sends a Rule 4(d)(1) waiver request.
event WaiverRequestSent()
/// The defendant receives the initial pleading, "through service or
/// otherwise" (28 U.S.C. § 1446(b)(1); FRCP 81(c)(2)(A)).
event InitialPleadingReceived()
/// A notice of removal is filed under 28 U.S.C. § 1446(a).
event NoticeOfRemovalFiled()
/// The court denies a Rule 12 motion or postpones its disposition until
/// trial (FRCP 12(a)(4)(A) runs from notice of that action).
event Rule12MotionDenied()
/// A responsive pleading is served, by `method` (FRCP 5(b)).
event ResponsivePleadingServed(method: ServiceMethod)
/// An amended pleading is served, by `method` (FRCP 5(b)).
event AmendedPleadingServed(method: ServiceMethod)
/// The last pleading directed to a jury-triable issue is served, by
/// `method` (FRCP 38(b)(1)).
event LastPleadingServed(method: ServiceMethod)
/// The parties hold their Rule 26(f) conference.
event Rule26fConferenceHeld()
/// Judgment is entered (FRCP 58); the post-trial and appeal clocks run from
/// entry.
event JudgmentEntered()
/// The first notice of appeal is filed (FRAP 4(a)(3)).
event NoticeOfAppealFiled()
/// The court extends the Rule 4(m) service period to `until` (FRCP 4(m),
/// 6(b)(1)).
event ServicePeriodExtended(until: Date) extends service-period to until
/// The court extends the time to answer the complaint to `until` (FRCP
/// 6(b)(1)).
event AnswerPeriodExtended(until: Date) extends answer-period to until
/// The court extends the time to answer after a waiver of service to
/// `until` (FRCP 12(a)(1)(A)(ii), 6(b)(1)).
event WaiverAnswerPeriodExtended(until: Date) extends waiver-answer-period to until
/// The court extends the time to amend once as a matter of course to
/// `until` (FRCP 15(a)(1), 6(b)(1)).
event AmendmentAsOfCoursePeriodExtended(until: Date) extends amendment-as-of-course-period to until
/// The court extends the time to answer after removal to `until` (FRCP
/// 6(b)(1)).
event RemovedAnswerPeriodExtended(until: Date) extends removed-answer-period to until
/// The court extends the time to answer after denial of a Rule 12 motion
/// to `until` (FRCP 12(a)(4), 6(b)(1)).
event DenialAnswerPeriodExtended(until: Date) extends denial-answer-period to until
/// The court extends the time to respond to an amended pleading to `until`
/// (FRCP 15(a)(3), 6(b)(1)).
event AmendedResponsePeriodExtended(until: Date) extends amended-response-period to until
/// The court extends the time for initial disclosures to `until` (FRCP
/// 26(a)(1)(C), 6(b)(1)).
event InitialDisclosurePeriodExtended(until: Date) extends initial-disclosure-period to until
/// The court extends the time to demand a jury to `until` (FRCP 38(b),
/// 6(b)(1)).
event JuryDemandPeriodExtended(until: Date) extends jury-demand-period to until
/// The district court extends the time to file a notice of appeal to
/// `until` (FRAP 4(a)(5)).
event NoticeOfAppealPeriodExtended(until: Date) extends notice-of-appeal-period to until
/// The district court extends the time to file a notice of cross-appeal to
/// `until` (FRAP 4(a)(5)).
event CrossAppealPeriodExtended(until: Date) extends cross-appeal-period to until

/// Rule 4(m) from December 1, 2007 (the restyling; Rule 4's next amendment
/// was 2015's) to December 1, 2015: 120 days after the complaint is filed.
/// The amendment adopted April 29, 2015 "shortens the time for service
/// from 120 days to 90 days", and its successor's Committee Note recalls
/// "the 120 days originally set by Rule 4(m)" (2016 package,
/// sources/change-corpus/rules/congress-packages). FRCP 6(b)(1) read the
/// same then (FRCP (2008 ed.) 6(b)(1)).
deadline service-period: 120.days after ComplaintFiled() counted_by frcp6 effective [2007-12-01, 2015-12-01) known_at 2015-04-29 delegable_to [CaseOrder] cite ?("Rule 4(m) before the December 1, 2015 amendment: 120 days (text not vendored; the change is recorded in the 2016 Supreme Court package)") {
  extend { by court, discretion GoodCause }
  extend { by court, discretion GoodCause, on ExtensionMoved(ServicePeriod) }
  extend { by court, discretion ExcusableNeglect, after_expiry, on ExtensionMoved(ServicePeriod) }
}

/// Rule 4(m): 90 days after the complaint is filed; on good cause the court
/// "must extend the time for service", and absent it may "order that
/// service be made within a specified time". The 90 days date from the
/// amendment effective December 1, 2015; the 2016 and 2017 amendments only
/// clarify which foreign service it excludes.
deadline service-period: 90.days after ComplaintFiled() counted_by frcp6 effective [2015-12-01, ..) supersedes service-period@2007-12-01 delegable_to [CaseOrder] cite "FRCP 4(m)"
{
  extend { by court, discretion GoodCause }
  extend { by court, discretion GoodCause, on ExtensionMoved(ServicePeriod) }
  extend { by court, discretion ExcusableNeglect, after_expiry, on ExtensionMoved(ServicePeriod) }
}

/// Rule 12(a)(1)(A)(ii): an answer is due 60 days after a timely returned
/// waiver's request was sent (90 days for a defendant outside every judicial
/// district, which the pack does not branch on). In force from the 2009
/// text, which states the same 60 days (U.S. Reports vol. 556); the 2024
/// amendment left the period unchanged.
deadline waiver-answer-period: 60.days after WaiverRequestSent() counted_by frcp6 effective [2009-12-01, ..) cite "FRCP 12(a)(1)(A)(ii)"
{
  extend { by court, discretion GoodCause }
  extend { by court, discretion GoodCause, on ExtensionMoved(WaiverAnswerPeriod) }
  extend {
    by court
    discretion ExcusableNeglect
    after_expiry
    on ExtensionMoved(WaiverAnswerPeriod)
  }
}

/// Rule 12(a)(1)(A)(i): an answer is due 21 days after service of the
/// summons and complaint; a pre-answer Rule 12(b) motion "must be made
/// before pleading", so it runs on the same clock. Extendable under FRCP
/// 6(b)(1). In force from the 2009 text, which replaced 20 days with 21
/// (U.S. Reports vol. 556); the 2024 amendment left the period unchanged.
deadline answer-period: 21.days after ProcessServed() counted_by frcp6 effective [2009-12-01, ..) delegable_to [CaseOrder] cite "FRCP 12(a)(1)(A)(i)"
{
  extend { by court, discretion GoodCause }
  extend { by court, discretion GoodCause, on ExtensionMoved(AnswerPeriod) }
  extend { by court, discretion ExcusableNeglect, after_expiry, on ExtensionMoved(AnswerPeriod) }
}

/// 28 U.S.C. § 1446(b)(1): a notice of removal is due 30 days after the
/// defendant receives the initial pleading. A statute: no court may extend
/// it. The vendored section carries no history, so it is dated from the
/// package default.
deadline removal-period: 30.days after InitialPleadingReceived() counted_by frcp6 effective [2024-12-01, ..) cite "28 U.S.C. 1446(b)(1)"
/// 28 U.S.C. § 1447(c): a motion to remand for any defect other than lack
/// of subject-matter jurisdiction is due 30 days after the notice of
/// removal is filed. Section 1447 last amended by Pub. L. 112-51, § 2(d),
/// November 9, 2011 (vendored history).
deadline remand-motion-period: 30.days after NoticeOfRemovalFiled() counted_by frcp6 effective [2011-11-09, ..) cite "28 U.S.C. 1447(c)"

/// Rule 81(c)(2)(A): after removal, a defendant who has not answered
/// answers 21 days after receiving the initial pleading (the longest of
/// three periods; the pack models this one). Extendable under FRCP 6(b)(1).
/// Rule 81 last amended eff. December 1, 2009.
deadline removed-answer-period: 21.days after InitialPleadingReceived() counted_by frcp6 effective [2009-12-01, ..) delegable_to [CaseOrder] cite "FRCP 81(c)(2)(A)"
{
  extend { by court, discretion GoodCause }
  extend { by court, discretion GoodCause, on ExtensionMoved(RemovedAnswerPeriod) }
  extend {
    by court
    discretion ExcusableNeglect
    after_expiry
    on ExtensionMoved(RemovedAnswerPeriod)
  }
}

/// Rule 12(a)(4)(A): "Unless the court sets a different time", the
/// responsive pleading is due 14 days after notice that the court denied
/// the Rule 12 motion. In force from the 2009 text, which states the same
/// 14 days (U.S. Reports vol. 556); the 2024 amendment left it unchanged.
deadline denial-answer-period: 14.days after Rule12MotionDenied() counted_by frcp6 effective [2009-12-01, ..) delegable_to [CaseOrder] cite "FRCP 12(a)(4)(A)"
{
  extend { by court, discretion GoodCause }
  extend { by court, discretion GoodCause, on ExtensionMoved(DenialAnswerPeriod) }
  extend {
    by court
    discretion ExcusableNeglect
    after_expiry
    on ExtensionMoved(DenialAnswerPeriod)
  }
}

/// Rule 15(a)(1)(B): amendment once as a matter of course no later than 21
/// days after service of a responsive pleading (or of a Rule 12(b), (e) or
/// (f) motion, whichever is earlier). In force from the 2009 amendment, the
/// last before 2023's (vendored history); 2023's substituted "no later
/// than" for "within", which changes nothing for a period run from the
/// responsive pleading (the 2022 package quotes the earlier text: "21 days
/// after service of a responsive pleading").
deadline amendment-as-of-course-period: 21.days after ResponsivePleadingServed() counted_by frcp6 effective [2009-12-01, ..) cite "FRCP 15(a)(1)(B)"
{
  extend { by court, discretion GoodCause }
  extend { by court, discretion GoodCause, on ExtensionMoved(AmendmentAsOfCoursePeriod) }
  extend {
    by court
    discretion ExcusableNeglect
    after_expiry
    on ExtensionMoved(AmendmentAsOfCoursePeriod)
  }
}

/// Rule 15(a)(3): "Unless the court orders otherwise", a response to an
/// amended pleading is due within the time left on the original or 14 days
/// after service of the amendment, whichever is later; the pack models the
/// 14 days. In force from the 2009 amendment, the last before 2023's
/// (vendored history); 2023's amended only Rule 15(a)(1) (2022 package).
deadline amended-response-period: 14.days after AmendedPleadingServed() counted_by frcp6 effective [2009-12-01, ..) delegable_to [CaseOrder] cite "FRCP 15(a)(3)"
{
  extend { by court, discretion GoodCause }
  extend { by court, discretion GoodCause, on ExtensionMoved(AmendedResponsePeriod) }
  extend {
    by court
    discretion ExcusableNeglect
    after_expiry
    on ExtensionMoved(AmendedResponsePeriod)
  }
}

/// Rule 26(a)(1)(C): initial disclosures are due 14 days after the Rule
/// 26(f) conference "unless a different time is set by stipulation or court
/// order". Rule 26 last amended eff. December 1, 2015.
deadline initial-disclosure-period: 14.days after Rule26fConferenceHeld() counted_by frcp6 effective [2015-12-01, ..) delegable_to [CaseOrder] cite "FRCP 26(a)(1)(C)"
{
  extend { by court, discretion GoodCause }
  extend { by court, discretion GoodCause, on ExtensionMoved(InitialDisclosurePeriod) }
  extend {
    by court
    discretion ExcusableNeglect
    after_expiry
    on ExtensionMoved(InitialDisclosurePeriod)
  }
}

/// Rule 38(b)(1): a jury demand is due 14 days after the last pleading
/// directed to the issue is served. Extendable under FRCP 6(b)(1). Rule 38
/// last amended eff. December 1, 2009.
deadline jury-demand-period: 14.days after LastPleadingServed() counted_by frcp6 effective [2009-12-01, ..) delegable_to [CaseOrder] cite "FRCP 38(b)(1)"
{
  extend { by court, discretion GoodCause }
  extend { by court, discretion GoodCause, on ExtensionMoved(JuryDemandPeriod) }
  extend {
    by court
    discretion ExcusableNeglect
    after_expiry
    on ExtensionMoved(JuryDemandPeriod)
  }
}

/// Rule 50(b): a renewed motion for judgment as a matter of law is due 28
/// days after entry of judgment; FRCP 6(b)(2) forbids extending it. Rule 50
/// last amended eff. December 1, 2009.
deadline jmol-renewal-period: 28.days after JudgmentEntered() counted_by frcp6 effective [2009-12-01, ..) cite "FRCP 50(b)"
{
  extend { never cite "FRCP 6(b)(2)" }
}

/// Rule 59(b): a new-trial motion is due 28 days after entry of judgment;
/// FRCP 6(b)(2) forbids extending it. Rule 59 last amended eff. December 1,
/// 2009.
deadline new-trial-period: 28.days after JudgmentEntered() counted_by frcp6 effective [2009-12-01, ..) cite "FRCP 59(b)"
{
  extend { never cite "FRCP 6(b)(2)" }
}

/// Rule 59(e): a motion to alter or amend the judgment is due 28 days after
/// its entry; FRCP 6(b)(2) forbids extending it. Rule 59 last amended eff.
/// December 1, 2009.
deadline alter-amend-period: 28.days after JudgmentEntered() counted_by frcp6 effective [2009-12-01, ..) cite "FRCP 59(e)"
{
  extend { never cite "FRCP 6(b)(2)" }
}

/// Rule 60(c)(1): a Rule 60(b)(1)-(3) motion is due "no more than a year
/// after the entry of the judgment", a calendar year (`frcp6`'s
/// `end_of_month clamp` ends one from February 29 on February 28); FRCP
/// 6(b)(2) forbids extending it. Rule 60 last amended eff. December 1, 2007.
deadline relief-from-judgment-period: 1.years after JudgmentEntered() counted_by frcp6 effective [2007-12-01, ..) cite "FRCP 60(c)(1)"
{
  extend { never cite "FRCP 6(b)(2)" }
}

/// FRAP 4(a)(1)(A) before the 2009 amendments, as the 2008 edition of 28
/// U.S.C. App. prints it: the same 30 days and the same FRAP 4(a)(5)
/// grant, except that no extension "may exceed 30 days after the
/// prescribed time or 10 days after the date when the order granting the
/// motion is entered, whichever is later" (4(a)(5)(C)). In force from
/// December 1, 2002, when 4(a)(5)(A)(ii) took the text that edition
/// prints: before it most circuits read good cause as reaching only a
/// motion made before expiry (2002 Committee Note), so earlier law is not
/// declared. The 2005 amendment touched only 4(a)(6). FRAP 26(a)(2) then
/// left weekends and legal holidays out of a period under 11 days, so the
/// order's 10 days ran past 10 calendar days; a bound counts calendar days,
/// so this one is never later than the rule's: an extension it allows the
/// rule allowed, and one to a later day inside the FRAP 26(a)(2) count is
/// refused (UNVERIFIED for those days, the direction that never accepts an
/// untimely notice).
deadline notice-of-appeal-period: 30.days after JudgmentEntered() counted_by frap26 effective [2002-12-01, 2009-12-01) known_at 2002-04-29 cite "FRAP (2008 ed.) 4(a)(1)(A)"
{
  forum frap
  extend {
    by court
    discretion GoodCauseOrExcusableNeglect
    to max(prescribed_due + 30.days, grant_order_entered + 10.days)
    after_expiry
    on ExtensionMoved(NoticeOfAppealPeriod)
    within prescribed_due + 30.days
  }
  extend { never cite "FRAP (2008 ed.) 26(b)(1)" }
}

/// 28 U.S.C. § 2107(a): "no appeal shall bring any judgment ... before a
/// court of appeals for review unless notice of appeal is filed, within
/// thirty days after the entry" (restated in FRAP 4(a)(1)(A)). A statutory
/// limit is jurisdictional (Bowles v. Russell, 551 U.S. 205 (2007)), so no
/// order displaces it: the period delegates nothing, and its one
/// extension is the statute's own, § 2107(c) and FRAP 4(a)(5): on a motion
/// filed no later than 30 days after the time expires, to no later than
/// 30 days after the prescribed time or 14 days after the order, whichever
/// is later (FRAP 4(a)(5)(C)), for excusable neglect or good cause whether
/// the motion comes before or after expiry (4(a)(5)(A)(ii)). FRAP 26(b)(1)
/// forbids any other extension ("except as authorized in Rule 4").
deadline notice-of-appeal-period: 30.days after JudgmentEntered() counted_by frap26 effective [2009-12-01, ..) known_at 2009-03-26 supersedes notice-of-appeal-period@2002-12-01 cite "28 U.S.C. § 2107(a)"
{
  forum frap
  extend {
    by court
    discretion GoodCauseOrExcusableNeglect
    to max(prescribed_due + 30.days, grant_order_entered + 14.days)
    after_expiry
    on ExtensionMoved(NoticeOfAppealPeriod)
    within prescribed_due + 30.days
  }
  extend { never cite "FRAP 26(b)(1)" }
}

/// FRAP 4(a)(3) before the 2009 amendments: the same 14 days, "or within
/// the time otherwise prescribed by this Rule 4(a), whichever period ends
/// later" (2008 edition of 28 U.S.C. App.), with the pre-2009 FRAP 4(a)(5)
/// grant of `notice-of-appeal-period@2002-12-01` and its calendar-day
/// bound.
deadline cross-appeal-period: 14.days after NoticeOfAppealFiled() counted_by frap26 effective [2002-12-01, 2009-12-01) known_at 2002-04-29 cite "FRAP (2008 ed.) 4(a)(3)"
{
  trigger later_of(notice-of-appeal-period)
  forum frap
  extend {
    by court
    discretion GoodCauseOrExcusableNeglect
    to max(prescribed_due + 30.days, grant_order_entered + 10.days)
    after_expiry
    on ExtensionMoved(CrossAppealPeriod)
    within prescribed_due + 30.days
  }
  extend { never cite "FRAP (2008 ed.) 26(b)(1)" }
}

/// FRAP 4(a)(3): a cross-appeal is due "within 14 days after the date when
/// the first notice was filed, or within the time otherwise prescribed by
/// this Rule 4(a), whichever period ends later": `later_of` absorbs the
/// open notice-of-appeal instance, so the due date is never before it
/// (SPEC §5.3). A matter records only the first notice as
/// `NoticeOfAppealFiled`. FRAP 4(a)(5)(A) extends "the time to file a
/// notice of appeal" and 4(a)(5)(B) names 4(a)(3), so the cross-appeal
/// period carries the same grant and FRAP 26(b)(1) lock as the notice of
/// appeal, its bound counted from the later date.
deadline cross-appeal-period: 14.days after NoticeOfAppealFiled() counted_by frap26 effective [2009-12-01, ..) known_at 2009-03-26 supersedes cross-appeal-period@2002-12-01 cite "FRAP 4(a)(3)"
{
  trigger later_of(notice-of-appeal-period)
  forum frap
  extend {
    by court
    discretion GoodCauseOrExcusableNeglect
    to max(prescribed_due + 30.days, grant_order_entered + 14.days)
    after_expiry
    on ExtensionMoved(CrossAppealPeriod)
    within prescribed_due + 30.days
  }
  extend { never cite "FRAP 26(b)(1)" }
}
