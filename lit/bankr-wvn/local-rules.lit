module bankr-wvn-local-rules.local-rules

import core.frcp6.{ frcp6 }
import frbp.events.{ FirstMeetingDate, PetitionFiled }

// The Bankr. N.D.W. Va. court's own periods and page limit, computed under
// FRBP 9006(a), which states the FRCP 6(a) method. Every FRBP period
// (schedules, chapter 7, 12 and 13 claims, confirmation objections,
// discharge, dischargeability, adversary answers, appeals) is lit/frbp's; a
// period the rules restate from the Code is not declared again: the tax
// return 7 days before the first meeting (LBR 2003-1, 11 U.S.C. §
// 521(e)(2)(A)). Stated in the rules but not declared: the 30-day window
// before the § 727(a) deadline that triggers the added-creditor extension
// (LBR 1009-1(a)); the 75- and 60-day investigation periods a financing
// order must give (LBR 4001-2); the earlier-of caps of 3 days before the
// hearing on responses and replies (LBR 7007-1(d)-(e), 9013-1(d)); the
// later-of jury consent statement (LBR 9015-1(b)); the 7-business-day
// continuance threshold (LBR 5071-1); the judge's optional opinion within
// 21 days of a notice of appeal (LBR 8001-1); the clerk's 15-day cash-only
// period, 60-day destruction of originals, 90-day transcript inspection and
// 7-year signature retention (LBR 5081-1, 5005-1(f), 5077-1(a), 5005-6);
// and the case management conference within 14 days of appearance, LBR
// 7016-1, rescinded by General Order 20-06.
/// An amended schedule or list adding a creditor, or correcting its
/// address, within 30 days of the § 727(a) objection deadline is served on
/// that creditor (LBR 1009-1(a)).
event AmendedScheduleServed()
/// The § 341 meeting of creditors is scheduled to be held (LBR
/// 2003-1(b)-(c)).
event ScheduledMeetingDate()
/// The court directs an attorney to submit an order reflecting the outcome
/// of a hearing (LBR 5005-1(e)(5)).
event OrderDirected()
/// A transcript of a court proceeding is filed (LBR 5077-1(b)).
event TranscriptFiled()
/// A transcript is delivered (LBR 5077-1(b)).
event TranscriptDelivered()
/// A sale of estate property is made (LBR 6004-1).
event SaleCompleted()
/// A motion in an adversary proceeding is filed with the clerk (LBR
/// 7007-1(d)).
event AdversaryMotionFiled()
/// A response to a motion in an adversary proceeding is filed with the
/// clerk (LBR 7007-1(e)).
event AdversaryResponseFiled()
/// A motion in the case is filed (LBR 9013-1(d)).
event MotionFiled()
/// The scheduled hearing on a motion is held (LBR 9013-1(f)(2)).
event MotionHearingDate()

/// A brief, motion or accompanying memorandum: at most 25 pages, exclusive
/// of exhibits, absent the court's permission (LBR 9004-1(c)).
limit brief { pages <= 25 cite "N.D.W. Va. LBR 9004-1(c)" } cite "N.D.W. Va. LBR 9004-1(c)"

/// LBR 1009-1(a): when a creditor is added or its address corrected within
/// 30 days of the § 727(a) objection deadline, that deadline is extended
/// for it to 30 days from service of the amended schedule or list, without
/// notice or order.
deadline added-creditor-discharge-objection-period: 30.days after AmendedScheduleServed() counted_by frcp6 cite "N.D.W. Va. LBR 1009-1(a)"
{
  forum frcp
}

/// LBR 1014-2: an objection to venue is filed within 21 days of the date
/// first set for the meeting of creditors.
deadline venue-objection-period: 21.days after FirstMeetingDate() counted_by frcp6 cite "N.D.W. Va. LBR 1014-2"
{
  forum frcp
}

/// LBR 1072-1(b): a debtor may ask the U.S. Trustee's Regional Office at
/// least three days before filing to hold the meeting of creditors at a
/// different location.
deadline meeting-location-request-period: 3.days before PetitionFiled() counted_by frcp6 cite "N.D.W. Va. LBR 1072-1(b)"
{
  forum frcp
}

/// LBR 2003-1(b)(2): a debtor unable to agree on an alternative appearance
/// moves to approve it, extend or waive appearance at least 7 days before
/// the scheduled meeting.
deadline appearance-motion-period: 7.days before ScheduledMeetingDate() counted_by frcp6 cite "N.D.W. Va. LBR 2003-1(b)(2)"
{
  forum frcp
}

/// LBR 2003-1(b)(3): the debtor or counsel should notify the trustee and
/// U.S. Trustee of a disability needing accommodation not less than 14 days
/// before the § 341 meeting.
deadline accommodation-notice-period: 14.days before ScheduledMeetingDate() counted_by frcp6 cite "N.D.W. Va. LBR 2003-1(b)(3)"
{
  forum frcp
}

/// LBR 2003-1(c)(1): a request for a continuance of the meeting goes first
/// to the trustee, or in chapter 11 to the U.S. Trustee, at least 7 days
/// before the meeting.
deadline continuance-request-period: 7.days before ScheduledMeetingDate() counted_by frcp6 cite "N.D.W. Va. LBR 2003-1(c)(1)"
{
  forum frcp
}

/// LBR 4001-1(c): a motion to extend the automatic stay beyond the 30th day
/// under § 362(c)(3)(B) is filed within 7 days of the petition date.
deadline stay-extension-motion-period: 7.days after PetitionFiled() counted_by frcp6 cite "N.D.W. Va. LBR 4001-1(c)"
{
  forum frcp
}

/// LBR 5005-1(e)(5): an attorney directed to submit an order reflecting a
/// hearing's outcome submits it within 7 days unless otherwise directed.
deadline directed-order-period: 7.days after OrderDirected() counted_by frcp6 cite "N.D.W. Va. LBR 5005-1(e)(5)"
{
  forum frcp
}

/// LBR 5077-1(b): a request to redact personal data identifiers is due
/// within 21 calendar days of the filing of the transcript, or longer if
/// the court orders.
deadline transcript-redaction-request-period: 21.days after TranscriptFiled() counted_by frcp6 cite "N.D.W. Va. LBR 5077-1(b)"
{
  forum frcp
}

/// LBR 5077-1(b): the court reporter or transcriber files the redacted
/// transcript within 31 calendar days of the delivery of the transcript, or
/// longer if the court orders.
deadline redacted-transcript-period: 31.days after TranscriptDelivered() counted_by frcp6 cite "N.D.W. Va. LBR 5077-1(b)"
{
  forum frcp
}

/// LBR 6004-1: unless the court orders otherwise, a FRBP 6004(f)(1) report
/// of sale is timely if filed within 45 days of the sale.
deadline sale-report-period: 45.days after SaleCompleted() counted_by frcp6 cite "N.D.W. Va. LBR 6004-1"
{
  forum frcp
}

/// LBR 7007-1(d): a response to a motion in an adversary proceeding is
/// filed within 21 days from the motion's filing, or three days before the
/// hearing if earlier.
deadline adversary-motion-response-period: 21.days after AdversaryMotionFiled() counted_by frcp6 cite "N.D.W. Va. LBR 7007-1(d)"
{
  forum frcp
}

/// LBR 7007-1(e): a reply is filed within 7 days from the response's
/// filing, or three days before the hearing if earlier.
deadline adversary-motion-reply-period: 7.days after AdversaryResponseFiled() counted_by frcp6 cite "N.D.W. Va. LBR 7007-1(e)"
{
  forum frcp
}

/// LBR 9013-1(d): a response to a motion is filed within 21 days from the
/// motion's filing, or 3 days before the hearing if earlier, unless another
/// period applies.
deadline motion-response-period: 21.days after MotionFiled() counted_by frcp6 cite "N.D.W. Va. LBR 9013-1(d)"
{
  forum frcp
}

/// LBR 9013-1(f)(2): a party intending to object at a hearing set without
/// filed objections files a written objection at least three days before
/// the hearing.
deadline hearing-objection-period: 3.days before MotionHearingDate() counted_by frcp6 cite "N.D.W. Va. LBR 9013-1(f)(2)"
{
  forum frcp
}

start motion-filed

state motion-filed: "Motion filed and served" by applicant cite "N.D.W. Va. LBR 9013-1(a)"
{
  note "A motion is filed with its supporting documentation and served with a certificate of service (LBR 9013-1(a)-(c)); a response is due within 21 days from its filing or 3 days before the hearing, whichever is earlier (LBR 9013-1(d)). The motion's FRBP periods are lit/frbp's."
  edge-motion-filed-response "Response filed" -> response {
    authority cite "N.D.W. Va. LBR 9013-1(d)"
  }
  edge-motion-filed-unopposed "No timely response" -> ruling {
    authority cite "N.D.W. Va. LBR 9013-1(f)"
  }
}

state response: "Response filed" by opponent cite "N.D.W. Va. LBR 9013-1(e)"
{
  note "A response states its grounds (LBR 9013-1(e)); a party appearing to object at a hearing set without objections files a written objection at least three days before it (LBR 9013-1(f)(2))."
  edge-response-ruling "Matter heard" -> ruling { authority cite "N.D.W. Va. LBR 9013-1(f)" }
}

decision ruling: "Motion decided" by court cite "N.D.W. Va. LBR 9013-1(f)"
{
  note "Without a timely filed written response the court may grant the relief without a further hearing (LBR 9013-1(f)); an attorney directed to submit the order does so within 7 days (LBR 5005-1(e)(5))."
  edge-ruling-granted "Granted" -> decided { authority cite "N.D.W. Va. LBR 9013-1(f)" }
  edge-ruling-denied "Denied" -> decided { authority cite "N.D.W. Va. LBR 9013-1(f)" }
}

terminal decided: "Matter decided: the case continues under lit/frbp" outcome [procedural] cite "N.D.W. Va. LBR 9029-1(a)"
{
  note "The Local Rules govern practice and procedure before the court in all pending and later cases and supersede earlier local bankruptcy rules (LBR 9029-1(a))."
}
