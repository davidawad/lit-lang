// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-ny-commission-of-appeals

import ny-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start notice

decision notice: "Notice of appeal within time?" by applicant cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)")
{
  note "OUTLINE. Historical court: the Commission of Appeals heard the Court of Appeals' backlog from 1870 to 1875 (verify). Appeal to the New York Commission of Appeals: appealability, the notice period and service are holes. Leading decisions: not yet identified in this pass; verify before use."
  edge-notice-late "No timely notice" -> dismissed-untimely { authority cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)") }
  edge-notice-filed "Timely notice" -> record { event NoticeOfAppealFiled() authority cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)") }
}

state record: "Record or transcript prepared" by office cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)")
{
  note "OUTLINE. Record contents, transcript and fees are holes."
  edge-record-briefing "Record filed" -> briefing { event RecordFiled() authority cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)") }
}

state briefing: "Briefs filed" by applicant cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)")
{
  note "OUTLINE. Briefing periods, form and length are holes."
  edge-briefing-argument "Argument or submission" -> argument { authority cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)") }
}

state argument: "Argument or submission" by court cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)")
{
  note "OUTLINE. Argument may be discretionary."
  edge-argument-decision "Decision issued" -> decision { authority cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)") }
}

chance decision: "Court decides" by court cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)")
{
  note "OUTLINE. Outcome probabilities are holes."
  edge-decision-affirmed "Affirmed" -> post-decision p ? { event DecisionFiled() }
  edge-decision-reversed "Reversed, vacated or remanded" -> post-decision p ? { event DecisionFiled() }
}

decision post-decision: "Rehearing or further review?" by applicant cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)")
{
  note "OUTLINE. Rehearing and further-review periods are holes."
  edge-post-mandate "No further review" -> mandate-issued { event MandateIssued() authority cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)") }
  edge-post-further "Further review sought" -> further-review { event ReviewPetitionFiled() authority cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)") }
}

terminal dismissed-untimely: "Dismissed: no timely notice" outcome [loss, dismissal] cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)")
{
  note "OUTLINE. Whether the time limit is jurisdictional is a hole."
  payoff ?
}

terminal mandate-issued: "Mandate or remittitur issued" outcome [final] cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)")
{
  note "OUTLINE. The case returns to the court below; costs are holes."
  payoff ?
}

terminal further-review: "Further review sought in a higher court" outcome [final] cite ?("N.Y. Const. art. VI, § 5 (1869) (verify)")
{
  note "OUTLINE. Review in the higher court is its own package."
  payoff ?
}
