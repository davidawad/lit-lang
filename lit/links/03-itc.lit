// ITC <-> Federal Circuit. A party adversely affected by a final Section 337
// determination may appeal within 60 days after it becomes final (19 U.S.C.
// § 1337(c), lit/cafc's `itc-noa-period`) to the court with exclusive
// jurisdiction to review it (28 U.S.C. § 1295(a)(6)).
module links.itc

/// The Federal Circuit as entered from a final determination. Only
/// `origin-to-itc` and `remand-route-itc` survive. The Commission defends
/// its determination as a party, so the rehearing patches set the 45-day
/// agency-party period (`rehearing-period-united-states-party`, FRAP
/// 40(d)(1)(B)).
///
/// Proposed fix, not applied (it would change the generated notes): both
/// patch notes pin the 45 days on "Fed. Cir. R. 40(a)(1)(B)", which the
/// vendored Dec. 1, 2025 rules do not have; the time is Fed. Cir. R.
/// 40(f)(1), and the agency-party branch FRAP 40(d)(1)(B).
instance cafc@itc {
  pack cafc
  note "Federal Circuit as entered from an ITC § 337 final determination (19 U.S.C. § 1337(c)). Remand can only return to the Commission."
  remove_edges [origin-to-district-court, origin-to-ptab, origin-to-cofc, remand-route-district-court, remand-route-ptab, remand-route-cofc, origin-to-ttab, remand-route-ttab]
  probabilities { remand-route-itc: 1 }
  patch rehearing-file {
    deadline: {
      length: 45
      note: "45 days after entry of judgment because the Commission, a United States agency, is a party to every Section 337 appeal (Fed. Cir. R. 40(a)(1)(B): 30 days, or 45 if a United States agency is a party)."
    }
  }
  patch rehearing-time-expires {
    deadline: {
      length: 45
      note: "The rehearing window this edge waits out is 45 days here because the Commission, a United States agency, is a party (Fed. Cir. R. 40(a)(1)(B)); the mandate then issues 7 days after it expires (FRAP 41(b))."
    }
  }
}

/// Replaces the ITC pack's abstract appeal edge when both packs are loaded.
link itc-appeal-to-cafc "Appeal the Commission's final determination to the Federal Circuit": itc-337::federal-circuit-appeal-window -> cafc@itc::entry-itc by applicant {
  authority cite 19 U.S.C. § 1337(c); 28 U.S.C. § 1295(a)(6)
  note "Supersedes the ITC pack's abstract appeal edge when both packs are loaded."
  tags [appeal]
  replaces ["itc-337::federal-circuit-appeal-window->appeal-filed#0"]
}

/// On remand the Commission issues a new final determination (legacy
/// authority 28 U.S.C. § 2106, kept; see `cafc-remand-to-ptab`).
link cafc-remand-to-itc "Remand: Commission issues a new final determination": cafc@itc::remanded-to-itc -> itc-337::commission-final-determination by office p 1 {
  authority cite 28 U.S.C. § 2106
  tags [remand]
}
