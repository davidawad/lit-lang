// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-wv-intermediate-court-of-appeals

import outline-wv-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start notice-filed

state notice-filed: "Notice of appeal filed" by applicant cite ?("W. Va. Code § 58-5-1 (verify); W. Va. R. App. P. 5 (verify)")
{
  note "OUTLINE. Notice in the trial court; period, service and cross-appeal are holes. Circuit court final orders after June 30, 2022 go to the Intermediate Court of Appeals: W. Va. Code § 58-5-1."
  edge-notice-record "Record prepared" -> record { event NoticeOfAppealFiled()
    authority cite ?("W. Va. R. App. P. ? (record) (verify)")
  }
}

state record: "Record or transcript prepared" by office cite ?("W. Va. R. App. P. ? (record) (verify)")
{
  note "OUTLINE. Record contents, transcript and stays are holes. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-record-brief "Briefing" -> briefing { event RecordFiled()
    authority cite ?("W. Va. R. App. P. ? (briefs) (verify)")
  }
}

state briefing: "Briefs filed" by applicant cite ?("W. Va. R. App. P. ? (briefs) (verify)")
{
  note "OUTLINE. Brief form, length and reply are holes. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-brief-argument "Argument or submission" -> argument {
    authority cite ?("W. Va. R. App. P. ? (argument) (verify)")
  }
}

decision argument: "Argument or submission" by court cite ?("W. Va. R. App. P. ? (argument) (verify)")
{
  note "OUTLINE. Argument is discretionary in some courts. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-arg-decision "Decision issued" -> decision {
    authority cite ?("W. Va. Code § 51-11-1 et seq. (verify)")
  }
}

chance decision: "Court decides" by court cite ?("W. Va. Code § 51-11-1 et seq. (verify)")
{
  note "OUTLINE. Probabilities are holes. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-dec-affirmed "Affirmed" -> post-decision p ? {
  }
  edge-dec-reversed "Reversed or remanded" -> post-decision p ? {
  }
}

decision post-decision: "Rehearing or further review decision" by applicant cite ?("W. Va. R. App. P. ? (rehearing) (verify)")
{
  note "OUTLINE. Rehearing and further review: W. Va. R. App. P. 5 (petition to Supreme Court of Appeals) (verify). Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-pd-rehearing "Rehearing sought" -> rehearing {
    authority cite ?("W. Va. R. App. P. ? (rehearing) (verify)")
  }
  edge-pd-further "Further review sought" -> further-review {
    authority cite ?("W. Va. R. App. P. 5 (petition to Supreme Court of Appeals) (verify)")
  }
  edge-pd-mandate "No further review" -> mandate-issued { event MandateIssued()
    authority cite ?("W. Va. R. App. P. ? (mandate) (verify)")
  }
}

state rehearing: "Rehearing petition" by applicant cite ?("W. Va. R. App. P. ? (rehearing) (verify)")
{
  note "OUTLINE. Rehearing period and effect on finality are holes."
  edge-rh-decision "Rehearing decided" -> post-decision {
  }
}

state further-review: "Petition for further review" by applicant cite ?("W. Va. R. App. P. 5 (petition to Supreme Court of Appeals) (verify)")
{
  note "OUTLINE. Petition period and grant standard are holes. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-fr-mandate "Review denied" -> mandate-issued { event MandateIssued()
  }
  edge-fr-merits "Review granted" -> supreme-merits {
  }
}

terminal mandate-issued: "Mandate or remittitur issued" outcome [final] cite ?("W. Va. R. App. P. ? (mandate) (verify)")
{
  note "OUTLINE. Mandate or remittitur returns the case to the trial court. Costs: holes."
  payoff ?
}

terminal supreme-merits: "Review granted on the merits" outcome [final] cite ?("W. Va. R. App. P. 5 (petition to Supreme Court of Appeals) (verify)")
{
  note "OUTLINE. Merits review in the highest state court. Outcome is outside this outline."
  payoff ?
}

