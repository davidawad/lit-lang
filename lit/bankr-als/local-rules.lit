module bankr-als-local-rules.local-rules

import core.states.alabama.{ frbp9006-alabama }
import frbp.events.{ FirstMeetingDate }

// The Bankr. S.D. Ala. court's own periods, counted under FRBP 9006(a). The
// FRBP periods are lit/frbp's and are not declared again. Every period
// below binds only to the OCR extract of the July 1, 2026 rules, an image
// scan with no text layer (sources/bankr-als/PROVENANCE.md), so each has a
// hole cite naming its pinpoint and the value is the OCR text's,
// unverified.
//
// Stated in the rules but not declared: the FRBP's own periods the rules
// repeat (a creditor's request for tax returns at least 14 days before the
// first date set for the meeting, FRBP 4002(b)(4), which LBR 1007-1(d)
// extends to payment advices; objections to an amended chapter 13 plan at
// least seven days before the confirmation hearing, FRBP 3015(f), LBR
// 3015-2(c); 14 days to object on negative notice to an FRBP 4001(d)
// agreement, LBR 9007-1(b)(3)(A)); the business-day periods (notices of
// default and of termination of stay mailed within 1 business day of
// filing, LBR 4001-2(c)); the conditions that are not deadlines (at least 10
// days postpetition for a chapter 7 debtor to decide on a postpetition
// legal services contract, LBR 2016-2; a conditional denial's future relief
// provision expiring within 2 years, LBR 4001-2(a); the 90 days a filed
// transcript is restricted, LBR 5003; the six-year and one-year retention
// of originals, LBR 9011-1); and the chapter 13 sale filings due "a
// sufficient time before the hearing" (LBR 6004). The rules state no page
// limit.
/// The chapter 13 trustee's outstanding checks in a case converted to
/// chapter 7 have all cleared (LBR 1019-1).
event TrusteeChecksCleared()
/// The notice of a Rule 2004 examination is served (LBR 2004-1(c)).
event ExaminationNoticeServed()
/// The date of a proposed Rule 2004 examination or production (LBR
/// 2004-1(d)-(e)).
event ExaminationDate()
/// The chapter 13 trustee recommends confirmation (LBR 3015-2(d)).
event ConfirmationRecommended()
/// The chapter 13 trustee files a notice to correct the final plan summary
/// (LBR 3015-2(d)).
event CorrectionNoticeFiled()
/// The chapter 13 confirmation order is entered (LBR 3015-2(e)).
event ConfirmationOrderEntered()
/// The hearing on a motion for relief from the automatic stay or the
/// co-debtor stay (LBR 4001-1(b)-(c)).
event StayReliefHearing()
/// An agreed order conditionally denying stay relief in a chapter 13 case
/// is entered (LBR 4001-2(e)).
event ConditionalDenialEntered()
/// A creditor mails a notice of default under a conditional denial order
/// conditioned on direct payments (LBR 4001-2(f)).
event DirectPaymentDefaultMailed()
/// A creditor mails a notice of default under a conditional denial order
/// conditioned on plan payments to the trustee (LBR 4001-2(g)).
event PlanPaymentDefaultMailed()
/// The chapter 12 or 13 trustee files the notice of completion of the plan
/// (LBR 4004-1).
event PlanCompletionNoticeFiled()
/// A motion, objection or other matter is served with the negative notice
/// legend (LBR 9007-1(b)).
event NegativeNoticeServed()
/// An objection to a proof of claim is served with the negative notice
/// legend (LBR 9007-1(b)(3)(B)).
event ClaimObjectionServed()

/// LBR 1007-1(d): copies of payment advices and other evidence of payment
/// received within 60 days before the petition are filed through the
/// restricted CM/ECF entry at least 7 days prior to the meeting of creditors.
deadline payment-advices-period: 7.days before FirstMeetingDate() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 1007-1(d), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 1019-1: if a chapter 13 case is converted to chapter 7, the chapter
/// 13 trustee files a final report and account within 30 days after all
/// outstanding checks the trustee issued in the case have cleared.
deadline conversion-final-report-period: 30.days after TrusteeChecksCleared() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 1019-1, July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 2004-1(c): attendance and production may not be required less than
/// 21 days after service of the notice, and a request construed under FRBP
/// 7034 has its time to respond shortened to 21 days.
deadline examination-production-period: 21.days after ExaminationNoticeServed() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 2004-1(c), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 2004-1(d): a party in interest who wishes to attend files and serves a
/// cross-notice of examination at least 14 days in advance of it.
deadline cross-notice-period: 14.days before ExaminationDate() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 2004-1(d), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 2004-1(e): an interested party may file a motion for protective order,
/// with a request for expedited hearing, at least 7 days before the date of
/// the proposed examination or production.
deadline protective-order-period: 7.days before ExaminationDate() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 2004-1(e), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 3015-2(d): within 14 days of the chapter 13 trustee's recommendation
/// of confirmation, the debtor files a final plan summary on the court's form.
deadline final-plan-summary-period: 14.days after ConfirmationRecommended() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 3015-2(d), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 3015-2(d): if the trustee files a notice to correct the final plan
/// summary, debtor's counsel files a corrected summary within 10 days of the
/// notice.
deadline corrected-plan-summary-period: 10.days after CorrectionNoticeFiled() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 3015-2(d), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 3015-2(e): the confirmation order's negative notice provision lets a
/// creditor with an allowed unsecured claim object to the treatment of
/// unsecured claims within 21 days of the order's entry.
deadline unsecured-treatment-objection-period: 21.days after ConfirmationOrderEntered() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 3015-2(e), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 4001-1(b): all affidavits or other pleadings on a motion for relief
/// from stay are filed and served on all adverse parties at least 7 days
/// prior to the hearing.
deadline stay-relief-affidavit-period: 7.days before StayReliefHearing() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 4001-1(b), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 4001-1(c): an attorney seeking foreclosure or repossession files the
/// fact summary at least 7 days before the hearing on the motion.
deadline fact-summary-period: 7.days before StayReliefHearing() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 4001-1(c), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 4001-2(e): an amended or supplemental proof of claim for postpetition
/// arrearage or fees authorized by a conditional denial order is filed within
/// 60 days of the order's entry.
deadline conditional-denial-claim-period: 60.days after ConditionalDenialEntered() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 4001-2(e), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 4001-2(f): when the denial is conditioned on direct payments to the
/// creditor, the cure period after notice of default is at least 20 days
/// from the date of mailing.
deadline direct-payment-cure-period: 20.days after DirectPaymentDefaultMailed() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 4001-2(f), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 4001-2(g): when the denial is conditioned on plan payments to the
/// trustee, the cure period after notice of default is at least 15 days from
/// the date of mailing.
deadline plan-payment-cure-period: 15.days after PlanPaymentDefaultMailed() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 4001-2(g), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 4004-1: if the chapter 12 or 13 debtor's motion for discharge and
/// certifications are not filed within 21 days after the trustee files the
/// notice of completion, the court may close the case without a discharge.
deadline discharge-motion-period: 21.days after PlanCompletionNoticeFiled() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 4004-1, July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 9007-1(b)(3): the number of days placed in the negative notice legend
/// for a written objection is 21 days from the date of service, except as
/// (A) and (B) provide.
deadline negative-notice-objection-period: 21.days after NegativeNoticeServed() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 9007-1(b), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}
/// LBR 9007-1(b)(3)(B): for an objection to a proof of claim under FRBP 3007
/// on negative notice, the time to object is 30 days.
deadline claim-objection-response-period: 30.days after ClaimObjectionServed() counted_by frbp9006-alabama cite ?("S.D. Ala. LBR 9007-1(b), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {}

start matter-served

state matter-served: "Matter served with the negative notice legend" by applicant cite ?("S.D. Ala. LBR 9007-1(b), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {
  note "A motion, objection or other matter the court's administrative order lists is filed in CM/ECF with proof of service and the negative notice legend; the legend's time to object is 21 days from service, 14 days for an FRBP 4001(d) agreement and 30 days for a claim objection (LBR 9007-1(b)(3); the OCR text's values). No motion against the United States may use the procedure (LBR 9007-1(f))."
  edge-matter-served-objection "Written objection stating its grounds filed" -> objected {
    authority cite ?("S.D. Ala. LBR 9007-1(c), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified")
  }
  edge-matter-served-unopposed "No objection within the time permitted" -> ruling {
    authority cite ?("S.D. Ala. LBR 9007-1(d), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified")
  }
}

state objected: "Objection filed; hearing scheduled" by opponent cite ?("S.D. Ala. LBR 9007-1(c), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {
  note "The court schedules a hearing upon notice to the movant's attorney, the objecting parties and others as appropriate (LBR 9007-1(c))."
  edge-objected-hearing "Hearing held" -> ruling {
    authority cite ?("S.D. Ala. LBR 9007-1(c), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified")
  }
}

decision ruling: "Matter decided" by court cite ?("S.D. Ala. LBR 9007-1(d), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {
  note "Unopposed, the court may consider the matter without further notice or hearing, on a proposed order reciting the service, the absence of objection and that the matter is unopposed (LBR 9007-1(d)-(e)); it may still deny the matter or hold a hearing."
  edge-ruling-granted "Granted" -> decided {
    authority cite ?("S.D. Ala. LBR 9007-1(e), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified")
  }
  edge-ruling-denied "Denied" -> decided {
    authority cite ?("S.D. Ala. LBR 9007-1(d), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified")
  }
}

terminal decided: "Matter decided: the case continues under lit/frbp" outcome [procedural] cite ?("S.D. Ala. LBR 9029-3(a), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified") {
  note "The Local Rules govern practice and procedure in all cases and proceedings in the court; in all cases they do not provide for, the court may regulate its practice consistently with them and the FRBP (LBR 9029-3(a), (c); the OCR text)."
}

test "payment advices period: 7 days before" cite "S.D. Ala. LBR 1007-1(d), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified"
{
  given FirstMeetingDate() on 2027-01-04
  expect deadline(payment-advices-period) == 2026-12-28
}

test "conversion final report period: 30 days after" cite "S.D. Ala. LBR 1019-1, July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified"
{
  given TrusteeChecksCleared() on 2027-01-04
  expect deadline(conversion-final-report-period) == 2027-02-03
}

test "examination production period: 21 days after" cite "S.D. Ala. LBR 2004-1(c), July 1, 2026 rules: OCR extract of an image scan, verify numbers; the value is the vendored OCR text, unverified"
{
  given ExaminationNoticeServed() on 2027-01-04
  expect deadline(examination-production-period) == 2027-01-25
}

