// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-mi-trial-court

import outline-mi-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start complaint-filed

state complaint-filed: "Complaint Filed" by applicant cite ?("MCR 2.101")
{
  note "OUTLINE. Civil action commenced by filing complaint (MCR 2.101; verify). Venue is a hole until verified."
  edge-complaint-filed-service "Served" -> service-made {
    authority cite ?("MCR 2.102, 2.105")
  }
}

state service-made: "Served" by applicant cite ?("MCR 2.102, 2.105")
{
  note "OUTLINE. Summons (MCR 2.102) and service (MCR 2.105; verify). Service period is a hole (?)."
  edge-service-made-response "Served in time" -> response-due { event ActionCommenced()
    authority cite ?("MCR 2.102, 2.105")
  }
  edge-service-made-lapsed "Not served in time" -> service-dismissal {
    authority cite ?("MCR 2.102")
  }
}

decision response-due: "Answer, pleading challenge, or nothing" by office cite ?("MCR 2.108")
{
  note "OUTLINE. Answer due 21 days after service (MCR 2.108; verify period). Affirmative defenses (MCR 2.111; verify)."
  edge-response-due-answer "Answer filed" -> answered {
    authority cite ?("MCR 2.108")
  }
  edge-response-due-pleading "Pleading challenge filed" -> pleading-motion {
    authority cite ?("MCR 2.116(C)(7), (C)(8)")
  }
  edge-response-due-default "No response" -> default-request {
    authority cite ?("MCR 2.603(A)")
  }
}

state pleading-motion: "Motion for summary disposition under MCR 2.116(C)(7) or (C)(8)" by office cite ?("MCR 2.116(C)(7), (C)(8)")
{
  note "OUTLINE. Summary disposition motions (MCR 2.116; verify subrules). Notice and response periods are holes (?). Verify: Maiden v. Rozwood, 461 Mich. 109 (1999)."
  edge-pleading-motion-ruling "Court rules" -> pleading-ruling {
    authority cite ?("MCR 2.116(C)(7), (C)(8)")
  }
}

decision pleading-ruling: "Ruling on pleading challenge" by court cite ?("MCR 2.116(C)(7), (C)(8)")
{
  note "OUTLINE. Leave to amend is governed by the amendment rule (cite below). Verify leading decisions before use."
  edge-pleading-ruling-dismissed "Dismissed with prejudice" -> dismissed-merits {
    authority cite ?("MCR 2.116(C)(7), (C)(8)")
  }
  edge-pleading-ruling-leave "Dismissed with leave to amend" -> amended {
    authority cite ?("MCR 2.118")
  }
  edge-pleading-ruling-denied "Denied" -> answered {
    authority cite ?("MCR 2.108")
  }
}

state amended: "Amended pleading filed" by applicant cite ?("MCR 2.118")
{
  note "OUTLINE. Response period to the amended pleading is a hole (?)."
  edge-amended-response "Amended pleading served" -> response-due { event ActionCommenced()
    authority cite ?("MCR 2.108")
  }
}

state answered: "Answer filed" by applicant cite ?("MCR 2.108")
{
  note "OUTLINE. Affirmative defenses must be pleaded (cite below); discovery opens after pleadings close."
  edge-answered-discovery "Pleadings closed" -> discovery {
    authority cite ?("MCR 2.302, 2.306, 2.312, 2.314")
  }
}

state default-request: "Default sought" by applicant cite ?("MCR 2.603(A)")
{
  note "OUTLINE. Default entered by clerk (MCR 2.603(A); verify). Default judgment (MCR 2.603(B); verify). Setting aside (MCR 2.603(D); verify)."
  edge-default-request-entered "Default entered" -> default-entered {
    authority cite ?("MCR 2.603(A)")
  }
  edge-default-request-answered "Answer filed before default" -> answered {
    authority cite ?("MCR 2.108")
  }
}

state default-entered: "Default entered" by applicant cite ?("MCR 2.603(B)")
{
  note "OUTLINE. Default judgment requires proof of the claim; a hearing may be needed for damages (verify). Setting aside is a hole until verified."
  edge-default-entered-judgment "Default judgment sought" -> default-judgment {
    authority cite ?("MCR 2.603(B)")
  }
  edge-default-entered-set-aside "Defendant moves to set aside" -> set-aside-ruling {
    authority cite ?("MCR 2.603(D)")
  }
}

decision set-aside-ruling: "Set aside the default?" by court cite ?("MCR 2.603(D)")
{
  note "OUTLINE. Standard and any time limit are holes until verified."
  edge-set-aside-granted "Set aside" -> answered {
    authority cite ?("MCR 2.603(D)")
  }
  edge-set-aside-refused "Refused" -> default-judgment {
    authority cite ?("MCR 2.603(D)")
  }
}

state discovery: "Discovery" by applicant cite ?("MCR 2.302, 2.306, 2.312, 2.314")
{
  note "OUTLINE. Scope (MCR 2.302(B); verify). Depositions, production and requests for admission (MCR 2.306, 2.312, 2.314; verify each). Discovery period is a hole (?)."
  edge-discovery-dispute "Discovery dispute" -> discovery-ruling {
    authority cite ?("MCR 2.302, 2.306, 2.312, 2.314")
  }
  edge-discovery-sj "Dispositive motion" -> sj-motion {
    authority cite ?("MCR 2.116(C)(10)")
  }
  edge-discovery-settled "Settled" -> settled {
    authority cite ?("MCR 2.504(A)")
  }
  edge-discovery-voluntary "Voluntary dismissal" -> voluntary-dismissal {
    authority cite ?("MCR 2.504(A)")
  }
  edge-discovery-inactive "No prosecution" -> inactivity-dismissal {
    authority cite ?("MCR 2.502")
  }
}

decision discovery-ruling: "Discovery ruling" by court cite ?("MCR 2.313")
{
  note "OUTLINE. Meet-and-confer and sanction prerequisites are holes until verified."
  edge-discovery-ruling-resolved "Dispute resolved" -> discovery {
    authority cite ?("MCR 2.302, 2.306, 2.312, 2.314")
  }
  edge-discovery-ruling-sanction "Sanction dismissal" -> sanction-dismissal {
    authority cite ?("MCR 2.313")
  }
}

state sj-motion: "Summary judgment motion" by office cite ?("MCR 2.116(C)(10)")
{
  note "OUTLINE. No genuine issue of material fact (MCR 2.116(C)(10); verify). Verify: Maiden v. Rozwood, 461 Mich. 109 (1999); Spiek v. Department of Transportation, 456 Mich. 331 (1998)."
  edge-sj-motion-ruling "Motion heard" -> sj-ruling {
    authority cite ?("MCR 2.116(C)(10)")
  }
}

decision sj-ruling: "Summary judgment ruling" by court cite ?("MCR 2.116(C)(10)")
{
  note "OUTLINE. Partial summary judgment availability is a hole until verified."
  edge-sj-ruling-defense "Granted for defendant" -> sj-defense {
    authority cite ?("MCR 2.116(C)(10)")
  }
  edge-sj-ruling-applicant "Granted for applicant" -> judgment-for-applicant {
    authority cite ?("MCR 2.610")
  }
  edge-sj-ruling-denied "Denied" -> trial-setting {
    authority cite ?("MCR 2.508, 2.513")
  }
}

state trial-setting: "Trial setting and jury request" by office cite ?("MCR 2.508, 2.513")
{
  note "OUTLINE. Jury demand (MCR 2.508; period is a hole (?), verify). Findings in non-jury trials (MCR 2.513; verify)."
  edge-trial-setting-result "Tried" -> trial-result {
    authority cite ?("MCR 2.508, 2.513")
  }
}

decision trial-result: "Judgment after trial" by court cite ?("MCR 2.610")
{
  note "OUTLINE. Post-trial motion periods are holes (?) until verified."
  edge-trial-result-applicant "Judgment for applicant" -> judgment-for-applicant {
    authority cite ?("MCR 2.610")
  }
  edge-trial-result-defense "Judgment for defendant" -> verdict-for-defendant {
    authority cite ?("MCR 2.610")
  }
  edge-trial-result-post "Post-trial motion filed" -> post-trial { event JudgmentEntered()
    authority cite ?("MCR 2.611, 2.612")
  }
}

decision post-trial: "Post-trial motion ruling" by court cite ?("MCR 2.611, 2.612")
{
  note "OUTLINE. Grounds and time limits are holes until verified. Leading decisions: verify."
  edge-post-trial-new-trial "New trial granted" -> trial-setting {
    authority cite ?("MCR 2.611, 2.612")
  }
  edge-post-trial-applicant "Denied; applicant's judgment stands" -> judgment-for-applicant {
    authority cite ?("MCR 2.610")
  }
  edge-post-trial-defense "Denied; defendant's judgment stands" -> verdict-for-defendant {
    authority cite ?("MCR 2.610")
  }
}

terminal service-dismissal: "Dismissed for failure to serve" outcome [loss] cite ?("MCR 2.102")
{
  note "OUTLINE. Service period and refiling effect are holes (?)."
  payoff ?
}

terminal dismissed-merits: "Dismissed on the pleadings" outcome [loss] cite ?("MCR 2.116(C)(7), (C)(8)")
{
  note "OUTLINE. Appeal route: see the state's appellate court packages."
  payoff ?
}

terminal default-judgment: "Default judgment" outcome [win] cite ?("MCR 2.603(B)")
{
  note "OUTLINE. Damages and costs are holes."
  payoff ?
}

terminal sanction-dismissal: "Dismissed as discovery sanction" outcome [loss] cite ?("MCR 2.313")
{
  note "OUTLINE. Sanction prerequisites are holes until verified."
  payoff ?
}

terminal inactivity-dismissal: "Dismissed for inactivity" outcome [loss] cite ?("MCR 2.502")
{
  note "OUTLINE. Period of inactivity and any notice requirement are holes (?)."
  payoff ?
}

terminal voluntary-dismissal: "Voluntary dismissal" outcome [neutral] cite ?("MCR 2.504(A)")
{
  note "OUTLINE. Effect of dismissal on refiling is a hole until verified."
  payoff ?
}

terminal settled: "Settled" outcome [neutral] cite ?("MCR 2.504(A)")
{
  note "OUTLINE. Terms are holes."
  payoff ?
}

terminal sj-defense: "Summary judgment for defendant" outcome [loss] cite ?("MCR 2.116(C)(10)")
{
  note "OUTLINE. Appeal route: see the state's appellate court packages."
  payoff ?
}

terminal judgment-for-applicant: "Judgment for applicant" outcome [win] cite ?("MCR 2.610")
{
  note "OUTLINE. Costs, interest and fee recovery are holes."
  payoff ?
}

terminal verdict-for-defendant: "Judgment or verdict for defendant" outcome [loss] cite ?("MCR 2.610")
{
  note "OUTLINE. Costs are holes."
  payoff ?
}
