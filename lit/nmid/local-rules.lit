test "exhibit removal no appeal: 14 days after the trigger" cite "D.N.M.I. LR 79.1(b)"
{
  given AppealTimeExpired() on 2026-11-02
  expect deadline(exhibit-removal-no-appeal) == 2026-11-16
}

test "exhibit removal after mandate: 14 days after the trigger" cite "D.N.M.I. LR 79.1(b)"
{
  given MandateIssued() on 2026-11-02
  expect deadline(exhibit-removal-after-mandate) == 2026-11-16
}

test "unclaimed exhibit period: 21 days after the trigger" cite "D.N.M.I. LR 79.1(c)"
{
  given ExhibitRemovalTimeArrived() on 2026-11-02
  expect deadline(unclaimed-exhibit-period) == 2026-11-23
}

test "unsealing period: 120 days after the trigger" cite "D.N.M.I. LR 79.2(c)"
{
  given SealingOrderEntered() on 2026-11-02
  expect deadline(unsealing-period) == 2027-03-02
}

test "temporary admission termination notice: 14 days after the trigger" cite "D.N.M.I. LR 83.5(d)"
{
  given QualifyingEmploymentEnded() on 2026-11-02
  expect deadline(temporary-admission-termination-notice) == 2026-11-16
