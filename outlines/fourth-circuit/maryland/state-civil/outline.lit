// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-outline-md-state-civil

start filed

state filed: "Complaint filed" by applicant cite ?("Md. Rule 2-101")
{
  note "OUTLINE. Commencement by filing. Tolling of the appeal period: Md. Rule 8-202(c). Circuit court rule numbers are to be verified."
  edge-filed-served "Defendant served" -> served {
    authority cite ?("Md. Rule 2-121")
  }
}

decision served: "Response due" by office cite ?("Md. Rule 2-321(a)")
{
  note "OUTLINE. Response period is a hole. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-served-answer "Answer filed" -> answered {
    authority cite ?("Md. Rule 2-321(a)")
  }
  edge-served-motion "Motion to dismiss under Md. Rule 2-322" -> motion-pending {
    authority cite ?("Md. Rule 2-322")
  }
  edge-served-default "No response by the deadline" -> default-entered {
    authority cite ?("Md. Rule 2-613(a)")
  }
}

state motion-pending: "Pleading motion pending" by applicant cite ?("Md. Rule 2-322")
{
  note "OUTLINE. Motion to dismiss under Md. Rule 2-322. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-motion-ruling "Court rules" -> motion-ruling {
  }
}

chance motion-ruling: "Ruling on pleading motion" by court cite ?("Md. Rule 2-322")
{
  note "OUTLINE. Probabilities are holes; no calibration."
  edge-mr-dismissed "Dismissed" -> dismissed-pleading p ? {
  }
  edge-mr-leave "Dismissed with leave to amend" -> amend p ? {
  }
  edge-mr-denied "Denied" -> answered p ? {
  }
}

state amend: "Amended pleading" by applicant cite ?("Md. Rule 2-341")
{
  note "OUTLINE. Amendment period and consent are holes."
  edge-amend-motion "Amended pleading tested again" -> motion-pending {
  }
}

state default-entered: "Default entered" by office cite ?("Md. Rule 2-613(a)")
{
  note "OUTLINE. Default entry. Setting it aside: Md. Rule 2-535 (verify)."
  edge-default-judgment "Default judgment sought" -> default-judgment {
    authority cite ?("Md. Rule 2-613(b) (verify)")
  }
  edge-default-vacate "Default vacated" -> answered {
    authority cite ?("Md. Rule 2-535 (verify)")
  }
}

terminal default-judgment: "Default judgment entered" outcome [loss] cite ?("Md. Rule 2-613(b) (verify)")
{
  note "OUTLINE. Default judgment. Damages hearing and proof are holes."
  payoff ?
}

terminal dismissed-pleading: "Dismissed on the pleadings" outcome [loss] cite ?("Md. Rule 2-322")
{
  note "OUTLINE. Dismissal on a pleading motion. Appeal period is a hole. Leading decisions for this stage: not yet identified in this pass; verify before use."
  payoff ?
}

state answered: "Answer filed" by applicant cite ?("Md. Rule 2-323")
{
  note "OUTLINE. Answer and affirmative defenses."
  edge-answered-discovery "Case proceeds to discovery" -> discovery {
    authority cite ?("Md. Rule 2-402")
  }
}

state discovery: "Discovery" by applicant cite ?("Md. Rule 2-402")
{
  note "OUTLINE. Written discovery, depositions, expert disclosure. Scope and limits are holes."
  edge-disc-dispute "Discovery dispute" -> dispute {
    authority cite ?("Md. Rule 2-432")
  }
  edge-disc-sj "Dispositive motion" -> sj-motion {
    authority cite ?("Md. Rule 2-501")
  }
  edge-disc-settle "Settlement" -> settled {
  }
}

decision dispute: "Discovery dispute ruling" by court cite ?("Md. Rule 2-432")
{
  note "OUTLINE. Sanctions: Md. Rule 2-433. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-dispute-resolved "Dispute resolved" -> discovery {
  }
  edge-dispute-sanction "Dismissal as a sanction" -> dismissed-sanction {
    authority cite ?("Md. Rule 2-433")
  }
}

terminal dismissed-sanction: "Dismissed as a discovery sanction" outcome [loss] cite ?("Md. Rule 2-433")
{
  note "OUTLINE. Dismissal as a sanction. Leading decisions for this stage: not yet identified in this pass; verify before use."
  payoff ?
}

state sj-motion: "Summary judgment motion" by applicant cite ?("Md. Rule 2-501")
{
  note "OUTLINE. Summary judgment standard and timing are holes. Leading decisions for this stage: not yet identified in this pass; verify before use."
  edge-sj-ruling "Motion decided" -> sj-ruling {
  }
}

chance sj-ruling: "Summary judgment ruling" by court cite ?("Md. Rule 2-501")
{
  note "OUTLINE. Probabilities are holes."
  edge-sjr-granted "Granted" -> judgment-entered p ? {
  }
  edge-sjr-denied "Denied" -> pretrial p ? {
  }
}

state pretrial: "Pretrial conference and motions in limine" by court cite ?("Md. Rule 2-504 (verify)")
{
  note "OUTLINE. Pretrial conference and trial setting are holes."
  edge-pre-settle "Settlement" -> settled {
  }
  edge-pre-trial "Trial" -> trial {
    authority cite ?("Md. Rule 2-511 (verify)")
  }
}

state trial: "Trial" by court cite ?("Md. Rule 2-511 (verify)")
{
  note "OUTLINE. Trial by jury or the court. Jury demand timing is a hole."
  edge-trial-verdict "Verdict or decision" -> verdict {
  }
}

chance verdict: "Verdict or decision" by court cite ?("Md. Rule 2-522 (verify)")
{
  note "OUTLINE. Probabilities are holes."
  edge-v-favorable "For applicant" -> judgment-entered p ? {
  }
  edge-v-adverse "For opponent" -> judgment-entered p ? {
  }
}

decision judgment-entered: "Judgment entered" by office cite ?("Md. Rule 2-601")
{
  note "OUTLINE. Entry of judgment. Costs and fees are holes."
  edge-jud-post "Post-trial motion" -> post-trial {
    authority cite ?("Md. Rule 2-532, 2-533, 2-534")
  }
  edge-jud-appeal "Notice of appeal" -> appeal-noticed {
    authority cite ?("Md. Rule 8-202(a)")
  }
  edge-jud-final "No further action" -> judgment-final {
    authority cite ?("Md. Rule 2-601")
  }
}

state post-trial: "Post-trial motion" by applicant cite ?("Md. Rule 2-532, 2-533, 2-534")
{
  note "OUTLINE. Post-trial motion periods are holes. Relief from judgment: Md. Rule 2-535."
  edge-post-ruling "Motion decided" -> post-ruling {
  }
}

chance post-ruling: "Ruling on post-trial motion" by court cite ?("Md. Rule 2-532, 2-533, 2-534")
{
  note "OUTLINE. Probabilities are holes."
  edge-pr-retrial "New trial" -> trial p ? {
  }
  edge-pr-denied "Denied" -> judgment-entered p ? {
  }
}

terminal settled: "Settled or dismissed" outcome [settle] cite ?("Md. Rule 2-402")
{
  note "OUTLINE. Settlement or voluntary dismissal. Payoff is a hole."
  payoff ?
}

terminal judgment-final: "Judgment final in trial court" outcome [final] cite ?("Md. Rule 2-601")
{
  note "OUTLINE. Final judgment. Appeal is governed by the state-appellate package."
  payoff ?
}

terminal appeal-noticed: "Notice of appeal filed" outcome [appeal] cite ?("Md. Rule 8-202(a)")
{
  note "OUTLINE. Appeal to the state appellate court; see the state-appellate package."
  payoff ?
}

