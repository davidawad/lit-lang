module ptab.post-institution

import ptab.deadlines.{ patent-owner-response-period }
import ptab.trial-to-appeal.{ patent-owner-response-window, settlement-decision }
import ptab.{ post-institution-group }

state scheduling-order-issued: "Scheduling Order Issued" cite 37 CFR 42.5(c); 35 U.S.C. 316(a)(11)
{
  group post-institution-group
  note "Sets Due Dates 1-7 (POR, MTA, reply, sur-reply, hearing) against the 1-year statutory FWD deadline, extendable to 18 months for good cause or joinder. Rule-set default times serve as a baseline but may be modified by Board order (37 CFR 42.5(c)(1))."
  _ "Exchange mandatory initial disclosures" -> mandatory-disclosures {
    authority cite 37 CFR 42.51(a)
  }
  _ "Settle right after scheduling" -> settlement-decision { authority cite 35 U.S.C. 317 }
}

state mandatory-disclosures: "Mandatory Initial Disclosures Exchanged" cite 37 CFR 42.51(a)
{
  group post-institution-group
  note "Routine discovery categories requiring no Board authorization: relied-upon exhibits, cross-examination scheduling for affidavits, and information inconsistent with a party's stated position. Anything beyond these narrow categories requires party agreement or a motion under 37 CFR 42.51(b)(2)."
  _ "Move for additional discovery" -> additional-discovery-motion {
    authority cite 37 CFR 42.51(b)(2)
  }
  _ "Disclosures complete — no motion needed" -> patent-owner-response-window {
    authority cite 37 CFR 42.120(b)
    within patent-owner-response-period {
      extendable true
      extension_authority "37 CFR 42.5(c)(2)"
      note "Patent Owner Response due 3 months from the institution date. Extensions require a showing of good cause per 37 CFR 42.5(c)(2). Missing this deadline without an extension waives the response and may preclude arguments at trial."
    }
    duration { min 13.5.days, mode 45.days, max 90.days }
  }
  _ "Designate exchanged material confidential" -> protective-order-ipr {
    authority cite 37 CFR 42.54(a)
  }
}

/// Tribunal discretion: additional discovery is granted only "in the
/// interests of justice" (37 C.F.R. § 42.51(b)(2)). The pack authors the
/// grant/deny draw (0.3/0.7); its renew and settle moves carry none.
/// The Board's ruling on the motion, not a party's choice. Either way the
/// case reaches `patent-owner-response-window`, where settlement stays open.
chance additional-discovery-motion: "Motion for Additional Discovery" by examiner discretion cite ?("37 CFR 42.51(b)(2); Garmin Ltd. v. Cuozzo Speed Tech. LLC, IPR2012-00001, Paper 26") {
  group post-institution-group
  note "Beyond routine categories, discovery in IPR requires a showing that it serves 'the interests of justice,' applying the five-factor Garmin test (claim complexity, evidence availability, delay, burden/cost, non-moving party's position); PGR uses the more permissive 'good cause' standard. Each motion is fact-intensive and case-specific."
  _ "Board grants additional discovery" -> protective-order-ipr p 0.3 {
    authority cite 37 CFR 42.51(b)(2); 37 CFR 42.54(a)
  }
  _ "Board denies additional discovery" -> patent-owner-response-window p 0.7 {
    authority cite 37 CFR 42.51(b)(2); 37 CFR 42.120
    within patent-owner-response-period {
      extendable true
      extension_authority "37 CFR 42.5(c)(2)"
      note "The Patent Owner Response deadline (90 days from institution) remains unaffected by a discovery motion denial. Failure to extend if needed results in waiver of the response and preclusion at trial."
    }
    duration { min 13.5.days, mode 45.days, max 90.days }
  }
}

state protective-order-ipr: "Protective Order Governs Discovery" by office cite 37 CFR 42.54(a)
{
  group post-institution-group
  note "Default protective order (Trial Practice Guide model order) governs confidential material exchanged in discovery unless the parties stipulate to or move for different terms; restricts disclosure to designated personnel and bars public filing without Board authorization."
  _ "Discovery proceeds under protective order" -> patent-owner-response-window {
    authority cite 37 CFR 42.54(a); 37 CFR 42.120
    within patent-owner-response-period {
      extendable true
      extension_authority "37 CFR 42.5(c)(2)"
      note "Patent Owner Response must comply with protective order terms while still meeting the 90-day deadline from institution. Extensions require good cause; confidentiality restrictions do not excuse untimeliness."
    }
    duration { min 13.5.days, mode 45.days, max 90.days }
  }
}
