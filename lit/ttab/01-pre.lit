// Imported by `litigate import` from packs/ttab-trademark-trial-and-appeal-board.json.
module ttab.pre

import ttab.opposition-to-trial.{ opposition-filed }
import ttab.pre-2.{ opposer-d120 }
import ttab.pre-3.{ abandon-chance }
import ttab.standstill.{ standstill-period }

import ttab.{
  ExtendedPeriodExpired,
  ExtensionRequested,
  ExtensionTerm,
  first-extension-90,
  opposition-period,
  pre,
  second-extension-60,
}

start published

state published: "Application published for opposition" by opposer cite "15 USC 1063(a); 37 CFR 2.101(c)"
{
  group pre
  note "Start of the 30-day opposition period after publication (37 CFR 2.101(c)). A matter scenario sets scenario.start to the node matching its current posture."
  tags [entry]
  _ "Opposer requests 30-day extension (granted on request)" -> ext-first-30 {
    event ExtensionRequested(Thirty)
    authority cite "37 CFR 2.102(c)(1)(i)"
    within opposition-period { extendable true, extension_authority "37 CFR 2.102(c)(2)-(3)" }
    attrs { opp_hours: 1 }
  }
  _ "Opposer requests 90-day extension (good cause)" -> ext-first-90 {
    event ExtensionRequested(Ninety)
    authority cite "37 CFR 2.102(c)(1)(ii)"
    within first-extension-90 { extendable true, extension_authority "37 CFR 2.102(c)(3)" }
    attrs { opp_fees: 200, opp_hours: 1 }
  }
  _ "Opposer opposes within the original 30 days" -> opposition-filed {
    authority cite "37 CFR 2.101(c)"
    within opposition-period { extendable true, extension_authority "37 CFR 2.102(c)" }
    note "Notice of opposition via ESTTA with $600 per class fee (37 CFR 2.6(a)(17)(ii)); application is Class 37 only (one class)."
    attrs { opp_fees: 600, opp_hours: 14 }
  }
}

state ext-first-30: "First extension (30 days, granted on request)" by opposer cite "37 CFR 2.102(c)(1)(i)"
{
  group pre
  _ "Opposer requests additional 60 days (good cause)" -> ext-second-60 {
    event ExtensionRequested(Sixty)
    authority cite "37 CFR 2.102(c)(2)"
    within second-extension-60 { extendable true, extension_authority "37 CFR 2.102(c)(3)" }
    attrs { opp_fees: 200, opp_hours: 1 }
  }
}

state ext-first-90: "First extension (90 days, good cause)" by board cite "37 CFR 2.102(c)(1)(ii)"
{
  group pre
  _ "Extension runs to day 120" -> period-ends-day120 {
    event ExtendedPeriodExpired()
    authority cite "37 CFR 2.102(c)"
    duration { min 0.days, mode 0.days, max 0.days }
  }
}

state ext-second-60: "Second extension (additional 60 days, good cause)" by board cite "37 CFR 2.102(c)(2)"
{
  group pre
  _ "Extensions run to day 120" -> period-ends-day120 {
    event ExtendedPeriodExpired()
    authority cite "37 CFR 2.102(c)"
    duration { min 0.days, mode 0.days, max 0.days }
  }
}

decision period-ends-day120: "Day 120: opposition period expires unless the applicant consents to the final 60-day extension" by applicant cite ?("37 CFR 2.102(c)(3); TBMP 207.03") {
  group pre
  note "Day 120 from publication. The final 60 days (to day 180) is available only on the applicant's written consent or a showing of extraordinary circumstances; settlement talks, letters of protest, pending amendments and civil litigation are not extraordinary (TBMP 207.03)."
  tags [entry, day120]
  _ "Consent to final 60-day extension under standstill" -> standstill-period {
    authority cite "37 CFR 2.102(c)(3)"
    effort 3.hours
    duration { min 1.days, mode 1.days, max 3.days }
    attrs { opp_hours: 2 }
  }
  _ "Refuse consent; let the period expire" -> opposer-d120 {
    authority cite "37 CFR 2.101(c); 2.102(c)(3)"
    effort 1.hours
    duration { min 0.days, mode 1.days, max 1.days }
    tags [refuse-consent]
  }
  _ "Abandon application now (before opposition)" -> abandon-chance {
    authority cite "37 CFR 2.68"
    effort 2.hours
    tags [abandon-now]
    attrs { opp_hours: 1 }
  }
}
