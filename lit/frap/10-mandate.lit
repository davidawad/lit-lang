module frap.mandate

import frap.cert.{ cert-petition-window }
import frap.{ mandate-group }

state mandate-issued: "Mandate Issues" by office cite Fed. R. App. P. 41(a)–(b)
{
  group mandate-group
  note "The mandate is the formal order returning jurisdiction to the district court — distinct from the opinion and critical for enforcing the judgment. It issues automatically 7 days after either expiration of the rehearing period or denial of a timely rehearing petition. The mandate, not the opinion, is what actually binds the district court."
  _ "Judgment final — cert clock runs" -> cert-petition-window {
    authority cite ?("Fed. R. App. P. 41(b); Sup. Ct. R. 13.3")
    deadline 90.days {
      extendable true
      extension_authority "Sup. Ct. R. 13.6"
      note "The 90-day deadline is measured from the date the appellate opinion is filed/docketed. Missing this deadline forecloses any Supreme Court review; the judgment becomes final and enforceable. Extensions require filing before the deadline expires."
    }
    duration { min 13.5.days, mode 45.days, max 90.days }
  }
  _ "Move to stay mandate for cert" -> mandate-stayed-pending-cert by applicant {
    authority cite Fed. R. App. P. 41(d)(1)
    effort 8.hours
    note "Hours: BigLaw-honest estimate for the effort of this move; basis: estimate."
  }
}

state mandate-stayed-pending-cert: "Mandate Stayed Pending Certiorari" by examiner cite Fed. R. App. P. 41(d)(1)–(2)
{
  group mandate-group
  note "On motion, the court of appeals may stay its mandate pending a cert petition — otherwise the district court could enforce the judgment while the Supreme Court is still deciding whether to take the case. The stay is discretionary and requires a showing of likelihood of cert grant plus irreparable harm."
  _ "Stay granted — cert proceeds" -> cert-petition-window {
    authority cite Fed. R. App. P. 41(d)(2)
    deadline 90.days {
      extendable true
      extension_authority "Sup. Ct. R. 13.6"
      note "If cert is denied or the 90-day window expires (whichever is earlier), the stay terminates automatically and the mandate issues to enforce the judgment."
    }
    duration { min 13.5.days, mode 45.days, max 90.days }
  }
}
