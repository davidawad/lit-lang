// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-or-tax-court

import outline-or-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start commenced

state commenced: "Complaint, petition or appeal filed" by applicant cite ?("ORS 305.280 (verify)")
{
  note "OUTLINE. Appeals begin in the Magistrate Division (ORS 305.501); the Regular Division tries de novo (ORS 305.560); the Supreme Court hears appeals (verify). Commencement in the Oregon Tax Court: filing period, fees and pleading form are holes. Leading decisions: not yet identified in this pass; verify before use."
  edge-commenced-served "Process served" -> pleadings { event ActionCommenced() authority cite ?("TCR 7 (verify)") }
}

chance pleadings: "Answer or motion to dismiss" by court cite ?("TCR 21 (verify)")
{
  note "OUTLINE. Response period and dismissal grounds are holes."
  edge-pleadings-dismissed "Dismissed on the pleadings" -> dismissed p ? { authority cite ?("TCR 21 (verify)") }
  edge-pleadings-answered "Answered; case proceeds" -> discovery p ? { authority cite ?("TCR 21 (verify)") }
  edge-pleadings-settled "Settled or withdrawn" -> settled p ? { }
}

state discovery: "Discovery and pretrial" by applicant cite ?("TCR 36 (verify)")
{
  note "OUTLINE. Discovery scope, limits and scheduling are holes."
  edge-discovery-dispositive "Dispositive motion or trial setting" -> dispositive { authority cite ?("TCR 47 (verify)") }
}

chance dispositive: "Summary disposition?" by court cite ?("TCR 47 (verify)")
{
  note "OUTLINE. Summary-judgment standard and timing are holes."
  edge-dispositive-granted "Decided without trial" -> judgment p ? { authority cite ?("TCR 47 (verify)") }
  edge-dispositive-trial "Tried" -> trial p ? { authority cite ?("ORS 305.425 (verify)") }
}

state trial: "Trial or hearing" by court cite ?("ORS 305.425 (verify)")
{
  note "OUTLINE. Jury availability and trial procedure are holes."
  edge-trial-judgment "Decision rendered" -> judgment { authority cite ?("TCR 67 (verify)") }
}

state judgment: "Judgment or decision entered" by court cite ?("TCR 67 (verify)")
{
  note "OUTLINE. Entry, notice of entry and post-judgment motion periods are holes."
  edge-judgment-entered "Judgment entered" -> post-judgment { event JudgmentEntered() authority cite ?("TCR 67 (verify)") }
}

decision post-judgment: "Appeal or review?" by applicant cite ?("ORS 305.445 (verify)")
{
  note "OUTLINE. The appeal period and the court that hears it are holes."
  edge-post-appeal "Appeal or petition for review filed" -> appeal-taken { event NoticeOfAppealFiled() authority cite ?("ORS 305.445 (verify)") }
  edge-post-final "No appeal" -> final-no-appeal { }
}

terminal dismissed: "Dismissed" outcome [loss, dismissal] cite ?("TCR 21 (verify)")
{
  note "OUTLINE. With or without prejudice is a hole."
  payoff ?
}

terminal settled: "Settled or withdrawn" outcome [settlement] cite ?("ORS 305.280 (verify)")
{
  note "OUTLINE. Settlement terms are outside this outline."
  payoff ?
}

terminal appeal-taken: "Appeal or review taken" outcome [final] cite ?("ORS 305.445 (verify)")
{
  note "OUTLINE. The reviewing court is its own package."
  payoff ?
}

terminal final-no-appeal: "Judgment final without appeal" outcome [final] cite ?("TCR 67 (verify)")
{
  note "OUTLINE. Enforcement is outside this outline."
  payoff ?
}
