terminal lost: "Lost" cite ?("Doctrine of laches") { group pleading-group, payoff -350_000.usd }
==> lit/demo/Lit.toml <- tests/fixtures/demo-pack.json
# Imported by `litigate import` from tests/fixtures/demo-pack.json.
# in_force and authority are placeholders: legacy JSON records neither.
[package]
name = "demo-court"
version = "0.1.0"
language = 1
pack_id = "demo-court"
forum = "demo"
authority = "Unclassified"
title = "Demo court"
description = "Every construct the importer spells."
jurisdiction = "Nowhere"
in_force = "0001-01-01"
known_at = "2024-12-01"
counting = "demo6"

[package.roles]
applicant = "self"
either = "nature"
examiner = "opponent"
office = "nature"

[sources.demo-rules]
title = "Demo Rules"
url = "https://example.org/rules"
path = "sources/demo.txt"
sha256 = "abc"
as_of = "2024-12-01"

[[cite_syntax.rules]]
prefixes = ["DR", "Demo R."]
heading = "Rule {}"
source = "demo-rules"

[[cite_syntax.shorthands]]
prefix = "cfr"
code = "cfr"
title = 19
section_parts = 2
source = "demo-rules"
