module ttab-board-order

import ttab.{ answer-period, counterclaim-answer-period, ttab-2-196 }

start reset

/// The Board's order resetting the time to answer (37 C.F.R. § 2.106(a)).
/// Its date is the order's; `due` is the date it sets.
event AnswerTimeReset(due: Date)

/// The answer is due on the date the order sets: it replaces the date the
/// notice of institution designated (`trigger latest`). The rule states no
/// least time for a reset, so the order may set any date from its own.
deadline answer-reset: 0.days from AnswerTimeReset() counted_by ttab-2-196 override answer-period cite "37 CFR 2.106(a)"
{
  designated due
  trigger latest
}

/// The Board's order resetting or extending the time to answer a
/// counterclaim "to enable a party fully to present or meet a
/// counterclaim" (37 C.F.R. § 2.106(b)(3)(iv)). Its date is the order's;
/// `due` is the date it sets.
event CounterclaimAnswerTimeReset(due: Date)

/// The counterclaim answer is due on the date the order sets, replacing
/// the date the Board first designated (`trigger latest`). The rule
/// states no least time for a reset.
deadline counterclaim-answer-reset: 0.days from CounterclaimAnswerTimeReset() counted_by ttab-2-196 override counterclaim-answer-period cite "37 CFR 2.106(b)(3)(iv)"
{
  designated due
  trigger latest
}

terminal reset: "Answer time reset by the Board" cite "37 CFR 2.106(a)"
{
  payoff 0.usd
}
