  note "Outcome distribution authored at 0.75 deadline holds / 0.25 continuance granted -- the pack's existing teaching estimate, APPROXIMATE, not a sourced rate."
  edge-rule12-continuance-ruling-pretrial-motions-window "Motions deadline arrives" -> pretrial-motions-window p 0.75 {
    authority cite "Fed. R. Crim. P. 12(c)(1)"
  }
  edge-rule12-continuance-ruling-rule12-deadline-set "Grant continuance" -> rule12-deadline-set p 0.25 {
    authority cite "18 U.S.C. § 3161(h)(7); Fed. R. Crim. P. 12(c)(1)"
  }
}

