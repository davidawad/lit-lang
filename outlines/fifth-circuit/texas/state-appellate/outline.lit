// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-tx-state-appellate

start judgment-signed

state judgment-signed: "Judgment signed" by applicant cite ?("Tex. R. Civ. P. 306a")
{
  note "OUTLINE. Finality and appealable judgments (Rule 306a; verify). Interlocutory appeals are limited (Tex. Civ. Prac. & Rem. Code 51.014; verify)."
  edge-judgment-signed-notice "Appeal taken within delay" -> notice-filed {
    authority cite ?("Tex. R. App. P. 26.1")
  }
  edge-judgment-signed-late "Delay missed" -> time-barred {
    authority cite ?("Tex. R. App. P. 26.1")
  }
}

state notice-filed: "Appeal taken" by applicant cite ?("Tex. R. App. P. 25.1")
{
  note "OUTLINE. Notice of appeal due 30 days after judgment, or 90 days after a timely post-judgment motion (Rule 26.1; periods are holes (?) until verified). Extension rule (Rule 26.3; verify)."
  edge-notice-filed-record "Record lodged" -> record-lodged {
    authority cite ?("Tex. R. App. P. 34.5, 34.6")
  }
}

state record-lodged: "Record lodged" by office cite ?("Tex. R. App. P. 34.5, 34.6")
{
  note "OUTLINE. Record contents and transcript deadlines are holes (?)."
  edge-record-lodged-briefs "Briefing schedule set" -> briefing {
    authority cite ?("Tex. R. App. P. 38.1")
  }
}

state briefing: "Briefs filed" by applicant cite ?("Tex. R. App. P. 38.1")
{
  note "OUTLINE. Brief length and format are holes until verified against the court's rules."
  edge-briefing-argument "Argument set" -> argument {
    authority cite ?("Tex. R. App. P. 39.1")
  }
  edge-briefing-submitted "Submitted on briefs" -> appellate-decision {
    authority cite ?("Tex. R. App. P. 43.2")
  }
}

state argument: "Oral argument" by office cite ?("Tex. R. App. P. 39.1")
{
  note "OUTLINE. Argument practice and time are holes until verified."
  edge-argument-decision "Argued" -> appellate-decision {
    authority cite ?("Tex. R. App. P. 43.2")
  }
}

decision appellate-decision: "Appellate decision" by court cite ?("Tex. R. App. P. 43.2")
{
  note "OUTLINE. Standard of review is a hole until verified. Disposition under Rule 43.2 (verify). Opinions under Rule 47 (verify). Standard of review is a hole until verified. Verify: Valence Operating Co. v. Dorsett, 164 S.W.3d 656 (Tex. 2005) (summary judgment review)."
  edge-decision-affirmed "Affirmed" -> affirmed {
    authority cite ?("Tex. R. App. P. 43.2")
  }
  edge-decision-reversed "Reversed or amended" -> reversed {
    authority cite ?("Tex. R. App. P. 43.2")
  }
  edge-decision-remanded "Remanded" -> remanded {
    authority cite ?("Tex. R. App. P. 43.2")
  }
  edge-decision-dismissed "Appeal dismissed" -> appeal-dismissed {
    authority cite ?("Tex. R. App. P. 43.2")
  }
  edge-decision-rehearing "Rehearing sought" -> rehearing-filed {
    authority cite ?("Tex. R. App. P. 49.1")
  }
}

state rehearing-filed: "Application for rehearing" by applicant cite ?("Tex. R. App. P. 49.1")
{
  note "OUTLINE. Rehearing period is a hole (?). Denial or grant is a hole until verified."
  edge-rehearing-supreme "Rehearing denied; review sought" -> supreme-review {
    authority cite ?("Tex. R. App. P. 53.2, 53.7")
  }
  edge-rehearing-decision "Rehearing granted" -> appellate-decision {
    authority cite ?("Tex. R. App. P. 43.2")
  }
}

state supreme-review: "Review or writ application to supreme court" by applicant cite ?("Tex. R. App. P. 53.2, 53.7")
{
  note "OUTLINE. Petition for review to the Supreme Court of Texas (Rule 53.2; time under Rule 53.7 is a hole, verify). Discretionary review (Tex. Gov't Code 22.001(a); verify)."
  edge-supreme-review-denied "Review denied" -> review-denied {
    authority cite ?("Tex. R. App. P. 53.2, 53.7")
  }
  edge-supreme-review-granted "Review granted" -> supreme-decided {
    authority cite ?("Tex. R. App. P. 53.2, 53.7")
  }
}

terminal time-barred: "Appeal time missed" outcome [loss] cite ?("Tex. R. App. P. 26.1")
{
  note "OUTLINE. Delay is generally jurisdictional or near-jurisdictional (verify)."
  payoff ?
}

terminal affirmed: "Affirmed" outcome [loss] cite ?("Tex. R. App. P. 43.2")
{
  note "OUTLINE. Further review: see supreme-review."
  payoff ?
}

terminal reversed: "Reversed or amended" outcome [win] cite ?("Tex. R. App. P. 43.2")
{
  note "OUTLINE. Fees and costs are holes."
  payoff ?
}

terminal remanded: "Remanded" outcome [neutral] cite ?("Tex. R. App. P. 43.2")
{
  note "OUTLINE. Remand outcome depends on the trial court's next ruling."
  payoff ?
}

terminal appeal-dismissed: "Appeal dismissed" outcome [loss] cite ?("Tex. R. App. P. 43.2")
{
  note "OUTLINE. Grounds for dismissal are holes until verified."
  payoff ?
}

terminal review-denied: "Review denied" outcome [loss] cite ?("Tex. R. App. P. 53.2, 53.7")
{
  note "OUTLINE. Denial of review ends the state appeal path."
  payoff ?
}

terminal supreme-decided: "Supreme court decided" outcome [neutral] cite ?("Tex. R. App. P. 53.2, 53.7")
{
  note "OUTLINE. Outcome is a hole until the decision is known."
  payoff ?
}
