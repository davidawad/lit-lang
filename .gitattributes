# The tree-sitter parser (editors/tree-sitter-litigate/src) is generated
# from grammar.js and grammar/*.js and committed (the crate's build.rs and
# editor packages compile src/parser.c). Two branches changing different
# grammar rules both rewrite it, so a text merge always conflicts. The
# `tsgenerate` driver (`just tree-sitter-merge-driver`, run by `just
# install` and `just lit-sync`) resolves it to ours without node or cargo;
# `just tree-sitter-generate` then regenerates it from the merged grammar,
# and `just tree-sitter-test` (in `just ci`) fails while it is stale.
editors/tree-sitter-litigate/src/parser.c merge=tsgenerate
editors/tree-sitter-litigate/src/grammar.json merge=tsgenerate
editors/tree-sitter-litigate/src/node-types.json merge=tsgenerate

# The keyword table is the one hand-edited list of keywords, a row per
# line in any order: `union` keeps both branches' additions. The editor
# files generated from it (and Helix's queries, generated from the
# canonical ones) resolve to ours the same way as the parser, and `just
# editor-queries` (run by `just tree-sitter-generate` and `just lit-sync`)
# regenerates them; `cargo test -p litigate-editors` fails while one is
# stale. `SyntaxKind`'s keyword variants are generated at build time.
crates/litigate-syntax/keywords.txt merge=union
editors/tree-sitter-litigate/queries/highlights.scm merge=tsgenerate linguist-generated=true
editors/emacs/litigate-ts-mode-keywords.el merge=tsgenerate linguist-generated=true
editors/helix/queries/litigate/highlights.scm merge=tsgenerate linguist-generated=true
editors/helix/queries/litigate/indents.scm merge=tsgenerate linguist-generated=true
editors/helix/queries/litigate/locals.scm merge=tsgenerate linguist-generated=true
editors/helix/queries/litigate/injections.scm merge=tsgenerate linguist-generated=true

# Generated by tree-sitter from grammar.js; verified by regeneration (just
# tree-sitter-test), so the land revert guard skips it (dotfiles 32578af).
editors/tree-sitter-litigate/src/** linguist-generated=true

# Changelog entries are appended independently by parallel beads.
CHANGELOG.md merge=union
