module bankr-nye-local-rules.local-rules

import core.states.new-york.{ frbp9006-new-york }
import frbp.events.{ FirstMeetingDate, OrderForReliefEntered, PetitionFiled }

// The Bankr. E.D.N.Y. court's own periods, counted under FRBP 9006(a). The
// FRBP periods (schedules, claims, discharge, dischargeability, exemption
// objections, the adversary answer and summons, appeals) are lit/frbp's and
// are not declared again.
//
// Stated in the rules but not declared: the business-day and clock-time
// periods (a responsive letter on a summary judgment pre-motion conference
// within two business days, LBR 7056-1(b); a certificate of no objection
// filed no sooner than 48 hours after the objection deadline, LBR 9075-2;
// the Clerk's one-day notice of a tenant's cure deposit, LBR 4001-4(b));
// the service of a chapter 13 plan at least 28 days before the confirmation
// hearing (LBR 3015-1(b)), which is the FRBP 2002(b) notice and lit/frbp's;
// the minimum notice a paper must give rather than a deadline of its own (a
// notice of presentment's 21 days, LBR 2002-1(c); the 7 days' notice of a
// proposed order settled after a decision and the 3 days' notice of a
// counter-proposal, LBR 9072-1(a); the 7 days' notice of an auctioneer's
// application, LBR 6005-1(e); the 60, 75 and 60 days a cash-collateral or
// financing order must afford a committee or other party to investigate,
// LBR 4001-5); the three extra days for service by first-class mail and the
// one day for overnight delivery (LBR 9006-1(c)); the return dates of
// motions to assume leases, which track 11 U.S.C. § 365(d)(1) and (4) and
// the 210-day cap (LBR 6006-1); the deemed consent to the stay of a stay
// motion returnable more than 30 days after filing (LBR 4001-1(a)); the
// stipulated 30-day extension to plead (LBR 7012-1), a cap; the recurring
// post-confirmation reports at least every six months (LBR 3021(b)); the
// valuations no more than 90 days old (LBR 2003-1(a)(iii)); a matter
// adjourned without date deemed withdrawn after 60 days and the mediator's
// discard of submissions 60 days after the report (LBR 5070-1(b),
// 9019-1(d)), court and neutral acts; and the Clerk's disposal of exhibits
// 30 days after notice (LBR 9070-1(b)).
/// Excerpts of exhibits not in electronic form, scanned and filed (LBR
/// 5005-1(b)(iv)).
limit exhibit-excerpt { pages <= 20 cite "E.D.N.Y. LBR 5005-1(b)" } cite "E.D.N.Y. LBR 5005-1(b)"
/// A letter requesting a pre-motion conference before a summary judgment
/// motion, or a responsive letter (LBR 7056-1(a), (b)).
limit pre-motion-letter { pages <= 2 cite "E.D.N.Y. LBR 7056-1(a)" } cite "E.D.N.Y. LBR 7056-1(a)"

/// The date set for the presentment of a proposed order on notice (LBR
/// 2002-1).
event PresentmentDate()
/// The first date set for confirmation of a chapter 13 plan (LBR 2003-1(b),
/// 3015-1(c), 3015-2(a)).
event Chapter13ConfirmationHearingScheduled()
/// The date of the hearing on a chapter 7 trustee's final account (LBR
/// 2016-2).
event FinalAccountHearingScheduled()
/// The summons and complaint in an adversary proceeding are served on the
/// debtor (LBR 2090-2).
event SummonsServed()
/// An amendment to the schedules that modifies a creditor's scheduled claim
/// or adds a creditor takes effect when the claims bar date has expired or
/// will expire in less than 30 days (LBR 3007-2).
event ScheduleAmendmentEffective()
/// A chapter 13 plan filed after the petition is filed (LBR 3015-1(b)).
event Chapter13PlanFiled()
/// The first date set for the hearing on confirmation of a chapter 9 or 11
/// plan (LBR 3018-1, 3020-1(a)).
event Chapter11ConfirmationHearingScheduled()
/// An order confirming a chapter 11 plan is entered (LBR 3021(a), 3022-1).
event PlanConfirmed()
/// The estate in a chapter 11 case is fully administered (LBR 3022-1).
event EstateFullyAdministered()
/// The Clerk sends the lessor notice that a debtor has complied with LBR
/// 4001-4(a) (LBR 4001-4(b)).
event CureComplianceNoticed()
/// An amendment to a claim of exemptions is served (LBR 4003-1(a)).
event ExemptionAmendmentServed()
/// An amendment to the schedules adding a creditor is served fewer than 30
/// days before, or after, the FRBP 4003(b) objection deadline (LBR
/// 4003-1(b)).
event CreditorAddedToSchedulesServed()
/// The date of a sale of estate property of an aggregate gross value of no
/// more than $10,000 (LBR 6004-1(b)).
event SmallSaleDate()
/// An auctioneer receives the proceeds of a sale (LBR 6004-1(e)).
event AuctionProceedsReceived()
/// The last date of an auction (LBR 6004-1(f)).
event AuctionConcluded()
/// All proceeds of an auction have been received after the auction report
/// was due (LBR 6004-1(f)).
event AllAuctionProceedsReceived()
/// The discovery cut-off date in an adversary proceeding (LBR 7033-1(c)).
event DiscoveryCutoff()
/// Answers to interrogatories that refer to records are served (LBR
/// 7033-1(f)).
event InterrogatoryAnswersServed()
/// An appellate court remands for further proceedings (LBR 8024-1).
event Remanded()
/// The date set for the hearing on a motion (LBR 9006-1(a)).
event HearingScheduled()
/// An order assigning a matter to mediation is entered (LBR 9019-1(b)).
event MediationOrdered()
/// The mediation participants select a mediator (LBR 9019-1(b)).
event MediatorSelected()
/// The Mediation Order is entered (LBR 9019-1(c)).
event MediationOrderEntered()
/// A motion to redact a filed document or proof of claim is granted (LBR
/// 9037-1(e)).
event RedactionGranted()
/// The record on appeal is returned to the Clerk (LBR 9070-1(b)).
event RecordReturned()
/// After a trial, hearing or decision, the court directs a party to settle
/// or submit an order, judgment or decree (LBR 9072-1).
event OrderDirected()

/// LBR 1002-1(d): if a petition is filed without photo identification, the
/// identification is provided to the Clerk's Office within 14 days, or a
/// motion for waiver is made within that time.
deadline photo-identification-period: 14.days after PetitionFiled() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 1002-1(d)"
/// LBR 1007-4(b): in an involuntary chapter 11 case, the debtor's affidavit
/// is filed within 14 days after the order for relief is entered.
deadline involuntary-chapter11-affidavit-period: 14.days after OrderForReliefEntered() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 1007-4(b)"
/// LBR 1073-3(b)(ii): in an involuntary case, the debtor files the LBR
/// 1073-3 corporate disclosure statement within 14 days after the order for
/// relief.
deadline involuntary-disclosure-statement-period: 14.days after OrderForReliefEntered() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 1073-3(b)"
/// LBR 2002-1(e): an objection to a proposed order noticed for presentment
/// is served so as to be received, and filed with proof of service, at
/// least 7 days before the presentment date.
deadline presentment-objection-period: 7.days before PresentmentDate() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 2002-1(e)"
/// LBR 2003-1(a): in a chapter 13 case, the debtor provides the trustee the
/// mandatory disclosures (payment advices, contribution affidavits,
/// valuations, leases, a prior-case affidavit and post-petition payment
/// proof) no later than 7 days before the first date set for the § 341
/// meeting.
deadline chapter13-meeting-disclosures-period: 7.days before FirstMeetingDate() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 2003-1(a)"
/// LBR 2003-1(b): the chapter 13 debtor provides the trustee the further
/// documents no later than 7 days before the first date set for
/// confirmation.
deadline chapter13-confirmation-disclosures-period: 7.days before Chapter13ConfirmationHearingScheduled() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 2003-1(b)"
/// LBR 2016-2: an application for a final award of compensation in a
/// chapter 7 case is filed and served no later than 21 days before the
/// hearing on the trustee's final account.
deadline final-compensation-application-period: 21.days before FinalAccountHearingScheduled() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 2016-2"
/// LBR 2016-2: objections to the application are filed at least 7 days
/// before the hearing.
deadline final-compensation-objection-period: 7.days before FinalAccountHearingScheduled() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 2016-2"
/// LBR 2090-2: where the debtor's retainer agreement excludes the defense of
/// an adversary proceeding, the attorney of record files and serves the
/// relevant portions of the agreement within 14 days of service of the
/// summons and complaint.
deadline retainer-exclusion-period: 14.days after SummonsServed() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 2090-2"
/// LBR 3007-2: a creditor whose scheduled claim is modified, or who is
/// added, when the bar date has expired or will expire in less than 30
/// days, has 30 days from the effective date of the amendment to file a
/// proof of claim.
deadline amended-schedule-claim-period: 30.days after ScheduleAmendmentEffective() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 3007-2"
/// LBR 3015-1(b): unless the plan is filed with the petition, the chapter 13
/// debtor serves the plan on the trustee and all creditors within 7 days of
/// filing it, and files proof of service.
deadline chapter13-plan-service-period: 7.days after Chapter13PlanFiled() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 3015-1(b)"
/// LBR 3015-1(c): a plan or summary stating the payments to the debtor's
/// attorney as an administrative expense stands in for separate notice only
/// if served on all parties in interest at least 14 days before the
/// confirmation hearing.
deadline attorney-fee-notice-period: 14.days before Chapter13ConfirmationHearingScheduled() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 3015-1(c)"
/// LBR 3015-2(a): a pre-confirmation modification that adversely affects a
/// creditor is served on the trustee and all creditors not later than 14
/// days before the confirmation hearing or any adjournment.
deadline chapter13-modification-service-period: 14.days before Chapter13ConfirmationHearingScheduled() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 3015-2(a)"
/// LBR 3018-1(a): at least 7 days before the confirmation hearing on a
/// chapter 9 or 11 plan, the proponent files and serves a summary of the
/// ballots and any notice of cramdown.
deadline ballot-summary-period: 7.days before Chapter11ConfirmationHearingScheduled() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 3018-1(a)"
/// LBR 3018-1(b): at least 7 days before the confirmation hearing, the
/// proponent or the balloting agent files the certification of the vote.
deadline vote-certification-period: 7.days before Chapter11ConfirmationHearingScheduled() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 3018-1(b)"
/// LBR 3018-1(c): the person tabulating ballots notifies a holder whose
/// election is ineffective at least 7 days before the confirmation hearing.
deadline ineffective-election-notice-period: 7.days before Chapter11ConfirmationHearingScheduled() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 3018-1(c)"
/// LBR 3020-1(a): objections to confirmation of a chapter 9 or 11 plan are
/// filed at least 7 days before the first date set for the confirmation
/// hearing.
deadline chapter11-confirmation-objection-period: 7.days before Chapter11ConfirmationHearingScheduled() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 3020-1(a)"
/// LBR 3021(a): within 14 days after the order confirming a chapter 11
/// plan, the plan proponent files on presentment a proposed order with a
/// timetable for substantial consummation and a final decree.
deadline consummation-timetable-period: 14.days after PlanConfirmed() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 3021(a)"
/// LBR 3022-1: the plan proponent applies for a final decree within 14 days
/// following the full administration of the estate (this period and the
/// next; the earlier controls).
deadline final-decree-application-period: 14.days after EstateFullyAdministered() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 3022-1"
/// LBR 3022-1: and not later than 18 months following the entry of the
/// confirmation order.
deadline final-decree-outside-period: 18.months after PlanConfirmed() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 3022-1"
/// LBR 4001-4(b): the lessor may, no later than 14 days after the Clerk's
/// notice of compliance, consent to receive the debtor's check or object to
/// the debtor's certification; silence is consent.
deadline lessor-election-period: 14.days after CureComplianceNoticed() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 4001-4(b)"
/// LBR 4003-1(a): an amendment to a claim of exemptions is not effective
/// until proof of service is filed, which is done within 7 days of service.
deadline exemption-amendment-proof-period: 7.days after ExemptionAmendmentServed() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 4003-1(a)"
/// LBR 4003-1(b): a creditor added fewer than 30 days before, or after, the
/// FRBP 4003(b) deadline has 30 days from service of the amendment to
/// object to the property claimed as exempt.
deadline added-creditor-exemption-objection-period: 30.days after CreditorAddedToSchedulesServed() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 4003-1(b)"
/// LBR 6004-1(b): a trustee may sell estate property it reasonably believes
/// worth no more than $10,000 in aggregate on 7 days' written notice to the
/// United States trustee, interested parties and the landlord.
deadline small-sale-notice-period: 7.days before SmallSaleDate() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 6004-1(b)"
/// LBR 6004-1(e)(i): the auctioneer pays the gross proceeds to the trustee
/// or debtor in possession no later than 7 days after receiving them.
deadline auction-proceeds-period: 7.days after AuctionProceedsReceived() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 6004-1(e)"
/// LBR 6004-1(f): within 21 days after the last date of the auction, the
/// auctioneer files a verified report.
deadline auction-report-period: 21.days after AuctionConcluded() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 6004-1(f)"
/// LBR 6004-1(f): if not all proceeds were received by then, the auctioneer
/// files a supplemental report within 14 days after all are received.
deadline auction-supplemental-report-period: 14.days after AllAuctionProceedsReceived() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 6004-1(f)"
/// LBR 7033-1(c): contention interrogatories may be served at the
/// conclusion of a party's discovery and at least 30 days before the
/// discovery cut-off.
deadline contention-interrogatory-period: 30.days before DiscoveryCutoff() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 7033-1(c)"
/// LBR 7033-1(f)(4): records referred to in answers to interrogatories are
/// made available for inspection within 14 days after service of the
/// answers, or on an agreed date.
deadline records-inspection-period: 14.days after InterrogatoryAnswersServed() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 7033-1(f)"
/// LBR 8024-1: on a remand for further proceedings, the appropriate party
/// moves for them within 21 days of the remand, unless the appellate court
/// orders otherwise.
deadline remand-motion-period: 21.days after Remanded() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 8024-1"
/// LBR 9006-1(a)(i): unless the rules provide otherwise, motion papers are
/// served at least 14 days before the hearing date.
deadline motion-service-period: 14.days before HearingScheduled() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 9006-1(a)"
/// LBR 9006-1(a)(ii): answering papers are served so as to be received at
/// least 7 days before the hearing date.
deadline answering-papers-period: 7.days before HearingScheduled() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 9006-1(a)"
/// LBR 9006-1(a)(iii): reply papers are served and filed at least 3 days
/// before the hearing date.
deadline reply-papers-period: 3.days before HearingScheduled() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 9006-1(a)"
/// LBR 9019-1(b): the mediation participants select a mediator and an
/// alternate from the Mediation Register within 7 days of the order
/// assigning the matter to mediation.
deadline mediator-selection-period: 7.days after MediationOrdered() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 9019-1(b)"
/// LBR 9019-1(b): within 7 days of selecting a mediator, the participants
/// and the mediator submit a proposed Mediation Order.
deadline mediation-order-submission-period: 7.days after MediatorSelected() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 9019-1(b)"
/// LBR 9019-1(c)(i): the initial mediation conference takes place no later
/// than 30 days after the entry of the Mediation Order.
deadline initial-mediation-conference-period: 30.days after MediationOrderEntered() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 9019-1(c)"
/// LBR 9037-1(e): the party seeking redaction files a correctly redacted
/// document or proof of claim within 21 days of the granting of the motion.
deadline redacted-filing-period: 21.days after RedactionGranted() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 9037-1(e)"
/// LBR 9070-1(b)(ii): if an appeal has been taken, the responsible party
/// removes its filed exhibits within 30 days after the record on appeal is
/// returned to the Clerk.
deadline exhibit-removal-period: 30.days after RecordReturned() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 9070-1(b)"
/// LBR 9072-1(a), (b): a party directed to settle or submit an order,
/// judgment or decree files it within 14 days of the court's direction, or
/// such other time as the court directs.
deadline proposed-order-period: 14.days after OrderDirected() counted_by frbp9006-new-york cite "E.D.N.Y. LBR 9072-1(a)"

start motion-filed

state motion-filed: "Motion served and filed" by applicant cite "E.D.N.Y. LBR 9006-1(a)"
{
  note "Unless the rules provide otherwise, motion papers are served at least 14 days before the hearing date and filed no later than the day after service (LBR 9006-1(a)(i), (b)); service by first-class mail adds 3 days, by overnight delivery 1 (LBR 9006-1(c)). Relief may instead be sought on presentment with at least 21 days' notice (LBR 2002-1). The motion's FRBP periods are lit/frbp's."
  edge-motion-filed-answer "Answering papers served" -> answered {
    authority cite "E.D.N.Y. LBR 9006-1(a)"
  }
  edge-motion-filed-unopposed "No answering papers; matter heard or decided on the papers" -> ruling {
    authority cite "E.D.N.Y. LBR 9006-1(a)"
  }
}

state answered: "Answering papers served" by opponent cite "E.D.N.Y. LBR 9006-1(a)"
{
  note "Answering papers are received at least 7 days before the hearing and reply papers are served and filed at least 3 days before it; untimely papers may not be considered (LBR 9006-1(a))."
  edge-answered-hearing "Hearing held" -> ruling { authority cite "E.D.N.Y. LBR 9006-1(a)" }
}

decision ruling: "Motion decided" by court cite "E.D.N.Y. LBR 9072-1"
{
  note "A party directed to settle or submit an order, judgment or decree does so within 14 days of the direction (LBR 9072-1)."
  edge-ruling-granted "Granted" -> decided { authority cite "E.D.N.Y. LBR 9072-1(a)" }
  edge-ruling-denied "Denied" -> decided { authority cite "E.D.N.Y. LBR 9072-1(b)" }
}

terminal decided: "Matter decided: the case continues under lit/frbp" outcome [procedural] cite "E.D.N.Y. LBR 1001-1"
{
  note "The Local Bankruptcy Rules apply insofar as they are not inconsistent with the Bankruptcy Code and the Bankruptcy Rules, and are cited as E.D.N.Y. LBR (LBR 1001-1(b)); an order in a specific case controls over them."
}
