module frap.mandate

import core.authority.{ CaseOrder }
import core.frap26.{ frap26 }
import frap.cert.{ cert-period, cert-petition-window }
import frap.events.{ EnteredOnAppeal, RehearingClosed, ServedPaper }
import frap.{ mandate-group }

/// FRAP 41(b): the mandate issues 7 days after the time to petition for
/// rehearing expires, or 7 days after entry of an order denying a timely
/// petition or a motion to stay the mandate, whichever is later. "The
/// court may shorten or extend the time by order", so the period delegates
/// to `CaseOrder`. It binds the clerk, not a party: the pack models it as
/// the window the mandate edges wait out.
rule duty issue-mandate effective [2009-12-01, ..) known_at 2009-03-26 cite "FRAP 41(b)"
{
  deadline mandate-period: 7.days after RehearingClosed() counted_by frap26 delegable {
    to CaseOrder
    op set
  } cite "FRAP 41(b)"
}

test "the mandate issues 7 days after the rehearing time expires" cite "FRAP 41(b)"
{
  given RehearingClosed(TimeExpired) on 2025-03-03
  expect deadline(mandate-period) == 2025-03-10
}

test "a 7th day on Independence Day rolls to Monday" cite "FRAP 26(a)(6)(A)"
{
  given RehearingClosed(PetitionDenied) on 2025-06-27
  expect deadline(mandate-period) == 2025-07-07
}

/// A party who wants costs taxed in the court of appeals must file with the
/// circuit clerk and serve an itemized, verified bill within 14 days after
/// judgment is entered, and objections are due 14 days after the bill is
/// served, "unless the court extends the time". The bill's period says
/// nothing of extension, but FRAP 26(b) lets the court extend any period
/// for good cause, so both delegate to `CaseOrder`. Neither delays the
/// mandate (FRAP 39(e)(3)(C)). A served bill gains FRAP 26(c)'s 3 days
/// after mail, carrier or prison-mail service.
///
/// Before December 1, 2025 the periods were FRAP 39(d)(1) and (d)(2),
/// unchanged in length since the 2009 time-computation amendments. That
/// text is not vendored, so that version's cite is a hole carrying it.
rule duty tax-appellate-costs effective [2009-12-01, 2025-12-01) known_at 2009-03-26 cite ?("FRAP 39(d) before the December 2025 amendment (text not vendored)") {
  deadline bill-of-costs-period: 14.days after EnteredOnAppeal(Judgment) counted_by frap26 delegable {
    to CaseOrder
    op set
  } cite ?("FRAP 39(d)(1) before the December 2025 amendment (text not vendored)")
  deadline cost-objection-period: 14.days after ServedPaper(BillOfCosts) counted_by frap26 delegable {
    to CaseOrder
    op set
  } cite ?("FRAP 39(d)(2) before the December 2025 amendment (text not vendored)")
}

/// The December 1, 2025 amendment (Supreme Court order of April 23, 2025)
/// moved both periods to FRAP 39(e)(3), unchanged.
rule duty tax-appellate-costs effective [2025-12-01, ..) known_at 2025-04-23 supersedes tax-appellate-costs@2009-12-01 cite "FRAP 39(e)(3)"
{
  deadline bill-of-costs-period: 14.days after EnteredOnAppeal(Judgment) counted_by frap26 delegable {
    to CaseOrder
    op set
  } cite "FRAP 39(e)(3)(A)"
  deadline cost-objection-period: 14.days after ServedPaper(BillOfCosts) counted_by frap26 delegable {
    to CaseOrder
    op set
  } cite "FRAP 39(e)(3)(B)"
}

/// The tests run in 2025, under the FRAP 39(d) version the package's
/// `known_at` records; FRAP 39(e)(3) carries the same periods over.
test "the bill of costs is due 14 days after the judgment is entered" cite "FRAP 39(e)(3)(A)"
{
  given EnteredOnAppeal(Judgment) on 2025-03-03
  expect deadline(bill-of-costs-period) == 2025-03-17
}

test "objections are due 14 days after the bill is served electronically" cite "FRAP 39(e)(3)(B)"
{
  given ServedPaper(BillOfCosts, Electronic) on 2025-03-17
  expect deadline(cost-objection-period) == 2025-03-31
}

test "a bill served by mail gains 3 days for objections" cite "FRAP 26(c)"
{
  given ServedPaper(BillOfCosts, Mail) on 2025-03-17
  expect deadline(cost-objection-period) == 2025-04-03
}

state mandate-issued: "Mandate Issues" by office cite "Fed. R. App. P. 41(a)–(b)"
{
  group mandate-group
  note "The mandate is the formal order returning jurisdiction to the district court — distinct from the opinion and critical for enforcing the judgment. It issues automatically 7 days after either expiration of the rehearing period or denial of a timely rehearing petition. The mandate, not the opinion, is what actually binds the district court."
  edge-mandate-issued-cert-petition-window "Judgment final — cert clock runs" -> cert-petition-window {
    authority cite "Fed. R. App. P. 41(b); Sup. Ct. R. 13.3"
    within cert-period {
      extendable true
      extension_authority "Sup. Ct. R. 13.6"
      note "The 90-day deadline is measured from the date the appellate opinion is filed/docketed. Missing this deadline forecloses any Supreme Court review; the judgment becomes final and enforceable. Extensions require filing before the deadline expires."
    }
    duration { min 13.5.days, mode 45.days, max 90.days }
  }
  edge-mandate-issued-mandate-stayed-pending-cert "Move to stay mandate for cert" -> mandate-stayed-pending-cert by applicant {
    authority cite "Fed. R. App. P. 41(d)(1)"
    effort 8.hours
    note "Hours: BigLaw-honest estimate for the effort of this move; basis: estimate."
  }
}

state mandate-stayed-pending-cert: "Mandate Stayed Pending Certiorari" by examiner cite "Fed. R. App. P. 41(d)(1)–(2)"
{
  group mandate-group
  note "On motion, the court of appeals may stay its mandate pending a cert petition — otherwise the district court could enforce the judgment while the Supreme Court is still deciding whether to take the case. The stay is discretionary and requires a showing of likelihood of cert grant plus irreparable harm."
  edge-mandate-stayed-pending-cert-cert-petition-window "Stay granted — cert proceeds" -> cert-petition-window {
    authority cite "Fed. R. App. P. 41(d)(2)"
    within cert-period {
      extendable true
      extension_authority "Sup. Ct. R. 13.6"
      note "If cert is denied or the 90-day window expires (whichever is earlier), the stay terminates automatically and the mandate issues to enforce the judgment."
    }
    duration { min 13.5.days, mode 45.days, max 90.days }
  }
}
