// The joint appendix (Fed. Cir. R. 30). Its period is declared with the
// briefing deadlines, on the edge that files it.
module cafc.appendix

import cafc.argument.{ oral-argument-fork }
import cafc.{ appendix-group }

state joint-appendix-filed: "Joint Appendix Served and Filed" by office cite "Fed. Cir. R. 30(a)(1)-(2)"
{
  group appendix-group
  note "Beyond FRAP 30(a)(1)(A)-(C), the appendix must include the entire docket sheet/certified list/index, jury materials in a jury case, and (in a patent case) the patents/applications at issue in their entirety (Fed. Cir. R. 30(a)(1)(A)). Parties must attempt to agree on the designation 45 days before the appellant's principal-brief deadline (Fed. Cir. R. 30(b)(1)(A)); appellant's unilateral designation is due 30 days before that deadline if no agreement, with a 14-day appellee counter-designation window."
  appendix-to-argument-fork "Clerk calendars the argument decision" -> oral-argument-fork {
    authority cite ?("FRAP 34(a); Fed. Cir. IOP #7")
  }
}
