// Imported by `litigate import` from packs/ttab-trademark-trial-and-appeal-board.json.
module ttab.pre-2

import ttab.lapse.{ period-lapsed }
import ttab.opposition-to-trial.{ opposition-filed }
import ttab.{ OppositionFiled, extended-period-120, pre }

decision opposer-d120: "No consent: the opposer must oppose by end of day 120 or lose the right to oppose" by opposer cite "37 CFR 2.101(c); 2.102(c)(3)"
{
  group pre
  tags [opponent-decision]
  _ "Opposer files notice of opposition (ESTTA, $600/class)" -> opposition-filed {
    authority cite ?("37 CFR 2.101(a)-(c), 2.6(a)(17)(ii)")
    event OppositionFiled()
    within extended-period-120 {
      extendable true
      extension_authority "37 CFR 2.102(c)(3) (applicant consent only)"
    }
    tags [file-opposition]
    attrs { opp_fees: 600, opp_hours: 14 }
  }
  _ "Opposer lets the opposition period lapse" -> period-lapsed {
    authority cite "37 CFR 2.101(c); 15 USC 1063(b)"
    tags [lapse]
  }
}
