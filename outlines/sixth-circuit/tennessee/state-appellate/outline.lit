// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-tn-state-appellate

start judgment-signed

state judgment-signed: "Judgment signed" by applicant cite ?("Tenn. R. App. P. 3")
{
  note "OUTLINE. Appeal as of right from final judgment (Rule 3; verify). Interlocutory appeal by permission (Rule 9; verify)."
  edge-judgment-signed-notice "Appeal taken within delay" -> notice-filed {
    authority cite ?("Tenn. R. App. P. 4")
  }
  edge-judgment-signed-late "Delay missed" -> time-barred {
    authority cite ?("Tenn. R. App. P. 4")
  }
}

state notice-filed: "Appeal taken" by applicant cite ?("Tenn. R. App. P. 3")
{
  note "OUTLINE. Notice of appeal within 30 days after entry of judgment (Rule 4(a); period verify). Post-judgment motion tolling (Rule 4(b)-(c); verify)."
  edge-notice-filed-record "Record lodged" -> record-lodged {
    authority cite ?("Tenn. R. App. P. 24")
  }
}

state record-lodged: "Record lodged" by office cite ?("Tenn. R. App. P. 24")
{
  note "OUTLINE. Record contents and transcript deadlines are holes (?)."
  edge-record-lodged-briefs "Briefing schedule set" -> briefing {
    authority cite ?("Tenn. R. App. P. 27")
  }
}

state briefing: "Briefs filed" by applicant cite ?("Tenn. R. App. P. 27")
{
  note "OUTLINE. Brief length and format are holes until verified against the court's rules."
  edge-briefing-argument "Argument set" -> argument {
    authority cite ?("Tenn. R. App. P. 27")
  }
  edge-briefing-submitted "Submitted on briefs" -> appellate-decision {
    authority cite ?("Tenn. R. App. P. 13")
  }
}

state argument: "Oral argument" by office cite ?("Tenn. R. App. P. 27")
{
  note "OUTLINE. Argument practice and time are holes until verified."
  edge-argument-decision "Argued" -> appellate-decision {
    authority cite ?("Tenn. R. App. P. 13")
  }
}

decision appellate-decision: "Appellate decision" by court cite ?("Tenn. R. App. P. 13")
{
  note "OUTLINE. Standard of review is a hole until verified. Scope of review (Rule 13; verify). Standard of review is a hole until verified."
  edge-decision-affirmed "Affirmed" -> affirmed {
    authority cite ?("Tenn. R. App. P. 13")
  }
  edge-decision-reversed "Reversed or amended" -> reversed {
    authority cite ?("Tenn. R. App. P. 13")
  }
  edge-decision-remanded "Remanded" -> remanded {
    authority cite ?("Tenn. R. App. P. 13")
  }
  edge-decision-dismissed "Appeal dismissed" -> appeal-dismissed {
    authority cite ?("Tenn. R. App. P. 13")
  }
  edge-decision-rehearing "Rehearing sought" -> rehearing-filed {
    authority cite ?("Tenn. R. App. P. 39")
  }
}

state rehearing-filed: "Application for rehearing" by applicant cite ?("Tenn. R. App. P. 39")
{
  note "OUTLINE. Rehearing period is a hole (?). Denial or grant is a hole until verified."
  edge-rehearing-supreme "Rehearing denied; review sought" -> supreme-review {
    authority cite ?("Tenn. R. App. P. 11")
  }
  edge-rehearing-decision "Rehearing granted" -> appellate-decision {
    authority cite ?("Tenn. R. App. P. 13")
  }
}

state supreme-review: "Review or writ application to supreme court" by applicant cite ?("Tenn. R. App. P. 11")
{
  note "OUTLINE. Application for permission to appeal to the Tennessee Supreme Court (Rule 11; time is a hole (?), verify)."
  edge-supreme-review-denied "Review denied" -> review-denied {
    authority cite ?("Tenn. R. App. P. 11")
  }
  edge-supreme-review-granted "Review granted" -> supreme-decided {
    authority cite ?("Tenn. R. App. P. 11")
  }
}

terminal time-barred: "Appeal time missed" outcome [loss] cite ?("Tenn. R. App. P. 4")
{
  note "OUTLINE. Delay is generally jurisdictional or near-jurisdictional (verify)."
  payoff ?
}

terminal affirmed: "Affirmed" outcome [loss] cite ?("Tenn. R. App. P. 13")
{
  note "OUTLINE. Further review: see supreme-review."
  payoff ?
}

terminal reversed: "Reversed or amended" outcome [win] cite ?("Tenn. R. App. P. 13")
{
  note "OUTLINE. Fees and costs are holes."
  payoff ?
}

terminal remanded: "Remanded" outcome [neutral] cite ?("Tenn. R. App. P. 13")
{
  note "OUTLINE. Remand outcome depends on the trial court's next ruling."
  payoff ?
}

terminal appeal-dismissed: "Appeal dismissed" outcome [loss] cite ?("Tenn. R. App. P. 13")
{
  note "OUTLINE. Grounds for dismissal are holes until verified."
  payoff ?
}

terminal review-denied: "Review denied" outcome [loss] cite ?("Tenn. R. App. P. 11")
{
  note "OUTLINE. Denial of review ends the state appeal path."
  payoff ?
}

terminal supreme-decided: "Supreme court decided" outcome [neutral] cite ?("Tenn. R. App. P. 11")
{
  note "OUTLINE. Outcome is a hole until the decision is known."
  payoff ?
}
