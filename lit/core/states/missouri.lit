module core.states.missouri

import core.calendar.{ us-federal-holidays }

calendar missouri-holidays effective [2022-08-28, ..) cite "RSMo § 9.010"
{
  lincolns-birthday: fixed(2, 12) effective [2022-08-28, ..)
  lincolns-birthday-observed-2023: once(2023-02-13) effective [2022-08-28, ..)
  lincolns-birthday-observed-2034: once(2034-02-13) effective [2022-08-28, ..)
  lincolns-birthday-observed-2040: once(2040-02-13) effective [2022-08-28, ..)
  lincolns-birthday-observed-2045: once(2045-02-13) effective [2022-08-28, ..)
  truman-day: fixed(5, 8) effective [2022-08-28, ..)
  truman-day-observed-2033: once(2033-05-09) effective [2022-08-28, ..)
  truman-day-observed-2039: once(2039-05-09) effective [2022-08-28, ..)
  truman-day-observed-2044: once(2044-05-09) effective [2022-08-28, ..)
  truman-day-observed-2050: once(2050-05-09) effective [2022-08-28, ..)
}

/// FRCP 6 in the district courts of Missouri: the 2023 text
/// (`frcp6@2023-12-01`) with `missouri-holidays`, which 6(a)(6)(C)
/// ("any day declared a holiday by ... the state where the district court
/// is located") makes legal holidays "for periods that are measured after
/// an event" only. A district package there names it as its `counting`
/// rule and `recounts` lit/frcp. A calendar day is closed only from the
/// date its entry is in force; before it the count is `frcp6`'s.
counting frcp6-missouri effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCP 6(d)"
  holidays us-federal-holidays
  forward_holidays missouri-holidays cite "FRCP 6(a)(6)(C)"
  forums [frcp]
  allow_hours
  end_of_month clamp
}

/// FRBP 9006(a) (`frbp9006`) in the bankruptcy courts of Missouri:
/// `missouri-holidays` are legal holidays for a period counted forward only (FRBP
/// 9006(a)(6)(C), "any day declared a holiday by the state where the
/// district court is located"). A bankruptcy package there names it as its
/// `counting` rule and `recounts` lit/frbp. A calendar day is closed only
/// from the date its entry is in force.
counting frbp9006-missouri effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays missouri-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-moe, bankr-mow]
  allow_hours
  end_of_month clamp
}
