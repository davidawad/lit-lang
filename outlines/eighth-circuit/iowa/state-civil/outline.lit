// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-ia-state-civil

start complaint-filed

state complaint-filed: "Action commenced" by applicant cite ?("Iowa R. Civ. P. 1.301")
{
  note "OUTLINE. Rule numbers from memory: verify every Iowa cite. Pleading standard and leading case not named; verify."
  edge-complaint-filed-response-due "Summons served" -> response-due {
    authority cite ?("Iowa R. Civ. P. 1.302")
  }
}

state response-due: "Response due: answer or motion" cite ?("Iowa R. Civ. P. 1.411")
{
  note "OUTLINE. Response period is a hole. Motion practice under rule 1.421 (verify); response period is a hole."
  edge-response-due-default-entered "No timely response" -> default-entered {
    authority cite ?("Iowa R. Civ. P. 1.971")
  }
  edge-response-due-motion-ruling "Motion to dismiss filed" -> motion-ruling {
    authority cite ?("Iowa R. Civ. P. 1.421")
  }
  edge-response-due-sched "Answer filed" -> sched {
    authority cite ?("Iowa R. Civ. P. 1.411")
  }
}

decision motion-ruling: "Motion to dismiss ruling" by court cite ?("Iowa R. Civ. P. 1.421")
{
  note "OUTLINE. No leading decision named. Verify Iowa motion-to-dismiss case law."
  edge-motion-ruling-dismissed-with-prejudice "Dismissed with prejudice" -> dismissed-with-prejudice {
    authority cite ?("Iowa R. Civ. P. 1.943")
  }
  edge-motion-ruling-response-due "Dismissed with leave to amend" -> response-due {
    authority cite ?("Iowa R. Civ. P. 1.402")
  }
  edge-motion-ruling-sched "Denied" -> sched {
    authority cite ?("Iowa R. Civ. P. 1.421")
  }
}

state sched: "Scheduling order and initial disclosures" cite ?("Iowa R. Civ. P. 1.601")
{
  note "OUTLINE. Pretrial under rule 1.601 (verify)."
  edge-sched-discovery "Order entered" -> discovery {
    authority cite ?("Iowa R. Civ. P. 1.601")
  }
}

state discovery: "Discovery" cite ?("Iowa R. Civ. P. 1.501, 1.503, 1.509, 1.512")
{
  note "OUTLINE. Discovery under rules 1.501 to 1.517 (verify)."
  edge-discovery-sj-ruling "Dispositive motion filed" -> sj-ruling {
    authority cite ?("Iowa R. Civ. P. 1.981(3)")
  }
  edge-discovery-dismissed-with-prejudice "Discovery sanction dismisses claims" -> dismissed-with-prejudice {
    authority cite ?("Iowa R. Civ. P. 1.517")
  }
  edge-discovery-settled "Settlement or voluntary dismissal" -> settled {
    authority cite ?("Iowa R. Civ. P. 1.943")
  }
  edge-discovery-pretrial "No dispositive motion" -> pretrial {
    authority cite ?("Iowa R. Civ. P. 1.601")
  }
}

decision sj-ruling: "Summary judgment ruling" by court cite ?("Iowa R. Civ. P. 1.981(3)")
{
  note "OUTLINE. No leading decision named. Verify Iowa summary judgment case law."
  edge-sj-ruling-judgment-applicant "Granted for applicant" -> judgment-applicant {
    authority cite ?("Iowa R. Civ. P. 1.903")
  }
  edge-sj-ruling-judgment-opponent "Granted for opponent" -> judgment-opponent {
    authority cite ?("Iowa R. Civ. P. 1.903")
  }
  edge-sj-ruling-pretrial "Denied" -> pretrial {
    authority cite ?("Iowa R. Civ. P. 1.981(3)")
  }
}

state pretrial: "Pretrial order" cite ?("Iowa R. Civ. P. 1.601")
{
  note "OUTLINE. Pretrial conference, order and trial setting."
  edge-pretrial-trial "Trial set" -> trial {
    authority cite ?("Iowa R. Civ. P. 1.601")
  }
}

state trial: "Trial (jury or bench)" cite ?("Iowa R. Civ. P. 1.901")
{
  note "OUTLINE. Trial and findings or verdict."
  edge-trial-judgment-applicant "Verdict or findings for applicant" -> judgment-applicant {
    authority cite ?("Iowa R. Civ. P. 1.903")
  }
  edge-trial-judgment-opponent "Verdict or findings for opponent" -> judgment-opponent {
    authority cite ?("Iowa R. Civ. P. 1.903")
  }
}

state judgment-applicant: "Judgment for applicant entered" cite ?("Iowa R. Civ. P. 1.903")
{
  note "OUTLINE. Entry of judgment. Post-trial motions under rules 1.904 and 1.1003 (verify)."
  edge-judgment-applicant-post-judgment-ruling "Post-judgment motion" -> post-judgment-ruling {
    authority cite ?("Iowa R. Civ. P. 1.904(2), 1.1003, 1.1004")
  }
  edge-judgment-applicant-appellate-review "Notice of appeal filed" -> appellate-review {
    authority cite ?("Iowa R. App. P. 6.101")
  }
  edge-judgment-applicant-final-win "No appeal within time" -> final-win {
    authority cite ?("Iowa R. App. P. 6.101(1)")
  }
}

state judgment-opponent: "Judgment for opponent entered" cite ?("Iowa R. Civ. P. 1.903")
{
  note "OUTLINE. Entry of judgment. Post-trial motions under rules 1.904 and 1.1003 (verify)."
  edge-judgment-opponent-post-judgment-ruling "Post-judgment motion" -> post-judgment-ruling {
    authority cite ?("Iowa R. Civ. P. 1.904(2), 1.1003, 1.1004")
  }
  edge-judgment-opponent-appellate-review "Notice of appeal filed" -> appellate-review {
    authority cite ?("Iowa R. App. P. 6.101")
  }
  edge-judgment-opponent-final-loss "No appeal within time" -> final-loss {
    authority cite ?("Iowa R. App. P. 6.101(1)")
  }
}

decision post-judgment-ruling: "Post-judgment motion ruling" by court cite ?("Iowa R. Civ. P. 1.904(2), 1.1003, 1.1004")
{
  note "OUTLINE. Post-judgment motions toll the appeal clock; verify tolling rule."
  edge-post-judgment-ruling-pretrial "Granted: new trial" -> pretrial {
    authority cite ?("Iowa R. Civ. P. 1.904(2), 1.1003, 1.1004")
  }
  edge-post-judgment-ruling-appellate-review "Denied: appeal clock runs from order" -> appellate-review {
    authority cite ?("Iowa R. App. P. 6.101(1)")
  }
}

terminal default-entered: "Default entered against opponent" outcome [win] cite ?("Iowa R. Civ. P. 1.971")
{
  note "OUTLINE. Default under the rule; judgment by default is a separate entry. Outcome is from the applicant's side."
  payoff ?
}

terminal dismissed-with-prejudice: "Dismissed with prejudice" outcome [loss] cite ?("Iowa R. Civ. P. 1.943")
{
  note "OUTLINE. Outcome from the applicant's side."
  payoff ?
}

terminal settled: "Settled or voluntarily dismissed" outcome [settlement] cite ?("Iowa R. Civ. P. 1.943")
{
  note "OUTLINE. Settlement terms are a hole."
  payoff ?
}

terminal final-win: "Final judgment for applicant, no appeal" outcome [win] cite ?("Iowa R. App. P. 6.101(1)")
{
  note "OUTLINE. Judgment final when the appeal period lapses."
  payoff ?
}

terminal final-loss: "Final judgment for opponent, no appeal" outcome [loss] cite ?("Iowa R. App. P. 6.101(1)")
{
  note "OUTLINE. Judgment final when the appeal period lapses."
  payoff ?
}

terminal appellate-review: "Appeal taken: continue in the appellate package" cite ?("Iowa R. App. P. 6.101")
{
  note "OUTLINE. Hand-off to the state-appellate or court-of-appeals package."
  payoff ?
}
