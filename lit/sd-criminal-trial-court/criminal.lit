module sd-criminal-trial-court.criminal

// A criminal prosecution in the South Dakota circuit court, from the
// defendant's view of outcomes. The vendored SDCL Title 23A now includes
// full text for the cited chapters, but its currency is unconfirmed; cites
// remain holes and values are stated in notes as unverified. Every period
// is stated in a note: lit/core has no South Dakota counting rule.
// The outline's decisions (Gerstein, McLaughlin, Gideon, Brady, Barker v.
// Wingo, Boykin, Missouri v. Frye, Jackson v. Virginia, Roe v.
// Flores-Ortega, Garza v. Idaho) are federal constitutional authority with
// no reporter text vendored, so they are removed here.
start arrested

state arrested: "Arrest" by applicant cite ?("SDCL § 23A-3-2, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
{
  note "A law enforcement officer's power to arrest without a warrant, and the circumstances permitting it, are SDCL §§ 23A-3-2 and 23A-3-2.1. Unverified: CURRENCY UNCONFIRMED. The initial appearance and preliminary hearing are governed by SDCL §§ 23A-4-1 to 23A-4-8; periods include 15 days if in custody and 45 days if not in custody for a preliminary hearing (§ 23A-4-3). Unverified: CURRENCY UNCONFIRMED."
  edge-arrested-appearance "Initial appearance before a magistrate" -> initial-appearance {
    authority cite ?("SDCL §§ 23A-4-1 to 23A-4-8, CURRENCY UNCONFIRMED (text present; value unverified)")
  }
}

decision initial-appearance: "Initial appearance and release" by court cite ?("SDCL §§ 23A-4-1 to 23A-4-8, CURRENCY UNCONFIRMED (text present; value unverified)")
{
  note "Release on personal recognizance or unsecured bond is governed by SDCL § 23A-43-2, and preliminary proceedings by §§ 23A-4-1 to 23A-4-8; both texts are present but currency is unconfirmed. The 180-day period runs from the date the defendant first appears before a judicial officer on an indictment, information or complaint (§ 23A-44-5.1(2)). Unverified: CURRENCY UNCONFIRMED."
  edge-initial-appearance-detained "Held on bail" -> charging {
    authority cite ?("SDCL § 23A-43-2, CURRENCY UNCONFIRMED (text present; value unverified)")
  }
  edge-initial-appearance-released "Released on recognizance or bond" -> charging {
    authority cite ?("SDCL § 23A-43-2, CURRENCY UNCONFIRMED (text present; value unverified)")
  }
}

decision charging: "Preliminary hearing; indictment or information" by court cite ?("SDCL § 23A-6-3, CURRENCY UNCONFIRMED (text present; value unverified)")
{
  note "The preliminary hearing provisions are stated in SDCL § 23A-6-3; its deadline to file a felony information is 30 days after the preliminary hearing unless extended by the court. Unverified: CURRENCY UNCONFIRMED."
  edge-charging-charged "Indictment or information filed" -> arraignment {
    authority cite ?("SDCL § 23A-6-1, CURRENCY UNCONFIRMED (text present; value unverified)")
  }
  edge-charging-none "No probable cause; discharged" -> dismissed {
    authority cite ?("SDCL §§ 23A-4-1 to 23A-4-8, CURRENCY UNCONFIRMED (text present; value unverified)")
  }
}

state arraignment: "Arraignment and plea" by applicant cite ?("SDCL § 23A-7-1, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
{
  note "An arraignment is conducted in open court (a Class 2 misdemeanor's may be in chambers) by reading the indictment, information or complaint to the defendant, or stating its substance, and calling on the defendant to plead (SDCL § 23A-7-1); the pleas permitted are § 23A-7-2's. Unverified: CURRENCY UNCONFIRMED."
  edge-arraignment-pretrial "Plea of not guilty; pretrial proceedings" -> pretrial {
    authority cite ?("SDCL § 23A-44-5.1, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
  }
}

state pretrial: "Discovery and pretrial motions" by applicant cite ?("SDCL § 23A-44-5.1, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
{
  note "Every person indicted, informed or complained against is brought to trial within one hundred eighty days from the first appearance before a judicial officer on the charge (or from a mistrial, the filing of an order for new trial or of the mandate on remand), excluding the delay from other proceedings concerning the defendant (including the time from filing to final disposition of the defendant's pretrial motions), continuances at the defendant's request or with consent approved by written order, certain prosecution continuances, the defendant's absence, a change of judge the defendant obtains, a declared judicial emergency, and other delay the court finds is for good cause (SDCL § 23A-44-5.1(1)-(4)). Unverified: CURRENCY UNCONFIRMED. Pretrial motions and discovery are addressed in §§ 23A-8-3 and 23A-13-1 et seq.; no general filing deadline is stated in these cited provisions."
  edge-pretrial-motions "Pretrial motion filed" -> motions-ruling {
    authority cite ?("SDCL § 23A-8-3, CURRENCY UNCONFIRMED (text present; value unverified)")
  }
  edge-pretrial-speedy "180 days run; motion to dismiss" -> motions-ruling {
    authority cite ?("SDCL § 23A-44-5.1, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
  }
  edge-pretrial-plea "Plea negotiations" -> plea-decision {
    authority cite ?("SDCL § 23A-7-2, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
  }
}

decision motions-ruling: "Ruling on pretrial motions" by court cite ?("SDCL § 23A-44-5.1, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
{
  note "If the defendant is not tried before the time runs, as extended by excluded periods, prejudice is presumed and, unless the prosecuting attorney rebuts it, the defendant is entitled to dismissal with prejudice of the offense charged and any offense required to be joined with it (SDCL § 23A-44-5.1(5)); a dismissal under §§ 23A-44-2 to 23A-44-4 does not bar another prosecution (§ 23A-44-5). Unverified: CURRENCY UNCONFIRMED."
  edge-motions-ruling-speedy "Dismissed with prejudice under the 180-day rule" -> dismissed {
    authority cite ?("SDCL § 23A-44-5.1, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
  }
  edge-motions-ruling-denied "Motions denied; case proceeds" -> plea-decision {
    authority cite ?("SDCL § 23A-8-3, CURRENCY UNCONFIRMED (text present; value unverified)")
  }
}

decision plea-decision: "Plea or trial" by applicant cite ?("SDCL § 23A-7-2, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
{
  note "A defendant may plead not guilty, guilty or, with the court's consent, nolo contendere; the court advises a defendant pleading guilty or nolo contendere and determines that the plea is voluntary (SDCL §§ 23A-7-2 to 23A-7-5). Unverified: CURRENCY UNCONFIRMED."
  edge-plea-decision-plea "Guilty or nolo contendere plea accepted" -> sentencing {
    authority cite ?("SDCL § 23A-7-5, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
  }
  edge-plea-decision-trial "Trial" -> trial {
    authority cite ?("SDCL § 23A-44-5.1, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
  }
}

decision trial: "Verdict" by court cite ?("SDCL § 23A-26, CURRENCY UNCONFIRMED (text present; value unverified)")
{
  note "The verdict, judgment of acquittal, new-trial and arrest-of-judgment provisions are in SDCL chapters 23A-26, 23A-23, 23A-29 and 23A-30. New-trial and arrest-of-judgment motions are due within ten days (§§ 23A-29-1, 23A-30-1). Unverified: CURRENCY UNCONFIRMED."
  edge-trial-acquittal "Not guilty" -> acquitted {
    authority cite ?("SDCL § 23A-26, CURRENCY UNCONFIRMED (text present; value unverified)")
  }
  edge-trial-guilty "Guilty; post-trial motions" -> post-trial {
    authority cite ?("SDCL § 23A-29, CURRENCY UNCONFIRMED (text present; value unverified)")
  }
}

decision post-trial: "Post-trial motions" by court cite ?("SDCL § 23A-29, CURRENCY UNCONFIRMED (text present; value unverified)")
{
  edge-post-trial-acquittal "Judgment of acquittal" -> acquitted {
    authority cite ?("SDCL § 23A-23, CURRENCY UNCONFIRMED (text present; value unverified)")
  }
  edge-post-trial-new-trial "New trial granted" -> trial {
    authority cite ?("SDCL § 23A-29, CURRENCY UNCONFIRMED (text present; value unverified)")
  }
  edge-post-trial-arrest "Judgment arrested" -> dismissed {
    authority cite ?("SDCL § 23A-30, CURRENCY UNCONFIRMED (text present; value unverified)")
  }
  edge-post-trial-denied "Motions denied; sentencing" -> sentencing {
    authority cite ?("SDCL § 23A-27-1, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
  }
}

state sentencing: "Sentence and judgment" by court cite ?("SDCL § 23A-27-1, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
{
  note "Sentence is imposed without unreasonable delay, but not within forty-eight hours after the determination of guilt unless the defendant waives that delay; before sentence the court may hold a hearing in mitigation or aggravation (SDCL § 23A-27-1). Unverified: CURRENCY UNCONFIRMED."
  edge-sentencing-judgment "Sentence imposed; judgment entered" -> judgment {
    authority cite ?("SDCL § 23A-27-1, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
  }
}

decision judgment: "Judgment of conviction" by applicant cite ?("SDCL § 23A-32-2, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
{
  note "The defendant may appeal to the Supreme Court from a final judgment of conviction (SDCL § 23A-32-2); the prosecution's appeals under §§ 23A-32-4 and 23A-32-5 are taken within ten days after written notice of entry of the judgment or order (§ 23A-32-6). Unverified: CURRENCY UNCONFIRMED. A judgment appeal must be taken within thirty days after the judgment is signed, attested and filed; other appeals within thirty days after written notice (§ 23A-32-15). A timely new-trial motion tolls the appeal period as specified there. Unverified: CURRENCY UNCONFIRMED."
  edge-judgment-appeal "Notice of appeal filed" -> appeal-taken {
    authority cite ?("SDCL § 23A-32-15, CURRENCY UNCONFIRMED (text present; value unverified)")
  }
  edge-judgment-no-appeal "No appeal" -> conviction-final {
    authority cite ?("SDCL § 23A-32-15, CURRENCY UNCONFIRMED (text present; value unverified)")
  }
}

terminal acquitted: "Acquitted" outcome [win] cite ?("SDCL § 23A-26, CURRENCY UNCONFIRMED (text present; value unverified)")

terminal dismissed: "Charge dismissed or judgment arrested" outcome [win, dismissal] cite ?("SDCL § 23A-44-5.1, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")

terminal appeal-taken: "Appeal to the Supreme Court" outcome [appeal] cite ?("SDCL § 23A-32-2, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")
{
  note "The appeal continues before the South Dakota Supreme Court (lit/sd)."
}

terminal conviction-final: "Conviction final" outcome [loss] cite ?("SDCL § 23A-32-2, CURRENCY UNCONFIRMED (the Legislature's API states no edition date); the value is the vendored text, unverified")

