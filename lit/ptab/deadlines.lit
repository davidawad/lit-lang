/// Rehearing of a final decision: "Within 30 days of the entry of a final
/// decision" (37 C.F.R. § 42.71(d)(2)). The section was amended in 2015 (80
/// Fed. Reg. 28561, May 19, 2015) and 2020 (85 Fed. Reg. 79120, effective
/// Jan. 8, 2021), per its vendored history line; neither changed the 30 days.
/// UNVERIFIED against the earlier texts, which are not vendored.
rule duty rehearing-deadline cite 37 C.F.R. § 42.71(d)(2)
{
  deadline rehearing-period: 30.days after DecisionEntered(FinalWritten) counted_by rcfc6 effective [2012-09-16, 2021-01-08) known_at 2012-08-14 delegable_to [CaseOrder] cite ?("the 2012 and 2015 texts (77 Fed. Reg. 48612 (Aug. 14, 2012); 80 Fed. Reg. 28561 (May 19, 2015)) are not vendored: 37 C.F.R. § 42.71(d)(2) before the 2020 amendment")
  deadline rehearing-period: 30.days after DecisionEntered(FinalWritten) counted_by rcfc6 effective [2021-01-08, ..) known_at 2020-12-09 supersedes rehearing-period@2012-09-16 delegable_to [CaseOrder] cite 37 C.F.R. § 42.71(d)(2); 37 C.F.R. § 42.5(c)(1)
}

test "rehearing: 30 days from the final written decision" cite 37 C.F.R. § 42.71(d)(2)
{
  given DecisionEntered(FinalWritten) on 2025-03-03
  expect deadline(rehearing-period) == 2025-04-02
}

test "rehearing: a Sunday last day before Labor Day rolls to Tuesday" cite 37 C.F.R. § 42.71(d)(2)
{
  given DecisionEntered(FinalWritten) on 2025-08-01
  expect deadline(rehearing-period) == 2025-09-02
}

test "rehearing under the pre-2021 rule: a Sunday last day rolls to Monday" cite 37 C.F.R. § 42.71(d)(2)
{
  given DecisionEntered(FinalWritten) on 2018-06-01
  expect deadline(rehearing-period) == 2018-07-02
}

/// Director review: a request within 30 days of the final written decision
/// (or of a decision on rehearing, below), under the USPTO's Interim
/// Director Review Process of June 29, 2021, which the pack cites. The
/// pack's "37 CFR 42.73(d)(1)" is the estoppel rule, not Director review.
/// UNVERIFIED: the process is not vendored.
rule duty director-review-deadline effective [2021-06-29, ..) known_at 2021-06-29 cite ?("USPTO Interim Director Review Process (June 29, 2021); not vendored") {
  deadline director-review-period: 30.days after DecisionEntered(FinalWritten) counted_by rcfc6 effective [2021-06-29, ..) known_at 2021-06-29 delegable_to [CaseOrder] cite ?("USPTO Interim Director Review Process (June 29, 2021): 30 days from the final written decision, per the pack; the pack's 37 CFR 42.73(d)(1) is the estoppel rule")
  deadline director-review-after-rehearing-period: 30.days after DecisionEntered(Rehearing) counted_by rcfc6 effective [2021-06-29, ..) known_at 2021-06-29 delegable_to [CaseOrder] cite ?("USPTO Interim Director Review Process (June 29, 2021): 30 days from the rehearing decision, per the pack; the pack's 37 CFR 42.73(d)(1) is the estoppel rule")
}

test "Director review: 30 days from the final written decision" cite ?("USPTO Interim Director Review Process (June 29, 2021)") {
  given DecisionEntered(FinalWritten) on 2025-09-02
  expect deadline(director-review-period) == 2025-10-02
}

test "Director review: a Sunday last day before Columbus Day rolls to Tuesday" cite ?("USPTO Interim Director Review Process (June 29, 2021)") {
  given DecisionEntered(FinalWritten) on 2025-09-12
  expect deadline(director-review-period) == 2025-10-14
}

test "Director review after rehearing: 30 days from the rehearing decision" cite ?("USPTO Interim Director Review Process (June 29, 2021)") {
  given DecisionEntered(FinalWritten) on 2025-09-02
  given DecisionEntered(Rehearing) on 2025-11-03
  expect deadline(director-review-after-rehearing-period) == 2025-12-03
}

test "Director review after rehearing: a Sunday last day before MLK Day rolls to Tuesday" cite ?("USPTO Interim Director Review Process (June 29, 2021)") {
  given DecisionEntered(Rehearing) on 2025-12-19
  expect deadline(director-review-after-rehearing-period) == 2026-01-20
}

/// A written request to the Director to extend the time for appeal (37
/// C.F.R. § 90.3(c)(1)). Its date is its receipt date: the Eastern Time
/// date the Office of the General Counsel receives the email, "regardless
/// of whether that date is a Saturday, Sunday, or Federal holiday within
/// the District of Columbia" (§ 90.3(c)(2)). That date is `request_made`.
event AppealExtensionRequested()
/// The Director, or the Director's designee, extends the time for appeal
/// to `until` (37 C.F.R. § 90.3(c)(1)).
event AppealPeriodExtended(until: Date) extends appeal-period to until

/// The notice of appeal is due "no later than sixty-three (63) days after
/// the date of the final Board decision" (37 C.F.R. § 90.3(a)(1)); a timely
/// rehearing request resets that to 63 days "after action on the request"
/// (§ 90.3(b)(1)), so the period runs from the latest decision entered. The
/// vendored history: "Added, 77 FR 48612, Aug. 14, 2012, effective Sept. 16,
/// 2012; paras. (c)(1) introductory text and (c)(2) revised, 89 FR 22084,
/// Mar. 29, 2024, effective Mar. 29, 2024"; paragraph (a) is unchanged.
/// Extension: "The Director, or the Director's designee, may extend the
/// time for filing an appeal ... upon written request if: (i) Requested
/// before the expiration of the period ..., and upon a showing of good
/// cause; or (ii) Requested after the expiration of the period ..., and
/// upon a showing that the failure to act was the result of excusable
/// neglect" (§ 90.3(c)(1)). Both turn on when the request was made, not
/// when the Director acts, and neither has a numeric ceiling. The
/// extender is the Director: no court, district or Federal Circuit, holds
/// the power. The grants are on the version in force from Mar. 29, 2024,
/// whose text is vendored; the 2012 version's paragraph (c) is not
/// vendored, so it grants nothing here (UNVERIFIED: its pre-2024 text).
rule duty appeal-deadline cite 37 C.F.R. § 90.3(a)(1)
{
  deadline appeal-period: 63.days after DecisionEntered() counted_by rcfc6 effective [2012-09-16, 2024-03-29) known_at 2012-08-14 cite 37 C.F.R. § 90.3(a)(1); 37 C.F.R. § 90.3(b)(1)
  {
    trigger latest
  }
  deadline appeal-period: 63.days after DecisionEntered() counted_by rcfc6 effective [2024-03-29, ..) known_at 2024-03-29 supersedes appeal-period@2012-09-16 cite 37 C.F.R. § 90.3(a)(1); 37 C.F.R. § 90.3(b)(1)
  {
    trigger latest
    extend { by director, discretion GoodCause, on AppealExtensionRequested() }
    extend { by director, discretion ExcusableNeglect, after_expiry, on AppealExtensionRequested() }
  }
}

test "appeal: 63 days from the final written decision" cite 37 C.F.R. § 90.3(a)(1)
{
  given DecisionEntered(FinalWritten) on 2025-03-03
  expect deadline(appeal-period) == 2025-05-05
}

test "appeal: a last day on Christmas rolls to Friday" cite 37 C.F.R. § 90.3(b)(2)
{
  given DecisionEntered(FinalWritten) on 2025-10-23
  expect deadline(appeal-period) == 2025-12-26
}

test "appeal: a rehearing decision resets the 63 days" cite 37 C.F.R. § 90.3(b)(1)
{
  given DecisionEntered(FinalWritten) on 2025-03-03
  given DecisionEntered(Rehearing) on 2025-04-15
  expect deadline(appeal-period) == 2025-06-17
}

test "appeal under the 2012 text" cite 37 C.F.R. § 90.3(a)(1)
{
  given DecisionEntered(FinalWritten) on 2020-01-02
  expect deadline(appeal-period) == 2020-03-05
}
