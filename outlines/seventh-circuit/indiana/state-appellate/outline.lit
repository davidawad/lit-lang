// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-in-state-appellate

start notice-filed

state notice-filed: "Notice of appeal filed" by applicant cite ?("Ind. App. R. 9(A)(1)")
{
  note "OUTLINE. Notice within the Rule 9(A) period (hole); verify tolling by motion to correct error."
  edge-notice-filed-appealability "Notice filed" -> appealability {
    authority cite ?("Ind. App. R. 9(A)(1)")
  }
}

decision appealability: "Appellate jurisdiction check" by court cite ?("Ind. App. R. 2(H), 14")
{
  note "OUTLINE. Final judgment under App. R. 2(H); interlocutory orders under App. R. 14 (verify). No leading decision named."
  edge-appealability-dismissed-jurisdiction "Not an appealable order, or untimely" -> dismissed-jurisdiction {
    authority cite ?("Ind. App. R. 2(H), 14")
  }
  edge-appealability-record "Appealable order" -> record {
    authority cite ?("Ind. App. R. 2(H), 14")
  }
}

terminal dismissed-jurisdiction: "Dismissed for lack of appellate jurisdiction" outcome [loss] cite ?("Ind. App. R. 2(H), 14")
{
  note "OUTLINE. Outcome from the applicant's side."
  payoff ?
}

state record: "Record settled and transmitted" cite ?("Ind. App. R. 10")
{
  note "OUTLINE. Record under App. R. 10 (verify)."
  edge-record-briefing "Record filed" -> briefing {
    authority cite ?("Ind. App. R. 10")
  }
}

state briefing: "Briefing: opening, response, reply" cite ?("Ind. App. R. 43, 44, 46")
{
  note "OUTLINE. Briefing schedule is a hole. Brief content and length are holes (App. R. 43, 44, 46)."
  edge-briefing-argument "Briefs complete" -> argument {
    authority cite ?("Ind. App. R. 43, 44, 46")
  }
}

state argument: "Oral argument or submission on briefs" cite ?("Ind. App. R. 46 (verify)")
{
  note "OUTLINE. Argument may be waived."
  edge-argument-disposition "Submitted for decision" -> disposition {
    authority cite ?("Ind. App. R. 46 (verify)")
  }
}

decision disposition: "Disposition" by court cite ?("Ind. App. R. 58 (verify)")
{
  note "OUTLINE. Disposition and opinion publication (verify)."
  edge-disposition-affirmed-entered "Affirmed" -> affirmed-entered {
    authority cite ?("Ind. App. R. 58 (verify)")
  }
  edge-disposition-reversed-entered "Reversed or vacated" -> reversed-entered {
    authority cite ?("Ind. App. R. 58 (verify)")
  }
  edge-disposition-remanded-entered "Remanded" -> remanded-entered {
    authority cite ?("Ind. App. R. 58 (verify)")
  }
}

decision affirmed-entered: "Affirmed: rehearing election" by applicant cite ?("Ind. App. R. 58 (verify)")
{
  note "OUTLINE. Rehearing and mandate clocks run from entry."
  edge-affirmed-entered-rehearing-affirmed "Rehearing petition filed" -> rehearing-affirmed {
    authority cite ?("Ind. App. R. 54 (verify)")
  }
  edge-affirmed-entered-mandate-affirmed "No rehearing petition" -> mandate-affirmed {
    authority cite ?("Ind. App. R. 58 (verify)")
  }
}

decision rehearing-affirmed: "Rehearing ruling (affirmed)" by court cite ?("Ind. App. R. 54 (verify)")
{
  note "OUTLINE. Rehearing (verify)."
  edge-rehearing-affirmed-mandate-affirmed "Rehearing denied" -> mandate-affirmed {
    authority cite ?("Ind. App. R. 54 (verify)")
  }
  edge-rehearing-affirmed-disposition "Rehearing granted: re-decide" -> disposition {
    authority cite ?("Ind. App. R. 54 (verify)")
  }
}

decision mandate-affirmed: "Mandate issued: further review election" by applicant cite ?("Ind. App. R. 58 (verify)")
{
  note "OUTLINE. Mandate and its effect on the trial court."
  edge-mandate-affirmed-review-affirmed "Further review sought" -> review-affirmed {
    authority cite ?("Ind. App. R. 57")
  }
  edge-mandate-affirmed-affirmed-final "No further review" -> affirmed-final {
    authority cite ?("Ind. App. R. 58 (verify)")
  }
}

decision review-affirmed: "Further review ruling (affirmed)" by court cite ?("Ind. App. R. 57")
{
  note "OUTLINE. Petition to transfer under App. R. 57 (verify)."
  edge-review-affirmed-affirmed-final "Review denied" -> affirmed-final {
    authority cite ?("Ind. App. R. 57")
  }
  edge-review-affirmed-affirmed-final-2 "Review granted: merits in high court" -> affirmed-final {
    authority cite ?("Ind. App. R. 57")
  }
}

terminal affirmed-final: "Affirmed: final" outcome [loss] cite ?("Ind. App. R. 58 (verify)")
{
  note "OUTLINE. Outcome from the applicant's side."
  payoff ?
}

decision reversed-entered: "Reversed or vacated: rehearing election" by applicant cite ?("Ind. App. R. 58 (verify)")
{
  note "OUTLINE. Rehearing and mandate clocks run from entry."
