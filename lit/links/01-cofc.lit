// Court of Federal Claims <-> Federal Circuit. 28 U.S.C. § 1295(a)(3) gives
// the Federal Circuit exclusive jurisdiction of appeals from final CoFC
// decisions; § 2522 sets the notice of appeal at 60 days after judgment
// (lit/cafc's `cofc-noa-period`); § 2106 empowers the remand. The United
// States defends every CoFC case, so each side's appeal enters its own
// instance: `cafc@cofc` (the plaintiff appeals a loss) and `cafc@cofc-gov`
// (the government appeals a plaintiff's win, perspective flipped).
//
// The appeal authorities stay cite holes carrying the legacy text verbatim:
// `28 U.S.C. §§ 1295(a)(3), 2522` has a comma, which ends citation mode, so
// it has no `CiteText` spelling (SPEC §2) and any respelling would change
// the generated `authority` string.
module links.cofc

/// The plaintiff's appeal. Only `origin-to-cofc` and `remand-route-cofc`
/// survive. The rehearing patches set the 45-day United States-party
/// period (`rehearing-period-united-states-party`).
///
/// Proposed fix, not applied (it would change the generated note): the
/// `rehearing-time-expires` note pins the 45 days on Fed. Cir. R. 40(a)(1);
/// in the vendored Dec. 1, 2025 rules the time is Fed. Cir. R. 40(f)(1),
/// and 40(a)(1) is the general rehearing provision.
instance cafc@cofc {
  pack cafc
  note "Federal Circuit as entered by the CoFC plaintiff appealing a loss (plaintiff = appellant = self). Remand can only return to the CoFC."
  remove_edges [origin-to-district-court, origin-to-ptab, origin-to-itc, remand-route-district-court, remand-route-ptab, remand-route-itc, origin-to-ttab, remand-route-ttab]
  probabilities { remand-route-cofc: 1 }
  patch rehearing-file {
    deadline: {
      length: 45
      note: "45 days after entry of judgment because the United States is a party to every CoFC appeal (Fed. Cir. R. 40, Federal Circuit Rules of Practice Dec. 1, 2025: 30 days, or 45 if the United States or its officer or agency is a party)."
    }
  }
  patch rehearing-time-expires {
    deadline: {
      length: 45
      note: "The rehearing window this edge waits out is 45 days here, not 30, because the United States is a party (Fed. Cir. R. 40(a)(1)); the mandate then issues 7 days after it expires (FRAP 41(b))."
    }
  }
}

/// The government's appeal. Roles flip so the United States (`examiner`,
/// the appellant) is the opponent, and payoffs become the plaintiff's under
/// `1000000 - payoff`: the $1M stake is the legacy placeholder, which a
/// matter overrides with its own stakes. Same rehearing patches and same
/// proposed note fix as `cafc@cofc`.
instance cafc@cofc-gov {
  pack cafc
  note "Federal Circuit as entered by the United States appealing a CoFC plaintiff win. Perspective flipped: the government (appellant) is the opponent; payoffs are the plaintiff's (stake − appellant payoff, stake = $1M placeholder)."
  remove_edges [origin-to-district-court, origin-to-ptab, origin-to-itc, remand-route-district-court, remand-route-ptab, remand-route-itc, origin-to-ttab, remand-route-ttab]
  probabilities { remand-route-cofc: 1 }
  roles { applicant: opponent, examiner: self }
  payoff_transform "1000000 - payoff"
  patch rehearing-file {
    deadline: {
      length: 45
      note: "45 days after entry of judgment because the United States is a party to every CoFC appeal (Fed. Cir. R. 40, Federal Circuit Rules of Practice Dec. 1, 2025: 30 days, or 45 if the United States or its officer or agency is a party)."
    }
  }
  patch rehearing-time-expires {
    deadline: {
      length: 45
      note: "The rehearing window this edge waits out is 45 days here, not 30, because the United States is a party (Fed. Cir. R. 40(a)(1)); the mandate then issues 7 days after it expires (FRAP 41(b))."
    }
  }
}

/// A judgment for the United States after a bench trial (RCFC 52(a), 58) is
/// appealable by the plaintiff (28 U.S.C. § 1295(a)(3)).
link cofc-appeal-judgment-for-government "Plaintiff appeals the judgment to the Federal Circuit": cofc::judgment-for-government -> cafc@cofc::entry-cofc by applicant {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// Summary judgment for the United States (RCFC 56) is a final decision.
link cofc-appeal-sj-for-government "Plaintiff appeals the summary judgment": cofc::summary-judgment-for-government -> cafc@cofc::entry-cofc by applicant {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// A dismissal for lack of subject-matter jurisdiction (RCFC 12(b)(1)).
link cofc-appeal-dismissal-jurisdiction "Plaintiff appeals the RCFC 12(b)(1) dismissal": cofc::dismissed-lack-of-jurisdiction -> cafc@cofc::entry-cofc by applicant {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// A dismissal for failure to state a claim (RCFC 12(b)(6)).
link cofc-appeal-dismissal-failure-to-state "Plaintiff appeals the RCFC 12(b)(6) dismissal": cofc::dismissed-failure-to-state -> cafc@cofc::entry-cofc by applicant {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// A dismissal under the six-year limitation of 28 U.S.C. § 2501.
link cofc-appeal-time-bar "Plaintiff appeals the § 2501 time-bar dismissal": cofc::dismissed-time-barred -> cafc@cofc::entry-cofc by applicant {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// A dismissal under 28 U.S.C. § 1500 (same claim pending in another
/// court).
link cofc-appeal-1500-bar "Plaintiff appeals the § 1500 dismissal": cofc::dismissed-1500-bar -> cafc@cofc::entry-cofc by applicant {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// A bid-protest judgment under 28 U.S.C. § 1491(b) is appealed the same
/// way.
link cofc-appeal-protest-denied "Protester appeals the bid-protest judgment": cofc::protest-denied -> cafc@cofc::entry-cofc by applicant {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// The government's appeals enter `cafc@cofc-gov`, by `examiner` (the
/// United States, the opponent in the cofc package).
link cofc-gov-appeal-judgment-for-plaintiff "United States appeals the judgment for plaintiff": cofc::judgment-for-plaintiff -> cafc@cofc-gov::entry-cofc by examiner {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  note "The government's appeal decision (Solicitor General authorization, 28 C.F.R. § 0.20(b)) is modeled as the opponent's choice; with no probability authored it is solved adversarially (worst case for the plaintiff). Author a probability here to use an appeal rate instead."
  tags [appeal]
}

/// A judgment entered for the plaintiff on summary judgment.
link cofc-gov-appeal-sj-for-plaintiff "United States appeals the judgment entered for plaintiff": cofc::judgment-entered -> cafc@cofc-gov::entry-cofc by examiner {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// A sustained bid protest; an intervenor awardee may appeal as well.
link cofc-gov-appeal-protest-sustained "United States (or intervenor) appeals the sustained protest": cofc::protest-sustained -> cafc@cofc-gov::entry-cofc by examiner {
  authority cite ?("28 U.S.C. §§ 1295(a)(3), 2522")
  tags [appeal]
}

/// 28 U.S.C. § 2106: a court of appellate jurisdiction may remand and
/// "require such further proceedings to be had as may be just under the
/// circumstances".
link cafc-remand-to-cofc "Remand: further proceedings in the Court of Federal Claims": cafc@cofc::remanded-to-cofc -> cofc::trial-bench by office p 1 {
  authority cite 28 U.S.C. § 2106
  note "Re-entry point modeled as further merits proceedings (bench trial). A remand on a narrower issue re-enters later; override with scenario.mask/start when the mandate is specific."
  tags [remand]
}

/// The same remand from the government's appeal.
link cafc-gov-remand-to-cofc "Remand: further proceedings in the Court of Federal Claims": cafc@cofc-gov::remanded-to-cofc -> cofc::trial-bench by office p 1 {
  authority cite 28 U.S.C. § 2106
  tags [remand]
}
