// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-la-trial-court

import outline-la-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start complaint-filed

state complaint-filed: "Complaint Filed" by applicant cite ?("La. C.C.P. art. 421")
{
  note "OUTLINE. A civil action is commenced by filing a petition (art. 421). Petition contents: art. 891 (verify). Venue articles are not cited here (verify numbers)."
  edge-complaint-filed-service "Served" -> service-made {
    authority cite ?("La. C.C.P. arts. 1201, 1231")
  }
}

state service-made: "Served" by applicant cite ?("La. C.C.P. arts. 1201, 1231")
{
  note "OUTLINE. Citation (art. 1201) and service of citation (art. 1231) (verify). Service period and abandonment are holes; abandonment for inactivity is art. 561 (verify)."
  edge-service-made-response "Served in time" -> response-due { event ActionCommenced()
    authority cite ?("La. C.C.P. arts. 1201, 1231")
  }
  edge-service-made-lapsed "Not served in time" -> service-dismissal {
    authority cite ?("La. C.C.P. art. ?")
  }
}

decision response-due: "Answer, pleading challenge, or nothing" by office cite ?("La. C.C.P. art. 1001")
{
  note "OUTLINE. Answer due 21 days after service (art. 1001; verify current text). Affirmative defenses in the answer (art. 1005; verify)."
  edge-response-due-answer "Answer filed" -> answered {
    authority cite ?("La. C.C.P. art. 1001")
  }
  edge-response-due-pleading "Pleading challenge filed" -> pleading-motion {
    authority cite ?("La. C.C.P. arts. 925, 926, 927, 928")
  }
  edge-response-due-default "No response" -> default-request {
    authority cite ?("La. C.C.P. art. 1701")
  }
}

state pleading-motion: "Declinatory, dilatory or peremptory exception" by office cite ?("La. C.C.P. arts. 925, 926, 927, 928")
{
  note "OUTLINE. Declinatory and dilatory exceptions are pleaded before or with the answer (art. 928; verify). No cause of action (art. 927(A)(5)) and no right of action (art. 927(A)(6)) (verify). Verify: Everything on Wheels Subaru, Inc. v. Subaru South, Inc., 616 So. 2d 1234 (La. 1993) (no cause of action)."
  edge-pleading-motion-ruling "Court rules" -> pleading-ruling {
    authority cite ?("La. C.C.P. arts. 925, 926, 927, 928")
  }
}

decision pleading-ruling: "Ruling on pleading challenge" by court cite ?("La. C.C.P. arts. 925, 926, 927, 928")
{
  note "OUTLINE. Leave to amend is governed by the amendment rule (cite below). Verify leading decisions before use."
  edge-pleading-ruling-dismissed "Dismissed with prejudice" -> dismissed-merits {
    authority cite ?("La. C.C.P. arts. 925, 926, 927, 928")
  }
  edge-pleading-ruling-leave "Dismissed with leave to amend" -> amended {
    authority cite ?("La. C.C.P. art. 934")
  }
  edge-pleading-ruling-denied "Denied" -> answered {
    authority cite ?("La. C.C.P. art. 1001")
  }
}

state amended: "Amended pleading filed" by applicant cite ?("La. C.C.P. art. 934")
{
  note "OUTLINE. Response period to the amended pleading is a hole (?)."
  edge-amended-response "Amended pleading served" -> response-due { event ActionCommenced()
    authority cite ?("La. C.C.P. art. 1001")
  }
}

state answered: "Answer filed" by applicant cite ?("La. C.C.P. art. 1001")
{
  note "OUTLINE. Affirmative defenses must be pleaded (cite below); discovery opens after pleadings close."
  edge-answered-discovery "Pleadings closed" -> discovery {
    authority cite ?("La. C.C.P. arts. 1421, 1457, 1461")
  }
}

state default-request: "Default sought" by applicant cite ?("La. C.C.P. art. 1701")
{
  note "OUTLINE. Preliminary default on motion (art. 1701; verify). Confirmation by default requires proof of the demand and the claim (art. 1702; verify)."
  edge-default-request-entered "Default entered" -> default-entered {
    authority cite ?("La. C.C.P. art. 1701")
  }
  edge-default-request-answered "Answer filed before default" -> answered {
    authority cite ?("La. C.C.P. art. 1001")
  }
}

state default-entered: "Default entered" by applicant cite ?("La. C.C.P. art. 1702")
{
  note "OUTLINE. Default judgment requires proof of the claim; a hearing may be needed for damages (verify). Setting aside is a hole until verified."
  edge-default-entered-judgment "Default judgment sought" -> default-judgment {
    authority cite ?("La. C.C.P. art. 1702")
  }
  edge-default-entered-set-aside "Defendant moves to set aside" -> set-aside-ruling {
    authority cite ?("La. C.C.P. art. ?")
  }
}

decision set-aside-ruling: "Set aside the default?" by court cite ?("La. C.C.P. art. ?")
{
  note "OUTLINE. Standard and any time limit are holes until verified."
  edge-set-aside-granted "Set aside" -> answered {
    authority cite ?("La. C.C.P. art. ?")
  }
  edge-set-aside-refused "Refused" -> default-judgment {
    authority cite ?("La. C.C.P. art. ?")
  }
}

state discovery: "Discovery" by applicant cite ?("La. C.C.P. arts. 1421, 1457, 1461")
{
  note "OUTLINE. Scope (art. 1421). Interrogatories (art. 1457), production (art. 1461), protective orders (art. 1426), sanctions (art. 1471) (all verify). Deposition and request-for-admission articles to be added (verify)."
  edge-discovery-dispute "Discovery dispute" -> discovery-ruling {
    authority cite ?("La. C.C.P. arts. 1421, 1457, 1461")
  }
  edge-discovery-sj "Dispositive motion" -> sj-motion {
    authority cite ?("La. C.C.P. art. 966")
  }
  edge-discovery-settled "Settled" -> settled {
    authority cite ?("La. C.C. art. 3071")
  }
  edge-discovery-voluntary "Voluntary dismissal" -> voluntary-dismissal {
    authority cite ?("La. C.C.P. art. 1671")
  }
  edge-discovery-inactive "No prosecution" -> inactivity-dismissal {
    authority cite ?("La. C.C.P. art. 561")
  }
}

decision discovery-ruling: "Discovery ruling" by court cite ?("La. C.C.P. art. 1471")
{
  note "OUTLINE. Meet-and-confer and sanction prerequisites are holes until verified."
  edge-discovery-ruling-resolved "Dispute resolved" -> discovery {
    authority cite ?("La. C.C.P. arts. 1421, 1457, 1461")
  }
  edge-discovery-ruling-sanction "Sanction dismissal" -> sanction-dismissal {
    authority cite ?("La. C.C.P. art. 1471")
  }
}

state sj-motion: "Summary judgment motion" by office cite ?("La. C.C.P. art. 966")
{
  note "OUTLINE. Standard: no genuine issue of material fact and mover entitled to judgment (art. 966; verify current text). Supporting documents (arts. 966 and 967; verify). Verify: Hines v. Garrett, 2004-0806 (La. 6/25/04), 876 So. 2d 764 (summary judgment standard)."
  edge-sj-motion-ruling "Motion heard" -> sj-ruling {
    authority cite ?("La. C.C.P. art. 966")
  }
}

decision sj-ruling: "Summary judgment ruling" by court cite ?("La. C.C.P. art. 966")
{
  note "OUTLINE. Partial summary judgment availability is a hole until verified."
  edge-sj-ruling-defense "Granted for defendant" -> sj-defense {
    authority cite ?("La. C.C.P. art. 966")
  }
  edge-sj-ruling-applicant "Granted for applicant" -> judgment-for-applicant {
    authority cite ?("La. C.C.P. art. 1841")
  }
  edge-sj-ruling-denied "Denied" -> trial-setting {
    authority cite ?("La. C.C.P. arts. 1731, 1733")
  }
}

state trial-setting: "Trial setting and jury request" by office cite ?("La. C.C.P. arts. 1731, 1733")
{
  note "OUTLINE. Jury trial availability and demand timing (arts. 1732, 1733; verify). Most civil cases are bench trials unless a jury right applies (verify)."
  edge-trial-setting-result "Tried" -> trial-result {
    authority cite ?("La. C.C.P. arts. 1731, 1733")
  }
}

decision trial-result: "Judgment after trial" by court cite ?("La. C.C.P. art. 1841")
{
  note "OUTLINE. Post-trial motion periods are holes (?) until verified."
  edge-trial-result-applicant "Judgment for applicant" -> judgment-for-applicant {
    authority cite ?("La. C.C.P. art. 1841")
  }
  edge-trial-result-defense "Judgment for defendant" -> verdict-for-defendant {
    authority cite ?("La. C.C.P. art. 1841")
  }
  edge-trial-result-post "Post-trial motion filed" -> post-trial { event JudgmentEntered()
    authority cite ?("La. C.C.P. arts. 1811, 1972, 1974")
  }
}

decision post-trial: "Post-trial motion ruling" by court cite ?("La. C.C.P. arts. 1811, 1972, 1974")
{
  note "OUTLINE. Grounds and time limits are holes until verified. Leading decisions: verify."
  edge-post-trial-new-trial "New trial granted" -> trial-setting {
    authority cite ?("La. C.C.P. arts. 1811, 1972, 1974")
  }
  edge-post-trial-applicant "Denied; applicant's judgment stands" -> judgment-for-applicant {
    authority cite ?("La. C.C.P. art. 1841")
  }
  edge-post-trial-defense "Denied; defendant's judgment stands" -> verdict-for-defendant {
    authority cite ?("La. C.C.P. art. 1841")
  }
}

terminal service-dismissal: "Dismissed for failure to serve" outcome [loss] cite ?("La. C.C.P. art. ?")
{
  note "OUTLINE. Service period and refiling effect are holes (?)."
  payoff ?
}

terminal dismissed-merits: "Dismissed on the pleadings" outcome [loss] cite ?("La. C.C.P. arts. 925, 926, 927, 928")
{
  note "OUTLINE. Appeal route: see the state's appellate court packages."
  payoff ?
}

terminal default-judgment: "Default judgment" outcome [win] cite ?("La. C.C.P. art. 1702")
{
  note "OUTLINE. Damages and costs are holes."
  payoff ?
}

terminal sanction-dismissal: "Dismissed as discovery sanction" outcome [loss] cite ?("La. C.C.P. art. 1471")
{
  note "OUTLINE. Sanction prerequisites are holes until verified."
  payoff ?
}

terminal inactivity-dismissal: "Dismissed for inactivity" outcome [loss] cite ?("La. C.C.P. art. 561")
{
  note "OUTLINE. Period of inactivity and any notice requirement are holes (?)."
  payoff ?
}

terminal voluntary-dismissal: "Voluntary dismissal" outcome [neutral] cite ?("La. C.C.P. art. 1671")
{
  note "OUTLINE. Effect of dismissal on refiling is a hole until verified."
  payoff ?
}

terminal settled: "Settled" outcome [neutral] cite ?("La. C.C. art. 3071")
{
  note "OUTLINE. Terms are holes."
  payoff ?
}

terminal sj-defense: "Summary judgment for defendant" outcome [loss] cite ?("La. C.C.P. art. 966")
{
  note "OUTLINE. Appeal route: see the state's appellate court packages."
  payoff ?
}

terminal judgment-for-applicant: "Judgment for applicant" outcome [win] cite ?("La. C.C.P. art. 1841")
{
  note "OUTLINE. Costs, interest and fee recovery are holes."
  payoff ?
}

terminal verdict-for-defendant: "Judgment or verdict for defendant" outcome [loss] cite ?("La. C.C.P. art. 1841")
{
  note "OUTLINE. Costs are holes."
  payoff ?
}
