// Ported from packs/mpep-prosecution.json (`litigate import`, then made strict).
module mpep.filing-to-allowance

import mpep.deadlines.{
  appeal-brief,
  appeal-forwarding-fee,
  broadening-reissue,
  court-review,
  election-reply,
  extension-month,
  final-reply,
  issue-fee,
  missing-parts-reply,
  ssp-reply,
}

import mpep.post-grant.{ patent-challenged }
import mpep.reissue.{ reissue-pending }
import mpep.{ after-final-group, allowance-group, appeal-group, examination-group, filing-group }

chance nonprovisional-filed: "Nonprovisional Filed" by office discretion effective [2024-01-31, ..) cite 35 U.S.C. 111(a); 37 CFR 1.53(b)
{
  group filing-group
  note "Specification (with or without claims), drawings (if necessary), filing fee, search fee, examination fee, and oath/declaration required. Filing date = date specification received at USPTO (37 CFR 1.53(b)). The 20-year term begins here."
  _ "USPTO issues Notice to File Missing Parts" -> missing-parts p 0.15 {
    authority cite 37 CFR 1.53(f); MPEP 601
  }
  _ "Application complete — assigned to examiner" -> pre-examination p 0.85 {
    authority cite 37 CFR 1.104; MPEP 704
  }
}

state missing-parts: "Notice: Missing Parts" by applicant effective [2024-01-31, ..) cite 37 CFR 1.53(f); MPEP 601
{
  group filing-group
  note "USPTO issues a Notice to File Missing Parts if oath/declaration, basic fee, or specification is deficient. Applicant has a surcharge deadline to supply missing parts. Failure to respond = abandonment."
  _ "File missing parts + surcharge" -> pre-examination {
    authority cite 37 CFR 1.53(f); 37 CFR 1.16(f)
    effort 2.hours
    cost 170.usd
    within missing-parts-reply {
      extendable true
      extension_authority "37 CFR 1.136(a)"
      note "Missing parts surcharge required. Filing date not accorded until specification present."
    }
    duration { min 9.days, mode 30.days, max 60.days }
    valence good
    note "Surcharge $170.00, undiscounted/large-entity, effective 1/19/2025 (37 CFR 1.16(f): late filing fee, oath/declaration, or an application filed without at least one claim)."
  }
  _ "Fail to supply missing parts" -> abandoned-no-reply {
    authority cite 37 CFR 1.135; 35 U.S.C. 133
    effort 0.hours
    valence bad
  }
}

// `/// imported` keeps this declaration's unresolvable legacy citation a
// warning: its cite hole carries the original text, and cite-resolves
// checks hole reasons like cites (see the bead report). MPEP §§ 803,
// 818 and 2210-2214 are not vendored in sources/mpep.txt.
/// imported
chance pre-examination: "Pre-Examination Processing" by examiner discretion effective [2024-01-31, ..) cite MPEP 704; 37 CFR 1.104
{
  group filing-group
  note "Application assigned to a Technology Center and art unit. Examiner assigned. Awaiting first Office Action. Applicant may file a Request for Prioritized Examination (Track One) under 37 CFR 1.102(e) to accelerate."
  _ "Examiner issues Non-Final Office Action" -> non-final-oa p 0.7 {
    authority cite 35 U.S.C. 132; 37 CFR 1.104; MPEP 706
  }
  _ "Examiner allows on first action (FAOM)" -> allowance p 0.1 {
    authority cite 37 CFR 1.311; MPEP 1303
    note "First Action Allowance (FAOM) — rare but occurs on well-drafted claims with strong prior art searches."
  }
  _ "Examiner issues Restriction / Election Requirement" -> restriction-requirement p 0.2 {
    authority cite ?("37 CFR 1.142; 35 U.S.C. 121; MPEP 803")
    note "Restriction rate modeled at 0.20 (defensible 0.15–0.25 band; multi-invention applications draw restriction before/at first action). Rebalanced the pre-examination stochastic node: non-final-oa 0.90→0.70, allowance 0.10 held, restriction 0.20 — sum 1.0."
  }
}

state non-final-oa: "Non-Final Office Action" by applicant effective [2024-01-31, ..) cite 35 U.S.C. 132; 37 CFR 1.104; MPEP 706
{
  group examination-group
  note "Examiner's first rejection or objection. SSP (shortened statutory period) is typically 3 months. Extendable month-by-month up to the 6-month statutory ceiling under 37 CFR 1.136(a). Extensions require fees per 37 CFR 1.17(a)."
  _ "Receive and docket Office Action" -> applicant-response-window {
    authority cite 37 CFR 1.134; 35 U.S.C. 133
    effort 0.5.hours
  }
}

decision applicant-response-window: "Response Window Open" by applicant effective [2024-01-31, ..) cite 37 CFR 1.111; 35 U.S.C. 133
{
  group examination-group
  note "Applicant must reply within the SSP (3 months) or extend. The 6-month statutory ceiling under 35 U.S.C. 133 cannot be extended for any reason — missing it triggers immediate abandonment. Three extension slots available (1, 2, and 3 additional months) under 37 CFR 1.136(a)."
  _ "File amendment/response within SSP (3 months)" -> amendment-filed {
    authority cite 37 CFR 1.111; MPEP 714
    effort 15.hours
    within ssp-reply {
      extendable true
      extension_authority "37 CFR 1.136(a)"
      note "SSP is 3 months. Extendable month-by-month to the 6-month statutory ceiling under 35 U.S.C. 133. No extension beyond 6 months is possible."
    }
    duration { min 13.5.days, mode 45.days, max 90.days }
    valence good
  }
  _ "File extension of time (1-month)" -> extension-taken {
    authority cite 37 CFR 1.136(a); 37 CFR 1.17(a)
    effort 0.5.hours
    cost 235.usd
    within extension-month {
      extendable true
      extension_authority "37 CFR 1.136(a)"
      note "Month 4 extension. Two more available (months 5 and 6). The 6-month absolute ceiling under 35 U.S.C. 133 cannot be exceeded."
    }
    duration { min 4.5.days, mode 15.days, max 30.days }
    note "1-month extension fee $235.00, undiscounted/large-entity, effective 1/19/2025 (37 CFR 1.17(a)(1))."
  }
  _ "Fail to reply within 6-month statutory ceiling" -> abandoned-no-reply {
    authority cite 35 U.S.C. 133; 37 CFR 1.135
    effort 0.hours
    valence bad
  }
  _ "Request examiner interview" -> interview-conducted {
    authority cite 37 CFR 1.133; MPEP 713
    effort 2.hours
  }
}

state extension-taken: "Extension of Time Taken" by applicant effective [2024-01-31, ..) cite 37 CFR 1.136(a); 37 CFR 1.17(a)
{
  group examination-group
  note "Extension granted per 37 CFR 1.136(a). Each extension costs fees under 37 CFR 1.17(a). Maximum 3 extensions (months 4, 5, 6). Month 6 is the absolute ceiling — 35 U.S.C. 133 permits no further extension."
  _ "File amendment within extended period" -> amendment-filed {
    authority cite 37 CFR 1.111; MPEP 714
    effort 15.hours
    within extension-month {
      extendable true
      extension_authority "37 CFR 1.136(a)"
      note "Further extensions available up to the 6-month ceiling."
    }
    duration { min 4.5.days, mode 15.days, max 30.days }
  }
  _ "Take additional extension of time" -> extension-taken {
    authority cite 37 CFR 1.136(a); 37 CFR 1.17(a)
    effort 0.5.hours
    cost 690.usd
    within extension-month {
      extendable false
      note "Month 5 or 6 extension. After month 6, 35 U.S.C. 133 prohibits any further extension — abandonment is automatic."
    }
    duration { min 4.5.days, mode 15.days, max 30.days }
    note "37 CFR 1.17(a) extension fees are non-linear tiers on cumulative months late, not a per-month multiple: 1 mo $235.00, 2 mo $690.00, 3 mo $1,590.00, 4 mo $2,495.00, 5 mo $3,395.00 (undiscounted/large-entity, effective 1/19/2025). This edge's $690.00 is the month-5 (2-month-cumulative) tier; a second traversal (month 6) would be the 3-month tier ($1,590.00), not modeled separately here."
  }
}

chance amendment-filed: "Amendment / Response Filed" by examiner discretion effective [2024-01-31, ..) cite 37 CFR 1.111; MPEP 714
{
  group examination-group
  note "Applicant files amendment with or without arguments. Examiner must act on a complete reply. Traversal of rejections, claim amendments, and/or declaration/affidavit under 37 CFR 1.131 or 1.132 are common tools."
  _ "Examiner allows all claims" -> allowance p 0.35 { authority cite 37 CFR 1.311; MPEP 1303 }
  _ "Examiner issues new Non-Final OA" -> non-final-oa p 0.15 {
    authority cite 35 U.S.C. 132; 37 CFR 1.104
  }
  _ "Examiner issues Final Rejection" -> final-rejection p 0.5 {
    authority cite 37 CFR 1.113; MPEP 706.07
  }
}

state interview-conducted: "Examiner Interview" by applicant effective [2024-01-31, ..) cite 37 CFR 1.133; MPEP 713
{
  group examination-group
  note "Applicant may request an interview at any stage. Interviews are not a substitute for a written reply but can clarify the examiner's position and narrow disputed issues efficiently."
  _ "Follow up interview with amendment" -> amendment-filed {
    authority cite 37 CFR 1.111; MPEP 713.04
    effort 12.hours
  }
}

state allowance: "Application Allowed" by office effective [2024-01-31, ..) cite 37 CFR 1.311; MPEP 1303
{
  group allowance-group
  note "Examiner concludes all claims are patentable. Notice of Allowance (NOA) mailed. Issue fee due within 3 months from NOA date. This deadline is NOT extendable under any authority — 37 CFR 1.311(a); MPEP 1306 [R-01.2024] ('The period for payment of the issue fee and any required publication fee is not extendable, see 37 CFR 1.311(a).'). The only relief for a missed issue fee is revival under 37 CFR 1.137, not an extension of time."
  _ "Notice of Allowance mailed" -> noa-received { authority cite 37 CFR 1.311; MPEP 1303 }
}

state final-rejection: "Final Rejection" by applicant effective [2024-01-31, ..) cite 37 CFR 1.113; MPEP 706.07
{
  group examination-group
  note "Second or subsequent rejection is 'final.' After final, reply is limited to appeal (37 CFR 41.31), after-final amendment (37 CFR 1.116), AFCP 2.0 (MPEP 706.07(h)), or RCE (37 CFR 1.114). The 3-month SSP still runs; extensions still available under 37 CFR 1.136(a)."
  _ "Receive and docket Final Rejection" -> after-final-decision {
    authority cite 37 CFR 1.113; 35 U.S.C. 133
    effort 0.5.hours
  }
}

decision after-final-decision: "After-Final Choice" by applicant effective [2024-01-31, ..) cite 37 CFR 1.113; 37 CFR 1.116; 37 CFR 1.114; 37 CFR 41.31
{
  group after-final-group
  note "Four paths from final rejection: (1) after-final amendment (37 CFR 1.116 — limited scope); (2) AFCP 2.0 (no-fee examiner review of after-final amendment); (3) RCE (restart prosecution, costs filing/search/exam fees); (4) Notice of Appeal (37 CFR 41.31). The RCE-vs-appeal fork is the key economic decision point of prosecution."
  _ "File after-final amendment (37 CFR 1.116)" -> after-final-amendment {
    authority cite 37 CFR 1.116; MPEP 714.12
    effort 10.hours
    within final-reply {
      extendable true
      extension_authority "37 CFR 1.136(a)"
      note "After-final amendment limited in scope. Examiner has discretion to enter or not."
    }
    duration { min 13.5.days, mode 45.days, max 90.days }
  }
  _ "File RCE — restart prosecution" -> rce-filed {
    authority cite 37 CFR 1.114; MPEP 706.07(h)
    effort 12.hours
    cost 1_500.usd
    within final-reply {
      extendable true
      extension_authority "37 CFR 1.136(a)"
      note "RCE requires a submission + fee. Must be filed before payment of issue fee or abandonment. Reduces or eliminates patent term adjustment (PTA). Key trap: repeated RCEs compound PTA harm."
    }
    duration { min 13.5.days, mode 45.days, max 90.days }
    note "1st RCE fee $1,500.00, undiscounted/large-entity, effective 1/19/2025 (37 CFR 1.17(e)(1)); a 2nd or subsequent RCE is $2,860.00 (1.17(e)(2)). Marks the application as having used at least one RCE (37 CFR 1.114): a scenario can price a second/subsequent RCE differently with a cost expression that reads flag('rce-filed-before'). See docs/PACK_SCHEMA.md#state-flags."
    sets [rce-filed-before]
  }
  _ "File Notice of Appeal to PTAB" -> notice-of-appeal {
    authority cite 37 CFR 41.31(a)(1); 37 CFR 1.134; MPEP 1204
    effort 6.hours
    cost 905.usd
    within final-reply {
      extendable true
      extension_authority "37 CFR 41.31(d); 37 CFR 1.136(a)"
      note "Notice of Appeal timing is governed by 37 CFR 41.31(a)(1) (any twice-rejected claim) and runs within the period under 37 CFR 1.134/1.136 (the SSP for reply to the final rejection). Extensions of that period are authorized by 37 CFR 41.31(d). Cheaper up front than RCE but risks all rejected claims; the appeal brief must follow within 2 months (37 CFR 41.37(a))."
    }
    duration { min 13.5.days, mode 45.days, max 90.days }
    note "Notice of Appeal fee $905.00, undiscounted/large-entity, effective 1/19/2025 (37 CFR 41.20(b)(1)); a separate appeal-forwarding fee is due later, when the appeal brief is filed."
  }
  _ "Fail to reply after final — abandonment" -> abandoned-no-reply {
    authority cite 35 U.S.C. 133; 37 CFR 1.135
    effort 0.hours
    valence bad
  }
  _ "File continuation to pursue additional claims (37 CFR 1.53(b))" -> continuation-filed {
    authority cite 37 CFR 1.53(b); 35 U.S.C. 120; MPEP 201.07
    effort 25.hours
    cost 2_000.usd
    within final-reply {
      extendable true
      extension_authority "37 CFR 1.136(a)"
      note "Continuation must be filed while the parent is still pending (before issue-fee payment or abandonment) to claim the parent's priority under 35 U.S.C. 120. Alternative to RCE/appeal that opens a fresh child on the same disclosure."
    }
    duration { min 13.5.days, mode 45.days, max 90.days }
    note "Same filing/search/examination fees as an original nonprovisional: $2,000.00 undiscounted/large-entity, effective 1/19/2025 ($350.00 + $770.00 + $880.00, 37 CFR 1.16(a)/(k)/(o))."
  }
}

state after-final-amendment: "After-Final Amendment Filed" by examiner effective [2024-01-31, ..) cite 37 CFR 1.116; MPEP 714.12
{
  group after-final-group
  note "After-final amendment is limited: may cancel claims or comply with examiner requirements; substantive amendments only entered if they place application in condition for allowance or do not require additional search/examination."
  _ "Examiner enters amendment and allows" -> allowance { authority cite 37 CFR 1.116; MPEP 714.12 }
  _ "Amendment not entered — file RCE" -> rce-filed by applicant {
    authority cite 37 CFR 1.114
    effort 12.hours
    cost 1_500.usd
    note "1st RCE fee $1,500.00, undiscounted/large-entity, effective 1/19/2025 (37 CFR 1.17(e)(1)); a 2nd or subsequent RCE is $2,860.00 (1.17(e)(2)) -- see sets:rce-filed-before."
    sets [rce-filed-before]
  }
  _ "Amendment not entered — appeal" -> notice-of-appeal by applicant {
    authority cite 37 CFR 41.31
    effort 6.hours
    cost 905.usd
    note "Notice of Appeal fee $905.00, undiscounted/large-entity, effective 1/19/2025 (37 CFR 41.20(b)(1))."
  }
  _ "Examiner issues Advisory Action (amendment not entered)" -> advisory-action {
    authority cite 37 CFR 1.116; MPEP 714.13; MPEP 706.07(f)
    note "Advisory Action does NOT reset or toll the 35 U.S.C. 133 clock — the period for reply keeps running from the final rejection (MPEP 714.13)."
  }
}

chance rce-filed: "RCE Filed" by examiner discretion effective [2024-01-31, ..) cite 37 CFR 1.114; MPEP 706.07(h)
{
  group after-final-group
  note "Request for Continued Examination reopens prosecution. Requires a submission (amendment, affidavit, or other reply) + the RCE fee under 37 CFR 1.17(e). Patent term adjustment (PTA) is affected by RCE filing — can reduce or eliminate PTA. This is the key economic trap: RCE costs money and time, appeal costs less up front but risks all claims."
  _ "Examiner issues new Non-Final OA after RCE" -> non-final-oa p 0.7 {
    authority cite 37 CFR 1.104; MPEP 706
  }
  _ "Examiner allows after RCE submission" -> allowance p 0.3 { authority cite 37 CFR 1.311 }
}

state notice-of-appeal: "Notice of Appeal Filed" by applicant effective [2024-01-31, ..) cite 37 CFR 41.31; MPEP 1204
{
  group appeal-group
  note "Notice of Appeal filed with the Patent Trial and Appeal Board (PTAB). Appeal fee required. Appellant has 2 months from filing the notice to file the appeal brief (37 CFR 41.37), extendable."
  _ "File Appeal Brief (within 2 months)" -> appeal-brief-filed {
    authority cite 37 CFR 41.37; MPEP 1205
    effort 40.hours
    within appeal-brief {
      extendable true
      extension_authority "37 CFR 1.136(a)"
      note "Brief must be filed within 2 months of Notice of Appeal. Failure to file brief = abandonment of appeal. The brief is the applicant's primary substantive document before PTAB."
    }
    duration { min 9.days, mode 30.days, max 60.days }
    valence good
  }
  _ "Fail to file appeal brief — appeal dismissed" -> appeal-dismissed {
    authority cite 37 CFR 41.37(a); MPEP 1215.04; MPEP 710.02(e)
    effort 0.hours
    within appeal-brief {
      extendable true
      extension_authority "37 CFR 1.136(a)"
      note "Brief due 2 months from notice of appeal, extendable up to 5 months under 37 CFR 1.136(a). If no brief is filed within that period, the appeal stands DISMISSED by operation of the rule (37 CFR 41.37; MPEP 1215.04) — the appeal is not 'denied' (Rev-01.2024 replaced 'denied' with 'dismissed' throughout ch. 1200)."
    }
    duration { min 9.days, mode 30.days, max 60.days }
    valence bad
  }
}

state appeal-brief-filed: "Appeal Brief Filed" by examiner effective [2024-01-31, ..) cite 37 CFR 41.37(a); MPEP 1205
{
  group appeal-group
  note "Appeal brief must be filed within 2 months of the notice of appeal (37 CFR 41.37(a)), extendable up to 5 months under 37 CFR 1.136(a) (this period is NOT a 35 U.S.C. 133 statutory period — MPEP 710.02(e)). Failure to file the brief within the time prescribed by 37 CFR 41.37 results in DISMISSAL of the appeal by operation of the rule (MPEP 1215.04), not automatic abandonment. Dismissal ripens into abandonment only if no allowed claims remain."
  _ "Examiner files Answer" -> examiners-answer { authority cite 37 CFR 41.39; MPEP 1207 }
}

state examiners-answer: "Examiner's Answer" by applicant effective [2024-01-31, ..) cite 37 CFR 41.39; MPEP 1207
{
  group appeal-group
  note "Examiner may respond with an Examiner's Answer, which may include new grounds of rejection. If new grounds raised, applicant may reopen prosecution (via RCE) or submit reply brief within 2 months."
  _ "Pay appeal forwarding fee — appeal forwarded to PTAB" -> ptab-decision {
    authority cite 37 CFR 41.20(b)(4); 37 CFR 41.45; MPEP 1208.01
    effort 1.hours
    cost 2_535.usd
    within appeal-forwarding-fee {
      extendable false
      note "The APPEAL FORWARDING FEE (37 CFR 41.20(b)(4)) — not a brief fee — is due within 2 months of the Examiner's Answer to forward the appeal to the Board (35 U.S.C. 41 note; MPEP 1208.01). 37 CFR 41.37 itself carries NO brief fee. Non-payment means the appeal is dismissed."
    }
    duration { min 9.days, mode 30.days, max 60.days }
    note "Appeal forwarding fee $2,535.00, undiscounted/large-entity, effective 1/19/2025 (37 CFR 41.20(b)(4))."
  }
  _ "Reopen prosecution via RCE (new grounds in Answer)" -> rce-filed {
    authority cite 37 CFR 1.114; MPEP 1207.03
    effort 12.hours
    cost 1_500.usd
    note "1st RCE fee $1,500.00, undiscounted/large-entity, effective 1/19/2025 (37 CFR 1.17(e)(1)); a 2nd or subsequent RCE is $2,860.00 (1.17(e)(2)) -- see sets:rce-filed-before."
    sets [rce-filed-before]
  }
}

chance ptab-decision: "PTAB Decision" by office discretion effective [2024-01-31, ..) cite 37 CFR 41.50; MPEP 1213
{
  group appeal-group
  note "PTAB issues its decision: affirmance (examiner sustained), reversal (examiner overruled), or new ground of rejection (applicant must respond). PTAB may affirm in part, reverse in part."
  _ "PTAB reverses examiner" -> ptab-reversal p 0.3 { authority cite 37 CFR 41.50(b); MPEP 1214 }
  _ "PTAB affirms examiner" -> ptab-affirmed p 0.7 { authority cite 37 CFR 41.50; MPEP 1214 }
}

state ptab-reversal: "PTAB Reversed (Allowable)" by examiner effective [2024-01-31, ..) cite 37 CFR 41.50(b); MPEP 1214
{
  group appeal-group
  note "PTAB reversed the examiner's rejection. Application returns to examiner for allowance processing unless examiner reopens prosecution on different grounds. Strong applicant win — proceed to Notice of Allowance."
  _ "Examiner processes allowance after reversal" -> allowance { authority cite MPEP 1214.04 }
}

decision ptab-affirmed: "PTAB Affirmed" by applicant effective [2024-01-31, ..) cite 37 CFR 41.50; 35 U.S.C. 141; 35 U.S.C. 145
{
  group appeal-group
  note "PTAB affirmed the examiner. Applicant may: (1) file Request for Rehearing (37 CFR 41.52); (2) appeal to Federal Circuit under 35 U.S.C. 141; or (3) file civil action in EDVA under 35 U.S.C. 145. All further paths have cost and strategic implications."
  _ "Appeal to Federal Circuit (35 U.S.C. 141)" -> federal-circuit-appeal {
    authority cite 35 U.S.C. 141; 37 CFR 90.1
    effort 80.hours
    within court-review {
      extendable false
      note "63-day deadline from PTAB decision. No extensions available for Federal Circuit appeals."
    }
    duration { min 9.4.days, mode 31.5.days, max 63.days }
  }
  _ "File civil action in E.D. Va. (35 U.S.C. 145)" -> sec145-action {
    authority cite 35 U.S.C. 145; 37 CFR 90.3
    effort 120.hours
    within court-review {
      extendable false
      note "63-day deadline. De novo review with new evidence. Expensive — USPTO may recover attorney fees if applicant loses."
    }
    duration { min 9.4.days, mode 31.5.days, max 63.days }
  }
  _ "Take no further action — application abandoned" -> abandoned-no-reply {
    authority cite 37 CFR 1.135
    effort 0.hours
  }
}

state federal-circuit-appeal: "Federal Circuit Appeal" by office effective [2024-01-31, ..) cite 35 U.S.C. 141; 37 CFR 90.1
{
  group appeal-group
  note "Appeal to the U.S. Court of Appeals for the Federal Circuit. Must be filed within 63 days of PTAB decision. Standard of review: substantial evidence for factual findings; de novo for claim construction and legal determinations."
  court_listener_url "https://www.courtlistener.com/opinion/209543/in-re-bilski/"
  _ "Federal Circuit reverses — allowance ordered" -> allowance {
