module core.states.hawaii

import core.calendar.{ us-federal-holidays }

/// Hawaii state holidays under HRS § 8-1 that are not already federal
/// holidays, closed on their statutory date under § 8-2. The fixed and
/// nth-weekday dates are represented directly. Good Friday, election days,
/// and proclaimed holidays are not modeled because the calendar language
/// cannot derive Easter, county election dates, or proclamations.
calendar hawaii-holidays effective [2023-01-01, ..) cite "HRS § 8-1"
{
  prince-kuhio-day: fixed(3, 26) effective [2023-01-01, ..)
  king-kamehameha-day: fixed(6, 11) effective [2023-01-01, ..)
  statehood-day: nth(3, friday, 8) effective [2023-01-01, ..)
  good-friday-2023: once(2023-04-07) effective [2023-01-01, ..)
  good-friday-2024: once(2024-03-29) effective [2023-01-01, ..)
  good-friday-2025: once(2025-04-18) effective [2023-01-01, ..)
  good-friday-2026: once(2026-04-03) effective [2023-01-01, ..)
  good-friday-2027: once(2027-03-26) effective [2023-01-01, ..)
  good-friday-2028: once(2028-04-14) effective [2023-01-01, ..)
  good-friday-2029: once(2029-03-30) effective [2023-01-01, ..)
  good-friday-2030: once(2030-04-19) effective [2023-01-01, ..)
  good-friday-2031: once(2031-04-11) effective [2023-01-01, ..)
  good-friday-2032: once(2032-03-26) effective [2023-01-01, ..)
  good-friday-2033: once(2033-04-15) effective [2023-01-01, ..)
  good-friday-2034: once(2034-04-07) effective [2023-01-01, ..)
  good-friday-2035: once(2035-03-23) effective [2023-01-01, ..)
  good-friday-2036: once(2036-04-11) effective [2023-01-01, ..)
  good-friday-2037: once(2037-04-03) effective [2023-01-01, ..)
  good-friday-2038: once(2038-04-23) effective [2023-01-01, ..)
  good-friday-2039: once(2039-04-08) effective [2023-01-01, ..)
  good-friday-2040: once(2040-03-30) effective [2023-01-01, ..)
  good-friday-2041: once(2041-04-19) effective [2023-01-01, ..)
  good-friday-2042: once(2042-04-04) effective [2023-01-01, ..)
  good-friday-2043: once(2043-03-27) effective [2023-01-01, ..)
  good-friday-2044: once(2044-04-15) effective [2023-01-01, ..)
  good-friday-2045: once(2045-04-07) effective [2023-01-01, ..)
  good-friday-2046: once(2046-03-23) effective [2023-01-01, ..)
  good-friday-2047: once(2047-04-12) effective [2023-01-01, ..)
  good-friday-2048: once(2048-04-03) effective [2023-01-01, ..)
  good-friday-2049: once(2049-04-16) effective [2023-01-01, ..)
  good-friday-2050: once(2050-04-08) effective [2023-01-01, ..)
}

/// FRCrimP 45 in the District of Hawaii: the federal rule with Hawaii's
/// state holidays in forward-counted periods only under Rule 45(a)(6)(C).
counting frcrimp45-hawaii effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCrimP 45(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCrimP 45(c)"
  holidays us-federal-holidays
  forward_holidays hawaii-holidays cite "FRCrimP 45(a)(6)(C)"
  forums [frcrimp]
  allow_hours
}
