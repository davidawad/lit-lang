// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-ny-state-civil

start commenced

state commenced: "Complaint Filed" by applicant cite ?("CPLR 304")
{
  note "OUTLINE. A civil action commences with the filing of the complaint. Filing fee and service period are holes."
  edge-commenced-response-due "Defendant served" -> response-due {
    authority cite ?("CPLR 306-b")
  }
}

decision response-due: "Answer or Motion Due" by office cite ?("CPLR 3012(a)")
{
  note "OUTLINE. The response period is a hole until verified. Leading decision on pleading challenges (verify): Leon v. Martinez, 84 N.Y.2d 83 (1994)"
  edge-response-due-default "No response" -> default-entered {
    authority cite ?("CPLR 3215")
  }
  edge-response-due-motion "Pre-answer motion filed" -> pleading-ruling {
    authority cite ?("CPLR 3211")
  }
  edge-response-due-discovery "Answer filed" -> discovery {
    authority cite ?("CPLR 3012(a)")
  }
}

decision pleading-ruling: "Pre-answer Motion Decided" by court cite ?("CPLR 3211")
{
  note "OUTLINE. Pre-answer motion under CPLR 3211 (verify subsection)."
  edge-pleading-ruling-dismissed "Dismissed" -> dismissed {
    authority cite ?("CPLR 3211")
  }
  edge-pleading-ruling-discovery "Motion denied; case proceeds" -> discovery {
    authority cite ?("CPLR 3012(a)")
  }
}

state discovery: "Discovery" by applicant cite ?("CPLR 3101(a)")
{
  note "OUTLINE. Disclosure under CPLR 3101 et seq. (verify). Scope, deadlines and sanctions are holes until verified."
  edge-discovery-sj-ruling "Dispositive motion filed" -> sj-ruling {
    authority cite ?("CPLR 3212(b)")
  }
  edge-discovery-trial-ready "No dispositive motion" -> trial-ready {
    authority cite ?("CPLR 4011")
  }
}

decision sj-ruling: "Summary Judgment Decided" by court cite ?("CPLR 3212(b)")
{
  note "OUTLINE. Leading decision on summary judgment (verify): Alvarez v. Prospect Hospital, 68 N.Y.2d 320 (1986)"
  edge-sj-ruling-granted "Granted" -> sj-granted {
    authority cite ?("CPLR 3212(b)")
  }
  edge-sj-ruling-denied "Denied" -> trial-ready {
    authority cite ?("CPLR 3212(b)")
  }
}

decision trial-ready: "Pretrial and Trial Setting" by court cite ?("CPLR 4011")
{
  note "OUTLINE. Pretrial order, jury demand and trial setting. Settlement and dismissal paths are not modeled."
  edge-trial-ready-verdict "Tried" -> verdict {
    authority cite ?("CPLR 4401")
  }
}

state verdict: "Verdict Returned" by applicant cite ?("CPLR 4401")
{
  note "OUTLINE. Motions for judgment as a matter of law and for a new trial follow the verdict."
  edge-verdict-post-trial "Post-trial motions" -> post-trial {
    authority cite ?("CPLR 4404(a)")
  }
}

decision post-trial: "Post-trial Motions Decided" by court cite ?("CPLR 4404(a)")
{
  note "OUTLINE. Deadlines for renewed motions are holes until verified."
  edge-post-trial-judgment "Judgment entered" -> judgment-entered {
    authority cite ?("CPLR 5016")
  }
}

terminal judgment-entered: "Judgment entered on verdict" outcome [win] cite ?("CPLR 5016")
{
  note "OUTLINE. Notice of appeal runs from entry of judgment; see the state-appellate package for this state."
  payoff ?
}

terminal default-entered: "Default entered" outcome [loss] cite ?("CPLR 3215")
{
  note "OUTLINE. Default judgment and relief from default are holes until verified."
  payoff ?
}

terminal dismissed: "Dismissed on the pleadings" outcome [loss] cite ?("CPLR 3211")
{
  note "OUTLINE. Leading decision on pleading standard (verify): Leon v. Martinez, 84 N.Y.2d 83 (1994)"
  payoff ?
}

terminal sj-granted: "Summary judgment granted" outcome [loss] cite ?("CPLR 3212(b)")
{
  note "OUTLINE. Leading decision on summary judgment (verify): Alvarez v. Prospect Hospital, 68 N.Y.2d 320 (1986)"
  payoff ?
}

