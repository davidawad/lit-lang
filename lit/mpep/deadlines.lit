module mpep.deadlines

import core.authority.{ CaseOrder }
import core.calendar.{ dc-federal-holidays, uspto-closures }

/// The Patent Office's clock, 37 C.F.R. § 1.7(a): periods "in days" are
/// calendar days, and an action due on a Saturday, Sunday, or "Federal
/// holiday within the District of Columbia" may be taken on the next
/// business day (35 U.S.C. § 21(b); MPEP § 710.05 restates both). A period
/// runs from the mail date of the action that sets it (MPEP § 710.01(a)), so
/// the trigger day is excluded and the last day included. A period in
/// months ends on "the corresponding day of the month" after the action, and
/// where the later month has no such day, on its last day: "a 3-month
/// shortened statutory period dated November 30 is due on the following
/// February 28 (or 29 if it is a leap year)" (MPEP 710.01(a)).
///
/// The vendored section's source note dates the current text to 78 FR
/// 62395 (October 21, 2013), the Patent Law Treaty implementation rule,
/// effective December 18, 2013. UNVERIFIED: the effective date is from that
/// Federal Register document, which is not vendored. Earlier text (65 FR
/// 14871, 2000) is outside this package's lifetime and not modeled.
///
/// A weekday the Office is officially closed for the entire day is "a
/// Federal holiday within the District of Columbia" (§ 1.9(h)): the days
/// its notices designate close it too (core's `uspto-closures`).
///
/// 37 C.F.R. § 42.1(a): "Sections 1.4, 1.7, ... of this chapter also apply
/// to proceedings before the Board", so this is the Patent Trial and Appeal
/// Board's counting rule too (`forums [uspto, ptab]`). § 1.7 adds no time
/// for any manner of service: a period runs from the action or event that
/// sets it, and no service method is recognized.
counting uspto-1-7 effective [2013-12-18, ..) known_at 2026-01-01 cite "37 CFR 1.7(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday]
  service_extension {
    Personal: unrecognized
    Electronic: unrecognized
    Mail: unrecognized
    Clerk: unrecognized
    OtherConsented: unrecognized
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "37 CFR 1.7(a)"
  holidays dc-federal-holidays
  declared_holidays uspto-closures cite "37 CFR 1.9(h)"
  forums [uspto, ptab]
  end_of_month clamp
}

/// A provisional application is accorded a filing date (37 C.F.R. § 1.53(c)).
event ProvisionalFiled()
/// The Office mails a Notice to File Missing Parts (37 C.F.R. § 1.53(f)).
event MissingPartsNoticeMailed()
/// The examiner mails a restriction requirement (37 C.F.R. § 1.142(a)).
event RestrictionRequirementMailed()
/// The examiner mails a non-final Office action (37 C.F.R. § 1.104).
event OfficeActionMailed()
/// The reply period then running (shortened or extended) ends.
event ReplyPeriodEnded()
/// The examiner mails a final rejection (37 C.F.R. § 1.113).
event FinalRejectionMailed()
/// The applicant files a notice of appeal (37 C.F.R. § 41.31).
event NoticeOfAppealFiled()
/// The examiner's answer is mailed (37 C.F.R. § 41.39).
event ExaminersAnswerMailed()
/// The Board decides the appeal (37 C.F.R. § 41.50).
event BoardDecisionMailed()
/// The Office mails a notice of allowance (37 C.F.R. § 1.311(a)).
event NoticeOfAllowanceMailed()
/// The petitioner is served with a complaint alleging infringement (35 U.S.C.
/// § 315(b)).
event InfringementComplaintServed()
/// The patent issues (35 U.S.C. § 151).
event PatentGranted()
/// The Board notices that an IPR or PGR petition has been accorded a filing
/// date.
event PetitionFilingDateNoticed()
/// The Office orders ex parte reexamination (35 U.S.C. § 304).
event ReexamOrdered()

/// 35 U.S.C. § 119(e)(1): a nonprovisional claims a provisional's filing date
/// only if filed "not later than 12 months after the date on which the
/// provisional application was filed"; 37 C.F.R. § 1.7(b) extends a
/// pendency ending on a Saturday, Sunday or DC federal holiday.
deadline provisional-pendency: 12.months from ProvisionalFiled() counted_by uspto-1-7 effective [2024-01-31, ..) cite "35 U.S.C. 119(e)(1)"

test "provisional-pendency: 12 months from Monday, 2025-03-03" cite "37 CFR 1.7(a)"
{
  given ProvisionalFiled() on 2025-03-03
  expect deadline(provisional-pendency) == 2026-03-03
}

test "provisional-pendency: the last day, 2026-07-03, is a holiday; due Monday" cite "37 CFR 1.7(a)"
{
  given ProvisionalFiled() on 2025-07-03
  expect deadline(provisional-pendency) == 2026-07-06
}

/// Reply to a Notice to File Missing Parts (37 C.F.R. § 1.53(f)), modeled as
/// two months.
///
/// Delegated to the order setting it: 37 C.F.R. § 1.53(f)(1): the applicant
/// "will be notified and given a period of time" to complete the application,
/// so the notice sets the period.
deadline missing-parts-reply: 2.months from MissingPartsNoticeMailed() counted_by uspto-1-7 effective [2024-01-31, ..) delegable {
  to CaseOrder
  op set
} cite "37 CFR 1.53(f)"

test "missing-parts-reply: 2 months from Thursday, 2025-03-06" cite "37 CFR 1.7(a)"
{
  given MissingPartsNoticeMailed() on 2025-03-06
  expect deadline(missing-parts-reply) == 2025-05-06
}

test "missing-parts-reply: the last day, 2025-01-06, and the next are weather closures; due Wednesday" cite "37 CFR 1.9(h)"
{
  given MissingPartsNoticeMailed() on 2024-11-06
  expect deadline(missing-parts-reply) == 2025-01-08
}

test "missing-parts-reply: the last day, 2025-05-26, is a holiday; due Tuesday" cite "37 CFR 1.7(a)"
{
  given MissingPartsNoticeMailed() on 2025-03-26
  expect deadline(missing-parts-reply) == 2025-05-27
}

/// Reply electing an invention after a restriction requirement (37 C.F.R.
/// § 1.142(a)), modeled as two months.
///
/// Delegated to the order setting it: 37 C.F.R. § 1.134: the Office action
/// itself sets any shortened period for reply.
deadline election-reply: 2.months from RestrictionRequirementMailed() counted_by uspto-1-7 effective [2024-01-31, ..) delegable {
  to CaseOrder
  op set
} cite "37 CFR 1.142(a)"

test "election-reply: 2 months from Thursday, 2025-04-03" cite "37 CFR 1.7(a)"
{
  given RestrictionRequirementMailed() on 2025-04-03
  expect deadline(election-reply) == 2025-06-03
}

test "election-reply: the last day, 2025-11-11, is a holiday; due Wednesday" cite "37 CFR 1.7(a)"
{
  given RestrictionRequirementMailed() on 2025-09-11
  expect deadline(election-reply) == 2025-11-12
}

/// Reply to a non-final Office action within the shortened statutory period
/// (37 C.F.R. §§ 1.111, 1.134), modeled as three months.
///
/// Delegated to the order setting it: 37 C.F.R. § 1.134: the Office action
/// sets the shortened statutory period.
deadline ssp-reply: 3.months from OfficeActionMailed() counted_by uspto-1-7 effective [2024-01-31, ..) delegable {
  to CaseOrder
  op set
} cite "37 CFR 1.134"

test "ssp-reply: 3 months from Tuesday, 2025-03-04" cite "37 CFR 1.7(a)"
{
  given OfficeActionMailed() on 2025-03-04
  expect deadline(ssp-reply) == 2025-06-04
}

test "ssp-reply: the last day, 2025-06-19, is a holiday; due Friday" cite "37 CFR 1.7(a)"
{
  given OfficeActionMailed() on 2025-03-19
  expect deadline(ssp-reply) == 2025-06-20
}

test "ssp-reply: from November 30, three months end on February 28 (MPEP 710.01(a))" cite "MPEP 710.01(a)"
{
  given OfficeActionMailed() on 2024-11-30
  expect deadline(ssp-reply) == 2025-02-28
}

test "ssp-reply: from November 30, three months end on February 29 in a leap year" cite "MPEP 710.01(a)"
{
  given OfficeActionMailed() on 2027-11-30
  expect deadline(ssp-reply) == 2028-02-29
}

test "ssp-reply: from February 28, three months end on May 28, not May 31 (MPEP 710.01(a))" cite "MPEP 710.01(a)"
{
  given OfficeActionMailed() on 2025-02-28
  expect deadline(ssp-reply) == 2025-05-28
}

/// One month of extension under 37 C.F.R. § 1.136(a), purchased with a
/// § 1.17(a) fee, up to the six-month ceiling of 35 U.S.C. § 133: the length
/// of the window the graph's extension edges read. It is not how a matter's
/// extended due date is counted. MPEP 710.01(a) extends "to the date
/// corresponding to the Office action date in the following month" (a
/// reply due April 30 on a January 31 action is extended to May 31), which
/// a month chained on the period's end gets wrong whenever that end was cut
/// to a short month's last day; the extended periods below count instead
/// from the action itself.
deadline extension-month: 1.months from ReplyPeriodEnded() counted_by uspto-1-7 effective [2024-01-31, ..) cite "37 CFR 1.136(a); MPEP 710.01(a)"

test "extension-month: 1 month from Monday, 2025-03-03" cite "37 CFR 1.7(a)"
{
  given ReplyPeriodEnded() on 2025-03-03
  expect deadline(extension-month) == 2025-04-03
}

test "extension-month: the last day, 2025-06-19, is a holiday; due Friday" cite "37 CFR 1.7(a)"
{
  given ReplyPeriodEnded() on 2025-05-19
  expect deadline(extension-month) == 2025-06-20
}

/// The shortened statutory period of `ssp-reply` extended under 37 C.F.R.
/// § 1.136(a) by one, two or three months: "A 1-month extension of time
/// extends the time for reply to the date corresponding to the Office
/// action date in the following month", and "The fact that April 30 may
/// have been a Saturday, Sunday, or federal holiday has no effect on the
/// extension of time" (MPEP 710.01(a)). So an extended period is not a
/// chain on the period it extends, from either end: it is the action's
/// own period, 3 + k months from the mail date, its last day rolled under
/// § 1.7(a). Three months of extension reach the six-month ceiling of 35
/// U.S.C. § 133.
deadline ssp-reply-extended-1: 4.months from OfficeActionMailed() counted_by uspto-1-7 effective [2024-01-31, ..) cite "37 CFR 1.136(a); MPEP 710.01(a)"
deadline ssp-reply-extended-2: 5.months from OfficeActionMailed() counted_by uspto-1-7 effective [2024-01-31, ..) cite "37 CFR 1.136(a); MPEP 710.01(a)"
deadline ssp-reply-extended-3: 6.months from OfficeActionMailed() counted_by uspto-1-7 effective [2024-01-31, ..) cite "37 CFR 1.136(a); 35 U.S.C. 133"

test "a reply due April 30 on a January 31 action is extended a month to May 31 (MPEP 710.01(a))" cite "MPEP 710.01(a)"
{
  given OfficeActionMailed() on 2024-01-31
  expect deadline(ssp-reply) == 2024-04-30
  expect deadline(ssp-reply-extended-1) == 2024-05-31
  expect deadline(ssp-reply-extended-2).nominal == 2024-06-30
  expect deadline(ssp-reply-extended-2).adjusted == 2024-07-01
  expect deadline(ssp-reply-extended-3) == 2024-07-31
}

test "a reply due February 28 on a November 30 action is extended to March 30, not March 28" cite "MPEP 710.01(a)"
{
  given OfficeActionMailed() on 2024-11-30
  expect deadline(ssp-reply) == 2025-02-28
  expect deadline(ssp-reply-extended-1).nominal == 2025-03-30
  expect deadline(ssp-reply-extended-1).adjusted == 2025-03-31
}

/// Reply to a final rejection (37 C.F.R. §§ 1.113, 1.116, 1.134): an
/// after-final amendment, an RCE, a notice of appeal, or a continuation, all
/// within the shortened statutory period, modeled as three months.
///
/// Delegated to the order setting it: 37 C.F.R. § 1.134: the final Office
/// action sets the shortened statutory period.
deadline final-reply: 3.months from FinalRejectionMailed() counted_by uspto-1-7 effective [2024-01-31, ..) delegable {
  to CaseOrder
  op set
} cite "37 CFR 1.134"

test "final-reply: 3 months from Wednesday, 2025-06-04" cite "37 CFR 1.7(a)"
{
  given FinalRejectionMailed() on 2025-06-04
  expect deadline(final-reply) == 2025-09-04
}

test "final-reply: the last day, 2025-11-27, is a holiday; due Friday" cite "37 CFR 1.7(a)"
{
  given FinalRejectionMailed() on 2025-08-27
  expect deadline(final-reply) == 2025-11-28
}

/// 37 C.F.R. § 41.37(a): the appeal brief is due "within two months from the
/// date of filing the notice of appeal", extendable under § 1.136 (§ 41.37(e)).
deadline appeal-brief: 2.months from NoticeOfAppealFiled() counted_by uspto-1-7 effective [2024-01-31, ..) cite "37 CFR 41.37(a)"

test "appeal-brief: 2 months from Wednesday, 2025-03-05" cite "37 CFR 1.7(a)"
{
  given NoticeOfAppealFiled() on 2025-03-05
  expect deadline(appeal-brief) == 2025-05-05
}

test "appeal-brief: the last day, 2025-05-26, is a holiday; due Tuesday" cite "37 CFR 1.7(a)"
{
  given NoticeOfAppealFiled() on 2025-03-26
  expect deadline(appeal-brief) == 2025-05-27
}

/// 37 C.F.R. § 41.45(a): the § 41.20(b)(4) appeal forwarding fee is due
/// "within the later of two months from the date of either the examiner's
/// answer" or a petition decision; unpaid, the appeal stands dismissed
/// (§ 41.45(b)).
deadline appeal-forwarding-fee: 2.months from ExaminersAnswerMailed() counted_by uspto-1-7 effective [2024-01-31, ..) cite "37 CFR 41.45(a)"

test "appeal-forwarding-fee: 2 months from Thursday, 2025-03-06" cite "37 CFR 1.7(a)"
{
  given ExaminersAnswerMailed() on 2025-03-06
  expect deadline(appeal-forwarding-fee) == 2025-05-06
}

test "appeal-forwarding-fee: the last day, 2025-11-11, is a holiday; due Wednesday" cite "37 CFR 1.7(a)"
{
  given ExaminersAnswerMailed() on 2025-09-11
  expect deadline(appeal-forwarding-fee) == 2025-11-12
}

/// 37 C.F.R. § 90.3(a): a notice of appeal to the Federal Circuit (35 U.S.C.
/// § 141) or a civil action under 35 U.S.C. § 145 is due 63 days after the
/// Board's decision.
deadline court-review: 63.days from BoardDecisionMailed() counted_by uspto-1-7 effective [2024-01-31, ..) cite "37 CFR 90.3(a)"

test "court-review: 63 days from Monday, 2025-03-03" cite "37 CFR 1.7(a)"
{
  given BoardDecisionMailed() on 2025-03-03
  expect deadline(court-review) == 2025-05-05
}

test "court-review: day 63 falls on 2025-05-26, a holiday; due Tuesday" cite "37 CFR 1.7(a)"
{
  given BoardDecisionMailed() on 2025-03-24
  expect deadline(court-review) == 2025-05-27
}

/// 37 C.F.R. § 1.311(a): the issue fee is due "within three months from the
/// date of mailing of the notice of allowance"; "This three-month period is
/// not extendable."
deadline issue-fee: 3.months from NoticeOfAllowanceMailed() counted_by uspto-1-7 effective [2024-01-31, ..) cite "37 CFR 1.311(a)"

test "issue-fee: 3 months from Tuesday, 2025-03-04" cite "37 CFR 1.7(a)"
{
  given NoticeOfAllowanceMailed() on 2025-03-04
  expect deadline(issue-fee) == 2025-06-04
}

test "issue-fee: the last day, 2025-12-25, is a holiday and the 26th a closure; due Monday" cite "37 CFR 1.7(a)"
{
  given NoticeOfAllowanceMailed() on 2025-09-25
  expect deadline(issue-fee) == 2025-12-29
}

/// 35 U.S.C. § 315(b): no inter partes review may be instituted on a petition
/// filed more than 1 year after the petitioner is served with a complaint
/// alleging infringement.
deadline ipr-time-bar: 1.years from InfringementComplaintServed() counted_by uspto-1-7 effective [2024-01-31, ..) cite "35 U.S.C. 315(b)"

test "ipr-time-bar: 1 year from Monday, 2025-03-03" cite "37 CFR 1.7(a)"
{
  given InfringementComplaintServed() on 2025-03-03
  expect deadline(ipr-time-bar) == 2026-03-03
}

test "ipr-time-bar: the last day, 2026-07-03, is a holiday; due Monday" cite "37 CFR 1.7(a)"
{
  given InfringementComplaintServed() on 2025-07-03
  expect deadline(ipr-time-bar) == 2026-07-06
}

/// 35 U.S.C. § 321(c): a post-grant review petition may be filed only within
/// 9 months after the grant of the patent.
deadline pgr-window: 9.months from PatentGranted() counted_by uspto-1-7 effective [2024-01-31, ..) cite "35 U.S.C. 321(c)"

test "pgr-window: 9 months from Tuesday, 2025-03-04" cite "37 CFR 1.7(a)"
{
  given PatentGranted() on 2025-03-04
  expect deadline(pgr-window) == 2025-12-04
}

test "pgr-window: the last day, 2026-01-19, is a holiday; due Tuesday" cite "37 CFR 1.7(a)"
{
  given PatentGranted() on 2025-04-19
  expect deadline(pgr-window) == 2026-01-20
}

/// 37 C.F.R. § 42.107(b): the patent owner preliminary response is due "no
/// later than three months after the date of a notice indicating that the
/// request to institute an inter partes review has been granted a filing
/// date".
///
/// Delegated to the order setting it: 37 C.F.R. § 42.5(c)(1): "Times set by
/// rule are default and may be modified by order".
deadline ipr-preliminary-response: 3.months from PetitionFilingDateNoticed() counted_by uspto-1-7 effective [2024-01-31, ..) delegable {
  to CaseOrder
  op set
} cite "37 CFR 42.107(b)"

test "ipr-preliminary-response: 3 months from Tuesday, 2025-03-04" cite "37 CFR 1.7(a)"
{
  given PetitionFilingDateNoticed() on 2025-03-04
  expect deadline(ipr-preliminary-response) == 2025-06-04
}

test "ipr-preliminary-response: the last day, 2025-06-19, is a holiday; due Friday" cite "37 CFR 1.7(a)"
{
  given PetitionFilingDateNoticed() on 2025-03-19
  expect deadline(ipr-preliminary-response) == 2025-06-20
}

/// 37 C.F.R. § 42.207(b): the same three-month preliminary response period in
/// a post-grant review.
///
/// Delegated to the order setting it: 37 C.F.R. § 42.5(c)(1): "Times set by
/// rule are default and may be modified by order".
deadline pgr-preliminary-response: 3.months from PetitionFilingDateNoticed() counted_by uspto-1-7 effective [2024-01-31, ..) delegable {
  to CaseOrder
  op set
} cite "37 CFR 42.207(b)"

test "pgr-preliminary-response: 3 months from Tuesday, 2025-05-06" cite "37 CFR 1.7(a)"
{
  given PetitionFilingDateNoticed() on 2025-05-06
  expect deadline(pgr-preliminary-response) == 2025-08-06
}

test "pgr-preliminary-response: the last day, 2025-11-11, is a holiday; due Wednesday" cite "37 CFR 1.7(a)"
{
  given PetitionFilingDateNoticed() on 2025-08-11
  expect deadline(pgr-preliminary-response) == 2025-11-12
}

/// The patent owner's optional statement after an order for ex parte
/// reexamination (35 U.S.C. § 304; 37 C.F.R. § 1.530(b)), modeled as the
/// two-month minimum; extendable under § 1.550(c).
///
/// Delegated to the order setting it: 37 C.F.R. § 1.530(b): "The order for ex
/// parte reexamination will set a period of not less than two months".
deadline reexam-owner-statement: 2.months from ReexamOrdered() counted_by uspto-1-7 effective [2024-01-31, ..) delegable {
  to CaseOrder
  op set
} cite "37 CFR 1.530(b)"

test "reexam-owner-statement: 2 months from Wednesday, 2025-03-05" cite "37 CFR 1.7(a)"
{
  given ReexamOrdered() on 2025-03-05
  expect deadline(reexam-owner-statement) == 2025-05-05
}

test "reexam-owner-statement: the last day, 2025-11-11, is a holiday; due Wednesday" cite "37 CFR 1.7(a)"
{
  given ReexamOrdered() on 2025-09-11
  expect deadline(reexam-owner-statement) == 2025-11-12
}

/// 35 U.S.C. § 251(d): no reissue enlarging the scope of the original claims
/// unless "applied for within two years from the grant of the original
/// patent".
deadline broadening-reissue: 2.years from PatentGranted() counted_by uspto-1-7 effective [2024-01-31, ..) cite "35 U.S.C. 251(d)"

test "broadening-reissue: 2 years from Monday, 2025-03-03" cite "37 CFR 1.7(a)"
{
  given PatentGranted() on 2025-03-03
  expect deadline(broadening-reissue) == 2027-03-03
}

test "broadening-reissue: the last day, 2027-06-18, is a holiday; due Monday" cite "37 CFR 1.7(a)"
{
  given PatentGranted() on 2025-06-18
  expect deadline(broadening-reissue) == 2027-06-21
}

