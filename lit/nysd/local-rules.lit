test "magistrate objection response period: 14 days after the trigger" cite "S.D.N.Y. Local Civ. R. 72.1(b)"
{
  given MagistrateObjectionServed() on 2026-11-02
  expect deadline(magistrate-objection-response-period) == 2026-11-16
}

