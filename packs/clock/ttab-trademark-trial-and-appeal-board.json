  "countingRules": [
    {
      "id": "ttab-2-196",
      "label": "37 C.F.R. § 2.196",
      "sourceUrl": "https://www.ecfr.gov/current/title-37/chapter-I/subchapter-B/part-2",
      "closedWeekdays": [
        "saturday",
        "sunday"
      ],
      "holidays": [
        "dc-federal-holidays"
      ],
      "steps": [
        {
          "op": "anchor",
          "kind": "trigger",
          "text": "37 C.F.R. § 2.196: exclude the trigger date {trigger}"
        },
        {
          "op": "count",
          "periods": [
            {
              "unit": "calendar",
              "count": "calendar",
              "text": "37 C.F.R. § 2.196: count {n} calendar day(s) {after} the anchor -> {date}"
            },
            {
              "unit": "court",
              "count": "business",
              "text": "37 C.F.R. § 2.196: count {n} court day(s) {forward}, skipping weekends and holidays -> {date}"
            }
          ]
        },
        {
          "op": "roll",
          "forward": {
            "toward": "later",
            "text": "37 C.F.R. § 2.196: the last day is a weekend or legal holiday; roll forward -> {date}"
          },
          "backward": {
            "toward": "earlier",
            "text": "37 C.F.R. § 2.196: the last day is a weekend or legal holiday; roll backward -> {date}"
          }
        },
        {
          "op": "base"
        },
        {
          "op": "service",
          "methods": [
            {
              "method": "personal",
              "days": 0
            },
            {
              "method": "electronic",
              "days": 0
            },
            {
              "method": "mail",
              "days": 0
            },
            {
              "method": "commercial-carrier",
              "days": 0
            },
            {
              "method": "express",
              "days": 0
            }
          ],
          "unrecognized": [
            "clerk",
            "other-consented",
            "prison-mail",
            "mail-foreign",
            "express-foreign"
          ],
          "text": "37 C.F.R. § 2.196: service by {method} adds {days} day(s) -> {date}",
          "backwardText": "37 C.F.R. § 2.196: service extensions apply to forward periods only; ignored"
        },
        {
          "op": "roll",
          "forward": {
            "toward": "later",
            "text": "37 C.F.R. § 2.196: the last day is a weekend or legal holiday; roll forward -> {date}"
          },
          "backward": {
            "toward": "earlier",
            "text": "37 C.F.R. § 2.196: the last day is a weekend or legal holiday; roll backward -> {date}"
          }
        }
      ]
