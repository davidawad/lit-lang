# The law in force for the collected rulings at ca2 (lg-fq2.6): the FRAP 4(a) periods with the 2005 and 2009 amendments.
# Versions are selected by each trigger's date, so one world holds for every
# ruling there, before and after each amendment.
layers = ["change-deadline-frap-base", "change-deadline-frap-2005-amendment", "change-deadline-frap-2009-amendment"]

[location]
family = "circuit-appellate"
circuit = "ca2"
