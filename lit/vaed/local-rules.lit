{
  given CostsOppositionFiled() on 2026-11-02
  expect deadline(costs-reply-period) == 2026-11-09
}

test "expedited transcript request period: 5 days before the trigger" cite "E.D. Va. Loc. Civ. R. 80(E)"
{
  given HearingOrTrialHeld() on 2027-02-02
  expect deadline(expedited-transcript-request-period) == 2027-01-28
}
