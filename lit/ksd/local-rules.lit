test "remand amended complaint: 14 days after the trigger" cite "D. Kan. Rule 83.7.3(c)"
{
  given RemandTranscriptFiled() on 2026-11-02
  expect deadline(remand-amended-complaint-period) == 2026-11-16
}

test "remand answer: 14 days after the trigger" cite "D. Kan. Rule 83.7.3(c)"
{
  given RemandAmendedComplaintFiled() on 2026-11-02
  expect deadline(remand-answer-period) == 2026-11-16
}
