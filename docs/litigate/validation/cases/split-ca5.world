# The circuit split `frap-4a6-notice` (lg-i1qw; docs/litigate/VALIDATION.md
# §4): the three precedents that read FRAP 4(a)(6)(A)'s notice, at the Fifth Circuit, where Bass v. U.S. Dep't of Agriculture binds (reading B).
# `litigate worlds benavides.case --world split-ca5.world` (and bass.case)
# replays the motion to reopen under the reading the engine selects there.
layers = ["change-validation-benavides", "change-validation-bass", "change-validation-nunley"]

[location]
family = "circuit-appellate"
circuit = "ca5"
