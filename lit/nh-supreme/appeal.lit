module nh-supreme-court-civil-appeals.appeal

/// A brief other than a reply brief, in a case without a cross-appeal, and
/// the moving party's opening and answering briefs in a case with one: at
/// most 9,500 words, exclusive of the tables and the addendum of pertinent
/// texts (N.H. Sup. Ct. R. 16(11)).
limit principal-brief {
  words <= 9_500 cite "N.H. Sup. Ct. R. 16(11)"
} cite "N.H. Sup. Ct. R. 16(11)"

/// The cross-appellant's opposing brief: at most 14,000 words (N.H. Sup.
/// Ct. R. 16(11)).
limit cross-appeal-opposing-brief {
  words <= 14_000 cite "N.H. Sup. Ct. R. 16(11)"
} cite "N.H. Sup. Ct. R. 16(11)"

/// A reply brief, or a response to one: at most 3,000 words (N.H. Sup. Ct.
/// R. 16(11)).
limit reply-brief { words <= 3_000 cite "N.H. Sup. Ct. R. 16(11)" } cite "N.H. Sup. Ct. R. 16(11)"

/// The opposing party's memorandum of law in a mandatory appeal, filed
/// instead of a brief: at most 4,000 words (N.H. Sup. Ct. R. 16(4)).
limit opposing-memorandum {
  words <= 4_000 cite "N.H. Sup. Ct. R. 16(4)"
} cite "N.H. Sup. Ct. R. 16(4)"

/// A motion for rehearing or reconsideration: at most 3,000 words (N.H.
/// Sup. Ct. R. 22(2)).
limit rehearing-motion {
  words <= 3_000 cite "N.H. Sup. Ct. R. 22(2)"
} cite "N.H. Sup. Ct. R. 22(2)"

start notice

decision notice: "Notice of appeal within 30 days of the clerk's notice?" by applicant cite "N.H. Sup. Ct. R. 7"
{
  note "A mandatory appeal, and any other appeal from a trial court decision on the merits, is filed by the approved notice of appeal form within 30 days from the date on the clerk's written notice of the decision on the merits; a timely post-decision motion stays the appeal period for all parties, an untimely one does not unless the trial court waives the untimeliness within the appeal period (N.H. Sup. Ct. R. 7(1)). The appeal is filed when the notice in proper form and the filing fee are received by the clerk within the 30 days (N.H. Sup. Ct. R. 7(2)); another party may cross-appeal within 10 days from the filing of the first notice (N.H. Sup. Ct. R. 7(5)). The entry fee is prescribed by the supreme court and is not stated in the vendored rules (N.H. Sup. Ct. R. 5(1)). Periods in this package are stated, not counted: computation is N.H. Sup. Ct. R. 27(1). No leading decision is named."
  edge-notice-timely "Notice filed in time" -> acceptance { authority cite "N.H. Sup. Ct. R. 7" }
  edge-notice-late "Notice late" -> dismissed-untimely { authority cite "N.H. Sup. Ct. R. 21" }
}

terminal dismissed-untimely: "Appeal not entered as untimely" outcome [loss, dismissal] cite "N.H. Sup. Ct. R. 21"
{
  note "Only the supreme court may extend the time to file an appeal document or permit its late entry; such motions must carry the appeal document and entry fee and are granted only on a showing of exceptional circumstances (N.H. Sup. Ct. R. 21(6))."
}

decision acceptance: "Appeal accepted?" by court cite "N.H. Sup. Ct. R. 7"
{
  note "The court may decline to accept an appeal other than a mandatory appeal, or any question in it, or summarily dispose of it (N.H. Sup. Ct. R. 7(1)(B), 25(1)). Except in a mandatory appeal a party may move for summary reversal or affirmance within 20 days of the filing of the appeal, with a response due within 10 days (N.H. Sup. Ct. R. 25(2)). Outcome from the appellant's side."
  edge-acceptance-accepted "Mandatory appeal, or appeal accepted" -> scheduling {
    authority cite "N.H. Sup. Ct. R. 12-B"
  }
  edge-acceptance-declined "Acceptance declined" -> declined { authority cite "N.H. Sup. Ct. R. 7" }
}

terminal declined: "Appeal declined" outcome [loss] cite "N.H. Sup. Ct. R. 7"
{
  note "A declination of acceptance order implies no view on the merits (N.H. Sup. Ct. R. 3)."
}

state scheduling: "Scheduling order; record and transcript" by office cite "N.H. Sup. Ct. R. 12-B"
{
  note "The clerk issues a scheduling order setting the dates for the record, the briefs and the appendices, and whether a transcript is prepared (N.H. Sup. Ct. R. 12-B(1)). The record reaches the court through the parties' appendices or a motion for transmittal filed by the brief date (N.H. Sup. Ct. R. 13(2)-(4)). The moving party pays the transcript deposit within 15 days from the date on the scheduling order's written notice (N.H. Sup. Ct. R. 15(2)). A case not timely docketed, whose record is not transmitted or whose entry fee is not paid is dismissed (N.H. Sup. Ct. R. 5(4))."
  edge-scheduling-briefing "Scheduling order issued" -> briefing {
    authority cite "N.H. Sup. Ct. R. 16"
  }
  edge-scheduling-dismissed "Not docketed or record not provided" -> dismissed-prosecution {
    authority cite "N.H. Sup. Ct. R. 5"
  }
}

state briefing: "Briefs filed" by applicant cite "N.H. Sup. Ct. R. 16"
{
  note "Briefs are filed within the times in the scheduling order (N.H. Sup. Ct. R. 16(7)); with all parties' assent, up to two automatic extensions of no more than fifteen days each are taken by notice (N.H. Sup. Ct. R. 21(6-A)). A reply brief is filed by the earlier of 20 days after the opposing brief or memorandum of law or 10 days before oral argument (N.H. Sup. Ct. R. 16(7)). Word limits are those of N.H. Sup. Ct. R. 16(11) and 16(4)(b). The appealing party's failure to file a brief waives the appeal and the case is dismissed (N.H. Sup. Ct. R. 16(12))."
  edge-briefing-submitted "Briefing complete" -> argument { authority cite "N.H. Sup. Ct. R. 18" }
  edge-briefing-dismissed "No brief filed" -> dismissed-prosecution {
    authority cite "N.H. Sup. Ct. R. 16(12)"
  }
}

terminal dismissed-prosecution: "Appeal dismissed" outcome [loss, dismissal] cite "N.H. Sup. Ct. R. 16(12)"
{
  note "Failure to file a brief waives the appeal (N.H. Sup. Ct. R. 16(12)); failure to docket, transmit the record or pay the entry fee dismisses the case (N.H. Sup. Ct. R. 5(4))."
}

state argument: "Oral argument or submission on briefs" by court cite "N.H. Sup. Ct. R. 18"
{
  note "The court notifies the parties if oral argument is held; it is limited to 15 minutes a side unless more is granted for good cause shown in the brief (N.H. Sup. Ct. R. 18(1), (3)). A stipulation to submit on briefs is filed not later than ten days, and a motion to waive argument not later than twenty days, before the date scheduled for argument (N.H. Sup. Ct. R. 18(7))."
  edge-argument-decision "Argued or submitted" -> decision { authority cite "N.H. Sup. Ct. R. 20" }
}

decision decision: "Supreme Court decision" by court cite "N.H. Sup. Ct. R. 20"
{
  note "At least three justices must concur in any judgment; the opinion or final order, when mandated under Rule 24, is the judgment of the court (N.H. Sup. Ct. R. 20(1)-(2)). A motion for rehearing or reconsideration is filed within 10 days from the date of the opinion, dismissal or summary decision and may not exceed 3,000 words; an answer, if any, is due within 10 days from the filing of the motion (N.H. Sup. Ct. R. 22(2)-(3)). Review by the Supreme Court of the United States is lit/scotus and is not modeled here."
  edge-decision-affirmed "Affirmed" -> mandate-affirmed { authority cite "N.H. Sup. Ct. R. 24" }
  edge-decision-reversed "Reversed or vacated" -> mandate-reversed {
    authority cite "N.H. Sup. Ct. R. 24"
  }
}

state mandate-affirmed: "Mandate issues: affirmed" by office cite "N.H. Sup. Ct. R. 24"
{
  note "The clerk forwards the mandate to the trial court within 7 days after the time to move for rehearing or reconsideration has expired, or within 7 days after an order denying a timely motion, whichever is later, unless the court shortens or extends the time; the mandate is effective when issued (N.H. Sup. Ct. R. 24(1), (3))."
  edge-mandate-affirmed-final "Mandate issued" -> affirmed { authority cite "N.H. Sup. Ct. R. 24" }
}

state mandate-reversed: "Mandate issues: reversed or vacated" by office cite "N.H. Sup. Ct. R. 24"
{
  note "The mandate issues as Rule 24(1) provides. Costs are waived unless a request for taxation with itemization is filed within 30 days after the date on the order in the case (N.H. Sup. Ct. R. 23). Further proceedings in the trial court are not modeled."
  edge-mandate-reversed-final "Mandate issued" -> reversed { authority cite "N.H. Sup. Ct. R. 24" }
}

terminal affirmed: "Judgment affirmed" outcome [loss, judgment] cite "N.H. Sup. Ct. R. 24"
{
  note "Outcome from the appellant's side."
}

terminal reversed: "Judgment reversed or vacated" outcome [win, judgment] cite "N.H. Sup. Ct. R. 24"
{
  note "Outcome from the appellant's side."
}
