{
  given FinalPretrialConferenceHeld() on 2027-02-02
  expect deadline(pretrial-confer-period) == 2027-01-19
}

test "pretrial memorandum period: 7 days before the trigger" cite "D. Mass. L.R. 16.5(d)"
{
  given FinalPretrialConferenceHeld() on 2027-02-01
  expect deadline(pretrial-memorandum-period) == 2027-01-25
}

test "trial brief period: 7 days before the trigger" cite "D. Mass. L.R. 16.5(f)"
{
  given TrialCommenced() on 2027-02-01
  expect deadline(trial-brief-period) == 2027-01-25
}

test "witness notice period: 7 days before the trigger" cite "D. Mass. L.R. 43.1(b)"
{
  given WitnessTestified() on 2027-02-01
  expect deadline(witness-notice-period) == 2027-01-25
}

test "initial disclosure period: 14 days after the trigger" cite "D. Mass. L.R. 26.2(a)"
{
  given PartiesConferred() on 2026-11-02
  expect deadline(initial-disclosure-period) == 2026-11-16
}

