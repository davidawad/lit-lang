{
  "mcpServers": {
    "agent_mail": {
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp/",
      "headers": {
        "Authorization": "Bearer ${AGENT_MAIL_TOKEN}"
      }
    },
    "litigate": {
      "type": "stdio",
      "command": "cargo",
      "args": [
        "run",
        "-q",
        "--release",
        "-p",
        "litigate-cli",
        "--",
        "mcp"
      ]
    }
  }
}
