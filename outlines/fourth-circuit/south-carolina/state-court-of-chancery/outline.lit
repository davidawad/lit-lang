// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-sc-court-of-chancery

import sc-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start commenced

state commenced: "Complaint, petition or appeal filed" by applicant cite ?("S.C. Code (1825) (verify)")
{
  note "OUTLINE. Historical court: the Court of Chancery (Court of Equity) heard equity cases until the 1868 Constitution merged law and equity in the circuit courts (verify). Commencement in the Court of Chancery of South Carolina: filing period, fees and pleading form are holes. Leading decisions: not yet identified in this pass; verify before use."
  edge-commenced-served "Process served" -> pleadings { event ActionCommenced() authority cite ?("S.C. Ch. R. (verify)") }
}

chance pleadings: "Answer or motion to dismiss" by court cite ?("S.C. Ch. R. (verify)")
{
  note "OUTLINE. Response period and dismissal grounds are holes."
  edge-pleadings-dismissed "Dismissed on the pleadings" -> dismissed p ? { authority cite ?("S.C. Ch. R. (verify)") }
  edge-pleadings-answered "Answered; case proceeds" -> discovery p ? { authority cite ?("S.C. Ch. R. (verify)") }
  edge-pleadings-settled "Settled or withdrawn" -> settled p ? { }
}

state discovery: "Discovery and pretrial" by applicant cite ?("S.C. Ch. R. (verify)")
{
  note "OUTLINE. Discovery scope, limits and scheduling are holes."
  edge-discovery-dispositive "Dispositive motion or trial setting" -> dispositive { authority cite ?("S.C. Ch. R. (verify)") }
}

chance dispositive: "Summary disposition?" by court cite ?("S.C. Ch. R. (verify)")
{
  note "OUTLINE. Summary-judgment standard and timing are holes."
  edge-dispositive-granted "Decided without trial" -> judgment p ? { authority cite ?("S.C. Ch. R. (verify)") }
  edge-dispositive-trial "Tried" -> trial p ? { authority cite ?("S.C. Ch. R. (verify)") }
}

state trial: "Trial or hearing" by court cite ?("S.C. Ch. R. (verify)")
{
  note "OUTLINE. Jury availability and trial procedure are holes."
  edge-trial-judgment "Decision rendered" -> judgment { authority cite ?("S.C. Ch. R. (verify)") }
}

state judgment: "Judgment or decision entered" by court cite ?("S.C. Ch. R. (verify)")
{
  note "OUTLINE. Entry, notice of entry and post-judgment motion periods are holes."
  edge-judgment-entered "Judgment entered" -> post-judgment { event JudgmentEntered() authority cite ?("S.C. Ch. R. (verify)") }
}

decision post-judgment: "Appeal or review?" by applicant cite ?("S.C. Ct. of Errors (verify)")
{
  note "OUTLINE. The appeal period and the court that hears it are holes."
  edge-post-appeal "Appeal or petition for review filed" -> appeal-taken { event NoticeOfAppealFiled() authority cite ?("S.C. Ct. of Errors (verify)") }
  edge-post-final "No appeal" -> final-no-appeal { }
}

terminal dismissed: "Dismissed" outcome [loss, dismissal] cite ?("S.C. Ch. R. (verify)")
{
  note "OUTLINE. With or without prejudice is a hole."
  payoff ?
}

terminal settled: "Settled or withdrawn" outcome [settlement] cite ?("S.C. Code (1825) (verify)")
{
  note "OUTLINE. Settlement terms are outside this outline."
  payoff ?
}

terminal appeal-taken: "Appeal or review taken" outcome [final] cite ?("S.C. Ct. of Errors (verify)")
{
  note "OUTLINE. The reviewing court is its own package."
  payoff ?
}

terminal final-no-appeal: "Judgment final without appeal" outcome [final] cite ?("S.C. Ch. R. (verify)")
{
  note "OUTLINE. Enforcement is outside this outline."
  payoff ?
}
