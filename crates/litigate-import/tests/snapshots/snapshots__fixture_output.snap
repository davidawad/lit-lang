[dependencies]
demo-court = { version = "^0.1.0", path = "../demo" }
==> lit/links/links.lit <- tests/fixtures/demo-links.json
// Imported by `litigate import` from tests/fixtures/demo-links.json.
module links

instance demo-court@appeal {
  pack demo-court
  note "Entered on appeal."
  remove_edges [denied]
  probabilities { 12b-move: 1 }
  roles { applicant: opponent, examiner: self }
  payoff_transform (1_000_000.usd - payoff)
  patch denied { deadline 45.days { note "U.S. party" }, tags [patched] }
}

/// imported
link to-appeal "Appeal": demo-court::lost -> demo-court@appeal::filed by applicant p 0.5 {
  authority cite "28 U.S.C. § 1291"
  tags [appeal]
  replaces [demo-court::denied, "demo-court::ruling->won#0"]
}

/// imported
link _ "Refile": demo-court::won -> demo-court::filed
