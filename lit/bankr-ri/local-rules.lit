start motion-filed

state motion-filed: "Paper filed with response-time language" by applicant cite "R.I. LBR 1005-1(d)"
{
  note "Every motion, application, petition, objection to claim or objection to exemption carries the response-time language of R.I. LBR 1005-1(d) (14 days after electronic service, or the excepted periods of 1005-1(d)(2)), states its points and authorities (R.I. LBR 9013-1(a)) and is limited to 20 pages, a reply to 10 (R.I. LBR 9013-1(b)). Expedited and emergency determination follow R.I. LBR 9013-2. The paper's FRBP periods are lit/frbp's."
  edge-motion-filed-response "Objection or response filed" -> response {
    authority cite "R.I. LBR 1005-1(d)"
    within response-period
  }
  edge-motion-filed-unopposed "No timely response; deemed unopposed and granted" -> decided {
    authority cite "R.I. LBR 1005-1(d)"
  }
}

state response: "Objection or response filed; hearing scheduled" by opponent cite "R.I. LBR 9013-1(b)"
{
  note "If a hearing is needed, the clerk schedules it no less than 14 days from the hearing notice and the movant serves the notice (R.I. LBR 9013-1(b)(1)-(3)); a Joint Pretrial Statement may be required (R.I. LBR 9013-1(c), 9014-1(c))."
  edge-response-ruling "Hearing held" -> ruling { authority cite "R.I. LBR 9013-1(b)" }
}

decision ruling: "Matter decided" by court cite "R.I. LBR 9072-1(a)"
{
  note "The prevailing party submits and serves the order announced in open court within 7 days of the hearing (R.I. LBR 9072-1(a))."
  edge-ruling-granted "Granted" -> decided { authority cite "R.I. LBR 9072-1(a)" }
  edge-ruling-denied "Denied" -> decided { authority cite "R.I. LBR 9072-1(a)" }
}

terminal decided: "Matter decided: the case continues under lit/frbp" outcome [procedural] cite "R.I. LBR 1001-1"
{
  note "The Local Bankruptcy Rules govern cases and proceedings in the court."
}
