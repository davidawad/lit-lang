module core.states.new-york

import core.calendar.{ us-federal-holidays }

/// The public holidays of New York (N.Y. Gen. Constr. Law § 24) that
/// `us-federal-holidays` does not already close: Lincoln's birthday, February
/// 12 (the next day when it falls on a Sunday; a Saturday one is not moved),
/// and each general election day, held every year on the Tuesday after the
/// first Monday in November (Election Law § 8-100, not vendored), listed with
/// `once` to the end of 2050. Flag day, the second Sunday in June, is closed by
/// `weekend`. Closed from the date the vendored text was retrieved (October 29,
/// 2026; it carries no as-of date). Not modeled: the days the President or the
/// Governor appoints, which no vendored source lists.
calendar new-york-holidays cite "N.Y. Gen. Constr. Law § 24"
{
  lincolns-birthday: fixed(2, 12) effective [2026-10-29, ..) observed next_day
  general-election-day-2026: once(2026-11-03) effective [2026-10-29, ..)
  general-election-day-2027: once(2027-11-02) effective [2026-10-29, ..)
  general-election-day-2028: once(2028-11-07) effective [2026-10-29, ..)
  general-election-day-2029: once(2029-11-06) effective [2026-10-29, ..)
  general-election-day-2030: once(2030-11-05) effective [2026-10-29, ..)
  general-election-day-2031: once(2031-11-04) effective [2026-10-29, ..)
  general-election-day-2032: once(2032-11-02) effective [2026-10-29, ..)
  general-election-day-2033: once(2033-11-08) effective [2026-10-29, ..)
  general-election-day-2034: once(2034-11-07) effective [2026-10-29, ..)
  general-election-day-2035: once(2035-11-06) effective [2026-10-29, ..)
  general-election-day-2036: once(2036-11-04) effective [2026-10-29, ..)
  general-election-day-2037: once(2037-11-03) effective [2026-10-29, ..)
  general-election-day-2038: once(2038-11-02) effective [2026-10-29, ..)
  general-election-day-2039: once(2039-11-08) effective [2026-10-29, ..)
  general-election-day-2040: once(2040-11-06) effective [2026-10-29, ..)
  general-election-day-2041: once(2041-11-05) effective [2026-10-29, ..)
  general-election-day-2042: once(2042-11-04) effective [2026-10-29, ..)
  general-election-day-2043: once(2043-11-03) effective [2026-10-29, ..)
  general-election-day-2044: once(2044-11-08) effective [2026-10-29, ..)
  general-election-day-2045: once(2045-11-07) effective [2026-10-29, ..)
  general-election-day-2046: once(2046-11-06) effective [2026-10-29, ..)
  general-election-day-2047: once(2047-11-05) effective [2026-10-29, ..)
  general-election-day-2048: once(2048-11-03) effective [2026-10-29, ..)
  general-election-day-2049: once(2049-11-02) effective [2026-10-29, ..)
  general-election-day-2050: once(2050-11-08) effective [2026-10-29, ..)
}

/// FRCP 6 in the district courts of New York: the 2023 text
/// (`frcp6@2023-12-01`) with `new-york-holidays`, which 6(a)(6)(C)
/// ("any day declared a holiday by ... the state where the district court
/// is located") makes legal holidays "for periods that are measured after
/// an event" only. A district package there names it as its `counting`
/// rule and `recounts` lit/frcp. A calendar day is closed only from the
/// date its entry is in force; before it the count is `frcp6`'s.
counting frcp6-new-york effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCP 6(d)"
  holidays us-federal-holidays
  forward_holidays new-york-holidays cite "FRCP 6(a)(6)(C)"
  forums [frcp]
  allow_hours
  end_of_month clamp
}

/// FRBP 9006(a) (`frbp9006`) in the bankruptcy courts of New York:
/// `new-york-holidays` are legal holidays for a period counted forward only (FRBP
/// 9006(a)(6)(C), "any day declared a holiday by the state where the
/// district court is located"). A bankruptcy package there names it as its
/// `counting` rule and `recounts` lit/frbp. A calendar day is closed only
/// from the date its entry is in force.
counting frbp9006-new-york effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays new-york-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-nye, bankr-nyn, bankr-nys, bankr-nyw]
  allow_hours
  end_of_month clamp
}
