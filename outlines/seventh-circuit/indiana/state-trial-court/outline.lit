// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-in-trial-court

import outline-in-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start complaint-filed

state complaint-filed: "Action commenced" by applicant cite ?("Ind. Trial Rule 3")
{
  note "OUTLINE. Commencement by filing complaint (verify). Indiana uses notice pleading (verify)."
  edge-complaint-filed-response-due "Summons served" -> response-due { event ActionCommenced()
    authority cite ?("Ind. Trial Rule 4.1")
  }
}

state response-due: "Response due: answer or motion" cite ?("Ind. Trial Rule 12(A)")
{
  note "OUTLINE. Response period is a hole. Trial Rule 12(B)(6) motion; response period is a hole."
  edge-response-due-default-entered "No timely response" -> default-entered {
    authority cite ?("Ind. Trial Rule 55")
  }
  edge-response-due-motion-ruling "Motion to dismiss filed" -> motion-ruling {
    authority cite ?("Ind. Trial Rule 12(B)(6)")
  }
  edge-response-due-sched "Answer filed" -> sched {
    authority cite ?("Ind. Trial Rule 12(A)")
  }
}

decision motion-ruling: "Motion to dismiss ruling" by court cite ?("Ind. Trial Rule 12(B)(6)")
{
  note "OUTLINE. Trail v. Boys, 884 N.E.2d 294 (Ind. 2008) (T.R. 12(B)(6) standard; verify)."
  edge-motion-ruling-dismissed-with-prejudice "Dismissed with prejudice" -> dismissed-with-prejudice {
    authority cite ?("Ind. Trial Rule 41(B)")
  }
  edge-motion-ruling-response-due "Dismissed with leave to amend" -> response-due { event ActionCommenced()
    authority cite ?("Ind. Trial Rule 15")
  }
  edge-motion-ruling-sched "Denied" -> sched {
    authority cite ?("Ind. Trial Rule 12(B)(6)")
  }
}

state sched: "Scheduling order and initial disclosures" cite ?("Ind. Trial Rule 16")
{
  note "OUTLINE. Trial Rule 16 conference; local rules are holes."
  edge-sched-discovery "Order entered" -> discovery {
    authority cite ?("Ind. Trial Rule 16")
  }
}

state discovery: "Discovery" cite ?("Ind. Trial Rule 26, 33, 34, 36")
{
  note "OUTLINE. Discovery scope and sanctions under T.R. 26 and 37; local rules are holes."
  edge-discovery-sj-ruling "Dispositive motion filed" -> sj-ruling {
    authority cite ?("Ind. Trial Rule 56")
  }
  edge-discovery-dismissed-with-prejudice "Discovery sanction dismisses claims" -> dismissed-with-prejudice {
    authority cite ?("Ind. Trial Rule 37")
  }
  edge-discovery-settled "Settlement or voluntary dismissal" -> settled {
    authority cite ?("Ind. Trial Rule 41(A)")
  }
  edge-discovery-pretrial "No dispositive motion" -> pretrial {
    authority cite ?("Ind. Trial Rule 16")
  }
}

decision sj-ruling: "Summary judgment ruling" by court cite ?("Ind. Trial Rule 56")
{
  note "OUTLINE. Hughley v. State, 15 N.E.3d 1000 (Ind. 2014) (summary judgment burden; verify)."
  edge-sj-ruling-judgment-applicant "Granted for applicant" -> judgment-applicant {
    authority cite ?("Ind. Trial Rule 58")
  }
  edge-sj-ruling-judgment-opponent "Granted for opponent" -> judgment-opponent {
    authority cite ?("Ind. Trial Rule 58")
  }
  edge-sj-ruling-pretrial "Denied" -> pretrial {
    authority cite ?("Ind. Trial Rule 56")
  }
}

state pretrial: "Pretrial order" cite ?("Ind. Trial Rule 16")
{
  note "OUTLINE. Pretrial conference, order and trial setting."
  edge-pretrial-trial "Trial set" -> trial {
    authority cite ?("Ind. Trial Rule 16")
  }
}

state trial: "Trial (jury or bench)" cite ?("Ind. Trial Rule 38, 39")
{
  note "OUTLINE. Trial and findings or verdict."
  edge-trial-judgment-applicant "Verdict or findings for applicant" -> judgment-applicant {
    authority cite ?("Ind. Trial Rule 58")
  }
  edge-trial-judgment-opponent "Verdict or findings for opponent" -> judgment-opponent {
    authority cite ?("Ind. Trial Rule 58")
  }
}

state judgment-applicant: "Judgment for applicant entered" cite ?("Ind. Trial Rule 58")
{
  note "OUTLINE. Entry of judgment. Motion to correct error under T.R. 59; its period is a hole (verify)."
  edge-judgment-applicant-post-judgment-ruling "Post-judgment motion" -> post-judgment-ruling { event JudgmentEntered()
    authority cite ?("Ind. Trial Rule 50, 52, 59, 60")
  }
  edge-judgment-applicant-appellate-review "Notice of appeal filed" -> appellate-review { event NoticeOfAppealFiled()
    authority cite ?("Ind. Appellate Rule 9(A)(1)")
  }
  edge-judgment-applicant-final-win "No appeal within time" -> final-win {
    authority cite ?("Ind. Appellate Rule 9(A)(1)")
  }
}

state judgment-opponent: "Judgment for opponent entered" cite ?("Ind. Trial Rule 58")
{
  note "OUTLINE. Entry of judgment. Motion to correct error under T.R. 59; its period is a hole (verify)."
  edge-judgment-opponent-post-judgment-ruling "Post-judgment motion" -> post-judgment-ruling { event JudgmentEntered()
    authority cite ?("Ind. Trial Rule 50, 52, 59, 60")
  }
  edge-judgment-opponent-appellate-review "Notice of appeal filed" -> appellate-review { event NoticeOfAppealFiled()
    authority cite ?("Ind. Appellate Rule 9(A)(1)")
  }
  edge-judgment-opponent-final-loss "No appeal within time" -> final-loss {
    authority cite ?("Ind. Appellate Rule 9(A)(1)")
  }
}

decision post-judgment-ruling: "Post-judgment motion ruling" by court cite ?("Ind. Trial Rule 50, 52, 59, 60")
{
  note "OUTLINE. Post-judgment motions toll the appeal clock; verify tolling rule."
  edge-post-judgment-ruling-pretrial "Granted: new trial" -> pretrial {
    authority cite ?("Ind. Trial Rule 50, 52, 59, 60")
  }
  edge-post-judgment-ruling-appellate-review "Denied: appeal clock runs from order" -> appellate-review { event NoticeOfAppealFiled()
    authority cite ?("Ind. Appellate Rule 9(A)(1)")
  }
}

terminal default-entered: "Default entered against opponent" outcome [win] cite ?("Ind. Trial Rule 55")
{
  note "OUTLINE. Default under the rule; judgment by default is a separate entry. Outcome is from the applicant's side."
  payoff ?
}

terminal dismissed-with-prejudice: "Dismissed with prejudice" outcome [loss] cite ?("Ind. Trial Rule 41(B)")
{
  note "OUTLINE. Outcome from the applicant's side."
  payoff ?
}

terminal settled: "Settled or voluntarily dismissed" outcome [settlement] cite ?("Ind. Trial Rule 41(A)")
{
  note "OUTLINE. Settlement terms are a hole."
  payoff ?
}

terminal final-win: "Final judgment for applicant, no appeal" outcome [win] cite ?("Ind. Appellate Rule 9(A)(1)")
{
  note "OUTLINE. Judgment final when the appeal period lapses."
  payoff ?
}

terminal final-loss: "Final judgment for opponent, no appeal" outcome [loss] cite ?("Ind. Appellate Rule 9(A)(1)")
{
  note "OUTLINE. Judgment final when the appeal period lapses."
  payoff ?
}

terminal appellate-review: "Appeal taken: continue in the appellate package" cite ?("Ind. Appellate Rule 9(A)(1)")
{
  note "OUTLINE. Hand-off to the state's appellate court packages."
  payoff ?
}
