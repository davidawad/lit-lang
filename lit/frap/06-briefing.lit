module frap.briefing

import core.authority.{ CaseOrder, LocalRule }
import core.frap26.{ frap26 }
import frap.argument.{ oral-argument-fork }
import frap.events.{ RecordFiled, ServedPaper }
import frap.filing.{ PrincipalBriefFiled }
import frap.{ briefing-group }

/// FRAP 31(a)(1) as the 2009 amendments left it (2017 edition of 28
/// U.S.C. App.): the appellant's brief is due 40 days after the record is
/// filed, the appellee's 30 days after the appellant's brief is served,
/// and a reply "within 14 days after service of the appellee's brief" (the
/// 2009 amendment changed only the reply's "3 days" before argument to "7
/// days"; 2009 Committee Note). The December 1, 2018 amendment's 21 days
/// is the version below. A court of appeals "may shorten the time to serve
/// and file briefs, either by local rule or by order in a particular case"
/// (FRAP 31(a)(2)), and may extend it for good cause (FRAP 26(b)), so each
/// period delegates to `LocalRule` and `CaseOrder`. The two served briefs
/// gain FRAP 26(c)'s 3 days after mail, carrier or prison-mail service.
rule duty serve-and-file-briefs effective [2009-12-01, 2018-12-01) known_at 2009-03-26 cite "FRAP (2017 ed.) 31(a)"
{
  deadline appellant-brief-period: 40.days after RecordFiled() counted_by frap26 delegable {
    to [LocalRule, CaseOrder]
    op set
  } cite "FRAP (2017 ed.) 31(a)(1)"
  deadline appellee-brief-period: 30.days after ServedPaper(AppellantBrief) counted_by frap26 delegable {
    to [LocalRule, CaseOrder]
    op set
  } cite "FRAP (2017 ed.) 31(a)(1)"
  deadline reply-brief-period: 14.days after ServedPaper(AppelleeBrief) counted_by frap26 delegable {
    to [LocalRule, CaseOrder]
    op set
  } cite "FRAP (2017 ed.) 31(a)(1)"
}

/// FRAP 31(a)(1) as amended December 1, 2018 (Apr. 26, 2018 order): the
/// appellant "may serve and file a reply brief within 21 days after
/// service of the appellee's brief", in place of 14. The 40 and 30 days
/// and the delegation to `LocalRule` and `CaseOrder` (FRAP 31(a)(2), 26(b))
/// are unchanged from the 2009 version above.
rule duty serve-and-file-briefs effective [2018-12-01, ..) known_at 2018-04-26 supersedes serve-and-file-briefs@2009-12-01 cite "FRAP 31(a)"
{
  deadline appellant-brief-period: 40.days after RecordFiled() counted_by frap26 delegable {
    to [LocalRule, CaseOrder]
    op set
  } cite "FRAP 31(a)(1)"
  deadline appellee-brief-period: 30.days after ServedPaper(AppellantBrief) counted_by frap26 delegable {
    to [LocalRule, CaseOrder]
    op set
  } cite "FRAP 31(a)(1)"
  deadline reply-brief-period: 21.days after ServedPaper(AppelleeBrief) counted_by frap26 delegable {
    to [LocalRule, CaseOrder]
    op set
  } cite "FRAP 31(a)(1)"
}

test "the opening brief is due 40 days after the record is filed" cite "FRAP 31(a)(1)"
{
  given RecordFiled() on 2025-02-05
  expect deadline(appellant-brief-period) == 2025-03-17
}

test "a 40th day on a Saturday rolls to Monday" cite "FRAP 26(a)(1)(C)"
{
  given RecordFiled() on 2025-03-03
  expect deadline(appellant-brief-period) == 2025-04-14
}

test "the appellee's brief is due 30 days after service of the opening brief" cite "FRAP 31(a)(1)"
{
  given ServedPaper(AppellantBrief, Electronic) on 2025-04-14
  expect deadline(appellee-brief-period) == 2025-05-14
}

test "a 30th day on Independence Day rolls to Monday" cite "FRAP 26(a)(6)(A)"
{
  given ServedPaper(AppellantBrief, Electronic) on 2025-06-04
  expect deadline(appellee-brief-period) == 2025-07-07
}

test "a reply is due 21 days after service of the appellee's brief" cite "FRAP 31(a)(1)"
{
  given ServedPaper(AppelleeBrief, Electronic) on 2025-05-14
  expect deadline(reply-brief-period) == 2025-06-04
}

test "a 21st day on Labor Day rolls to Tuesday" cite "FRAP 26(a)(6)(A)"
{
  given ServedPaper(AppelleeBrief, Electronic) on 2025-08-11
  expect deadline(reply-brief-period) == 2025-09-02
}

decision appellant-brief-window: "Appellant's Opening Brief Due" by applicant cite "FRAP 31(a)(1)"
{
  group briefing-group
  note "The 40-day deadline runs from the date the record is filed with the court, not from the notice of appeal. Appellant must track the actual record closure date to avoid confusion; missing this self-inflicted trap is a leading cause of appellate dismissal. FRAP 28(a) sets required contents; FRAP 32(a)(7) caps the brief at 13,000 words (or 30 pages if monospaced)."
  edge-appellant-brief-window-appellant-brief-filed "File opening brief" -> appellant-brief-filed {
    authority cite "FRAP 31(a)(1)"
    effort 100.hours
    event PrincipalBriefFiled()
    within appellant-brief-period {
      extendable true
      extension_authority "FRAP 26(b); court discretion for good cause"
      note "Failure to file by day 40 (or the extended date) permits an appellee motion to dismiss for want of prosecution under FRAP 31(c), triggering a dismissal that is nearly impossible to revive."
    }
    duration { min 6.days, mode 20.days, max 40.days }
    note "Hours: BigLaw-honest estimate for the effort of this move; basis: estimate."
  }
  edge-appellant-brief-window-appeal-dismissed-no-brief "Fail to file opening brief" -> appeal-dismissed-no-brief {
    authority cite "FRAP 31(c)"
    effort 0.hours
    valence bad
    note "Hours: BigLaw-honest estimate for the effort of this move; basis: estimate."
  }
}

state appellant-brief-filed: "Opening Brief Filed" by applicant cite "FRAP 28(a); FRAP 32(a)(7)"
{
  group briefing-group
  note "The opening brief frames the issues, selects the standard of review, and defines the factual universe for appellate review. The appellant is bound by these choices; the reply brief cannot resurrect abandoned arguments, and new theories in reply are waived. The 13,000-word cap forces ruthless economy in issue-spotting."
  edge-appellant-brief-filed-appellee-brief-filed "Appellee files response brief" -> appellee-brief-filed {
    authority cite "FRAP 31(a)(1); FRAP 28(b)"
    effort 90.hours
    event PrincipalBriefFiled()
    within appellee-brief-period {
      extendable true
      extension_authority "FRAP 26(b); court discretion for good cause"
      note "Appellee's failure to file within 30 days is grounds for default, but the appellee retains the right to oral argument by court permission even if the brief is late; missing this deadline is far less terminal than the appellant's miss."
    }
    duration { min 4.5.days, mode 15.days, max 30.days }
    note "Hours: BigLaw-honest estimate for the effort of this move; basis: estimate."
  }
}

terminal appeal-dismissed-no-brief: "DISMISSED — Failure to Prosecute (No Opening Brief)" outcome [loss, procedural-default, waiver-trap] cite "FRAP 31(c)"
{
  group briefing-group
  note "Dismissal for 'want of prosecution' when the appellant fails to file timely is discretionary with the court but nearly automatic on appellee motion. This is a conduct-based sanction, not a jurisdictional defect, and is extremely difficult to revive post-dismissal because it reflects lack of diligence, not legal error. PLACEHOLDER PAYOFF: $0, override per matter."
  valence bad
  payoff 0.usd
}

state appellee-brief-filed: "Appellee's Response Brief Filed" by applicant cite "FRAP 31(a)(1); FRAP 28(b)"
{
  group briefing-group
  note "The appellee enjoys asymmetric freedom: it may defend the judgment on any ground in the record without admitting any fact or standard the appellant proposed, and may attack the appellant's statement of the case or standard of review without conceding issue-framing. The 30-day period runs from service of the opening brief and can be extended for good cause."
  edge-appellee-brief-filed-reply-brief-filed "File reply brief" -> reply-brief-filed {
    authority cite "FRAP 31(a)(1); FRAP 28(c)"
    effort 40.hours
    within reply-brief-period {
      extendable true
      extension_authority "FRAP 26(b); court discretion for good cause; FRAP 31(a)(1) requires filing at least 7 days before argument"
      note "Reply brief must be filed at least 7 days before oral argument (if scheduled) or risk rejection. Late reply briefs are rarely accepted; this is a cascading deadline that depends on the argument calendar, not a pure 21-day rule."
    }
    duration { min 3.1.days, mode 10.5.days, max 21.days }
    note "Hours: BigLaw-honest estimate for the effort of this move; basis: estimate."
  }
  edge-appellee-brief-filed-briefing-complete "Waive reply brief" -> briefing-complete {
    authority cite "FRAP 28(c)"
    effort 1.hours
    note "Hours: BigLaw-honest estimate for the effort of this move; basis: estimate."
  }
}

state reply-brief-filed: "Appellant's Reply Brief Filed" by office cite "FRAP 31(a)(1); FRAP 28(c)"
{
  group briefing-group
  note "The reply brief is optional — failure to file waives no substantive right, but filing one that strays beyond the appellee's response opens waiver traps. The 6,500-word cap is non-negotiable; new arguments, new authorities, and arguments not fairly responsive to the response brief are all waived."
  edge-reply-brief-filed-briefing-complete "Briefing closes" -> briefing-complete {
    authority cite "FRAP 31"
  }
}

state briefing-complete: "Briefing Closed" by office cite "FRAP 31"
{
  group briefing-group
  note "Once all briefs are filed or the reply deadline expires, the written record closes and is fixed. No supplemental briefs are permitted absent extraordinary circumstances (e.g., intervening Supreme Court authority). The panel's decision is now constrained to the four corners of the briefs and the certified record on appeal."
  edge-briefing-complete-oral-argument-fork "Clerk calendars argument decision" -> oral-argument-fork {
    authority cite "FRAP 34(a)"
  }
}
