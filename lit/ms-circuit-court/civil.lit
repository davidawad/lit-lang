module ms-circuit-court-civil.civil

start complaint-filed

state complaint-filed: "Complaint filed" by applicant cite "M.R.C.P. 3(a)"
{
  note "A civil action is commenced by filing a complaint with the court, with the costs deposit the law and rules require (M.R.C.P. 3(a)). Periods in this package are stated, not counted: computation is M.R.C.P. 6(a). The outline's one named decision, Brown v. Credit Center, Inc., 444 So. 2d 358 (Miss. 1983), could not be checked against a vendored reporter and is removed."
  edge-complaint-filed-service "Summons issued for service" -> service-made {
    authority cite "M.R.C.P. 4(h)"
  }
}

decision service-made: "Served within 120 days?" by applicant cite "M.R.C.P. 4(h)"
{
  note "If service of the summons and complaint is not made on a defendant within 120 days after the filing of the complaint and good cause is not shown, the action is dismissed as to that defendant without prejudice, on the court's own initiative with notice or on motion (M.R.C.P. 4(h)). If no acknowledgment of service by mail is received within 20 days after mailing, service may be made in any other permitted manner (M.R.C.P. 4(c)(3)(B))."
  edge-service-made-response "Served in time" -> response-due { authority cite "M.R.C.P. 4(h)" }
  edge-service-made-lapsed "Not served in time" -> service-dismissal {
    authority cite "M.R.C.P. 4(h)"
  }
}

decision response-due: "Answer, Rule 12 motion, or nothing" by office cite "M.R.C.P. 12(a)"
{
  note "A defendant serves the answer within thirty days after service of the summons and complaint, or within the time directed under Rule 4 (M.R.C.P. 12(a)). A Rule 12 motion alters the time: if it is denied or postponed, the responsive pleading is served within ten days after notice of the court's action (M.R.C.P. 12(a)(1)); these times may be extended once only, for not more than ten days, by written stipulation filed in the record (M.R.C.P. 12(a)). Affirmative defenses are set forth in the answer (M.R.C.P. 8(c))."
  edge-response-due-answer "Answer filed" -> answered { authority cite "M.R.C.P. 12(a)" }
  edge-response-due-motion "Rule 12(b)(6) or 12(c) motion filed" -> pleading-motion {
    authority cite "M.R.C.P. 12(b)"
  }
  edge-response-due-default "No response" -> default-request { authority cite "M.R.C.P. 55(a)" }
}

state pleading-motion: "Rule 12(b)(6) or 12(c) motion" by office cite "M.R.C.P. 12(b)"
{
  note "Failure to state a claim upon which relief can be granted may be raised by motion (M.R.C.P. 12(b)(6)); after the pleadings are closed a party may move for judgment on the pleadings (M.R.C.P. 12(c)). A written motion and notice of its hearing are served not later than five days before the hearing unless the rules or an order fix another period (M.R.C.P. 6(d))."
  edge-pleading-motion-ruling "Court rules" -> pleading-ruling { authority cite "M.R.C.P. 12(b)" }
}

decision pleading-ruling: "Ruling on the pleading challenge" by court cite "M.R.C.P. 12(b)"
{
  note "On sustaining a motion under Rule 12(b)(6) or 12(c), leave to amend shall be granted when justice so requires, on conditions and within time the court determines (M.R.C.P. 15(a))."
  edge-pleading-ruling-dismissed "Dismissed with prejudice" -> dismissed-merits {
    authority cite "M.R.C.P. 12(b)"
  }
  edge-pleading-ruling-leave "Dismissed with leave to amend" -> amended {
    authority cite "M.R.C.P. 15(a)"
  }
  edge-pleading-ruling-denied "Denied" -> answered { authority cite "M.R.C.P. 12(a)" }
}

state amended: "Amended pleading filed" by applicant cite "M.R.C.P. 15(a)"
{
  note "A party may amend as a matter of course before a responsive pleading is served; otherwise by leave of court or written consent of the adverse party (M.R.C.P. 15(a))."
  edge-amended-response "Amended pleading served" -> response-due {
    authority cite "M.R.C.P. 15(a)"
  }
}

state answered: "Answer filed" by applicant cite "M.R.C.P. 8(c)"
{
  note "Affirmative defenses such as accord and satisfaction, estoppel, fraud, limitations and waiver are set forth affirmatively (M.R.C.P. 8(c))."
  edge-answered-discovery "Pleadings closed" -> discovery { authority cite "M.R.C.P. 26(b)" }
}

state default-request: "Default sought" by applicant cite "M.R.C.P. 55(a)"
{
  note "When a party against whom affirmative relief is sought has failed to plead or otherwise defend and that fact is made to appear by affidavit or otherwise, the clerk enters the default (M.R.C.P. 55(a))."
  edge-default-request-entered "Default entered" -> default-entered {
    authority cite "M.R.C.P. 55(a)"
  }
  edge-default-request-answered "Answer filed before default" -> answered {
    authority cite "M.R.C.P. 12(a)"
  }
}

state default-entered: "Default entered" by applicant cite "M.R.C.P. 55(b)"
{
  note "The party entitled to a default judgment applies to the court; a party who has appeared is served with written notice of the application at least three days before the hearing, but judgment may be entered on the day the case is set for trial without that notice (M.R.C.P. 55(b)). The court may conduct hearings to determine damages (M.R.C.P. 55(b))."
  edge-default-entered-judgment "Default judgment sought" -> default-judgment {
    authority cite "M.R.C.P. 55(b)"
  }
  edge-default-entered-set-aside "Defendant moves to set aside" -> set-aside-ruling {
    authority cite "M.R.C.P. 55(c)"
  }
}

decision set-aside-ruling: "Set aside the default?" by court cite "M.R.C.P. 55(c)"
{
  note "For good cause shown the court may set aside an entry of default and, if a default judgment has been entered, may set it aside in accordance with Rule 60(b) (M.R.C.P. 55(c)); a Rule 60(b) motion for reasons (1), (2) and (3) is made not more than six months after the judgment (M.R.C.P. 60(b))."
  edge-set-aside-granted "Set aside" -> answered { authority cite "M.R.C.P. 55(c)" }
  edge-set-aside-refused "Refused" -> default-judgment { authority cite "M.R.C.P. 55(c)" }
}

state discovery: "Discovery" by applicant cite "M.R.C.P. 26(b)"
{
  note "Parties may obtain discovery of any matter, not privileged, relevant to the issues raised by the claims or defenses of any party (M.R.C.P. 26(b)(1)). Where no action of record has been taken during the preceding twelve months, the clerk mails notice that the case will be dismissed for want of prosecution unless within thirty days action of record is taken or good cause is shown (M.R.C.P. 41(d)(1))."
  edge-discovery-dispute "Discovery dispute" -> discovery-ruling { authority cite "M.R.C.P. 37(a)" }
  edge-discovery-sj "Summary judgment motion" -> sj-motion { authority cite "M.R.C.P. 56(c)" }
  edge-discovery-settled "Settled: dismissal by stipulation" -> settled {
    authority cite "M.R.C.P. 41(a)"
  }
  edge-discovery-voluntary "Voluntary dismissal" -> voluntary-dismissal {
    authority cite "M.R.C.P. 41(a)"
  }
  edge-discovery-inactive "No action of record for twelve months" -> inactivity-dismissal {
    authority cite "M.R.C.P. 41(d)"
  }
}

decision discovery-ruling: "Discovery ruling" by court cite "M.R.C.P. 37(b)"
{
  note "A discovering party may move for an order compelling discovery (M.R.C.P. 37(a)); failure to obey a discovery order may draw sanctions including dismissal of the action (M.R.C.P. 37(b)(2))."
  edge-discovery-ruling-resolved "Dispute resolved" -> discovery { authority cite "M.R.C.P. 37(a)" }
  edge-discovery-ruling-sanction "Sanction dismissal" -> sanction-dismissal {
    authority cite "M.R.C.P. 37(b)"
  }
}

state sj-motion: "Summary judgment motion" by office cite "M.R.C.P. 56(c)"
{
  note "A claimant may move at any time after thirty days from commencement of the action (M.R.C.P. 56(a)). The motion is served at least ten days before the time fixed for the hearing, and the adverse party may serve opposing affidavits before the day of the hearing; judgment is rendered forthwith if there is no genuine issue as to any material fact and the movant is entitled to judgment as a matter of law (M.R.C.P. 56(c))."
  edge-sj-motion-ruling "Motion heard" -> sj-ruling { authority cite "M.R.C.P. 56(c)" }
}

decision sj-ruling: "Summary judgment ruling" by court cite "M.R.C.P. 56(c)"
{
  note "A summary judgment, interlocutory in character, may be rendered on liability alone although there is a genuine issue as to damages (M.R.C.P. 56(c)); a case not fully adjudicated proceeds under M.R.C.P. 56(d)."
  edge-sj-ruling-defense "Granted for defendant" -> sj-defense { authority cite "M.R.C.P. 56(c)" }
  edge-sj-ruling-applicant "Granted for applicant" -> judgment-for-applicant {
    authority cite "M.R.C.P. 56(c)"
  }
  edge-sj-ruling-denied "Denied" -> trial-setting { authority cite "M.R.C.P. 56(d)" }
}

state trial-setting: "Trial setting and jury trial" by office cite "M.R.C.P. 40(b)"
{
  note "Cases are set on the trial docket at least twenty (20) days before the trial date unless all parties agree to a shorter period (M.R.C.P. 40(b)). The court may direct a pretrial conference at least twenty days before trial (M.R.C.P. 16). The right of trial by jury is preserved inviolate and is waived only by a specific written stipulation filed with the court (M.R.C.P. 38(a), (b)); the rules set no jury-demand period, contrary to the outline."
  edge-trial-setting-result "Tried" -> trial-result { authority cite "M.R.C.P. 38(a)" }
}

decision trial-result: "Judgment after trial" by court cite "M.R.C.P. 58"
{
  note "Every judgment is set forth on a separate document titled \"Judgment\" and is effective only when entered as provided in M.R.C.P. 79(a) (M.R.C.P. 58). A motion for judgment notwithstanding the verdict is filed not later than ten days after entry of judgment (M.R.C.P. 50(b)); a motion for a new trial, or to alter or amend the judgment, not later than ten days after entry of judgment (M.R.C.P. 59(b), (e)); a motion to amend findings not later than ten days after entry (M.R.C.P. 52(b)). The time for appeal is lit/ms-appellate's."
  edge-trial-result-applicant "Judgment for applicant" -> judgment-for-applicant {
    authority cite "M.R.C.P. 58"
  }
  edge-trial-result-defense "Judgment for defendant" -> verdict-for-defendant {
    authority cite "M.R.C.P. 58"
  }
  edge-trial-result-post "Post-trial motion filed" -> post-trial { authority cite "M.R.C.P. 59(b)" }
}

decision post-trial: "Post-trial motion ruling" by court cite "M.R.C.P. 59(a)"
{
  note "When a new trial motion rests on affidavits, the opposing party has ten days after service to file opposing affidavits (M.R.C.P. 59(c)). The court may on its own initiative order a new trial not later than ten days after entry of judgment (M.R.C.P. 59(d))."
  edge-post-trial-new-trial "New trial granted" -> trial-setting { authority cite "M.R.C.P. 59(a)" }
  edge-post-trial-applicant "Denied; applicant's judgment stands" -> judgment-for-applicant {
    authority cite "M.R.C.P. 58"
  }
  edge-post-trial-defense "Denied; defendant's judgment stands" -> verdict-for-defendant {
    authority cite "M.R.C.P. 58"
  }
}

terminal service-dismissal: "Dismissed for failure to serve" outcome [loss, dismissal] cite "M.R.C.P. 4(h)"
{
  note "Dismissal for failure to serve within 120 days is without prejudice as to that defendant (M.R.C.P. 4(h))."
}

terminal dismissed-merits: "Dismissed on the pleadings" outcome [loss, dismissal] cite "M.R.C.P. 12(b)"
{
  note "Appeal: see lit/ms-appellate."
}

terminal default-judgment: "Default judgment" outcome [win] cite "M.R.C.P. 55(b)"
{
  note "Costs are allowed as of course to the prevailing party unless the court otherwise directs (M.R.C.P. 54(e))."
}

terminal sanction-dismissal: "Dismissed as discovery sanction" outcome [loss, dismissal] cite "M.R.C.P. 37(b)"
{
  note "Dismissal is among the sanctions for failure to obey a discovery order (M.R.C.P. 37(b)(2))."
}

terminal inactivity-dismissal: "Dismissed for want of prosecution" outcome [loss, dismissal] cite "M.R.C.P. 41(d)"
{
  note "If no action of record is taken and no good cause is shown within thirty days after the clerk's notice, the court dismisses the case without prejudice (M.R.C.P. 41(d)(1))."
}

terminal voluntary-dismissal: "Voluntary dismissal" outcome [neutral] cite "M.R.C.P. 41(a)"
{
  note "By notice before service of an answer or summary judgment motion, whichever first occurs, or by stipulation of all parties who have appeared; without prejudice unless the notice or stipulation states otherwise (M.R.C.P. 41(a)(1))."
}

terminal settled: "Settled" outcome [neutral] cite "M.R.C.P. 41(a)"
{
  note "Dismissal by a stipulation signed by all parties who have appeared (M.R.C.P. 41(a)(1)(ii))."
}

terminal sj-defense: "Summary judgment for defendant" outcome [loss] cite "M.R.C.P. 56(c)"
{
  note "Appeal: see lit/ms-appellate."
}

terminal judgment-for-applicant: "Judgment for applicant" outcome [win] cite "M.R.C.P. 58"
{
  note "Costs are allowed as of course to the prevailing party unless the court otherwise directs (M.R.C.P. 54(e))."
}

terminal verdict-for-defendant: "Judgment or verdict for defendant" outcome [loss] cite "M.R.C.P. 58"
{
  note "Appeal: see lit/ms-appellate."
}
