// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-ar-state-appellate

start notice-filed

state notice-filed: "Notice of appeal filed" by applicant cite ?("Ark. R. App. P.–Civ. 2(a)")
{
  note "OUTLINE. Notice of appeal under App.-Civ. 2(a) period (hole; verify)."
  edge-notice-filed-appealability "Notice filed" -> appealability {
    authority cite ?("Ark. R. App. P.–Civ. 2(a)")
  }
}

decision appealability: "Appellate jurisdiction check" by court cite ?("Ark. Const. amend. 80, § 6; Ark. Sup. Ct. R. 2-1(a)")
{
  note "OUTLINE. Appealable orders under Ark. Sup. Ct. R. 2-1(a) (verify). No leading decision named."
  edge-appealability-dismissed-jurisdiction "Not an appealable order, or untimely" -> dismissed-jurisdiction {
    authority cite ?("Ark. Const. amend. 80, § 6; Ark. Sup. Ct. R. 2-1(a)")
  }
  edge-appealability-record "Appealable order" -> record {
    authority cite ?("Ark. Const. amend. 80, § 6; Ark. Sup. Ct. R. 2-1(a)")
  }
}

terminal dismissed-jurisdiction: "Dismissed for lack of appellate jurisdiction" outcome [loss] cite ?("Ark. Const. amend. 80, § 6; Ark. Sup. Ct. R. 2-1(a)")
{
  note "OUTLINE. Outcome from the applicant's side."
  payoff ?
}

state record: "Record settled and transmitted" cite ?("Ark. Sup. Ct. R. 3-5(a)-(b)")
{
  note "OUTLINE. Record under Ark. Sup. Ct. R. 3-5 (verify)."
