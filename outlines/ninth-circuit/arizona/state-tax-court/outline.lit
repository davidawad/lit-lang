// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-az-tax-court

import outline-az-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start commenced

state commenced: "Complaint, petition or appeal filed" by applicant cite ?("A.R.S. § 12-163 (verify)")
{
  note "OUTLINE. The tax court is a department of the Superior Court in Maricopa County with jurisdiction over tax appeals; small-claims tax cases go to its small claims division. Commencement in the Arizona Tax Court: filing period, fees and pleading form are holes. Leading decisions: not yet identified in this pass; verify before use."
  edge-commenced-served "Process served" -> pleadings { event ActionCommenced() authority cite ?("Ariz. Tax Ct. R. (verify)") }
}

chance pleadings: "Answer or motion to dismiss" by court cite ?("Ariz. R. Civ. P. 12 (verify)")
{
  note "OUTLINE. Response period and dismissal grounds are holes."
  edge-pleadings-dismissed "Dismissed on the pleadings" -> dismissed p ? { authority cite ?("Ariz. R. Civ. P. 12 (verify)") }
  edge-pleadings-answered "Answered; case proceeds" -> discovery p ? { authority cite ?("Ariz. R. Civ. P. 12 (verify)") }
  edge-pleadings-settled "Settled or withdrawn" -> settled p ? { }
}

state discovery: "Discovery and pretrial" by applicant cite ?("Ariz. R. Civ. P. 26 (verify)")
{
  note "OUTLINE. Discovery scope, limits and scheduling are holes."
  edge-discovery-dispositive "Dispositive motion or trial setting" -> dispositive { authority cite ?("Ariz. R. Civ. P. 56 (verify)") }
}

chance dispositive: "Summary disposition?" by court cite ?("Ariz. R. Civ. P. 56 (verify)")
{
  note "OUTLINE. Summary-judgment standard and timing are holes."
  edge-dispositive-granted "Decided without trial" -> judgment p ? { authority cite ?("Ariz. R. Civ. P. 56 (verify)") }
  edge-dispositive-trial "Tried" -> trial p ? { authority cite ?("A.R.S. § 12-168 (verify)") }
}

state trial: "Trial or hearing" by court cite ?("A.R.S. § 12-168 (verify)")
{
  note "OUTLINE. Jury availability and trial procedure are holes."
  edge-trial-judgment "Decision rendered" -> judgment { authority cite ?("Ariz. R. Civ. P. 54 (verify)") }
}

state judgment: "Judgment or decision entered" by court cite ?("Ariz. R. Civ. P. 54 (verify)")
{
  note "OUTLINE. Entry, notice of entry and post-judgment motion periods are holes."
  edge-judgment-entered "Judgment entered" -> post-judgment { event JudgmentEntered() authority cite ?("Ariz. R. Civ. P. 54 (verify)") }
}

decision post-judgment: "Appeal or review?" by applicant cite ?("A.R.S. § 12-170 (verify)")
{
  note "OUTLINE. The appeal period and the court that hears it are holes."
  edge-post-appeal "Appeal or petition for review filed" -> appeal-taken { event NoticeOfAppealFiled() authority cite ?("A.R.S. § 12-170 (verify)") }
  edge-post-final "No appeal" -> final-no-appeal { }
}

terminal dismissed: "Dismissed" outcome [loss, dismissal] cite ?("Ariz. R. Civ. P. 12 (verify)")
{
  note "OUTLINE. With or without prejudice is a hole."
  payoff ?
}

terminal settled: "Settled or withdrawn" outcome [settlement] cite ?("A.R.S. § 12-163 (verify)")
{
  note "OUTLINE. Settlement terms are outside this outline."
  payoff ?
}

terminal appeal-taken: "Appeal or review taken" outcome [final] cite ?("A.R.S. § 12-170 (verify)")
{
  note "OUTLINE. The reviewing court is its own package."
  payoff ?
}

terminal final-no-appeal: "Judgment final without appeal" outcome [final] cite ?("Ariz. R. Civ. P. 54 (verify)")
{
  note "OUTLINE. Enforcement is outside this outline."
  payoff ?
}
