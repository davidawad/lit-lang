// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-kyed

start complaint-filed

state complaint-filed: "Complaint Filed" by applicant cite ?("Fed. R. Civ. P. 3")
{
  note "OUTLINE. A civil action commences by filing a complaint (Rule 3). Subject-matter jurisdiction (28 U.S.C. 1331, 1332) and venue (28 U.S.C. 1391) are checked at filing. OUTLINE. E.D. Ky. local civil rules and the assigned district and magistrate judges' standing orders are NOT verified here (local rule numbers are holes). Check them before any step."
  edge-complaint-filed-service-made "Summons issued and served" -> service-made {
    authority cite ?("Fed. R. Civ. P. 4(m)")
  }
}

state service-made: "Summons and complaint served" by applicant cite ?("Fed. R. Civ. P. 4(c)(1), 4(m)")
{
  note "OUTLINE. Service period under Rule 4(m) is a hole (?). Extension for good cause is discretionary. Verify leading decisions on good cause before relying on them."
  edge-service-made-response-due "Served in time" -> response-due {
    authority cite ?("Fed. R. Civ. P. 4(m)")
  }
  edge-service-made-not-served "Not served in time" -> dismissed-no-service {
    authority cite ?("Fed. R. Civ. P. 4(m)")
  }
}

decision response-due: "Answer, Rule 12 motion, or nothing" by office cite ?("Fed. R. Civ. P. 12(a)(1)(A)(i), 12(a)(4)")
{
  note "OUTLINE. Response period is ? (Rule 12(a)(1)(A)); Rule 12(a)(4) suspends it for a Rule 12 motion. A waiver under Rule 4(d) carries its own period (?)."
  edge-response-due-answer "Answer filed" -> answer-filed {
    authority cite ?("Fed. R. Civ. P. 8(b); 12(a)(1)(A)(i)")
  }
  edge-response-due-motion "Rule 12(b) motion filed" -> rule12-motion {
    authority cite ?("Fed. R. Civ. P. 12(b)")
  }
  edge-response-due-none "No response" -> default-request {
    authority cite ?("Fed. R. Civ. P. 55(a)")
  }
}

state rule12-motion: "Rule 12(b) motion pending" by office cite ?("Fed. R. Civ. P. 12(b)(1), 12(b)(6), 12(h)(3)")
{
  note "OUTLINE. Pleading standard (verify): Bell Atlantic Corp. v. Twombly, 550 U.S. 544 (2007); Ashcroft v. Iqbal, 556 U.S. 662 (2009). Subject-matter jurisdiction may be raised at any time (Rule 12(h)(3)). Circuit applications to be added. OUTLINE. E.D. Ky. local civil rules and the assigned district and magistrate judges' standing orders are NOT verified here (local rule numbers are holes). Check them before any step."
  edge-rule12-motion-ruling "Court rules" -> rule12-ruling {
    authority cite ?("Fed. R. Civ. P. 12(b)(6)")
  }
}

decision rule12-ruling: "Ruling on Rule 12 motion" by court cite ?("Fed. R. Civ. P. 12(b)(6), 15(a)(2)")
{
  note "OUTLINE. Dismissal with leave to amend is the usual course on first dismissal (verify circuit practice)."
  edge-rule12-ruling-dismissed "Dismissed with prejudice" -> dismissed-with-prejudice {
    authority cite ?("Fed. R. Civ. P. 41(b)")
  }
  edge-rule12-ruling-leave "Dismissed with leave to amend" -> amendment-filed {
    authority cite ?("Fed. R. Civ. P. 15(a)(2)")
  }
  edge-rule12-ruling-denied "Denied" -> answer-filed {
    authority cite ?("Fed. R. Civ. P. 12(a)(4)(A)")
  }
}

state amendment-filed: "Amended complaint filed" by applicant cite ?("Fed. R. Civ. P. 15(a)(1)")
{
  note "OUTLINE. Amendment as of course has a period (?) after the original pleading or the Rule 12 motion (Rule 15(a)(1)); otherwise leave or consent (Rule 15(a)(2))."
  edge-amendment-filed-response-due "Amended pleading served" -> response-due {
    authority cite ?("Fed. R. Civ. P. 15(a)(3)")
  }
}

state default-request: "Request for entry of default" by applicant cite ?("Fed. R. Civ. P. 55(a)")
{
  note "OUTLINE. Clerk enters default on a showing that the party failed to plead or defend. Verify: Frow v. De La Vega, 82 U.S. 552 (1872) (default with several defendants)."
  edge-default-request-entered "Clerk enters default" -> default-entered {
    authority cite ?("Fed. R. Civ. P. 55(a)")
  }
}

state default-entered: "Default entered" by applicant cite ?("Fed. R. Civ. P. 55(b)")
{
  note "OUTLINE. Default judgment by clerk or court (Rule 55(b)(1)-(2)); a hearing may be needed to fix damages. Setting aside is governed by Rule 55(c)."
  edge-default-entered-judgment "Apply for default judgment" -> default-judgment {
    authority cite ?("Fed. R. Civ. P. 55(b)")
  }
  edge-default-entered-set-aside "Defendant moves to set aside" -> set-aside-ruling {
    authority cite ?("Fed. R. Civ. P. 55(c); 60(b)")
  }
}

decision set-aside-ruling: "Set aside default?" by court cite ?("Fed. R. Civ. P. 55(c)")
{
  note "OUTLINE. Good cause and the Rule 60(b) factors. Verify circuit standard before relying on it. Leading decisions: to be added with circuit cites."
  edge-set-aside-granted "Set aside" -> answer-filed {
    authority cite ?("Fed. R. Civ. P. 55(c)")
  }
  edge-set-aside-refused "Refused" -> default-judgment {
    authority cite ?("Fed. R. Civ. P. 55(c)")
  }
}

state answer-filed: "Answer filed" by applicant cite ?("Fed. R. Civ. P. 8(b), 8(c), 12(a)")
{
  note "OUTLINE. Affirmative defenses are pleaded in the answer (Rule 8(c)). Counterclaims are not modeled here."
  edge-answer-filed-scheduling "Pleadings close" -> scheduling {
    authority cite ?("Fed. R. Civ. P. 26(f); 16(b)")
  }
}

decision scheduling: "Rule 26(f) conference and scheduling order" by office cite ?("Fed. R. Civ. P. 16(b); 26(f)")
{
  note "OUTLINE. Initial disclosure deadline after the conference is a hole (?). OUTLINE. E.D. Ky. local civil rules and the assigned district and magistrate judges' standing orders are NOT verified here (local rule numbers are holes). Check them before any step. The scheduling order controls where it differs from the rules."
  edge-scheduling-discovery "Order entered" -> discovery {
    authority cite ?("Fed. R. Civ. P. 16(b); 26(a)(1)")
  }
  edge-scheduling-settled "Parties settle before discovery" -> settled {
    authority cite ?("Fed. R. Civ. P. 41(a)(1)(A)(ii)")
  }
}

state discovery: "Discovery under Rules 26 to 37" by applicant cite ?("Fed. R. Civ. P. 26(b)(1); 30; 33; 34; 36")
{
  note "OUTLINE. Scope is relevance and proportionality (Rule 26(b)(1)). Discovery period is set by the scheduling order (?). Verify circuit proportionality decisions before relying on them."
  edge-discovery-dispute "Motion to compel or for protective order" -> discovery-dispute {
    authority cite ?("Fed. R. Civ. P. 37(a); 26(c)(1)")
  }
  edge-discovery-sj "Discovery closes; dispositive motion" -> summary-judgment-motion {
    authority cite ?("Fed. R. Civ. P. 56(a)")
  }
  edge-discovery-settled "Settlement reached" -> settled {
    authority cite ?("Fed. R. Civ. P. 41(a)(1)(A)(ii)")
  }
}

decision discovery-dispute: "Discovery motion ruling" by court cite ?("Fed. R. Civ. P. 37(a)(5); 26(c)(1)")
{
  note "OUTLINE. Meet-and-confer is required before the motion (Rule 37(a)(1)); E.D. Ky. local rules may add to it (number ?)."
  edge-discovery-dispute-resolved "Dispute resolved; discovery continues" -> discovery {
    authority cite ?("Fed. R. Civ. P. 37(a)(5)")
  }
  edge-discovery-dispute-sanction "Order violated; sanctions" -> sanction-dismissal {
    authority cite ?("Fed. R. Civ. P. 37(b)(2)(A)")
  }
}

state summary-judgment-motion: "Summary judgment motion" by office cite ?("Fed. R. Civ. P. 56(a)")
{
  note "OUTLINE. Standard (verify): Celotex Corp. v. Catrett, 477 U.S. 317 (1986); Anderson v. Liberty Lobby, Inc., 477 U.S. 242 (1986); Matsushita Elec. Indus. Co. v. Zenith Radio Corp., 475 U.S. 574 (1986). Response and reply periods are holes (?). OUTLINE. E.D. Ky. local civil rules and the assigned district and magistrate judges' standing orders are NOT verified here (local rule numbers are holes). Check them before any step."
  edge-summary-judgment-motion-ruling "Motion briefed" -> sj-ruling {
    authority cite ?("Fed. R. Civ. P. 56(a)")
  }
}

decision sj-ruling: "Summary judgment ruling" by court cite ?("Fed. R. Civ. P. 56(a)")
{
  note "OUTLINE. Partial summary judgment is available under Rule 56(a) (verify circuit practice)."
  edge-sj-ruling-defense "Granted for defendant" -> sj-defense-judgment {
    authority cite ?("Fed. R. Civ. P. 56(a)")
  }
  edge-sj-ruling-applicant "Granted for applicant" -> judgment-for-applicant {
    authority cite ?("Fed. R. Civ. P. 56(a)")
  }
  edge-sj-ruling-denied "Denied" -> pretrial {
    authority cite ?("Fed. R. Civ. P. 56(a)")
  }
}

state pretrial: "Pretrial order and motions in limine" by office cite ?("Fed. R. Civ. P. 16(d)-(e); 26(a)(3)")
{
  note "OUTLINE. Pretrial disclosures and objection periods are holes (?). Daubert review of experts is a motion in limine in most districts (verify under Fed. R. Evid. 702)."
  edge-pretrial-trial-set "Trial set" -> trial-decision {
    authority cite ?("Fed. R. Civ. P. 16(e)")
  }
}

decision trial-decision: "Trial, settlement, or dismissal" by office cite ?("Fed. R. Civ. P. 38(b); 39(a); 41(a)")
{
  note "OUTLINE. A jury demand must be made within the Rule 38(b) period (?). Bench trial is the default absent a demand (Rule 39(a))."
  edge-trial-decision-trial "Trial proceeds" -> trial {
    authority cite ?("Fed. R. Civ. P. 38(b); 39(a)")
  }
  edge-trial-decision-settled "Settled" -> settled {
    authority cite ?("Fed. R. Civ. P. 41(a)(1)(A)(ii)")
  }
  edge-trial-decision-voluntary "Voluntary dismissal" -> voluntary-dismissal {
    authority cite ?("Fed. R. Civ. P. 41(a)(1)(A)(i)")
  }
}

state trial: "Trial" by applicant cite ?("Fed. R. Civ. P. 50(a); 51; 52(a); 39(a)")
{
  note "OUTLINE. Rule 50(a) motion at close of the evidence (period ?). Jury verdict or bench findings follow."
  edge-trial-post-trial "Verdict or findings entered" -> post-trial-decision {
    authority cite ?("Fed. R. Civ. P. 50(b); 52(b); 58")
  }
}

decision post-trial-decision: "Post-trial motions" by court cite ?("Fed. R. Civ. P. 50(b), 52(b), 59, 60(b)")
{
  note "OUTLINE. Renewed motion for judgment as a matter of law, new trial and amendment motions have periods (?) that run from entry of judgment. Verify circuit standards."
  edge-post-trial-denied "Motions denied" -> judgment-entered {
    authority cite ?("Fed. R. Civ. P. 58")
  }
  edge-post-trial-new-trial "New trial ordered" -> trial {
    authority cite ?("Fed. R. Civ. P. 59(a)")
  }
  edge-post-trial-jmol "Judgment as a matter of law for defendant" -> verdict-for-defendant {
    authority cite ?("Fed. R. Civ. P. 50(b)")
  }
}

decision judgment-entered: "Judgment entered" by court cite ?("Fed. R. Civ. P. 54(a), 58")
{
  note "OUTLINE. A separate document is required (Rule 58(a)). Notice of appeal period runs from entry (FRAP 4(a)(1)(A) and 4(a)(4)); see the circuit package."
  edge-judgment-entered-applicant "Judgment for applicant" -> judgment-for-applicant {
    authority cite ?("Fed. R. Civ. P. 58")
  }
  edge-judgment-entered-defense "Judgment for defendant" -> verdict-for-defendant {
    authority cite ?("Fed. R. Civ. P. 58")
  }
}

terminal dismissed-no-service: "Dismissed without prejudice for lack of service" outcome [loss] cite ?("Fed. R. Civ. P. 4(m)")
{
  note "OUTLINE. Dismissal is without prejudice unless the court orders otherwise (verify)."
  payoff ?
}

terminal default-judgment: "Default judgment entered" outcome [win] cite ?("Fed. R. Civ. P. 55(b)")
{
  note "OUTLINE. Damages and relief limits (Rule 54(c)) are holes."
  payoff ?
}

terminal dismissed-with-prejudice: "Dismissed with prejudice" outcome [loss] cite ?("Fed. R. Civ. P. 41(b)")
{
  note "OUTLINE. Dismissal on the merits; appealable under 28 U.S.C. 1291 once final."
  payoff ?
}

terminal sanction-dismissal: "Dismissal as discovery sanction" outcome [loss] cite ?("Fed. R. Civ. P. 37(b)(2)(A)(v)")
{
  note "OUTLINE. Sanction under Rule 37(b)(2)(A)(v) requires a prior order (verify circuit standard)."
  payoff ?
}

terminal sj-defense-judgment: "Summary judgment for defendant" outcome [loss] cite ?("Fed. R. Civ. P. 56(a)")
{
  note "OUTLINE. Appeal runs under FRAP 4(a)(1)(A) from entry of judgment (period ?)."
  payoff ?
}

terminal judgment-for-applicant: "Judgment for applicant" outcome [win] cite ?("Fed. R. Civ. P. 58")
{
  note "OUTLINE. Fee and cost recovery (Rule 54(d)) and any statutory fees are holes."
  payoff ?
}

terminal verdict-for-defendant: "Verdict or judgment for defendant" outcome [loss] cite ?("Fed. R. Civ. P. 58")
{
  note "OUTLINE. Costs under Rule 54(d)(1) are holes."
  payoff ?
}

terminal voluntary-dismissal: "Voluntary dismissal" outcome [neutral] cite ?("Fed. R. Civ. P. 41(a)(1)(A)(i)")
{
  note "OUTLINE. Dismissal by notice before answer or motion; by stipulation otherwise (Rule 41(a)(1)(A)(ii))."
  payoff ?
}

terminal settled: "Settled" outcome [neutral] cite ?("Fed. R. Civ. P. 41(a)(1)(A)(ii)")
{
  note "OUTLINE. Settlement terms and any payment are holes."
  payoff ?
}
