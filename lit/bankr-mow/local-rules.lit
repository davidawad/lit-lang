module bankr-mow-local-rules.local-rules

import core.states.missouri.{ frbp9006-missouri }
import frbp.events.{ OrderForReliefEntered, PetitionFiled }

// The Bankr. W.D. Mo. court's own periods, counted under FRBP 9006(a): the
// Local Rules of Practice and their Appendix. The FRBP periods (schedules,
// claims, discharge, dischargeability, exemptions, the adversary answer
// and summons, appeals) are lit/frbp's and are not declared again.
// Restated national periods are not declared: the 21-day objection notice
// on motions to dismiss or convert (LR 1017-1; FRBP 2002(a)(4)); the
// schedules due 14 days after the order for relief in an involuntary case
// and the other initial documents due 14 days after the petition (LR
// 1007-1(G), Appendix 1-6; FRBP 1007(c)); the 14 days to move on a
// disputed trustee election (LR 2007.1-1; FRBP 2007.1); the 21 days'
// notice of fee applications (LR 2016-2, 2016-3; FRBP 2002(a)(6)) and of a
// claim transfer (LR 3001-1(C); FRBP 3001(e)(2)); the 30-day response to a
// claim objection (LR 3007-1(C); FRBP 3007(a)); the home mortgage notices,
// responses and motions of LR 3094-1(A) (21 days before a payment change,
// 180 days after fees are incurred, one year after their notice, the
// trustee's notice of disbursements and the holder's response; FRBP
// 3002.1); the course certificate 45 days after the first meeting date (LR
// 4004-3; FRBP 5009(b)); the 60-day reaffirmation filing (LR 4008-1(A);
// FRBP 4008(a)); and the 14-day jury demands (LR 9015-1; FRCP 38(b),
// FRBP 9015).
//
// Stated in the rules but not declared: the business-day and clock-time
// periods (first-day hearings within two business days, LR 1002-1; proof
// of insurance within three business days, LR 4070-1; witness lists and
// exhibits three business days before trial, LR 7016-1(D)-(E); a
// continuance motion two business days before the hearing, LR 9060-1(C);
// reaffirmation hardship information 24 hours before the hearing, LR
// 4008-1; pro se emergency petitions with a foreclosure within 24 hours,
// LR 11002-2); the monthly reports due by the 21st day of each month (LR
// 1002-2(C), 2015-2(C)), a day of the month rather than a period; the
// court's, clerk's, trustee's, transcriber's and United States trustee's
// own acts (a stay extension hearing on the next docket after 14 days, LR
// 4001-2(D); at least 7 days' notice of a hearing, LR 9013-1(G); motions
// deemed submitted 21 days after filing, LR 9013-1(F); the United States
// trustee's 60 and 30 days on final and distribution reports, the trustee's
// distribution within 21 days of the order approving the final report and
// its distribution report within 125 days, LR 5009-1; the redacted
// transcript within 31 days and the 90-day access restriction, LR 5007-1);
// the 60-day pretrial period the court generally allows (LR 7016-1(B)); the
// collateral inspection not less than two days before a hearing (LR
// 4002-1(C)), the inspection's own five days being declared; the attorney's
// 30-day hold of case closing fees pending reinstatement (LR 2016-2(F)); the
// one-year bar on a former law clerk's work (LR 2090-1(E)); and amounts
// (the $1,000 subchapter V deposit, LR 1002-2(B); the no-look and case
// closing fees, LR 2016-2). The rules state no page limit.
/// The initial mailing matrix is missing documents or in an incorrect
/// format (LR 1007-1(F)).
event MatrixDeficient()
/// The notice of an amendment adding creditors without knowledge of the
/// case is served (LR 1009-1(B)).
event AmendmentNoticeServed()
/// The first meeting of creditors in a joint case concludes (LR 1015-1).
event FirstMeetingConcluded()
/// The debtor's attorney of record learns of the debtor's death (LR
/// 1016-1).
event DeathLearned()
/// A dismissed case is reinstated after the meeting of creditors was held
/// (LR 1017-1(E)).
event CaseReinstated()
/// The debtor's motion to vacate a dismissal and reinstate or reopen the
/// case is served with its notice (LR 1017-1(E)).
event ReinstatementMotionServed()
/// An order converting a case to chapter 7 is entered (LR 1019-1).
event ConversionOrdered()
/// A notice of a Rule 2004 examination is served (LR 2004-1(A)-(B)).
event ExamNoticeServed()
/// A post-confirmation flat-fee motion of a chapter 13 debtor's attorney is
/// filed (LR 2016-2(F)).
event PostConfirmationFeeMotionFiled()
/// A chapter 13 case is dismissed before confirmation (LR 2016-2(G)).
event PreConfirmationDismissal()
/// The order approving a lease rejection, or the judgment in an avoidance
/// action, becomes final (LR 3002-1(E)).
event RejectionOrderFinal()
/// Final distribution is made under a chapter 11 liquidating plan (LR
/// 3011-1(B)).
event PlanFinalDistribution()
/// A chapter 13 home mortgage modification motion is filed (LR 3082-1(B)).
event ModificationMotionFiled()
/// The final trial home mortgage modification payment is made (LR
/// 3082-1(C)).
event FinalTrialPaymentMade()
/// A chapter 13 plan or amended plan is filed (LR 3083-1(B), (E)).
event Chapter13PlanFiled()
/// The § 341 meeting of creditors in a chapter 13 case concludes (LR
/// 3083-1(D)).
event MeetingConcluded()
/// The chapter 13 trustee's notice of claims after confirmation and the
/// claims deadline is served (LR 3085-1).
event TrusteeClaimsNoticeServed()
/// The initial date of confirmation of the chapter 13 plan (LR 3094-1(A)).
event PlanConfirmed()
/// The court enters an order denying a motion to dismiss on the condition
/// that an amended plan is filed (LR 3096-1(A)-(B)).
event ConditionalDenialEntered()
/// The court enters an order denying confirmation and granting time to file
/// an amended plan (LR 3096-1(D)).
event ConfirmationDenied()
/// A motion for a personal property tax waiver is filed and served on the
/// County Collector (LR 3097-1(B)).
event TaxWaiverMotionServed()
/// The date the debtor proposes to enter into a loan service agreement with
/// a federal agency (LR 4001-1(H)).
event LoanServiceAgreementDate()
/// A movant alleging default under a conditional order granting relief
/// from stay gives the debtor written notice to cure (LR 4001-1(I)).
event ConditionalOrderDefaultNoticed()
/// A motion to extend or impose the automatic stay is served (LR
/// 4001-2(D)).
event StayExtensionMotionServed()
/// The trustee requests information at the § 341 meeting or in writing (LR
/// 4002-1(A)).
event TrusteeInformationRequested()
/// A secured creditor requests to inspect its collateral in preparation for
/// a hearing (LR 4002-1(C)).
event InspectionRequested()
/// A motion to extend the time for a discharge or dischargeability
/// complaint is served (LR 4004-2).
event ExtensionMotionServed()
/// The chapter 12 debtor completes the payments the plan requires (LR
/// 4004-6(C)).
event PlanPaymentsCompleted()
/// A transcript of a court proceeding is filed (LR 5007-1(B)-(C)).
event TranscriptFiled()
/// The trustee serves the Summary and Notice of Proposed Distribution (LR
/// 5009-1(B)).
event DistributionNoticeServed()
/// The notice to an affected creditor of a motion to reopen to add it is
/// served (LR 5010-1).
event ReopenCreditorNoticeServed()
/// An order reopening a case to add a creditor is entered (LR 5010-1(F)).
event ReopenOrdered()
/// A motion to reopen a case closed without a discharge for want of the
/// financial management course certificate is served (LR 5010-1).
event ReopenForDischargeServed()
/// The trustee sells estate property (LR 6004-1(B)).
event SaleMade()
/// The date set for trial (LR 7026-1(A)).
event TrialScheduled()
/// A motion is served (LR 9013-1(C)).
event MotionServed()
/// A motion for summary judgment is filed (LR 9013-1(H)).
event SummaryJudgmentMotionFiled()
/// Suggestions in opposition to a summary judgment motion are filed (LR
/// 9013-1(H)).
event OppositionFiled()
/// A pro se debtor submits initial pleadings electronically through eSR
/// (LR 11002-1).
event ElectronicSubmissionMade()
/// The court orders a pro se filer to show cause and remedy deficient
/// initial filings (LR 11002-1(G), 17004-1).
event ShowCauseOrdered()

/// W.D. Mo. Bankr. L.R. 1002-2(B): no later than seven days after the
/// petition, a subchapter V debtor tenders the deposit to the Subchapter V
/// Trustee.
deadline subchapter-v-deposit-period: 7.days after PetitionFiled() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 1002-2(B)"
/// W.D. Mo. Bankr. L.R. 1007-1(F): if the mailing matrix is missing
/// documents or in an incorrect format, a new verified matrix is submitted
/// within two days from the filing of the case, or the case may be
/// dismissed.
deadline matrix-correction-period: 2.days after MatrixDeficient() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 1007-1(F)"
/// W.D. Mo. Bankr. L.R. Appendix 1-6: if not included with the petition,
/// the List of Creditors is filed within 2 days of case opening, or the case
/// may be dismissed.
deadline creditor-list-period: 2.days after PetitionFiled() counted_by frbp9006-missouri effective [2026-10-01, ..) unknown_before 2026-10-01 cite "W.D. Mo. Bankr. L.R. Appendix 1-6"
/// W.D. Mo. Bankr. L.R. Appendix 1-6: if not included, Form B121 (or the
/// Declaration re electronic filing) is filed within 7 days of case
/// opening.
deadline initial-declaration-period: 7.days after PetitionFiled() counted_by frbp9006-missouri effective [2026-10-01, ..) unknown_before 2026-10-01 cite "W.D. Mo. Bankr. L.R. Appendix 1-6"
/// W.D. Mo. Bankr. L.R. 1009-1(B): if the claims deadline has passed or
/// will pass within 30 days, added creditors without knowledge of the case
/// have 30 days after service of the notice to file claims.
deadline added-creditor-claim-period: 30.days after AmendmentNoticeServed() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 1009-1(B)"
/// W.D. Mo. Bankr. L.R. 1009-1(B): likewise they have 30 days after service
/// of the notice to file § 523 and § 727 complaints.
deadline added-creditor-complaint-period: 30.days after AmendmentNoticeServed() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 1009-1(B)"
/// W.D. Mo. Bankr. L.R. 1015-1: spouses' estates are jointly administered
/// unless the trustee or another party objects within 14 days after the
/// conclusion of the first meeting of creditors.
deadline joint-administration-objection-period: 14.days after FirstMeetingConcluded() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 1015-1"
/// W.D. Mo. Bankr. L.R. 1016-1: the debtor's attorney of record files a
/// suggestion of death within 30 days of learning of the debtor's death.
deadline suggestion-of-death-period: 30.days after DeathLearned() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 1016-1"
/// W.D. Mo. Bankr. L.R. 1017-1(E): if the meeting of creditors was already
/// held, the proof of claim deadline in a reinstated case is set sixty days
/// from the date of reinstatement.
deadline reinstated-claim-period: 60.days after CaseReinstated() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 1017-1(E)"
/// W.D. Mo. Bankr. L.R. 1017-1(E): the motion to vacate a dismissal and
/// reinstate is served with a notice that recipients have 21 days to
/// object.
deadline reinstatement-objection-period: 21.days after ReinstatementMotionServed() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 1017-1(E)"
/// W.D. Mo. Bankr. L.R. 1019-1: in a case converted to chapter 7, the debtor
/// files verified schedules and a statement of financial affairs correct as
/// of conversion not later than fourteen days after the order of
/// conversion.
deadline conversion-schedules-period: 14.days after ConversionOrdered() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 1019-1"
/// W.D. Mo. Bankr. L.R. 2004-1(B): an objection to an examination under
/// notice is filed within 7 days.
deadline exam-objection-period: 7.days after ExamNoticeServed() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 2004-1(B)"
/// W.D. Mo. Bankr. L.R. 2016-2(F): a chapter 13 debtor's attorney's
/// post-confirmation flat-fee motion is served with 21 days after filing to
/// object.
deadline post-confirmation-fee-objection-period: 21.days after PostConfirmationFeeMotionFiled() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 2016-2(F)"
/// W.D. Mo. Bankr. L.R. 2016-2(G): on dismissal before confirmation, the
/// debtor's attorney obtains payment from funds the trustee received only
/// by an order on a motion filed within 14 days of the dismissal.
deadline dismissal-fee-motion-period: 14.days after PreConfirmationDismissal() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 2016-2(G)"
/// W.D. Mo. Bankr. L.R. 3002-1(E): a claim arising from the rejection of a
/// lease or an avoidance action is filed by the later of the claims bar date
/// and thirty days after the order or judgment becomes final.
deadline rejection-claim-period: 30.days after RejectionOrderFinal() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 3002-1(E)"
/// W.D. Mo. Bankr. L.R. 3011-1(B): unless the plan provides otherwise, the
/// disbursing agent under a chapter 11 liquidating plan pays into the Court
/// Registry funds left unclaimed 120 calendar days after the final
/// distribution.
deadline liquidating-plan-unclaimed-funds-period: 120.days after PlanFinalDistribution() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 3011-1(B)"
/// W.D. Mo. Bankr. L.R. 3016-1: unless the Code or an order requires
/// otherwise, a chapter 11 debtor (other than under subchapter V) files a
/// plan and disclosure statement within 120 days after the petition, and
/// moves to extend before the 120 days expire.
deadline chapter11-plan-period: 120.days after PetitionFiled() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 3016-1"
/// W.D. Mo. Bankr. L.R. 3082-1(B): objections to a home mortgage
/// modification motion are due 7 days after it is filed; without a response
/// the court enters an order granting it.
deadline modification-objection-period: 7.days after ModificationMotionFiled() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 3082-1(B)"
/// W.D. Mo. Bankr. L.R. 3082-1(C): absent an order to the contrary, the
/// debtor has 60 days from the final trial modification payment to finalize
/// the home mortgage modification.
deadline modification-finalization-period: 60.days after FinalTrialPaymentMade() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 3082-1(C)"
/// W.D. Mo. Bankr. L.R. 3083-1(B): the debtor files a certificate of service
/// of a chapter 13 plan or amended plan within three days after it is filed;
/// otherwise the plan is not considered for confirmation.
deadline plan-service-certificate-period: 3.days after Chapter13PlanFiled() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 3083-1(B)"
/// W.D. Mo. Bankr. L.R. 3083-1(D): unless otherwise noticed, objections to
/// confirmation of a chapter 13 plan are filed within 21 days after the
/// conclusion of the § 341 meeting.
deadline confirmation-objection-period: 21.days after MeetingConcluded() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 3083-1(D)"
/// W.D. Mo. Bankr. L.R. 3083-1(E): objections to an amended plan are filed
/// on or before 21 days after it is filed and served.
deadline amended-plan-objection-period: 21.days after Chapter13PlanFiled() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 3083-1(E)"
/// W.D. Mo. Bankr. L.R. 3085-1: the trustee distributes on the claims notice
/// unless, within 30 days, the debtor or a creditor files and serves an
/// objection to a claim listed in it.
deadline trustee-claims-notice-objection-period: 30.days after TrusteeClaimsNoticeServed() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 3085-1"
/// W.D. Mo. Bankr. L.R. 3094-1(A): a party contending the payee record
/// misstates the mortgage amount due files an objection within 30 days of
/// the initial date of confirmation.
deadline payee-record-objection-period: 30.days after PlanConfirmed() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 3094-1(A)"
/// W.D. Mo. Bankr. L.R. 3096-1(A)-(B): where a response to a motion to
/// dismiss recites an amended plan (and motion to suspend), the motion is
/// denied on condition the amended plan is filed within 21 days.
deadline conditional-amended-plan-period: 21.days after ConditionalDenialEntered() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 3096-1(A)"
/// W.D. Mo. Bankr. L.R. 3096-1(D): where a response to a motion to deny
/// confirmation recites an amended plan, the court denies confirmation and
/// grants the debtor 21 days to file it.
deadline denied-confirmation-amended-plan-period: 21.days after ConfirmationDenied() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 3096-1(D)"
/// W.D. Mo. Bankr. L.R. 3097-1(B): objections to a personal property tax
/// waiver motion are due 5 days after it is filed and served on the County
/// Collector.
deadline tax-waiver-objection-period: 5.days after TaxWaiverMotionServed() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 3097-1(B)"
/// W.D. Mo. Bankr. L.R. 4001-1(H): the debtor files and serves on all
/// creditors a Notice of Intent to Enter into Loan Service Agreement at
/// least 21 days before entering into it.
deadline loan-service-notice-period: 21.days before LoanServiceAgreementDate() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 4001-1(H)"
/// W.D. Mo. Bankr. L.R. 4001-1(I): a movant alleging default under a
/// conditional order granting stay relief gives the debtor 10 days written
/// notice to cure before submitting a final order.
deadline conditional-order-cure-period: 10.days after ConditionalOrderDefaultNoticed() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 4001-1(I)"
/// W.D. Mo. Bankr. L.R. 4001-2(D): unless otherwise ordered, an objection to
/// a motion to extend or impose the automatic stay is filed within 14 days
/// after its service.
deadline stay-extension-objection-period: 14.days after StayExtensionMotionServed() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 4001-2(D)"
/// W.D. Mo. Bankr. L.R. 4001-3(B): in chapter 7 and 13 cases the stay is
/// modified 45 days after the order for relief to let the IRS offset
/// prepetition tax debts, unless the debtor or a party in interest objects
/// within the 45-day period and requests a hearing.
deadline irs-setoff-objection-period: 45.days after OrderForReliefEntered() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 4001-3(B)"
/// W.D. Mo. Bankr. L.R. 4002-1(A): within 14 days after the trustee requests
/// information at the § 341 meeting or in writing, the debtor serves the
/// information or files and serves an objection.
deadline trustee-request-response-period: 14.days after TrusteeInformationRequested() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 4002-1(A)"
/// W.D. Mo. Bankr. L.R. 4002-1(C): a secured creditor's request to inspect
/// collateral in preparation for a hearing is granted within five days of
/// the request.
deadline collateral-inspection-period: 5.days after InspectionRequested() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 4002-1(C)"
/// W.D. Mo. Bankr. L.R. 4004-2: a hearing on a motion to extend the time for
/// a discharge or dischargeability complaint is held if the debtor objects
/// or requests a hearing within 21 days after its service.
deadline extension-motion-objection-period: 21.days after ExtensionMotionServed() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 4004-2"
/// W.D. Mo. Bankr. L.R. 4004-6(C): if no motion for entry of a chapter 12
/// discharge is filed within 60 days after the plan payments are completed,
/// the case may be closed without a discharge.
deadline chapter12-discharge-motion-period: 60.days after PlanPaymentsCompleted() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 4004-6(C)"
/// W.D. Mo. Bankr. L.R. 5007-1(B): attorneys and pro se parties who
/// attended the hearing have 7 days to file a Notice of Intent to Request
/// Redaction.
deadline redaction-intent-period: 7.days after TranscriptFiled() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 5007-1(B)"
/// W.D. Mo. Bankr. L.R. 5007-1(C): a party that filed the notice serves its
/// Request for Redaction on the transcriber within 21 calendar days from
/// the filing of the transcript.
deadline redaction-request-period: 21.days after TranscriptFiled() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 5007-1(C)"
/// W.D. Mo. Bankr. L.R. 5009-1(B): creditors and parties in interest have 21
/// days after service of the Summary and Notice of Proposed Distribution to
/// object to a chapter 7 trustee's final report.
deadline final-report-objection-period: 21.days after DistributionNoticeServed() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 5009-1(B)"
/// W.D. Mo. Bankr. L.R. 5010-1(D): on a motion to reopen to add a creditor,
/// the notice tells the affected creditor it must object within 30 days
/// after service, after which the case is reclosed.
deadline reopen-creditor-objection-period: 30.days after ReopenCreditorNoticeServed() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 5010-1(D)"
/// W.D. Mo. Bankr. L.R. 5010-1(F): within 30 days after the order reopening
/// a case to add a creditor, a creditor objecting to its addition or to the
/// dischargeability of its debt files its objection or complaint.
deadline reopened-creditor-complaint-period: 30.days after ReopenOrdered() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 5010-1(F)"
/// W.D. Mo. Bankr. L.R. 5010-1(D): on a motion to reopen a case closed
/// without a discharge for want of the financial management course, all
/// creditors are served and given 21 days to object (LR 4004-3, 4004-4,
/// 4004-6).
deadline reopen-for-discharge-objection-period: 21.days after ReopenForDischargeServed() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 5010-1(D)"
/// W.D. Mo. Bankr. L.R. 6004-1(B): within 14 days after a sale, the trustee
/// files a report of sale.
deadline report-of-sale-period: 14.days after SaleMade() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 6004-1(B)"
/// W.D. Mo. Bankr. L.R. 7026-1(A): unless otherwise ordered, discovery in an
/// adversary proceeding is completed 14 days prior to trial.
deadline discovery-completion-period: 14.days before TrialScheduled() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 7026-1(A)"
/// W.D. Mo. Bankr. L.R. 9013-1(C): unless the rules or an order provide
/// otherwise, the respondent files its response, memorandum and supporting
/// documents within 21 days after service of the motion.
deadline motion-response-period: 21.days after MotionServed() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 9013-1(C)"
/// W.D. Mo. Bankr. L.R. 9013-1(H)(4): suggestions in opposition to a motion
/// for summary judgment are filed within 21 days of its filing.
deadline summary-judgment-opposition-period: 21.days after SummaryJudgmentMotionFiled() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 9013-1(H)"
/// W.D. Mo. Bankr. L.R. 9013-1(H)(4): a reply, if any, is filed within 14
/// days of the filing of the suggestions in opposition.
deadline summary-judgment-reply-period: 14.days after OppositionFiled() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 9013-1(H)"
/// W.D. Mo. Bankr. L.R. 11002-1: a pro se case submitted electronically
/// through eSR opens only when the required signed documents are received
/// within 14 days of the electronic submission.
deadline signed-documents-period: 14.days after ElectronicSubmissionMade() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 11002-1"
/// W.D. Mo. Bankr. L.R. 11002-1(G): on an order to show cause the pro se
/// debtor remedies deficient initial filings within 14 days (two days for a
/// mailing matrix), or the case may be dismissed (also LR 17004-1).
deadline pro-se-deficiency-cure-period: 14.days after ShowCauseOrdered() counted_by frbp9006-missouri cite "W.D. Mo. Bankr. L.R. 11002-1(G)"

start motion-filed

state motion-filed: "Motion filed and served" by applicant cite "W.D. Mo. Bankr. L.R. 9013-1(C)"
{
  note "Unless the rules or an order provide otherwise, the respondent files its response, memorandum and supporting documents within 21 days after service (LR 9013-1(C)); court-noticed motions are heard only if a response is filed within the 14-day deadline the court sets, and motions held for response wait 21 days, or 30 for claim objections and reopenings to add creditors (LR 9060-1(G), (I)). The motion's FRBP periods are lit/frbp's."
  edge-motion-filed-response "Response filed" -> responded {
    authority cite "W.D. Mo. Bankr. L.R. 9013-1(C)"
  }
  edge-motion-filed-unopposed "No timely response: deemed submitted after 21 days" -> ruling {
    authority cite "W.D. Mo. Bankr. L.R. 9013-1(F)"
  }
}

state responded: "Response filed; motion submitted" by opponent cite "W.D. Mo. Bankr. L.R. 9013-1(F)"
{
  note "A motion is deemed submitted on the date the response is filed; the court gives at least 7 days' notice of any hearing if practicable (LR 9013-1(F)-(G))."
  edge-responded-hearing "Hearing or submission on the papers" -> ruling {
    authority cite "W.D. Mo. Bankr. L.R. 9013-1(G)"
  }
}

decision ruling: "Motion decided" by court cite "W.D. Mo. Bankr. L.R. 9013-1(F)"
{
  note "A respondent's failure to respond timely waives the right to file a response (LR 9013-1(E))."
  edge-ruling-granted "Granted" -> decided { authority cite "W.D. Mo. Bankr. L.R. 9013-1(E)" }
  edge-ruling-denied "Denied" -> decided { authority cite "W.D. Mo. Bankr. L.R. 9013-1(F)" }
}

terminal decided: "Matter decided: the case continues under lit/frbp" outcome [procedural] cite "W.D. Mo. Bankr. L.R. 1001-1(A)"
{
  note "The Local Rules of Practice govern practice in the court (LR 1001-1(A))."
}

test "Deadline arithmetic: subchapter-v-deposit-period (7 days after)" cite "W.D. Mo. Bankr. L.R. 1002-2(B)"
{
  given PetitionFiled() on 2027-01-04
  expect deadline(subchapter-v-deposit-period) == 2027-01-11
}

