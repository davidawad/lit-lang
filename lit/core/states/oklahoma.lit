module core.states.oklahoma

import core.calendar.{ us-federal-holidays }
import core.time.{ Scheduled, Served }

/// Oklahoma's day after Thanksgiving is a state legal holiday (25 O.S.
/// § 82.1(A)). The statute's amendment history does not show when the day
/// after Thanksgiving was added. The vendored 2022 Title 25 text is the
/// earliest dated evidence used here, so dates are effective from 2022-05-01.
/// The engine has no offset calendar rule, so list each date through 2050.
calendar oklahoma-holidays cite "25 O.S. § 82.1"
{
  day-after-thanksgiving-2022: once(2022-11-25) effective [2022-05-01, ..)
  day-after-thanksgiving-2023: once(2023-11-24) effective [2022-05-01, ..)
  day-after-thanksgiving-2024: once(2024-11-29) effective [2022-05-01, ..)
  day-after-thanksgiving-2025: once(2025-11-28) effective [2022-05-01, ..)
  day-after-thanksgiving-2026: once(2026-11-27) effective [2022-05-01, ..)
  day-after-thanksgiving-2027: once(2027-11-26) effective [2022-05-01, ..)
  day-after-thanksgiving-2028: once(2028-11-24) effective [2022-05-01, ..)
  day-after-thanksgiving-2029: once(2029-11-23) effective [2022-05-01, ..)
  day-after-thanksgiving-2030: once(2030-11-29) effective [2022-05-01, ..)
  day-after-thanksgiving-2031: once(2031-11-28) effective [2022-05-01, ..)
  day-after-thanksgiving-2032: once(2032-11-26) effective [2022-05-01, ..)
  day-after-thanksgiving-2033: once(2033-11-25) effective [2022-05-01, ..)
  day-after-thanksgiving-2034: once(2034-11-24) effective [2022-05-01, ..)
  day-after-thanksgiving-2035: once(2035-11-23) effective [2022-05-01, ..)
  day-after-thanksgiving-2036: once(2036-11-28) effective [2022-05-01, ..)
  day-after-thanksgiving-2037: once(2037-11-27) effective [2022-05-01, ..)
  day-after-thanksgiving-2038: once(2038-11-26) effective [2022-05-01, ..)
  day-after-thanksgiving-2039: once(2039-11-25) effective [2022-05-01, ..)
  day-after-thanksgiving-2040: once(2040-11-23) effective [2022-05-01, ..)
  day-after-thanksgiving-2041: once(2041-11-29) effective [2022-05-01, ..)
  day-after-thanksgiving-2042: once(2042-11-28) effective [2022-05-01, ..)
  day-after-thanksgiving-2043: once(2043-11-27) effective [2022-05-01, ..)
  day-after-thanksgiving-2044: once(2044-11-25) effective [2022-05-01, ..)
  day-after-thanksgiving-2045: once(2045-11-24) effective [2022-05-01, ..)
  day-after-thanksgiving-2046: once(2046-11-23) effective [2022-05-01, ..)
  day-after-thanksgiving-2047: once(2047-11-29) effective [2022-05-01, ..)
  day-after-thanksgiving-2048: once(2048-11-27) effective [2022-05-01, ..)
  day-after-thanksgiving-2049: once(2049-11-26) effective [2022-05-01, ..)
  day-after-thanksgiving-2050: once(2050-11-25) effective [2022-05-01, ..)
}

/// FRBP 9006(a) in Oklahoma bankruptcy courts, with the state's declared
/// holidays as required by 9006(a)(6)(C). The Western District local-rule
/// package uses this rule for its own periods and recounts lit/frbp.
counting frbp9006-oklahoma effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays oklahoma-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-okw]
  allow_hours
  end_of_month clamp
}

// Core-local clock fixtures for the Oklahoma forward-only state holiday.
deadline oklahoma-forward-personal: 1.days after Served(Personal) counted_by frbp9006-oklahoma {
  forum bankr-okw
}

deadline oklahoma-backward: 1.days before Scheduled() counted_by frbp9006-oklahoma {
  forum bankr-okw
}

deadline oklahoma-forward-electronic: 1.days after Served(Electronic) counted_by frbp9006-oklahoma {
  forum bankr-okw
}

test "Oklahoma day after Thanksgiving closes a forward period" cite "FRBP 9006(a)(6)(C)"
{
  given Served(Personal) on 2030-11-28
  expect deadline(oklahoma-forward-personal).nominal == 2030-11-29
  expect deadline(oklahoma-forward-personal) == 2030-12-02
}

test "Oklahoma fourth Friday is not a state holiday" cite "FRBP 9006(a)(6)(C)"
{
  given Served(Personal) on 2030-11-21
  expect deadline(oklahoma-forward-personal) == 2030-11-22
}

test "Oklahoma day after Thanksgiving closes a forward period in 2027" cite "FRBP 9006(a)(6)(C)"
{
  given Served(Personal) on 2027-11-25
  expect deadline(oklahoma-forward-personal) == 2027-11-29
}

test "Oklahoma state holiday is ignored in a backward count" cite "FRBP 9006(a)(5)"
{
  given Scheduled() on 2030-11-30
  expect deadline(oklahoma-backward) == 2030-11-29
}

test "electronic service starts the count on the next day" cite "FRBP 9006(a)(1)(A)"
{
  given Served(Electronic) on 2030-11-18
  expect deadline(oklahoma-forward-electronic) == 2030-11-19
}
