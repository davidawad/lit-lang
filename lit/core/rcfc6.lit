module core.rcfc6

import core.calendar.{ rcfc-legal-holidays }
import core.time.{ Served, Scheduled, ServiceMethod }

/// RCFC 6 as revised and reissued May 1, 2002 "to conform to FRCP 6" (2002
/// Revision note), so the FRCP 6 of the day: periods under 11 days skip
/// weekends and legal holidays; mail, leaving with the clerk, and other
/// consented means add 3 days (conformed to FRCP 6(e) in 2006). The 2008
/// amendment restyled it.
counting rcfc6 effective [2002-05-01, 2010-01-11) known_at 2002-05-01 cite "RCFC 6 (2002 Revision note)" historical
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  short_period { below: 11.days, count: business_days }
  service_extension {
    Personal: 0.days
    Electronic: unrecognized
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "RCFC 6 (2006 Amendment note)"
  holidays rcfc-legal-holidays
  forums [cofc]
}

/// RCFC 6 as amended January 11, 2010 "in accordance with the corresponding
/// changes to FRCP 6 that became effective December 1, 2009" (2010
/// Amendment note): every day counts, hours periods, and the clerk's
/// office inaccessibility rule (6(a)(3)). Its legal holidays add
/// Inauguration Day (6(a)(6)(A)). 6(d) then followed FRCP 6(d) of 2009,
/// whose 3 days followed electronic service too. RCFC 6, like FRCP 6, is
/// silent on periods stated in months or years; it counts them as the
/// Patent Office does (MPEP 710.01(a)): to the corresponding day of the
/// later month, else that month's last day. UNVERIFIED: whether the 2002
/// RCFC added days after electronic service; that version does not
/// recognize it.
counting rcfc6 effective [2010-01-11, 2017-08-01) known_at 2010-01-11 supersedes rcfc6@2002-05-01 cite "RCFC 6 (2010 Amendment note)" historical
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 3.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "RCFC 6 (2010 Amendment note)"
  holidays rcfc-legal-holidays
  forums [cofc]
  allow_hours
  end_of_month clamp
}

/// RCFC 6(d) as amended August 1, 2017 "in accordance with the
/// corresponding change to FRCP 6 that became effective December 1, 2016"
/// (2017 Amendment note): the 3 days follow service "under RCFC 5(b)(2)(C)
/// (mail), (D) (leaving with the clerk), or (F) (other means consented
/// to)" only, so electronic service adds nothing.
counting rcfc6 effective [2017-08-01, 2024-07-29) known_at 2017-08-01 supersedes rcfc6@2010-01-11 cite "RCFC 6 (2017 Amendment note)" historical
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "RCFC 6 (2017 Amendment note)"
  holidays rcfc-legal-holidays
  forums [cofc]
  allow_hours
  end_of_month clamp
}

/// RCFC 6 as last amended July 29, 2024 (its credits). The 2024 Amendment
/// note records that 6(a)(6) added Juneteenth National Independence Day in
/// 2022 as an administrative amendment. The count is unchanged:
/// `rcfc-legal-holidays` has observed it since June 17, 2021, when
/// Congress declared it a holiday.
counting rcfc6 effective [2024-07-29, ..) known_at 2024-07-29 supersedes rcfc6@2017-08-01 cite "RCFC 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "RCFC 6(d)"
  holidays rcfc-legal-holidays
  forums [cofc]
  allow_hours
  end_of_month clamp
}

// Fixtures cite nothing: they are periods for the tests, not rules in
// force, and each test cites the rule it checks.
deadline rcfc6-1-day: 1.days after Served() counted_by rcfc6 { forum cofc }
deadline rcfc6-10-days: 10.days after Served() counted_by rcfc6 { forum cofc }
deadline rcfc6-14-days: 14.days after Served() counted_by rcfc6 { forum cofc }
deadline rcfc6-26-days: 26.days after Served() counted_by rcfc6 { forum cofc }
deadline rcfc6-2-days-before: 2.days before Scheduled() counted_by rcfc6 { forum cofc }

test "an ordinary fourteen-day period matches FRCP 6" cite "RCFC 6(a)(1)"
{
  given Served(Personal) on 2026-07-01
  expect deadline(rcfc6-14-days) == 2026-07-15
}

test "mail adds three days, as under FRCP 6(d)" cite "RCFC 6(d)"
{
  given Served(Mail) on 2026-07-20
  expect deadline(rcfc6-14-days) == 2026-08-06
}

test "a Saturday last day rolls to Monday, then three days end Thursday" cite "RCFC 6(d)"
{
  given Served(Mail) on 2026-01-05
  expect deadline(rcfc6-26-days) == 2026-02-05
}

test "backward onto Saturday rolls to Friday" cite "RCFC 6(a)(5)"
{
  given Scheduled() on 2026-07-27
  expect deadline(rcfc6-2-days-before) == 2026-07-24
}

test "Inauguration Day 2029 falls on Saturday and is observed Friday" cite "RCFC 6(a)(6)(A)"
{
  given Served(Personal) on 2029-01-18
  expect deadline(rcfc6-1-day) == 2029-01-22
}

test "Inauguration Day 2021 was a Wednesday holiday" cite "RCFC 6(a)(6)(A)"
{
  given Served(Personal) on 2021-01-19
  expect deadline(rcfc6-1-day) == 2021-01-21
}

test "January 20, 2026 is not an inauguration year" cite "RCFC 6(a)(6)(A)"
{
  given Served(Personal) on 2026-01-19
  expect deadline(rcfc6-1-day) == 2026-01-20
}

test "January 20, 2027 is not an inauguration year" cite "RCFC 6(a)(6)(A)"
{
  given Served(Personal) on 2027-01-19
  expect deadline(rcfc6-1-day) == 2027-01-20
}

test "the Court of Federal Claims kept the 11-day rule until January 11, 2010" cite "RCFC 6 (2010 Amendment note)"
{
  given Served(Personal) on 2009-12-04
  expect deadline(rcfc6-10-days) == 2009-12-18
}

test "from January 11, 2010, ten days count every day" cite "RCFC 6(a)(1)(B)"
{
  given Served(Personal) on 2010-01-15
  expect deadline(rcfc6-10-days) == 2010-01-25
}
