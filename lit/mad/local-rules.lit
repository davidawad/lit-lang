{
  given ObjectionOverruled() on 2026-11-02
  expect deadline(answer-after-objection-period) == 2026-11-16
}

test "admission after objection period: 14 days after the trigger" cite "D. Mass. L.R. 36.1(b)"
{
  given ObjectionOverruled() on 2026-11-02
  expect deadline(admission-after-objection-period) == 2026-11-16
}

test "medical disclosure period: 14 days after the trigger" cite "D. Mass. L.R. 35.1(a)"
{
  given IssueJoined() on 2026-11-02
  expect deadline(medical-disclosure-period) == 2026-11-16
}

test "removed medical disclosure period: 21 days after the trigger" cite "D. Mass. L.R. 35.1(c)"
{
  given RemovedOrTransferred() on 2026-11-02
  expect deadline(removed-medical-disclosure-period) == 2026-11-23
}

test "discovery conference response period: 7 days after the trigger" cite "D. Mass. L.R. 37.1(a)"
{
  given DiscoveryConferenceRequested() on 2026-11-02
  expect deadline(discovery-conference-response-period) == 2026-11-09
}

test "discovery conference period: 14 days after the trigger" cite "D. Mass. L.R. 37.1(b)"
{
  given DiscoveryConferenceRequested() on 2026-11-02
  expect deadline(discovery-conference-period) == 2026-11-16
}

test "discovery motion response period: 14 days after the trigger" cite "D. Mass. L.R. 37.1(c)"
{
  given DiscoveryMotionServed() on 2026-11-02
  expect deadline(discovery-motion-response-period) == 2026-11-16
}

test "prosecution explanation period: 28 days after the trigger" cite "D. Mass. L.R. 41.1(a)"
{
  given ProsecutionNoticeServed() on 2026-11-02
  expect deadline(prosecution-explanation-period) == 2026-11-30
}

