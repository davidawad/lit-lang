module frap.appeal-periods

import core.frap26.{ frap26 }
import frap.events.{ AppealExtensionMoved, EnteredBelow, NoticeOfAppealFiled }

// The FRAP 4(a) civil appeal periods, in one module so that the
// cross-appeal period can name the notice-of-appeal period it may not end
// before (FRAP 4(a)(3)) while the notice and docketing modules, which
// route into each other, both use them.
/// FRAP 4(a)(1) and 4(a)(3) before the 2009 amendments, as the 2008
/// edition of 28 U.S.C. App. prints them: the same 30, 60 and 14 days and
/// the same FRAP 4(a)(5) grant, except that no extension "may exceed 30
/// days after the prescribed time or 10 days after the date when the order
/// granting the motion is entered, whichever is later" (4(a)(5)(C)). In
/// force from December 1, 2002, when 4(a)(5)(A)(ii) took the text that
/// edition prints: before it most circuits read good cause as reaching
/// only a motion made before expiry (2002 Committee Note), so earlier law
/// is not declared. The 2005 amendment touched only 4(a)(6). FRAP 26(a)(2)
/// then left weekends and legal holidays out of a period under 11 days, so
/// the order's 10 days ran past 10 calendar days; a bound counts calendar
/// days, so this one is never later than the rule's: an extension it
/// allows the rule allowed, and one to a later day inside the FRAP
/// 26(a)(2) count is refused (UNVERIFIED for those days, the direction
/// that never accepts an untimely notice).
rule duty civil-notice-of-appeal effective [2002-12-01, 2009-12-01) known_at 2002-04-29 cite "FRAP (2008 ed.) 4(a)(1)"
{
  deadline notice-civil-period: 30.days after EnteredBelow() counted_by frap26 cite "FRAP (2008 ed.) 4(a)(1)(A)"
  {
    trigger latest
    extend {
      by court
      discretion GoodCauseOrExcusableNeglect
      to max(prescribed_due + 30.days, grant_order_entered + 10.days)
      after_expiry
      on AppealExtensionMoved()
      within prescribed_due + 30.days
    }
    extend { never cite "FRAP (2008 ed.) 26(b)(1)" }
  }
  deadline notice-us-party-period: 60.days after EnteredBelow() counted_by frap26 cite "FRAP (2008 ed.) 4(a)(1)(B)"
  {
    extend {
      by court
      discretion GoodCauseOrExcusableNeglect
      to max(prescribed_due + 30.days, grant_order_entered + 10.days)
      after_expiry
      on AppealExtensionMoved()
      within prescribed_due + 30.days
    }
    extend { never cite "FRAP (2008 ed.) 26(b)(1)" }
  }
}

/// The pre-2009 FRAP 4(a)(3) (2008 edition): the same "whichever period
/// ends later" and the pre-2009 FRAP 4(a)(5) grant above.
rule duty cross-appeal effective [2002-12-01, 2009-12-01) known_at 2002-04-29 cite "FRAP (2008 ed.) 4(a)(3)"
{
  deadline cross-appeal-period: 14.days after NoticeOfAppealFiled() counted_by frap26 cite "FRAP (2008 ed.) 4(a)(3)"
  {
    trigger later_of(notice-civil-period)
    extend {
      by court
      discretion GoodCauseOrExcusableNeglect
      to max(prescribed_due + 30.days, grant_order_entered + 10.days)
      after_expiry
      on AppealExtensionMoved()
      within prescribed_due + 30.days
    }
    extend { never cite "FRAP (2008 ed.) 26(b)(1)" }
  }
}

/// FRAP 4(a)(1): a civil appeal as of right is taken by a notice filed
/// within 30 days after entry of the judgment or order appealed from (60
/// when the United States, its agency, or its officer or employee is a
/// party). Both mirror 28 U.S.C. § 2107(a)-(b) and are jurisdictional
/// (Bowles v. Russell, 551 U.S. 205 (2007)). The periods are counted from
/// the latest entry, so the order disposing of the last FRAP 4(a)(4)(A)
/// motion restarts them. Being statutory, no order displaces them, so
/// they delegate nothing: the court's only power over them is the
/// statute's own, to extend (FRAP 4(a)(5)(A); 28 U.S.C. § 2107(c)) or
/// reopen (FRAP 4(a)(6)), and FRAP 26(b)(1) forbids any extension Rule 4
/// does not authorize. The FRAP 4(a)(5) grant is
/// exact: on motion filed no later than 30 days after the prescribed time
/// expires (4(a)(5)(A)(i)), for excusable neglect or good cause either
/// side of expiry (4(a)(5)(A)(ii)), to no later than 30 days after the
/// prescribed time or 14 days after the order, whichever is later
/// (4(a)(5)(C)); FRAP 26(b)(1) locks out any other.
///
/// In force from the package's start, the 2009 time-computation amendments,
/// which kept 30-day and longer periods unchanged (FRAP 26, 2009 Committee
/// Note) and lengthened 4(a)(5)(C)'s 10 days to 14 (2011 edition of 28
/// U.S.C. App., 2009 Committee Note).
rule duty civil-notice-of-appeal effective [2009-12-01, ..) known_at 2009-03-26 supersedes civil-notice-of-appeal@2002-12-01 cite "FRAP 4(a)(1)"
{
  deadline notice-civil-period: 30.days after EnteredBelow() counted_by frap26 cite "28 U.S.C. § 2107(a)"
  {
    trigger latest
    extend {
      by court
      discretion GoodCauseOrExcusableNeglect
      to max(prescribed_due + 30.days, grant_order_entered + 14.days)
      after_expiry
      on AppealExtensionMoved()
      within prescribed_due + 30.days
    }
    extend { never cite "FRAP 26(b)(1)" }
  }
  deadline notice-us-party-period: 60.days after EnteredBelow() counted_by frap26 cite "28 U.S.C. § 2107(b)"
  {
    extend {
      by court
      discretion GoodCauseOrExcusableNeglect
      to max(prescribed_due + 30.days, grant_order_entered + 14.days)
      after_expiry
      on AppealExtensionMoved()
      within prescribed_due + 30.days
    }
    extend { never cite "FRAP 26(b)(1)" }
  }
}

/// FRAP 4(a)(3): once one party files a timely notice of appeal, any
/// other party may file one "within 14 days after the date when the first
/// notice was filed, or within the time otherwise prescribed by this Rule
/// 4(a), whichever period ends later". `later_of` absorbs the open
/// `notice-civil-period` instance, so the due date is never before it
/// (SPEC §5.3); where the United States is a party, its 60-day period is
/// not the floor, so the date is the earlier, never a later one. A matter
/// records only the first notice as `NoticeOfAppealFiled`. The district
/// court's power to extend "the time to file a notice of appeal" (FRAP
/// 4(a)(5)(A)) reaches a cross-appeal notice (and 4(a)(5)(B) names
/// 4(a)(3)), so the period carries the notice of appeal's FRAP 4(a)(5)
/// grant and FRAP 26(b)(1) lock and, like it, delegates nothing.
rule duty cross-appeal effective [2009-12-01, ..) known_at 2009-03-26 supersedes cross-appeal@2002-12-01 cite "FRAP 4(a)(3)"
{
  deadline cross-appeal-period: 14.days after NoticeOfAppealFiled() counted_by frap26 cite "FRAP 4(a)(3)"
  {
    trigger later_of(notice-civil-period)
    extend {
      by court
      discretion GoodCauseOrExcusableNeglect
      to max(prescribed_due + 30.days, grant_order_entered + 14.days)
      after_expiry
      on AppealExtensionMoved()
      within prescribed_due + 30.days
    }
    extend { never cite "FRAP 26(b)(1)" }
  }
}

test "a civil notice of appeal is due 30 days after entry" cite "FRAP 4(a)(1)(A)"
{
  given EnteredBelow(FinalJudgment) on 2025-03-03
  expect deadline(notice-civil-period) == 2025-04-02
}

test "a 30th day on Independence Day rolls to Monday" cite "FRAP 26(a)(1)(C)"
{
  given EnteredBelow(FinalJudgment) on 2025-06-04
  expect deadline(notice-civil-period) == 2025-07-07
}

test "the order disposing of a tolling motion restarts the period" cite "FRAP 4(a)(4)(A)"
{
  given EnteredBelow(FinalJudgment) on 2025-03-03
  given EnteredBelow(TollingDisposition) on 2025-04-14
  expect deadline(notice-civil-period) == 2025-05-14
}

test "a United States party has 60 days" cite "FRAP 4(a)(1)(B)"
{
  given EnteredBelow(FinalJudgment) on 2025-03-03
  expect deadline(notice-us-party-period) == 2025-05-02
}

test "a 60th day on a Saturday rolls to Monday" cite "FRAP 26(a)(1)(C)"
{
  given EnteredBelow(FinalJudgment) on 2025-09-02
  expect deadline(notice-us-party-period) == 2025-11-03
}

test "a cross-appeal is due 14 days after the first notice" cite "FRAP 4(a)(3)"
{
  given NoticeOfAppealFiled() on 2025-03-12
  expect deadline(cross-appeal-period) == 2025-03-26
}

test "a 14th day on Christmas rolls to the 26th" cite "FRAP 26(a)(6)(A)"
{
  given NoticeOfAppealFiled() on 2025-12-11
  expect deadline(cross-appeal-period) == 2025-12-26
}

test "before 2009 a civil notice of appeal is still due 30 days after entry" cite "FRAP (2008 ed.) 4(a)(1)(A)"
{
  given EnteredBelow(FinalJudgment) on 2008-03-03
  expect deadline(notice-civil-period) == 2008-04-02
}

test "before 2009 a cross-appeal is due 14 days after the first notice" cite "FRAP (2008 ed.) 4(a)(3)"
{
  given NoticeOfAppealFiled() on 2008-03-12
  expect deadline(cross-appeal-period) == 2008-03-26
}
