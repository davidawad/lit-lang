module core.states.rhode-island

import core.calendar.{ us-federal-holidays }

/// The holidays of Rhode Island (R.I. Gen. Laws § 25-1-1) that
/// `us-federal-holidays` does not already close: Rhode Island Independence Day
/// (May 4, the day after when it falls on a Sunday), Victory Day (the second
/// Monday in August), the Monday after a New Year's Day, Juneteenth,
/// Independence Day, Veterans' Day or Christmas Day that falls on a Saturday,
/// and election day, the Tuesday after the first Monday in November of each
/// year in which a general election of state officers is held (an even year).
/// Each `once` day is listed from the date the vendored text was retrieved
/// (October 29, 2026) to the end of 2050. Not modeled: the days the governor,
/// the general assembly, the President or Congress appoints, which no vendored
/// source lists.
calendar rhode-island-holidays cite "R.I. Gen. Laws § 25-1-1"
{
  rhode-island-independence-day: fixed(5, 4) effective [2026-10-29, ..) observed next_day
  victory-day: nth(2, monday, 8) effective [2026-10-29, ..)
  // A Saturday New Year's Day, Juneteenth, Independence Day, Veterans' Day or
  // Christmas Day is celebrated the following Monday.
  new-years-day-observed-2028: once(2028-01-03) effective [2026-10-29, ..)
  new-years-day-observed-2033: once(2033-01-03) effective [2026-10-29, ..)
  new-years-day-observed-2039: once(2039-01-03) effective [2026-10-29, ..)
  new-years-day-observed-2050: once(2050-01-03) effective [2026-10-29, ..)
  juneteenth-observed-2027: once(2027-06-21) effective [2026-10-29, ..)
  juneteenth-observed-2032: once(2032-06-21) effective [2026-10-29, ..)
  juneteenth-observed-2038: once(2038-06-21) effective [2026-10-29, ..)
  juneteenth-observed-2049: once(2049-06-21) effective [2026-10-29, ..)
  independence-day-observed-2037: once(2037-07-06) effective [2026-10-29, ..)
  independence-day-observed-2043: once(2043-07-06) effective [2026-10-29, ..)
  independence-day-observed-2048: once(2048-07-06) effective [2026-10-29, ..)
  veterans-day-observed-2028: once(2028-11-13) effective [2026-10-29, ..)
  veterans-day-observed-2034: once(2034-11-13) effective [2026-10-29, ..)
  veterans-day-observed-2045: once(2045-11-13) effective [2026-10-29, ..)
  christmas-day-observed-2027: once(2027-12-27) effective [2026-10-29, ..)
  christmas-day-observed-2032: once(2032-12-27) effective [2026-10-29, ..)
  christmas-day-observed-2038: once(2038-12-27) effective [2026-10-29, ..)
  christmas-day-observed-2049: once(2049-12-27) effective [2026-10-29, ..)
  // The Tuesday after the first Monday in November of a year in which a
  // general election of state officers is held (an even year).
  general-election-day-2026: once(2026-11-03) effective [2026-10-29, ..)
  general-election-day-2028: once(2028-11-07) effective [2026-10-29, ..)
  general-election-day-2030: once(2030-11-05) effective [2026-10-29, ..)
  general-election-day-2032: once(2032-11-02) effective [2026-10-29, ..)
  general-election-day-2034: once(2034-11-07) effective [2026-10-29, ..)
  general-election-day-2036: once(2036-11-04) effective [2026-10-29, ..)
  general-election-day-2038: once(2038-11-02) effective [2026-10-29, ..)
  general-election-day-2040: once(2040-11-06) effective [2026-10-29, ..)
  general-election-day-2042: once(2042-11-04) effective [2026-10-29, ..)
  general-election-day-2044: once(2044-11-08) effective [2026-10-29, ..)
  general-election-day-2046: once(2046-11-06) effective [2026-10-29, ..)
  general-election-day-2048: once(2048-11-03) effective [2026-10-29, ..)
  general-election-day-2050: once(2050-11-08) effective [2026-10-29, ..)
}

/// FRCP 6 in the district courts of Rhode Island: the 2023 text
/// (`frcp6@2023-12-01`) with `rhode-island-holidays`, which 6(a)(6)(C)
/// ("any day declared a holiday by ... the state where the district court
/// is located") makes legal holidays "for periods that are measured after
/// an event" only. A district package there names it as its `counting`
/// rule and `recounts` lit/frcp. A calendar day is closed only from the
/// date its entry is in force; before it the count is `frcp6`'s.
counting frcp6-rhode-island effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCP 6(d)"
  holidays us-federal-holidays
  forward_holidays rhode-island-holidays cite "FRCP 6(a)(6)(C)"
  forums [frcp]
  allow_hours
  end_of_month clamp
}

/// FRBP 9006(a) (`frbp9006`) in the bankruptcy courts of Rhode Island:
/// `rhode-island-holidays` are legal holidays for a period counted forward only (FRBP
/// 9006(a)(6)(C), "any day declared a holiday by the state where the
/// district court is located"). A bankruptcy package there names it as its
/// `counting` rule and `recounts` lit/frbp. A calendar day is closed only
/// from the date its entry is in force.
counting frbp9006-rhode-island effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays rhode-island-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-ri]
  allow_hours
  end_of_month clamp
}
