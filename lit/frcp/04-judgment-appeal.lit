module frcp.judgment-appeal

import frcp.periods.{ cross-appeal-period, notice-of-appeal-period }
import frcp.{ judgment-appeal-group }

/// The court-of-appeals docketing fee is $600 from December 1, 2023 (Court
/// of Appeals Miscellaneous Fee Schedule item 1, the coa-fee-schedule
/// source), so the filing edge costs $605 with the $5 28 U.S.C. § 1917 fee.
decision notice-of-appeal-window: "Notice of Appeal Window" by applicant effective [2023-12-01, ..) supersedes notice-of-appeal-window@2013-12-01 cite "FRAP 4(a)(1)(A); 4(a)(1)(B)"
{
  group judgment-appeal-group
  note "30 days after entry of judgment (60 days if the United States or its officer/agency is a party). Bowles v. Russell, 551 U.S. 205 (2007): this statutory appeal deadline (rooted in 28 U.S.C. 2107) is JURISDICTIONAL, not a mere claim-processing rule -- unlike most deadlines in this chart, no equitable exception (excusable neglect, unique circumstances, waiver by the opposing party) can revive it once blown, though FRAP 4(a)(5) allows a district court to grant a limited extension (excusable neglect or good cause, capped at 30 days past the original deadline or 14 days after the extension order, whichever is later) if sought BEFORE the original deadline expires or shortly after."
  _ "File notice of appeal within 30 days of entry of judgment" -> notice-of-appeal-filed {
    authority cite "FRAP 4(a)(1)(A)"
    effort 4.hours
    cost 605.usd
    within notice-of-appeal-period {
      extendable true
      extension_authority "FRAP 4(a)(5) excusable neglect or good cause, sought before or shortly after the deadline"
      note "30 days after entry of judgment (60 if the United States is a party). JURISDICTIONAL under Bowles v. Russell, 551 U.S. 205 (2007) -- not subject to equitable exceptions once actually blown, unlike most deadlines in this chart."
    }
    duration { min 4.5.days, mode 15.days, max 30.days }
    valence good
    note "Filing fee $605.00, verified: $600.00 court-of-appeals docketing fee (Court of Appeals Miscellaneous Fee Schedule item 1, effective 12/1/2023, raised from $500.00) plus the $5.00 statutory notice-of-appeal fee (28 U.S.C. § 1917), both collected by the district clerk on filing."
  }
  _ "Miss the FRAP 4(a) deadline -- no timely extension sought" -> appeal-window-blown {
    authority cite ?("FRAP 4(a)(1)(A); Bowles v. Russell, 551 U.S. 205 (2007)")
    effort 0.hours
    valence bad
    court_listener_url "https://www.courtlistener.com/opinion/145714/bowles-v-russell/"
  }
  _ "Elect not to appeal -- judgment becomes final" -> judgment-final-no-appeal {
    authority cite "28 U.S.C. 1291"
    effort 0.hours
  }
}

/// Before December 1, 2023 the docketing fee was $500 (the pack's own note:
/// "raised from $500.00"), in force from December 1, 2013, when the Judicial
/// Conference raised it from $450 (First Circuit notice, "Increase to the
/// Appellate Filing Fee and Other Miscellaneous Fee Changes Effective December
/// 1, 2013", https://www.ca1.uscourts.gov/news/increase-appellate-filing-fee-
/// and-other-miscellaneous-fee-changes-effective-december-1-2013): $505 with
/// the § 1917 fee. Recorded 2026-10-22.
/// Its cites are holes: the FRAP text in force before December 1, 2023 is
/// not vendored, and the 2024 text the sources hold postdates this version.
decision notice-of-appeal-window: "Notice of Appeal Window" by applicant effective [2013-12-01, 2023-12-01) known_at 2026-10-22 cite ?("FRAP 4(a)(1)(A); 4(a)(1)(B)") {
  group judgment-appeal-group
  note "30 days after entry of judgment (60 days if the United States or its officer/agency is a party). Bowles v. Russell, 551 U.S. 205 (2007): this statutory appeal deadline (rooted in 28 U.S.C. 2107) is JURISDICTIONAL, not a mere claim-processing rule -- unlike most deadlines in this chart, no equitable exception (excusable neglect, unique circumstances, waiver by the opposing party) can revive it once blown, though FRAP 4(a)(5) allows a district court to grant a limited extension (excusable neglect or good cause, capped at 30 days past the original deadline or 14 days after the extension order, whichever is later) if sought BEFORE the original deadline expires or shortly after."
  _ "File notice of appeal within 30 days of entry of judgment" -> notice-of-appeal-filed {
    authority cite ?("FRAP 4(a)(1)(A)")
    effort 4.hours
    cost 505.usd
    within notice-of-appeal-period {
      extendable true
      extension_authority "FRAP 4(a)(5) excusable neglect or good cause, sought before or shortly after the deadline"
      note "30 days after entry of judgment (60 if the United States is a party). JURISDICTIONAL under Bowles v. Russell, 551 U.S. 205 (2007) -- not subject to equitable exceptions once actually blown, unlike most deadlines in this chart."
    }
    duration { min 4.5.days, mode 15.days, max 30.days }
    valence good
    note "Filing fee $505.00: $500.00 court-of-appeals docketing fee (Court of Appeals Miscellaneous Fee Schedule item 1, effective 12/1/2013, raised from $450.00) plus the $5.00 statutory notice-of-appeal fee (28 U.S.C. § 1917), both collected by the district clerk on filing."
  }
  _ "Miss the FRAP 4(a) deadline -- no timely extension sought" -> appeal-window-blown {
    authority cite ?("FRAP 4(a)(1)(A); Bowles v. Russell, 551 U.S. 205 (2007)")
    effort 0.hours
    valence bad
    court_listener_url "https://www.courtlistener.com/opinion/145714/bowles-v-russell/"
  }
  _ "Elect not to appeal -- judgment becomes final" -> judgment-final-no-appeal {
    authority cite "28 U.S.C. 1291"
    effort 0.hours
  }
}

state notice-of-appeal-filed: "Notice of Appeal Filed" by office cite "FRAP 3; 4(a)(1)(A)"
{
  group judgment-appeal-group
  note "Filed with the district clerk, specifying the party taking the appeal, the judgment/order appealed from, and the court to which the appeal is taken. The district court retains jurisdiction over matters not involved in the appeal, but generally loses jurisdiction over the merits of what is on appeal."
  _ "Notice served on all parties" -> cross-appeal-window { authority cite "FRAP 3(d)" }
}

terminal appeal-window-blown: "APPEAL FORFEITED -- Judgment Final" outcome [procedural-default, waiver-trap, final] cite ?("FRAP 4(a)(1)(A); Bowles v. Russell, 551 U.S. 205 (2007)") {
  group judgment-appeal-group
  note "PERMADEATH. No notice of appeal within 30 days (60 if the U.S. is a party) and no timely FRAP 4(a)(5) extension motion. Because the deadline is jurisdictional rather than a claim-processing rule, the court of appeals lacks power to hear the appeal even if the appellee never objects to its untimeliness -- the single most consequential deadline-as-permadeath trap in federal civil practice, the direct analog of the MPEP pack's 35 U.S.C. 133 six-month abandonment ceiling. PLACEHOLDER PAYOFF: $350,000, override per matter -- below the blended-neutral midpoint because a missed deadline (not a deliberate choice by either side) forecloses appellate correction of whatever the judgment was. This pack does not branch on which party a judgment favors -- `verdict-rendered`'s 'for plaintiff'/'for defendant' edges both lead to the same `final-judgment-entered` state, and every downstream terminal (summary judgment, appeal outcomes) tracks only the procedural posture from there, not who won. A single payoff here necessarily blends a possible plaintiff win with a possible plaintiff loss; override with scenario.payoffs once the matter's actual judgment is known."
  valence bad
  court_listener_url "https://www.courtlistener.com/opinion/145714/bowles-v-russell/"
  payoff 350_000.usd
}

terminal judgment-final-no-appeal: "JUDGMENT FINAL -- No Appeal Taken" outcome [final] cite "28 U.S.C. 1291"
{
  group judgment-appeal-group
  note "The losing party had a live right to appeal and elected not to exercise it within the FRAP 4(a) window. The judgment becomes final and, subject to any available collateral remedies (a Rule 60(b) motion in the district court, not further modeled here), is no longer open to challenge in this action. PLACEHOLDER PAYOFF: $500,000 (stake midpoint), override per matter. This pack does not branch on which party a judgment favors -- `verdict-rendered`'s 'for plaintiff'/'for defendant' edges both lead to the same `final-judgment-entered` state, and every downstream terminal (summary judgment, appeal outcomes) tracks only the procedural posture from there, not who won. A single payoff here necessarily blends a possible plaintiff win with a possible plaintiff loss; override with scenario.payoffs once the matter's actual judgment is known."
  valence good
  payoff 500_000.usd
}

/// A cross-appeal pays the same $605 filing fee as the lead notice from
/// December 1, 2023 (coa-fee-schedule).
decision cross-appeal-window: "Cross-Appeal Window" by applicant effective [2023-12-01, ..) supersedes cross-appeal-window@2013-12-01 cite "FRAP 4(a)(3)"
{
  group judgment-appeal-group
  note "A party who wants to challenge a different part of the same judgment -- not merely defend the judgment on alternative grounds -- must file its own notice of appeal within 14 days after the first notice of appeal was filed, or within the time otherwise prescribed by Rule 4(a)(1), whichever period ends later."
  _ "File cross-appeal" -> cross-appeal-filed {
    authority cite "FRAP 4(a)(3)"
    effort 6.hours
    cost 605.usd
    within cross-appeal-period {
      extendable true
      extension_authority "FRAP 4(a)(5): on motion no later than 30 days after the period expires, for excusable neglect or good cause"
      note "14 days after the first notice of appeal, or within the original FRAP 4(a)(1) period, whichever ends LATER."
    }
    duration { min 2.1.days, mode 7.days, max 14.days }
    note "Filing fee $605.00, same fee as the lead notice of appeal ($600.00 docketing fee, Court of Appeals Miscellaneous Fee Schedule item 1, effective 12/1/2023, plus 28 U.S.C. § 1917's $5.00 notice fee) -- a separate notice, a separate fee."
  }
  _ "No cross-appeal -- appellee will defend the judgment on the existing record" -> appellate-briefing {
    authority cite "FRAP 28.1"
    effort 0.hours
    note "Hours: 0, a default/no-action transition with no billable work of its own."
  }
}

/// The same $505 filing fee as the lead notice before December 1, 2023
/// (see `notice-of-appeal-window`'s earlier version). Recorded 2026-10-22.
/// Its cites are holes: the FRAP text in force before December 1, 2023 is
/// not vendored, and the 2024 text the sources hold postdates this version.
decision cross-appeal-window: "Cross-Appeal Window" by applicant effective [2013-12-01, 2023-12-01) known_at 2026-10-22 cite ?("FRAP 4(a)(3)") {
  group judgment-appeal-group
  note "A party who wants to challenge a different part of the same judgment -- not merely defend the judgment on alternative grounds -- must file its own notice of appeal within 14 days after the first notice of appeal was filed, or within the time otherwise prescribed by Rule 4(a)(1), whichever period ends later."
  _ "File cross-appeal" -> cross-appeal-filed {
    authority cite ?("FRAP 4(a)(3)")
    effort 6.hours
    cost 505.usd
    within cross-appeal-period {
      extendable true
      extension_authority "FRAP 4(a)(5): on motion no later than 30 days after the period expires, for excusable neglect or good cause"
      note "14 days after the first notice of appeal, or within the original FRAP 4(a)(1) period, whichever ends LATER."
    }
    duration { min 2.1.days, mode 7.days, max 14.days }
    note "Filing fee $505.00, same fee as the lead notice of appeal ($500.00 docketing fee, Court of Appeals Miscellaneous Fee Schedule item 1, effective 12/1/2013, plus 28 U.S.C. § 1917's $5.00 notice fee) -- a separate notice, a separate fee."
  }
  _ "No cross-appeal -- appellee will defend the judgment on the existing record" -> appellate-briefing {
    authority cite ?("FRAP 28.1")
    effort 0.hours
    note "Hours: 0, a default/no-action transition with no billable work of its own."
  }
}

state cross-appeal-filed: "Cross-Appeal Filed" by office cite "FRAP 4(a)(3); 28"
{
  group judgment-appeal-group
  note "The cross-appeal is docketed together with the lead appeal; briefing order and page limits under FRAP 28.1 are adjusted to account for both parties' status as appellant and appellee."
  _ "Cross-appeal docketed with the lead appeal" -> appellate-briefing {
    authority cite "FRAP 3; 28.1"
  }
}

state appellate-briefing: "Appellate Briefing & Argument" by applicant cite "FRAP 28; 34"
{
  group judgment-appeal-group
  note "Principal brief, response brief, and reply brief (FRAP 28), followed by oral argument unless the panel unanimously agrees it is unnecessary (FRAP 34(a)(2)). Standard of review varies sharply by issue: de novo for pure legal conclusions (including summary judgment grants and 12(b)(6) dismissals), clear error for a bench trial's factual findings (Rule 52(a)(6)), and highly deferential abuse-of-discretion review for most evidentiary and case-management rulings (protective orders, sanctions, motions in limine)."
  _ "Complete FRAP 28 briefing and oral argument" -> court-of-appeals-decision {
    authority cite "FRAP 28; 34"
    effort 160.hours
    cost 45_000.usd
  }
}

chance court-of-appeals-decision: "Court of Appeals Decision" by examiner discretion cite "28 U.S.C. 1291"
{
  group judgment-appeal-group
  note "Outcome distribution authored at 0.55 affirmed / 0.35 reversed-or-vacated-and-remanded / 0.10 affirmed-in-part-reversed-in-part -- APPROXIMATE, not a live empirical figure, but consistent with the well-documented general pattern that civil appeals are affirmed considerably more often than reversed given deferential standards of review on most issues."
  coa-affirms "Court of appeals affirms" -> judgment-affirmed p 0.55 {
    authority cite "28 U.S.C. 1291"
  }
  _ "Court of appeals reverses or vacates and remands" -> judgment-reversed-remanded p 0.35 {
    authority cite "28 U.S.C. 2106"
  }
  coa-affirmed-in-part "Affirmed in part, reversed in part -- net affirmance for appellee" -> judgment-affirmed p 0.1 {
    authority cite "28 U.S.C. 1291; 2106"
  }
}

terminal judgment-affirmed: "JUDGMENT AFFIRMED ON APPEAL" outcome [affirmed, final] cite "28 U.S.C. 1291"
{
  group judgment-appeal-group
  note "The district court's judgment stands. Subject only to the narrow, discretionary avenue of a petition for certiorari to the Supreme Court (28 U.S.C. 1254(1); not separately modeled in this chart), the case is over. PLACEHOLDER PAYOFF: $500,000 (stake midpoint), override per matter. This pack does not branch on which party a judgment favors -- `verdict-rendered`'s 'for plaintiff'/'for defendant' edges both lead to the same `final-judgment-entered` state, and every downstream terminal (summary judgment, appeal outcomes) tracks only the procedural posture from there, not who won. A single payoff here necessarily blends a possible plaintiff win with a possible plaintiff loss; override with scenario.payoffs once the matter's actual judgment is known."
  valence good
  court_listener_url "https://www.courtlistener.com/opinion/9395291/epic-games-inc-v-apple-inc/"
  payoff 500_000.usd
}

terminal judgment-reversed-remanded: "JUDGMENT REVERSED / VACATED AND REMANDED" outcome [remand] cite "28 U.S.C. 2106"
{
  group judgment-appeal-group
  note "The court of appeals may affirm, modify, vacate, set aside, or reverse any judgment and remand the case with instructions as just under the circumstances (28 U.S.C. 2106). Marks the end of THIS chart's walk -- the remanded case re-enters district-court proceedings at whatever posture the mandate specifies (a new trial, reconsideration of a single ruling, or entry of a different judgment), which this pack does not separately re-model to avoid an unbounded loop back through the whole procedural history. PLACEHOLDER PAYOFF: $400,000, override per matter, matching this project's remand tier. This pack does not branch on which party a judgment favors -- `verdict-rendered`'s 'for plaintiff'/'for defendant' edges both lead to the same `final-judgment-entered` state, and every downstream terminal (summary judgment, appeal outcomes) tracks only the procedural posture from there, not who won. A single payoff here necessarily blends a possible plaintiff win with a possible plaintiff loss; override with scenario.payoffs once the matter's actual judgment is known."
  valence caution
  court_listener_url "https://www.courtlistener.com/opinion/779367/residential-funding-corporation-v-degeorge-financial-corp-degeorge-home/"
  payoff 400_000.usd
}
