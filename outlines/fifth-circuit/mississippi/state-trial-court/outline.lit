// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-ms-trial-court

import outline-ms-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start complaint-filed

state complaint-filed: "Complaint Filed" by applicant cite ?("Miss. R. Civ. P. 3")
{
  note "OUTLINE. Action commenced by filing complaint (Rule 3; verify). Equity matters go to chancery courts (verify)."
  edge-complaint-filed-service "Served" -> service-made {
    authority cite ?("Miss. R. Civ. P. 4")
  }
}

state service-made: "Served" by applicant cite ?("Miss. R. Civ. P. 4")
{
  note "OUTLINE. Summons and service (Rule 4; verify). Service period is a hole (?)."
  edge-service-made-response "Served in time" -> response-due { event ActionCommenced()
    authority cite ?("Miss. R. Civ. P. 4")
  }
  edge-service-made-lapsed "Not served in time" -> service-dismissal {
    authority cite ?("Miss. R. Civ. P. 4")
  }
}

decision response-due: "Answer, pleading challenge, or nothing" by office cite ?("Miss. R. Civ. P. 12(a)")
{
  note "OUTLINE. Answer period is a hole (?) after service (Rule 12(a); verify). Affirmative defenses (Rule 8(c); verify)."
  edge-response-due-answer "Answer filed" -> answered {
    authority cite ?("Miss. R. Civ. P. 12(a)")
  }
  edge-response-due-pleading "Pleading challenge filed" -> pleading-motion {
    authority cite ?("Miss. R. Civ. P. 12(b)(6), 12(c)")
  }
  edge-response-due-default "No response" -> default-request {
    authority cite ?("Miss. R. Civ. P. 55(a)")
  }
}

state pleading-motion: "Rule 12(b)(6) or 12(c) motion" by office cite ?("Miss. R. Civ. P. 12(b)(6), 12(c)")
{
  note "OUTLINE. Failure to state a claim (Rule 12(b)(6)); judgment on the pleadings (Rule 12(c)); verify. Leading Mississippi pleading-standard decisions to be added (verify)."
  edge-pleading-motion-ruling "Court rules" -> pleading-ruling {
    authority cite ?("Miss. R. Civ. P. 12(b)(6), 12(c)")
  }
}

decision pleading-ruling: "Ruling on pleading challenge" by court cite ?("Miss. R. Civ. P. 12(b)(6), 12(c)")
{
  note "OUTLINE. Leave to amend is governed by the amendment rule (cite below). Verify leading decisions before use."
  edge-pleading-ruling-dismissed "Dismissed with prejudice" -> dismissed-merits {
    authority cite ?("Miss. R. Civ. P. 12(b)(6), 12(c)")
  }
  edge-pleading-ruling-leave "Dismissed with leave to amend" -> amended {
    authority cite ?("Miss. R. Civ. P. 15(a)")
  }
  edge-pleading-ruling-denied "Denied" -> answered {
    authority cite ?("Miss. R. Civ. P. 12(a)")
  }
}

state amended: "Amended pleading filed" by applicant cite ?("Miss. R. Civ. P. 15(a)")
{
  note "OUTLINE. Response period to the amended pleading is a hole (?)."
  edge-amended-response "Amended pleading served" -> response-due { event ActionCommenced()
    authority cite ?("Miss. R. Civ. P. 12(a)")
  }
}

state answered: "Answer filed" by applicant cite ?("Miss. R. Civ. P. 12(a)")
{
  note "OUTLINE. Affirmative defenses must be pleaded (cite below); discovery opens after pleadings close."
  edge-answered-discovery "Pleadings closed" -> discovery {
    authority cite ?("Miss. R. Civ. P. 26(b)(1), 30, 33, 34, 36")
  }
}

state default-request: "Default sought" by applicant cite ?("Miss. R. Civ. P. 55(a)")
{
  note "OUTLINE. Clerk's entry of default (Rule 55(a)); default judgment (Rule 55(b); verify). Setting aside (Rule 55(c); verify)."
  edge-default-request-entered "Default entered" -> default-entered {
    authority cite ?("Miss. R. Civ. P. 55(a)")
  }
  edge-default-request-answered "Answer filed before default" -> answered {
    authority cite ?("Miss. R. Civ. P. 12(a)")
  }
}

state default-entered: "Default entered" by applicant cite ?("Miss. R. Civ. P. 55(b)")
{
  note "OUTLINE. Default judgment requires proof of the claim; a hearing may be needed for damages (verify). Setting aside is a hole until verified."
  edge-default-entered-judgment "Default judgment sought" -> default-judgment {
    authority cite ?("Miss. R. Civ. P. 55(b)")
  }
  edge-default-entered-set-aside "Defendant moves to set aside" -> set-aside-ruling {
    authority cite ?("Miss. R. Civ. P. 55(c)")
  }
}

decision set-aside-ruling: "Set aside the default?" by court cite ?("Miss. R. Civ. P. 55(c)")
{
  note "OUTLINE. Standard and any time limit are holes until verified."
  edge-set-aside-granted "Set aside" -> answered {
    authority cite ?("Miss. R. Civ. P. 55(c)")
  }
  edge-set-aside-refused "Refused" -> default-judgment {
    authority cite ?("Miss. R. Civ. P. 55(c)")
  }
}

state discovery: "Discovery" by applicant cite ?("Miss. R. Civ. P. 26(b)(1), 30, 33, 34, 36")
{
  note "OUTLINE. Scope (Rule 26(b)(1); verify). Discovery period and limits are set by case management (Rule 16; verify)."
  edge-discovery-dispute "Discovery dispute" -> discovery-ruling {
    authority cite ?("Miss. R. Civ. P. 26(b)(1), 30, 33, 34, 36")
  }
  edge-discovery-sj "Dispositive motion" -> sj-motion {
    authority cite ?("Miss. R. Civ. P. 56(c)")
  }
  edge-discovery-settled "Settled" -> settled {
    authority cite ?("Miss. R. Civ. P. 41(a)")
  }
  edge-discovery-voluntary "Voluntary dismissal" -> voluntary-dismissal {
    authority cite ?("Miss. R. Civ. P. 41(a)")
  }
  edge-discovery-inactive "No prosecution" -> inactivity-dismissal {
    authority cite ?("Miss. R. Civ. P. 41(b)")
  }
}

decision discovery-ruling: "Discovery ruling" by court cite ?("Miss. R. Civ. P. 37(b)")
{
  note "OUTLINE. Meet-and-confer and sanction prerequisites are holes until verified."
  edge-discovery-ruling-resolved "Dispute resolved" -> discovery {
    authority cite ?("Miss. R. Civ. P. 26(b)(1), 30, 33, 34, 36")
  }
  edge-discovery-ruling-sanction "Sanction dismissal" -> sanction-dismissal {
    authority cite ?("Miss. R. Civ. P. 37(b)")
  }
}

state sj-motion: "Summary judgment motion" by office cite ?("Miss. R. Civ. P. 56(c)")
{
  note "OUTLINE. Summary judgment standard (Rule 56(c); verify). Verify: Brown v. Credit Center, Inc., 444 So. 2d 358 (Miss. 1983)."
  edge-sj-motion-ruling "Motion heard" -> sj-ruling {
    authority cite ?("Miss. R. Civ. P. 56(c)")
  }
}

decision sj-ruling: "Summary judgment ruling" by court cite ?("Miss. R. Civ. P. 56(c)")
{
  note "OUTLINE. Partial summary judgment availability is a hole until verified."
  edge-sj-ruling-defense "Granted for defendant" -> sj-defense {
    authority cite ?("Miss. R. Civ. P. 56(c)")
  }
  edge-sj-ruling-applicant "Granted for applicant" -> judgment-for-applicant {
    authority cite ?("Miss. R. Civ. P. 58")
  }
  edge-sj-ruling-denied "Denied" -> trial-setting {
    authority cite ?("Miss. R. Civ. P. 38, 39")
  }
}

state trial-setting: "Trial setting and jury request" by office cite ?("Miss. R. Civ. P. 38, 39")
{
  note "OUTLINE. Jury demand (Rule 38; period is a hole (?), verify). Jury right under Miss. Const. art. 3, sec. 31 (verify)."
  edge-trial-setting-result "Tried" -> trial-result {
    authority cite ?("Miss. R. Civ. P. 38, 39")
  }
}

decision trial-result: "Judgment after trial" by court cite ?("Miss. R. Civ. P. 58")
{
  note "OUTLINE. Post-trial motion periods are holes (?) until verified."
  edge-trial-result-applicant "Judgment for applicant" -> judgment-for-applicant {
    authority cite ?("Miss. R. Civ. P. 58")
  }
  edge-trial-result-defense "Judgment for defendant" -> verdict-for-defendant {
    authority cite ?("Miss. R. Civ. P. 58")
  }
  edge-trial-result-post "Post-trial motion filed" -> post-trial { event JudgmentEntered()
    authority cite ?("Miss. R. Civ. P. 50(b), 59")
  }
}

decision post-trial: "Post-trial motion ruling" by court cite ?("Miss. R. Civ. P. 50(b), 59")
{
  note "OUTLINE. Grounds and time limits are holes until verified. Leading decisions: verify."
  edge-post-trial-new-trial "New trial granted" -> trial-setting {
    authority cite ?("Miss. R. Civ. P. 50(b), 59")
  }
  edge-post-trial-applicant "Denied; applicant's judgment stands" -> judgment-for-applicant {
    authority cite ?("Miss. R. Civ. P. 58")
  }
  edge-post-trial-defense "Denied; defendant's judgment stands" -> verdict-for-defendant {
    authority cite ?("Miss. R. Civ. P. 58")
  }
}

terminal service-dismissal: "Dismissed for failure to serve" outcome [loss] cite ?("Miss. R. Civ. P. 4")
{
  note "OUTLINE. Service period and refiling effect are holes (?)."
  payoff ?
}

terminal dismissed-merits: "Dismissed on the pleadings" outcome [loss] cite ?("Miss. R. Civ. P. 12(b)(6), 12(c)")
{
  note "OUTLINE. Appeal route: see the state's appellate court packages."
  payoff ?
}

terminal default-judgment: "Default judgment" outcome [win] cite ?("Miss. R. Civ. P. 55(b)")
{
  note "OUTLINE. Damages and costs are holes."
  payoff ?
}

terminal sanction-dismissal: "Dismissed as discovery sanction" outcome [loss] cite ?("Miss. R. Civ. P. 37(b)")
{
  note "OUTLINE. Sanction prerequisites are holes until verified."
  payoff ?
}

terminal inactivity-dismissal: "Dismissed for inactivity" outcome [loss] cite ?("Miss. R. Civ. P. 41(b)")
{
  note "OUTLINE. Period of inactivity and any notice requirement are holes (?)."
  payoff ?
}

terminal voluntary-dismissal: "Voluntary dismissal" outcome [neutral] cite ?("Miss. R. Civ. P. 41(a)")
{
  note "OUTLINE. Effect of dismissal on refiling is a hole until verified."
  payoff ?
}

terminal settled: "Settled" outcome [neutral] cite ?("Miss. R. Civ. P. 41(a)")
{
  note "OUTLINE. Terms are holes."
  payoff ?
}

terminal sj-defense: "Summary judgment for defendant" outcome [loss] cite ?("Miss. R. Civ. P. 56(c)")
{
  note "OUTLINE. Appeal route: see the state's appellate court packages."
  payoff ?
}

terminal judgment-for-applicant: "Judgment for applicant" outcome [win] cite ?("Miss. R. Civ. P. 58")
{
  note "OUTLINE. Costs, interest and fee recovery are holes."
  payoff ?
}

terminal verdict-for-defendant: "Judgment or verdict for defendant" outcome [loss] cite ?("Miss. R. Civ. P. 58")
{
  note "OUTLINE. Costs are holes."
  payoff ?
}
