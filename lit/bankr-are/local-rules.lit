module bankr-are-local-rules.local-rules

import core.frcp6.{ frcp6 }

// The Bankr. E.D. Ark. court's own periods, counted under FRBP 9006(a). The
// FRBP periods are lit/frbp's and are not declared again. Every period
// below binds only to the CURRENCY UNCONFIRMED complete set of the Arkansas
// local rules (sources/bankr-are/PROVENANCE.md), so each has a hole cite
// naming its pinpoint and the value is the vendored text's, unverified.
//
// Stated in the rules but not declared: the Insurer's own acts under the
// chapter 13 motor vehicle insurance program (a notice of cancellation
// mailed within two days after an order dismissing or converting the case,
// and coverage ending 30 days after that notice or, absent one, 30 days
// after the order, LR 2015-1 I.6), which bind no party; the debtor's
// evidence of insurance due at or before the § 341(a) meeting (LR 2015-1
// I.14, II.3), which runs on the meeting itself rather than a period; and
// the notice to other courts "as soon as possible" after the petition (LR
// 2072-1). Monthly operating reports (LR 1020-1) follow the United States
// Trustee's guidelines, which are not vendored. The rules state no page
// limit.
/// A loss to a motor vehicle insured under the chapter 13 trustee's Master
/// Policy occurs (LR 2015-1 I.8).
event InsuredLossOccurred()
/// A party forwards a proposed consent order to the opposing attorney (LR
/// 9019-1(c)).
event ConsentOrderForwarded()

/// E.D. Ark. Bankr. LR 2015-1 I.8: every claim under the chapter 13 trustee's
/// Master Policy is made by sworn proof of loss delivered to the Insurer
/// within 91 days after the insured loss.
deadline proof-of-loss-period: 91.days after InsuredLossOccurred() counted_by frcp6 cite ?("E.D. Ark. Bankr. LR 2015-1 I.8, undated complete set: CURRENCY UNCONFIRMED (no edition or effective date on the document or the court's page); the value is the vendored text, unverified") {
  forum frcp
}

/// E.D. Ark. Bankr. LR 9019-1(c): the opposing attorney has 14 days from the
/// mailing or transmission of a proposed consent order to object to its form
/// or content; without a response in 14 days the order is a Consent Order
/// the preparing party may submit.
deadline consent-order-objection-period: 14.days after ConsentOrderForwarded() counted_by frcp6 cite ?("E.D. Ark. Bankr. LR 9019-1(c), undated complete set: CURRENCY UNCONFIRMED (no edition or effective date on the document or the court's page); the value is the vendored text, unverified") {
  forum frcp
}

start order-forwarded

state order-forwarded: "Proposed consent order forwarded to opposing counsel" by applicant cite ?("E.D. Ark. Bankr. LR 9019-1(c), undated complete set: CURRENCY UNCONFIRMED (no edition or effective date on the document or the court's page); the value is the vendored text, unverified") {
  note "The party responsible for the order (designated by the court or agreed by the parties, LR 9019-1(b)) forwards it to the opposing attorney, who has 14 days from its mailing or transmission to object to its form or content (LR 9019-1(c)); the value is the CURRENCY UNCONFIRMED text's."
  edge-order-forwarded-objection "Objection to form or content" -> objected {
    authority cite ?("E.D. Ark. Bankr. LR 9019-1(c), undated complete set: CURRENCY UNCONFIRMED (no edition or effective date on the document or the court's page); the value is the vendored text, unverified")
  }
  edge-order-forwarded-signed "Signed, or no response within the period: a Consent Order" -> submitted {
    authority cite ?("E.D. Ark. Bankr. LR 9019-1(c), undated complete set: CURRENCY UNCONFIRMED (no edition or effective date on the document or the court's page); the value is the vendored text, unverified")
  }
}

state objected: "Objection to the proposed order" by opponent cite ?("E.D. Ark. Bankr. LR 9019-1(c), undated complete set: CURRENCY UNCONFIRMED (no edition or effective date on the document or the court's page); the value is the vendored text, unverified") {
  note "An attorney submits only a Consent Order or a Routine Order (LR 9019-1(e)); an objected-to order is neither, and the matter returns to the court."
  edge-objected-court "Matter returned to the court" -> ruling {
    authority cite ?("E.D. Ark. Bankr. LR 9019-1(e), undated complete set: CURRENCY UNCONFIRMED (no edition or effective date on the document or the court's page); the value is the vendored text, unverified")
  }
}

state submitted: "Consent Order submitted to the court" by applicant cite ?("E.D. Ark. Bankr. LR 9019-1(c), undated complete set: CURRENCY UNCONFIRMED (no edition or effective date on the document or the court's page); the value is the vendored text, unverified") {
  note "Upon the signatures, or when opposing counsel does not respond within the period, the preparing party submits the order (LR 9019-1(c))."
  edge-submitted-court "Order considered" -> ruling {
    authority cite ?("E.D. Ark. Bankr. LR 9019-1(c), undated complete set: CURRENCY UNCONFIRMED (no edition or effective date on the document or the court's page); the value is the vendored text, unverified")
  }
}

decision ruling: "Order entered or matter decided" by court cite ?("E.D. Ark. Bankr. LR 9019-1(e), undated complete set: CURRENCY UNCONFIRMED (no edition or effective date on the document or the court's page); the value is the vendored text, unverified") {
  note "The court enters the consent order or decides the disputed matter."
  edge-ruling-entered "Entered" -> decided {
    authority cite ?("E.D. Ark. Bankr. LR 9019-1(c), undated complete set: CURRENCY UNCONFIRMED (no edition or effective date on the document or the court's page); the value is the vendored text, unverified")
  }
  edge-ruling-decided "Decided on the merits" -> decided {
    authority cite ?("E.D. Ark. Bankr. LR 9019-1(e), undated complete set: CURRENCY UNCONFIRMED (no edition or effective date on the document or the court's page); the value is the vendored text, unverified")
  }
}

terminal decided: "Matter decided: the case continues under lit/frbp" outcome [procedural] cite ?("E.D. Ark. Bankr. LR 1001-1, undated complete set: CURRENCY UNCONFIRMED (no edition or effective date on the document or the court's page); the value is the vendored text, unverified") {
  note "All matters of procedure the local rules do not address are governed by the Federal Rules of Bankruptcy Procedure (LR 1001-1; the CURRENCY UNCONFIRMED text)."
}
