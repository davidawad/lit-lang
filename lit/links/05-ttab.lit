// TTAB <-> Federal Circuit. A party dissatisfied with a final Board decision
// may appeal to the Federal Circuit on the Board record (15 U.S.C.
// § 1071(a); 28 U.S.C. § 1295(a)(4)(B)) within 63 days (37 C.F.R.
// § 2.145(d)(1), lit/cafc's `ttab-noa-period`), or instead bring a civil
// action (§ 1071(b)), which stays abstract in the TTAB pack.
module links.ttab

/// The Federal Circuit as entered from a final TTAB decision. Only
/// `origin-to-ttab` and `remand-route-ttab` survive. No rehearing patch: in
/// an inter partes appeal the appellee is the other party, so lit/cafc's
/// 30-day `rehearing-period` applies unless the Director intervenes.
instance cafc@ttab {
  pack cafc
  note "Federal Circuit as entered from a final TTAB decision (15 U.S.C. § 1071(a); 28 U.S.C. § 1295(a)(4)(B)). Remand can only return to the TTAB."
  remove_edges [origin-to-district-court, origin-to-ptab, origin-to-itc, origin-to-cofc, remand-route-district-court, remand-route-ptab, remand-route-itc, remand-route-cofc]
  probabilities { remand-route-ttab: 1 }
}

/// Replaces the TTAB pack's abstract Federal Circuit outcome edge when both
/// packs are loaded.
link ttab-appeal-to-cafc "Appeal the TTAB decision to the Federal Circuit on the Board record": ttab-trademark-trial-and-appeal-board::decision-sustained -> cafc@ttab::entry-ttab by applicant {
  authority cite 15 U.S.C. § 1071(a); 28 U.S.C. § 1295(a)(4)(B)
  note "Supersedes the TTAB pack's abstract Federal Circuit outcome node when both packs are loaded. The 15 U.S.C. § 1071(b) civil-action alternative stays abstract (district-court de novo review is not a good fit for the FRCP pack's generic civil case); a matter scenario removes whichever route it does not use."
  tags [appeal]
  replaces ["ttab-trademark-trial-and-appeal-board::decision-sustained->cafc-outcome#0"]
}

/// On remand the Board issues a new final decision (legacy authority 28
/// U.S.C. § 2106, kept; see `cafc-remand-to-ptab`).
link cafc-remand-to-ttab "Remand: Board issues a new final decision": cafc@ttab::remanded-to-ttab -> ttab-trademark-trial-and-appeal-board::final-decision by office p 1 {
  authority cite 28 U.S.C. § 2106
  tags [remand]
}
