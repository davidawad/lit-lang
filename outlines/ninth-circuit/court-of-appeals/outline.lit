// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.

module outline-ca9

start notice-filed

state notice-filed: "Notice of Appeal Filed" by applicant cite ?("Fed. R. App. P. 4(a)(1)(A)")
{
  note "Notice period is a hole. Timeliness: Bowles v. Russell, 551 U.S. 205 (2007); Hamer v. Neighborhood Housing Services, Inc., 138 S. Ct. 13 (2017). Verify."
  edge-notice-filed-appealability "Timely notice" -> appealability {
    authority cite ?("Fed. R. App. P. 4(a)(1)(A)")
  }
  edge-notice-filed-dismissed-untimely "Late or defective notice" -> dismissed-untimely {
    authority cite ?("Fed. R. App. P. 4(a)(1)(A)")
  }
}

terminal dismissed-untimely: "Dismissed as untimely" outcome [loss] cite ?("Fed. R. App. P. 4(a)(1)(A)")
{
  note "Dismissal for untimely notice. Verify."
  payoff ?
}

decision appealability: "Appealable Order or Judgment" by court cite ?("28 U.S.C. § 1291")
{
  note "Final decision under 28 U.S.C. 1291: Catlin v. United States, 324 U.S. 229 (1945). Interlocutory routes under 28 U.S.C. 1292 are holes. Verify."
  edge-appealability-dismissed-jurisdiction "Not appealable" -> dismissed-jurisdiction {
    authority cite ?("28 U.S.C. § 1291")
  }
  edge-appealability-record-assembled "Appealable" -> record-assembled {
    authority cite ?("28 U.S.C. § 1291")
  }
}

terminal dismissed-jurisdiction: "Dismissed for lack of appealable order" outcome [loss] cite ?("28 U.S.C. § 1291")
{
  note "OUTLINE. Interlocutory review routes are holes (verify)."
  payoff ?
}

state record-assembled: "Record Assembled" by applicant cite ?("Fed. R. App. P. 10")
{
  note "Record designation and transcript deadlines are holes. Ninth Circuit local rules: identify and verify."
  edge-record-assembled-briefing "Record transmitted" -> briefing {
    authority cite ?("Fed. R. App. P. 10")
  }
}

state briefing: "Briefing" by applicant cite ?("Fed. R. App. P. 28")
{
  note "Brief length, format and due dates are holes. Ninth Circuit local rules: identify and verify."
  edge-briefing-argument "Briefing complete" -> argument {
    authority cite ?("Fed. R. App. P. 28")
  }
}

decision argument: "Argument or Submission" by court cite ?("Fed. R. App. P. 34")
{
  note "Calendaring and submission on briefs are holes. Verify."
  edge-argument-decision-issued "Argued or submitted" -> decision-issued {
    authority cite ?("Fed. R. App. P. 34")
  }
}

decision decision-issued: "Decision" by court cite ?("Fed. R. App. P. 36")
{
  note "Published or unpublished disposition status is a hole. Verify."
  edge-decision-issued-rehearing-window "Disposition entered" -> rehearing-window {
    authority cite ?("Fed. R. App. P. 36")
  }
}

decision rehearing-window: "Rehearing or Reconsideration" by applicant cite ?("Fed. R. App. P. 40")
{
  note "Period is a hole. En banc: Fed. R. App. P. 35. Verify."
  edge-rehearing-window-mandate-issued "No petition" -> mandate-issued {
    authority cite ?("Fed. R. App. P. 41")
  }
  edge-rehearing-window-rehearing-ruling "Petition filed" -> rehearing-ruling {
    authority cite ?("Fed. R. App. P. 40")
  }
}

decision rehearing-ruling: "Rehearing Decided" by court cite ?("Fed. R. App. P. 40")
{
  note "Period is a hole. En banc: Fed. R. App. P. 35. Verify."
  edge-rehearing-ruling-mandate-issued "Denied" -> mandate-issued {
    authority cite ?("Fed. R. App. P. 40")
  }
  edge-rehearing-ruling-rehearing-granted "Granted" -> rehearing-granted {
    authority cite ?("Fed. R. App. P. 40")
  }
}

terminal rehearing-granted: "Rehearing granted; new decision" outcome [appeal] cite ?("Fed. R. App. P. 40")
{
  note "OUTLINE. Loops back to the decision stage in practice; modeled as an exit here."
  payoff ?
}

state mandate-issued: "Mandate or Remittitur Issued" by court cite ?("Fed. R. App. P. 41")
{
  note "Issuance timing is a hole."
  edge-mandate-issued-further-review "Review sought" -> further-review {
    authority cite ?("28 U.S.C. § 1254(1)")
  }
  edge-mandate-issued-final-appellate "No further review sought" -> final-appellate {
    authority cite ?("Fed. R. App. P. 41")
  }
}

decision further-review: "Further Review Petition" by applicant cite ?("28 U.S.C. § 1254(1)")
{
  note "Petition period is a hole. Verify."
  edge-further-review-review-denied "Denied" -> review-denied {
    authority cite ?("28 U.S.C. § 1254(1)")
  }
  edge-further-review-review-granted "Granted" -> review-granted {
    authority cite ?("28 U.S.C. § 1254(1)")
  }
}

terminal review-denied: "Further review denied" outcome [loss] cite ?("28 U.S.C. § 1254(1)")
{
  note "OUTLINE. Denial ends further review; finality of the appellate judgment is a hole."
  payoff ?
}

terminal review-granted: "Further review granted" outcome [appeal] cite ?("28 U.S.C. § 1254(1)")
{
  note "OUTLINE. Merits of further review are a hole."
  payoff ?
}

terminal final-appellate: "Appellate judgment final" outcome [judgment] cite ?("Fed. R. App. P. 41")
{
  note "OUTLINE. Trial court regains jurisdiction on issuance (verify)."
  payoff ?
}

