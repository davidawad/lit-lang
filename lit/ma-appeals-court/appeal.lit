module ma-appeals-court.appeal

import ma-state-rules.{ DecisionFiled, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start notice

decision notice: "Notice of appeal within 30 days of entry?" by applicant cite "Mass. R. A. P. 4(a)"
{
  note "In a civil case, unless a statute provides otherwise, the notice of appeal required by rule 3 is filed with the clerk of the lower court within 30 days of entry of the judgment, decree, appealable order or adjudication, or within 60 days if the Commonwealth or an officer or agency of it is a party (Mass. R. A. P. 4(a)(1)(A)); any other party may file within 14 days of the first notice (Mass. R. A. P. 4(a)(1)(C)). A timely postjudgment motion under Mass. R. Civ. P. 50(b), 52(b) or 59, or 60(b) served within 10 days, runs the time from the order disposing of the last of them (Mass. R. A. P. 4(a)(2)). On excusable neglect the lower court may extend the time by not more than 30 days from its expiration (Mass. R. A. P. 4(c)); no court may enlarge it beyond 1 year from entry (Mass. R. A. P. 14(b)). Periods are computed under Mass. R. A. P. 14(a), which excludes intermediate Saturdays, Sundays and legal holidays from a period under 7 days; they are stated here, not counted. No leading decision is named."
  edge-notice-late "Untimely notice" -> dismissed-untimely { authority cite "Mass. R. A. P. 4(a)" }
  edge-notice-timely "Timely notice" -> record { event NoticeOfAppealFiled() authority cite "Mass. R. A. P. 4(a)" }
}

terminal dismissed-untimely: "Appeal lost: no timely notice" outcome [loss, dismissal] cite "Mass. R. A. P. 4(a)"
{
  note "Outcome from the appellant's side. An extension for excusable neglect under Mass. R. A. P. 4(c) is not modeled."
}

state record: "Transcript ordered and record assembled" by office cite "Mass. R. A. P. 9(d)"
{
  note "The appellant orders the transcript of the relevant court-reported proceedings within 14 days of filing the notice of appeal, or certifies that none is relevant or that it is on file (Mass. R. A. P. 8(b)(1)(A)). Within 14 days after filing the notice, each civil appellant delivers to the clerk of the lower court the transcript, a certificate that it has been ordered, or a certificate that none will be ordered (Mass. R. A. P. 9(d)(2)). The clerk of the lower court then assembles the record and sends notice of assembly."
  edge-record-docket "Notice of assembly received" -> docketing { event RecordFiled()
    authority cite "Mass. R. A. P. 10(a)"
  }
}

state docketing: "Appeal docketed in the Appeals Court" by applicant cite "Mass. R. A. P. 10(a)"
{
  note "Within 14 days after receiving the notice of assembly of the record, each appellant pays the appellate court's docket fee or requests its waiver, and the clerk enters the appeal on the docket (Mass. R. A. P. 10(a)(1)(A))."
  edge-docketing-dar "Application for direct appellate review" -> direct-review { event ReviewPetitionFiled()
    authority cite "Mass. R. A. P. 11(a)"
  }
  edge-docketing-brief "Briefing in the Appeals Court" -> briefing {
    authority cite "Mass. R. A. P. 19(a)"
  }
}

decision direct-review: "Direct appellate review decided" by court cite "Mass. R. A. P. 11(a)"
{
  note "Within 21 days after the appeal is docketed in the Appeals Court, any party may apply to the Supreme Judicial Court for direct appellate review on questions of first impression or novel questions of law, constitutional questions, or questions of such public interest that justice requires a final determination by the full court (Mass. R. A. P. 11(a)); any other party may respond within 14 days after the application is filed (Mass. R. A. P. 11(c)). Briefing in a transferred case runs under Mass. R. A. P. 11(g); the Supreme Judicial Court's own decision is modeled by the same steps as the Appeals Court's."
  edge-direct-review-allowed "Allowed: appeal transferred" -> transferred {
    authority cite "Mass. R. A. P. 11(g)"
  }
  edge-direct-review-denied "Denied: appeal stays in the Appeals Court" -> briefing {
    authority cite "Mass. R. A. P. 11(a)"
  }
}

state briefing: "Briefs served" by applicant cite "Mass. R. A. P. 19(a)"
{
  note "The appellant serves and files a brief and appendix within 40 days after the appeal is docketed; the appellee within 30 days after service of the appellant's brief; a reply brief, except by leave, by the earlier of 14 days after service of the appellee's brief or 7 days before argument (Mass. R. A. P. 19(a)). A principal brief is limited to 11,000 words in a proportional font or 50 pages in a monospaced font, a reply brief to 4,500 words or 20 pages (Mass. R. A. P. 20(a)(2))."
  edge-briefing-argue "Briefing complete" -> argument { authority cite "Mass. R. A. P. 22(a)" }
}

state argument: "Oral argument or submission" by court cite "Mass. R. A. P. 22(a)"
{
  note "The clerk advises the parties of the time and place of argument; unless enlarged or limited, each side has 15 minutes (Mass. R. A. P. 22(a), (b))."
  edge-argument-decide "Decision released" -> decision { event DecisionFiled() authority cite "Mass. R. A. P. 23(a)" }
}

decision decision: "Appeals Court decision" by court cite "Mass. R. A. P. 23(a)"
{
  note "The clerk sends the parties the rescript and any written decision on the day the decision is released (Mass. R. A. P. 23(a)). Affirmance and reversal both move to the post-decision step; the outcome is read from the side of the appellant."
  edge-decision-affirmed "Affirmed" -> post-decision { authority cite "Mass. R. A. P. 23(a)" }
  edge-decision-reversed "Reversed or vacated" -> post-decision-reversed {
    authority cite "Mass. R. A. P. 23(a)"
  }
}

decision post-decision: "Reconsideration or further appellate review sought?" by applicant cite "Mass. R. A. P. 27.1(a)"
{
  note "Within 14 days after the decision any party may move for reconsideration or modification, stating with particularity what the court overlooked or misapprehended, in not more than 10 pages or 2,000 words (Mass. R. A. P. 27(a), (b)). Within 21 days after the decision any party may apply to the Supreme Judicial Court for further appellate review on substantial reasons affecting the public interest or the interests of justice (Mass. R. A. P. 27.1(a)); any other party may respond within 14 days after the application is filed (Mass. R. A. P. 27.1(c)). A timely motion or application stays the rescript (Mass. R. A. P. 23(c))."
  edge-post-decision-far "Application for further appellate review" -> review-applied { event ReviewPetitionFiled()
    authority cite "Mass. R. A. P. 27.1(a)"
  }
  edge-post-decision-none "No motion or application" -> rescript-affirmed {
    authority cite "Mass. R. A. P. 23(b)"
  }
}

decision post-decision-reversed: "Appellee seeks further review?" by court cite "Mass. R. A. P. 27.1(a)"
{
  note "After a reversal the appellee may move for reconsideration within 14 days (Mass. R. A. P. 27(a)) or apply for further appellate review within 21 days (Mass. R. A. P. 27.1(a)); otherwise the rescript issues 28 days after the decision (Mass. R. A. P. 23(b))."
  edge-post-decision-reversed-far "Application allowed" -> review-granted {
    authority cite "Mass. R. A. P. 27.1(a)"
  }
  edge-post-decision-reversed-final "No application, or application denied" -> rescript-reversed {
    authority cite "Mass. R. A. P. 23(c)"
  }
}

terminal review-applied: "Application for further appellate review filed" outcome [appeal] cite "Mass. R. A. P. 27.1(a)"
{
  note "Within 21 days after the decision a party applies to the Supreme Judicial Court for further appellate review (Mass. R. A. P. 27.1(a)); a timely application stays the rescript (Mass. R. A. P. 23(c)). The application and its disposition are the Supreme Judicial Court's: lit/ma-sjc."
}

terminal rescript-affirmed: "Rescript issues: judgment affirmed" outcome [loss, judgment] cite "Mass. R. A. P. 23(b)"
{
  note "The rescript and decision issue to the lower court 28 days after the decision unless the time is shortened or enlarged by order, or forthwith after a stayed motion or application is disposed of (Mass. R. A. P. 23(b), (c))."
}

terminal rescript-reversed: "Rescript issues: judgment reversed" outcome [win, judgment] cite "Mass. R. A. P. 23(b)"
{
  note "Further proceedings in the lower court on remand are not modeled."
}

terminal review-granted: "Further appellate review granted" outcome [appeal] cite "Mass. R. A. P. 27.1(a)"
{
  note "The case proceeds in the Supreme Judicial Court (briefing under Mass. R. A. P. 27.1(f)); its merits outcome is not modeled here."
}

terminal transferred: "Direct appellate review allowed: the appeal is transferred" outcome [appeal] cite "Mass. R. A. P. 11(g)"
{
  note "The appeal is briefed and decided in the Supreme Judicial Court (Mass. R. A. P. 11(g)): lit/ma-sjc."
}
