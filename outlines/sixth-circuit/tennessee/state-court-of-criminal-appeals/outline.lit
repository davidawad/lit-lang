// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
// Tennessee Court of Criminal Appeals.
module outline-tn-court-of-criminal-appeals

import outline-tn-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start invoked

state invoked: "Review invoked" by applicant cite ?("Tenn. R. App. P. 3(b), 4(a)") {
  note "OUTLINE. Tennessee's intermediate appellate court for criminal cases. It hears appeals as of right from criminal convictions and post-conviction proceedings; further review is by application for permission to appeal to the Tennessee Supreme Court (Tenn. R. App. P. 11; verify). Notice of appeal filed with the appellate court clerk; the period is a hole (?). The court may waive a late notice in a criminal case in the interest of justice (Tenn. R. App. P. 4(a); verify)."
  edge-invoked-proceeds "Jurisdiction accepted" -> record-prepared { event NoticeOfAppealFiled()
    authority cite ?("Tenn. R. App. P. 3(b)")
  }
  edge-invoked-dismissed "Untimely or not reviewable; dismissed" -> review-dismissed {
    authority cite ?("Tenn. R. App. P. 4(a)")
  }
}

state record-prepared: "Record filed" by office cite ?("Tenn. R. App. P. 24, 25") {
  note "OUTLINE. Record and transcript periods are holes (?)."
  edge-record-prepared-briefing "Record complete" -> briefing { event RecordFiled()
    authority cite ?("Tenn. R. App. P. 27, 29")
  }
}

state briefing: "Briefing" by applicant cite ?("Tenn. R. App. P. 27, 29") {
  note "OUTLINE. Brief periods, length limits and extension practice are holes (?). Key decisions (verify): State v. Bledsoe, 226 S.W.3d 349 (Tenn. 2007) (sufficiency review); State v. Rodriguez, 254 S.W.3d 361 (Tenn. 2008) (harmless error)."
  edge-briefing-submitted "Briefs filed" -> argument { authority cite ?("Tenn. R. App. P. 35") }
}

decision argument: "Oral argument or submission on briefs" by court cite ?("Tenn. R. App. P. 35") {
  note "OUTLINE. Whether argument is granted, and its time limits, are holes."
  edge-argument-argued "Argued" -> decision { authority cite ?("Tenn. R. App. P. 35") }
  edge-argument-submitted "Submitted on the briefs" -> decision {
    authority cite ?("Tenn. R. App. P. 35")
  }
}

decision decision: "Decision" by court cite ?("Tenn. Ct. Crim. App. R. 20") {
  note "OUTLINE. Standards of review (sufficiency, harmless error) are holes until verified. Key decision (verify): Jackson v. Virginia, 443 U.S. 307 (1979)."
  edge-decision-affirmed "Conviction affirmed" -> after-affirmance {
    authority cite ?("Tenn. Ct. Crim. App. R. 20")
  }
  edge-decision-reversed "Reversed or remanded" -> conviction-reversed {
    authority cite ?("Tenn. R. App. P. 42")
  }
}

decision after-affirmance: "Rehearing, further review or mandate" by applicant cite ?("Tenn. R. App. P. 39") {
  note "OUTLINE. The rehearing and further-review periods are holes (?)."
  edge-after-affirmance-rehearing "Motion for rehearing" -> rehearing {
    authority cite ?("Tenn. R. App. P. 39")
  }
  edge-after-affirmance-further "Further review sought" -> further-review {
    authority cite ?("Tenn. R. App. P. 11")
  }
  edge-after-affirmance-mandate "Mandate issues" -> conviction-affirmed {
    authority cite ?("Tenn. R. App. P. 42")
  }
}

decision rehearing: "Rehearing ruling" by court cite ?("Tenn. R. App. P. 39") {
  note "OUTLINE. Grounds for rehearing are holes until verified."
  edge-rehearing-granted "Rehearing granted" -> decision { authority cite ?("Tenn. R. App. P. 39") }
  edge-rehearing-denied-further "Rehearing denied; further review sought" -> further-review {
    authority cite ?("Tenn. R. App. P. 11")
  }
  edge-rehearing-denied "Rehearing denied; mandate issues" -> conviction-affirmed {
    authority cite ?("Tenn. R. App. P. 42")
  }
}

terminal review-dismissed: "Review dismissed" outcome [loss] cite ?("Tenn. R. App. P. 4(a)") {
  note "OUTLINE. Payoff is a hole."
  payoff ?
}

terminal conviction-affirmed: "Conviction affirmed; mandate issued" outcome [loss] cite ?("Tenn. R. App. P. 42") {
  note "OUTLINE. Collateral review is a hole (verify). Payoff is a hole."
  payoff ?
}

terminal conviction-reversed: "Conviction reversed or remanded" outcome [win] cite ?("Tenn. R. App. P. 42") {
  note "OUTLINE. Retrial or resentencing on remand is a hole. Payoff is a hole."
  payoff ?
}

terminal further-review: "Further review sought" outcome [appeal] cite ?("Tenn. R. App. P. 11") {
  note "OUTLINE. Payoff is a hole."
  payoff ?
}
