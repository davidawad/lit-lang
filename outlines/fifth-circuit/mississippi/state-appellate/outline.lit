// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-ms-state-appellate

start judgment-signed

state judgment-signed: "Judgment signed" by applicant cite ?("Miss. R. Civ. P. 58")
{
  note "OUTLINE. Appeal lies from a final judgment (verify). Interlocutory appeal rules are a hole (verify)."
  edge-judgment-signed-notice "Appeal taken within delay" -> notice-filed {
    authority cite ?("Miss. R. App. P. 4(a)")
  }
  edge-judgment-signed-late "Delay missed" -> time-barred {
    authority cite ?("Miss. R. App. P. 4(a)")
  }
}

state notice-filed: "Appeal taken" by applicant cite ?("Miss. R. App. P. 3")
{
  note "OUTLINE. Notice of appeal within 30 days after entry of judgment (Rule 4(a); period verify). Tolling by post-judgment motion (verify)."
  edge-notice-filed-record "Record lodged" -> record-lodged {
    authority cite ?("Miss. R. App. P. 10")
  }
}

state record-lodged: "Record lodged" by office cite ?("Miss. R. App. P. 10")
{
  note "OUTLINE. Record contents and transcript deadlines are holes (?)."
  edge-record-lodged-briefs "Briefing schedule set" -> briefing {
    authority cite ?("Miss. R. App. P. 28")
  }
}

state briefing: "Briefs filed" by applicant cite ?("Miss. R. App. P. 28")
{
  note "OUTLINE. Brief length and format are holes until verified against the court's rules."
  edge-briefing-argument "Argument set" -> argument {
    authority cite ?("Miss. R. App. P. 34")
  }
  edge-briefing-submitted "Submitted on briefs" -> appellate-decision {
    authority cite ?("Miss. R. App. P. ?")
  }
}

state argument: "Oral argument" by office cite ?("Miss. R. App. P. 34")
{
  note "OUTLINE. Argument practice and time are holes until verified."
  edge-argument-decision "Argued" -> appellate-decision {
    authority cite ?("Miss. R. App. P. ?")
  }
}

decision appellate-decision: "Appellate decision" by court cite ?("Miss. R. App. P. ?")
{
  note "OUTLINE. Standard of review is a hole until verified. Disposition rule number is a hole (?). Assignment between the Supreme Court and the Court of Appeals is a hole until verified."
  edge-decision-affirmed "Affirmed" -> affirmed {
    authority cite ?("Miss. R. App. P. ?")
  }
  edge-decision-reversed "Reversed or amended" -> reversed {
    authority cite ?("Miss. R. App. P. ?")
  }
  edge-decision-remanded "Remanded" -> remanded {
    authority cite ?("Miss. R. App. P. ?")
  }
  edge-decision-dismissed "Appeal dismissed" -> appeal-dismissed {
    authority cite ?("Miss. R. App. P. ?")
  }
  edge-decision-rehearing "Rehearing sought" -> rehearing-filed {
    authority cite ?("Miss. R. App. P. 40")
  }
}

state rehearing-filed: "Application for rehearing" by applicant cite ?("Miss. R. App. P. 40")
{
  note "OUTLINE. Rehearing period is a hole (?). Denial or grant is a hole until verified."
  edge-rehearing-supreme "Rehearing denied; review sought" -> supreme-review {
    authority cite ?("Miss. R. App. P. 16")
  }
  edge-rehearing-decision "Rehearing granted" -> appellate-decision {
    authority cite ?("Miss. R. App. P. ?")
  }
}

state supreme-review: "Review or writ application to supreme court" by applicant cite ?("Miss. R. App. P. 16")
{
  note "OUTLINE. Petition for certiorari to the Mississippi Supreme Court (Rule 16; verify). Timing is a hole (?)."
  edge-supreme-review-denied "Review denied" -> review-denied {
    authority cite ?("Miss. R. App. P. 16")
  }
  edge-supreme-review-granted "Review granted" -> supreme-decided {
    authority cite ?("Miss. R. App. P. 16")
  }
}

terminal time-barred: "Appeal time missed" outcome [loss] cite ?("Miss. R. App. P. 4(a)")
{
  note "OUTLINE. Delay is generally jurisdictional or near-jurisdictional (verify)."
  payoff ?
}

terminal affirmed: "Affirmed" outcome [loss] cite ?("Miss. R. App. P. ?")
{
  note "OUTLINE. Further review: see supreme-review."
  payoff ?
}

terminal reversed: "Reversed or amended" outcome [win] cite ?("Miss. R. App. P. ?")
{
  note "OUTLINE. Fees and costs are holes."
  payoff ?
}

terminal remanded: "Remanded" outcome [neutral] cite ?("Miss. R. App. P. ?")
{
  note "OUTLINE. Remand outcome depends on the trial court's next ruling."
  payoff ?
}

terminal appeal-dismissed: "Appeal dismissed" outcome [loss] cite ?("Miss. R. App. P. ?")
{
  note "OUTLINE. Grounds for dismissal are holes until verified."
  payoff ?
}

terminal review-denied: "Review denied" outcome [loss] cite ?("Miss. R. App. P. 16")
{
  note "OUTLINE. Denial of review ends the state appeal path."
  payoff ?
}

terminal supreme-decided: "Supreme court decided" outcome [neutral] cite ?("Miss. R. App. P. 16")
{
  note "OUTLINE. Outcome is a hole until the decision is known."
  payoff ?
}
