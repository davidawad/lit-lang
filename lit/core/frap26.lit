module core.frap26

import core.calendar.{ us-federal-holidays }

/// FRAP 26 from the rules' effective date, July 1, 1968: "based upon FRCP
/// 6(a), (b) and (e)" (1967 Advisory Committee Note), so periods under 7
/// days skip weekends and legal holidays (the rule the 1996 and 2002 notes
/// describe) and mail service adds 3 days.
counting frap26 effective [1968-07-01, 1989-12-01) known_at 1967-12-04 cite "FRAP (2008 ed.) 26 (1967 Advisory Committee Note)" historical
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday]
  short_period { below: 7.days, count: business_days }
  service_extension {
    Personal: 0.days
    Electronic: unrecognized
    Mail: 3.days
    Clerk: unrecognized
    OtherConsented: unrecognized
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  }
  holidays us-federal-holidays
  forums [frap, cafc]
}

/// The 1989 amendment: a last day the clerk's office is inaccessible rolls
/// forward (1989 Advisory Committee Note).
counting frap26 effective [1989-12-01, 1996-12-01) known_at 1989-04-25 supersedes frap26@1968-07-01 cite "FRAP (2008 ed.) 26 (1989 Advisory Committee Note)" historical
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  short_period { below: 7.days, count: business_days }
  service_extension {
    Personal: 0.days
    Electronic: unrecognized
    Mail: 3.days
    Clerk: unrecognized
    OtherConsented: unrecognized
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  }
  holidays us-federal-holidays
  forums [frap, cafc]
}

/// The 1996 amendment: the 3 days follow any service delivered after the
/// date its proof states, commercial carrier included (1996 Advisory
/// Committee Note).
counting frap26 effective [1996-12-01, 2002-12-01) known_at 1996-04-23 supersedes frap26@1989-12-01 cite "FRAP (2008 ed.) 26(c)" historical
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  short_period { below: 7.days, count: business_days }
  service_extension {
    Personal: 0.days
    Electronic: unrecognized
    Mail: 3.days
    Clerk: unrecognized
    OtherConsented: unrecognized
    CommercialCarrier: 3.days
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  }
  holidays us-federal-holidays
  forums [frap, cafc]
}

/// The 2002 amendment: the short-period exclusion reaches periods under 11
/// days, as in FRCP 6(a) (2002 Committee Note). Electronic service also
/// gains the 3 days: "a paper that is served electronically is not treated
/// as delivered on the date of service stated in the proof of service"
/// (26(c), 2008 ed.). A paper delivered on that date (personal delivery)
/// gets none. The 2008 edition prints the text as amended December 1,
/// 2005, which only renamed "Presidents' Day" back to "Washington's
/// Birthday" (2005 Committee Note): a later text, cited for 2002-2005 on
/// purpose.
counting frap26 effective [2002-12-01, 2009-12-01) known_at 2002-04-29 supersedes frap26@1996-12-01 cite "FRAP (2008 ed.) 26(a)(2)" historical
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  short_period { below: 11.days, count: business_days }
  service_extension {
    Personal: 0.days
    Electronic: 3.days
    Mail: 3.days
    Clerk: unrecognized
    OtherConsented: unrecognized
    CommercialCarrier: 3.days
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRAP (2008 ed.) 26(c)"
  holidays us-federal-holidays
  forums [frap, cafc]
}

/// FRAP 26 as amended December 1, 2009 (2009 Committee Note): every day
/// counts (26(a)(1)), periods may be stated in hours (26(a)(2)), and the
/// clerk's office inaccessibility rule is 26(a)(3). 26(c) adds 3 days after
/// a paper is mailed, sent by commercial carrier, or deposited in a prison
/// mailing system, and after electronic service, which "is not treated as
/// delivered on the date of service stated in the proof of service" (2011
/// ed.).
counting frap26 effective [2009-12-01, 2016-12-01) known_at 2009-03-26 supersedes frap26@2002-12-01 cite "FRAP (2011 ed.) 26(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 3.days
    Mail: 3.days
    Clerk: unrecognized
    OtherConsented: unrecognized
    CommercialCarrier: 3.days
    PrisonMail: 3.days
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRAP (2011 ed.) 26(c)"
  holidays us-federal-holidays
  forums [frap, cafc]
  allow_hours
}

/// The 2016 amendment (adopted April 28, 2016, effective December 1, 2016):
/// a paper served electronically "is treated as delivered on the date of
/// service stated in the proof of service", so electronic service adds
/// nothing (Committee Note: "to remove service by electronic means under
/// Rule 25(c)(1)(D) from the modes of service that allow 3 added days");
/// restyled in 2019 as "not served electronically on the party or delivered
/// to the party on the date stated in the proof of service". The text is
/// the 2017 edition's: the 2018 amendment only "adjust[s] references to
/// subdivisions of Rule 25 that have been renumbered" and the 2019 one
/// "simplifies the expression of the current rules for when three days
/// are added" (Committee Notes), neither a change to the count.
counting frap26 effective [2016-12-01, 2023-12-01) known_at 2016-04-28 supersedes frap26@2009-12-01 cite "FRAP (2017 ed.) 26(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: unrecognized
    OtherConsented: unrecognized
    CommercialCarrier: 3.days
    PrisonMail: 3.days
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRAP (2017 ed.) 26(c)"
  holidays us-federal-holidays
  forums [frap, cafc]
  allow_hours
}

/// The 2023 amendment (adopted April 24, 2023, effective December 1, 2023)
/// adds Juneteenth National Independence Day to 26(a)(6)(A)'s list. The
/// count is unchanged: `us-federal-holidays` has observed it since June 17,
/// 2021, when Congress declared it a holiday (26(a)(6)(B)).
counting frap26 effective [2023-12-01, ..) known_at 2023-04-24 supersedes frap26@2016-12-01 cite "FRAP 26(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: unrecognized
    OtherConsented: unrecognized
    CommercialCarrier: 3.days
    PrisonMail: 3.days
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRAP 26(c)"
  holidays us-federal-holidays
  forums [frap, cafc]
  allow_hours
}
