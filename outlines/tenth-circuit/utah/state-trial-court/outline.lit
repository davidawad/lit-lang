// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
// Outcome tags are labels only; payoff is a hole. Rule numbers are from memory: verify each.
module outline-ut-trial-court

import outline-ut-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start complaint-filed

state complaint-filed: "Complaint Filed" by applicant cite ?("URCP 3")
{
  note "OUTLINE. Commencement of a civil action in Utah district court. Rule numbers from memory; verify against official text."
  edge-complaint-filed-service "Summons issued and served" -> service-check { event ActionCommenced()
    authority cite ?("URCP 4")
  }
}

decision service-check: "Service Within Required Period" by office cite ?("URCP 4")
{
  note "OUTLINE. Service period is a hole. Rule numbers from memory; verify against official text."
  edge-service-check-served "Served" -> answer-due { event ActionCommenced()
    authority cite ?("URCP 12(a)")
  }
  edge-service-check-unserved "Not served in time" -> dismissed-unserved {
    authority cite ?("URCP 4")
  }
}

decision answer-due: "Answer, Motion or Default" by office cite ?("URCP 12(a)")
{
  note "OUTLINE. Response period is a hole. Rule numbers from memory; verify against official text."
  edge-answer-due-default "No response" -> default-entered {
    authority cite ?("URCP 55(a)")
  }
  edge-answer-due-motion "Pleading motion filed" -> pleading-motion {
    authority cite ?("URCP 12(b)(6)")
  }
  edge-answer-due-answer "Answer filed" -> case-management {
    authority cite ?("URCP 16")
  }
}

decision pleading-motion: "Pleading Motion Decided" by court cite ?("URCP 12(b)(6)")
{
  note "OUTLINE. Leading decisions (verify): none named in this pass (verify). Rule numbers from memory; verify against official text."
  edge-pleading-motion-dismissed "Granted with prejudice" -> dismissed-pleading {
    authority cite ?("URCP 12(b)(6)")
  }
  edge-pleading-motion-leave "Granted with leave to amend" -> case-management {
    authority cite ?("URCP 15")
  }
  edge-pleading-motion-denied "Denied" -> case-management {
    authority cite ?("URCP 12(b)(6)")
  }
}

terminal default-entered: "Default Entered" outcome [loss] cite ?("URCP 55(a)")
{
  note "OUTLINE. Default judgment and setting aside default are not modeled. Rule numbers from memory; verify against official text."
  payoff ?
}

terminal dismissed-unserved: "Dismissed for Failure to Serve" outcome [loss, dismissal] cite ?("URCP 4")
{
  note "OUTLINE. Dismissal for untimely service (verify)."
  payoff ?
}

terminal dismissed-pleading: "Dismissed on Pleading Motion" outcome [win, dismissal] cite ?("URCP 12(b)(6)")
{
  note "OUTLINE. Dismissal on the pleadings (verify standard)."
  payoff ?
}

state case-management: "Case Management and Scheduling" by court cite ?("URCP 16")
{
  note "OUTLINE. Scheduling and case-management order is a hole. Rule numbers from memory; verify against official text."
  edge-case-management-discovery "Scheduling order entered" -> discovery {
    authority cite ?("URCP 26")
  }
}

state discovery: "Discovery" by applicant cite ?("URCP 26")
{
  note "OUTLINE. Discovery scope and sanctions for failure to make discovery (verify). Rule numbers from memory; verify against official text."
  edge-discovery-sj "Discovery closed" -> sj-motion {
    authority cite ?("URCP 56")
  }
  edge-discovery-settle "Settled during discovery" -> settled {
    authority cite ?("URCP 41")
  }
}

decision sj-motion: "Summary Judgment Motion Decided" by court cite ?("URCP 56")
{
  note "OUTLINE. Leading decisions (verify): Orvis v. Johnson, 2008 UT 2 (summary judgment) (verify). Rule numbers from memory; verify against official text."
  edge-sj-motion-granted "Granted" -> judgment-for-movant {
    authority cite ?("URCP 56")
  }
  edge-sj-motion-denied "Denied or partly denied" -> trial {
    authority cite ?("URCP 16")
  }
}

terminal judgment-for-movant: "Judgment for Movant on Summary Judgment" outcome [win, judgment] cite ?("URCP 56")
{
  note "OUTLINE. Partial summary judgment is not modeled."
  payoff ?
}

state trial: "Trial or Bench Decision" by court cite ?("URCP 38")
{
  note "OUTLINE. Jury demand and trial setting are holes. Rule numbers from memory; verify against official text."
  edge-trial-post "Verdict or decision" -> post-trial { event JudgmentEntered()
    authority cite ?("URCP 50(b)")
  }
}

decision post-trial: "Post-Trial Motions Decided" by court cite ?("URCP 50(b)")
{
  note "OUTLINE. Post-trial motions: judgment as a matter of law, new trial and relief from judgment. Time limits are holes. Rule numbers from memory; verify against official text."
  edge-post-trial-judgment "Motions resolved or none filed" -> judgment-entered { event JudgmentEntered()
    authority cite ?("URCP 58A")
  }
  edge-post-trial-jmol "Judgment as a matter of law granted" -> judgment-for-movant {
    authority cite ?("URCP 50(b)")
  }
}

state judgment-entered: "Judgment Entered" by office cite ?("URCP 58A")
{
  note "OUTLINE. Entry of judgment rule governs when the appeal clock starts. Rule numbers from memory; verify against official text."
  edge-judgment-entered-appeal "Next step" -> appeal-decision {
    authority cite ?("URAP 4")
  }
}

decision appeal-decision: "Notice of Appeal Within Time?" by applicant cite ?("URAP 4")
{
  note "OUTLINE. Notice of appeal period and form are holes. Rule numbers from memory; verify against official text."
  edge-appeal-decision-taken "Notice filed" -> appeal-taken { event NoticeOfAppealFiled()
    authority cite ?("URAP 4")
  }
  edge-appeal-decision-none "No notice filed" -> final-no-appeal {
    authority cite ?("URAP 4")
  }
}

terminal appeal-taken: "Appeal to Appellate Court" outcome [appeal] cite ?("URAP 4")
{
  note "OUTLINE. Continue in the state's appellate court packages."
  payoff ?
}

terminal final-no-appeal: "Final: No Appeal" outcome [final] cite ?("URAP 4")
{
  note "OUTLINE. Final judgment with no notice filed in time."
  payoff ?
}

terminal settled: "Settled or Stipulated Dismissal" outcome [settlement] cite ?("URCP 41")
{
  note "OUTLINE. Settlement or voluntary dismissal; terms are not modeled."
  payoff ?
}
