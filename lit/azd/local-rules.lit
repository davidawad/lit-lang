{
  given JuryTrialBegins() on 2027-02-02
  expect deadline(jury-fee-settlement-notice-period) == 2027-01-28
}

test "draft findings period: 7 days after the trigger" cite "D. Ariz. LRCiv 52.1"
{
  given DecisionRendered() on 2026-11-02
  expect deadline(draft-findings-period) == 2026-11-09
}

