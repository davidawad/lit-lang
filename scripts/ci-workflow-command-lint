#!/usr/bin/env python3
"""Check workflow shell commands against runner and job-installed tools."""
import json
import os
import re
import sys

try:
    import yaml
except ImportError as error:
    raise SystemExit("workflow command lint requires PyYAML") from error

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
with open(os.path.join(ROOT, ".github/runner-command-allowlist.json"), encoding="utf-8") as source:
    ALLOW = json.load(source)
ISSUES = []
CONTROL = {"if", "then", "elif", "else", "fi", "for", "while", "do", "done", "case", "esac", "function", "!"}
BUILTINS = {"[", "]]", ".", ":", "break", "cd", "command", "continue", "eval", "exec", "exit", "export", "local", "read", "return", "set", "shift", "source", "trap", "ulimit", "unset"}


def _shell_commands(script):
    """Yield shell command words, preserving command positions across nesting."""
    # Remove heredoc bodies while keeping the command line that declares them.
    lines = []
    delimiter = None
    for line in script.splitlines():
        if delimiter is not None:
            if line.strip() == delimiter:
                delimiter = None
            continue
        lines.append(line)
        marker = re.search(r"<<-?\s*['\"]?([A-Za-z_][A-Za-z0-9_]*)", line)
        if marker:
            delimiter = marker.group(1)
    script = "\n".join(lines)
    # Workflow steps execute shell. Don't recursively inspect non-shell source
    # files that happen to be invoked by a script (Ruby formula / Python code).
    tokens = []
    word = []
    quote = None
    escaped = False
    i = 0
    while i < len(script):
        char = script[i]
        if escaped:
            word.append(char)
            escaped = False
            i += 1
            continue
        if char == "\\" and quote != "'":
            escaped = True
            i += 1
            continue
        if quote:
            if char == quote:
                quote = None
            elif char == "$" and script[i:i + 2] == "$(":
                body, i = _substitution(script, i + 2)
                tokens.extend(("SUB", body))
                continue
            else:
                word.append(char)
            i += 1
            continue
        if char in "'\"":
            quote = char
            i += 1
            continue
        if char == "#" and (i == 0 or script[i - 1].isspace()):
            while i < len(script) and script[i] != "\n":
                i += 1
            continue
        if char == "$" and script[i:i + 2] == "$(":
            if word:
                tokens.append("".join(word)); word = []
            body, i = _substitution(script, i + 2)
            tokens.extend(("SUB", body))
            continue
        if char in ";&|\n":
            if word:
                tokens.append("".join(word)); word = []
            if char in "&|" and i + 1 < len(script) and script[i + 1] == char:
                i += 1
            tokens.append(char)
            i += 1
            continue
        if char.isspace():
            if word:
                tokens.append("".join(word)); word = []
        else:
            word.append(char)
        i += 1
    if word:
        tokens.append("".join(word))
    return tokens


def _substitution(script, start):
    depth = 1
    quote = None
    escaped = False
    i = start
    while i < len(script):
        char = script[i]
        if escaped:
            escaped = False
        elif char == "\\" and quote != "'":
            escaped = True
        elif quote:
            if char == quote:
                quote = None
        elif char in "'\"":
            quote = char
        elif script[i:i + 2] == "$(":
            depth += 1; i += 1
        elif char == ")":
            depth -= 1
            if depth == 0:
                return script[start:i], i + 1
        i += 1
    return script[start:], len(script)


def commands(script):
    result = []
    tokens = _shell_commands(str(script))
    start = True
    skip_test = False
    i = 0
    while i < len(tokens):
        token = tokens[i]
        if token == "SUB":
            result.extend(commands(tokens[i + 1]))
            i += 2
            continue
        if token in {";", "&", "|", "\n"}:
            start = True
            i += 1
            continue
        if token in {"then", "do", "else", "elif"}:
            start = True
            i += 1
            continue
        if token in {"if", "while", "until", "!", "{"}:
            start = token in {"if", "while", "until"}
            i += 1
            continue
        if token in {"fi", "done", "}", "case", "esac", "for", "in"}:
            start = False
            i += 1
            continue
        if token in {"major)", "minor)", "patch)", "none)", "*)"}:
            start = True
            i += 1
            continue
        if token == "function" or token.endswith("()") or token in {"roots", "raise", "rank", "+"}:
            start = False
            i += 1
            continue
        if token.startswith("(") or token.endswith("{"):
            i += 1
            continue
        if skip_test:
            skip_test = token != "]"
            if token == "]]": skip_test = False
            i += 1
            continue
        if start:
            if token == "command":
                i += 1
                while i < len(tokens) and tokens[i] in {"-v", "-V", "--"}: i += 1
                start = True
                continue
            if token in {"[", "[["}:
                skip_test = True
                i += 1
                continue
            if re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", token):
                i += 1
                continue
            result.append(token)
            start = False
        i += 1
    return result


def lint_script(text, path, allowed, depth, seen):
    for token in commands(text):
        name = token.split("=", 1)[-1] if re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", token) else token
        name = name.split()[0].strip("\"'`$;,")
        if not name or name.startswith(("-", ">", "<")) or name in BUILTINS or re.fullmatch(r"\d+\)?", name) or name.endswith("()"):
            continue
        if name.startswith("scripts/") and depth:
            candidate = os.path.join(ROOT, name)
            if name.endswith((".sh", ".bash")) and os.path.isfile(candidate) and candidate not in seen:
                seen.add(candidate)
                with open(candidate, encoding="utf-8") as source:
                    lint_script(source.read(), name, allowed, depth - 1, seen)
            continue
        if "/" in name or name in allowed:
            continue
        ISSUES.append(f"{path}: command {name!r} is not available on this runner")


for workflow_path in sorted(os.path.join(ROOT, ".github/workflows", name) for name in os.listdir(os.path.join(ROOT, ".github/workflows")) if name.endswith(".yml")):
    with open(workflow_path, encoding="utf-8") as source:
        workflow = yaml.safe_load(source)
    for job in (workflow.get("jobs") or {}).values():
        runner = str(job.get("runs-on", ""))
        if "${{ matrix.os }}" in runner:
            runner = "ubuntu-latest"  # release matrix currently declares ubuntu and macOS
        allowed = set(ALLOW.get(runner, ALLOW["default"]))
        installed = set()
        for step in job.get("steps", []):
            if not isinstance(step, dict):
                continue
            action = str(step.get("uses", ""))
            settings = step.get("with") or {}
            if "rust-toolchain" in action:
                installed.update({"cargo", "rustc", "rustup", "rustfmt", "clippy"})
                installed.update(str(settings.get("components", "")).replace(",", " ").split())
            elif "install-action" in action:
                installed.update(item.split("@")[0] for item in str(settings.get("tool", "")).split(","))
            elif "setup-node" in action:
                installed.update({"node", "npm", "npx", "corepack"})
            elif "install-nix-action" in action:
                installed.add("nix")
            script = step.get("run")
            if script is None:
                continue
            script = re.sub(r"\$\{\{[^}]*\}\}", "placeholder", str(script))
            for package in re.findall(r"apt-get\s+install[^\n]*", script):
                installed.update(word for word in package.split() if re.fullmatch(r"[a-z0-9][a-z0-9+.-]*", word) and word not in {"apt-get", "install", "update", "sudo", "y"})
            lint_script(script, os.path.basename(workflow_path), allowed | installed, 1, set())
            if re.search(r"\bcargo\s+build\b[^\n]*-p\s+litigate-cli", script):
                installed.add("litigate")
            installed.update(crate.replace("_", "-") for crate in re.findall(r"cargo\s+install\s+(?:[^\n]*?\s)?([A-Za-z0-9_-]+)", script))

if ISSUES:
    for issue in sorted(set(ISSUES)):
        print(issue, file=sys.stderr)
    raise SystemExit(1)
print("workflow command lint: pass")
