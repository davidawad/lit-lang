module change-deadline-frcp-2009-amendment.periods

import change-deadline-frcp-base.periods.{
  JudgmentEntered,
  ClassOrderEntered,
  new-trial-motion,
  alter-amend-motion,
  renewed-jmol-motion,
  class-appeal-petition,
}

import core.frcp6.{ frcp6 }

// An amendment versions base text (docs/litigate/CHANGE.md §2.2): each
// declaration supersedes the base's from the effective date the order
// fixes. The order's pending-case clause ("insofar as just and
// practicable") is not modelled here: a matter's period is the one in
// force on its trigger's date (docs/litigate/CHANGE-REPORT.md).
/// FRCP 59(b) as amended effective December 1, 2009: 28 days.
deadline new-trial-motion-2009: 28.days after JudgmentEntered() counted_by frcp6 effective [2009-12-01, ..) known_at 2009-03-26 supersedes new-trial-motion cite "FRCP (2009) 59(b)"
{
  extend { never cite "FRCP (2009) 6(b)(2)" }
}

/// FRCP 59(e) as amended effective December 1, 2009: 28 days.
deadline alter-amend-motion-2009: 28.days after JudgmentEntered() counted_by frcp6 effective [2009-12-01, ..) known_at 2009-03-26 supersedes alter-amend-motion cite "FRCP (2009) 59(e)"
{
  extend { never cite "FRCP (2009) 6(b)(2)" }
}

/// FRCP 50(b) as amended effective December 1, 2009: 28 days.
deadline renewed-jmol-motion-2009: 28.days after JudgmentEntered() counted_by frcp6 effective [2009-12-01, ..) known_at 2009-03-26 supersedes renewed-jmol-motion cite "FRCP (2009) 50(b)"
{
  extend { never cite "FRCP (2009) 6(b)(2)" }
}

/// FRCP 23(f) as amended effective December 1, 2009: 14 days.
deadline class-appeal-petition-2009: 14.days after ClassOrderEntered() counted_by frcp6 effective [2009-12-01, ..) known_at 2009-03-26 supersedes class-appeal-petition cite "FRCP (2009) 23(f)"

test "from December 1, 2009 a new-trial motion is due 28 days after entry" cite "FRCP (2009) 59(b)"
{
  given JudgmentEntered() on 2025-03-03
  expect deadline(new-trial-motion-2009) == 2025-03-31
}

test "from December 1, 2009 a Rule 59(e) motion is due 28 days after entry" cite "FRCP (2009) 59(e)"
{
  given JudgmentEntered() on 2025-03-03
  expect deadline(alter-amend-motion-2009) == 2025-03-31
}

test "from December 1, 2009 a renewed Rule 50(b) motion is due 28 days after entry" cite "FRCP (2009) 50(b)"
{
  given JudgmentEntered() on 2025-03-03
  expect deadline(renewed-jmol-motion-2009) == 2025-03-31
}

test "from December 1, 2009 a Rule 23(f) petition is due 14 days after the order" cite "FRCP (2009) 23(f)"
{
  given ClassOrderEntered() on 2025-03-03
  expect deadline(class-appeal-petition-2009) == 2025-03-17
}
