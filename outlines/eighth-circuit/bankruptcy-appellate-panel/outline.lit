// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-bap8

start notice-filed

state notice-filed: "Notice of appeal filed" by applicant cite ?("Fed. R. Bankr. P. 8001(a), 8002(a)")
{
  note "OUTLINE. Notice within the Rule 8002 period (hole). Interlocutory leave under Rule 8003 (verify)."
  edge-notice-filed-appealability "Notice filed" -> appealability {
    authority cite ?("Fed. R. Bankr. P. 8001(a), 8002(a)")
  }
}

decision appealability: "Appellate jurisdiction check" by court cite ?("Fed. R. Bankr. P. 8003 (verify)")
{
  note "OUTLINE. Appealability and timeliness: 28 U.S.C. 1291, 1292, 1294, 2107(a) and 158 (verify). Catlin v. United States, 324 U.S. 229 (1945) (verify); Bowles v. Russell, 551 U.S. 205 (2007) (verify). 28 U.S.C. 158(a) (verify)."
  edge-appealability-dismissed-jurisdiction "Not appealable, or untimely" -> dismissed-jurisdiction {
    authority cite ?("Fed. R. Bankr. P. 8003 (verify)")
  }
  edge-appealability-election "Appealable" -> election {
    authority cite ?("Fed. R. Bankr. P. 8003 (verify)")
  }
}

decision election: "Forum election" by applicant cite ?("Fed. R. Bankr. P. 8001(a)")
{
  note "OUTLINE. Choose district court, BAP, or direct certification to the court of appeals."
  edge-election-district-court-appeal "Appeal to district court" -> district-court-appeal {
    authority cite ?("Fed. R. Bankr. P. 8001(a)")
  }
  edge-election-record "Appeal to BAP" -> record {
    authority cite ?("Fed. R. Bankr. P. 8001(a)")
  }
  edge-election-certified-ca8 "Certified direct appeal" -> certified-ca8 {
    authority cite ?("Fed. R. Bankr. P. 8006")
  }
}

terminal dismissed-jurisdiction: "Dismissed for lack of appellate jurisdiction" outcome [loss] cite ?("Fed. R. Bankr. P. 8003 (verify)")
{
  note "OUTLINE. Outcome from the applicant's side."
  payoff ?
}

terminal district-court-appeal: "Appeal heard in district court" cite ?("Fed. R. Bankr. P. 8001(a)")
{
  note "OUTLINE. Hand-off to the federal-district package."
  payoff ?
}

terminal certified-ca8: "Certified to the court of appeals" cite ?("Fed. R. Bankr. P. 8006")
{
  note "OUTLINE. Hand-off to the court-of-appeals package."
  payoff ?
}

state record: "Record settled and transmitted" cite ?("Fed. R. Bankr. P. 8009")
{
  note "OUTLINE. Record under Rule 8009 (verify)."
  edge-record-briefing "Record filed" -> briefing {
    authority cite ?("Fed. R. Bankr. P. 8009")
  }
}

state briefing: "Briefing: opening, response, reply" cite ?("Fed. R. Bankr. P. 8018 (verify)")
{
  note "OUTLINE. Briefing schedule is a hole. Brief under Rule 8018 (verify); length is a hole."
  edge-briefing-argument "Briefs complete" -> argument {
    authority cite ?("Fed. R. Bankr. P. 8018 (verify)")
  }
}

state argument: "Oral argument or submission on briefs" cite ?("Fed. R. Bankr. P. 8019 (verify)")
{
  note "OUTLINE. Argument may be waived."
  edge-argument-disposition "Submitted for decision" -> disposition {
    authority cite ?("Fed. R. Bankr. P. 8019 (verify)")
  }
}

decision disposition: "Disposition" by court cite ?("Fed. R. Bankr. P. 8013 (verify)")
{
  note "OUTLINE. BAP disposition (verify)."
  edge-disposition-affirmed-entered "Affirmed" -> affirmed-entered {
    authority cite ?("Fed. R. Bankr. P. 8013 (verify)")
  }
  edge-disposition-reversed-entered "Reversed or vacated" -> reversed-entered {
    authority cite ?("Fed. R. Bankr. P. 8013 (verify)")
  }
  edge-disposition-remanded-entered "Remanded" -> remanded-entered {
    authority cite ?("Fed. R. Bankr. P. 8013 (verify)")
  }
}

decision affirmed-entered: "Affirmed: rehearing election" by applicant cite ?("Fed. R. Bankr. P. 8013 (verify)")
{
  note "OUTLINE. Rehearing and mandate clocks run from entry."
  edge-affirmed-entered-rehearing-affirmed "Rehearing petition filed" -> rehearing-affirmed {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
  edge-affirmed-entered-mandate-affirmed "No rehearing petition" -> mandate-affirmed {
    authority cite ?("Fed. R. Bankr. P. 8024 (verify)")
  }
}

decision rehearing-affirmed: "Rehearing ruling (affirmed)" by court cite ?("Fed. R. Bankr. P. 8022")
{
  note "OUTLINE. Rehearing under Rule 8022 (verify)."
  edge-rehearing-affirmed-mandate-affirmed "Rehearing denied" -> mandate-affirmed {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
  edge-rehearing-affirmed-disposition "Rehearing granted: re-decide" -> disposition {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
}

decision mandate-affirmed: "Mandate issued: further review election" by applicant cite ?("Fed. R. Bankr. P. 8024 (verify)")
{
  note "OUTLINE. Mandate and its effect on the trial court."
  edge-mandate-affirmed-review-affirmed "Further review sought" -> review-affirmed {
    authority cite ?("Fed. R. Bankr. P. 8006 (verify)")
  }
  edge-mandate-affirmed-affirmed-final "No further review" -> affirmed-final {
    authority cite ?("Fed. R. Bankr. P. 8024 (verify)")
  }
}

decision review-affirmed: "Further review ruling (affirmed)" by court cite ?("Fed. R. Bankr. P. 8006 (verify)")
{
  note "OUTLINE. Appeal to court of appeals under 28 U.S.C. 158(d)(1) (verify)."
  edge-review-affirmed-affirmed-final "Review denied" -> affirmed-final {
    authority cite ?("Fed. R. Bankr. P. 8006 (verify)")
  }
  edge-review-affirmed-affirmed-final-2 "Review granted: merits in high court" -> affirmed-final {
    authority cite ?("Fed. R. Bankr. P. 8006 (verify)")
  }
}

terminal affirmed-final: "Affirmed: final" outcome [loss] cite ?("Fed. R. Bankr. P. 8024 (verify)")
{
  note "OUTLINE. Outcome from the applicant's side."
  payoff ?
}

decision reversed-entered: "Reversed or vacated: rehearing election" by applicant cite ?("Fed. R. Bankr. P. 8013 (verify)")
{
  note "OUTLINE. Rehearing and mandate clocks run from entry."
  edge-reversed-entered-rehearing-reversed "Rehearing petition filed" -> rehearing-reversed {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
  edge-reversed-entered-mandate-reversed "No rehearing petition" -> mandate-reversed {
    authority cite ?("Fed. R. Bankr. P. 8024 (verify)")
  }
}

decision rehearing-reversed: "Rehearing ruling (reversed or vacated)" by court cite ?("Fed. R. Bankr. P. 8022")
{
  note "OUTLINE. Rehearing under Rule 8022 (verify)."
  edge-rehearing-reversed-mandate-reversed "Rehearing denied" -> mandate-reversed {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
  edge-rehearing-reversed-disposition "Rehearing granted: re-decide" -> disposition {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
}

decision mandate-reversed: "Mandate issued: further review election" by applicant cite ?("Fed. R. Bankr. P. 8024 (verify)")
{
  note "OUTLINE. Mandate and its effect on the trial court."
  edge-mandate-reversed-review-reversed "Further review sought" -> review-reversed {
    authority cite ?("Fed. R. Bankr. P. 8006 (verify)")
  }
  edge-mandate-reversed-reversed-final "No further review" -> reversed-final {
    authority cite ?("Fed. R. Bankr. P. 8024 (verify)")
  }
}

decision review-reversed: "Further review ruling (reversed or vacated)" by court cite ?("Fed. R. Bankr. P. 8006 (verify)")
{
  note "OUTLINE. Appeal to court of appeals under 28 U.S.C. 158(d)(1) (verify)."
  edge-review-reversed-reversed-final "Review denied" -> reversed-final {
    authority cite ?("Fed. R. Bankr. P. 8006 (verify)")
  }
  edge-review-reversed-reversed-final-2 "Review granted: merits in high court" -> reversed-final {
    authority cite ?("Fed. R. Bankr. P. 8006 (verify)")
  }
}

terminal reversed-final: "Reversed or vacated: final" outcome [win] cite ?("Fed. R. Bankr. P. 8024 (verify)")
{
  note "OUTLINE. Outcome from the applicant's side."
  payoff ?
}

decision remanded-entered: "Remanded: rehearing election" by applicant cite ?("Fed. R. Bankr. P. 8013 (verify)")
{
  note "OUTLINE. Rehearing and mandate clocks run from entry."
  edge-remanded-entered-rehearing-remanded "Rehearing petition filed" -> rehearing-remanded {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
  edge-remanded-entered-mandate-remanded "No rehearing petition" -> mandate-remanded {
    authority cite ?("Fed. R. Bankr. P. 8024 (verify)")
  }
}

decision rehearing-remanded: "Rehearing ruling (remanded)" by court cite ?("Fed. R. Bankr. P. 8022")
{
  note "OUTLINE. Rehearing under Rule 8022 (verify)."
  edge-rehearing-remanded-mandate-remanded "Rehearing denied" -> mandate-remanded {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
  edge-rehearing-remanded-disposition "Rehearing granted: re-decide" -> disposition {
    authority cite ?("Fed. R. Bankr. P. 8022")
  }
}

decision mandate-remanded: "Mandate issued: further review election" by applicant cite ?("Fed. R. Bankr. P. 8024 (verify)")
{
  note "OUTLINE. Mandate and its effect on the trial court."
  edge-mandate-remanded-review-remanded "Further review sought" -> review-remanded {
    authority cite ?("Fed. R. Bankr. P. 8006 (verify)")
  }
  edge-mandate-remanded-remanded-final "No further review" -> remanded-final {
    authority cite ?("Fed. R. Bankr. P. 8024 (verify)")
  }
