module ptab.deadlines

import core.authority.{ CaseOrder }
import mpep.deadlines.{ uspto-1-7 }

import ptab.{
  BoardDecision,
  ComplaintServed,
  DecisionEntered,
  FilingDateNoticed,
  IncompletePetitionNoticed,
  PatentGranted,
  PatentOwnerResponseFiled,
  PetitionerReplyFiled,
  PreliminaryResponseFiled,
  PreliminaryResponseWaived,
  TrialInstituted,
}

// Counting. A PTAB period counts calendar days, and a last day on a
// Saturday, Sunday or "Federal holiday within the District of Columbia"
// moves to the next business day: 37 C.F.R. § 1.7(a), which 37 C.F.R.
// § 42.1(a) applies to the Board ("Sections 1.4, 1.7, ... also apply to
// proceedings before the Board"; 35 U.S.C. § 21(b); 37 C.F.R. § 90.3(b)(2)
// for appeals). So these periods count under lit/mpep's `uspto-1-7`, the
// Office's own rule, not under a court's (no cross-forum borrowing). Its
// version is in force from December 18, 2013; a trigger between the AIA
// trial provisions' effective date and then has no counting rule. No PTAB
// trigger carries a service method, and § 1.7 recognizes none. Periods the
// statute or rule states in months or years ("9 months", "1 year", "three
// months", "one month") are calendar months: they end on the corresponding
// day of the later month, or on that month's last day when it has no such
// day (`end_of_month clamp`, as MPEP 710.01(a) counts the Office's months),
// and then roll like any period.
//
// Effective intervals. Every deadline states its window. The AIA trial
// provisions (35 U.S.C. §§ 314(b), 315(b), 321(c)) apply from September 16,
// 2012 (Pub. L. 112-29, § 6(c)(2)(A), 125 Stat. 284, enacted September 16,
// 2011: `known_at 2011-09-16`); the Part 42 trial rules took effect the same
// day (77 Fed. Reg. 48612 and 48680, published August 14, 2012: `known_at
// 2012-08-14`). Later versions follow the amendment dates in the vendored
// sections' history lines.
//
// Delegation. "Times set by rule are default and may be modified by order"
// (37 C.F.R. § 42.5(c)(1)), so every period a Part 42 rule sets is
// `delegable { to CaseOrder, op set }`. Statutory periods (35 U.S.C. §§ 314(b),
// 315(b), 321(c)) are not.
/// 35 U.S.C. § 321(c): a post-grant review petition may be filed no later
/// than "the date that is 9 months after the date of the grant".
rule duty pgr-filing-deadline cite "35 U.S.C. § 321(c)"
{
  deadline pgr-filing-period: 9.months after PatentGranted() counted_by uspto-1-7 effective [2012-09-16, ..) known_at 2011-09-16 cite "35 U.S.C. § 321(c)"
}

test "PGR window: 9 months from a March 4 grant end on December 4" cite "35 U.S.C. § 321(c)"
{
  given PatentGranted() on 2025-03-04
  expect deadline(pgr-filing-period) == 2025-12-04
}

test "PGR window: a last day on Martin Luther King Day rolls to Tuesday" cite "35 U.S.C. § 321(c)"
{
  given PatentGranted() on 2025-04-19
  expect deadline(pgr-filing-period) == 2026-01-20
}

test "PGR window: from May 31, February has no 31st; its last day is a Saturday" cite "35 U.S.C. § 321(c)"
{
  given PatentGranted() on 2025-05-31
  expect deadline(pgr-filing-period).nominal == 2026-02-28
  expect deadline(pgr-filing-period).adjusted == 2026-03-02
}

/// 35 U.S.C. § 315(b): no inter partes review is instituted on a petition
/// filed more than 1 year after the petitioner, its real party in interest,
/// or a privy is served with an infringement complaint.
rule duty ipr-time-bar-deadline cite "35 U.S.C. § 315(b)"
{
  deadline ipr-time-bar: 1.years after ComplaintServed() counted_by uspto-1-7 effective [2012-09-16, ..) known_at 2011-09-16 cite "35 U.S.C. § 315(b)"
}

test "315(b) bar: one year from service" cite "35 U.S.C. § 315(b)"
{
  given ComplaintServed() on 2025-03-03
  expect deadline(ipr-time-bar) == 2026-03-03
}

test "315(b) bar: a last day on observed Independence Day rolls to Monday" cite "35 U.S.C. § 315(b)"
{
  given ComplaintServed() on 2025-07-03
  expect deadline(ipr-time-bar) == 2026-07-06
}

test "315(b) bar: a year across February 29 is not 365 days" cite "35 U.S.C. § 315(b)"
{
  given ComplaintServed() on 2023-03-01
  expect deadline(ipr-time-bar) == 2024-03-01
}

test "315(b) bar: from February 29, the year ends on February 28" cite "35 U.S.C. § 315(b)"
{
  given ComplaintServed() on 2024-02-29
  expect deadline(ipr-time-bar) == 2025-02-28
}

/// Correcting an incomplete petition: the Office dismisses it "if the
/// deficiency in the petition is not corrected within one month from the
/// notice of an incomplete petition" (37 C.F.R. § 42.106(b); § 42.206(b)
/// for PGR, which also ends the month at the statutory filing deadline if
/// that is earlier). The legacy pack's 14 days had no source. UNVERIFIED
/// against the 2012 text, which is not vendored; the vendored section
/// carries no amendment history.
rule duty petition-correction-deadline cite "37 C.F.R. § 42.106(b)"
{
  deadline petition-correction-period: 1.months after IncompletePetitionNoticed() counted_by uspto-1-7 effective [2012-09-16, ..) known_at 2012-08-14 delegable {
    to CaseOrder
    op set
  } cite "37 C.F.R. § 42.106(b); 37 C.F.R. § 42.5(c)(1)"
}

test "petition correction: one month from the notice" cite "37 C.F.R. § 42.106(b)"
{
  given IncompletePetitionNoticed() on 2025-03-03
  expect deadline(petition-correction-period) == 2025-04-03
}

test "petition correction: a last day on Labor Day rolls to Tuesday" cite "37 C.F.R. § 42.106(b)"
{
  given IncompletePetitionNoticed() on 2025-08-01
  expect deadline(petition-correction-period) == 2025-09-02
}

/// The patent owner preliminary response is due "no later than three
/// months" after the notice according the petition a filing date (37 C.F.R. §§ 42.107(b), 42.207(b)). The 2012 rule (77 Fed.
/// Reg. 48680, vendored as `cfr-42-2012`) set the same period in the same
/// words; the 2016 amendment (81 Fed. Reg. 18750, Apr. 1, 2016, effective
/// May 2, 2016; the vendored section's history line) changed other
/// paragraphs.
rule duty popr-deadline cite "37 C.F.R. (2012) § 42.107(b)"
{
  deadline popr-period: 3.months after FilingDateNoticed() counted_by uspto-1-7 effective [2012-09-16, 2016-05-02) known_at 2012-08-14 delegable {
    to CaseOrder
    op set
  } cite "37 C.F.R. (2012) § 42.107(b); 37 C.F.R. (2012) § 42.207(b); 37 C.F.R. (2012) § 42.5(c)(1)"
  deadline popr-period: 3.months after FilingDateNoticed() counted_by uspto-1-7 effective [2016-05-02, ..) known_at 2016-04-01 supersedes popr-period@2012-09-16 delegable {
    to CaseOrder
    op set
  } cite "37 C.F.R. § 42.107(b); 37 C.F.R. § 42.207(b); 37 C.F.R. § 42.5(c)(1)"
}

test "POPR: three months from the filing-date notice" cite "37 C.F.R. § 42.107(b)"
{
  given FilingDateNoticed() on 2025-03-04
  expect deadline(popr-period) == 2025-06-04
}

test "POPR: a last day on Memorial Day rolls to Tuesday" cite "37 C.F.R. § 42.107(b)"
{
  given FilingDateNoticed() on 2025-02-26
  expect deadline(popr-period).nominal == 2025-05-26
  expect deadline(popr-period) == 2025-05-27
}

test "POPR under the 2012 rule: a Sunday last day rolls to Monday" cite "37 C.F.R. § 42.107(b)"
{
  given FilingDateNoticed() on 2015-05-30
  expect deadline(popr-period) == 2015-08-31
}

/// 35 U.S.C. § 314(b)(1): the Director decides whether to institute within
/// 3 months after receiving the preliminary response.
deadline institution-period: 3.months after PreliminaryResponseFiled() counted_by uspto-1-7 effective [2012-09-16, ..) known_at 2011-09-16 cite "35 U.S.C. § 314(b)"

test "institution: three months after the preliminary response" cite "35 U.S.C. § 314(b)"
{
  given PreliminaryResponseFiled() on 2025-04-01
  expect deadline(institution-period) == 2025-07-01
}

test "institution: a last day on Veterans Day rolls to Wednesday" cite "35 U.S.C. § 314(b)"
{
  given PreliminaryResponseFiled() on 2025-08-11
  expect deadline(institution-period) == 2025-11-12
}

/// 35 U.S.C. § 314(b)(2): with no preliminary response, the 3 months run
/// from the last date one could be filed. The pack runs them from the
/// patent owner's waiver election (37 C.F.R. § 42.107(b)), which ends the
/// response period early; UNVERIFIED reading. Until the May 2, 2016
/// amendment of § 42.107 the election is the 2012 text's.
deadline institution-period-on-waiver: 3.months after PreliminaryResponseWaived() counted_by uspto-1-7 effective [2012-09-16, 2016-05-02) known_at 2011-09-16 cite "35 U.S.C. § 314(b); 37 C.F.R. (2012) § 42.107(b)"
/// From the May 2, 2016 amendment of § 42.107 (81 FR 18750), whose text
/// keeps the waiver election in paragraph (b).
deadline institution-period-on-waiver: 3.months after PreliminaryResponseWaived() counted_by uspto-1-7 effective [2016-05-02, ..) known_at 2016-04-01 cite "35 U.S.C. § 314(b); 37 C.F.R. § 42.107(b)"

test "institution after waiver: three months from the election" cite "35 U.S.C. § 314(b)"
{
  given PreliminaryResponseWaived() on 2025-05-01
  expect deadline(institution-period-on-waiver) == 2025-08-01
}

test "institution after waiver: a last day on Christmas rolls past the December 26, 2025 closure to Monday" cite "35 U.S.C. § 314(b)"
{
  given PreliminaryResponseWaived() on 2025-09-25
  expect deadline(institution-period-on-waiver) == 2025-12-29
}

/// "If no time for filing a patent owner response to a petition is provided
/// in a Board order, the default date ... is three months from the date the
/// inter partes review was instituted" (37 C.F.R. § 42.120(b)). The 2020 amendment (85 Fed. Reg. 79120, Dec. 9, 2020, effective
/// Jan. 8, 2021; the history line's 85 FR 79129) rewrote paragraph (a);
/// the 2012 text (`cfr-42-2012`) states the same default in paragraph (b).
rule duty patent-owner-response-deadline cite "37 C.F.R. (2012) § 42.120(b)"
{
  deadline patent-owner-response-period: 3.months after TrialInstituted() counted_by uspto-1-7 effective [2012-09-16, 2021-01-08) known_at 2012-08-14 delegable {
    to CaseOrder
    op set
  } cite "37 C.F.R. (2012) § 42.120(b); 37 C.F.R. (2012) § 42.5(c)(1)"
  deadline patent-owner-response-period: 3.months after TrialInstituted() counted_by uspto-1-7 effective [2021-01-08, ..) known_at 2020-12-09 supersedes patent-owner-response-period@2012-09-16 delegable {
    to CaseOrder
    op set
  } cite "37 C.F.R. § 42.120(b); 37 C.F.R. § 42.5(c)(1)"
}

test "patent owner response: three months from institution" cite "37 C.F.R. § 42.120(b)"
{
  given TrialInstituted() on 2025-03-05
  expect deadline(patent-owner-response-period) == 2025-06-05
}

test "patent owner response: a last day on Columbus Day rolls to Tuesday" cite "37 C.F.R. § 42.120(b)"
{
  given TrialInstituted() on 2025-07-13
  expect deadline(patent-owner-response-period) == 2025-10-14
}

test "patent owner response under the 2012 rule: a Saturday last day rolls to Monday" cite "37 C.F.R. § 42.120(b)"
{
  given TrialInstituted() on 2019-03-01
  expect deadline(patent-owner-response-period) == 2019-06-03
}

/// The petitioner's reply. No rule sets it (37 C.F.R. § 42.23 governs only
/// content): the Board's scheduling order does, issued with the decision to
/// institute, and the Trial Practice Guide's sample order sets DUE DATE 2
/// "3 months" after DUE DATE 1, the patent owner response (App. A-1, Due
/// Date Appendix). The period runs here from the response as filed, which a
/// response filed on its due date makes the same day. The guide is vendored
/// as revised October 2025; earlier sample orders are not encoded
/// (`unknown_before`).
deadline petitioner-reply-period: 3.months after PatentOwnerResponseFiled() counted_by uspto-1-7 effective [2025-10-01, ..) known_at 2025-10-01 unknown_before 2025-10-01 delegable {
  to CaseOrder
  op set
} cite "PTAB Trial Practice Guide App. A-1"

test "petitioner reply: three months from the patent owner response" cite "PTAB Trial Practice Guide App. A-1"
{
  given PatentOwnerResponseFiled() on 2025-11-03
  expect deadline(petitioner-reply-period) == 2026-02-03
}

test "petitioner reply: a last day on Memorial Day rolls to Tuesday" cite "PTAB Trial Practice Guide App. A-1"
{
  given PatentOwnerResponseFiled() on 2026-02-25
  expect deadline(petitioner-reply-period).nominal == 2026-05-25
  expect deadline(petitioner-reply-period) == 2026-05-26
}

/// The patent owner's sur-reply: DUE DATE 3 of the guide's sample order,
/// "6 weeks" after DUE DATE 2, the petitioner's reply (App. A-1, Due Date
/// Appendix); set by the scheduling order, not by rule. As
/// `petitioner-reply-period`, it runs from the reply as filed.
deadline sur-reply-period: 6.weeks after PetitionerReplyFiled() counted_by uspto-1-7 effective [2025-10-01, ..) known_at 2025-10-01 unknown_before 2025-10-01 delegable {
  to CaseOrder
  op set
} cite "PTAB Trial Practice Guide App. A-1"

test "sur-reply: six weeks from the reply" cite "PTAB Trial Practice Guide App. A-1"
{
  given PetitionerReplyFiled() on 2025-11-03
  expect deadline(sur-reply-period) == 2025-12-15
}

test "sur-reply: a last day on New Year's Day rolls to Friday" cite "PTAB Trial Practice Guide App. A-1"
{
  given PetitionerReplyFiled() on 2025-11-20
  expect deadline(sur-reply-period).nominal == 2026-01-01
  expect deadline(sur-reply-period) == 2026-01-02
}

// No period runs from the Board's preliminary guidance or from a revised
// motion to amend: 37 C.F.R. § 42.121(f)(1) lets the patent owner file one
// revised motion "after receiving an opposition to the original motion to
// amend or after receiving the Board's preliminary guidance", the guide's
// sample order times it at DUE DATE 3 (App. A-1), and "the Board will
// enter a revised scheduling order setting the briefing schedule for that
// revised motion" (Trial Practice Guide, App. A-1 § A.7). The pack's
// 30-day estimates for both are gone; the edges keep their durations.
/// Rehearing of a final decision: "Within 30 days of the entry of a final
/// decision" (37 C.F.R. § 42.71(d)(2)). The section was amended in 2015 (80
/// Fed. Reg. 28561, May 19, 2015) and 2020 (85 Fed. Reg. 79120, effective
/// Jan. 8, 2021), per its vendored history line; neither changed the 30 days.
/// The 2012 text is vendored (`cfr-42-2012`), and the 2015 amendment
/// revised only the first sentence of paragraph (d) (80 FR 28565), so the
/// 2015 version cites both.
rule duty rehearing-deadline cite "37 C.F.R. (2012) § 42.71(d)(2)"
{
  deadline rehearing-period: 30.days after DecisionEntered(FinalWritten) counted_by uspto-1-7 effective [2012-09-16, 2015-05-19) known_at 2012-08-14 delegable {
    to CaseOrder
    op set
  } cite "37 C.F.R. (2012) § 42.71(d)(2)"
  deadline rehearing-period: 30.days after DecisionEntered(FinalWritten) counted_by uspto-1-7 effective [2015-05-19, 2021-01-08) known_at 2015-05-19 supersedes rehearing-period@2012-09-16 delegable {
    to CaseOrder
    op set
  } cite "37 C.F.R. (2012) § 42.71(d)(2); 80 FR 28565"
  deadline rehearing-period: 30.days after DecisionEntered(FinalWritten) counted_by uspto-1-7 effective [2021-01-08, ..) known_at 2020-12-09 supersedes rehearing-period@2015-05-19 delegable {
    to CaseOrder
    op set
  } cite "37 C.F.R. § 42.71(d)(2); 37 C.F.R. § 42.5(c)(1)"
}

test "rehearing: 30 days from the final written decision" cite "37 C.F.R. § 42.71(d)(2)"
{
  given DecisionEntered(FinalWritten) on 2025-03-03
  expect deadline(rehearing-period) == 2025-04-02
}

test "rehearing: a Sunday last day before Labor Day rolls to Tuesday" cite "37 C.F.R. § 42.71(d)(2)"
{
  given DecisionEntered(FinalWritten) on 2025-08-01
  expect deadline(rehearing-period) == 2025-09-02
}

test "rehearing under the pre-2021 rule: a Sunday last day rolls to Monday" cite "37 C.F.R. § 42.71(d)(2)"
{
  given DecisionEntered(FinalWritten) on 2018-06-01
  expect deadline(rehearing-period) == 2018-07-02
}

/// Director review (37 C.F.R. § 42.75, 89 FR 79744, effective Oct. 31,
/// 2024): a party may request it "instead of filing a request for
/// rehearing" (§ 42.75(c)), "within the time period set forth in
/// § 42.71(d)" (§ 42.75(c)(1)): 30 days from a final decision
/// (§ 42.71(d)(2)). A decision granting rehearing of a final decision is
/// reviewable too (§ 42.75(a)); the pack runs that period from any
/// rehearing decision. The Interim Director Review Process of 2021-2024
/// is not vendored, so review before the rule is not encoded
/// (`unknown_before`).
rule duty director-review-deadline effective [2024-10-31, ..) known_at 2024-10-01 unknown_before 2024-10-31 cite "37 C.F.R. § 42.75(c)(1)"
{
  deadline director-review-period: 30.days after DecisionEntered(FinalWritten) counted_by uspto-1-7 effective [2024-10-31, ..) known_at 2024-10-01 delegable {
    to CaseOrder
    op set
  } cite "37 C.F.R. § 42.75(c)(1); 37 C.F.R. § 42.71(d)(2)"
  deadline director-review-after-rehearing-period: 30.days after DecisionEntered(Rehearing) counted_by uspto-1-7 effective [2024-10-31, ..) known_at 2024-10-01 delegable {
    to CaseOrder
    op set
  } cite "37 C.F.R. § 42.75(a); 37 C.F.R. § 42.75(c)(1); 37 C.F.R. § 42.71(d)(2)"
}

test "Director review: 30 days from the final written decision" cite "37 C.F.R. § 42.75(c)(1)"
{
  given DecisionEntered(FinalWritten) on 2025-09-02
  expect deadline(director-review-period) == 2025-10-02
}

test "Director review: a Sunday last day before Columbus Day rolls to Tuesday" cite "37 C.F.R. § 42.75(c)(1)"
{
  given DecisionEntered(FinalWritten) on 2025-09-12
  expect deadline(director-review-period) == 2025-10-14
}

test "Director review after rehearing: 30 days from the rehearing decision" cite "37 C.F.R. § 42.75(c)(1)"
{
  given DecisionEntered(FinalWritten) on 2025-09-02
  given DecisionEntered(Rehearing) on 2025-11-03
  expect deadline(director-review-after-rehearing-period) == 2025-12-03
}

test "Director review after rehearing: a Sunday last day before MLK Day rolls to Tuesday" cite "37 C.F.R. § 42.75(c)(1)"
{
  given DecisionEntered(Rehearing) on 2025-12-19
  expect deadline(director-review-after-rehearing-period) == 2026-01-20
}

/// A written request to the Director to extend the time for appeal (37
/// C.F.R. § 90.3(c)(1)). Its date is its receipt date: the Eastern Time
/// date the Office of the General Counsel receives the email, "regardless
/// of whether that date is a Saturday, Sunday, or Federal holiday within
/// the District of Columbia" (§ 90.3(c)(2)). That date is `request_made`.
/// Under the 2012 text the request "must be filed as provided in § 104.2
/// of this title" (77 FR 48678), which is not vendored: its date is the
/// filing date the matter records, and no receipt-date rule is applied.
event AppealExtensionRequested()
/// The Director, or the Director's designee, extends the time for appeal
/// to `until` (37 C.F.R. § 90.3(c)(1)).
event AppealPeriodExtended(until: Date) extends appeal-period to until

/// The notice of appeal is due "no later than sixty-three (63) days after
/// the date of the final Board decision" (37 C.F.R. § 90.3(a)(1)); a timely
/// rehearing request resets that to 63 days "after action on the request"
/// (§ 90.3(b)(1)), so the period runs from the latest decision entered. The
/// vendored history: "Added, 77 FR 48612, Aug. 14, 2012, effective Sept. 16,
/// 2012; paras. (c)(1) introductory text and (c)(2) revised, 89 FR 22084,
/// Mar. 29, 2024, effective Mar. 29, 2024"; paragraph (a) is unchanged.
/// Extension: "The Director, or the Director's designee, may extend the
/// time for filing an appeal ... upon written request if: (i) Requested
/// before the expiration of the period ..., and upon a showing of good
/// cause; or (ii) Requested after the expiration of the period ..., and
/// upon a showing that the failure to act was the result of excusable
/// neglect" (§ 90.3(c)(1)). Both turn on when the request was made, not
/// when the Director acts, and neither has a numeric ceiling. The
/// extender is the Director: no court, district or Federal Circuit, holds
/// the power. The 2012 version, as published (77 FR 48677-48678, effective
/// Sept. 16, 2012, 77 FR 48612), has the same two grants: "The Director, or
/// his designee, may extend the time ... upon written request if: (i)
/// Requested before the expiration of the period ..., and upon a showing
/// of good cause; or (ii) Requested after the expiration of the period
/// ..., and upon a showing that the failure to act was the result of
/// excusable neglect"; the 2024 revision changed "his designee" and how
/// the request is filed (§ 90.3(c)(2)), not the grants.
rule duty appeal-deadline cite "37 C.F.R. § 90.3(a)(1)"
{
  deadline appeal-period: 63.days after DecisionEntered() counted_by uspto-1-7 effective [2012-09-16, 2024-03-29) known_at 2012-08-14 cite "77 FR 48677; 77 FR 48612"
  {
    trigger latest
    extend { by director, discretion GoodCause, on AppealExtensionRequested() }
    extend { by director, discretion ExcusableNeglect, after_expiry, on AppealExtensionRequested() }
  }
  deadline appeal-period: 63.days after DecisionEntered() counted_by uspto-1-7 effective [2024-03-29, ..) known_at 2024-03-29 supersedes appeal-period@2012-09-16 cite "37 C.F.R. § 90.3(a)(1); 37 C.F.R. § 90.3(b)(1)"
  {
    trigger latest
    extend { by director, discretion GoodCause, on AppealExtensionRequested() }
    extend { by director, discretion ExcusableNeglect, after_expiry, on AppealExtensionRequested() }
  }
}

test "appeal: 63 days from the final written decision" cite "37 C.F.R. § 90.3(a)(1)"
{
  given DecisionEntered(FinalWritten) on 2025-03-03
  expect deadline(appeal-period) == 2025-05-05
}

