module core.states.montana

import core.calendar.{ us-federal-holidays }

calendar montana-holidays cite "MCA 1-1-216(1)"
{
  general-election-day-2026: once(2026-11-03) effective [2026-10-22, ..)
  general-election-day-2028: once(2028-11-07) effective [2026-10-22, ..)
  general-election-day-2030: once(2030-11-05) effective [2026-10-22, ..)
  general-election-day-2032: once(2032-11-02) effective [2026-10-22, ..)
  general-election-day-2034: once(2034-11-07) effective [2026-10-22, ..)
  general-election-day-2036: once(2036-11-04) effective [2026-10-22, ..)
  general-election-day-2038: once(2038-11-02) effective [2026-10-22, ..)
  general-election-day-2040: once(2040-11-06) effective [2026-10-22, ..)
  general-election-day-2042: once(2042-11-04) effective [2026-10-22, ..)
  general-election-day-2044: once(2044-11-08) effective [2026-10-22, ..)
  general-election-day-2046: once(2046-11-06) effective [2026-10-22, ..)
  general-election-day-2048: once(2048-11-03) effective [2026-10-22, ..)
  general-election-day-2050: once(2050-11-08) effective [2026-10-22, ..)
}

/// FRCP 6 in the district courts of Montana: the 2023 text
/// (`frcp6@2023-12-01`) with `montana-holidays`, which 6(a)(6)(C)
/// ("any day declared a holiday by ... the state where the district court
/// is located") makes legal holidays "for periods that are measured after
/// an event" only. A district package there names it as its `counting`
/// rule and `recounts` lit/frcp. A calendar day is closed only from the
/// date its entry is in force; before it the count is `frcp6`'s.
counting frcp6-montana effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCP 6(d)"
  holidays us-federal-holidays
  forward_holidays montana-holidays cite "FRCP 6(a)(6)(C)"
  forums [frcp]
  allow_hours
  end_of_month clamp
}

/// FRBP 9006(a) (`frbp9006`) in the bankruptcy courts of Montana:
/// `montana-holidays` are legal holidays for a period counted forward only (FRBP
/// 9006(a)(6)(C), "any day declared a holiday by the state where the
/// district court is located"). A bankruptcy package there names it as its
/// `counting` rule and `recounts` lit/frbp. A calendar day is closed only
/// from the date its entry is in force.
counting frbp9006-montana effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays montana-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-mt]
  allow_hours
  end_of_month clamp
}
