/// FRCP 6 in the District of Delaware: the 2023 text (`frcp6@2023-12-01`)
/// with Delaware's legal holidays, which 6(a)(6)(C) ("any day declared a
/// holiday by ... the state where the district court is located") makes
/// legal holidays "for periods that are measured after an event" only. A
/// D. Del. package names it as its `counting` rule; core's `frcp6` stays
/// the federal-only count of every other district. Only the Delaware days
/// the federal calendar lacks close here. It is in force with the 2023
/// text, from December 1, 2023 (core's `delaware-holidays` closes days from
/// May 2, 2011), and counts no period before: no D. Del. civil package is
/// in force earlier.
counting frcp6-delaware effective [2023-12-01, ..) known_at 2023-04-24 cite "FRCP 6(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCP 6(d)"
  holidays us-federal-holidays
  forward_holidays delaware-holidays cite "FRCP 6(a)(6)(C)"
  forums [frcp]
  allow_hours
  end_of_month clamp
}

/// FRBP 9006(a) (`frbp9006`) in the bankruptcy courts of Delaware:
/// `delaware-holidays` are legal holidays for a period counted forward only (FRBP
/// 9006(a)(6)(C), "any day declared a holiday by the state where the
/// district court is located"). A bankruptcy package there names it as its
/// `counting` rule and `recounts` lit/frbp. A calendar day is closed only
/// from the date its entry is in force.
counting frbp9006-delaware effective [2025-12-01, ..) known_at 2025-12-01 cite "FRBP 9006(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRBP 9006(f)"
  holidays us-federal-holidays
  forward_holidays delaware-holidays cite "FRBP 9006(a)(6)(C)"
  forums [bankr-de]
  allow_hours
  end_of_month clamp
}

/// FRCrimP 45 in the District of Delaware: each version of `frcrimp45`
/// with Delaware's legal holidays, which 45(a)(6)(C) ("for periods that are
/// measured after an event, any other day declared a holiday by the state
/// where the district court is located", in every text from 2009) makes
/// legal holidays of a forward-counted period only. A D. Del. criminal
/// package names it as its `counting` rule; core's `frcrimp45` stays the
/// federal-only count of every other district. Only the Delaware days the
/// federal calendar lacks close here. It is in force from May 2, 2011, when
/// core's `delaware-holidays` is, and counts no period before.
counting frcrimp45-delaware effective [2011-05-02, 2016-12-01) known_at 2009-03-26 cite "FRCrimP (2011 ed.) 45(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 3.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCrimP (2011 ed.) 45(c)"
  holidays us-federal-holidays
  forward_holidays delaware-holidays cite "FRCrimP 45(a)(6)(C)"
  forums [frcrimp]
  allow_hours
}

/// The 2016 and 2018 texts (2017 and 2019 eds.), as `frcrimp45@2016-12-01`.
counting frcrimp45-delaware effective [2016-12-01, 2023-12-01) known_at 2016-04-28 supersedes frcrimp45-delaware@2011-05-02 cite "FRCrimP (2017 ed.) 45(a)"
{
  exclude_trigger_day
  include_last_day
  roll_forward_on [weekend, legal_holiday, inaccessible]
  service_extension {
    Personal: 0.days
    Electronic: 0.days
    Mail: 3.days
    Clerk: 3.days
    OtherConsented: 3.days
    CommercialCarrier: unrecognized
    PrisonMail: unrecognized
    MailForeign: unrecognized
    Express: unrecognized
    ExpressForeign: unrecognized
  } cite "FRCrimP (2017 ed.) 45(c)"
  holidays us-federal-holidays
  forward_holidays delaware-holidays cite "FRCrimP 45(a)(6)(C)"
  forums [frcrimp]
  allow_hours
}

/// The 2023 text, as `frcrimp45@2023-12-01`.
counting frcrimp45-delaware effective [2023-12-01, ..) known_at 2023-04-24 supersedes frcrimp45-delaware@2016-12-01 cite "FRCrimP 45(a)"
{
  exclude_trigger_day
