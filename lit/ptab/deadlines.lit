module ptab.deadlines

import core.authority.{ CaseOrder }
import core.rcfc6.{ rcfc6 }

import ptab.{
  AmendmentOppositionFiled,
  BoardDecision,
  ComplaintServed,
  DecisionEntered,
  FilingDateNoticed,
  IncompletePetitionNoticed,
  PatentGranted,
  PatentOwnerResponseFiled,
  PetitionerReplyFiled,
  PreliminaryGuidanceIssued,
  PreliminaryResponseFiled,
  PreliminaryResponseWaived,
  RevisedMotionToAmendFiled,
  TrialInstituted,
}

// Counting. A PTAB period counts calendar days (37 C.F.R. § 1.7(a), which
// 37 C.F.R. § 42.1(a) applies to the Board), and a last day on a Saturday,
// Sunday or "Federal holiday within the District of Columbia" moves to the
// next business day (35 U.S.C. § 21(b); 37 C.F.R. § 90.3(b)(2) for appeals).
// lit/core has no USPTO counting rule, and declaring one here would give
// the lowered pack a `counting` field the legacy pack lacks. `rcfc6` (in
// force from 2010) counts these periods the same way: every day counts, the
// trigger day is excluded, the last day rolls off weekends and legal
// holidays, and its calendar adds Inauguration Day to the 5 U.S.C. § 6103(a)
// holidays, as § 6103(c) does for federal employees in the District of
// Columbia area. Its service extensions never apply: no PTAB trigger carries
// a service method. Periods the statute or rule states in months or years
// ("9 months", "1 year", "three months", "one month") are calendar months:
// they end on the corresponding day of the later month, or on that month's
// last day when it has no such day (`rcfc6`'s `end_of_month clamp`, as MPEP
// 710.01(a) counts the Office's months), and then roll like any period.
//
// Effective intervals. Every deadline states its window. The AIA trial
// provisions (35 U.S.C. §§ 314(b), 315(b), 321(c)) apply from September 16,
// 2012 (Pub. L. 112-29, § 6(c)(2)(A), 125 Stat. 284, enacted September 16,
// 2011: `known_at 2011-09-16`); the Part 42 trial rules took effect the same
// day (77 Fed. Reg. 48612 and 48680, published August 14, 2012: `known_at
// 2012-08-14`). Later versions follow the amendment dates in the vendored
// sections' history lines.
//
// Delegation. "Times set by rule are default and may be modified by order"
// (37 C.F.R. § 42.5(c)(1)), so every period a Part 42 rule sets is
// `delegable_to [CaseOrder]`. Statutory periods (35 U.S.C. §§ 314(b),
// 315(b), 321(c)) are not.
/// 35 U.S.C. § 321(c): a post-grant review petition may be filed no later
/// than "the date that is 9 months after the date of the grant".
rule duty pgr-filing-deadline cite 35 U.S.C. § 321(c)
{
  deadline pgr-filing-period: 9.months after PatentGranted() counted_by rcfc6 effective [2012-09-16, ..) known_at 2011-09-16 cite 35 U.S.C. § 321(c)
}

test "PGR window: 9 months from a March 4 grant end on December 4" cite 35 U.S.C. § 321(c)
{
  given PatentGranted() on 2025-03-04
  expect deadline(pgr-filing-period) == 2025-12-04
}

test "PGR window: a last day on Martin Luther King Day rolls to Tuesday" cite 35 U.S.C. § 321(c)
{
  given PatentGranted() on 2025-04-19
  expect deadline(pgr-filing-period) == 2026-01-20
}

test "PGR window: from May 31, February has no 31st; its last day is a Saturday" cite 35 U.S.C. § 321(c)
{
  given PatentGranted() on 2025-05-31
  expect deadline(pgr-filing-period).nominal == 2026-02-28
  expect deadline(pgr-filing-period).adjusted == 2026-03-02
}

/// 35 U.S.C. § 315(b): no inter partes review is instituted on a petition
/// filed more than 1 year after the petitioner, its real party in interest,
/// or a privy is served with an infringement complaint.
rule duty ipr-time-bar-deadline cite 35 U.S.C. § 315(b)
{
  deadline ipr-time-bar: 1.years after ComplaintServed() counted_by rcfc6 effective [2012-09-16, ..) known_at 2011-09-16 cite 35 U.S.C. § 315(b)
}

test "315(b) bar: one year from service" cite 35 U.S.C. § 315(b)
{
  given ComplaintServed() on 2025-03-03
  expect deadline(ipr-time-bar) == 2026-03-03
}

test "315(b) bar: a last day on observed Independence Day rolls to Monday" cite 35 U.S.C. § 315(b)
{
  given ComplaintServed() on 2025-07-03
  expect deadline(ipr-time-bar) == 2026-07-06
}

test "315(b) bar: a year across February 29 is not 365 days" cite 35 U.S.C. § 315(b)
{
  given ComplaintServed() on 2023-03-01
  expect deadline(ipr-time-bar) == 2024-03-01
}

test "315(b) bar: from February 29, the year ends on February 28" cite 35 U.S.C. § 315(b)
{
  given ComplaintServed() on 2024-02-29
  expect deadline(ipr-time-bar) == 2025-02-28
}

/// Correcting an incomplete petition: the Office dismisses it "if the
/// deficiency in the petition is not corrected within one month from the
/// notice of an incomplete petition" (37 C.F.R. § 42.106(b); § 42.206(b)
/// for PGR, which also ends the month at the statutory filing deadline if
/// that is earlier). The legacy pack's 14 days had no source. UNVERIFIED
/// against the 2012 text, which is not vendored; the vendored section
/// carries no amendment history.
rule duty petition-correction-deadline cite 37 C.F.R. § 42.106(b)
{
  deadline petition-correction-period: 1.months after IncompletePetitionNoticed() counted_by rcfc6 effective [2012-09-16, ..) known_at 2012-08-14 delegable_to [CaseOrder] cite 37 C.F.R. § 42.106(b); 37 C.F.R. § 42.5(c)(1)
}

test "petition correction: one month from the notice" cite 37 C.F.R. § 42.106(b)
{
  given IncompletePetitionNoticed() on 2025-03-03
  expect deadline(petition-correction-period) == 2025-04-03
}

test "petition correction: a last day on Labor Day rolls to Tuesday" cite 37 C.F.R. § 42.106(b)
{
  given IncompletePetitionNoticed() on 2025-08-01
  expect deadline(petition-correction-period) == 2025-09-02
}

/// The patent owner preliminary response is due "no later than three
/// months" after the notice according the petition a filing date (37 C.F.R. §§ 42.107(b), 42.207(b)). The 2012 rule (77 Fed.
/// Reg. 48680) set the same period; the 2016 amendment (81 Fed. Reg. 18750,
/// Apr. 1, 2016, effective May 2, 2016; the vendored section's history line)
/// changed other paragraphs. UNVERIFIED against the 2012 text, which is not
/// vendored.
rule duty popr-deadline cite 37 C.F.R. § 42.107(b)
{
  deadline popr-period: 3.months after FilingDateNoticed() counted_by rcfc6 effective [2012-09-16, 2016-05-02) known_at 2012-08-14 delegable_to [CaseOrder] cite ?("the 2012 text (77 Fed. Reg. 48680 (Aug. 14, 2012)) is not vendored: 37 C.F.R. § 42.107(b) as promulgated")
  deadline popr-period: 3.months after FilingDateNoticed() counted_by rcfc6 effective [2016-05-02, ..) known_at 2016-04-01 supersedes popr-period@2012-09-16 delegable_to [CaseOrder] cite 37 C.F.R. § 42.107(b); 37 C.F.R. § 42.207(b); 37 C.F.R. § 42.5(c)(1)
}

test "POPR: three months from the filing-date notice" cite 37 C.F.R. § 42.107(b)
{
  given FilingDateNoticed() on 2025-03-04
  expect deadline(popr-period) == 2025-06-04
}

test "POPR: a last day on Memorial Day rolls to Tuesday" cite 37 C.F.R. § 42.107(b)
{
  given FilingDateNoticed() on 2025-02-26
  expect deadline(popr-period).nominal == 2025-05-26
  expect deadline(popr-period) == 2025-05-27
}

test "POPR under the 2012 rule: a Sunday last day rolls to Monday" cite 37 C.F.R. § 42.107(b)
{
  given FilingDateNoticed() on 2015-05-30
  expect deadline(popr-period) == 2015-08-31
}

/// 35 U.S.C. § 314(b)(1): the Director decides whether to institute within
/// 3 months after receiving the preliminary response.
deadline institution-period: 3.months after PreliminaryResponseFiled() counted_by rcfc6 effective [2012-09-16, ..) known_at 2011-09-16 cite 35 U.S.C. § 314(b)

test "institution: three months after the preliminary response" cite 35 U.S.C. § 314(b)
{
  given PreliminaryResponseFiled() on 2025-04-01
  expect deadline(institution-period) == 2025-07-01
}

test "institution: a last day on Veterans Day rolls to Wednesday" cite 35 U.S.C. § 314(b)
{
  given PreliminaryResponseFiled() on 2025-08-11
  expect deadline(institution-period) == 2025-11-12
}

/// 35 U.S.C. § 314(b)(2): with no preliminary response, the 3 months run
/// from the last date one could be filed. The pack runs them from the
/// patent owner's waiver election (37 C.F.R. § 42.107(b)), which ends the
/// response period early; UNVERIFIED reading.
deadline institution-period-on-waiver: 3.months after PreliminaryResponseWaived() counted_by rcfc6 effective [2012-09-16, ..) known_at 2011-09-16 cite 35 U.S.C. § 314(b); 37 C.F.R. § 42.107(b)

test "institution after waiver: three months from the election" cite 35 U.S.C. § 314(b)
{
  given PreliminaryResponseWaived() on 2025-05-01
  expect deadline(institution-period-on-waiver) == 2025-08-01
}

test "institution after waiver: a last day on Christmas rolls to Friday" cite 35 U.S.C. § 314(b)
{
  given PreliminaryResponseWaived() on 2025-09-25
  expect deadline(institution-period-on-waiver) == 2025-12-26
}

/// No rule fixes when the scheduling order issues: the 30 days are the
/// pack's practice estimate, and the Board sets the trial's times by order
/// (37 C.F.R. § 42.5(c)(1)).
deadline scheduling-order-period: 30.days after TrialInstituted() counted_by rcfc6 effective [2012-09-16, ..) known_at 2012-08-14 delegable_to [CaseOrder] cite ?("no rule: the pack's estimate that the scheduling order issues within 30 days of institution; times are set by order, 37 C.F.R. § 42.5(c)(1)")

test "scheduling order: 30 days from institution" cite 37 C.F.R. § 42.5(c)(1)
{
  given TrialInstituted() on 2025-03-03
  expect deadline(scheduling-order-period) == 2025-04-02
}

test "scheduling order: a last day on Juneteenth rolls to Friday" cite 37 C.F.R. § 42.5(c)(1)
{
  given TrialInstituted() on 2025-05-20
  expect deadline(scheduling-order-period) == 2025-06-20
}

/// "If no time for filing a patent owner response to a petition is provided
/// in a Board order, the default date ... is three months from the date the
/// inter partes review was instituted" (37 C.F.R. § 42.120(b)). The 2020 amendment (85 Fed. Reg. 79120, Dec. 9, 2020, effective
/// Jan. 8, 2021; the history line's 85 FR 79129) rewrote paragraph (a).
/// UNVERIFIED against the 2012 text, which is not vendored.
rule duty patent-owner-response-deadline cite 37 C.F.R. § 42.120(b)
{
  deadline patent-owner-response-period: 3.months after TrialInstituted() counted_by rcfc6 effective [2012-09-16, 2021-01-08) known_at 2012-08-14 delegable_to [CaseOrder] cite ?("the 2012 text (77 Fed. Reg. 48680 (Aug. 14, 2012)) is not vendored: 37 C.F.R. § 42.120(b) as promulgated")
  deadline patent-owner-response-period: 3.months after TrialInstituted() counted_by rcfc6 effective [2021-01-08, ..) known_at 2020-12-09 supersedes patent-owner-response-period@2012-09-16 delegable_to [CaseOrder] cite 37 C.F.R. § 42.120(b); 37 C.F.R. § 42.5(c)(1)
}

test "patent owner response: three months from institution" cite 37 C.F.R. § 42.120(b)
{
  given TrialInstituted() on 2025-03-05
  expect deadline(patent-owner-response-period) == 2025-06-05
}

