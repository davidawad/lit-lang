module mo-court-of-appeals-civil.appeal

// A civil appeal in the Missouri Court of Appeals, from the appellant's
// view of outcomes.
// The Missouri Supreme Court Rules are not vendored: courts.mo.gov answered
// HTTP 403 to every fetch (sources/mo-criminal-trial-court/PROVENANCE.md),
// tracked as lg-3sut (#15). Every cite is therefore a hole naming that
// issue, its rule number carried from the outline unverified, and no
// period, count, limit, probability or payoff is stated: each is a hole
// until the rule text is vendored and read.
// The outline's decision (Nazeri v. Missouri Valley College) has no
// reporter text vendored, so it is removed here.
import mo-state-rules.{ MandateIssued, NoticeOfAppealFiled, RecordFiled }

start notice-filed

state notice-filed: "Notice of appeal filed" by applicant cite ?("Mo. Sup. Ct. R. 81.04; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)") {
  note "Notice of appeal under Rule 81.04; period is a hole (unverified). Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  edge-notice-filed-appealability "Notice filed" -> appealability {
    authority cite ?("Mo. Sup. Ct. R. 81.04; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
  }
}

decision appealability: "Appellate jurisdiction check" by court cite ?("Mo. Const. art. V, § 3; Mo. Sup. Ct. R. 81.04; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)") {
  note "Final judgment and appealable orders (unverified). Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  edge-appealability-dismissed-jurisdiction "Not an appealable order, or untimely" -> dismissed-jurisdiction {
    authority cite ?("Mo. Const. art. V, § 3; Mo. Sup. Ct. R. 81.04; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
  }
  edge-appealability-record "Appealable order" -> record {
    event NoticeOfAppealFiled()
    authority cite ?("Mo. Const. art. V, § 3; Mo. Sup. Ct. R. 81.04; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
  }
}

terminal dismissed-jurisdiction: "Dismissed for lack of appellate jurisdiction" outcome [loss] cite ?("Mo. Const. art. V, § 3; Mo. Sup. Ct. R. 81.04; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)") {
  note "Outcome from the applicant's side. Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  payoff ?
}

state record: "Record settled and transmitted" cite ?("Mo. Sup. Ct. R. 81.12; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)") {
  note "Record on appeal (unverified). Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  edge-record-briefing "Record filed" -> briefing {
    event RecordFiled()
    authority cite ?("Mo. Sup. Ct. R. 81.12; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
  }
}

state briefing: "Briefing: opening, response, reply" cite ?("Mo. Sup. Ct. R. 84.04, 84.06; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)") {
  note "Briefing schedule is a hole. Brief content under Rules 84.04 and 84.06; length is a hole. Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  edge-briefing-argument "Briefs complete" -> argument {
    authority cite ?("Mo. Sup. Ct. R. 84.04, 84.06; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)")
  }
}

state argument: "Oral argument or submission on briefs" cite ?("Mo. Sup. Ct. R. 84.16; not vendored: courts.mo.gov blocked the fetch (lg-3sut, #15)") {
  note "Argument may be waived. Hole: the Missouri rule text is not vendored (lg-3sut, #15)."
  edge-argument-disposition "Submitted for decision" -> disposition {
