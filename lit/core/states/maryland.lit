  // § 1-111(a)(15): the Friday after Thanksgiving Day.
  american-indian-heritage-day-2026: once(2026-11-27) effective [2026-10-29, ..)
  american-indian-heritage-day-2027: once(2027-11-26) effective [2026-10-29, ..)
  american-indian-heritage-day-2028: once(2028-11-24) effective [2026-10-29, ..)
  american-indian-heritage-day-2029: once(2029-11-23) effective [2026-10-29, ..)
