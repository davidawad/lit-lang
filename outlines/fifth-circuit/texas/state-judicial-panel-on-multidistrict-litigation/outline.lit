// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-tx-judicial-panel-on-multidistrict-litigation

import outline-tx-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start request

state request: "Motion or request filed" by applicant cite ?("Tex. R. Jud. Admin. 13.3 (verify)")
{
  note "OUTLINE. The panel transfers related cases involving common questions of fact to a pretrial court. Requests to the Texas Judicial Panel on Multidistrict Litigation: who may file, form and response periods are holes. Leading decisions: not yet identified in this pass; verify before use."
  edge-request-decision "Submitted for decision" -> decision { event ActionCommenced() authority cite ?("Tex. Gov't Code § 74.162 (verify)") }
}

chance decision: "Panel decides" by court cite ?("Tex. Gov't Code § 74.162 (verify)")
{
  note "OUTLINE. Outcome probabilities are holes."
  edge-decision-granted "Granted or opinion issued" -> granted p ? { event DecisionFiled() }
  edge-decision-denied "Denied or declined" -> denied p ? { event DecisionFiled() }
}

terminal granted: "Granted or opinion issued" outcome [win] cite ?("Tex. Gov't Code § 74.162 (verify)")
{
  note "OUTLINE. Effect of the order or opinion is a hole."
  payoff ?
}

terminal denied: "Denied or declined" outcome [loss] cite ?("Tex. Gov't Code § 74.162 (verify)")
{
  note "OUTLINE. Further review: Tex. R. Jud. Admin. 13.9 (mandamus) (verify) (verify)."
  payoff ?
}
