// OUTLINE (unverified). Structure, cites and holes only: every cite ?(...) and every
// value ? stays a hole until a later pass verifies it against vendored rule text.
module outline-ca-superior-court-appellate-division

import ca-state-rules.{ ActionCommenced, DecisionFiled, JudgmentEntered, MandateIssued, NoticeOfAppealFiled, RecordFiled, ReviewPetitionFiled }

start notice

decision notice: "Notice of appeal within time?" by applicant cite ?("Cal. Rules of Court, rule 8.822 (verify)")
{
  note "OUTLINE. The appellate division hears limited civil, misdemeanor and infraction appeals; transfer to the Court of Appeal is under rules 8.1000-8.1018. Appeal to the California Superior Court, Appellate Division: appealability, the notice period and service are holes. Leading decisions: not yet identified in this pass; verify before use."
  edge-notice-late "No timely notice" -> dismissed-untimely { authority cite ?("Cal. Rules of Court, rule 8.822 (verify)") }
  edge-notice-filed "Timely notice" -> record { event NoticeOfAppealFiled() authority cite ?("Cal. Rules of Court, rule 8.822 (verify)") }
}

state record: "Record or transcript prepared" by office cite ?("Cal. Rules of Court, rule 8.830 (verify)")
{
  note "OUTLINE. Record contents, transcript and fees are holes."
  edge-record-briefing "Record filed" -> briefing { event RecordFiled() authority cite ?("Cal. Rules of Court, rule 8.830 (verify)") }
}

state briefing: "Briefs filed" by applicant cite ?("Cal. Rules of Court, rule 8.882 (verify)")
{
  note "OUTLINE. Briefing periods, form and length are holes."
  edge-briefing-argument "Argument or submission" -> argument { authority cite ?("Cal. Rules of Court, rule 8.885 (verify)") }
}

state argument: "Argument or submission" by court cite ?("Cal. Rules of Court, rule 8.885 (verify)")
{
  note "OUTLINE. Argument may be discretionary."
  edge-argument-decision "Decision issued" -> decision { authority cite ?("Cal. Rules of Court, rule 8.887 (verify)") }
}

chance decision: "Court decides" by court cite ?("Cal. Rules of Court, rule 8.887 (verify)")
{
  note "OUTLINE. Outcome probabilities are holes."
  edge-decision-affirmed "Affirmed" -> post-decision p ? { event DecisionFiled() }
  edge-decision-reversed "Reversed, vacated or remanded" -> post-decision p ? { event DecisionFiled() }
}

decision post-decision: "Rehearing or further review?" by applicant cite ?("Cal. Rules of Court, rule 8.1005 (verify)")
{
  note "OUTLINE. Rehearing and further-review periods are holes."
  edge-post-mandate "No further review" -> mandate-issued { event MandateIssued() authority cite ?("Cal. Rules of Court, rule 8.890 (verify)") }
  edge-post-further "Further review sought" -> further-review { event ReviewPetitionFiled() authority cite ?("Cal. Rules of Court, rule 8.1005 (verify)") }
}

terminal dismissed-untimely: "Dismissed: no timely notice" outcome [loss, dismissal] cite ?("Cal. Rules of Court, rule 8.822 (verify)")
{
  note "OUTLINE. Whether the time limit is jurisdictional is a hole."
  payoff ?
}

terminal mandate-issued: "Mandate or remittitur issued" outcome [final] cite ?("Cal. Rules of Court, rule 8.890 (verify)")
{
  note "OUTLINE. The case returns to the court below; costs are holes."
  payoff ?
}

terminal further-review: "Further review sought in a higher court" outcome [final] cite ?("Cal. Rules of Court, rule 8.1005 (verify)")
{
  note "OUTLINE. Review in the higher court is its own package."
  payoff ?
}
