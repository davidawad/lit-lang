}

state briefs-filed: "Final briefs filed (plaintiff 60d, defendant +30d, reply +15d)" by board cite "37 CFR 2.128(a)(1)"
{
  group trial
  _ "Board panel decides" -> final-decision {
    authority cite ?("37 CFR 2.129; TBMP 801")
    duration { min 90.days, mode 120.days, max 240.days }
  }
}
