module ncwd-local-rules.local-rules

import core.states.north-carolina.{ frcp6-north-carolina }

// The Western District of North Carolina's own civil periods and limits,
// computed under FRCP 6(a), which governs a period stated in a local rule.
// Rules that state no period this layer can count stay out: the NCDPS
// acknowledgement by 5:00 p.m. the following business day (LCvR 4.3(a));
// the Social Security briefs, due on dates the scheduling order sets (LCvR
// 7.2(c), (e)); the Court's scheduling of the Initial Pretrial Conference
// within 14 days after receiving the discovery plan (LCvR 16.1) and the
// clerk's disposal of exhibits (LCvR 79.1(d)), court actions; the
// mediator's report (LCvR 16.3); attorney discipline (LCvR 83.2); and the
// Local Criminal Rules. A Standing Civil Order or Case Management Order may
// set other page limits (LCvR 7.1(d)). The earlier W.D.N.C. outline's FRCP
// flow belongs to lit/frcp and lit/frap; its decisions (Twombly, Iqbal,
// Foman v. Davis, Frow v. De La Vega, Celotex, Anderson v. Liberty Lobby,
// Catlin, Bowles v. Russell, and in the Third and Fourth Circuits Phillips
// v. County of Allegheny, Fowler v. UPMC Shadyside, Poulis v. State Farm,
// Goines v. Valley Community Services Board and Anderson v. Foundation for
// Advancement) are FRCP authority, and no reporter text is vendored, so
// they are removed here.
/// Any brief, absent a different limit in the assigned judge's Standing
/// Civil Order or the Case Management Order: at most 25 pages (LCvR
/// 7.1(d)).
limit brief { pages <= 25 cite "W.D.N.C. LCvR 7.1(d)" } cite "W.D.N.C. LCvR 7.1(d)"
/// A notice of supplemental authority, and any response: at most two pages
/// (LCvR 7.1).
limit supplemental-authority-notice { pages <= 2 cite "W.D.N.C. LCvR 7.1" } cite "W.D.N.C. LCvR 7.1"
/// The plaintiff's one reply brief in a Social Security case: at most five
/// pages (LCvR 7.2(g)).
limit social-security-reply { pages <= 5 cite "W.D.N.C. LCvR 7.2(g)" } cite "W.D.N.C. LCvR 7.2(g)"

/// A request for waiver of service on a current or former NCDPS employee is
/// filed (LCvR 4.3(b)).
event NcdpsWaiverRequestFiled()
/// A defendant's waiver of service is filed under LCvR 4.3(c).
event NcdpsWaiverFiled()
/// A motion is served (LCvR 7.1(e)).
event MotionServed() paper brief
/// The response to a motion is served (LCvR 7.1(e)).
event ResponseServed() paper brief
/// A notice of supplemental authority is filed (LCvR 7.1).
event SupplementalAuthorityFiled() paper supplemental-authority-notice
/// The Commissioner submits its brief in a Social Security case (LCvR
/// 7.2(g)).
event CommissionerBriefSubmitted()
/// The plaintiff's Social Security reply brief is filed (LCvR 7.2(g)).
event SocialSecurityReplyFiled() paper social-security-reply
/// The issues are joined, as LCvR 16.1(d) defines it (LCvR 16.1(a)).
event IssuesJoined()
/// The Initial Attorney's Conference is held (LCvR 16.1(b)).
event InitialAttorneysConference()
/// The Court rules on a motion to stay (LCvR 16.1(c)).
event StayMotionRuled()
/// A pro se litigant receives the Opt-In Notice of the Pro Se Settlement
/// Assistance Program (LCvR 16.4).
event OptInNoticeReceived()
/// A document subpoena is served on a non-party (LCvR 45.2).
event NonPartySubpoenaServed()
/// The time allowed for appeal of a final judgment expires, or the Clerk of
/// Court receives the mandate or other order terminating the action on
/// appeal (LCvR 54.1(a)).
event CostsPeriodTriggered()
/// A bill of costs is electronically filed (LCvR 54.1(d)).
event BillOfCostsFiled()
/// An objection to the bill of costs is filed (LCvR 54.1(d)).
event CostsObjectionFiled()
/// The Clerk of Court's order on costs is entered (LCvR 54.1(e)).
event CostsTaxed()

/// LCvR 4.3(b): the NCDPS has sixty days from the filing of a request for
/// waiver of service to accept or refuse service on its current or former
/// employee.
deadline ncdps-waiver-response-period: 60.days after NcdpsWaiverRequestFiled() counted_by frcp6-north-carolina cite "W.D.N.C. LCvR 4.3(b)"
{
  forum frcp
}

/// LCvR 4.3(c)(1): a defendant whose waiver of service has been filed has
/// sixty days from the date the waiver is filed to answer or otherwise
/// respond to the complaint.
deadline ncdps-answer-period: 60.days after NcdpsWaiverFiled() counted_by frcp6-north-carolina cite "W.D.N.C. LCvR 4.3(c)"
{
  forum frcp
}

/// LCvR 7.1(e): responses to motions are filed within fourteen days of the
/// date on which the motion is served.
deadline response-period: 14.days after MotionServed() counted_by frcp6-north-carolina cite "W.D.N.C. LCvR 7.1(e)"
{
  forum frcp
}

/// LCvR 7.1(e): a reply, if any, is filed within seven days of the date on
/// which the response is served, limited to matters newly raised in it.
deadline reply-period: 7.days after ResponseServed() counted_by frcp6-north-carolina cite "W.D.N.C. LCvR 7.1(e)"
{
  forum frcp
}

/// LCvR 7.2(g): the plaintiff may file one reply brief fourteen calendar
/// days after the Commissioner submits its brief, limited to issues raised
/// for the first time in it.
deadline social-security-reply-period: 14.days after CommissionerBriefSubmitted() counted_by frcp6-north-carolina cite "W.D.N.C. LCvR 7.2(g)"
{
  forum frcp
}

/// LCvR 16.1(a): not later than fourteen days from joinder of the issues,
/// the parties confer under FRCP 26(f) and conduct the Initial Attorney's
/// Conference; the period is tolled during a pro se litigant's opt-in
/// period (LCvR 16.4).
deadline initial-attorneys-conference-period: 14.days after IssuesJoined() counted_by frcp6-north-carolina cite "W.D.N.C. LCvR 16.1(a)"
{
  forum frcp
}

/// LCvR 16.1(b): within seven days of the Initial Attorney's Conference the
/// parties file its Certificate, with a proposed discovery plan.
deadline iac-certificate-period: 7.days after InitialAttorneysConference() counted_by frcp6-north-carolina cite "W.D.N.C. LCvR 16.1(b)"
{
  forum frcp
}

/// LCvR 16.1(c): a Joint Stipulation of Consent to a magistrate judge's
/// jurisdiction is filed with the Certificate of Initial Attorney's
/// Conference or within seven days of the Court's ruling on a motion to
/// stay.
deadline consent-stipulation-period: 7.days after StayMotionRuled() counted_by frcp6-north-carolina cite "W.D.N.C. LCvR 16.1(c)"
{
  forum frcp
}

/// LCvR 16.4: a pro se litigant has fourteen days from receipt of the
/// Opt-In Notice to opt into the Pro Se Settlement Assistance Program.
deadline pro-se-opt-in-period: 14.days after OptInNoticeReceived() counted_by frcp6-north-carolina cite "W.D.N.C. LCvR 16.4"
{
  forum frcp
}

/// LCvR 45.2: notice of a document subpoena to a non-party, with a copy, is
/// served on all other parties at least three calendar days before the
/// subpoena is served on the non-party, unless the parties agree or the
/// Court orders otherwise.
deadline subpoena-notice-period: 3.days before NonPartySubpoenaServed() counted_by frcp6-north-carolina cite "W.D.N.C. LCvR 45.2"
{
  forum frcp
}

/// LCvR 54.1(a), (c): a prevailing party files its bill of costs within
/// thirty days after the time for appeal of a final judgment expires or the
/// Clerk of Court receives the mandate or other order terminating the
/// action on appeal; failure to file in time waives costs.
deadline bill-of-costs-period: 30.days after CostsPeriodTriggered() counted_by frcp6-north-carolina cite "W.D.N.C. LCvR 54.1(a)"
{
  forum frcp
}

/// LCvR 54.1(d): an adverse party may file an objection with a supporting
/// brief within fourteen days after the electronic filing of the bill of
/// costs.
deadline costs-objection-period: 14.days after BillOfCostsFiled() counted_by frcp6-north-carolina cite "W.D.N.C. LCvR 54.1(d)"
{
  forum frcp
}

/// LCvR 54.1(d): within seven days after the objection, the prevailing
/// party may file a response with brief.
deadline costs-response-period: 7.days after CostsObjectionFiled() counted_by frcp6-north-carolina cite "W.D.N.C. LCvR 54.1(d)"
{
  forum frcp
}

/// LCvR 54.1(e): a party may request review of the Clerk of Court's ruling
/// by motion within seven days after entry of the Clerk of Court's order.
deadline costs-review-period: 7.days after CostsTaxed() counted_by frcp6-north-carolina cite "W.D.N.C. LCvR 54.1(e)"
{
  forum frcp
}

test "ncdps waiver response period: 60 days after the trigger" cite "W.D.N.C. LCvR 4.3(b)"
{
  given NcdpsWaiverRequestFiled() on 2026-11-02
  expect deadline(ncdps-waiver-response-period) == 2027-01-04
}

test "ncdps answer period: 60 days after the trigger" cite "W.D.N.C. LCvR 4.3(c)"
{
  given NcdpsWaiverFiled() on 2026-11-02
  expect deadline(ncdps-answer-period) == 2027-01-04
}

test "response period: 14 days after the trigger" cite "W.D.N.C. LCvR 7.1(e)"
{
  given MotionServed() on 2026-11-02
  expect deadline(response-period) == 2026-11-16
}

test "reply period: 7 days after the trigger" cite "W.D.N.C. LCvR 7.1(e)"
{
  given ResponseServed() on 2026-11-02
  expect deadline(reply-period) == 2026-11-09
}

test "social security reply period: 14 days after the trigger" cite "W.D.N.C. LCvR 7.2(g)"
{
  given CommissionerBriefSubmitted() on 2026-11-02
  expect deadline(social-security-reply-period) == 2026-11-16
}

test "initial attorneys conference period: 14 days after the trigger" cite "W.D.N.C. LCvR 16.1(a)"
{
  given IssuesJoined() on 2026-11-02
  expect deadline(initial-attorneys-conference-period) == 2026-11-16
}

test "iac certificate period: 7 days after the trigger" cite "W.D.N.C. LCvR 16.1(b)"
{
  given InitialAttorneysConference() on 2026-11-02
  expect deadline(iac-certificate-period) == 2026-11-09
}

test "consent stipulation period: 7 days after the trigger" cite "W.D.N.C. LCvR 16.1(c)"
{
  given StayMotionRuled() on 2026-11-02
  expect deadline(consent-stipulation-period) == 2026-11-09
}

test "pro se opt in period: 14 days after the trigger" cite "W.D.N.C. LCvR 16.4"
{
  given OptInNoticeReceived() on 2026-11-02
  expect deadline(pro-se-opt-in-period) == 2026-11-16
}

test "subpoena notice period: 3 days before the trigger" cite "W.D.N.C. LCvR 45.2"
{
  given NonPartySubpoenaServed() on 2027-03-02
  expect deadline(subpoena-notice-period) == 2027-02-26
}

test "bill of costs period: 30 days after the trigger" cite "W.D.N.C. LCvR 54.1(a)"
{
  given CostsPeriodTriggered() on 2026-11-02
  expect deadline(bill-of-costs-period) == 2026-12-02
}

test "costs objection period: 14 days after the trigger" cite "W.D.N.C. LCvR 54.1(d)"
{
  given BillOfCostsFiled() on 2026-11-02
  expect deadline(costs-objection-period) == 2026-11-16
}

test "costs response period: 7 days after the trigger" cite "W.D.N.C. LCvR 54.1(d)"
{
  given CostsObjectionFiled() on 2026-11-02
  expect deadline(costs-response-period) == 2026-11-09
}

test "costs review period: 7 days after the trigger" cite "W.D.N.C. LCvR 54.1(e)"
{
  given CostsTaxed() on 2026-11-02
  expect deadline(costs-review-period) == 2026-11-09
}
